# versioning — compute a release ring's next GenVer version, or its changelog, from git history.
#
#   versioning tag       <ring>   ->  the next tag `G.E.N-<label>` (stdout)
#   versioning changelog <ring>   ->  the commits since the previous version, grouped (stdout)
#
# Both subcommands find the previous version tag on the ring (the most recent `*-<label>` tag
# reachable from HEAD) and read the commits landed since it. `tag` counts those commits by kind and
# adds the counts onto the previous version WITHOUT resetting lower axes; `changelog` groups them for
# display. All diagnostics go to stderr.
#
# `ring` is a release ring or its pre-release label (root/code_style/git_branching.md):
#   behemoth | nightly  ->  nightly    azazello | rc      ->  rc
#   koroviev | latest   ->  latest     master   | stable  ->  stable
#
# git has no in-process capture here (std::process::run! only returns an exit status), so each query
# is run through `sh -c` redirecting its stdout to a temp file, which is read back and deleted — the
# same shell-redirect-to-tempfile route the compiler uses for its own subprocess intermediates. This
# lives standalone under lib/versioning/ for now; it is destined to become `cf mod`'s versioner.

import std::data::str::{ eq, trim_end }
import std::io::console::{ print, println, eprintln }
import std::process::{ run!, find_executable!, getpid, exit }
import std::io::file::{ read_file! }
import std::io::fs::{ remove }
import std::data::{ Either }
import std::mem::arena::growing_arena
import genver::{ Ver, parse_ver, bump, format_tag }
import commit::{ Commit, parse_log, count_kinds }
import changelog::{ render }

# A ring name or a pre-release label -> the canonical pre-release label, or "" if unrecognised.
const ring_label = (Str ring): Str -> {
	if eq(ring, "nightly") || eq(ring, "behemoth") then return "nightly"
	if eq(ring, "rc") || eq(ring, "azazello") then return "rc"
	if eq(ring, "latest") || eq(ring, "koroviev") then return "latest"
	if eq(ring, "stable") || eq(ring, "master") then return "stable"

	return ""
}

# Resolve a required tool on PATH, or die with a readable message on stderr. `exit` never returns, so
# the `<- ""` nominally supplies the Str the `Left` arm's type wants.
const need_tool! = ([Str] env, Str name): Str -> match find_executable!(env, name) {
	Either.Left(e) -> {
		eprintln("versioning: cannot find `${name}` on PATH")
		exit(1)

		<- ""
	},
	Either.Right(p) -> p,
}

# Read a whole file, or "" if it cannot be read (an absent/empty capture file means "no output").
const read_or_empty! = (Str path): Str -> match read_file!(path) {
	Either.Left(e) -> "",
	Either.Right(s) -> s,
}

# Capture the commits since the previous version on `ring` as `[Commit]`, and report the previous tag
# through `prevtag_out`... — cf has no out-params, so the two callers each need both the commits AND
# the previous tag string. Bundle them.
pub data Range = { Str prevtag, [Commit] commits }

# Gather the previous tag and the commits since it (all of HEAD when there is no prior tag), or die on
# stderr if git cannot be read. `label` is the resolved pre-release label, or "" to diff against the
# most recent tag on ANY ring — the ring-less changelog case, which needs no version lineage.
const gather! = ([Str] env, Str label): Range -> {
	const Str git = need_tool!(env, "git")
	const Str sh = need_tool!(env, "sh")
	const Iarch pid = getpid()
	const Str tagfile = "/tmp/versioning-${pid}.tag"
	const Str logfile = "/tmp/versioning-${pid}.log"

	# The previous version: the most recent tag reachable from HEAD — restricted to this ring's
	# `*-<label>` when a ring is given, else any tag. A non-zero status (no such tag) is the
	# first-release case — the base stays `0.0.0`.
	let Str dcmd = "${git} describe --tags --abbrev=0 > ${tagfile} 2>/dev/null"

	if !eq(label, "") then
	dcmd = "${git} describe --tags --match '*-${label}' --abbrev=0 > ${tagfile} 2>/dev/null"

	const Iarch drc = run!(sh, ["sh", "-c", dcmd], env)

	let Str prevtag = ""

	if drc == 0 then prevtag = read_or_empty!(tagfile) |> trim_end

	remove(tagfile)

	# The commits landed since that tag — or all of HEAD when there is no prior tag. `%h<NUL>%s` is
	# short-sha, subject; NUL separates the two fields (it cannot occur inside commit text). The author
	# is not captured here — the release workflow resolves each sha to a GitHub `@login` after the fact.
	let Str lcmd = "${git} log --format='%h%x00%s' > ${logfile} 2>/dev/null"

	if !eq(prevtag, "") then
	lcmd = "${git} log --format='%h%x00%s' ${prevtag}..HEAD > ${logfile} 2>/dev/null"

	const Iarch lrc = run!(sh, ["sh", "-c", lcmd], env)

	if lrc != 0 then {
		remove(logfile)
		eprintln("versioning: cannot read git history (is this a git repository with commits?)")
		exit(1)
	}

	const Str logtext = read_or_empty!(logfile)

	remove(logfile)

	return Range({ prevtag: prevtag, commits: parse_log(logtext) })
}

# `versioning tag <ring>` — print the next `G.E.N-<label>` tag. The ring is REQUIRED: the version
# both counts against that ring's previous tag and carries its label.
const cmd_tag! = ([Str] env, Str ring): Iarch -> {
	const Str label = ring_label(ring)

	if eq(label, "") then {
		eprintln("versioning: unknown ring `${ring}` (expected nightly|rc|latest|stable)")

		return 2
	}

	const Range r = gather!(env, label)
	const Ver base = parse_ver(r.prevtag)
	const Ver delta = count_kinds(r.commits)

	println(format_tag(bump(base, delta), label))

	return 0
}

# `versioning changelog [ring]` — print the grouped changelog of commits since the previous version.
# The ring is OPTIONAL: with one, the range is that ring's previous `*-<label>` tag; without, it is the
# most recent tag on any ring (a changelog emits no version, so it needs no ring to name one).
const cmd_changelog! = ([Str] env, Str ring, Bool has_ring): Iarch -> {
	let Str label = ""

	if has_ring then {
		label = ring_label(ring)

		if eq(label, "") then {
			eprintln("versioning: unknown ring `${ring}` (expected nightly|rc|latest|stable)")

			return 2
		}
	}

	const Range r = gather!(env, label)

	print(render(r.commits))

	return 0
}

# The whole computation, run under one arena so `main` holds no residue on the root page. `tag` needs
# a ring; `changelog` accepts one but does not require it.
const compute! = ([Str] env, Str sub, Str ring, Bool has_ring): Iarch -> {
	if eq(sub, "tag") then {
		if !has_ring then {
			eprintln("versioning: `tag` needs a ring (nightly|rc|latest|stable)")

			return 2
		}

		return cmd_tag!(env, ring)
	}

	return cmd_changelog!(env, ring, has_ring)
}

pub const main = ([Str] args, [Str] env) -> {
	if Iarch(args.len) < 2 then {
		eprintln("versioning: usage: versioning tag <ring> | versioning changelog [ring]   (ring = nightly|rc|latest|stable)")

		return 2
	}

	const Str sub = args[1]

	if !eq(sub, "tag") && !eq(sub, "changelog") then {
		eprintln("versioning: unknown subcommand `${sub}` (expected tag|changelog)")

		return 2
	}

	let Str ring = ""
	let Bool has_ring = false

	if Iarch(args.len) >= 3 then {
		ring = args[2]
		has_ring = true
	}

	const a = growing_arena::of(16777216)

	return compute!(env, sub, ring, has_ring) in a
}
