# changelog — render a `[Commit]` as a human-readable changelog string. Commits are grouped into the
# four GenVer sections in fixed order (Glory, Enhancement, Nurture, Other), each headed by its count
# and listing `- <title> (<author>) - <sha>` per commit, followed by a Contributors section of the
# unique authors. Order within a section follows git's (newest first); no I/O — the entry point prints
# the returned string.

import std::str::{ eq }
import commit::{ Commit, k_glory, k_enh, k_nur, k_other }

# How many commits carry `kind`.
const count_kind = ([Commit] cs, Iarch kind): Iarch -> {
	let Iarch k = 0
	let Iarch i = 0

	loop {
		if i >= Iarch(cs.len) then break

		const Commit c = cs[i]

		if c.kind == kind then k = k + 1

		i = i + 1
	}

	return k
}

# The bullet lines for one kind: `- <title> (<author>) - <sha>\n` per matching commit, "" if none.
const bullets = ([Commit] cs, Iarch kind): Str -> {
	let Str out = ""
	let Iarch i = 0

	loop {
		if i >= Iarch(cs.len) then break

		const Commit c = cs[i]

		if c.kind == kind then {
			const Str title = c.title
			const Str author = c.author
			const Str sha = c.sha

			out = "${out}- ${title} (${author}) - ${sha}\n"
		}

		i = i + 1
	}

	return out
}

# One `<name> (<count>)` section with its bullets, or "" when the kind has no commits — an empty group
# gets no heading at all. A non-empty section ends in a newline, so `render` joins with one blank line.
const section = (Str name, [Commit] cs, Iarch kind): Str -> {
	const Iarch n = count_kind(cs, kind)

	if n == 0 then return ""

	return "${name} (${n})\n\n${bullets(cs, kind)}"
}

# Is `a` already in `xs`? (Linear — the author set is small.)
const contains = ([Str] xs, Str a): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(xs.len) then break
		if eq(xs[i], a) then return true

		i = i + 1
	}

	return false
}

# The distinct authors across `cs`, in first-appearance order.
const unique_authors = ([Commit] cs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(cs.len) then break

		const Commit c = cs[i]
		const Str a = c.author

		if !contains(out, a) then out = [...out, a]

		i = i + 1
	}

	return out
}

# The `Contributors (<count>)` section listing each unique author once, or "" when there are none.
const contributors = ([Commit] cs): Str -> {
	const [Str] auth = unique_authors(cs)
	const Iarch n = Iarch(auth.len)

	if n == 0 then return ""

	let Str out = "Contributors (${n})\n\n"
	let Iarch i = 0

	loop {
		if i >= n then break

		const Str a = auth[i]

		out = "${out}- ${a}\n"
		i = i + 1
	}

	return out
}

# Append a section to the accumulator, skipping empties and keeping exactly one blank line between the
# sections that survive (each non-empty section already ends in a newline, so a joining "\n" opens the
# blank line before the next heading).
const join_section = (Str acc, Str sec): Str -> {
	if eq(sec, "") then return acc
	if eq(acc, "") then return sec

	return "${acc}\n${sec}"
}

# The whole changelog: the (non-empty) kind sections in fixed order, then the contributors, one blank
# line between each. Groups with no commits contribute nothing — no heading.
pub const render = ([Commit] cs): Str -> {
	let Str out = ""

	out = join_section(out, section("Glory", cs, k_glory))
	out = join_section(out, section("Enhancement", cs, k_enh))
	out = join_section(out, section("Nurture", cs, k_nur))
	out = join_section(out, section("Other", cs, k_other))
	out = join_section(out, contributors(cs))

	return out
}
