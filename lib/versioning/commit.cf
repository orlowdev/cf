# commit — the commit model shared by both subcommands. A `Commit` is one line of git history reduced
# to what versioning cares about: its short sha, its author, its subject title, and its GenVer kind
# (glory / enhancement / nurture / other) read off the subject prefix per
# root/code_style/git_committing.md. `parse_log` turns the raw `git log` capture into `[Commit]`;
# `count_kinds` sums those kinds into a version delta for `tag`; `changelog` groups them for display.

import std::str::{ starts_with }
import genver::{ Ver, split_lines, split_fields }

# The four commit kinds. `Other` is any subject that follows none of the versioning conventions — a
# plain sentence-case change or a merge — and moves no axis.
pub const k_glory = 0
pub const k_enh = 1
pub const k_nur = 2
pub const k_other = 3

pub data Commit = { Str sha, Str author, Str title, Iarch kind }

# The kind of a commit from its subject `title`. `GLORIOUSLY` is verbatim caps, `Enhance`/`Nurture`
# are the capitalised leads of their `<verb> <thing> by <change>` forms — mutually exclusive prefixes,
# so the first match wins and anything else is `Other`.
pub const classify = (Str title): Iarch -> {
	if starts_with(title, "GLORIOUSLY ") then return k_glory
	if starts_with(title, "Enhance ") then return k_enh
	if starts_with(title, "Nurture ") then return k_nur

	return k_other
}

# Parse the raw `git log --format=%h<NUL>%an<NUL>%s` capture into `[Commit]`. Records are newline
# separated (a subject is single-line by convention); the three fields within a record are NUL
# separated. A record without the full three fields (only possible on malformed input) is skipped.
pub const parse_log = (Str raw): [Commit] -> {
	let [Commit] out = []
	const [Str] recs = split_lines(raw)
	let Iarch i = 0

	loop {
		if i >= Iarch(recs.len) then break

		const Str rec = recs[i]
		const [Str] f = split_fields(rec, 0)

		if Iarch(f.len) >= 3 then {
			const Str sha = f[0]
			const Str author = f[1]
			const Str title = f[2]

			out = [...out, Commit({ sha: sha, author: author, title: title, kind: classify(title) })]
		}

		i = i + 1
	}

	return out
}

# Sum the commits by kind into a GenVer delta — the per-axis counts `tag` adds onto the base version.
pub const count_kinds = ([Commit] cs): Ver -> {
	let Iarch g = 0
	let Iarch e = 0
	let Iarch n = 0
	let Iarch i = 0

	loop {
		if i >= Iarch(cs.len) then break

		const Commit c = cs[i]

		if c.kind == k_glory then g = g + 1
		if c.kind == k_enh then e = e + 1
		if c.kind == k_nur then n = n + 1

		i = i + 1
	}

	return Ver({ glory: g, enh: e, nur: n })
}
