# std::math — small pure helpers over the signed machine integer `Iarch`. Everything here is a total
# function on the value it is given: no allocation, no rounding, no failure. Integer only for now;
# floating-point joins as the language grows.

# The absolute value of `x` — its distance from zero, always non-negative. (The most-negative
# `Iarch`
# has no positive counterpart and wraps to itself, the one edge the two's-complement range cannot
# represent.)
pub const abs = (Iarch x): Iarch -> if x < 0 then -x else x

# The larger of `a` and `b` (returns `a` when they are equal).
pub const max = (Iarch a, Iarch b): Iarch -> if a > b then a else b

# The smaller of `a` and `b` (returns `a` when they are equal).
pub const min = (Iarch a, Iarch b): Iarch -> if a < b then a else b
