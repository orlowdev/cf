# std::data::maybe::ops — the composition operators over `Maybe`: they transform one `Maybe` into
# another, so a computation over a possibly-absent value chains without checking for absence at
# every step. Every operator takes the subject `Maybe` LAST, so a value pipes straight through a
# preconfigured chain: `m |> map[...](f) |> chain[...](g)`. A `Nothing` short-circuits: every
# operator passes it through untouched.

import std::data::maybe::{ Maybe }

# Lift a present value: `of(v)` is the `Just` of a fresh `Maybe` — the unit a chain starts from.
pub const of = ['A]('A v): Maybe['A] -> Maybe['A].Just(v)

# Transform the present value with `f`; a `Nothing` passes through untouched.
pub const map = ['A, 'B](('A) -> 'B f, Maybe['A] m): Maybe['B] -> match m {
	Maybe.Just(v) -> Maybe['B].Just(f(v)),
	Maybe.Nothing -> Maybe['B].Nothing,
}

# Sequence a step that may itself come up empty: `f` maps the present value to a whole new `Maybe`,
# so absence at any step collapses into one `Nothing` (the flat-map).
pub const chain = ['A, 'B](('A) -> Maybe['B] f, Maybe['A] m): Maybe['B] -> match m {
	Maybe.Just(v) -> f(v),
	Maybe.Nothing -> Maybe['B].Nothing,
}

# Recover with an alternative: a `Just` stays itself, a `Nothing` is replaced by `fallback`.
pub const alt = ['A](Maybe['A] fallback, Maybe['A] m): Maybe['A] -> match m {
	Maybe.Just(v) -> Maybe['A].Just(v),
	Maybe.Nothing -> fallback,
}

# Keep the value only if it satisfies `pred`; a failing value (and a `Nothing`) yields `Nothing`.
pub const filter = ['A](('A) -> Bool pred, Maybe['A] m): Maybe['A] -> match m {
	Maybe.Just(v) -> if pred(v) then Maybe['A].Just(v) else Maybe['A].Nothing,
	Maybe.Nothing -> Maybe['A].Nothing,
}



# ── tests (testing.md §1: cases live beside the code; `cf test` runs them, other builds discard
# them after type-checking). Tyargs are explicit throughout: inferring a generic-union parameter
# from an annotated binding is an open monomorph gap.
import std::test::{ equals }

case!("of wraps and map transforms a Just", () -> {
	const Maybe[Iarch] j = of(3)
	const Maybe[Iarch] j2 = map[Iarch, Iarch]((n) -> n + 1, j)
	match j2 {
		Maybe.Just(v) -> equals(4, v),
		Maybe.Nothing -> equals(true, false),
	}
})

case!("chain sequences a Just", () -> {
	const Maybe[Iarch] j = of(3)
	const Maybe[Iarch] j2 = chain[Iarch, Iarch]((n) -> of[Iarch](n * 2), j)
	match j2 {
		Maybe.Just(v) -> equals(6, v),
		Maybe.Nothing -> equals(true, false),
	}
})

case!("alt falls back only from Nothing", () -> {
	const Maybe[Iarch] j = of(1)
	const Maybe[Iarch] fb = of(9)
	const Maybe[Iarch] kept = alt[Iarch](fb, j)
	match kept {
		Maybe.Just(v) -> equals(1, v),
		Maybe.Nothing -> equals(true, false),
	}
	const Maybe[Iarch] none = filter[Iarch]((v) -> false, j)
	const Maybe[Iarch] fell = alt[Iarch](fb, none)
	match fell {
		Maybe.Just(v) -> equals(9, v),
		Maybe.Nothing -> equals(true, false),
	}
})

case!("filter drops a Just that fails the predicate", () -> {
	const Maybe[Iarch] j = of(3)
	const Maybe[Iarch] kept = filter[Iarch]((n) -> n > 2, j)
	match kept {
		Maybe.Just(v) -> equals(3, v),
		Maybe.Nothing -> equals(true, false),
	}
	const Maybe[Iarch] dropped = filter[Iarch]((n) -> n > 9, j)
	match dropped {
		Maybe.Just(v) -> equals(true, false),
		Maybe.Nothing -> equals(true, true),
	}
})
