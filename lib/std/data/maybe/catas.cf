# std::data::maybe::catas — the forks out of `Maybe`: each function ELIMINATES the union, handing
# back an ordinary value (where `ops` operators stay inside it). The subject `Maybe` rides LAST, so
# a chain of operators ends `|> or_else[...](dflt)` or `|> fold[...](f, dflt)`.

import std::data::either::{ Either }
import std::data::maybe::{ Maybe }

# The catamorphism: collapse both cases into one result — `f` over a present value, `dflt` for an
# absent one.
pub const fold = ['A, 'B](('A) -> 'B f, 'B dflt, Maybe['A] m): 'B -> match m {
	Maybe.Just(v) -> f(v),
	Maybe.Nothing -> dflt,
}

# The present value, or `dflt` when the `Maybe` is `Nothing`.
pub const or_else = ['A]('A dflt, Maybe['A] m): 'A -> match m {
	Maybe.Just(v) -> v,
	Maybe.Nothing -> dflt,
}

# Explain the absence: a `Just` becomes `Right`, a `Nothing` becomes `Left(on_nothing)` — the
# upgrade path from "absent" to "absent, and here is why".
pub const to_either = ['L, 'A]('L on_nothing, Maybe['A] m): Either['L, 'A] -> match m {
	Maybe.Just(v) -> Either['L, 'A].Right(v),
	Maybe.Nothing -> Either['L, 'A].Left(on_nothing),
}

# The case and the value as `(present, value)`, an absent value filled with `dflt` — for callers
# that want to destructure once instead of matching.
pub const to_tuple = ['A]('A dflt, Maybe['A] m): (Bool, 'A) -> match m {
	Maybe.Just(v) -> (true, v),
	Maybe.Nothing -> (false, dflt),
}

# ── tests (testing.md §1: cases live beside the code; `cf test` runs them, other builds discard
# them after type-checking). Tyargs are explicit throughout: inferring a generic-union parameter
# from an annotated binding is an open monomorph gap.
import std::test::{ equals }
import std::data::maybe::ops::{ of, filter }

case!("fold applies to a Just and defaults a Nothing", () -> {
	const Maybe[Iarch] j = of(3)
	fold[Iarch, Iarch]((n) -> n * 2, 0, j) |> equals(6)
	const Maybe[Iarch] noth = filter[Iarch]((v) -> false, j)
	fold[Iarch, Iarch]((v) -> v * 2, 7, noth) |> equals(7)
})

case!("or_else unwraps or defaults", () -> {
	const Maybe[Iarch] j = of(5)
	or_else[Iarch](9, j) |> equals(5)
	const Maybe[Iarch] noth = filter[Iarch]((v) -> false, j)
	or_else[Iarch](9, noth) |> equals(9)
})

case!("to_either names the absence", () -> {
	const Maybe[Iarch] j = of(5)
	const Either[Str, Iarch] r = to_either[Str, Iarch]("empty", j)

	match r {
		Either.Left(l) -> equals(true, false),
		Either.Right(v) -> equals(5, v),
	}

	const Maybe[Iarch] noth = filter[Iarch]((v) -> false, j)
	const Either[Str, Iarch] l2 = to_either[Str, Iarch]("empty", noth)

	match l2 {
		Either.Left(l) -> equals("empty", l),
		Either.Right(v) -> equals(true, false),
	}
})

case!("to_tuple pairs presence with the value", () -> {
	const Maybe[Iarch] j = of(5)
	const (jhas, jv) = to_tuple[Iarch](0, j)
	equals(true, jhas)
	equals(5, jv)
	const Maybe[Iarch] noth = filter[Iarch]((v) -> false, j)
	const (nhas, nv) = to_tuple[Iarch](0, noth)
	equals(false, nhas)
	equals(0, nv)
})
