# std::data::either — the `Either` carrier itself; its operators live in `ops`, its eliminators in
# `catas`.

# `Either['Left, 'Right]` holds one of exactly two values: a `Left` wrapping a `'Left`, or a `Right`
# wrapping a `'Right`. It is the canonical "one of two outcomes" carrier — by convention `Right` is
# the
# success ("right" = correct) and `Left` is the error or alternative, so a fallible operation
# returns
# `Either[Error, Value]`: the `Right` when it worked, the `Left` explaining why it did not.
pub union Either['Left, 'Right] = {
	# the error or alternative outcome, carrying a `'Left`
	Left('Left),
	# the successful outcome, carrying a `'Right`
	Right('Right),
}
