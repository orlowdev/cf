# std::data::maybe — the `Maybe` carrier itself; its operators live in `ops`, its eliminators in
# `catas`.

# `Maybe['Value]` is a value that may be absent: `Just` wraps a present `'Value`, `Nothing` marks
# its
# absence. Use it when absence is an ordinary result; use `Either` instead when the caller needs to
# know WHY a value is missing.
pub union Maybe['Value] = {
	# the value is present, wrapping a `'Value`
	Just('Value),
	# the value is absent
	Nothing,
}
