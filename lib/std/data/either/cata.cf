# std::data::either::cata — the forks out of `Either`: each function ELIMINATES the union, handing
# back an ordinary value (where `ops` operators stay inside it). The subject `Either` rides LAST,
# so a chain of operators ends `|> or_else[...](dflt)` or `|> fold[...](on_left, on_right)`.

import std::data::{ Either, Maybe }

# The catamorphism: collapse both lanes into one result — `on_left` over a `Left`'s value,
# `on_right` over a `Right`'s.
pub const fold = ['L, 'R, 'B](
	('L) -> 'B on_left,
	('R) -> 'B on_right,
	Either['L, 'R] e,
): 'B -> match e {
	Either.Left(l) -> on_left(l),
	Either.Right(r) -> on_right(r),
}

# The success value, or `dflt` when the `Either` is a `Left`.
pub const or_else = ['L, 'R]('R dflt, Either['L, 'R] e): 'R -> match e {
	Either.Left(l) -> dflt,
	Either.Right(r) -> r,
}

# Forget WHY it failed: a `Right` becomes `Just`, a `Left` collapses to `Nothing`.
pub const to_maybe = ['L, 'R](Either['L, 'R] e): Maybe['R] -> match e {
	Either.Left(l) -> Maybe['R].Nothing,
	Either.Right(r) -> Maybe['R].Just(r),
}

# Both lanes at once as `(left, right)`, the absent lane filled with its default — for callers that
# want to destructure once instead of matching.
pub const to_tuple = ['L, 'R]('L left_dflt, 'R right_dflt, Either['L, 'R] e): ('L, 'R) -> match e {
	Either.Left(l) -> (l, right_dflt),
	Either.Right(r) -> (left_dflt, r),
}
