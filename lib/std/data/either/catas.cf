# std::data::either::catas — the forks out of `Either`: each function ELIMINATES the union, handing
# back an ordinary value (where `ops` operators stay inside it). The subject `Either` rides LAST,
# so a chain of operators ends `|> or_else[...](dflt)` or `|> fold[...](on_left, on_right)`.

import std::data::either::{ Either }
import std::data::maybe::{ Maybe }

# The catamorphism: collapse both lanes into one result — `on_left` over a `Left`'s value,
# `on_right` over a `Right`'s.
pub const fold = ['L, 'R, 'B](('L) -> 'B on_left, ('R) -> 'B on_right, Either['L, 'R] e): 'B -> match e {
	Either.Left(l) -> on_left(l),
	Either.Right(r) -> on_right(r),
}

# The success value, or `dflt` when the `Either` is a `Left`.
pub const or_else = ['L, 'R]('R dflt, Either['L, 'R] e): 'R -> match e {
	Either.Left(l) -> dflt,
	Either.Right(r) -> r,
}

# Forget WHY it failed: a `Right` becomes `Just`, a `Left` collapses to `Nothing`.
pub const to_maybe = ['L, 'R](Either['L, 'R] e): Maybe['R] -> match e {
	Either.Left(l) -> Maybe['R].Nothing,
	Either.Right(r) -> Maybe['R].Just(r),
}

# Both lanes at once as `(left, right)`, the absent lane filled with its default — for callers that
# want to destructure once instead of matching.
pub const to_tuple = ['L, 'R]('L left_dflt, 'R right_dflt, Either['L, 'R] e): ('L, 'R) -> match e {
	Either.Left(l) -> (l, right_dflt),
	Either.Right(r) -> (left_dflt, r),
}

# ── tests (testing.md §1: cases live beside the code; `cf test` runs them, other builds discard
# them after type-checking). Tyargs are explicit throughout: inferring a generic-union parameter
# from an annotated binding is an open monomorph gap.
import std::test::{ equals }
import std::data::either::ops::{ of, of_left }

case!("fold collapses each side through its arm", () -> {
	const Either[Str, Iarch] r = of[Str, Iarch](5)
	fold[Str, Iarch, Iarch]((e) -> 0 - 1, (v) -> v, r) |> equals(5)
	const Either[Str, Iarch] l = of_left[Str, Iarch]("e")
	fold[Str, Iarch, Iarch]((e) -> 0 - 1, (v) -> v, l) |> equals(0 - 1)
})

case!("or_else keeps a right and defaults a left", () -> {
	const Either[Str, Iarch] r = of[Str, Iarch](5)
	or_else[Str, Iarch](9, r) |> equals(5)
	const Either[Str, Iarch] l = of_left[Str, Iarch]("e")
	or_else[Str, Iarch](9, l) |> equals(9)
})

case!("to_maybe forgets the left", () -> {
	const Either[Str, Iarch] r = of[Str, Iarch](5)
	const Maybe[Iarch] j = to_maybe[Str, Iarch](r)

	match j {
		Maybe.Just(v) -> equals(5, v),
		Maybe.Nothing -> equals(true, false),
	}

	const Either[Str, Iarch] l = of_left[Str, Iarch]("e")
	const Maybe[Iarch] n = to_maybe[Str, Iarch](l)

	match n {
		Maybe.Just(v) -> equals(true, false),
		Maybe.Nothing -> equals(true, true),
	}
})

case!("to_tuple fills the absent side with its default", () -> {
	const Either[Str, Iarch] r = of[Str, Iarch](5)
	const (rl, rv) = to_tuple[Str, Iarch]("d", 0, r)
	equals("d", rl)
	equals(5, rv)
	const Either[Str, Iarch] l = of_left[Str, Iarch]("e")
	const (ll, lv) = to_tuple[Str, Iarch]("d", 0, l)
	equals("e", ll)
	equals(0, lv)
})
