# std::data::either::ops — the composition operators over `Either`: they transform one `Either`
# into another, so a computation chains as a sequence of operators. Every operator takes the subject
# `Either` LAST, so a value pipes straight through a preconfigured chain:
# `e |> map[...](f) |> chain[...](g)`. The `Left` short-circuits: an operator over the `Right` lane
# passes a `Left` through untouched, so the first error rides to the end of the chain.

import std::data::either::{ Either }

# Lift a success value: `of(v)` is the `Right` of a fresh `Either` — the unit the `Right` lane
# chains from.
pub const of = ['L, 'R]('R v): Either['L, 'R] -> Either['L, 'R].Right(v)

# Lift an error value: `of_left(e)` is the `Left` counterpart of `of`.
pub const of_left = ['L, 'R]('L e): Either['L, 'R] -> Either['L, 'R].Left(e)

# Transform the `Right` lane: `f` over the success value; a `Left` passes through untouched.
pub const map = ['L, 'A, 'B](('A) -> 'B f, Either['L, 'A] e): Either['L, 'B] -> match e {
	Either.Left(l) -> Either['L, 'B].Left(l),
	Either.Right(r) -> Either['L, 'B].Right(f(r)),
}

# Transform the `Left` lane: `f` over the error value; a `Right` passes through untouched.
pub const map_left = ['A, 'M, 'R](('A) -> 'M f, Either['A, 'R] e): Either['M, 'R] -> match e {
	Either.Left(l) -> Either['M, 'R].Left(f(l)),
	Either.Right(r) -> Either['M, 'R].Right(r),
}

# Transform both lanes at once: `fl` over a `Left`, `fr` over a `Right`.
pub const bimap = ['A, 'B, 'C, 'D](('A) -> 'C fl, ('B) -> 'D fr, Either['A, 'B] e): Either['C, 'D] -> match e {
	Either.Left(l) -> Either['C, 'D].Left(fl(l)),
	Either.Right(r) -> Either['C, 'D].Right(fr(r)),
}

# Sequence a fallible step: `f` maps the success value to a whole new `Either`, so failures at any
# step collapse into one `Left` lane (the flat-map).
pub const chain = ['L, 'A, 'B](('A) -> Either['L, 'B] f, Either['L, 'A] e): Either['L, 'B] -> match e {
	Either.Left(l) -> Either['L, 'B].Left(l),
	Either.Right(r) -> f(r),
}

# Recover with an alternative: a `Right` stays itself, a `Left` is replaced by `fallback`.
pub const alt = ['L, 'R](Either['L, 'R] fallback, Either['L, 'R] e): Either['L, 'R] -> match e {
	Either.Left(l) -> fallback,
	Either.Right(r) -> Either['L, 'R].Right(r),
}

# Exchange the lanes: a `Left` becomes a `Right` and vice versa — useful to run the error lane
# through `Right`-lane operators.
pub const swap = ['L, 'R](Either['L, 'R] e): Either['R, 'L] -> match e {
	Either.Left(l) -> Either['R, 'L].Right(l),
	Either.Right(r) -> Either['R, 'L].Left(r),
}

# ── tests (testing.md §1: cases live beside the code; `cf test` runs them, other builds discard
# them after type-checking). Tyargs are explicit throughout: inferring a generic-union parameter
# from an annotated binding is an open monomorph gap.
import std::test::{ equals }

case!("of and of_left choose the side", () -> {
	const Either[Str, Iarch] r = of[Str, Iarch](3)

	match r {
		Either.Left(e) -> equals(true, false),
		Either.Right(v) -> equals(3, v),
	}

	const Either[Str, Iarch] l = of_left[Str, Iarch]("boom")

	match l {
		Either.Left(e) -> equals("boom", e),
		Either.Right(v) -> equals(true, false),
	}
})

case!("map is right-biased", () -> {
	const Either[Str, Iarch] r = of[Str, Iarch](3)
	const Either[Str, Iarch] r2 = map[Str, Iarch, Iarch]((n) -> n + 1, r)

	match r2 {
		Either.Left(e) -> equals(true, false),
		Either.Right(v) -> equals(4, v),
	}

	const Either[Str, Iarch] l = of_left[Str, Iarch]("e")
	const Either[Str, Iarch] l2 = map[Str, Iarch, Iarch]((n) -> n + 1, l)

	match l2 {
		Either.Left(e) -> equals("e", e),
		Either.Right(v) -> equals(true, false),
	}
})

case!("map_left touches only the left", () -> {
	const Either[Str, Iarch] l = of_left[Str, Iarch]("e")
	const Either[Str, Iarch] l2 = map_left[Str, Str, Iarch]((e) -> "ee", l)

	match l2 {
		Either.Left(e2) -> equals("ee", e2),
		Either.Right(v) -> equals(true, false),
	}

	const Either[Str, Iarch] r = of[Str, Iarch](7)
	const Either[Str, Iarch] r2 = map_left[Str, Str, Iarch]((e) -> "ee", r)

	match r2 {
		Either.Left(e2) -> equals(true, false),
		Either.Right(v) -> equals(7, v),
	}
})

case!("chain sequences and short-circuits on left", () -> {
	const Either[Str, Iarch] r = of[Str, Iarch](3)
	const Either[Str, Iarch] r2 = chain[Str, Iarch, Iarch]((n) -> of[Str, Iarch](n * 2), r)

	match r2 {
		Either.Left(e) -> equals(true, false),
		Either.Right(v) -> equals(6, v),
	}

	const Either[Str, Iarch] l = of_left[Str, Iarch]("e")
	const Either[Str, Iarch] l2 = chain[Str, Iarch, Iarch]((n) -> of[Str, Iarch](n * 2), l)

	match l2 {
		Either.Left(e) -> equals("e", e),
		Either.Right(v) -> equals(true, false),
	}
})

case!("alt falls back only from left, swap flips", () -> {
	const Either[Str, Iarch] r = of[Str, Iarch](1)
	const Either[Str, Iarch] fb = of[Str, Iarch](9)
	const Either[Str, Iarch] kept = alt[Str, Iarch](fb, r)

	match kept {
		Either.Left(e) -> equals(true, false),
		Either.Right(v) -> equals(1, v),
	}

	const Either[Str, Iarch] l = of_left[Str, Iarch]("e")
	const Either[Str, Iarch] fell = alt[Str, Iarch](fb, l)

	match fell {
		Either.Left(e) -> equals(true, false),
		Either.Right(v) -> equals(9, v),
	}

	const Either[Iarch, Str] sw = swap[Str, Iarch](r)

	match sw {
		Either.Left(e) -> equals(1, e),
		Either.Right(v) -> equals(true, false),
	}
})
