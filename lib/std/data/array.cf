# std::data::array — the everyday operations over dynamic `['A]` arrays. Every function takes the
# subject array LAST, so a value pipes straight through a preconfigured chain:
# `xs |> map(f) |> filter(pred)` (the type arguments infer from the function argument's
# signature and the subject array; `map[Iarch, Iarch](f)` stays valid spelled out). A
# function that builds an array returns a
# FRESH one — the input is never mutated or aliased (growing a binding in place stays the
# language-level `xs = [...xs, e]` self-append).

import std::data::maybe::{ Maybe }

# Lift one value: `of(x)` is the single-element array.
pub const of = ['A]('A x): ['A] -> [x]

# A fresh array of `xs`'s elements with `x` appended.
pub const push = ['A]('A x, ['A] xs): ['A] -> [...xs, x]

# A fresh array of `xs`'s elements followed by `tail`'s.
pub const concat = ['A](['A] tail, ['A] xs): ['A] -> [...xs, ...tail]

# Transform every element with `f`, preserving order and length.
pub const map = ['A, 'B](('A) -> 'B f, ['A] xs): ['B] -> {
	let ['B] out = []

	for x in xs {
		out = [...out, f(x)]
	}

	return out
}

# Keep the elements that satisfy `pred`, preserving their order.
pub const filter = ['A](('A) -> Bool pred, ['A] xs): ['A] -> {
	let ['A] out = []

	for x in xs {
		if pred(x) then out = [...out, x]
	}

	return out
}

# Collapse the array left to right: starting from `init`, fold each element in with
# `f(accumulated, element)`.
pub const reduce = ['A, 'B](('B, 'A) -> 'B f, 'B init, ['A] xs): 'B -> {
	let 'B acc = init

	for x in xs {
		acc = f(acc, x)
	}

	return acc
}

# Map every element to a whole array and splice the results into one flat array (the flat-map).
pub const chain = ['A, 'B](('A) -> ['B] f, ['A] xs): ['B] -> {
	let ['B] out = []

	for x in xs {
		out = [...out, ...f(x)]
	}

	return out
}

# One level of nesting removed: the arrays of `xss` spliced into a single array.
pub const flatten = ['A]([['A]] xss): ['A] -> {
	let ['A] out = []

	for inner in xss {
		out = [...out, ...inner]
	}

	return out
}

# The first element satisfying `pred` as a `Maybe` — `Nothing` when no element does.
pub const find = ['A](('A) -> Bool pred, ['A] xs): Maybe['A] -> {
	for x in xs {
		if pred(x) then return Maybe['A].Just(x)
	}

	return Maybe['A].Nothing
}

# The sentinel `find_index` returns when no element satisfies the predicate.
pub const not_found = -1

# The index of the first element satisfying `pred`, or `not_found`.
pub const find_index = ['A](('A) -> Bool pred, ['A] xs): Iarch -> {
	for (x, i) in xs if pred(x) then return i

	return not_found
}

# Does at least one element satisfy `pred`? (An empty array does not.)
pub const some = ['A](('A) -> Bool pred, ['A] xs): Bool -> {
	for x in xs {
		if pred(x) then return true
	}

	return false
}

# Does every element satisfy `pred`? (An empty array does.)
pub const every = ['A](('A) -> Bool pred, ['A] xs): Bool -> {
	for x in xs {
		if !pred(x) then return false
	}

	return true
}

# Is the array empty?
pub const is_empty = ['A](['A] xs): Bool -> Iarch(xs.len) == 0

# The elements in reverse order, as a fresh array: position `i` takes the element mirrored from
# the far end.
pub const reverse = ['A](['A] xs): ['A] -> {
	let ['A] out = []

	for (x, i) in xs {
		out = [...out, xs[Iarch(xs.len) - 1 - i]]
	}

	return out
}

# The element range [start, stop) as a fresh array. The bounds are clamped to the array, so an
# out-of-range request yields the overlap (possibly empty) rather than a trap.
pub const slice = ['A](Iarch start, Iarch stop, ['A] xs): ['A] -> {
	let Iarch a = start
	if a < 0 then a = 0

	let ['A] out = []

	for (x, i) in xs {
		if i >= stop then break
		if i >= a then out = [...out, x]
	}

	return out
}

# The first `n` elements (all of them when `n` exceeds the length).
pub const take = ['A](Iarch n, ['A] xs): ['A] -> slice['A](0, n, xs)

# Everything after the first `n` elements (empty when `n` exceeds the length).
pub const drop = ['A](Iarch n, ['A] xs): ['A] -> slice['A](n, Iarch(xs.len), xs)

# The integers [from, to) in order — `range(0, n)` indexes an n-element array.
pub const range = (Iarch from, Iarch to): [Iarch] -> {
	let [Iarch] out = []
	let Iarch i = from

	loop {
		if i >= to then break
		out = [...out, i]
		i = i + 1
	}

	return out
}

# ── tests (testing.md §1: cases live beside the code; `cf test` runs them, other builds discard
# them after type-checking) ───────────────────────────────────────────────────────────────────
import std::test::{ equals }

case!("of and push build from the right", () -> {
	of(7) |> equals([7])
	push(3, [1, 2]) |> equals([1, 2, 3])
})

case!("concat appends the tail", () -> {
	concat([3, 4], [1, 2]) |> equals([1, 2, 3, 4])
	concat([], [1]) |> equals([1])
})

case!("map transforms every element", () -> {
	map((n) -> n * 2, [1, 2, 3]) |> equals([2, 4, 6])
	map((n) -> n, []) |> equals([])
})

case!("filter keeps what the predicate passes", () -> {
	filter((n) -> n > 1, [1, 2, 3]) |> equals([2, 3])
	filter((n) -> n > 9, [1, 2, 3]) |> equals([])
})

case!("reduce folds left with the seed", () -> {
	reduce((acc, n) -> acc + n, 0, [1, 2, 3]) |> equals(6)
	reduce((acc, n) -> acc + n, 42, []) |> equals(42)
})

case!("chain maps and flattens one level", () -> {
	chain((n) -> [n, n], [1, 2]) |> equals([1, 1, 2, 2])
	flatten([[1], [2, 3]]) |> equals([1, 2, 3])
})

case!("find yields the first hit and find_index its position", () -> {
	const Maybe[Iarch] hit = find((n) -> n > 1, [1, 2, 3])
	match hit {
		Maybe.Just(v) -> equals(2, v),
		Maybe.Nothing -> equals(true, false),
	}
	const Maybe[Iarch] miss = find((n) -> n > 9, [1, 2, 3])
	match miss {
		Maybe.Just(v) -> equals(true, false),
		Maybe.Nothing -> equals(true, true),
	}
	find_index((n) -> n == 2, [1, 2, 3]) |> equals(1)
	find_index((n) -> n == 9, [1, 2, 3]) |> equals(not_found)
})

case!("some and every quantify the predicate", () -> {
	some((n) -> n > 2, [1, 2, 3]) |> equals(true)
	some((n) -> n > 9, [1, 2, 3]) |> equals(false)
	every((n) -> n > 0, [1, 2, 3]) |> equals(true)
	every((n) -> n > 1, [1, 2, 3]) |> equals(false)
	is_empty([1]) |> equals(false)
})

case!("reverse, slice, take, and drop reorder and trim", () -> {
	reverse([1, 2, 3]) |> equals([3, 2, 1])
	slice(1, 3, [1, 2, 3, 4]) |> equals([2, 3])
	take(2, [1, 2, 3]) |> equals([1, 2])
	drop(2, [1, 2, 3]) |> equals([3])
})

case!("range is half-open", () -> {
	range(1, 4) |> equals([1, 2, 3])
	range(2, 2) |> equals([])
})
