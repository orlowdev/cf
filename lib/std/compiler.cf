# std::compiler — the cf compiler as a library.
#
# The whole compile pipeline the ratified specs pin — resolve, check, monomorphize,
# materialize, typecheck, lower, route, emit — behind one call. The `cf` binary is a thin
# CLI over this facade (boot/src/cf.cf); any cf program can `import std::compiler::{ compile! }`
# and drive the same pipeline. The individual stages remain importable as `std::compiler::<stage>`
# for tools that need finer control.

import std::data::{ Either }
import std::data::str::{ eq }
import std::io::console::{ die }
import std::io::file::{ create, close }
import std::io::fd::{ Fd, IoRrr }
import std::sys::{ Os, Arch }
import std::compiler::ast::{ Program }
import std::compiler::diag::{ Diag, sort_diags }
import std::compiler::resolve::{ resolve_program! }
import std::compiler::monomorph::{ mono_program!, MonoOut }
import std::compiler::materialize::{ materialize_program!, Mat }
import std::compiler::typecheck::{ check_program!, check_unreachable! }
import std::compiler::alloc::{ check_alloc_program!, check_root_program! }
import std::compiler::hoist_defertap::{ hoist_defertaps! }
import std::compiler::defer::{ lower_defers! }
import std::compiler::closures::{ lift_program!, check_dropped_captures! }
import std::compiler::routing::{
	routing_tables!,
	routing_check!,
	routing_dump!,
	check_destroy!,
	check_geom_escape!,
	RouteInfo,
}
import std::compiler::emit::{ emit_program! }

# Compile one entry module to QBE IL + an asm floor at `out_qbe`/`out_asm`, targeting
# `<target_os>-<target_arch>` with a `root_size`-byte root page (`dump_routing` prints the
# residue/survivor tables). Returns 0. Allocation runs in the caller's ambient arena — the pass
# products (AST, instances, emitted text) live there and are reclaimed wholesale on scope exit,
# so the caller grafts one growing arena and spends this call `in` it (memory_model §2, §4).
#
# The pipeline mirrors the ratified order (order_of_compilation): resolve the entry and its
# transitive imports into one flattened AST, run the `!` allocation algebra and root-page checks
# PRE-mono (so the color is per SOURCE function), monomorphize, Materialize the std-source
# geometries, typecheck, hoist defer-taps, lower defers, lift closures, compute the routing tables
# ONCE (feeding the oracle tripwire, `--dump-routing`, and emit's classification-at-birth), reject
# unsound geometry teardown/escape, then emit.
#
# TYPE errors come back as VALUES: a non-empty `[Diag]` list (one located error per declaration,
# collected across the whole program) means the program was rejected and nothing was emitted —
# the caller (the CLI edge, an LSP) decides how to present them. An empty list is success.
# Errors in the passes BEFORE typecheck (lexing, parsing, resolution, the `!` algebra, monomorph)
# still `die` fail-fast, as do the two output-file opens.
pub const compile! = (
	Str input,
	Str out_qbe,
	Str out_asm,
	Os target_os,
	Arch target_arch,
	Iarch root_size,
	Bool dump_routing,
	Bool skip_embeds,
	Str build_version,
): [Diag] -> {
	# front end: resolve the entry module and its transitive imports (lexing and parsing
	# each) into one flattened AST — module_system §8
	const Program raw = resolve_program!(input, target_os, target_arch)

	# the `!` allocation algebra, checked both ways (memory_model §5) — UNCONDITIONAL: the whole
	# tree (compiler + lib + corpus) is colored, so there is no flag. Run PRE-mono so the color is
	# per SOURCE function (a generic that may allocate in any instantiation is `!` once).
	# COLLECTED (D2): every mis-colored declaration reports in one run.
	const [Diag] adiags = check_alloc_program!(raw)

	# root-allocation validation (memory_model §2): reject residue placed on the ROOT page —
	# UNCONDITIONAL, no flag. Every program must run its allocating work `in` some arena; only the
	# entry floor (cf_build_args, pre-main) may touch the page. In ZERO-ROOT mode (`--root-size 0` on
	# `Bare`), the rule tightens to reject ANY page use at all — direct residue in `main` and arena
	# grafts alike — so the binary provably never dynamically allocates.
	const Bool zero_root = match target_os { Os.Bare -> root_size == 0, _ -> false }

	const [Diag] rdiags = check_root_program!(raw, zero_root)
	const [Diag] gdiags = sort_diags([...adiags, ...rdiags])

	# a mis-colored program stops HERE, before monomorph: the passes below still die fail-fast
	# on their own rejections, and a die with a pending collected report would MASK it (the
	# known_ty_at lesson) — so gate diags return alone rather than merging with typecheck's
	if Iarch(gdiags.len) > 0 then return gdiags

	# monomorphize generic functions into concrete instances (type_system §8.1) — after this
	# the program has no generic templates, only ordinary functions. COLLECTED (D2): every
	# failed instantiation reports in one run; the pass's output is unusable then (missing
	# instances), so its diags return ALONE — typecheck on the broken table would only add
	# "undefined function" cascades on top.
	const MonoOut mo = mono_program!(raw)

	if Iarch(mo.diags.len) > 0 then return sort_diags(mo.diags)

	const Program mono = mo.prog

	# the Materialize substep of the Memory arc (geometry_lowering §2): duplicate per
	# (fn × geometry) under the std-source geometries, retarget the `in b` seed calls, and
	# mint per-type value-hook instances from the PRE-mono templates (`raw` still holds
	# them). Runs before typecheck so every minted body is checked, lowered, and routed
	# like hand-written source. A program that touches no std-source geometry passes
	# through untouched (one name scan).
	const Mat mm = materialize_program!(mono, raw)
	const Program prog = mm.prog

	# middle: typecheck (rejects type errors before any output is produced) — a rejection
	# returns the collected diagnostics; no output files are touched. The declarations
	# Materialize pruned as unreachable are checked too, against the PRE-materialize tables:
	# uncalled code is still written code, and its errors must not vanish with the pruning.
	const [Diag] tdiags = check_program!(prog, input)
	const [Diag] xdiags = check_unreachable!(mm.dropped, mono.funcs, mono.recs, mono.unions)
	const [Diag] diags = sort_diags([...tdiags, ...xdiags])

	if Iarch(diags.len) > 0 then return diags

	# closures inside pruned declarations still validate their captures — the same fail-fast
	# classification the real lift below applies to live code
	check_dropped_captures!(mm.dropped, mono.recs, mono.funcs)

	# lift `defer`-tap VALUES (`defer f(x)` / `|> defer f`) out of expression position into a
	# snapshot binding + a scheduled `defer` statement (memory_model §6) — before lower_defers, so
	# the emitted `Stmt.Defer`s are lowered like any other
	const Program tapped = hoist_defertaps!(prog)

	# lower `defer` to explicit scope-exit code (memory_model §6): rewrite each `return e` in a
	# defer-bearing function to snapshot the value, run the pending defers (LIFO), then return —
	# before the closure lift, so a `defer f()` calling a local closure is a plain call site
	const Program deferred = lower_defers!(tapped)

	# lower local closures to top-level functions with hidden capture parameters (memory_model
	# §7) — after typecheck (which validated them), before emit
	const Program lowered = lift_program!(deferred)

	# the residue/survivor classification (memory_model §5, geometry_lowering §2-§3), computed
	# ONCE: the same tables feed the oracle tripwire (every `!`-oracle escape must appear in the
	# shadow sets — a divergence is a compiler bug), the `--dump-routing` inspection hatch, and
	# emit's classification-at-birth routing (the duplex node's whole soundness story).
	const RouteInfo ri = routing_tables!(lowered)
	routing_check!(lowered, ri)
	# reject an unsound `<geom>::destroy(b)` — one whose child `b` escapes its frame (geometry_lowering
	# §3): the teardown would dangle the escaped value. Uses the survivor sets routing just computed.
	check_destroy!(lowered, ri)
	# reject a geometry handle that escapes its constructing frame (geometry_lowering §1): a
	# `<geom>::of(...)` node must be spent in place, never returned/rehomed, so materialize can
	# always trace an `... in h` ambient to its constructor (no runtime-dispatch `cf_alloc` fallback).
	check_geom_escape!(lowered)
	if dump_routing then routing_dump!(lowered, ri)

	# back end: emit QBE IL + the asm floor to the two output paths
	const Fd qf = opened(create(out_qbe), "cf: cannot create the QBE output\n")
	const Fd af = opened(create(out_asm), "cf: cannot create the asm output\n")

	emit_program!(
		lowered,
		ri,
		mm.names,
		mm.geoms,
		qf,
		af,
		target_os,
		target_arch,
		root_size,
		skip_embeds,
		build_version,
	)
	close(qf)
	close(af)

	return []
}

# Check one entry module WITHOUT emitting: the full validation pipeline — resolve, the `!`
# and root gates, monomorph, materialize, typecheck (reachable AND pruned declarations),
# the defer/closure lowerings and the routing rejections — returning every collected
# diagnostic, tier by tier exactly as `compile!` would. No output file is touched. The
# passes that still die fail-fast (lexing, parsing, module resolution) die here too, so a
# caller that must survive them (an LSP server) runs this in a CHILD process (`cf check`).
pub const check! = (
	Str input,
	Os target_os,
	Arch target_arch,
	Iarch root_size,
): [Diag] -> {
	const Program raw = resolve_program!(input, target_os, target_arch)
	const [Diag] adiags = check_alloc_program!(raw)

	const Bool zero_root = match target_os { Os.Bare -> root_size == 0, _ -> false }

	const [Diag] rdiags = check_root_program!(raw, zero_root)
	const [Diag] gdiags = sort_diags([...adiags, ...rdiags])

	if Iarch(gdiags.len) > 0 then return gdiags

	const MonoOut mo = mono_program!(raw)

	if Iarch(mo.diags.len) > 0 then return sort_diags(mo.diags)

	const Program mono = mo.prog
	const Mat mm = materialize_program!(mono, raw)
	const Program prog = mm.prog
	const [Diag] tdiags = check_program!(prog, input)
	const [Diag] xdiags = check_unreachable!(mm.dropped, mono.funcs, mono.recs, mono.unions)
	const [Diag] diags = sort_diags([...tdiags, ...xdiags])

	if Iarch(diags.len) > 0 then return diags

	check_dropped_captures!(mm.dropped, mono.recs, mono.funcs)

	const Program tapped = hoist_defertaps!(prog)
	const Program deferred = lower_defers!(tapped)
	const Program lowered = lift_program!(deferred)
	const RouteInfo ri = routing_tables!(lowered)

	routing_check!(lowered, ri)
	check_destroy!(lowered, ri)
	check_geom_escape!(lowered)

	return []
}

# Extract the opened `Fd` from `create`'s outcome, or `die` with `msg` if it failed. `die` never
# returns (it exits), so the trailing `<- Fd(...)` is a nominal yield that satisfies the arm's type.
const opened = (Either[IoRrr, Fd] r, Str msg): Fd -> match r {
	Either.Left(e) -> {
		die(msg)

		<- Fd({ n: Uarch(0) })
	},
	Either.Right(fd) -> fd,
}
