# Process control for arm64/darwin. `exit` traps into the kernel with the BSD `exit` system call
# (number 1), passing the status `code` in `x0`. It never returns — the process is gone before the
# trailing `ret` — so the `: Iarch` result is nominal, present only to satisfy the value-return rule
# at call sites that use `exit` as an expression (e.g. `die`'s `return exit(1)`).
pub const exit = (Iarch code): Iarch -> asm "
	mov x0, ${code}
	mov x16, #1
	svc #0x80
	ret
"
