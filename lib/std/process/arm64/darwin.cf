# Process control for arm64/darwin. `exit` traps into the kernel with the BSD `exit` system call
# (number 1), passing the status `code` in `x0`. It never returns — the process is gone before the
# trailing `ret` — so its result type is `Never`, the bottom type: an `exit(...)` expression fits
# any hole (`return exit(1)`, `x = exit(1)`) and a call for effect diverges (ends control flow).
pub const exit = (Iarch code): Never -> asm "
	mov x0, ${code}
	mov x16, #1
	svc #0x80
	ret
"
