# The freestanding floor barrel: the per-target arena runtime (`cf_root_page_init`/`grow`/`oom`) the
# program links against. Resolve AUTO-INJECTS this into every program (the floor is needed whether or
# not the program names it), and the `comptime_if` fence — folded against the program's `--target` —
# selects the one implementation to load; the losing branches' modules are never opened. This is why
# the floor belongs in stdlib rather than the compiler: here `os::target`/`arch::target` are the
# program's target, so the fence works; inside `emit.cf` they would be frozen to the compiler's host.
#
# A plain `import` (not `pub import ... as *`) is all that's needed: the floor functions are referenced
# by their fixed asm symbols (the entry, and the `raw::grow`/`raw::trap` lowerings), never by cf name,
# so nothing is re-exported — importing the module just loads it so its symbols are emitted. `Bare` is
# absent here on purpose: its static-root floor is still emitted by the compiler (no OS to mmap).
import std::comptime::os
import std::comptime::arch
import std::sys::{ Os, Arch }

if os::target == Os.Darwin then {
	if arch::target == Arch.Amd64 then {
		pub import std::rt::floor::amd64::darwin as *
	} else {
		pub import std::rt::floor::arm64::darwin as *
	}
} else {
	if os::target == Os.Linux then {
		if arch::target == Arch.Riscv64 then {
			pub import std::rt::floor::riscv64::linux as *
		} else {
			if arch::target == Arch.Amd64 then {
				pub import std::rt::floor::amd64::linux as *
			} else {
				pub import std::rt::floor::arm64::linux as *
			}
		}
	}
}
