# The arm64/darwin arena floor — the freestanding runtime the compiler used to hand-write inline.
#
# These are naked, verbatim-symbol asm functions (resolve tags `std::rt::floor::*` so each emits
# under
# its EXACT source symbol, not positional `f<idx>`): the entry and the `raw::grow`/`raw::trap`
# lowerings link to them by fixed name. They take no cf parameters — a `MemoryNode` handle arrives
# in
# `x0` (and a target in `x1` for grow) per the C ABI, read directly from the register. Nothing calls
# them by cf name; they exist so their symbols are defined for the program to link against.
#
# `cf_root_page_init` reserves 4 GiB of address space (PROT_NONE), commits an initial 256 MiB, and
# seeds the `$cf_page` duplex node { top@0, limit@8, aux/committed@24 } plus its residue lane (+40);
# `cf_root_page_grow` commits more backing pages up to round_up(target, 256 MiB);
# `cf_oom`/`cf_mmap_fail`
# exit. darwin/arm64 traps via `svc #0x80` with the call number in `x16`, flags failure in the carry
# bit, and uses Mach-O `_`-prefixed symbols with `@PAGE`/`@PAGEOFF` relocations. mmap = 197,
# mprotect = 74, MAP_ANON|MAP_PRIVATE = 0x1002.

pub const _cf_root_page_init = (): () -> asm "
	mov x0, #0
	mov x1, #0x100000000
	mov x2, #0
	mov x3, #0x1002
	mov x4, #-1
	mov x5, #0
	mov x16, #197
	svc #0x80
	b.cs _cf_mmap_fail
	mov x12, x0
	mov x0, x12
	mov x1, #0x10000000
	mov x2, #3
	mov x16, #74
	svc #0x80
	b.cs _cf_mmap_fail
	adrp x9, _cf_page@PAGE
	add x9, x9, _cf_page@PAGEOFF
	str x12, [x9]
	mov x1, #0x100000000
	add x11, x12, x1
	str x11, [x9, #8]
	mov x1, #0x10000000
	add x13, x12, x1
	str x13, [x9, #24]
	mov x0, #0
	mov x1, #0x40000000
	mov x2, #0
	mov x3, #0x1002
	mov x4, #-1
	mov x5, #0
	mov x16, #197
	svc #0x80
	b.cs _cf_mmap_fail
	mov x12, x0
	mov x0, x12
	mov x1, #0x1000000
	mov x2, #3
	mov x16, #74
	svc #0x80
	b.cs _cf_mmap_fail
	str x12, [x9, #40]
	mov x1, #0x40000000
	add x11, x12, x1
	str x11, [x9, #48]
	mov x1, #0x1000000
	add x13, x12, x1
	str x13, [x9, #64]
	ret
"

pub const _cf_root_page_grow = (): () -> asm "
	add x9, x0, #24
	ldr x10, [x9]
	mov x11, #0x10000000
	sub x12, x11, #1
	add x13, x1, x12
	bic x14, x13, x12
	sub x1, x14, x10
	mov x0, x10
	mov x2, #3
	mov x16, #74
	svc #0x80
	b.cs _cf_mmap_fail
	str x14, [x9]
	ret
"

pub const _cf_mmap_fail = (): () -> asm "
	mov x0, #71
	mov x16, #1
	svc #0x80
"

pub const _cf_oom = (): () -> asm "
	mov x0, #70
	mov x16, #1
	svc #0x80
"

pub const _cf_oos = (): () -> asm "
	mov x0, #72
	mov x16, #1
	svc #0x80
"

pub const _cf_oob = (): () -> asm "
	mov x0, #73
	mov x16, #1
	svc #0x80
"

# The OOS guard-page handler's statics, floor-owned (only the two functions below touch
# them, and floor-side definition keeps the bootstrap clean — a seed-built cf0 that predates
# them still links this floor): the si_addr window [lo, hi] attributing a fault to stack
# overflow ({1, 0} = empty, the pre-init and unlimited-rlimit state — no address matches),
# the zeroed SIG_DFL act for the not-ours re-raise, the scratch act the installer fills, and
# the alternate signal stack the handler runs on (the exhausted thread stack cannot host it).
# The labels are floor-local; the leading label the emitter adds for this pseudo-function
# points harmlessly at the section switch.
pub const _cf_oos_data = (): () -> asm "
	.data
	.balign 8
_cf_oos_win:
	.quad 1
	.quad 0
_cf_oos_dflact:
	.space 32
_cf_oos_actbuf:
	.space 32
	.zerofill __DATA,__bss,_cf_oos_stk,32768,3
	.text
"

# The OOS guard-page handler (the zero-steady-state-cost replacement for the prologue stack
# probes — same observable, `cf_oos` exit 72). `cf_oos_guard_init(anchor)` runs once from
# `main`'s prologue (anchor = main's frame address): it reads RLIMIT_STACK and stores the
# si_addr attribution window [anchor - rlim - 512K, anchor - rlim + 2M] into `_cf_oos_win`
# (the kernel's argv/env strings sit between the anchor and the true stack top, so the true
# bottom lands inside the +2M slack; an unlimited rlimit keeps the empty {1, 0} window —
# faults then stay raw, conservatively), registers the static alternate signal stack (the
# exhausted thread stack cannot host the handler), and installs `cf_oos_handler` for SIGSEGV
# and SIGBUS (darwin delivers guard-page protection faults as either). Installation goes
# through libc `sigaction` — the kernel bounces delivery through libc's private `__sigtramp`,
# so a raw syscall cannot register a handler here; we already link -lSystem for the embedded
# QBE (the one sanctioned libc exception, see the build notes).
pub const _cf_oos_guard_init = (): () -> asm "
	stp x29, x30, [sp, #-64]!
	mov x29, sp
	str x19, [sp, #56]
	mov x19, x0
	mov x0, #3
	add x1, sp, #16
	bl _getrlimit
	ldr x9, [sp, #16]
	adrp x10, _cf_oos_win@PAGE
	add x10, x10, _cf_oos_win@PAGEOFF
	lsr x11, x9, #46
	cbnz x11, 2f
	sub x12, x19, x9
	mov x13, #524288
	sub x13, x12, x13
	str x13, [x10]
	mov x14, #2097152
	add x14, x12, x14
	str x14, [x10, #8]
2:
	adrp x11, _cf_oos_stk@PAGE
	add x11, x11, _cf_oos_stk@PAGEOFF
	str x11, [sp, #16]
	mov x12, #32768
	str x12, [sp, #24]
	str wzr, [sp, #32]
	add x0, sp, #16
	mov x1, #0
	bl _sigaltstack
	adrp x13, _cf_oos_actbuf@PAGE
	add x13, x13, _cf_oos_actbuf@PAGEOFF
	adrp x14, _cf_oos_handler@PAGE
	add x14, x14, _cf_oos_handler@PAGEOFF
	str x14, [x13]
	mov w15, #0x41
	str w15, [x13, #12]
	mov x0, #11
	mov x1, x13
	mov x2, #0
	bl _sigaction
	mov x0, #10
	mov x1, x13
	mov x2, #0
	bl _sigaction
	ldr x19, [sp, #56]
	ldp x29, x30, [sp], #64
	ret
"

# The handler: SA_SIGINFO hands (sig, siginfo*, ucontext*) in x0/x1/x2; darwin's siginfo
# carries the fault address at +24. Inside the window → the stack overflowed → `cf_oos`
# (exit 72, the probe's exact observable). Outside → not ours: reinstall SIG_DFL for this
# signal and return, so the retried instruction dies raw — a wild-pointer crash is never
# masked as OOS. Async-signal territory: compares, one libc sigaction, no allocation.
pub const _cf_oos_handler = (): () -> asm "
	ldr x9, [x1, #24]
	adrp x10, _cf_oos_win@PAGE
	add x10, x10, _cf_oos_win@PAGEOFF
	ldr x11, [x10]
	ldr x12, [x10, #8]
	cmp x9, x11
	b.lo 1f
	cmp x9, x12
	b.hi 1f
	b _cf_oos
1:
	stp x29, x30, [sp, #-16]!
	mov x29, sp
	adrp x1, _cf_oos_dflact@PAGE
	add x1, x1, _cf_oos_dflact@PAGEOFF
	mov x2, #0
	bl _sigaction
	ldp x29, x30, [sp], #16
	ret
"

# The freestanding entry (arm64/darwin). The kernel hands `_start` argc/argv/envp in x0/x1/x2; it
# seeds the root page, then ALWAYS builds argv AND env through the pre-main QBE bridges (the uniform
# entry ABI — `main` receives the node in x0 and args/env in x1/x2, ignoring what it doesn't
# declare),
# calls `main`, and exits via the BSD `exit` syscall (1). Mach-O `_`-prefixed symbols.
pub const _start = (): () -> asm "
	mov x19, x0
	mov x20, x1
	mov x21, x2
	bl _cf_root_page_init
	adrp x0, _cf_page@PAGE
	add x0, x0, _cf_page@PAGEOFF
	mov x1, x19
	mov x2, x20
	bl _cf_build_args
	mov x22, x0
	adrp x0, _cf_page@PAGE
	add x0, x0, _cf_page@PAGEOFF
	mov x1, x21
	bl _cf_build_env
	mov x2, x0
	mov x1, x22
	adrp x0, _cf_page@PAGE
	add x0, x0, _cf_page@PAGEOFF
	bl _main
	mov x16, #1
	svc #0x80
"
