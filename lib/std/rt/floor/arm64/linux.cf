# The arm64/linux arena floor — the same mmap-backed growing root as darwin, over the linux/arm64
# ABI.
#
# Naked, verbatim-symbol asm functions (resolve tags `std::rt::floor::*` so each emits under its
# EXACT
# source symbol): a `MemoryNode` handle arrives in `x0` (target in `x1` for grow), read directly.
# See
# `std::rt::floor::arm64::darwin` for the shared node layout; only the syscall ABI differs here —
# the
# call number goes in `x8`, `svc #0` traps, failure is `-errno` in `x0` (no carry flag, so the fail
# test is `x0` unsigned >= -4096, the threshold parked in x15). mmap = 222, mprotect = 226,
# MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE = 0x4022. ELF symbols carry no leading `_` and use
# `:lo12:`.

pub const cf_root_page_init = (): () -> asm "
	movn x15, #4095
	mov x0, #0
	mov x1, #0x100000000
	mov x2, #0
	mov x3, #0x4022
	mov x4, #-1
	mov x5, #0
	mov x8, #222
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	mov x12, x0
	mov x0, x12
	mov x1, #0x10000000
	mov x2, #3
	mov x8, #226
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	adrp x9, cf_page
	add x9, x9, :lo12:cf_page
	str x12, [x9]
	mov x1, #0x100000000
	add x11, x12, x1
	str x11, [x9, #8]
	mov x1, #0x10000000
	add x13, x12, x1
	str x13, [x9, #24]
	mov x0, #0
	mov x1, #0x40000000
	mov x2, #0
	mov x3, #0x4022
	mov x4, #-1
	mov x5, #0
	mov x8, #222
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	mov x12, x0
	mov x0, x12
	mov x1, #0x1000000
	mov x2, #3
	mov x8, #226
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	str x12, [x9, #40]
	mov x1, #0x40000000
	add x11, x12, x1
	str x11, [x9, #48]
	mov x1, #0x1000000
	add x13, x12, x1
	str x13, [x9, #64]
	ret
"

pub const cf_root_page_grow = (): () -> asm "
	movn x15, #4095
	add x9, x0, #24
	ldr x10, [x9]
	mov x11, #0x10000000
	sub x12, x11, #1
	add x13, x1, x12
	bic x14, x13, x12
	sub x1, x14, x10
	mov x0, x10
	mov x2, #3
	mov x8, #226
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	str x14, [x9]
	ret
"

pub const cf_mmap_fail = (): () -> asm "
	mov x0, #71
	mov x8, #94
	svc #0
"

pub const cf_oom = (): () -> asm "
	mov x0, #70
	mov x8, #94
	svc #0
"

pub const cf_oos = (): () -> asm "
	mov x0, #72
	mov x8, #94
	svc #0
"

pub const cf_oob = (): () -> asm "
	mov x0, #73
	mov x8, #94
	svc #0
"

# The OOS guard-page handler's statics, floor-owned (only the two functions below touch
# them, and floor-side definition keeps the bootstrap clean — a seed-built cf0 that predates
# them still links this floor): the si_addr window ({1, 0} = empty, the pre-init and
# unlimited-rlimit state), the zeroed SIG_DFL act, the scratch act, the alternate signal
# stack. Labels are floor-local; the pseudo-function's leading label points harmlessly at
# the section switch.
pub const cf_oos_data = (): () -> asm "
	.data
	.balign 8
cf_oos_win:
	.quad 1
	.quad 0
cf_oos_dflact:
	.skip 32
cf_oos_actbuf:
	.skip 32
	.bss
	.balign 16
cf_oos_stk:
	.skip 32768
	.text
"

# The OOS guard-page handler (the zero-steady-state-cost replacement for the prologue stack
# probes — same observable, `cf_oos` exit 72). `cf_oos_guard_init(anchor)` runs once from
# `main`'s prologue (anchor = main's frame address): prlimit64 reads RLIMIT_STACK and the
# si_addr attribution window [anchor - rlim - 512K, anchor - rlim + 2M] lands in
# `cf_oos_win` (the kernel's argv/env strings sit between the anchor and the true stack
# top, so the true bottom falls inside the +2M slack; an unlimited rlimit keeps the empty
# {1, 0} window — faults then stay raw, conservatively). The handler runs on a static
# alternate stack (the exhausted thread stack cannot host it); everything is raw syscalls
# (rt_sigaction 134, sigaltstack 132, prlimit64 261) — arm64 needs no SA_RESTORER, the
# kernel supplies its vdso sigreturn.
pub const cf_oos_guard_init = (): () -> asm "
	stp x29, x30, [sp, #-64]!
	mov x29, sp
	mov x9, x0
	mov x0, #0
	mov x1, #3
	mov x2, #0
	add x3, sp, #16
	mov x8, #261
	svc #0
	ldr x10, [sp, #16]
	adrp x11, cf_oos_win
	add x11, x11, :lo12:cf_oos_win
	lsr x12, x10, #46
	cbnz x12, 2f
	sub x13, x9, x10
	mov x14, #524288
	sub x14, x13, x14
	str x14, [x11]
	mov x15, #2097152
	add x15, x13, x15
	str x15, [x11, #8]
2:
	adrp x12, cf_oos_stk
	add x12, x12, :lo12:cf_oos_stk
	str x12, [sp, #16]
	str xzr, [sp, #24]
	mov x13, #32768
	str x13, [sp, #32]
	add x0, sp, #16
	mov x1, #0
	mov x8, #132
	svc #0
	adrp x14, cf_oos_actbuf
	add x14, x14, :lo12:cf_oos_actbuf
	adrp x15, cf_oos_handler
	add x15, x15, :lo12:cf_oos_handler
	str x15, [x14]
	mov x13, #4
	movk x13, #0x0800, lsl #16
	str x13, [x14, #8]
	mov x0, #11
	mov x1, x14
	mov x2, #0
	mov x3, #8
	mov x8, #134
	svc #0
	ldp x29, x30, [sp], #64
	ret
"

# The handler: SA_SIGINFO hands (sig, siginfo*, ucontext*) in x0/x1/x2; linux's siginfo
# carries the fault address at +16. Inside the window → the stack overflowed → `cf_oos`
# (exit 72, the probe's exact observable). Outside → not ours: reinstall SIG_DFL for this
# signal and return, so the retried instruction dies raw — a wild-pointer crash is never
# masked as OOS. Async-signal territory: compares and one raw rt_sigaction.
pub const cf_oos_handler = (): () -> asm "
	ldr x9, [x1, #16]
	adrp x10, cf_oos_win
	add x10, x10, :lo12:cf_oos_win
	ldr x11, [x10]
	ldr x12, [x10, #8]
	cmp x9, x11
	b.lo 1f
	cmp x9, x12
	b.hi 1f
	b cf_oos
1:
	adrp x1, cf_oos_dflact
	add x1, x1, :lo12:cf_oos_dflact
	mov x2, #0
	mov x3, #8
	mov x8, #134
	svc #0
	ret
"

# The freestanding entry (arm64/linux). The kernel lays argc/argv/envp on the STACK ([sp]=argc,
# sp+8=argv[], NULL, envp[], NULL, auxv), not registers — so `_start` reads them into callee-saved
# x19/x20/x21, initializes the embedded QBE's libc (musl), seeds the root page, then ALWAYS builds
# argv AND env through the pre-main bridges (the uniform entry ABI; `main` ignores what it doesn't
# declare), calls `main`, exits via exit_group (94).
#
# cf's own code is freestanding (raw syscalls, no libc), but the embedded QBE is C that uses libc.
# On
# linux that libc is static musl, which — unlike darwin's libSystem — needs its TLS/auxv/page-size
# set
# up before any call. So `_start` (still the entry — no crt, no hosted `main`) calls musl's own
# `__init_libc(envp, argv[0])` first; x19-x21 are callee-saved across it. envp is x21, argv[0] is
# [x20].
#
# This floor is SHARED with ordinary cf programs, which are freestanding (no libc). So `__init_libc`
# is
# a WEAK reference read through the GOT and guarded by a null check: for a plain program the symbol
# is
# undefined-weak and its GOT slot is 0, so the call is skipped (an `adrp`+`add` can't represent
# absolute
# 0 — the GOT slot can). Only cf's OWN build links static musl and passes `-Wl,-u,__init_libc`
# (build.sh), which force-pulls musl's real `__init_libc`, filling the GOT slot so the guard runs
# it.
pub const _start = (): () -> asm "
	.weak __init_libc
	ldr x19, [sp]
	add x20, sp, #8
	add x21, x20, x19, lsl #3
	add x21, x21, #8
	adrp x2, :got:__init_libc
	ldr x2, [x2, :got_lo12:__init_libc]
	cbz x2, 1f
	mov x0, x21
	ldr x1, [x20]
	blr x2
1:
	bl cf_root_page_init
	adrp x0, cf_page
	add x0, x0, :lo12:cf_page
	mov x1, x19
	mov x2, x20
	bl cf_build_args
	mov x22, x0
	adrp x0, cf_page
	add x0, x0, :lo12:cf_page
	mov x1, x21
	bl cf_build_env
	mov x2, x0
	mov x1, x22
	adrp x0, cf_page
	add x0, x0, :lo12:cf_page
	bl main
	mov x8, #94
	svc #0
"
