# The arm64/linux arena floor — the same mmap-backed growing root as darwin, over the linux/arm64 ABI.
#
# Naked, verbatim-symbol asm functions (resolve tags `std::rt::floor::*` so each emits under its EXACT
# source symbol): a `MemoryNode` handle arrives in `x0` (target in `x1` for grow), read directly. See
# `std::rt::floor::arm64::darwin` for the shared node layout; only the syscall ABI differs here — the
# call number goes in `x8`, `svc #0` traps, failure is `-errno` in `x0` (no carry flag, so the fail
# test is `x0` unsigned >= -4096, the threshold parked in x15). mmap = 222, mprotect = 226,
# MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE = 0x4022. ELF symbols carry no leading `_` and use `:lo12:`.

pub const cf_root_page_init = (): () -> asm "
	movn x15, #4095
	mov x0, #0
	mov x1, #0x100000000
	mov x2, #0
	mov x3, #0x4022
	mov x4, #-1
	mov x5, #0
	mov x8, #222
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	mov x12, x0
	mov x0, x12
	mov x1, #0x10000000
	mov x2, #3
	mov x8, #226
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	adrp x9, cf_page
	add x9, x9, :lo12:cf_page
	str x12, [x9]
	mov x1, #0x100000000
	add x11, x12, x1
	str x11, [x9, #8]
	mov x1, #0x10000000
	add x13, x12, x1
	str x13, [x9, #24]
	mov x0, #0
	mov x1, #0x40000000
	mov x2, #0
	mov x3, #0x4022
	mov x4, #-1
	mov x5, #0
	mov x8, #222
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	mov x12, x0
	mov x0, x12
	mov x1, #0x1000000
	mov x2, #3
	mov x8, #226
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	str x12, [x9, #40]
	mov x1, #0x40000000
	add x11, x12, x1
	str x11, [x9, #48]
	mov x1, #0x1000000
	add x13, x12, x1
	str x13, [x9, #64]
	ret
"

pub const cf_root_page_grow = (): () -> asm "
	movn x15, #4095
	add x9, x0, #24
	ldr x10, [x9]
	mov x11, #0x10000000
	sub x12, x11, #1
	add x13, x1, x12
	bic x14, x13, x12
	sub x1, x14, x10
	mov x0, x10
	mov x2, #3
	mov x8, #226
	svc #0
	cmp x0, x15
	b.hs cf_mmap_fail
	str x14, [x9]
	ret
"

pub const cf_mmap_fail = (): () -> asm "
	mov x0, #71
	mov x8, #94
	svc #0
"

pub const cf_oom = (): () -> asm "
	mov x0, #70
	mov x8, #94
	svc #0
"

# The freestanding entry (arm64/linux). The kernel lays argc/argv/envp on the STACK ([sp]=argc,
# sp+8=argv[], NULL, envp[], NULL, auxv), not registers — so `_start` reads them into callee-saved
# x19/x20/x21, seeds the root page, then ALWAYS builds argv AND env through the pre-main bridges (the
# uniform entry ABI; `main` ignores what it doesn't declare), calls `main`, exits via exit_group (94).
pub const _start = (): () -> asm "
	ldr x19, [sp]
	add x20, sp, #8
	add x21, x20, x19, lsl #3
	add x21, x21, #8
	bl cf_root_page_init
	adrp x0, cf_page
	add x0, x0, :lo12:cf_page
	mov x1, x19
	mov x2, x20
	bl cf_build_args
	mov x22, x0
	adrp x0, cf_page
	add x0, x0, :lo12:cf_page
	mov x1, x21
	bl cf_build_env
	mov x2, x0
	mov x1, x22
	adrp x0, cf_page
	add x0, x0, :lo12:cf_page
	bl main
	mov x8, #94
	svc #0
"
