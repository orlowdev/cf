# The riscv64/linux arena floor — the same mmap-backed growing root, in the RISC-V ISA.
#
# Naked, verbatim-symbol asm functions (resolve tags `std::rt::floor::*` so each emits under its EXACT
# source symbol): a `MemoryNode` handle arrives in `a0` (target in `a1` for grow), read directly. Same
# node layout and syscall numbers as arm64/linux (linux's generic ABI) — only the ISA differs: the
# call number goes in `a7`, `ecall` traps, failure is `-errno` in `a0` (fail test `a0` unsigned >=
# -4096, threshold in t6). mmap = 222, mprotect = 226, MAP_PRIVATE|ANON|NORESERVE = 0x4022. `la` loads
# symbol addresses; a0-a7 args, t0-t6 temps (nothing callee-saved is touched — call-clobber clean).

pub const cf_root_page_init = (): () -> asm "
	li t6, -4096
	li a0, 0
	li a1, 0x100000000
	li a2, 0
	li a3, 0x4022
	li a4, -1
	li a5, 0
	li a7, 222
	ecall
	bgeu a0, t6, cf_mmap_fail
	mv t0, a0
	mv a0, t0
	li a1, 0x10000000
	li a2, 3
	li a7, 226
	ecall
	bgeu a0, t6, cf_mmap_fail
	la t1, cf_page
	sd t0, 0(t1)
	li a1, 0x100000000
	add t2, t0, a1
	sd t2, 8(t1)
	li a1, 0x10000000
	add t3, t0, a1
	sd t3, 24(t1)
	li a0, 0
	li a1, 0x40000000
	li a2, 0
	li a3, 0x4022
	li a4, -1
	li a5, 0
	li a7, 222
	ecall
	bgeu a0, t6, cf_mmap_fail
	mv t0, a0
	mv a0, t0
	li a1, 0x1000000
	li a2, 3
	li a7, 226
	ecall
	bgeu a0, t6, cf_mmap_fail
	sd t0, 40(t1)
	li a1, 0x40000000
	add t2, t0, a1
	sd t2, 48(t1)
	li a1, 0x1000000
	add t3, t0, a1
	sd t3, 64(t1)
	ret
"

pub const cf_root_page_grow = (): () -> asm "
	li t6, -4096
	addi t1, a0, 24
	ld t2, 0(t1)
	li t3, 0x10000000
	addi t4, t3, -1
	add t5, a1, t4
	not t0, t4
	and t5, t5, t0
	sub a1, t5, t2
	mv a0, t2
	li a2, 3
	li a7, 226
	ecall
	bgeu a0, t6, cf_mmap_fail
	sd t5, 0(t1)
	ret
"

pub const cf_mmap_fail = (): () -> asm "
	li a0, 71
	li a7, 94
	ecall
"

pub const cf_oom = (): () -> asm "
	li a0, 70
	li a7, 94
	ecall
"

# The freestanding entry (riscv64/linux). Same stack layout as arm64/linux ([sp]=argc, argv=sp+8,
# envp after argv's NULL) read into callee-saved s1/s2/s3; seeds the root page, then ALWAYS builds
# argv AND env through the pre-main bridges (uniform entry ABI; `main` ignores what it doesn't
# declare), calls `main`, exits via exit_group (94). ELF; args in a0-a7, `la` for addresses.
pub const _start = (): () -> asm "
	ld s1, 0(sp)
	addi s2, sp, 8
	slli t0, s1, 3
	add t0, s2, t0
	addi s3, t0, 8
	call cf_root_page_init
	la a0, cf_page
	mv a1, s1
	mv a2, s2
	call cf_build_args
	mv s4, a0
	la a0, cf_page
	mv a1, s3
	call cf_build_env
	mv a2, a0
	mv a1, s4
	la a0, cf_page
	call main
	li a7, 94
	ecall
"
