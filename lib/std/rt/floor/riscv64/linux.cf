# The riscv64/linux arena floor — the same mmap-backed growing root, in the RISC-V ISA.
#
# Naked, verbatim-symbol asm functions (resolve tags `std::rt::floor::*` so each emits under its
# EXACT
# source symbol): a `MemoryNode` handle arrives in `a0` (target in `a1` for grow), read directly.
# Same
# node layout and syscall numbers as arm64/linux (linux's generic ABI) — only the ISA differs: the
# call number goes in `a7`, `ecall` traps, failure is `-errno` in `a0` (fail test `a0` unsigned >=
# -4096, threshold in t6). mmap = 222, mprotect = 226, MAP_PRIVATE|ANON|NORESERVE = 0x4022. `la`
# loads
# symbol addresses; a0-a7 args, t0-t6 temps (nothing callee-saved is touched — call-clobber clean).

pub const cf_root_page_init = (): () -> asm "
	li t6, -4096
	li a0, 0
	li a1, 0x100000000
	li a2, 0
	li a3, 0x4022
	li a4, -1
	li a5, 0
	li a7, 222
	ecall
	bgeu a0, t6, cf_mmap_fail
	mv t0, a0
	mv a0, t0
	li a1, 0x10000000
	li a2, 3
	li a7, 226
	ecall
	bgeu a0, t6, cf_mmap_fail
	la t1, cf_page
	sd t0, 0(t1)
	li a1, 0x100000000
	add t2, t0, a1
	sd t2, 8(t1)
	li a1, 0x10000000
	add t3, t0, a1
	sd t3, 24(t1)
	li a0, 0
	li a1, 0x40000000
	li a2, 0
	li a3, 0x4022
	li a4, -1
	li a5, 0
	li a7, 222
	ecall
	bgeu a0, t6, cf_mmap_fail
	mv t0, a0
	mv a0, t0
	li a1, 0x1000000
	li a2, 3
	li a7, 226
	ecall
	bgeu a0, t6, cf_mmap_fail
	sd t0, 40(t1)
	li a1, 0x40000000
	add t2, t0, a1
	sd t2, 48(t1)
	li a1, 0x1000000
	add t3, t0, a1
	sd t3, 64(t1)
	ret
"

pub const cf_root_page_grow = (): () -> asm "
	li t6, -4096
	addi t1, a0, 24
	ld t2, 0(t1)
	li t3, 0x10000000
	addi t4, t3, -1
	add t5, a1, t4
	not t0, t4
	and t5, t5, t0
	sub a1, t5, t2
	mv a0, t2
	li a2, 3
	li a7, 226
	ecall
	bgeu a0, t6, cf_mmap_fail
	sd t5, 0(t1)
	ret
"

pub const cf_mmap_fail = (): () -> asm "
	li a0, 71
	li a7, 94
	ecall
"

pub const cf_oom = (): () -> asm "
	li a0, 70
	li a7, 94
	ecall
"

pub const cf_oos = (): () -> asm "
	li a0, 72
	li a7, 94
	ecall
"

pub const cf_oob = (): () -> asm "
	li a0, 73
	li a7, 94
	ecall
"

# The OOS guard-page handler's statics — see the arm64/linux floor for the full story.
pub const cf_oos_data = (): () -> asm "
	.data
	.balign 8
cf_oos_win:
	.quad 1
	.quad 0
cf_oos_dflact:
	.skip 32
cf_oos_actbuf:
	.skip 32
	.bss
	.balign 16
cf_oos_stk:
	.skip 32768
	.text
"

# The OOS guard-page handler — see the arm64/linux floor for the full story; riscv64 shares
# the generic syscall numbers (rt_sigaction 134, sigaltstack 132, prlimit64 261), the kernel
# struct layouts, and the no-SA_RESTORER delivery, so this is the same machine in riscv
# mnemonics. `cf_oos_guard_init(anchor)` stores the rlimit-derived si_addr window (an
# unlimited rlimit keeps the empty {1, 0} data default — faults stay raw), registers the
# static alternate stack, installs `cf_oos_handler` for SIGSEGV.
pub const cf_oos_guard_init = (): () -> asm "
	addi sp, sp, -64
	sd ra, 56(sp)
	mv t0, a0
	li a0, 0
	li a1, 3
	li a2, 0
	addi a3, sp, 16
	li a7, 261
	ecall
	ld t1, 16(sp)
	lla t2, cf_oos_win
	srli t3, t1, 46
	bnez t3, 2f
	sub t4, t0, t1
	li t5, 524288
	sub t5, t4, t5
	sd t5, 0(t2)
	li t6, 2097152
	add t6, t4, t6
	sd t6, 8(t2)
2:
	lla t3, cf_oos_stk
	sd t3, 16(sp)
	sd zero, 24(sp)
	li t4, 32768
	sd t4, 32(sp)
	addi a0, sp, 16
	li a1, 0
	li a7, 132
	ecall
	lla t5, cf_oos_actbuf
	lla t6, cf_oos_handler
	sd t6, 0(t5)
	li t4, 0x08000004
	sd t4, 8(t5)
	li a0, 11
	mv a1, t5
	li a2, 0
	li a3, 8
	li a7, 134
	ecall
	ld ra, 56(sp)
	addi sp, sp, 64
	ret
"

# SA_SIGINFO hands (sig, siginfo*, ucontext*) in a0/a1/a2; si_addr sits at +16. Inside the
# window → `cf_oos` (exit 72); outside → reinstall SIG_DFL and return so the retry dies raw.
pub const cf_oos_handler = (): () -> asm "
	ld t0, 16(a1)
	lla t1, cf_oos_win
	ld t2, 0(t1)
	ld t3, 8(t1)
	bltu t0, t2, 1f
	bgtu t0, t3, 1f
	j cf_oos
1:
	lla a1, cf_oos_dflact
	li a2, 0
	li a3, 8
	li a7, 134
	ecall
	ret
"

# The freestanding entry (riscv64/linux). Same stack layout as arm64/linux ([sp]=argc, argv=sp+8,
# envp after argv's NULL) read into callee-saved s1/s2/s3; inits the embedded QBE's libc, seeds the
# root page, then ALWAYS builds argv AND env through the pre-main bridges (uniform entry ABI; `main`
# ignores what it doesn't declare), calls `main`, exits via exit_group (94). ELF; args in a0-a7.
#
# As on arm64/linux, the embedded QBE's static musl needs `__init_libc(envp, argv[0])` before any
# call,
# and this floor is shared with freestanding (libc-less) programs — so `__init_libc` is a WEAK ref
# read
# through the GOT and null-guarded (its GOT slot is 0 when undefined-weak, so a plain program skips
# it).
# cf's own build force-pulls musl's real one with `-Wl,-u,__init_libc`. envp is s3, argv[0] is [s2].
#
# Two RISC-V specifics before that: set `gp` (the global pointer) — musl is built with linker
# relaxation
# and addresses globals gp-relative, so an unset gp faults; and cf's build links `-no-pie` (this
# custom
# `_start` does no PIE self-relocation, and some musl toolchains default to static-PIE).
pub const _start = (): () -> asm "
	.option push
	.option norelax
	lla gp, __global_pointer$
	.option pop
	.weak __init_libc
	ld s1, 0(sp)
	addi s2, sp, 8
	slli t0, s1, 3
	add t0, s2, t0
	addi s3, t0, 8
1:
	auipc t0, %got_pcrel_hi(__init_libc)
	ld t0, %pcrel_lo(1b)(t0)
	beqz t0, 2f
	mv a0, s3
	ld a1, 0(s2)
	jalr t0
2:
	call cf_root_page_init
	la a0, cf_page
	mv a1, s1
	mv a2, s2
	call cf_build_args
	mv s4, a0
	la a0, cf_page
	mv a1, s3
	call cf_build_env
	mv a2, a0
	mv a1, s4
	la a0, cf_page
	call main
	li a7, 94
	ecall
"
