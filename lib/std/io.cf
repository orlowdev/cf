# std::io — the everyday I/O surface in one place. The pieces keep their own modules — `fd` (the
# descriptor and error types), `file` (whole-file and descriptor reads/writes), `fs` (the
# filesystem), `console` (the standard streams), `term` (the terminal) — and this barrel forwards
# them as namespaces, so `import std::io` opens `io::console::println`, `io::fd::Fd`, and the rest
# without per-module spelunking.

pub import std::io::fd
pub import std::io::console
pub import std::io::file
pub import std::io::fs
pub import std::io::term
