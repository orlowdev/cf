# std::io — the everyday I/O surface in one place. The pieces keep their own modules — `fd` (the
# descriptor and error types), `file` (whole-file and descriptor reads/writes), `fs` (the
# filesystem), `console` (the standard streams), `term` (the terminal) — and this barrel re-exports
# the common names, so `import std::io::{ read_file!, println, Fd }` needs no per-module spelunking.

pub import std::io::fd::{ Fd, IoRrr, DirEntry, entry_is_dir, stdin, stdout, stderr }
pub import std::io::console::{ print, println, eprint, eprintln, die }
pub import std::io::file::{ read_file! }
pub import std::io::fs::{ read_dir! }
