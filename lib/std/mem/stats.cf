# std/mem/stats — the instrumented build's allocation-accounting query (the debug arc).
#
# Under `--instrument` the arena geometries carve EXTENDED duplex headers — count@72,
# bytes@80, pulls@88 — and their reserves maintain the counters; `arena(a)` reads them
# back off a handle: how many reservations the arena served, how many bytes they summed
# to, and (elastic only) how many times it pulled a fresh block from its parent — the
# numbers that size a `fixed_arena` ceiling or tune a `growing_arena` quantum. In a
# plain build the counters do not exist and the query folds to zeros at comptime —
# no header read, no cost, same program shape.
import std::mem::raw
import std::comptime::build

if build::instrument then {
	# (reservations, bytes reserved, parent pulls) of the arena behind `node`
	pub const arena = (Uarch node): (Iarch, Iarch, Iarch) ->
		(Iarch(raw::load(node + 72)), Iarch(raw::load(node + 80)), Iarch(raw::load(node + 88)))
} else {
	pub const arena = (Uarch node): (Iarch, Iarch, Iarch) -> (0, 0, 0)
}
