# std/mem/probe — the raw-memory substrate's regression surface (geometry-modules arc,
# stage 0). Not a geometry: plain pub functions exercising the privileged ops
# (`mem.raw.addr/load/store/place`, `size_of`) so the corpus can drive them from tests.
# `mem.raw` parses only under `std/mem/…`, so this module is the one userland door to it.

pub data Probe = { Iarch a, Iarch b }

# A store/load roundtrip through the buffer's DATA pointer: `addr` yields the value's
# representation address — for a `[Uint8]` that is its `{data,len,cap}` header, so the
# first word loaded IS the byte storage's address. Returns the word read back raw.
pub const raw_roundtrip = ([Uint8] buf, Uarch v): Uarch -> {
	const Uarch data = mem.raw.load(mem.raw.addr(buf))
	mem.raw.store(data, v)
	return mem.raw.load(data)
}

# The byte size of a Probe's representation (two 8-byte field slots).
pub const probe_size = (Probe p): Uarch -> size_of(p)

# Place a record into the buffer's data bytes and hand back the placed copy — the copy
# lives in the caller's buffer, so its fields read back through raw storage.
pub const place_probe = ([Uint8] buf, Probe p): Probe -> {
	const Uarch data = mem.raw.load(mem.raw.addr(buf))
	return mem.raw.place(data, p)
}
