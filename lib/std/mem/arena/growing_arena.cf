# std/mem/arena/elastic_arena — the ELASTIC carved bump geometry (geometry_lowering §5): the
# `el` half of the old two-shape `arena`. `mem.arena.grow(n)` carves an elastic arena from the
# ambient node — its survivor (kind 1) bumps within its block and PULLS a fresh n-sized block
# from the parent on overflow; its residue is a lazy private chain (kind 1, empty triple) that
# pulls its own chunks. An elastic arena has NO shared two-ended block (a survivor that pulls
# away would let a still-linked residue clobber its limit — see the merged module's history).
# Splitting fixed from elastic makes every reserve MONOMORPHIC: the constructor picks the
# shape at comptime, so the reserves never test `node+32`/`node+80`.
#
# Duplex header (96 bytes, shared with the whole bump family):
#   node+0  survivor { top, committed, limit, parent, kind, chunk }
#   node+48 residue  { top, committed, limit, parent, kind, chunk }
#
# Auto-loaded on any `mem.arena.grow` use; the constructor is `of` (each geometry names its
# constructor `of` — the `.grow` surface selects THIS module), everything called by mangled
# name (`of__el`, `reserve_ret__el`, …); nothing is `pub`. The pull slow path allocates from
# the PARENT node, whose geometry is a comptime fact of the ambient nesting but is currently
# reached through the runtime-dispatching `mem.raw.alloc` (a Stage-3 shortcut; the parent-axis
# specialization that retires it is a later slice of the legacy sweep).

# `growing_arena.of(n)` — the constructor SURFACE: a bodyless intrinsic, a token the user imports
# and calls with only the args THEY provide. The compiler supplies the whole behavior at the
# call site, spending the ambient node it already holds on the placed `carve` below.
pub intrinsic of = (Uarch n): Uarch

# Carve a GROWING (elastic) arena: survivor kind 1 / chunk n over the whole
# initial block; residue the lazy private chain (kind 1, empty triple, chunk n).
# `node` is compiler-supplied (the ambient parent) when lowering an `of(n)` call.
const carve = (Uarch node, Uarch n): Uarch -> {
	const Uarch r = (n + 7) % 8
	const Uarch sz = n + 7 - r
	const Uarch hdr = mem.raw.alloc(node, 96)
	const Uarch blk = mem.raw.alloc(node, sz)
	const Uarch end = blk + sz
	mem.raw.store(hdr, blk)
	mem.raw.store(hdr + 8, end)
	mem.raw.store(hdr + 16, end)
	mem.raw.store(hdr + 24, node)
	mem.raw.store(hdr + 32, 1)
	mem.raw.store(hdr + 40, sz)
	mem.raw.store(hdr + 48, 0)
	mem.raw.store(hdr + 56, 0)
	mem.raw.store(hdr + 64, 0)
	mem.raw.store(hdr + 72, node)
	mem.raw.store(hdr + 80, 1)
	mem.raw.store(hdr + 88, sz)
	return hdr
}

# An elastic subnode's grow step (≡ the floor's cf_arena_pull): pull a fresh block — the larger
# of the subnode's chunk and the request — from the parent and reset the triple to it. The old
# block leaks into the parent (no per-object free); returned pointers stay valid.
const pull = (Uarch sub, Uarch sz): Uarch -> {
	const Uarch chunk = mem.raw.load(sub + 40)
	let Uarch bs = sz
	if chunk > sz then bs = chunk
	const Uarch parent = mem.raw.load(sub + 24)
	const Uarch blk = mem.raw.alloc(parent, bs)
	mem.raw.store(sub, blk)
	mem.raw.store(sub + 8, blk + bs)
	mem.raw.store(sub + 16, blk + bs)
	return 0
}

# Reserve `sz` on the SURVIVOR side — `on_ret` minus the copy. An elastic survivor (kind 1)
# bumps within its block and pulls a fresh chunk on overflow. Monomorphic: no kind test.
const reserve_ret = (Uarch node, Uarch sz): Uarch -> {
	let Uarch p = mem.raw.load(node)
	if p + sz > mem.raw.load(node + 16) then {
		pull(node, sz)
		p = mem.raw.load(node)
	}
	mem.raw.store(node, p + sz)
	return p
}

# Reserve `sz` on the RESIDUE side — `on_alloc` minus the copy. An elastic residue (kind 1)
# bumps up its private chain (at node+48), pulling its first/next chunk from the parent as
# needed. Monomorphic: no kind test.
const reserve_alloc = (Uarch node, Uarch sz): Uarch -> {
	const Uarch r = node + 48
	let Uarch p = mem.raw.load(r)
	if p + sz > mem.raw.load(r + 16) then {
		pull(r, sz)
		p = mem.raw.load(r)
	}
	mem.raw.store(r, p + sz)
	return p
}

# ── the scope bracket (geometry_lowering §2) ─────────────────────────────────────────────
# An elastic residue can pull mid-scope, so a bare top is not a sound mark: the exit must know
# the block it landed in. The mark is a 16-byte {top, limit} record bumped on the residue side
# itself; exit restores only when the saved limit is unchanged (no pull happened), else it
# skips, leaking the marked interval once (the floor cf_reset regime). Emit does NOT place
# these yet — the record leaks 16 bytes per `!` call under loops with no own residue (hundreds
# of MB on a self-compile), so elastic brackets stay on the floor triple + cf_reset until a
# leak-free one-word elastic mark design lands. These bodies are the placed contract.
const on_scope_enter = (Uarch node): Uarch -> {
	const Uarch m = reserve_alloc(node, 16)
	mem.raw.store(m, mem.raw.load(node + 48))
	mem.raw.store(m + 8, mem.raw.load(node + 64))
	return m
}

const on_scope_exit = (Uarch node, Uarch mark): Uarch -> {
	const Uarch t0 = mem.raw.load(mark)
	const Uarch l0 = mem.raw.load(mark + 8)
	if mem.raw.load(node + 64) == l0 then mem.raw.store(node + 48, t0)
	return 0
}

# ── the value hooks (geometry_lowering §1) ───────────────────────────────────────────────
# Fold-lite fuses these into reserve + build-in-place; the bodies serve the sites a
# pre-constructed value must genuinely relocate through. on_alloc_ret is the identity — the
# callee's survivor side outlives the call (the bump family's claim fold).
const on_alloc = ['T](Uarch node, 'T v): 'T -> mem.raw.place(reserve_alloc(node, size_of(v)), v)

const on_ret = ['T](Uarch node, 'T v): 'T -> mem.raw.place(reserve_ret(node, size_of(v)), v)

const on_alloc_ret = ['T](Uarch node, 'T v): 'T -> v
