# std/mem/arena/test_arena — the CASE geometry (testing.md §3). Structurally it IS a growing arena —
# bump allocation, elastic overflow, the standard duplex node — so the case body reserves through
# the
# `el` hooks (materialize folds a te body to el) and `of` carves the same node. What makes it a
# DISTINCT geometry is its teardown: where a plain arena's `destroy` only rewinds,
# `test_arena::destroy`
# REPORTS. It is a context CONSUMER — it `consume`s the verdict accumulator the case provided and
# dumps
# the case's verdict, then reclaims the block. No pointer is threaded or parked: the accumulator is
# in
# context, right where the case put it.
#
# The user never names this module: `std::test::case!` opens it. A shipped binary never takes the
# test
# route, so it costs the artifact nothing.
import std::mem::raw
import std::mem::arena::growing_arena
import std::mem::ctx
import std::test::{ Verdicts }
import std::io::console::{ print, println }

# `test_arena.of(n)` — the constructor SURFACE: a bodyless intrinsic `case!` opens with the case's
# arena size. Lowered exactly as `growing_arena::of` (a carve from the ambient node), the node
# published so children claim through the shared elastic reserve.
pub intrinsic of = (Uarch n): Uarch

# `test_arena::destroy(b)` — the reporting teardown (testing.md §3). It consumes the case's verdict
# accumulator from context and dumps the verdict — a tick when every assertion held, a cross
# otherwise
# — then dissolves the arena `b` back into its parent with a survivor rewind to its base (the carve
# mark, reached via the parent link at `b+16`). Colorless: it reads context and stores, allocating
# nothing.
pub const destroy = (Uarch node): () uses Verdicts -> {
	const v = std::mem::ctx::consume(Verdicts)

	if v.fails == 0 then {
		print("✓ ")
	} else {
		print("✗ ")
	}

	println(v.desc)
	raw::store(raw::load(node + 16), node)
}
