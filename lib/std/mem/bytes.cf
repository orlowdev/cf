# std/mem/bytes — borrowed byte VIEWS (privileged: computes raw addresses).
#
# `view(start, stop, s)` is `s[start..stop)` as a Str WITHOUT copying: the result
# aliases `s`'s backing bytes, so it is valid exactly as long as `s` is and must
# not outlive it. The one userland door to O(1) substrings — `str::slice` copies.
import std::mem::raw

pub const view = (Iarch start, Iarch stop, Str s): Str -> {
	let Iarch a = start
	let Iarch b = stop

	if a < 0 then a = 0
	if b > Iarch(s.len) then b = Iarch(s.len)
	if a >= b then return ""
	# a FRESH 16-byte header (never a literal's — rewriting a static header would poison
	# every user of that literal), repointed at s's backing via raw stores
	const [Uint8] none = []
	let Str v = Str({ bytes: none, len: 0 })
	const Uarch h = raw::addr(v)
	raw::store(h, raw::load(raw::addr(s)) + Uarch(a))
	raw::store(h + 8, Uarch(b - a))

	return v
}
