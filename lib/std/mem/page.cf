# std/mem/page — the ROOT geometry (geometry_lowering §5, `page`): the ambient node `main`
# runs under before any graft. Unlike `arena`/`fixed_buffer` it is never CONSTRUCTED — the
# entry floor mints the root duplex node (`$cf_page`) and passes it as main's hidden node
# arg-0. The page therefore has NO constructor surface at all — a program never mints or
# names it; it simply runs under it. The module is only the value/scope hooks a page-ambient
# (non-`!`, root-reachable) frame places when the Materialize pass tags it `pg`.
#
# The root node is the SAME 96-byte duplex header the whole bump family shares:
#
#   node+0  survivor { top, committed, limit, parent, kind, chunk }
#   node+48 residue  { top, committed, limit, parent, kind, chunk }
#
# but its lanes are seeded per TARGET (the floor's `cf_arena_init`):
#   - Darwin: both lanes are kind 0 — up-bumping over their OWN mmap reservation, bounded by
#     `limit`, committing more backing pages via `cf_grow` (→ `raw::grow`) when the cursor
#     crosses the `committed` watermark. This is the kind the page geometry contributes over
#     the arena's carved kinds, and the reason `raw::grow` exists.
#   - Bare: one two-ended BSS block — survivor kind 4 (up, bounded by the residue cursor),
#     residue kind 2 (down, bounded by the survivor cursor); no growth (fixed root).
#
# The reserves therefore branch on kind, exactly as the `cf_alloc` floor does, so one page
# body is correct on both targets. What Materialize cannot prove stays on that floor,
# coherent because both honor this identical layout. Like the other geometries this logic
# lives in std SOURCE; nothing is `pub` — the compiler places every call by mangled name
# (`reserve_ret__pg`, `on_alloc_ret__pg$T`, …).

# Reserve `sz` bytes on the SURVIVOR side (node+0) and hand back the placement address —
# `on_ret` minus the copy. The root's lane shape is a COMPTIME fact of the target, not a runtime
# kind read: a Bare root is a two-ended block (survivor bumps up toward the residue cursor, traps
# on meet); a Darwin root lane bumps toward `limit`, committing more pages through `raw::grow` when
# it crosses the committed watermark, and traps at reservation end. `comptime_if os::target` folds
# the winning body at parse, so neither reserve reads `node+32`/`node+80` — those kind slots are
# free to repurpose as the published reserve entry (the parent draw follows a pointer, not a kind).
import std::mem::raw
import std::comptime::os
import std::sys::{ Os }

if os::target == Os.Bare then {
	const reserve_ret = (Uarch node, Uarch sz): Uarch -> {
		const Uarch p = raw::load(node)
		const Uarch nt = p + sz
		if nt > raw::load(node + 48) then raw::trap()
		raw::store(node, nt)
		return p
	}
	const reserve_alloc = (Uarch node, Uarch sz): Uarch -> {
		const Uarch r = node + 48
		const Uarch dn = raw::load(r) - sz
		if dn < raw::load(node) then raw::trap()
		raw::store(r, dn)
		return dn
	}
} else {
	const reserve_ret = (Uarch node, Uarch sz): Uarch -> {
		const Uarch p = raw::load(node)
		const Uarch nt = p + sz
		if nt > raw::load(node + 16) then raw::trap()
		if nt > raw::load(node + 8) then raw::grow(node, nt)
		raw::store(node, nt)
		return p
	}
	const reserve_alloc = (Uarch node, Uarch sz): Uarch -> {
		const Uarch r = node + 48
		const Uarch p = raw::load(r)
		const Uarch nt = p + sz
		if nt > raw::load(r + 16) then raw::trap()
		if nt > raw::load(r + 8) then raw::grow(r, nt)
		raw::store(r, nt)
		return p
	}
}

# ── the scope bracket (geometry_lowering §2) ─────────────────────────────────────────────
# The root residue mark is the residue top alone (node+48+0), restored unconditionally on
# exit — sound for BOTH root lanes: a kind-2 down lane and a kind-0 up lane each only bump
# their top, neither ever pulls (only an elastic pull invalidates a top-only mark), and a
# kind-0 lane leaves `committed` advanced so the restore never re-commits. This is the
# floor's cf_reset same-limit path, the only one a non-pulling node can take.
const on_scope_enter = (Uarch node): Uarch -> raw::load(node + 48)

const on_scope_exit = (Uarch node, Uarch mark): Uarch -> {
	raw::store(node + 48, mark)
	return 0
}

# ── the value hooks (geometry_lowering §1) ───────────────────────────────────────────────
# Fold-lite fuses these to `reserve_*` + build-in-place (identity-law-equal); the bodies
# stay the contract for a site that must relocate a pre-constructed value. `on_alloc_ret` is
# the identity — a returned value was born on the callee's survivor side and outlives the call.

const on_alloc = ['T](Uarch node, 'T v): 'T -> raw::place(reserve_alloc(node, raw::size_of(v)), v)

const on_ret = ['T](Uarch node, 'T v): 'T -> raw::place(reserve_ret(node, raw::size_of(v)), v)

const on_alloc_ret = ['T](Uarch node, 'T v): 'T -> v
