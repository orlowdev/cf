# std/mem/arena — the carved bump geometry (geometry_lowering §5): `mem.arena.of(n)` carves
# a FIXED n-byte arena from the ambient node; `mem.arena.grow(n)` carves an ELASTIC one that
# pulls further n-sized blocks from its parent when it overflows. Both mint the same 96-byte
# duplex header the whole bump family shares:
#
#   node+0  survivor { top, committed, limit, parent, kind, chunk }
#   node+48 residue  { top, committed, limit, parent, kind, chunk }
#
# Kinds: 4 = up/shared-fixed (bounded by the residue cursor), 2 = down/fixed (bounded by the
# survivor cursor), 1 = up/elastic (a limit overflow pulls a fresh chunk from the parent).
# A FIXED arena is one two-ended block (kinds 4/2, cursors meeting is the hard trap); an
# ELASTIC arena has NO shared block — its residue is a LAZY private chain (kind 1 with an
# empty triple, so its first allocation pulls an own chunk), because an elastic survivor
# pulls away from any block a residue could share.
#
# Like fixed_buffer, this module's logic lives in std SOURCE: the compiler auto-loads it on
# any `mem.arena` use and calls everything here by mangled name (`of__ar`, `reserve_ret__ar`,
# …); nothing is `pub`. Emit lowers a record construction in a materialized `__ar` body to
# fold-lite form — `reserve_*` + build-in-place, the fused `on_alloc`/`on_ret` — and the
# constructors replace the `$cf_arena_of`/`$cf_arena_grow` floor text (swept in Stage 4;
# every ctor site now retargets to these hooks). What materialize cannot prove stays on the shared bump
# floor, coherent because both honor the same duplex layout. The pull slow path allocates
# from the PARENT node, whose geometry is dynamic — exactly the place where the floor's
# runtime dispatch is correct — so it goes through `mem.raw.alloc`.

# Carve a FIXED arena: pull the header and one n-byte block from the parent (the carve is
# the must-pin — headers outlive frames), then lay both subnodes over the one two-ended
# block. `of(n)` means n bytes TOTAL: the cursors meet at trap.
const of = (Uarch node, Uarch n): Uarch -> {
	const Uarch r = (n + 7) % 8
	const Uarch sz = n + 7 - r
	const Uarch hdr = mem.raw.alloc(node, 96)
	const Uarch blk = mem.raw.alloc(node, sz)
	const Uarch end = blk + sz
	mem.raw.store(hdr, blk)
	mem.raw.store(hdr + 8, end)
	mem.raw.store(hdr + 16, end)
	mem.raw.store(hdr + 24, node)
	mem.raw.store(hdr + 32, 4)
	mem.raw.store(hdr + 40, 0)
	mem.raw.store(hdr + 48, end)
	mem.raw.store(hdr + 56, end)
	mem.raw.store(hdr + 64, 0)
	mem.raw.store(hdr + 72, node)
	mem.raw.store(hdr + 80, 2)
	mem.raw.store(hdr + 88, 0)
	return hdr
}

# Carve an ELASTIC arena: the survivor is kind 1 / chunk n over the whole initial block;
# the residue is the lazy private chain (kind 1, empty triple, chunk n).
const grow = (Uarch node, Uarch n): Uarch -> {
	const Uarch r = (n + 7) % 8
	const Uarch sz = n + 7 - r
	const Uarch hdr = mem.raw.alloc(node, 96)
	const Uarch blk = mem.raw.alloc(node, sz)
	const Uarch end = blk + sz
	mem.raw.store(hdr, blk)
	mem.raw.store(hdr + 8, end)
	mem.raw.store(hdr + 16, end)
	mem.raw.store(hdr + 24, node)
	mem.raw.store(hdr + 32, 1)
	mem.raw.store(hdr + 40, sz)
	mem.raw.store(hdr + 48, 0)
	mem.raw.store(hdr + 56, 0)
	mem.raw.store(hdr + 64, 0)
	mem.raw.store(hdr + 72, node)
	mem.raw.store(hdr + 80, 1)
	mem.raw.store(hdr + 88, sz)
	return hdr
}

# An elastic subnode's grow step (≡ the floor's cf_arena_pull): pull a fresh block — the
# larger of the subnode's chunk and the request — from the parent and reset the triple to
# it. The old block leaks into the parent (no per-object free); returned pointers stay valid.
const pull = (Uarch sub, Uarch sz): Uarch -> {
	const Uarch chunk = mem.raw.load(sub + 40)
	let Uarch bs = sz
	if chunk > sz then bs = chunk
	const Uarch parent = mem.raw.load(sub + 24)
	const Uarch blk = mem.raw.alloc(parent, bs)
	mem.raw.store(sub, blk)
	mem.raw.store(sub + 8, blk + bs)
	mem.raw.store(sub + 16, blk + bs)
	return 0
}

# Reserve `sz` bytes on the SURVIVOR side and hand back the placement address — `on_ret`
# minus the copy. A fixed survivor (kind 4) bumps up toward the residue cursor and traps on
# meet; an elastic one (kind 1) bumps within its block and pulls a fresh chunk on overflow.
const reserve_ret = (Uarch node, Uarch sz): Uarch -> {
	if mem.raw.load(node + 32) == 4 then {
		const Uarch p = mem.raw.load(node)
		const Uarch nt = p + sz
		if nt > mem.raw.load(node + 48) then mem.raw.trap()
		mem.raw.store(node, nt)
		return p
	}
	let Uarch p = mem.raw.load(node)
	if p + sz > mem.raw.load(node + 16) then {
		pull(node, sz)
		p = mem.raw.load(node)
	}
	mem.raw.store(node, p + sz)
	return p
}

# Reserve `sz` bytes on the RESIDUE side — `on_alloc` minus the copy. A fixed residue
# (kind 2) bumps down toward the survivor cursor and traps on meet; an elastic one (kind 1)
# bumps up its private chain, pulling its first/next chunk from the parent as needed.
const reserve_alloc = (Uarch node, Uarch sz): Uarch -> {
	const Uarch r = node + 48
	if mem.raw.load(node + 80) == 2 then {
		const Uarch dn = mem.raw.load(r) - sz
		if dn < mem.raw.load(node) then mem.raw.trap()
		mem.raw.store(r, dn)
		return dn
	}
	let Uarch p = mem.raw.load(r)
	if p + sz > mem.raw.load(r + 16) then {
		pull(r, sz)
		p = mem.raw.load(r)
	}
	mem.raw.store(r, p + sz)
	return p
}

# ── the scope bracket (geometry_lowering §2) ─────────────────────────────────────────────
# `Mark` is geometry-private. For a FIXED residue the top alone is sound (a fixed node
# never pulls). For an ELASTIC residue a pull relocates the chain, so the mark must carry
# {top, limit} — here a 16-byte mark RECORD bumped on the residue side itself, whose exit
# compares the saved limit (unchanged = no pull = restore; changed = skip, leaking the
# marked interval once, the floor cf_reset regime). These bodies are the CONTRACT, but emit
# does NOT place them yet: the record leaks 16 bytes per `!` call under loops with no own
# residue (nothing beneath ever restores past it), which a self-compile measures in the
# hundreds of MB — so arena brackets stay on the floor triple + cf_reset (the §6 scope
# fold) until a leak-free one-word elastic mark design lands.

const on_scope_enter = (Uarch node): Uarch -> {
	if mem.raw.load(node + 80) == 2 then return mem.raw.load(node + 48)
	# the restore point is the top AFTER the record (and the limit of the block it landed
	# in, read after the possibly-pulling reserve): a LOOP bracket resets with the same
	# mark every iteration, so the restore must be idempotent — restoring to the record's
	# own start would free it under later iterations that still read it (the churn that
	# burns the reservation). The record itself is reclaimed by the enclosing bracket's
	# restore point sitting below it, or at node teardown.
	const Uarch m = reserve_alloc(node, 16)
	mem.raw.store(m, mem.raw.load(node + 48))
	mem.raw.store(m + 8, mem.raw.load(node + 64))
	return m
}

const on_scope_exit = (Uarch node, Uarch mark): Uarch -> {
	if mem.raw.load(node + 80) == 2 then {
		mem.raw.store(node + 48, mark)
		return 0
	}
	const Uarch t0 = mem.raw.load(mark)
	const Uarch l0 = mem.raw.load(mark + 8)
	if mem.raw.load(node + 64) == l0 then mem.raw.store(node + 48, t0)
	return 0
}

# ── the value hooks (geometry_lowering §1) ───────────────────────────────────────────────
# The contract fold-lite fuses: place a constructed value on the classified side. Emit
# renders record literals as reserve + build-in-place instead (identity-law-equal); these
# bodies serve the sites a pre-constructed value must genuinely relocate through.

const on_alloc = ['T](Uarch node, 'T v): 'T -> mem.raw.place(reserve_alloc(node, size_of(v)), v)

const on_ret = ['T](Uarch node, 'T v): 'T -> mem.raw.place(reserve_ret(node, size_of(v)), v)

# Claim a returned value: the bump family's fold is the IDENTITY — the callee's survivor
# side outlives the call. The hook stays placed by contract (a compacting geometry acts here).
const on_alloc_ret = ['T](Uarch node, 'T v): 'T -> v
