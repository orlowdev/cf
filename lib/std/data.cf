# std::data — the small algebraic carriers (`Either`, `Maybe`) used across the standard library.

# `Either['Left, 'Right]` holds one of exactly two values: a `Left` wrapping a `'Left`, or a `Right`
# wrapping a `'Right`. It is the canonical "one of two outcomes" carrier — by convention `Right` is the
# success ("right" = correct) and `Left` is the error or alternative, so a fallible operation returns
# `Either[Error, Value]`: the `Right` when it worked, the `Left` explaining why it did not.
pub union Either['Left, 'Right] = {
	# the error or alternative outcome, carrying a `'Left`
	Left('Left),
	# the successful outcome, carrying a `'Right`
	Right('Right),
}

# `Maybe['Value]` is a value that may be absent: `Just` wraps a present `'Value`, `Nothing` marks its
# absence. Use it when absence is an ordinary result; use `Either` instead when the caller needs to
# know WHY a value is missing.
pub union Maybe['Value] = {
	# the value is present, wrapping a `'Value`
	Just('Value),
	# the value is absent
	Nothing,
}
