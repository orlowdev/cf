# std::data — the algebraic carriers and their everyday companions. Each carrier lives in its own
# module (`std::data::either`, `std::data::maybe`) with its operators in `ops` and eliminators in
# `catas` beside it; `std::data::array` holds the dynamic-array operations and `std::data::str` the
# string ones. This barrel re-exports the carrier types, so `import std::data::{ Either, Maybe }`
# stays the one-line spelling.

pub import std::data::either::{ Either }
pub import std::data::maybe::{ Maybe }
