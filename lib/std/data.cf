# std::data — the small algebraic carriers used across the standard library.
#
# `Either['L, 'R]` is the two-outcome type: by FP convention `Left` carries the error/alternative
# and `Right` carries the success ("right" = correct). `std::io` returns `Either[IoRrr, T]` from
# fallible operations, so a caller `match`es the outcome instead of testing a raw negative code.
#
# `Maybe['T]` is presence-or-absence: `Just` wraps a value, `Nothing` marks its absence. Both are
# ordinary generic unions (nothing fancy) — a value is boxed on construction like any union.
pub union Either['L, 'R] = { Left('L), Right('R) }
pub union Maybe['T] = { Just('T), Nothing }
