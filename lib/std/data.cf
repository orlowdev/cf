# std::data — the small algebraic carriers (`Either`, `Maybe`) used across the standard library.

# `Either['L, 'R]` holds one of exactly two values: a `Left` wrapping an `'L`, or a `Right` wrapping an
# `'R`. It is the canonical "one of two outcomes" carrier — by convention `Right` is the success
# ("right" = correct) and `Left` is the error or alternative, so a fallible operation returns
# `Either[Error, Value]`: the `Right` when it worked, the `Left` explaining why it did not.
pub union Either['L, 'R] = {
	# the error or alternative outcome, carrying an `'L`
	Left('L),
	# the successful outcome, carrying an `'R`
	Right('R),
}

# `Maybe['T]` is a value that may be absent: `Just` wraps a present `'T`, `Nothing` marks its absence.
# Use it when absence is an ordinary result; use `Either` instead when the caller needs to know WHY a
# value is missing.
pub union Maybe['T] = {
	# the value is present, wrapping a `'T`
	Just('T),
	# the value is absent
	Nothing,
}
