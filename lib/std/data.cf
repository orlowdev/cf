# std::data — the small algebraic carriers (`Either`, `Maybe`) used across the standard library.

# `Either['L, 'R]` holds one of two values: a `Left` wrapping an `'L`, or a `Right` wrapping an `'R`.
# It is how C! reports "a result or a problem" without exceptions — by convention `Right` carries the
# success (right = correct) and `Left` carries the error. Every fallible `std::io` operation returns
# `Either[IoRrr, T]`, so you handle both outcomes explicitly with a `match`:
#
# ```
# match open_read("/etc/hosts") {
# 	Either.Left(err) -> report(err),   # err is an IoRrr describing the failure
# 	Either.Right(fd) -> use(fd),       # fd is the value you asked for
# }
# ```
#
# Build one by naming the full type and the variant: `Either[IoRrr, Fd].Right(fd)`. In a `match`, the
# type is inferred, so the arms are just `Either.Left(x)` / `Either.Right(x)`.
pub union Either['L, 'R] = { Left('L), Right('R) }

# `Maybe['T]` is a value that may be absent: `Just` wraps a present `'T`, `Nothing` marks its absence.
# Reach for it when "no value" is an ordinary outcome rather than a failure — use `Either` instead when
# the caller needs to know WHY something went wrong. Match on it the same way:
#
# ```
# match first(xs) {
# 	Maybe.Just(x) -> x,        # the list had a head
# 	Maybe.Nothing -> dflt,     # it was empty
# }
# ```
pub union Maybe['T] = { Just('T), Nothing }
