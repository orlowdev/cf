# resolve — module resolution and flattening (module_system §8), brick 1.
#
# Loads the entry module and, transitively, every module it imports, then flattens all
# their declarations into one Program for the typecheck and emit phases. Each `import m`
# resolves to a file `<dir>/m.cf` and its declarations join the program.
#
# Scope notes: paths resolve relative to the ENTRY file's directory — correct for a flat
# layout, where every module sits beside the entry, as cf's own sources do (the spec
# resolves each import relative to its own importer's directory); no visibility filtering,
# so every merged declaration is visible (the typecheck phase still rejects a reference to
# a name no module declares).

import std::data::{ Either }
import std::str::{ eq, starts_with }
import std::sys::{ Os, Arch }
import std::io::console::{ die }
import std::io::file::{ open_read, read, close }
import std::io::fd::{ Fd, IoRrr }
import std::comptime::{ embed_dir, EmbeddedFile }
import std::compiler::token::{ Token, is_ident, is_lbrace, is_rbrace, is_pathsep, is_star }
import std::compiler::ast::{
	Expr,
	Stmt,
	MatchArm,
	StmtArm,
	Seg,
	FieldInit,
	RecDecl,
	UnionDecl,
	UnionMember,
	TupElem,
	Param,
	Func,
	Import,
	Program,
	with_geom,
}
import std::compiler::lexer::{ lex }
import std::compiler::typealias::{ strip_type_aliases! }
import std::compiler::parser::{ Parser, parse_program! }

# Byte-wise Str equality (used to dedup already-loaded module paths).

# The directory prefix of a path: its bytes up to and INCLUDING the last `/` (empty when
# the path has no `/`). `import m` from `dir/entry.cf` resolves against this prefix.
const dir_of! = (Str path): Str -> {
	let Iarch last = -1
	let Iarch i = 0

	loop {
		if i >= Iarch(path.len) then break
		if Iarch(path[i]) == 47 then last = i
		i = i + 1
	}

	let [Uint8] v = []
	let Iarch k = 0

	loop {
		if k > last then break
		v = [...v, path[k]]
		k = k + 1
	}

	return Str(v)
}

# Build a module file path `<dir><name>.cf`, NUL-terminated for `open` (which reads a C
# string). `dir` already ends in `/` (or is empty). The trailing NUL rides in the sealed
# Str's bytes; `open` stops at it, so the one extra length byte is harmless.
const build_path! = (Str dir, Str name): Str -> {
	let [Uint8] v = []
	let Iarch i = 0

	loop {
		if i >= Iarch(dir.len) then break
		v = [...v, dir[i]]
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(name.len) then break
		v = [...v, name[j]]
		j = j + 1
	}

	v = [...v, 46]  # '.'
	v = [...v, 99]  # 'c'
	v = [...v, 102] # 'f'
	v = [...v, 0]   # NUL terminator for `open`
	return Str(v)
}

# Read, lex, and parse one module file into its Program. Its read buffer is a local, and
# the parser interns every name into the arena, so the returned Program is self-contained
# and the buffer can be discarded.
# The decoded text of a token — the source slice it points at, as a `Str`.
const tok_text! = (*[Uint8] src, Token t): Str -> {
	# a synthesized token carries its identifier directly (namespace mangling), bypassing src
	if Iarch(t.text.len) > 0 then return t.text
	let [Uint8] out = []
	let Iarch i = 0

	loop {
		if i >= t.len then break
		out = [...out, src[t.start + i]]
		i = i + 1
	}

	return Str(out)
}

# The flat prefix registered for alias `n`, or "" when `n` is not a namespace alias.
const alias_prefix = ([Str] aliases, [Str] prefixes, Str n): Str -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(aliases.len) then break
		if eq(aliases[i], n) then return prefixes[i]
		i = i + 1
	}

	return ""
}

# A pre-parse token pass for namespace imports (module_system §4/§5). A namespace import
# `import a::b::ns` binds a local alias `ns` (the last segment, or a `as <name>` rename), and a use
# `ns::member` means module `a::b::ns`'s `member`.
# Since the mangle later renames `m`'s value members to `<prefix>_<name>`, a value access
# `ns::member` cannot survive as a bare `member` — it is JOINED here into one synthesized token
# `<prefix>\x01member` (the sep flags a namespace access; the mangle resolves it through `m`'s
# export surface, which chases barrels).
#
# NESTED namespaces (§5): a `pub import` can reexport a module AS a namespace, so a path may have
# more than one namespace hop — `foo::io::member`, where `foo` windows over a barrel whose `io` is a
# reexported namespace. We GREEDILY consume the run of lowercase segments after an alias and join
# ALL of them, `<prefix>\x01seg\x01...\x01member` — the mangle walks the run through the module graph.
# Greedy consumption means a field access on a namespaced VALUE (`ns::value.field`) is not supported
# (the run would swallow `field` as a hop, and the mangle then errors that `value` is not a
# namespace) — destructure the value first. A TYPE terminal `ns::...segs::...::T` (PascalCase) is reached
# THROUGH the namespaces: the whole `ns::...seg::` prefix is dropped and the bare `T` kept (types are
# never mangled), so `T.M` stays intact. Pass 1 collects each alias and the sanitized prefix of its
# import path (the non-`{` form; `pub import` too); an optional `as <name>` on the declaration
# renames the alias (`import a::b::os as os2` → alias `os2`, prefix unchanged), and pass 2 emits the
# `as <name>` clause verbatim.
# Append `_seg` to a sanitized prefix (`std_mem` + `raw` → `std_mem_raw`).
const us_join! = (Str base, Str seg): Str -> {
	let [Uint8] v = []
	let Iarch i = 0

	loop {
		if i >= Iarch(base.len) then break
		v = [...v, base[i]]
		i = i + 1
	}

	if Iarch(base.len) > 0 then v = [...v, 95] # `_`
	let Iarch j = 0

	loop {
		if j >= Iarch(seg.len) then break
		v = [...v, seg[j]]
		j = j + 1
	}

	return Str(v)
}

# The pre-parse strip's result: the rewritten tokens, plus the module PATHS a full `::` path used
# WITHOUT an import (`std::comptime::os::target`) refers to — the loader turns each into a synthetic
# namespace import so the module is loaded (module_system §4: imports are optional).
data StripResult = { [Token] toks, [Str] deps }

# The first `nseg` segments of `segs` joined by `sep` (a byte): a full `::` path's module prefix is
# all-but-the-last segment joined `/` (a load path), and its flat mangled name is all segments `_`.
const segs_join! = ([Str] segs, Iarch nseg, Iarch sep): Str -> {
	let [Uint8] v = []
	let Iarch i = 0

	loop {
		if i >= nseg then break
		if i > 0 then v = [...v, sep]
		let Iarch j = 0

		loop {
			if j >= Iarch(segs[i].len) then break
			v = [...v, segs[i][j]]
			j = j + 1
		}

		i = i + 1
	}

	return Str(v)
}

const strip_import_namespaces! = (*[Uint8] src, [Token] toks): StripResult -> {
	# --- pass 1: collect the `::`-import namespace aliases (`import a::b::ns` → `ns`), so a
	# `ns::member` use can be joined against the alias's module prefix. ---
	let [Str] paliases = []
	let [Str] pprefixes = []
	# `saw_ps` counts a `::` only in a USE position — an import DECLARATION is walked past whole, so a
	# file with only `::` imports (no alias/full-path uses) still early-returns, keeping pass 2 (which
	# rebuilds the token stream, O(n²)) off the huge alias-free compiler files.
	let Bool saw_ps = false
	let Iarch i = 0

	loop {
		if i >= Iarch(toks.len) then break
		if is_ident(toks[i].kind) && eq(tok_text!(src, toks[i]), "import") then {
			let Iarch m = i + 1
			if m < Iarch(toks.len) && is_ident(toks[m].kind) then {
				# `::`-path import: walk segments; the last (if not `::{ ... }` destructure) is the alias.
				let Str pre = tok_text!(src, toks[m])
				let Str last = tok_text!(src, toks[m])
				m = m + 1
				let Bool destructured = false

				loop {
					if !(m < Iarch(toks.len) && is_pathsep(toks[m].kind)) then break
					m = m + 1 # `::`
					if m < Iarch(toks.len) && is_lbrace(toks[m].kind) then {
						destructured = true

						loop {
							if m >= Iarch(toks.len) then break
							if is_rbrace(toks[m].kind) then {
								m = m + 1
								break
							}
							m = m + 1
						}

						break
					}
					if !(m < Iarch(toks.len) && is_ident(toks[m].kind)) then break
					pre = us_join!(pre, tok_text!(src, toks[m]))
					last = tok_text!(src, toks[m])
					m = m + 1
				}

				if !destructured then {
					# optional `as <name>` renames the alias (`import a::b::os as os2` binds `os2`); the
					# module prefix `pre` is unchanged — only the local namespace name changes. `as *`
					# (wildcard) registers NO alias — the whole surface is spliced flat by the resolver.
					let Bool wildcard = false
					if m < Iarch(toks.len)
					&& is_ident(toks[m].kind)
					&& eq(tok_text!(src, toks[m]), "as") then {
						m = m + 1

						if m < Iarch(toks.len) && is_star(toks[m].kind) then {
							wildcard = true
							m = m + 1
						} else if m < Iarch(toks.len) && is_ident(toks[m].kind) then {
							last = tok_text!(src, toks[m])
							m = m + 1
						}
					}
					if !wildcard then {
						paliases = [...paliases, last]
						pprefixes = [...pprefixes, pre]
					}
				}
				i = m
				continue
			}
		}
		if is_pathsep(toks[i].kind) then saw_ps = true
		i = i + 1
	}

	let [Str] nodeps = []
	if Iarch(paliases.len) == 0 && !saw_ps then return StripResult({ toks: toks, deps: nodeps })
	# --- pass 2: rewrite uses; leave import declarations untouched ---
	let [Str] deps = []
	let [Token] out = []
	let Iarch k = 0

	loop {
		if k >= Iarch(toks.len) then break
		if is_ident(toks[k].kind) && eq(tok_text!(src, toks[k]), "import") then {
			# emit the import DECLARATION verbatim (`import a::b::c [::{ ... }]`) — not a use to mangle.
			out = [...out, toks[k]]
			k = k + 1
			if k < Iarch(toks.len) && is_ident(toks[k].kind) then {
				out = [...out, toks[k]] # first `::` segment
				k = k + 1
			}

			loop {
				if !(k < Iarch(toks.len) && is_pathsep(toks[k].kind)) then break
				out = [...out, toks[k]] # `::`
				k = k + 1
				if k < Iarch(toks.len) && is_lbrace(toks[k].kind) then {
					loop {
						if k >= Iarch(toks.len) then break
						out = [...out, toks[k]]
						if is_rbrace(toks[k].kind) then {
							k = k + 1
							break
						}
						k = k + 1
					}

					break
				}
				if !(k < Iarch(toks.len) && is_ident(toks[k].kind)) then break
				out = [...out, toks[k]]
				k = k + 1
			}

			# emit an optional `as <name>`/`as *` clause verbatim (a binding, not a use to mangle).
			if k + 1 < Iarch(toks.len)
			&& is_ident(toks[k].kind)
			&& eq(tok_text!(src, toks[k]), "as")
			&& (is_ident(toks[k + 1].kind) || is_star(toks[k + 1].kind)) then {
				out = [...out, toks[k]] # `as`
				out = [...out, toks[k + 1]] # name or `*`
				k = k + 2
			}
			continue
		}
		# a `::` use is joined against its `::`-import alias's module prefix (the same `\x01`-join +
		# export-surface machinery, chasing barrels) — its leading segment must be a `::`-import alias.
		let Str ppre = ""
		if is_ident(toks[k].kind) && k + 1 < Iarch(toks.len) && is_pathsep(toks[k + 1].kind)
			then ppre = alias_prefix(paliases, pprefixes, tok_text!(src, toks[k]))

		if Iarch(ppre.len) > 0
		&& k + 2 < Iarch(toks.len)
		&& is_ident(toks[k + 2].kind)
		&& is_lower_initial(tok_text!(src, toks[k + 2])) then {
			# `ns::seg1[::seg2...]::member` — same join, but `::`-separated (a `::` use is unambiguous:
			# every segment is a namespace hop, so no value/field terminal to guess at)
			let Str joined = join_ns!(ppre, tok_text!(src, toks[k + 2]))
			let Iarch j = k + 2

			loop {
				if j + 2 < Iarch(toks.len)
				&& is_pathsep(toks[j + 1].kind)
				&& is_ident(toks[j + 2].kind)
				&& is_lower_initial(tok_text!(src, toks[j + 2])) then {
					joined = join_ns!(joined, tok_text!(src, toks[j + 2]))
					j = j + 2
				} else {
					break
				}
			}

			if j + 2 < Iarch(toks.len)
			&& is_pathsep(toks[j + 1].kind)
			&& is_ident(toks[j + 2].kind)
			&& !is_lower_initial(tok_text!(src, toks[j + 2])) then {
				# `...seg::Type` — a type reached through the namespaces: drop the prefix, keep bare `Type`
				k = j + 2
			} else {
				out = [
					...out,
					Token({
						kind: toks[j].kind,
						ival: toks[j].ival,
						start: toks[j].start,
						len: toks[j].len,
						text: joined,
					}),
				]
				k = j + 1
			}
		} else if Iarch(ppre.len) > 0 then {
			# `ns::Type` → drop the leading `ns::`, keep the bare `Type`
			k = k + 2
		} else if is_ident(toks[k].kind) && k + 1 < Iarch(toks.len) && is_pathsep(toks[k + 1].kind) then {
			# a FULL `::` path with NO import alias (`std::comptime::os::target`): collect all segments,
			# mangle flat `::`→`_` to the member's path-prefix-mangled definition name, and record the
			# module (all but the last segment) as a dependency — the loader turns it into a synthetic
			# import so the module loads (imports are optional, module_system §4).
			let [Str] segs = [tok_text!(src, toks[k])]
			let Iarch j = k

			loop {
				if j + 2 < Iarch(toks.len) && is_pathsep(toks[j + 1].kind) && is_ident(toks[j + 2].kind) then {
					segs = [...segs, tok_text!(src, toks[j + 2])]
					j = j + 2
				} else {
					break
				}
			}

			const Iarch ns = Iarch(segs.len)
			const Str modpath = segs_join!(segs, ns - 1, 47) # all-but-last, `/`-joined — the load path
			if !in_priv(deps, modpath) then deps = [...deps, modpath]

			if is_lower_initial(segs[ns - 1]) then {
				# value member — flat name matches the module's path-prefix-mangled definition
				out = [
					...out,
					Token({
						kind: toks[j].kind,
						ival: toks[j].ival,
						start: toks[j].start,
						len: toks[j].len,
						text: segs_join!(segs, ns, 95),
					}),
				]
			} else {
				# type terminal — types are never mangled; keep the bare `Type` (the last token as-is)
				out = [...out, toks[j]]
			}

			k = j + 1
		} else {
			out = [...out, toks[k]]
			k = k + 1
		}
	}

	return StripResult({ toks: out, deps: deps })
}

# Join a namespace prefix and a value member into one identifier `<prefix>\x01member`.
const join_ns! = (Str prefix, Str member): Str -> {
	let [Uint8] v = []
	let Iarch i = 0

	loop {
		if i >= Iarch(prefix.len) then break
		v = [...v, prefix[i]]
		i = i + 1
	}

	v = [...v, 1]  # ns_sep (0x01) — flags a joined namespace access
	let Iarch j = 0

	loop {
		if j >= Iarch(member.len) then break
		v = [...v, member[j]]
		j = j + 1
	}

	return Str(v)
}

# Index of the first ns_sep (0x01) in `s`, or -1 — splits a joined namespace path into its first
# hop and the rest. A single-member key has none (a flat value); a nested path `seg\x01rest` has one.
const ns_sep_index = (Str s): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break
		if Iarch(s[i]) == 1 then return i
		i = i + 1
	}

	return -1
}

# The substring `s[a..b)`.
const str_range! = (Str s, Iarch a, Iarch b): Str -> {
	let [Uint8] v = []
	let Iarch i = a

	loop {
		if i >= b then break
		v = [...v, s[i]]
		i = i + 1
	}

	return Str(v)
}

# Does the embedded path `a` equal the first `blen` bytes of `b`? The lookup key: an import path
# from `build_path!` carries a trailing NUL, so the caller passes `blen` excluding it.
const path_eq_pre = (Str a, Str b, Iarch blen): Bool -> {
	if Iarch(a.len) != blen then return false
	let Iarch i = 0

	loop {
		if i >= blen then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}

	return true
}

# cf hosts its own standard library: the bytes of every `lib/std` module are baked into the binary
# by `embed_dir` (std::comptime), so a shipped cf resolves `std::…` imports with NOTHING on disk.
# Called only when the on-disk `open` failed, so a repo/dev build (lib/std present) never builds the
# table — it is materialized here, matched by path, and its bytes copied into `buf`. Returns the
# module's byte length, or dies if the path is neither on disk nor embedded (a real missing import).
const embed_fallback = (Str path, *[Uint8] buf, Iarch cap): Iarch -> {
	# drop `build_path!`'s trailing NUL before matching against the bare embedded path.
	let Iarch plen = Iarch(path.len)

	if plen > 0 && Iarch(path[plen - 1]) == 0 then plen = plen - 1
	const [EmbeddedFile] embedded = embed_dir("lib/std")
	let Iarch n = -1

	for ef in embedded {
		if n < 0 && path_eq_pre(ef.path, path, plen) then {
			let Iarch i = 0

			loop {
				if i >= Iarch(ef.content.len) then break
				if i >= cap then break
				buf[i] = ef.content[i]
				i = i + 1
			}

			n = Iarch(ef.content.len)
		}
	}

	if n < 0 then die("cf: cannot open an imported module\n")

	return n
}

const load_module! = (Str path, Os target_os, Arch target_arch): Program -> {
	# One module's read buffer — large enough for cf's own sources (its largest module, emit.cf,
	# crossed 256 KB; 1 MB leaves headroom). `buf.len` is the capacity handed to `read` (the
	# buffer reports its own size now), and `read` returns the actual byte count `n`. A read that
	# FILLS the buffer means the module was truncated — die loudly (a silent cut surfaces as a
	# baffling parse error at the boundary).
	let [1048576 Uint8] buf

	# Disk first (so editing lib/std during development takes effect at once); on a missing file fall
	# back to the copy baked into the binary — the same source, keyed on its path. A user import that
	# is neither on disk nor embedded dies in `embed_fallback`.
	const Iarch n = match open_read(path) {
		Either.Left(e) -> embed_fallback(path, buf, Iarch(buf.len)),
		Either.Right(fd) -> {
			const Iarch k = match read(fd, buf, Uarch(buf.len)) {
				Either.Left(e) -> die("cf: reading an imported module failed\n"),
				Either.Right(kk) -> kk,
			}

			close(fd)

			<- k
		},
	}

	if n >= Iarch(buf.len)
		then die("cf: an imported module exceeds the read buffer — grow it in resolve.cf\n")
	const StripResult sr = strip_import_namespaces!(buf, strip_type_aliases!(buf, lex(buf, n)))
	const [Stmt] nopend = []
	let Parser p = Parser({
		toks: sr.toks,
		src: buf,
		pos: 0,
		file: path,
		target_os: target_os,
		target_arch: target_arch,
		saw_fb: false,
		saw_fx: false,
		saw_el: false,
		pending: nopend,
	})
	const Program prog = parse_program!(&p)
	# imports are optional (module_system §4): a full `::` path used without an import contributed its
	# module PATH to `sr.deps` — turn each into a synthetic namespace import so the module is loaded
	# (the flat use already resolves to its path-prefix-mangled definition; the loader dedups by path).
	if Iarch(sr.deps.len) == 0 then return prog
	let [Import] imps = prog.imports
	let Iarch di = 0

	loop {
		if di >= Iarch(sr.deps.len) then break
		const [Str] no_names = []
		imps = [...imps, Import({ path: sr.deps[di], names: no_names, alias: "", wildcard: false })]
		di = di + 1
	}

	return Program({
		imports: imps,
		recs: prog.recs,
		unions: prog.unions,
		funcs: prog.funcs,
		groups: prog.groups,
	})
}

# Append every element of `src` onto `dst` (cf has no two-spread merge, so grow one at a
# time). One helper per declaration list — the payload types differ.
const cat_recs = ([RecDecl] dst, [RecDecl] src): [RecDecl] -> {
	let [RecDecl] out = dst
	let Iarch i = 0

	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}

	return out
}

const cat_unions = ([UnionDecl] dst, [UnionDecl] src): [UnionDecl] -> {
	let [UnionDecl] out = dst
	let Iarch i = 0

	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}

	return out
}

const cat_funcs = ([Func] dst, [Func] src): [Func] -> {
	let [Func] out = dst
	let Iarch i = 0

	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}

	return out
}

const cat_imports = ([Import] dst, [Import] src): [Import] -> {
	let [Import] out = dst
	let Iarch i = 0

	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}

	return out
}

# --- name mangling (module_system §8: flatten mangles module-qualified names apart) ------
#
# Every module's VALUE members (functions and value-consts, pub AND private) are renamed to
# a flat `<prefix>_<name>` keyed on the module's PATH (`std/mem/raw`'s `load` → `std_mem_raw_load`),
# so two modules may each export a `load`/`of`/`ping` without colliding after the flatten. Types
# (records/unions) are NOT mangled — they live once and are imported by their bare name. The
# ENTRY module keeps its names BARE (it fixes the naming frame; `main` stays `main`); the
# geometry std modules keep the FIXED per-shape SUFFIX tag (`of__fx`) that emit references by name.
#
# A reference is rewritten through a per-module rename table (`tbl`): a name defined in THIS
# module maps to its mangled definition; a name brought in by a destructured import maps to the
# EXPORT it resolves to (chasing barrels); a namespace access `ns::member`, joined at token level
# into `<prefix>\x01member`, resolves through the target module's export surface. Everything else
# (a builtin, a local, a type ctor, a phantom `cf__*`) is left bare.

# A resolved rename: the name as written in a body, and the flat top-level name it mangles to.
data Bind = { Str from, Str to }
# One loaded module, kept UNMANGLED as the resolution source-of-truth. `prefix` is the sanitized
# import path that loaded it (empty for the entry); `mpath` the resolved file path (the dedup key);
# `is_geom`/`tag` mark a fixed-suffix geometry module. `prog` is its parsed surface.
data Modu = { Str prefix, Str mpath, Bool is_geom, Str tag, Program prog }
# The constant resolution context. `mods` is every loaded module; `edir` the entry directory
# relative import paths resolve against (the brick-narrowing: all relative imports resolve against
# the entry, matching the loader); `itargets[m][k]` is the module index that module `m`'s import
# `k` resolves to (or -1), precomputed once so export resolution never re-opens a path.
data Rctx = { [Modu] mods, Str edir, [[Iarch]] itargets }

# A body's namespace access `ns::member` is joined to `<prefix>\x01member` (0x01 — never a source
# byte) at token level and pre-resolved into the rename table (`build_tbl!`), so the joined name is
# a plain table key — the mangle never re-splits it.
# Is `n` one of the names in `xs`?
const in_priv = ([Str] xs, Str n): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(xs.len) then break
		if eq(xs[i], n) then return true
		i = i + 1
	}

	return false
}

# Index of `n` in a rename table by `from`, or -1.
const bind_find = ([Bind] bs, Str n): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(bs.len) then break
		if eq(bs[i].from, n) then return i
		i = i + 1
	}

	return -1
}

# Is `n`'s first byte a lowercase letter? (a value/function member, vs a PascalCase type — the
# module_system §4 casing split, used to decide which imported names are renameable values.)
const is_lower_initial = (Str n): Bool -> {
	if Iarch(n.len) == 0 then return false
	const Iarch c = Iarch(n[0])
	if c < 97 then return false
	if c > 122 then return false

	return true
}

# The sanitized flat prefix of an import path: `/`→`_`, so `std/mem/raw` → `std_mem_raw`.
const sanitize_prefix! = (Str path): Str -> {
	let [Uint8] v = []
	let Iarch i = 0

	loop {
		if i >= Iarch(path.len) then break

		if Iarch(path[i]) == 47 then {
			v = [...v, 95]
		} else {
			v = [...v, path[i]]
		}

		i = i + 1
	}

	return Str(v)
}

# The resolved file path an import resolves to — `std/`-prefixed under the lib root, everything
# else against the entry dir (the loader's rule, replayed so `find_mod` matches what was loaded).
const mod_target_path! = (Str edir, Str impath): Str -> {
	if has_prefix(impath, "std/") then return build_path!("lib/", impath)

	return build_path!(edir, impath)
}

# Index of the module with resolved path `mpath`, or -1.
const find_mod = ([Modu] mods, Str mpath): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(mods.len) then break
		if eq(mods[i].mpath, mpath) then return i
		i = i + 1
	}

	return -1
}

# The flat name a VALUE named `name` gets in module `m`: bare in the entry, suffix-tagged in a
# geometry module, `<prefix>_<name>` otherwise.
const mod_mangled = (Str name, Modu m): Str -> {
	if Iarch(m.prefix.len) == 0 then return name
	if m.is_geom then return "${name}__${m.tag}"

	return "${m.prefix}_${name}"
}

# The mangled definition name of a function: `main` is always bare (the program entry symbol),
# everything else follows `mod_mangled`.
const mangle_def_name = (Func f, Modu m): Str -> {
	if eq(f.name, "main") then return f.name

	return mod_mangled(f.name, m)
}

# Does module `m` export a PUBLIC function named `name`? (the base case of export resolution.)
const has_pub_func = (Program p, Str name): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(p.funcs.len) then break
		if p.funcs[i].is_pub && eq(p.funcs[i].name, name) then return true
		i = i + 1
	}

	return false
}

# The flat top-level name that member `name`, reached through module `idx`, resolves to. `name`
# may be a NESTED namespace path `seg\x01rest` (module_system §5): the first hop `seg` names a
# reexported namespace of the module (an import aliased `seg`), through which the rest is resolved
# recursively. A single-member name is a pub function of the module (mangles directly) or is chased
# through the module's destructured imports (a barrel reexport forwards to the original definition).
# Falls back to the module's own prefixed name; a nested hop that names no reexported namespace is a
# hard error (module_system §9). Never re-opens a path.
const resolve_export! = (Rctx rc, Iarch idx, Str name, Iarch depth): Str -> {
	if depth > 64 then die("cf: resolve: an import reexport cycle\n")
	const Modu m = rc.mods[idx]
	const Iarch sp = ns_sep_index(name)
	if sp >= 0 then {
		# `seg\x01rest` — descend through the reexported namespace aliased `seg`, resolve the rest there
		const Str seg = str_range!(name, 0, sp)
		const Str rest = str_range!(name, sp + 1, Iarch(name.len))
		let Iarch ni = 0

		loop {
			if ni >= Iarch(m.prog.imports.len) then break
			if eq(m.prog.imports[ni].alias, seg) then {
				const Iarch tidx = rc.itargets[idx][ni]
				if tidx >= 0 then return resolve_export!(rc, tidx, rest, depth + 1)
			}
			ni = ni + 1
		}

		die("cf: resolve: a namespace path segment names no reexported namespace here\n")
	}
	if has_pub_func(m.prog, name) then return mod_mangled(name, m)
	let Iarch ii = 0

	loop {
		if ii >= Iarch(m.prog.imports.len) then break
		const Iarch tidx = rc.itargets[idx][ii]

		# a destructured reexport forwards its named members; a wildcard reexport forwards ANY
		# member the target exports (module_system §5) — both chase the barrel to the definition.
		if in_priv(m.prog.imports[ii].names, name) then {
			if tidx >= 0 then return resolve_export!(rc, tidx, name, depth + 1)
		} else if m.prog.imports[ii].wildcard
		&& tidx >= 0
		&& in_priv(export_names!(rc, tidx, 0), name) then {
			return resolve_export!(rc, tidx, name, depth + 1)
		}

		ii = ii + 1
	}

	return mod_mangled(name, m)
}

# The mangled form of a callee/definition reference: a name in the rename table maps to its target
# (a namespace access `<prefix>\x01member` is a table key like any other, pre-resolved by
# `build_tbl!`); everything else — a builtin, a local, a type ctor, a phantom `cf__*` — is left bare.
const mangle_name = (Str n, [Bind] tbl, Rctx rc): Str -> {
	const Iarch bi = bind_find(tbl, n)
	if bi >= 0 then return tbl[bi].to

	return n
}

# Rewrite every private-function reference in an expression tree. Only a `Call` callee can
# name a function; every other node is rebuilt unchanged around its recursively rewritten
# children.
const mangle_expr = (Expr e, [Bind] tbl, Rctx rc): Expr -> match e {
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	# a bare name may REFERENCE a private function (passed by name to a higher-order function);
	# rewrite it like a `Call` callee so the reference tracks the mangled definition. A local /
	# value-const name is not in `priv`, so it is left unchanged.
	Expr.Var(n) -> Expr.Var(mangle_name(n, tbl, rc)),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(n, mangle_fields(fs, tbl, rc)),
	# the base of a `base.field` read is a NAME — rewrite it through the table too, so a field read
	# on an imported value / namespaced value (`cfg.defaults` in `cfg.defaults.width`) tracks the
	# mangled definition; a local of the same name is absent from the (locals-filtered) table and
	# so is left bare.
	Expr.Field(b, f) -> Expr.Field(mangle_name(b, tbl, rc), f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(mangle_expr(b, tbl, rc), f),
	Expr.UnionMk(t, m, args) -> Expr.UnionMk(t, m, mangle_exprs(args, tbl, rc)),
	Expr.Match(scrut, arms) -> Expr.Match(mangle_expr(scrut, tbl, rc), mangle_arms(arms, tbl, rc)),
	Expr.ArrayLit(hs, sn, elems, et) ->
		Expr.ArrayLit(hs, mangle_expr(sn, tbl, rc), mangle_exprs(elems, tbl, rc), et),
	Expr.Index(a, i) -> Expr.Index(a, mangle_expr(i, tbl, rc)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, mangle_expr(i, tbl, rc), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(mangle_expr(b, tbl, rc), mangle_expr(i, tbl, rc)),
	Expr.Tuple(elems) -> Expr.Tuple(mangle_exprs(elems, tbl, rc)),
	Expr.Spread(x) -> Expr.Spread(mangle_expr(x, tbl, rc)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(mangle_stmts(body, tbl, rc)),
	Expr.Interp(segs) -> Expr.Interp(mangle_segs(segs, tbl, rc)),
	Expr.Buffer(sz) -> Expr.Buffer(mangle_expr(sz, tbl, rc)),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(mangle_expr(x, tbl, rc)),
	Expr.Not(x) -> Expr.Not(mangle_expr(x, tbl, rc)),
	Expr.BitNot(x) -> Expr.BitNot(mangle_expr(x, tbl, rc)),
	Expr.Add(l, r) -> Expr.Add(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.Sub(l, r) -> Expr.Sub(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.Mul(l, r) -> Expr.Mul(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.Div(l, r) -> Expr.Div(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.Mod(l, r) -> Expr.Mod(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.BitOr(l, r) -> Expr.BitOr(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.BitXor(l, r) -> Expr.BitXor(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.Shl(l, r) -> Expr.Shl(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.Shr(l, r) -> Expr.Shr(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.And(l, r) -> Expr.And(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.Or(l, r) -> Expr.Or(mangle_expr(l, tbl, rc), mangle_expr(r, tbl, rc)),
	Expr.If(c, t, e2) ->
		Expr.If(mangle_expr(c, tbl, rc), mangle_expr(t, tbl, rc), mangle_expr(e2, tbl, rc)),
	Expr.Call(n, ta, args, g) ->
		Expr.Call(mangle_name(n, tbl, rc), ta, mangle_exprs(args, tbl, rc), g),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(mangle_name(fn, tbl, rc), mangle_exprs(args, tbl, rc)),
}

# Rewrite a list of expressions / a data literal's field values / a match's arms.
const mangle_exprs = ([Expr] es, [Bind] tbl, Rctx rc): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		out = [...out, mangle_expr(es[i], tbl, rc)]
		i = i + 1
	}

	return out
}

const mangle_fields = ([FieldInit] fs, [Bind] tbl, Rctx rc): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: mangle_expr(fs[i].value, tbl, rc) })]
		i = i + 1
	}

	return out
}

const mangle_segs = ([Seg] segs, [Bind] tbl, Rctx rc): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		const Seg sg = segs[i]
		out = [
			...out,
			Seg({ is_hole: sg.is_hole, lit: sg.lit, name: sg.name, expr: mangle_expr(sg.expr, tbl, rc) }),
		]
		i = i + 1
	}

	return out
}

const mangle_arms = ([MatchArm] arms, [Bind] tbl, Rctx rc): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [
			...out,
			MatchArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: mangle_expr(a.body, tbl, rc),
			}),
		]
		i = i + 1
	}

	return out
}

# Rewrite every private-function reference in a statement (recursing into nested blocks).
const mangle_stmt = (Stmt s, [Bind] tbl, Rctx rc): Stmt -> match s {
	Stmt.Let(n, m, ann, e) -> Stmt.Let(n, m, ann, mangle_expr(e, tbl, rc)),
	Stmt.Destructure(pat, m, e) -> Stmt.Destructure(pat, m, mangle_expr(e, tbl, rc)),
	Stmt.Yield(e) -> Stmt.Yield(mangle_expr(e, tbl, rc)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, mangle_expr(e, tbl, rc)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, mangle_expr(e, tbl, rc)),
	Stmt.DeepFieldAssign(be, f, e) ->
		Stmt.DeepFieldAssign(mangle_expr(be, tbl, rc), f, mangle_expr(e, tbl, rc)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, mangle_expr(i, tbl, rc), mangle_expr(v, tbl, rc)),
	Stmt.Return(e) -> Stmt.Return(mangle_expr(e, tbl, rc)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, mangle_stmts(body, tbl, rc)),
	Stmt.Loop(ll_, body) -> Stmt.Loop(ll_, mangle_stmts(body, tbl, rc)),
	Stmt.Break(bl_) -> Stmt.Break(bl_),
	Stmt.Continue(bl_) -> Stmt.Continue(bl_),
	Stmt.IfThen(c, st) -> Stmt.IfThen(mangle_expr(c, tbl, rc), mangle_stmt(st, tbl, rc)),
	Stmt.IfElse(c, t, e) ->
		Stmt.IfElse(mangle_expr(c, tbl, rc), mangle_stmt(t, tbl, rc), mangle_stmt(e, tbl, rc)),
	Stmt.Do(e) -> Stmt.Do(mangle_expr(e, tbl, rc)),
	Stmt.Block(stmts) -> Stmt.Block(mangle_stmts(stmts, tbl, rc)),
	Stmt.Match(scrut, arms) ->
		Stmt.Match(mangle_expr(scrut, tbl, rc), mangle_stmt_arms(arms, tbl, rc)),
	Stmt.Closure(nm, params, ret, body) -> Stmt.Closure(nm, params, ret, mangle_stmts(body, tbl, rc)),
	Stmt.Defer(body) -> Stmt.Defer(mangle_stmts(body, tbl, rc)),
}

const mangle_stmt_arms = ([StmtArm] arms, [Bind] tbl, Rctx rc): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [
			...out,
			StmtArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: mangle_stmts(a.body, tbl, rc),
			}),
		]
		i = i + 1
	}

	return out
}

const mangle_stmts = ([Stmt] ss, [Bind] tbl, Rctx rc): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = [...out, mangle_stmt(ss[i], tbl, rc)]
		i = i + 1
	}

	return out
}

# --- local-name collection --------------------------------------------------------------
#
# A bare `Var` reference is mangled (rewritten to a private function's mangled name) ONLY when
# it is NOT shadowed by a local binding of the same name in the enclosing function. So each
# function's LOCAL names — its parameters plus every binder in its body (a `let`/`const`, a
# destructuring pattern, a `for x in`, a match-arm payload binding) — are collected and removed
# from the private set used to rewrite THAT body. A private function reference (not shadowed)
# still tracks its mangled definition; a local that happens to share a name with a private
# function is left alone (module_system §8: a syntactic mangle must not capture a local).
const no_names = (): [Str] -> {
	let [Str] e = []

	return e
}

const cat_names = ([Str] a, [Str] b): [Str] -> {
	let [Str] out = a
	let Iarch i = 0

	loop {
		if i >= Iarch(b.len) then break
		out = [...out, b[i]]
		i = i + 1
	}

	return out
}

const lnames_exprs! = ([Expr] es): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		out = cat_names(out, lnames_expr!(es[i]))
		i = i + 1
	}

	return out
}

const lnames_fieldinits! = ([FieldInit] fs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		out = cat_names(out, lnames_expr!(fs[i].value))
		i = i + 1
	}

	return out
}

const lnames_segs! = ([Seg] segs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		out = cat_names(out, lnames_expr!(segs[i].expr))
		i = i + 1
	}

	return out
}

const lnames_match_arms! = ([MatchArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		out = cat_names(cat_names(out, arms[i].binds), lnames_expr!(arms[i].body))
		i = i + 1
	}

	return out
}

const lnames_stmt_arms! = ([StmtArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		out = cat_names(cat_names(out, arms[i].binds), lnames_stmts!(arms[i].body))
		i = i + 1
	}

	return out
}

const lnames_stmts! = ([Stmt] ss): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = cat_names(out, lnames_stmt!(ss[i]))
		i = i + 1
	}

	return out
}

const lnames_expr! = (Expr e): [Str] -> match e {
	Expr.Lit(v) -> no_names(),
	Expr.BoolLit(b) -> no_names(),
	Expr.Var(n) -> no_names(),
	Expr.StrLit(bs) -> no_names(),
	Expr.FloatLit(t) -> no_names(),
	Expr.Record(n, fs) -> lnames_fieldinits!(fs),
	Expr.Field(b, f) -> no_names(),
	Expr.FieldExpr(b, f) -> lnames_expr!(b),
	Expr.UnionMk(t, m, args) -> lnames_exprs!(args),
	Expr.Match(scrut, arms) -> cat_names(lnames_expr!(scrut), lnames_match_arms!(arms)),
	Expr.ArrayLit(hs, sn, elems, et) -> cat_names(lnames_expr!(sn), lnames_exprs!(elems)),
	Expr.Index(a, i) -> lnames_expr!(i),
	Expr.IndexField(a, i, f) -> lnames_expr!(i),
	Expr.IndexExpr(b, i) -> cat_names(lnames_expr!(b), lnames_expr!(i)),
	Expr.Interp(segs) -> lnames_segs!(segs),
	Expr.Tuple(elems) -> lnames_exprs!(elems),
	Expr.Spread(x) -> lnames_expr!(x),
	Expr.Unit -> no_names(),
	Expr.Loop(body) -> lnames_stmts!(body),
	Expr.Buffer(sz) -> lnames_expr!(sz),
	Expr.Addr(name) -> no_names(),
	Expr.Neg(x) -> lnames_expr!(x),
	Expr.Not(x) -> lnames_expr!(x),
	Expr.BitNot(x) -> lnames_expr!(x),
	Expr.Add(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.Sub(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.Mul(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.Div(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.Mod(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.BitAnd(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.BitOr(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.BitXor(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.Shl(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.Shr(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.CmpEq(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.CmpNe(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.CmpLt(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.CmpGt(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.CmpLe(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.CmpGe(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.And(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.Or(l, r) -> cat_names(lnames_expr!(l), lnames_expr!(r)),
	Expr.If(c, t, e2) -> cat_names(cat_names(lnames_expr!(c), lnames_expr!(t)), lnames_expr!(e2)),
	Expr.Call(n, ta, args, _) -> lnames_exprs!(args),
	Expr.DeferTap(fn, args) -> lnames_exprs!(args),
}

const lnames_stmt! = (Stmt s): [Str] -> match s {
	Stmt.Let(n, m, ann, e) -> cat_names([n], lnames_expr!(e)),
	Stmt.Destructure(pat, m, e) -> cat_names(pat, lnames_expr!(e)),
	Stmt.Assign(n, e) -> lnames_expr!(e),
	Stmt.FieldAssign(b, f, e) -> lnames_expr!(e),
	Stmt.DeepFieldAssign(be, f, e) -> cat_names(lnames_expr!(be), lnames_expr!(e)),
	Stmt.IndexAssign(a, i, v) -> cat_names(lnames_expr!(i), lnames_expr!(v)),
	Stmt.Return(e) -> lnames_expr!(e),
	Stmt.ForIn(v, a, body) -> cat_names([v], lnames_stmts!(body)),
	Stmt.Loop(ll_, body) -> lnames_stmts!(body),
	Stmt.Break(bl_) -> no_names(),
	Stmt.Continue(bl_) -> no_names(),
	Stmt.IfThen(c, st) -> cat_names(lnames_expr!(c), lnames_stmt!(st)),
	Stmt.IfElse(c, t, e) -> cat_names(cat_names(lnames_expr!(c), lnames_stmt!(t)), lnames_stmt!(e)),
	Stmt.Do(e) -> lnames_expr!(e),
	Stmt.Block(ss) -> lnames_stmts!(ss),
	Stmt.Match(scrut, arms) -> cat_names(lnames_expr!(scrut), lnames_stmt_arms!(arms)),
	Stmt.Yield(e) -> lnames_expr!(e),
	Stmt.Closure(nm, params, ret, body) ->
		cat_names(cat_names([nm], param_name_list(params)), lnames_stmts!(body)),
	Stmt.Defer(body) -> lnames_stmts!(body),
}

# A function's parameter names.
const param_name_list = ([Param] ps): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ps.len) then break
		out = [...out, ps[i].name]
		i = i + 1
	}

	return out
}

# A rename table minus every entry shadowed by a local binder (`names`) — the subset to rewrite
# in one body. A local of the same name as an imported/module value hides it, so its references
# must NOT be rewritten (module_system §8: a syntactic mangle must not capture a local).
const tbl_minus = ([Bind] tbl, [Str] names): [Bind] -> {
	let [Bind] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(tbl.len) then break
		if !in_priv(names, tbl[i].from) then out = [...out, tbl[i]]
		i = i + 1
	}

	return out
}

# The exported VALUE member paths of module `idx` — its own pub functions, every value name its
# DESTRUCTURED imports bring in (a barrel reexports them flat), and — for a NAMESPACE reexport
# (`pub import m as io`, module_system §5) — the target's members each under the nested path
# `io\x01<member>`, so the reexported namespace joins the surface and is reachable/traversable.
# (The pub/non-pub distinction is not tracked, a deferred §9 privacy check.) Used to spread a
# namespace import's whole surface into rename keys.
const export_names! = (Rctx rc, Iarch idx, Iarch depth): [Str] -> {
	if depth > 64 then die("cf: resolve: an import reexport cycle\n")
	const Modu m = rc.mods[idx]
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(m.prog.funcs.len) then break
		if m.prog.funcs[i].is_pub && is_lower_initial(m.prog.funcs[i].name)
			then out = [...out, m.prog.funcs[i].name]
		i = i + 1
	}

	let Iarch ii = 0

	loop {
		if ii >= Iarch(m.prog.imports.len) then break

		if Iarch(m.prog.imports[ii].names.len) > 0 then {
			# destructured reexport → flat value members
			let Iarch k = 0

			loop {
				if k >= Iarch(m.prog.imports[ii].names.len) then break
				if is_lower_initial(m.prog.imports[ii].names[k])
					then out = [...out, m.prog.imports[ii].names[k]]
				k = k + 1
			}
		} else if m.prog.imports[ii].wildcard then {
			# wildcard reexport (`pub import m as *`) → splice the target's WHOLE surface in flat,
			# same member paths, no nesting prefix (module_system §5).
			const Iarch tidx = rc.itargets[idx][ii]
			if tidx >= 0 then {
				const [Str] sub = export_names!(rc, tidx, depth + 1)
				let Iarch s = 0

				loop {
					if s >= Iarch(sub.len) then break
					out = [...out, sub[s]]
					s = s + 1
				}
			}
		} else if Iarch(m.prog.imports[ii].alias.len) > 0
		&& is_lower_initial(m.prog.imports[ii].alias) then {
			# namespace reexport → nested members under `<alias>\x01...`
			const Iarch tidx = rc.itargets[idx][ii]
			if tidx >= 0 then {
				const [Str] sub = export_names!(rc, tidx, depth + 1)
				let Iarch s = 0

				loop {
					if s >= Iarch(sub.len) then break
					out = [...out, join_ns!(m.prog.imports[ii].alias, sub[s])]
					s = s + 1
				}
			}
		}

		ii = ii + 1
	}

	return out
}

# The rename table for module `idx`. A DESTRUCTURED import's VALUE members bind by their bare name
# to the export they resolve to (chasing barrels); a NAMESPACE import (no destructured names) has
# its whole export surface spread under joined `<prefix>\x01member` keys, matching the tokens the
# strip pass minted. Then every one of the module's own functions binds to its mangled definition
# (laid down last, so a body's own-function reference wins over a same-named import). Type imports
# (PascalCase) are skipped — types are never mangled.
const build_tbl! = (Iarch idx, Rctx rc): [Bind] -> {
	const Modu m = rc.mods[idx]
	let [Bind] tbl = []
	let Iarch ii = 0

	loop {
		if ii >= Iarch(m.prog.imports.len) then break
		const Iarch tidx = rc.itargets[idx][ii]
		if tidx >= 0 then {
			if Iarch(m.prog.imports[ii].names.len) > 0 then {
				# destructured: bind each named value member
				let Iarch k = 0

				loop {
					if k >= Iarch(m.prog.imports[ii].names.len) then break
					const Str nm = m.prog.imports[ii].names[k]
					if is_lower_initial(nm)
						then tbl = [...tbl, Bind({ from: nm, to: resolve_export!(rc, tidx, nm, 0) })]
					k = k + 1
				}
			} else if m.prog.imports[ii].wildcard then {
				# wildcard: bind every member of the target surface BARE (flat splice, no prefix) —
				# a use of the bare member name in this module resolves through to the definition.
				const [Str] ws = export_names!(rc, tidx, 0)
				let Iarch w = 0

				loop {
					if w >= Iarch(ws.len) then break
					tbl = [...tbl, Bind({ from: ws[w], to: resolve_export!(rc, tidx, ws[w], 0) })]
					w = w + 1
				}
			} else {
				# namespace: spread the whole surface under joined keys
				const [Str] xs = export_names!(rc, tidx, 0)
				let Iarch x = 0

				loop {
					if x >= Iarch(xs.len) then break
					tbl = [
						...tbl,
						Bind({ from: join_ns!(rc.mods[tidx].prefix, xs[x]), to: resolve_export!(rc, tidx, xs[x], 0) }),
					]
					x = x + 1
				}
			}
		}
		ii = ii + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(m.prog.funcs.len) then break
		const Func f = m.prog.funcs[j]
		tbl = [...tbl, Bind({ from: f.name, to: mangle_def_name(f, m) })]
		j = j + 1
	}

	return tbl
}

# Mangle module `idx`: rename each function definition to its flat name and rewrite every value
# reference in every body through the module's rename table — but not a reference shadowed by a local.
const mangle_module_funcs! = (Iarch idx, Rctx rc): [Func] -> {
	const Modu m = rc.mods[idx]
	const [Bind] tbl = build_tbl!(idx, rc)
	let [Func] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(m.prog.funcs.len) then break
		const Func f = m.prog.funcs[i]
		const Str nm = mangle_def_name(f, m)
		# a name bound locally in THIS function (a parameter or any body binder) shadows a module
		# value of the same name, so it is excluded from the set this body's references rewrite
		const [Str] locals = cat_names(param_name_list(f.params), lnames_stmts!(f.body))
		const [Bind] bodytbl = tbl_minus(tbl, locals)
		const [Stmt] body = mangle_stmts(f.body, bodytbl, rc)
		# an asm body references only parameters, never functions — passed through unchanged
		out = [
			...out,
			Func({
				name: nm,
				is_pub: f.is_pub,
				ret_name: f.ret_name,
				ret_elem: f.ret_elem,
				params: f.params,
				body: body,
				is_asm: f.is_asm,
				asm_body: f.asm_body,
				is_value: f.is_value,
				ret_telems: f.ret_telems,
				typarams: f.typarams,
				tbounds: f.tbounds,
				ret_size: f.ret_size,
				is_intrinsic: f.is_intrinsic,
				asm_sym: f.asm_sym,
			}),
		]
		i = i + 1
	}

	return out
}

# --- declaration spread (data/union), type_system §8 -------------------------------------
#
# A `data Ext = { ...Src, ... }` splices record `Src`'s fields in place; a `union Big = {
# ...Src, ... }` splices union `Src`'s members. The parser leaves a sentinel — a record field
# with ftype "$spread" (its source name in the field slot), or a union member with payloads
# == ["$spread"] (its source name in the member `name`). This pass, run after the flatten so
# every source declaration is visible, replaces each sentinel with the source's (recursively
# expanded) fields/members. The source must be a CONCRETE record (resp. union): a generic
# template is rejected, as is a cross-kind or duplicate-name splice.

# Index of a record / union by name, or -1 when absent.
const find_rec = ([RecDecl] recs, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(recs.len) then break
		if eq(recs[i].name, name) then return i
		i = i + 1
	}

	return -1
}

const find_union = ([UnionDecl] unions, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(unions.len) then break
		if eq(unions[i].name, name) then return i
		i = i + 1
	}

	return -1
}

# Whether a name already appears among the accumulated field / member names (collision).
const has_name = ([Str] names, Str name): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(names.len) then break
		if eq(names[i], name) then return true
		i = i + 1
	}

	return false
}

# Whether a union member is a spread sentinel (`payloads` is exactly `["$spread"]`).
const is_spread_member = (UnionMember m): Bool -> {
	if Iarch(m.payloads.len) != 1 then return false

	return eq(m.payloads[0], "$spread")
}

# A builtin non-aggregate type name — composing a bare union member over one of these is a
# deferred later brick (a compose-over LEAF like `Int8` needs the member usable as a standalone
# type argument; see the bound machinery). A bare member naming one is rejected (test 209).
const is_builtin_scalar_name = (Str n): Bool -> {
	if eq(n, "Iarch") then return true
	if eq(n, "Uarch") then return true
	if eq(n, "Int") then return true
	if eq(n, "Int8") then return true
	if eq(n, "Int16") then return true
	if eq(n, "Int32") then return true
	if eq(n, "Int64") then return true
	if eq(n, "Uint8") then return true
	if eq(n, "Uint16") then return true
	if eq(n, "Uint32") then return true
	if eq(n, "Uint64") then return true
	if eq(n, "Float32") then return true
	if eq(n, "Float64") then return true
	if eq(n, "Bool") then return true
	if eq(n, "Str") then return true

	return false
}

# §8.1 resolve-or-create: a BARE union member (no explicit payload) whose NAME denotes a declared
# record or union COMPOSES OVER it — the member carries that type as its single payload, so the
# value IS a value of that type (payload-is-the-value, §8.3), reachable as `U.Name(v)` /
# `match ... { U.Name(v) -> ... }` on the existing payload-member path. A name denoting nothing stays a
# fresh nullary tag (`Nil`, `Nothing`, `Red`). Composing over a builtin scalar is deferred (209).
# This is deliberately SCOPE-SENSITIVE (§8.1): a member whose name matches a type in scope IS that
# type. Runs inside `expand_union`, so both direct and spliced members are resolved.
const compose_member = (UnionMember mem, [RecDecl] recs, [UnionDecl] unions): UnionMember -> {
	if Iarch(mem.payloads.len) > 0 then return mem
	const Str nm = mem.name
	let Bool is_type = false
	if find_rec(recs, nm) >= 0 then is_type = true
	if find_union(unions, nm) >= 0 then is_type = true
	if is_type then {
		const [Str] ps = [nm]
		const [Str] pe = [""]
		const [TupElem] empty_tel = []
		const [[TupElem]] pt = [empty_tel]

		return UnionMember({ name: nm, payloads: ps, pelems: pe, ptelems: pt })
	}
	if is_builtin_scalar_name(nm)
		then die("cf: type: a union member composing over a builtin type is not yet supported\n")

	return mem
}

# Expand a record's declaration spreads into a flat field set. Each `$spread` sentinel names
# a source record; the source is looked up (must be a concrete record), recursively expanded,
# and its fields spliced in place — preserving order and rejecting name collisions. The depth
# guard turns an accidental spread cycle into a clean error instead of a hang.
const expand_rec = (RecDecl d, [RecDecl] recs, [UnionDecl] unions, Iarch depth): RecDecl -> {
	if depth > 64 then die("cf: spread: a record spread cycle\n")
	let [Str] fields = []
	let [Str] ftypes = []
	let [Str] felems = []
	let [[TupElem]] ftelems = []
	let [Bool] fptrs = []
	let [Iarch] fsizes = []
	let Iarch k = 0

	loop {
		if k >= Iarch(d.fields.len) then break

		if eq(d.ftypes[k], "$spread") then {
			const Str src = d.fields[k]
			const Iarch si = find_rec(recs, src)
			if si < 0 then {
				if find_union(unions, src) >= 0
					then die("cf: spread: a record can only spread a record, not a union\n")
				die("cf: spread: `...` names an undeclared record\n")
			}
			const RecDecl srd = recs[si]
			if Iarch(srd.typarams.len) > 0 then die("cf: spread: cannot spread a generic record template\n")
			const RecDecl ex = expand_rec(srd, recs, unions, depth + 1)
			let Iarch j = 0

			loop {
				if j >= Iarch(ex.fields.len) then break
				if has_name(fields, ex.fields[j])
					then die("cf: spread: a spliced field collides with an existing field\n")
				fields = [...fields, ex.fields[j]]
				ftypes = [...ftypes, ex.ftypes[j]]
				felems = [...felems, ex.felems[j]]
				ftelems = [...ftelems, ex.ftelems[j]]
				fptrs = [...fptrs, ex.fptrs[j]]
				fsizes = [...fsizes, ex.fsizes[j]]
				j = j + 1
			}
		} else {
			if has_name(fields, d.fields[k]) then die("cf: spread: a field collides with a spliced field\n")
			fields = [...fields, d.fields[k]]
			ftypes = [...ftypes, d.ftypes[k]]
			felems = [...felems, d.felems[k]]
			ftelems = [...ftelems, d.ftelems[k]]
			fptrs = [...fptrs, d.fptrs[k]]
			fsizes = [...fsizes, d.fsizes[k]]
		}

		k = k + 1
	}

	return RecDecl({
		name: d.name,
		fields: fields,
		ftypes: ftypes,
		felems: felems,
		ftelems: ftelems,
		fptrs: fptrs,
		typarams: d.typarams,
		tbounds: d.tbounds,
		fsizes: fsizes,
	})
}

# Expand a union's member spreads into a flat member set, mirroring `expand_rec`.
const expand_union! = (UnionDecl d, [RecDecl] recs, [UnionDecl] unions, Iarch depth): UnionDecl -> {
	if depth > 64 then die("cf: spread: a union spread cycle\n")
	let [UnionMember] members = []
	let [Str] names = []
	let Iarch k = 0

	loop {
		if k >= Iarch(d.members.len) then break
		const UnionMember mem = d.members[k]

		if is_spread_member(mem) then {
			const Str src = mem.name
			const Iarch si = find_union(unions, src)
			if si < 0 then {
				if find_rec(recs, src) >= 0
					then die("cf: spread: a union can only spread a union, not a record\n")
				die("cf: spread: `...` names an undeclared union\n")
			}
			const UnionDecl sud = unions[si]
			if Iarch(sud.typarams.len) > 0 then die("cf: spread: cannot spread a generic union template\n")
			const UnionDecl ex = expand_union!(sud, recs, unions, depth + 1)
			let Iarch j = 0

			loop {
				if j >= Iarch(ex.members.len) then break
				if has_name(names, ex.members[j].name)
					then die("cf: spread: a spliced member collides with an existing member\n")
				members = [...members, ex.members[j]]
				names = [...names, ex.members[j].name]
				j = j + 1
			}
		} else {
			const UnionMember cm = compose_member(mem, recs, unions)
			if has_name(names, cm.name) then die("cf: spread: a member collides with a spliced member\n")
			members = [...members, cm]
			names = [...names, cm.name]
		}

		k = k + 1
	}

	return UnionDecl({ name: d.name, members: members, typarams: d.typarams, tbounds: d.tbounds })
}

# Expand every record / union declaration's spreads. Lookups use the raw (pre-expansion)
# lists; `expand_rec`/`expand_union` re-expand a source on demand, so ordering is irrelevant.
const expand_recs = ([RecDecl] recs, [UnionDecl] unions): [RecDecl] -> {
	let [RecDecl] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(recs.len) then break
		out = [...out, expand_rec(recs[i], recs, unions, 0)]
		i = i + 1
	}

	return out
}

const expand_unions! = ([UnionDecl] unions, [RecDecl] recs): [UnionDecl] -> {
	let [UnionDecl] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(unions.len) then break
		out = [...out, expand_union!(unions[i], recs, unions, 0)]
		i = i + 1
	}

	return out
}

# --- member-type annotations (§8.1): validate + collapse `Union.Member` to `Union` -------------
# A member is a first-class type usable anywhere a type is (`Color.Red`, `Maybe[Iarch].Just`), but
# it DENOTES its union — cf collapses it to that union (a member value already widens to its union).
# The parser preserved the `Base.Member` spelling; this pass (run after expand, before monomorph)
# validates the member against the now-visible union tables and rewrites the annotation to `Base`.

# Index of the first byte `b` in `t`, or -1. A type name has no `.` except a member-type's one.
const index_of_byte = (Str t, Iarch b): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(t.len) then break
		if Iarch(t[i]) == b then return i
		i = i + 1
	}

	return -1
}

const str_prefix! = (Str t, Iarch k): Str -> {
	let [Uint8] v = []
	let Iarch i = 0

	loop {
		if i >= k then break
		v = [...v, t[i]]
		i = i + 1
	}

	return Str(v)
}

const str_suffix! = (Str t, Iarch k): Str -> {
	let [Uint8] v = []
	let Iarch i = k

	loop {
		if i >= Iarch(t.len) then break
		v = [...v, t[i]]
		i = i + 1
	}

	return Str(v)
}

# True when `hay` begins with the bytes of `needle`.
const has_prefix = (Str hay, Str needle): Bool -> {
	if hay.len < needle.len then return false
	let Iarch i = 0

	loop {
		if i >= Iarch(needle.len) then break
		if Iarch(hay[i]) != Iarch(needle[i]) then return false
		i = i + 1
	}

	return true
}

const union_has_mem = (UnionDecl u, Str member): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(u.members.len) then break
		if eq(u.members[i].name, member) then return true
		i = i + 1
	}

	return false
}

# Collapse a member-type annotation to its union, validating base + member (§8.1). `Color.Red` →
# `Color`; `Maybe[Iarch].Just` → `Maybe[Iarch]`. A plain type (no `.`) is returned unchanged, so
# this is a no-op on every ordinary annotation. Rejects a record base (685) or an unknown member (684).
const collapse_member_type! = (Str t, [RecDecl] recs, [UnionDecl] unions): Str -> {
	const Iarch d = index_of_byte(t, 46)
	if d < 0 then return t
	const Str base = str_prefix!(t, d)
	const Str member = str_suffix!(t, d + 1)
	const Iarch lb = index_of_byte(base, 91)   # `[` — strip a generic application to the union name
	let Str uname = base
	if lb >= 0 then uname = str_prefix!(base, lb)
	const Iarch ui = find_union(unions, uname)
	if ui < 0 then {
		if find_rec(recs, uname) >= 0
			then die("cf: type: a member type requires a union base (a record has no members)\n")
		die("cf: type: a member type names an unknown union\n")
	}
	if !union_has_mem(unions[ui], member)
		then die("cf: type: a member type names a non-member of its union\n")

	return base
}

# Rewrite every member-type annotation in a statement (a binding's `ann`), recursing into nested
# statement containers. NOT covered (each a later brick, and each fails LOUD at typecheck/monomorph
# — a dotted type is an unknown type — never a miscompile): an annotation buried in a value-yielding
# EXPRESSION (`loop`/`if`/block that yields), and a CLOSURE parameter/return type (monomorph likewise
# skips those, so a closure already rejects even a plain generic-app annotation there).
const norm_mt_stmt! = (Stmt s, [RecDecl] recs, [UnionDecl] unions): Stmt -> match s {
	Stmt.Let(n, m, ann, e) -> Stmt.Let(n, m, collapse_member_type!(ann, recs, unions), e),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, norm_mt_stmts!(body, recs, unions)),
	Stmt.Loop(ll_, body) -> Stmt.Loop(ll_, norm_mt_stmts!(body, recs, unions)),
	Stmt.IfThen(c, st) -> Stmt.IfThen(c, norm_mt_stmt!(st, recs, unions)),
	Stmt.IfElse(c, t, e) ->
		Stmt.IfElse(c, norm_mt_stmt!(t, recs, unions), norm_mt_stmt!(e, recs, unions)),
	Stmt.Block(stmts) -> Stmt.Block(norm_mt_stmts!(stmts, recs, unions)),
	Stmt.Match(scrut, arms) -> Stmt.Match(scrut, norm_mt_stmt_arms!(arms, recs, unions)),
	Stmt.Closure(nm, params, ret, body) ->
		Stmt.Closure(nm, params, ret, norm_mt_stmts!(body, recs, unions)),
	Stmt.Defer(body) -> Stmt.Defer(norm_mt_stmts!(body, recs, unions)),
	_ -> s,
}

const norm_mt_stmts! = ([Stmt] ss, [RecDecl] recs, [UnionDecl] unions): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = [...out, norm_mt_stmt!(ss[i], recs, unions)]
		i = i + 1
	}

	return out
}

const norm_mt_stmt_arms! = ([StmtArm] arms, [RecDecl] recs, [UnionDecl] unions): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [
			...out,
			StmtArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: norm_mt_stmts!(a.body, recs, unions),
			}),
		]
		i = i + 1
	}

	return out
}

# Collapse the member-type annotations in a function's parameters, return type, and body bindings.
const norm_mt_func! = (Func f, [RecDecl] recs, [UnionDecl] unions): Func -> {
	let [Param] ps = []
	let Iarch i = 0

	loop {
		if i >= Iarch(f.params.len) then break
		const Param p = f.params[i]
		ps = [
			...ps,
			Param({
				name: p.name,
				is_ptr: p.is_ptr,
				type_name: collapse_member_type!(p.type_name, recs, unions),
				elem: p.elem,
				telems: p.telems,
				size: p.size,
			}),
		]
		i = i + 1
	}

	return Func({
		name: f.name,
		is_pub: f.is_pub,
		ret_name: collapse_member_type!(f.ret_name, recs, unions),
		ret_elem: f.ret_elem,
		params: ps,
		body: norm_mt_stmts!(f.body, recs, unions),
		is_asm: f.is_asm,
		asm_body: f.asm_body,
		is_value: f.is_value,
		ret_telems: f.ret_telems,
		typarams: f.typarams,
		tbounds: f.tbounds,
		ret_size: f.ret_size,
		is_intrinsic: f.is_intrinsic,
		asm_sym: f.asm_sym,
	})
}

const norm_mt_funcs! = ([Func] fs, [RecDecl] recs, [UnionDecl] unions): [Func] -> {
	let [Func] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, norm_mt_func!(fs[i], recs, unions)]
		i = i + 1
	}

	return out
}

# Reject a user record/union that redeclares a builtin type name (`Bool`, `Str`, `Unit`, or a
# numeric width) — those names are reserved (§8.6), and `Bool` in particular is the injected union.
const reject_builtin_type_names = ([RecDecl] recs, [UnionDecl] unions): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(recs.len) then break
		if is_builtin_scalar_name(recs[i].name)
			then die("cf: type: a record may not redeclare a builtin type name\n")
		if eq(recs[i].name, "Unit")
			then die("cf: type: a record may not redeclare a builtin type name\n")
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(unions.len) then break
		if is_builtin_scalar_name(unions[j].name)
			then die("cf: type: a union may not redeclare a builtin type name\n")
		if eq(unions[j].name, "Unit")
			then die("cf: type: a union may not redeclare a builtin type name\n")
		j = j + 1
	}

	return 0
}

# --- grouped-parameter `type` splat (§7) -------------------------------------------------------
# Groups are record-shaped parameter bundles: a `(X g)` parameter becomes X's fields as individual
# parameters (the body uses the field names bare), and a `{ ... }` call argument for a group parameter
# expands to positional field values in the group's DECLARED order. Fully consumed by resolve.

const find_group = ([RecDecl] groups, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(groups.len) then break
		if eq(groups[i].name, name) then return i
		i = i + 1
	}

	return -1
}

const param_is_group = (Param p, [RecDecl] groups): Bool -> {
	if p.is_ptr then return false

	return find_group(groups, p.type_name) >= 0
}

# The fi-th field of a group as a Param (preserving `$dyn`/`$tuple`/`$ptr` field shapes).
const group_field_param = (RecDecl g, Iarch fi): Param -> {
	const Str ft = g.ftypes[fi]
	const [TupElem] no_tel = []
	if eq(ft, "$dyn")
		then return Param({
		name: g.fields[fi],
		is_ptr: false,
		type_name: "$dyn",
		elem: g.felems[fi],
		telems: no_tel,
		size: 0,
	})
	if eq(ft, "$tuple")
		then return Param({
		name: g.fields[fi],
		is_ptr: false,
		type_name: "$tuple",
		elem: "",
		telems: g.ftelems[fi],
		size: 0,
	})
	if eq(ft, "$ptr")
		then return Param({
		name: g.fields[fi],
		is_ptr: true,
		type_name: "$ptr",
		elem: "",
		telems: no_tel,
		size: 0,
	})

	return Param({
		name: g.fields[fi],
		is_ptr: false,
		type_name: ft,
		elem: "",
		telems: no_tel,
		size: 0,
	})
}

# Expand a function's parameters: a group parameter `(X g)` becomes X's fields (in order); others
# pass through. A duplicate parameter name after splatting (a field colliding with another param) is
# a duplicate-parameter error (627).
const splat_params! = ([RecDecl] groups, [Param] params): [Param] -> {
	let [Param] out = []
	let [Str] names = []
	let Iarch i = 0

	loop {
		if i >= Iarch(params.len) then break

		if param_is_group(params[i], groups) then {
			const RecDecl g = groups[find_group(groups, params[i].type_name)]
			let Iarch f = 0

			loop {
				if f >= Iarch(g.fields.len) then break
				const Param fp = group_field_param(g, f)
				if has_name(names, fp.name)
					then die("cf: type: a grouped parameter's field collides with another parameter\n")
				out = [...out, fp]
				names = [...names, fp.name]
				f = f + 1
			}
		} else {
			if has_name(names, params[i].name) then die("cf: type: a duplicate parameter name\n")
			out = [...out, params[i]]
			names = [...names, params[i].name]
		}

		i = i + 1
	}

	return out
}

# A bare `{ ... }` group-literal argument (a `Record` with an empty type_name) and its inits.
const is_bare_record_r = (Expr e): Bool ->
	match e { Expr.Record(tn, fs) -> eq(tn, ""), _ -> false }

const record_inits_r = (Expr e): [FieldInit] -> {
	let [FieldInit] r = []

	match e {
		Expr.Record(tn, fs) -> {
			r = fs
		},
		_ -> {},
	}

	return r
}

# Expand a group-literal argument `{ f1: v1, ... }` into positional field values in the GROUP's field
# order. Every group field must be present exactly once (a missing field 634 or extra field 635 is
# rejected); each value is itself splatted (a nested group call).
const expand_group_lit = ([RecDecl] groups, RecDecl g, [FieldInit] inits): [Expr] -> {
	if Iarch(inits.len) != Iarch(g.fields.len)
		then die("cf: type: a group literal must set every field of the group exactly once\n")
	let [Expr] vals = []
	let Iarch f = 0

	loop {
		if f >= Iarch(g.fields.len) then break
		let Iarch found = -1
		let Iarch k = 0

		loop {
			if k >= Iarch(inits.len) then break
			if eq(inits[k].field, g.fields[f]) then {
				found = k
				k = Iarch(inits.len)
			} else k = k + 1
		}

		if found < 0 then die("cf: type: a group literal is missing a field of the group\n")
		vals = [...vals, inits[found].value]
		f = f + 1
	}

	return vals
}

const splat_call = (Str callee, [Str] ta, [Expr] args, [Func] funcs, [RecDecl] groups): Expr -> {
	# recurse into every argument first (nested calls / literals)
	let [Expr] sargs = []
	let Iarch a0 = 0

	loop {
		if a0 >= Iarch(args.len) then break
		sargs = [...sargs, splat_expr(args[a0], funcs, groups)]
		a0 = a0 + 1
	}

	# does the callee have group parameters? (look up its ORIGINAL, pre-splat signature)
	const Iarch fi = find_func_r(funcs, callee)
	if fi < 0 then return Expr.Call(callee, ta, sargs, "")
	const [Param] ps = funcs[fi].params
	let Bool any_group = false
	let Iarch pg = 0

	loop {
		if pg >= Iarch(ps.len) then break
		if param_is_group(ps[pg], groups) then any_group = true
		pg = pg + 1
	}

	if !any_group then return Expr.Call(callee, ta, sargs, "")
	# a grouped-parameter callee must be called with one argument per ORIGINAL parameter
	if Iarch(sargs.len) != Iarch(ps.len)
		then die("cf: type: a grouped-parameter call needs one argument per parameter (a `{...}` for each group)\n")
	let [Expr] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ps.len) then break

		if param_is_group(ps[i], groups) then {
			if !is_bare_record_r(sargs[i])
				then die("cf: type: a grouped parameter must be passed a `{...}` literal argument\n")
			const RecDecl g = groups[find_group(groups, ps[i].type_name)]
			out = cat_exprs(out, expand_group_lit(groups, g, record_inits_r(sargs[i])))
		} else {
			out = [...out, sargs[i]]
		}

		i = i + 1
	}

	return Expr.Call(callee, ta, out, "")
}

const find_func_r = ([Func] funcs, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(funcs.len) then break
		if eq(funcs[i].name, name) then return i
		i = i + 1
	}

	return -1
}

const cat_exprs = ([Expr] a, [Expr] b): [Expr] -> {
	let [Expr] o = a
	let Iarch i = 0

	loop {
		if i >= Iarch(b.len) then break
		o = [...o, b[i]]
		i = i + 1
	}

	return o
}

# The call-expanding expression walk — mirrors `mangle_expr`, rewriting only `Call` (via `splat_call`)
# and recursing everywhere else.
const splat_exprs = ([Expr] es, [Func] funcs, [RecDecl] groups): [Expr] -> {
	let [Expr] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		o = [...o, splat_expr(es[i], funcs, groups)]
		i = i + 1
	}

	return o
}

const splat_fields = ([FieldInit] fs, [Func] funcs, [RecDecl] groups): [FieldInit] -> {
	let [FieldInit] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		o = [...o, FieldInit({ field: fs[i].field, value: splat_expr(fs[i].value, funcs, groups) })]
		i = i + 1
	}

	return o
}

const splat_arms = ([MatchArm] arms, [Func] funcs, [RecDecl] groups): [MatchArm] -> {
	let [MatchArm] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		o = [
			...o,
			MatchArm({
				is_wild: arms[i].is_wild,
				type_name: arms[i].type_name,
				members: arms[i].members,
				binds: arms[i].binds,
				body: splat_expr(arms[i].body, funcs, groups),
			}),
		]
		i = i + 1
	}

	return o
}

const splat_segs = ([Seg] segs, [Func] funcs, [RecDecl] groups): [Seg] -> {
	let [Seg] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		o = [
			...o,
			Seg({
				is_hole: segs[i].is_hole,
				lit: segs[i].lit,
				name: segs[i].name,
				expr: splat_expr(segs[i].expr, funcs, groups),
			}),
		]
		i = i + 1
	}

	return o
}

const splat_expr = (Expr e, [Func] funcs, [RecDecl] groups): Expr -> match e {
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	Expr.Var(n) -> Expr.Var(n),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(n, splat_fields(fs, funcs, groups)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(splat_expr(b, funcs, groups), f),
	Expr.UnionMk(t, m, args) -> Expr.UnionMk(t, m, splat_exprs(args, funcs, groups)),
	Expr.Match(scrut, arms) ->
		Expr.Match(splat_expr(scrut, funcs, groups), splat_arms(arms, funcs, groups)),
	Expr.ArrayLit(hs, sn, elems, et) ->
		Expr.ArrayLit(hs, splat_expr(sn, funcs, groups), splat_exprs(elems, funcs, groups), et),
	Expr.Index(a, i) -> Expr.Index(a, splat_expr(i, funcs, groups)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, splat_expr(i, funcs, groups), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(splat_expr(b, funcs, groups), splat_expr(i, funcs, groups)),
	Expr.Tuple(elems) -> Expr.Tuple(splat_exprs(elems, funcs, groups)),
	Expr.Spread(x) -> Expr.Spread(splat_expr(x, funcs, groups)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(splat_stmts(body, funcs, groups)),
	Expr.Interp(segs) -> Expr.Interp(splat_segs(segs, funcs, groups)),
	Expr.Buffer(sz) -> Expr.Buffer(splat_expr(sz, funcs, groups)),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(splat_expr(x, funcs, groups)),
	Expr.Not(x) -> Expr.Not(splat_expr(x, funcs, groups)),
	Expr.BitNot(x) -> Expr.BitNot(splat_expr(x, funcs, groups)),
	Expr.Add(l, r) -> Expr.Add(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.Sub(l, r) -> Expr.Sub(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.Mul(l, r) -> Expr.Mul(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.Div(l, r) -> Expr.Div(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.Mod(l, r) -> Expr.Mod(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.BitOr(l, r) -> Expr.BitOr(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.BitXor(l, r) -> Expr.BitXor(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.Shl(l, r) -> Expr.Shl(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.Shr(l, r) -> Expr.Shr(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.And(l, r) -> Expr.And(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.Or(l, r) -> Expr.Or(splat_expr(l, funcs, groups), splat_expr(r, funcs, groups)),
	Expr.If(c, t, e2) -> Expr.If(
		splat_expr(c, funcs, groups),
		splat_expr(t, funcs, groups),
		splat_expr(e2, funcs, groups),
	),
	Expr.Call(n, ta, args, g) -> with_geom(splat_call(n, ta, args, funcs, groups), g),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(fn, splat_exprs(args, funcs, groups)),
}

const splat_stmts = ([Stmt] ss, [Func] funcs, [RecDecl] groups): [Stmt] -> {
	let [Stmt] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		o = [...o, splat_stmt(ss[i], funcs, groups)]
		i = i + 1
	}

	return o
}

const splat_stmt_arms = ([StmtArm] arms, [Func] funcs, [RecDecl] groups): [StmtArm] -> {
	let [StmtArm] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		o = [
			...o,
			StmtArm({
				is_wild: arms[i].is_wild,
				type_name: arms[i].type_name,
				members: arms[i].members,
				binds: arms[i].binds,
				body: splat_stmts(arms[i].body, funcs, groups),
			}),
		]
		i = i + 1
	}

	return o
}

const splat_stmt = (Stmt s, [Func] funcs, [RecDecl] groups): Stmt -> match s {
	Stmt.Let(n, m, ann, e) -> Stmt.Let(n, m, ann, splat_expr(e, funcs, groups)),
	Stmt.Destructure(pat, m, e) -> Stmt.Destructure(pat, m, splat_expr(e, funcs, groups)),
	Stmt.Yield(e) -> Stmt.Yield(splat_expr(e, funcs, groups)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, splat_expr(e, funcs, groups)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, splat_expr(e, funcs, groups)),
	Stmt.DeepFieldAssign(be, f, e) ->
		Stmt.DeepFieldAssign(splat_expr(be, funcs, groups), f, splat_expr(e, funcs, groups)),
	Stmt.IndexAssign(a, i, v) ->
		Stmt.IndexAssign(a, splat_expr(i, funcs, groups), splat_expr(v, funcs, groups)),
	Stmt.Return(e) -> Stmt.Return(splat_expr(e, funcs, groups)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, splat_stmts(body, funcs, groups)),
	Stmt.Loop(ll_, body) -> Stmt.Loop(ll_, splat_stmts(body, funcs, groups)),
	Stmt.Break(bl_) -> Stmt.Break(bl_),
	Stmt.Continue(bl_) -> Stmt.Continue(bl_),
	Stmt.IfThen(c, st) -> Stmt.IfThen(splat_expr(c, funcs, groups), splat_stmt(st, funcs, groups)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(
		splat_expr(c, funcs, groups),
		splat_stmt(t, funcs, groups),
		splat_stmt(e, funcs, groups),
	),
	Stmt.Do(e) -> Stmt.Do(splat_expr(e, funcs, groups)),
	Stmt.Block(stmts) -> Stmt.Block(splat_stmts(stmts, funcs, groups)),
	Stmt.Match(scrut, arms) ->
		Stmt.Match(splat_expr(scrut, funcs, groups), splat_stmt_arms(arms, funcs, groups)),
	Stmt.Closure(nm, params, ret, body) ->
		Stmt.Closure(nm, params, ret, splat_stmts(body, funcs, groups)),
	Stmt.Defer(body) -> Stmt.Defer(splat_stmts(body, funcs, groups)),
}

# A group `type` names only PARAMETERS — never a return type (629) or a record field type (630) —
# and its name may not collide with a declared `data`/`union` (626) or a builtin type name.
const reject_group_misuse = ([Func] funcs, [RecDecl] recs, [UnionDecl] unions, [RecDecl] groups): Iarch -> {
	let Iarch gi = 0

	loop {
		if gi >= Iarch(groups.len) then break
		const Str gn = groups[gi].name
		if find_rec(recs, gn) >= 0 || find_union(unions, gn) >= 0
			then die("cf: type: a grouped-parameter `type` name collides with a declared type\n")
		if is_builtin_scalar_name(gn) || eq(gn, "Unit")
			then die("cf: type: a grouped-parameter `type` may not redeclare a builtin type name\n")
		gi = gi + 1
	}

	let Iarch i = 0

	loop {
		if i >= Iarch(funcs.len) then break
		if find_group(groups, funcs[i].ret_name) >= 0
			then die("cf: type: a grouped-parameter `type` may not be a return type\n")
		i = i + 1
	}

	let Iarch r = 0

	loop {
		if r >= Iarch(recs.len) then break
		let Iarch f = 0

		loop {
			if f >= Iarch(recs[r].fields.len) then break
			if find_group(groups, recs[r].ftypes[f]) >= 0
				then die("cf: type: a grouped-parameter `type` may not be a record field type\n")
			f = f + 1
		}

		r = r + 1
	}

	return 0
}

# Desugar every grouped-parameter `type`: splat group parameters and expand group-literal calls.
const splat_groups! = ([Func] funcs, [RecDecl] recs, [UnionDecl] unions, [RecDecl] groups): [Func] -> {
	if Iarch(groups.len) == 0 then return funcs
	reject_group_misuse(funcs, recs, unions, groups)
	let [Func] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(funcs.len) then break
		const Func f = funcs[i]
		const [Param] nps = splat_params!(groups, f.params)
		const [Stmt] nbody = splat_stmts(f.body, funcs, groups)
		out = [
			...out,
			Func({
				name: f.name,
				is_pub: f.is_pub,
				ret_name: f.ret_name,
				ret_elem: f.ret_elem,
				params: nps,
				body: nbody,
				is_asm: f.is_asm,
				asm_body: f.asm_body,
				is_value: f.is_value,
				ret_telems: f.ret_telems,
				typarams: f.typarams,
				tbounds: f.tbounds,
				ret_size: f.ret_size,
				is_intrinsic: f.is_intrinsic,
				asm_sym: f.asm_sym,
			}),
		]
		i = i + 1
	}

	return out
}

# Is this import path a compiler-supplied pseudo-module? `comptime` is now the real `std::comptime`
# module (§7); only `runtime` remains a reserved pseudo-namespace (out of scope here) — it backs no
# `.cf` file, so the loader never opens it and it contributes no module.
const is_pseudo_module = (Str path): Bool -> {
	if eq(path, "runtime") then return true

	return false
}

# Is this import path a per-target FLOOR implementation (`std/rt/floor/<arch>/<os>`)? Its asm fns are
# the freestanding entry + arena runtime — emitted under FIXED symbols, not positional `f<idx>`.
const is_floor_impl = (Str path): Bool -> starts_with("std/rt/floor/", path)

# `f` with its `asm_sym` set to `sym` (the sole field that changes) — cf has no record-update spread,
# so every field is copied.
const with_asm_sym = (Func f, Str sym): Func -> Func({
	name: f.name,
	is_pub: f.is_pub,
	ret_name: f.ret_name,
	ret_elem: f.ret_elem,
	params: f.params,
	body: f.body,
	is_asm: f.is_asm,
	asm_body: f.asm_body,
	is_value: f.is_value,
	ret_telems: f.ret_telems,
	typarams: f.typarams,
	tbounds: f.tbounds,
	ret_size: f.ret_size,
	is_intrinsic: f.is_intrinsic,
	asm_sym: sym,
})

# Tag every asm function of a privileged floor module so it emits under its EXACT source symbol
# (`_start`, `cf_root_page_grow`) — the entry and the `raw::grow`/`raw::trap` lowerings link by that
# fixed name. Runs at load, BEFORE mangling, so `asm_sym` captures the source name (mangling rewrites
# `name`, never this). A no-op for a module with no asm fns.
const tag_floor_syms = (Program p): Program -> {
	let [Func] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(p.funcs.len) then break
		const Func f = p.funcs[i]

		if f.is_asm then out = [...out, with_asm_sym(f, f.name)] else out = [...out, f]

		i = i + 1
	}

	return Program({ imports: p.imports, recs: p.recs, unions: p.unions, funcs: out, groups: p.groups })
}

# Load the entry module and flatten its transitive import graph into one Program in TWO passes.
# Pass 1 loads every module (the work list grows as newly loaded modules contribute imports;
# `find_mod` dedups by resolved path so a diamond or a cycle loads each once), keeping each
# UNMANGLED with its flat prefix. Pass 2 mangles every module's value members apart —
# `<prefix>_<name>` keyed on its path — so two modules may export the same name, resolving each
# cross-module reference through the module's imports (module_system §8).
pub const resolve_program! = (Str entry, Os target_os, Arch target_arch): Program -> {
	const Str edir = dir_of!(entry)
	const Program root = load_module!(entry, target_os, target_arch)
	# the entry is prefix-empty (its names stay bare — it fixes the naming frame)
	let [Modu] mods = [Modu({ prefix: "", mpath: entry, is_geom: false, tag: "", prog: root })]
	let [Import] work = []
	work = cat_imports(work, root.imports)
	# AUTO-INJECT the freestanding floor barrel (module_system): every program links the per-target
	# arena runtime (`cf_root_page_init`/`grow`/`oom`) whether or not it names it — exactly as the
	# compiler used to emit that floor unconditionally. The barrel's `comptime_if` (folded against this
	# program's `--target`) loads the one platform impl; its verbatim-symbol asm fns define the floor.
	const [Str] floor_none = []
	work = [...work, Import({ path: "std/rt/floor", names: floor_none, alias: "", wildcard: false })]
	let Iarch wi = 0

	loop {
		if wi >= Iarch(work.len) then break
		const Import im = work[wi]

		if is_pseudo_module(im.path) then {
			wi = wi + 1
		} else {
			# `std/`-prefixed imports resolve under the fixed library root, not the entry dir. The lib
			# root is the cwd-relative literal "lib/" for the fixed-target bootstrap (a later brick may
			# derive it from argv[0]). `build_path("lib/", "std/math")` → "lib/std/math.cf".
			const Str mpath = mod_target_path!(edir, im.path)
			if find_mod(mods, mpath) < 0 then {
				# a std GEOMETRY module keeps a FIXED per-shape SUFFIX tag rather than a path prefix: the
				# compiler references its (private) hooks by mangled name — `of__fx` — from emit, so the
				# name cannot depend on the path. (keyed on the IMPORT path string.)
				let Bool geom = false
				let Str mtag = ""
				if eq(im.path, "std/mem/fixed_buffer") then {
					geom = true
					mtag = "fb"
				}
				if eq(im.path, "std/mem/arena/fixed_arena") then {
					geom = true
					mtag = "fx"
				}
				if eq(im.path, "std/mem/arena/growing_arena") then {
					geom = true
					mtag = "el"
				}
				if eq(im.path, "std/mem/page") then {
					geom = true
					mtag = "pg"
				}
				const Program m0 = load_module!(mpath, target_os, target_arch)
				const Program m = if is_floor_impl(im.path) then tag_floor_syms(m0) else m0
				mods = [
					...mods,
					Modu({ prefix: sanitize_prefix!(im.path), mpath: mpath, is_geom: geom, tag: mtag, prog: m }),
				]
				work = cat_imports(work, m.imports)
			}
			wi = wi + 1
		}
	}

	# precompute, for every loaded module, the target-module index of each of its imports, so
	# export resolution never re-opens a path (keeping the mangle walkers allocation-free).
	let [[Iarch]] itargets = []
	let Iarch ti = 0

	loop {
		if ti >= Iarch(mods.len) then break
		let [Iarch] row = []
		let Iarch ri = 0

		loop {
			if ri >= Iarch(mods[ti].prog.imports.len) then break
			# the raw-memory substrate is privileged: only the geometry modules under lib/std/mem/
			# may import it (module_system; geometry_lowering §1 — userland never reaches raw ops)
			if eq(mods[ti].prog.imports[ri].path, "std/mem/raw") &&
				!has_prefix(mods[ti].mpath, "lib/std/mem/")
					then die("cf: resolve: `std/mem/raw` is privileged to the geometry modules under `std/mem/`\n")
			let Iarch t = -1
			if !is_pseudo_module(mods[ti].prog.imports[ri].path)
				then t = find_mod(mods, mod_target_path!(edir, mods[ti].prog.imports[ri].path))
			row = [...row, t]
			ri = ri + 1
		}

		itargets = [...itargets, row]
		ti = ti + 1
	}

	const Rctx rc = Rctx({ mods: mods, edir: edir, itargets: itargets })
	let [RecDecl] recs = []
	let [UnionDecl] unions = []
	let [Func] funcs = []
	let [RecDecl] groups = []
	let Iarch mi = 0

	loop {
		if mi >= Iarch(mods.len) then break
		recs = cat_recs(recs, mods[mi].prog.recs)
		unions = cat_unions(unions, mods[mi].prog.unions)
		groups = cat_recs(groups, mods[mi].prog.groups) # grouped-parameter `type` decls (splatted below)
		funcs = cat_funcs(funcs, mangle_module_funcs!(mi, rc))
		mi = mi + 1
	}

	let [Import] none = []
	# a user type may not redeclare a builtin (`Bool`/`Str`/`Iarch`/`Int8`/... — the names are
	# reserved, §8.6); checked on the raw decls before expansion/injection
	reject_builtin_type_names(recs, unions)
	# expand declaration spreads now that every source record/union is visible
	const [RecDecl] erecs = expand_recs(recs, unions)
	const [UnionDecl] eunions = expand_unions!(unions, recs)
	# collapse member-type annotations (`Color.Red` → `Color`, §8.1) against the expanded tables,
	# before monomorph sees the signatures — validating the base union and member
	const [Func] nfuncs = norm_mt_funcs!(funcs, erecs, eunions)
	# grouped-parameter `type` desugar (§7): splat group params into individual params and expand
	# `{ ... }` group-literal call args into positional values — CONSUMES `groups` (empty afterward)
	const [Func] gfuncs = splat_groups!(nfuncs, erecs, eunions, groups)
	const [RecDecl] nogroups = []

	return Program({ imports: none, recs: erecs, unions: eunions, funcs: gfuncs, groups: nogroups })
}
