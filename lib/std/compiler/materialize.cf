# The Materialize substep of the Memory arc (order_of_compilation, Memory; geometry_lowering
# §2): render the geometry DECISION into the program. Runs right after monomorphization —
# the call graph is concrete, and the minted code still flows through typecheck, the defer
# and closure lowerings, and routing like any hand-written function.
#
# Three jobs, all for the geometries whose logic lives in std source (fixed_buffer, arena):
#
#   1. (fn × geometry) duplication — every function that may allocate and is reachable under
#      a geometry ambient (an `in b` call whose binding traces to that geometry's
#      constructor) is copied under the geometry's fixed mangle tag: `f` → `f__fb`/`f__fx`/`f__el`.
#      Emit lowers the copy's allocation sites to the geometry's own hooks instead of the
#      shared bump floor — in FOLD-LITE form: a construction reserves through
#      `reserve_alloc`/`reserve_ret` and is built directly in the reservation (the fused
#      `on_alloc`/`on_ret`, identity-law-equal).
#   2. Call retargeting — the `in b` seed sites and, inside the copies, every direct call to
#      another may-allocate function are pointed at the geometry twins, so the whole subtree
#      under the geometry is hook-lowered.
#   3. Per-type claim instances — each geometry's generic `on_alloc_ret['T]` is specialized
#      per claimed record type (`on_alloc_ret__fb$Box`) from the PRE-mono template (mono
#      drops uninstantiated templates, so the raw program supplies them). The instances are
#      ordinary functions from here on: typechecked, routed, emitted.
#
# The table is rebuilt as the REACHABLE VARIANTS of a (fn × tag) walk from `main`: a call
# site inside a variant flows its callee to the tag the retarget rewrite will point it at,
# so exactly the originals and copies the final program references are emitted — an original
# every ambient caller was retargeted away from is never minted, which is what keeps the
# whole-program case (the compiler under its own graft) from doubling the function table.
# Indirect references (a bare function name feeding a HOF or a value binding) always keep
# the legacy original alive: indirect sites stay on the runtime-dispatch floor by design.
#
# The frontier is FAIL-SAFE: any site this pass cannot prove (an indirect call, a node handle
# passed as a plain word, a geometry binding it cannot trace) simply stays on the legacy
# runtime-kind-dispatch floor — correct because hook bodies and the floor honor the same
# duplex node layout. Materialization is an optimization frontier, never a soundness one.

import std::io::console::{ die }
import std::data::str::{ eq }
import std::compiler::ast::{
	Program,
	Func,
	Param,
	Stmt,
	Expr,
	FieldInit,
	Seg,
	MatchArm,
	StmtArm,
	RecDecl,
	UnionDecl,
	UnionMember,
}
import std::compiler::routing::{ kids, stmt_exprs }

# The pass result: the rewritten program plus the geometry copies — `names[i]` is a copy's
# function name and `geoms[i]` its tag ("fb"/"fx"/"el"/"pg"); emit consults the pair to pick the hook
# lowering for exactly those bodies.
pub data Mat = { Program prog, [Str] names, [Str] geoms, [Func] dropped }

# The ambient a reach tag names, as a parent geometry: the legacy/root (0) and page (4) tags are
# both the page root; fb/fx/el are themselves. Used only to tell whether an arena is carved from the
# page ambient (so `reserve_ret__pg` — the page's published entry — must be kept).
const tag_ambient_name = (Iarch tg): Str -> {
	if tg == 1 then return "fb"
	if tg == 2 then return "fx"
	if tg == 3 then return "el"

	return "pg"
}

# A reference site: the owning function's index, the callee name, the `in` binding (`""` =
# the ambient node), and whether the reference is DIRECT (a call / defer-tap — retargetable)
# or a bare name feeding an indirect site (rides along so value-const AUTO-CALLS returning
# records are seen by the instance collection, and so reachability keeps the original).
data CSite = { Iarch fnidx, Str callee, Str geom, Bool direct }

# A geometry-constructor binding: `const b = mem.arena.grow(n)` in function `fnidx`, with
# the geometry tag its constructor names ("fb" for `fixed_buffer.of`, "fx" for `fixed_arena.of`,
# "el" for `growing_arena.of` — the resolved constructor-intrinsic tokens).
data GBind = { Iarch fnidx, Str name, Str geom }

# The rewrite context threaded through the retarget walkers: the per-tag copy-name sets,
# the owning function's constructor bindings (parallel name/geom arrays), and the tag of
# the variant being built ("" for an original that holds seed sites).
data Rt = { [Str] fbn, [Str] fxn, [Str] eln, [Str] pgn, [Str] bnames, [Str] bgeoms, Str tag }

const has_str = ([Str] xs, Str n): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(xs.len) then break
		if eq(xs[i], n) then return true
		i = i + 1
	}

	return false
}

const find_fn = ([Func] fs, Str n): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		if eq(fs[i].name, n) then return i
		i = i + 1
	}

	return -1
}

const name_has_bang = (Str n): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(n.len) then break
		if Iarch(n[i]) == 33 then return true
		i = i + 1
	}

	return false
}

# A page-module function name (resolve's fixed `pg` mangle tag). The page module is imported
# into every program (its ambient has no surface keyword), so when nothing exercises it the
# pass strips these back out, restoring the pre-import table byte-for-byte.
const name_ends_pg = (Str n): Bool -> {
	const Iarch l = Iarch(n.len)
	if l < 4 then return false

	return Iarch(n[l - 4]) == 95 &&
		Iarch(n[l - 3]) == 95 &&
		Iarch(n[l - 2]) == 112 &&
		Iarch(n[l - 1]) == 103
}

const strip_pg = (Program prog): Program -> {
	let [Func] kept = []
	let Iarch i = 0

	loop {
		if i >= Iarch(prog.funcs.len) then break
		if !name_ends_pg(prog.funcs[i].name) then kept = [...kept, prog.funcs[i]]
		i = i + 1
	}

	return Program({
		imports: prog.imports,
		recs: prog.recs,
		unions: prog.unions,
		funcs: kept,
		groups: prog.groups,
	})
}

# Strip the dormant page module but PRESERVE `reserve_ret__pg`: a `main([Str] args)` program that
# materializes nothing still needs the ret reserve for the pre-main argv bridge (`cf_build_args`).
# `reserve_ret__pg` is a leaf (only `mem::raw::*` + the floor grow/oom), so keeping it alone is closed.
const strip_pg_keep_reserve = (Program prog): Program -> {
	let [Func] kept = []
	let Iarch i = 0

	loop {
		if i >= Iarch(prog.funcs.len) then break
		if !name_ends_pg(prog.funcs[i].name) || eq(prog.funcs[i].name, "reserve_ret__pg")
			then kept = [...kept, prog.funcs[i]]
		i = i + 1
	}

	return Program({
		imports: prog.imports,
		recs: prog.recs,
		unions: prog.unions,
		funcs: kept,
		groups: prog.groups,
	})
}

# ── the direct-allocation scan (the may-allocate seed bit) ───────────────────────────────
# Conservative on purpose: any construction counts (even under `$`-stack storage) — an
# over-included function merely gains a harmless copy; an under-included one stays legacy,
# which is still correct. `!` names are seeds too (bang-by-propagation frames bracket).

# A boxed union (any member carries a payload) — a value of it is a heap pointer, so even a
# TAG-ONLY member `U.Member` is a one-word box (emit_field! reserves 8 bytes for the tag).
# A tag-only union rides as a bare word tag and allocates nothing. (Mirrors alloc.cf's
# `union_boxed`; a non-union base — a record field read — finds no union and counts as false.)
const union_boxed = ([UnionDecl] unions, Str name): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(unions.len) then break
		if eq(unions[i].name, name) then {
			let Iarch j = 0

			loop {
				if j >= Iarch(unions[i].members.len) then break
				if Iarch(unions[i].members[j].payloads.len) > 0 then return true
				j = j + 1
			}

			return false
		}
		i = i + 1
	}

	return false
}

const alloc_expr = (Expr e, [UnionDecl] uns): Bool -> {
	const Bool here = match e {
		Expr.Record(_, _) -> true,
		Expr.ArrayLit(_, _, _, _) -> true,
		Expr.Tuple(_) -> true,
		Expr.Interp(_) -> true,
		Expr.StrLit(_) -> true,
		Expr.Buffer(_) -> true,
		Expr.UnionMk(_, _, _) -> true,
		# `U.Member` on a boxed union is a tag-only box (emit_field! reserves 8 bytes) — a
		# heap construction the syntactic scan would otherwise miss (it reads as a Field, not
		# a UnionMk), leaving the boxing function unmaterialized and stuck on the `cf_alloc` floor.
		Expr.Field(b, _) -> union_boxed(uns, b),
		Expr.Call(n, _, _, _) ->
			eq(n, "Str") || eq(n, "of__fx") || eq(n, "of__el") || eq(n, "of__fb"),
		_ -> false,
	}

	if here then return true

	return match e { Expr.Loop(ss) -> alloc_body(ss, uns), _ -> alloc_list(kids(e), uns) }
}

const alloc_list = ([Expr] es, [UnionDecl] uns): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if alloc_expr(es[i], uns) then return true
		i = i + 1
	}

	return false
}

const alloc_stmt = (Stmt s, [UnionDecl] uns): Bool -> {
	if alloc_list(stmt_exprs(s), uns) then return true

	return match s {
		Stmt.IfThen(_, b) -> alloc_stmt(b, uns),
		Stmt.IfElse(_, t, el) -> alloc_stmt(t, uns) || alloc_stmt(el, uns),
		Stmt.Block(ss) -> alloc_body(ss, uns),
		Stmt.Loop(ll_, ss) -> alloc_body(ss, uns),
		Stmt.ForIn(_, _, ss) -> alloc_body(ss, uns),
		Stmt.Match(_, arms) -> alloc_arms(arms, uns),
		Stmt.Defer(ss) -> alloc_body(ss, uns),
		Stmt.Closure(_, _, _, cb) -> alloc_body(cb, uns),
		_ -> false,
	}
}

const alloc_arms = ([StmtArm] arms, [UnionDecl] uns): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if alloc_body(arms[i].body, uns) then return true
		i = i + 1
	}

	return false
}

const alloc_body = ([Stmt] ss, [UnionDecl] uns): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		if alloc_stmt(ss[i], uns) then return true
		i = i + 1
	}

	return false
}

# ── the reference-site sweep ─────────────────────────────────────────────────────────────

const cs_expr! = (Expr e, Iarch fi, [CSite] acc): [CSite] -> {
	# the append is a statement-position SELF-append so it lowers to the grow-in-place
	# push: the accumulator is ONE shared header threaded through the whole sweep, mutated
	# in place (the array-aliasing behavior, deliberate here). The expression-arm form
	# `[...acc, x]` copies the whole array per site — quadratic in a function's site count,
	# which on the compiler's biggest bodies alone costs hundreds of MB of survivor churn.
	let [CSite] a1 = acc

	match e {
		Expr.Call(n, _, _, g) -> {
			a1 = [...a1, CSite({ fnidx: fi, callee: n, geom: g, direct: true })]
		},
		Expr.DeferTap(f, _) -> {
			a1 = [...a1, CSite({ fnidx: fi, callee: f, geom: "", direct: true })]
		},
		Expr.Var(n) -> {
			a1 = [...a1, CSite({ fnidx: fi, callee: n, geom: "", direct: false })]
		},
		Expr.Field(b, _) -> {
			a1 = [...a1, CSite({ fnidx: fi, callee: b, geom: "", direct: false })]
		},
		Expr.Index(b, _) -> {
			a1 = [...a1, CSite({ fnidx: fi, callee: b, geom: "", direct: false })]
		},
		Expr.IndexField(b, _, _) -> {
			a1 = [...a1, CSite({ fnidx: fi, callee: b, geom: "", direct: false })]
		},
		_ -> { },
	}

	# A Call's arguments: a bare fn-NAME argument (`apply(sq!, x)`) is a fn-value that the HOF
	# invokes under the CALL's ambient — so it flows like the callee to the call's geom (`g`),
	# minting the geometry copy the retarget will point it at. (A non-fn Var arg resolves to no
	# function and is skipped in the reach walk; other args recurse normally.) This is what closes
	# the indirect-allocation gap: the callback allocates through the geometry, not the `cf_alloc` floor.
	return match e {
		Expr.Call(_, _, cargs, g) -> cs_call_args!(cargs, fi, g, a1),
		Expr.Loop(ss) -> cs_body!(ss, fi, a1),
		_ -> cs_list!(kids(e), fi, a1),
	}
}

const cs_call_args! = ([Expr] args, Iarch fi, Str g, [CSite] acc): [CSite] -> {
	let [CSite] out = acc
	let Iarch i = 0

	loop {
		if i >= Iarch(args.len) then break

		match args[i] {
			Expr.Var(vn) -> {
				out = [...out, CSite({ fnidx: fi, callee: vn, geom: g, direct: true })]
			},
			_ -> {
				out = cs_expr!(args[i], fi, out)
			},
		}

		i = i + 1
	}

	return out
}

const cs_list! = ([Expr] es, Iarch fi, [CSite] acc): [CSite] -> {
	let [CSite] out = acc
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		out = cs_expr!(es[i], fi, out)
		i = i + 1
	}

	return out
}

const cs_stmt! = (Stmt s, Iarch fi, [CSite] acc): [CSite] -> {
	const [CSite] a1 = cs_list!(stmt_exprs(s), fi, acc)

	return match s {
		Stmt.IfThen(_, b) -> cs_stmt!(b, fi, a1),
		Stmt.IfElse(_, t, el) -> cs_stmt!(el, fi, cs_stmt!(t, fi, a1)),
		Stmt.Block(ss) -> cs_body!(ss, fi, a1),
		Stmt.Loop(ll_, ss) -> cs_body!(ss, fi, a1),
		Stmt.ForIn(_, _, ss) -> cs_body!(ss, fi, a1),
		Stmt.Match(_, arms) -> cs_arms!(arms, fi, a1),
		Stmt.Defer(ss) -> cs_body!(ss, fi, a1),
		Stmt.Closure(_, _, _, cb) -> cs_body!(cb, fi, a1),
		_ -> a1,
	}
}

const cs_arms! = ([StmtArm] arms, Iarch fi, [CSite] acc): [CSite] -> {
	let [CSite] out = acc
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		out = cs_body!(arms[i].body, fi, out)
		i = i + 1
	}

	return out
}

const cs_body! = ([Stmt] ss, Iarch fi, [CSite] acc): [CSite] -> {
	let [CSite] out = acc
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = cs_stmt!(ss[i], fi, out)
		i = i + 1
	}

	return out
}

# ── the geometry-binding sweep (`in x` handles must trace to a visible constructor) ──────

const ctor_geom = (Expr e): Str -> match e {
	Expr.Call(n, _, _, _) -> if eq(n, "of__fb")
		then "fb"
		else if eq(n, "of__fx")
			then "fx"
			else if eq(n, "of__el")
				then "el"
				else "",
	_ -> "",
}

const gb_stmt = (Stmt s, Iarch fi, [GBind] acc): [GBind] -> {
	const [GBind] a1 = match s {
		Stmt.Let(n, _, _, e) -> if eq(ctor_geom(e), "")
			then acc
			else [...acc, GBind({ fnidx: fi, name: n, geom: ctor_geom(e) })],
		Stmt.Assign(n, e) -> if eq(ctor_geom(e), "")
			then acc
			else [...acc, GBind({ fnidx: fi, name: n, geom: ctor_geom(e) })],
		_ -> acc,
	}

	return match s {
		Stmt.IfThen(_, b) -> gb_stmt(b, fi, a1),
		Stmt.IfElse(_, t, el) -> gb_stmt(el, fi, gb_stmt(t, fi, a1)),
		Stmt.Block(ss) -> gb_body(ss, fi, a1),
		Stmt.Loop(ll_, ss) -> gb_body(ss, fi, a1),
		Stmt.ForIn(_, _, ss) -> gb_body(ss, fi, a1),
		Stmt.Match(_, arms) -> gb_arms(arms, fi, a1),
		Stmt.Defer(ss) -> gb_body(ss, fi, a1),
		Stmt.Closure(_, _, _, cb) -> gb_body(cb, fi, a1),
		_ -> a1,
	}
}

const gb_arms = ([StmtArm] arms, Iarch fi, [GBind] acc): [GBind] -> {
	let [GBind] out = acc
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		out = gb_body(arms[i].body, fi, out)
		i = i + 1
	}

	return out
}

const gb_body = ([Stmt] ss, Iarch fi, [GBind] acc): [GBind] -> {
	let [GBind] out = acc
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = gb_stmt(ss[i], fi, out)
		i = i + 1
	}

	return out
}

const bind_geom = ([GBind] bs, Iarch fi, Str g): Str -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(bs.len) then break
		if bs[i].fnidx == fi && eq(bs[i].name, g) then return bs[i].geom
		i = i + 1
	}

	return ""
}

const bind_names_of = ([GBind] bs, Iarch fi): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(bs.len) then break
		if bs[i].fnidx == fi then out = [...out, bs[i].name]
		i = i + 1
	}

	return out
}

const bind_geoms_of = ([GBind] bs, Iarch fi): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(bs.len) then break
		if bs[i].fnidx == fi then out = [...out, bs[i].geom]
		i = i + 1
	}

	return out
}

# Closure declarations whose return is a record: post-lift their call sites are direct
# record-returning calls inside the copy, so the claim wrap needs their type too.
const cloret_stmt = (Stmt s, [Str] acc): [Str] -> {
	const [Str] a1 = match s {
		Stmt.Closure(_, _, rn, _) -> if eq(rn, "") || has_str(acc, rn) then acc else [...acc, rn],
		_ -> acc,
	}

	return match s {
		Stmt.IfThen(_, b) -> cloret_stmt(b, a1),
		Stmt.IfElse(_, t, el) -> cloret_stmt(el, cloret_stmt(t, a1)),
		Stmt.Block(ss) -> cloret_body(ss, a1),
		Stmt.Loop(ll_, ss) -> cloret_body(ss, a1),
		Stmt.ForIn(_, _, ss) -> cloret_body(ss, a1),
		Stmt.Match(_, arms) -> cloret_arms(arms, a1),
		Stmt.Defer(ss) -> cloret_body(ss, a1),
		Stmt.Closure(_, _, _, cb) -> cloret_body(cb, a1),
		_ -> a1,
	}
}

const cloret_arms = ([StmtArm] arms, [Str] acc): [Str] -> {
	let [Str] out = acc
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		out = cloret_body(arms[i].body, out)
		i = i + 1
	}

	return out
}

const cloret_body = ([Stmt] ss, [Str] acc): [Str] -> {
	let [Str] out = acc
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = cloret_stmt(ss[i], out)
		i = i + 1
	}

	return out
}

# ── the retarget rewrite (a variant's body points at the geometry twins) ─────────────────
# Only a `Call` callee (and a `DeferTap` target) retargets — a bare name reference feeds an
# INDIRECT site, which stays on the legacy dispatch path by design. Inside a copy (`rc.tag`
# nonempty) ambient calls retarget to the same tag's twins; an `in g` call retargets in ANY
# variant to the tag of `g`'s own constructor binding.

const tag_has = (Rt rc, Str t, Str n): Bool -> {
	if eq(t, "fb") then return has_str(rc.fbn, n)
	if eq(t, "fx") then return has_str(rc.fxn, n)
	if eq(t, "el") then return has_str(rc.eln, n)
	if eq(t, "pg") then return has_str(rc.pgn, n)

	return false
}

const rc_bind_geom = (Rt rc, Str g): Str -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(rc.bnames.len) then break
		if eq(rc.bnames[i], g) then return rc.bgeoms[i]
		i = i + 1
	}

	return ""
}

const rt_name = (Str n, Str g, Rt rc): Str -> {
	if eq(g, "") then {
		if eq(rc.tag, "") then return n
		if tag_has(rc, rc.tag, n) then return "${n}__${rc.tag}"

		return n
	}
	const Str u = rc_bind_geom(rc, g)
	if eq(u, "") then return n
	if tag_has(rc, u, n) then return "${n}__${u}"

	return n
}

const rt_expr = (Expr e, Rt rc): Expr -> match e {
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	Expr.Var(n) -> Expr.Var(n),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(n, rt_fields(fs, rc)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(rt_expr(b, rc), f),
	Expr.UnionMk(t, m, args) -> Expr.UnionMk(t, m, rt_exprs(args, rc)),
	Expr.Match(scrut, arms) -> Expr.Match(rt_expr(scrut, rc), rt_arms(arms, rc)),
	Expr.ArrayLit(hs, sn, elems, et) -> Expr.ArrayLit(hs, rt_expr(sn, rc), rt_exprs(elems, rc), et),
	Expr.Index(a, i) -> Expr.Index(a, rt_expr(i, rc)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, rt_expr(i, rc), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(rt_expr(b, rc), rt_expr(i, rc)),
	Expr.Tuple(elems) -> Expr.Tuple(rt_exprs(elems, rc)),
	Expr.Spread(x) -> Expr.Spread(rt_expr(x, rc)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(rt_stmts(body, rc)),
	Expr.Interp(segs) -> Expr.Interp(rt_segs(segs, rc)),
	Expr.Buffer(sz) -> Expr.Buffer(rt_expr(sz, rc)),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(rt_expr(x, rc)),
	Expr.Not(x) -> Expr.Not(rt_expr(x, rc)),
	Expr.BitNot(x) -> Expr.BitNot(rt_expr(x, rc)),
	Expr.Add(l, r) -> Expr.Add(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.Sub(l, r) -> Expr.Sub(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.Mul(l, r) -> Expr.Mul(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.Div(l, r) -> Expr.Div(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.Mod(l, r) -> Expr.Mod(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.BitOr(l, r) -> Expr.BitOr(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.BitXor(l, r) -> Expr.BitXor(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.Shl(l, r) -> Expr.Shl(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.Shr(l, r) -> Expr.Shr(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.And(l, r) -> Expr.And(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.Or(l, r) -> Expr.Or(rt_expr(l, rc), rt_expr(r, rc)),
	Expr.If(c, t, e2) -> Expr.If(rt_expr(c, rc), rt_expr(t, rc), rt_expr(e2, rc)),
	Expr.Call(n, ta, args, g) -> Expr.Call(rt_name(n, g, rc), ta, rt_call_args(args, g, rc), g),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(rt_name(fn, "", rc), rt_exprs(args, rc)),
}

# Retarget a Call's arguments: a bare fn-NAME argument becomes the copy for the CALL's ambient
# (`apply(sq!, x) in g` → `apply(sq!__el, x)`), so the HOF invokes the geometry-lowered callback;
# a non-fn Var passes through `rt_name` unchanged (not in any copy set). Other args recurse normally.
const rt_call_args = ([Expr] args, Str g, Rt rc): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(args.len) then break
		out = [
			...out,
			match args[i] { Expr.Var(vn) -> Expr.Var(rt_name(vn, g, rc)), _ -> rt_expr(args[i], rc) },
		]
		i = i + 1
	}

	return out
}

const rt_exprs = ([Expr] es, Rt rc): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		out = [...out, rt_expr(es[i], rc)]
		i = i + 1
	}

	return out
}

const rt_fields = ([FieldInit] fs, Rt rc): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: rt_expr(fs[i].value, rc) })]
		i = i + 1
	}

	return out
}

const rt_segs = ([Seg] segs, Rt rc): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		const Seg sg = segs[i]
		out = [
			...out,
			Seg({ is_hole: sg.is_hole, lit: sg.lit, name: sg.name, expr: rt_expr(sg.expr, rc) }),
		]
		i = i + 1
	}

	return out
}

const rt_arms = ([MatchArm] arms, Rt rc): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [
			...out,
			MatchArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: rt_expr(a.body, rc),
			}),
		]
		i = i + 1
	}

	return out
}

const rt_stmt = (Stmt s, Rt rc): Stmt -> match s {
	Stmt.Let(n, m, ann, e) -> Stmt.Let(n, m, ann, rt_expr(e, rc)),
	Stmt.Destructure(pat, m, e) -> Stmt.Destructure(pat, m, rt_expr(e, rc)),
	Stmt.Yield(e) -> Stmt.Yield(rt_expr(e, rc)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, rt_expr(e, rc)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, rt_expr(e, rc)),
	Stmt.DeepFieldAssign(be, f, e) -> Stmt.DeepFieldAssign(rt_expr(be, rc), f, rt_expr(e, rc)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, rt_expr(i, rc), rt_expr(v, rc)),
	Stmt.Return(e) -> Stmt.Return(rt_expr(e, rc)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, rt_stmts(body, rc)),
	Stmt.Loop(ll_, body) -> Stmt.Loop(ll_, rt_stmts(body, rc)),
	Stmt.Break(bl_) -> Stmt.Break(bl_),
	Stmt.Continue(bl_) -> Stmt.Continue(bl_),
	Stmt.IfThen(c, st) -> Stmt.IfThen(rt_expr(c, rc), rt_stmt(st, rc)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(rt_expr(c, rc), rt_stmt(t, rc), rt_stmt(e, rc)),
	Stmt.Do(e) -> Stmt.Do(rt_expr(e, rc)),
	Stmt.Block(stmts) -> Stmt.Block(rt_stmts(stmts, rc)),
	Stmt.Match(scrut, arms) -> Stmt.Match(rt_expr(scrut, rc), rt_stmt_arms(arms, rc)),
	Stmt.Closure(nm, params, ret, body) -> Stmt.Closure(nm, params, ret, rt_stmts(body, rc)),
	Stmt.Defer(body) -> Stmt.Defer(rt_stmts(body, rc)),
}

const rt_stmt_arms = ([StmtArm] arms, Rt rc): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [
			...out,
			StmtArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: rt_stmts(a.body, rc),
			}),
		]
		i = i + 1
	}

	return out
}

const rt_stmts = ([Stmt] ss, Rt rc): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = [...out, rt_stmt(ss[i], rc)]
		i = i + 1
	}

	return out
}

# ── hook-instance minting (the trivial specialization) ───────────────────────────────────
# The generic value hooks mention `'T` ONLY in their signature (the param and return type);
# their bodies work through `size_of`/`mem::raw::*`, which type themselves from the value.
# So an instance is the template with the signature substituted — no body walk needed
# (monomorph's full machinery would be dead weight here).

const hook_param = (Param p, Str t): Param -> {
	if eq(p.type_name, "'T")
		then return Param({
		name: p.name,
		is_ptr: p.is_ptr,
		type_name: t,
		elem: p.elem,
		telems: p.telems,
		size: p.size,
	})

	return p
}

const hook_instance = (Func tmpl, Str iname, Str t): Func -> {
	let [Param] ps = []
	let Iarch i = 0

	loop {
		if i >= Iarch(tmpl.params.len) then break
		ps = [...ps, hook_param(tmpl.params[i], t)]
		i = i + 1
	}

	let Str rn = tmpl.ret_name
	if eq(rn, "'T") then rn = t
	const [Str] no_typ = []

	return Func({
		name: iname,
		is_pub: false,
		ret_name: rn,
		ret_elem: tmpl.ret_elem,
		params: ps,
		body: tmpl.body,
		is_asm: false,
		asm_body: tmpl.asm_body,
		is_value: false,
		ret_telems: tmpl.ret_telems,
		typarams: no_typ,
		tbounds: no_typ,
		ret_size: tmpl.ret_size,
		is_intrinsic: tmpl.is_intrinsic,
		asm_sym: tmpl.asm_sym,
		dfile: tmpl.dfile,
		dline: tmpl.dline,
		dcol: tmpl.dcol,
	})
}

const rec_named = ([RecDecl] recs, Str n): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(recs.len) then break
		if eq(recs[i].name, n) then return true
		i = i + 1
	}

	return false
}

# The claim-type sweep over one minted copy: record RETURNS of the direct calls it makes
# (resolved against the rebuilt table, so retargeted names hit their twins) plus its
# closures' record returns — the on_alloc_ret claim sites emit will wrap.
const claim_tys! = (Func f, [Func] all, [RecDecl] recs, [Str] acc): [Str] -> {
	let [Str] tys = cloret_body(f.body, acc)
	let [CSite] csx = []
	csx = cs_body!(f.body, 0, csx)
	let Iarch k = 0

	loop {
		if k >= Iarch(csx.len) then break
		const Iarch tj = find_fn(all, csx[k].callee)
		if tj >= 0 then {
			const Str rn = all[tj].ret_name
			if !has_str(tys, rn) && rec_named(recs, rn) then tys = [...tys, rn]
		}
		k = k + 1
	}

	return tys
}

# The tag axis: index 0 = the legacy original, 1 = "fb", 2 = "fx" (fixed arena), 3 = "el"
# (elastic arena), 4 = "pg" (the page ambient).
const tag_idx = (Str t): Iarch -> {
	if eq(t, "fb") then return 1
	if eq(t, "fx") then return 2
	if eq(t, "el") then return 3
	if eq(t, "pg") then return 4

	return 0
}

# Does a function body construct a record literal directly? A record in a page-ambient body is
# a page-hook placement (this stage places records only), so main containing one — even as a
# call argument, built in the caller's frame before the `in` call runs — makes the page
# geometry ACTIVE (worth tagging main `pg` and keeping the page hooks). Arrays/strings/etc.
# stay on the shared floor even in a pg body, so they do not count here.
const rec_expr = (Expr e): Bool -> {
	const Bool here = match e { Expr.Record(_, _) -> true, _ -> false }

	if here then return true

	return match e { Expr.Loop(ss) -> rec_body(ss), _ -> rec_list(kids(e)) }
}

const rec_list = ([Expr] es): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if rec_expr(es[i]) then return true
		i = i + 1
	}

	return false
}

const rec_stmt = (Stmt s): Bool -> {
	if rec_list(stmt_exprs(s)) then return true

	return match s {
		Stmt.IfThen(_, b) -> rec_stmt(b),
		Stmt.IfElse(_, t, el) -> rec_stmt(t) || rec_stmt(el),
		Stmt.Block(ss) -> rec_body(ss),
		Stmt.Loop(ll_, ss) -> rec_body(ss),
		Stmt.ForIn(_, _, ss) -> rec_body(ss),
		Stmt.Match(_, arms) -> rec_arms(arms),
		Stmt.Defer(ss) -> rec_body(ss),
		Stmt.Closure(_, _, _, cb) -> rec_body(cb),
		_ -> false,
	}
}

const rec_arms = ([StmtArm] arms): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if rec_body(arms[i].body) then return true
		i = i + 1
	}

	return false
}

const rec_body = ([Stmt] ss): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		if rec_stmt(ss[i]) then return true
		i = i + 1
	}

	return false
}

# ── the pass ─────────────────────────────────────────────────────────────────────────────

# Run the Materialize substep of the memory arc over `prog`: duplicate each function per geometry it
# is used at, retarget its `in <geometry>` seeds, and mint per-type value-hook instances from the
# pre-mono templates still held in `raw`. Returns the rewritten program together with the emit-side
# name and geometry tables (`Mat`).
pub const materialize_program! = (Program prog, Program raw): Mat -> {
	const [Str] no_strs = []
	const [Func] no_funcs = []
	# The PAGE geometry is a first-class ambient: `main` runs under the root page, and any allocation
	# in its root subtree (its own body, or a bare-called helper — an `in <geometry>` graft leaves the
	# subtree) draws from the page's OWN reserve like every other geometry, not a runtime-dispatch
	# floor. `main` is always seeded `pg`, so the reach walk flows root allocators to `__pg` copies;
	# `page_active` below is set from that (or `main`'s own direct allocation). A program that
	# allocates NOTHING on the page and grafts no arena strips the dormant page module back out at
	# the LATE bail (byte-identical to the pre-import table) — that decision is deferred to there now,
	# so the walk always runs (cheap for a non-allocating program).
	const Iarch mi = find_fn(prog.funcs, "main")
	if mi < 0 then return Mat({ prog: strip_pg(prog), names: no_strs, geoms: no_strs, dropped: no_funcs })
	const Bool main_allocs = alloc_body(prog.funcs[mi].body, prog.unions)
	# UNIFORM ENTRY ABI (std::rt::floor): the hosted `_start` ALWAYS builds argv+env before `main`, so
	# `reserve_ret__pg` — the page reserve those pre-main bridges build the `[Str]`s through — must
	# ALWAYS survive, regardless of main's params. (Bare builds no args; its kept reserve is a dead
	# leaf, harmless.) Formerly keyed on `main([Str] …)`.
	const Bool main_argv = true

	const Iarch nf = Iarch(prog.funcs.len)

	# sweep every body once: reference sites, geometry bindings, the direct-allocation bit
	# (the site walk grows ONE shared accumulator in place — see cs_expr!)
	let [CSite] sites = []
	let [GBind] gbinds = []
	let [Bool] ma = []
	let Iarch i = 0

	loop {
		if i >= nf then break
		sites = cs_body!(prog.funcs[i].body, i, sites)
		gbinds = gb_body(prog.funcs[i].body, i, gbinds)
		let Bool da = false
		if !prog.funcs[i].is_asm
			then da = name_has_bang(prog.funcs[i].name) || alloc_body(prog.funcs[i].body, prog.unions)
		ma = [...ma, da]
		i = i + 1
	}

	# resolve each site's callee to a function index once (-1 = intrinsic/local/indirect)
	let [Iarch] cidx = []
	let Iarch si = 0

	loop {
		if si >= Iarch(sites.len) then break
		cidx = [...cidx, find_fn(prog.funcs, sites[si].callee)]
		si = si + 1
	}

	# may-allocate closes over the direct call graph: a caller of an allocating callee
	# allocates. (An indirect callee stays unresolved — its sites keep the legacy floor.)
	# Loop locals are HOISTED here and in the reach walk below: a `let` inside a loop body
	# is a function-lifetime QBE stack alloc repeated per iteration, and these loops run
	# sites × rounds — at compiler scale that accumulation alone blows the frame.
	let Iarch mk = 0
	let Iarch mcj = 0
	let Iarch mko = 0

	loop {
		let Bool changed = false
		mk = 0

		loop {
			if mk >= Iarch(sites.len) then break
			mcj = cidx[mk]
			if mcj >= 0 then {
				mko = sites[mk].fnidx
				if !ma[mko] && ma[mcj] then {
					ma[mko] = true
					changed = true
				}
			}
			mk = mk + 1
		}

		if !changed then break
	}

	# the (fn × tag) reachability walk, flattened as `reach[fn*5 + tag]` (tag 0 legacy, 1 fb,
	# 2 fx, 3 el, 4 pg). Roots: `main` seeded under the PAGE tag — its own ambient IS the root
	# page, so its records place through page hooks and its bare allocating calls flow to `__pg`
	# twins (its `in a` calls still flow to the arena twins by their binding). Plus the fb/fx/el
	# module functions emit references by NAME (constructors, fold-lite reserves, scope hooks),
	# rooted legacy so their internal calls flow. A site inside a reachable variant flows its
	# callee to the tag the retarget rewrite will use: ambient direct calls inherit the
	# variant's tag, `in g` calls take the tag of `g`'s constructor binding, indirect
	# references and calls to ineligible callees (never-allocating, asm, value-consts) stay legacy.
	let [Bool] reach = []
	let Iarch z = 0

	loop {
		if z >= nf * 5 then break
		reach = [...reach, false]
		z = z + 1
	}

	reach[mi * 5 + 4] = true
	# each geometry's `on_scope_exit` is a root — `emit_reset!` places it as the residue bracket
	# of every `!` frame under that geometry (the leak-free scope fold that retired the floor
	# `cf_reset`; the mark rides in emit temps, so nothing is stored per bracket). The page's
	# `on_scope_exit__pg` is kept by name only when the page is active, below — not an emit root
	# (a dormant page module is stripped byte-identical). The page's `reserve_ret` is likewise
	# appended below when active.
	# (`carve__*` are the placed constructor bodies behind the geometry `of` INTRINSICS — the
	# post-flip module shape; absent names are skipped, so both shapes root cleanly.) Each carve is a
	# SINGLE shared root now: its `raw::alloc(parent, sz)` draws follow the parent's PUBLISHED reserve
	# entry at runtime (parent+32), so no per-parent copy is needed — the parent axis is a pointer.
	const [Str] emit_roots = [
		"of__fb",
		"reserve_ret__fb",
		"reserve_alloc__fb",
		"on_scope_exit__fb",
		"of__fx",
		"reserve_ret__fx",
		"reserve_alloc__fx",
		"on_scope_exit__fx",
		"carve__fx",
		"of__el",
		"reserve_ret__el",
		"reserve_alloc__el",
		"on_scope_exit__el",
		"carve__el",
		"carve__fb",
	]
	let Iarch er = 0

	loop {
		if er >= Iarch(emit_roots.len) then break
		const Iarch ei = find_fn(prog.funcs, emit_roots[er])
		if ei >= 0 then reach[ei * 5] = true
		er = er + 1
	}

	let Iarch q = 0
	let Iarch rcj = 0
	let Iarch rqo = 0
	let Bool rel = false
	let Iarch rbt = 0
	let Iarch rtg = 0
	let Iarch ru = 0

	loop {
		let Bool fchanged = false
		q = 0

		loop {
			if q >= Iarch(sites.len) then break
			rcj = cidx[q]
			if rcj >= 0 then {
				rqo = sites[q].fnidx
				rel = ma[rcj] &&
					!prog.funcs[rcj].is_asm &&
					!prog.funcs[rcj].is_value &&
					!eq(prog.funcs[rcj].name, "main")
				rbt = 0
				if sites[q].direct && !eq(sites[q].geom, "")
					then rbt = tag_idx(bind_geom(gbinds, rqo, sites[q].geom))
				rtg = 0

				loop {
					if rtg >= 5 then break
					if reach[rqo * 5 + rtg] then {
						ru = 0
						if sites[q].direct && rel then {
							ru = rtg
							if !eq(sites[q].geom, "") then ru = rbt
						}
						if !reach[rcj * 5 + ru] then {
							reach[rcj * 5 + ru] = true
							fchanged = true
						}
					}
					rtg = rtg + 1
				}
			}
			q = q + 1
		}

		if !fchanged then break
	}

	# the copy-name sets per tag, in function-table order (deterministic emit). `main` is
	# excluded from the pg set — it is emitted in place (the entry symbol must stay `main`),
	# never a `__pg` copy.
	let [Str] fbn = []
	let [Str] fxn = []
	let [Str] eln = []
	let [Str] pgn = []
	let Iarch c = 0

	loop {
		if c >= nf then break
		if reach[c * 5 + 1] then fbn = [...fbn, prog.funcs[c].name]
		if reach[c * 5 + 2] then fxn = [...fxn, prog.funcs[c].name]
		if reach[c * 5 + 3] then eln = [...eln, prog.funcs[c].name]
		if reach[c * 5 + 4] && c != mi then pgn = [...pgn, prog.funcs[c].name]
		c = c + 1
	}

	# the page geometry is ACTIVE when main truly allocates on its own ambient — a bare-reachable
	# allocator became a `__pg` copy, or main itself builds a record. When it is INACTIVE (the
	# compiler, and every arena-grafting program whose main places nothing on the page), main
	# stays legacy and the dormant page module is stripped, keeping such programs byte-identical.
	const Bool page_active = Iarch(pgn.len) > 0 || main_allocs
	# nothing materialized and the page is dormant: strip it back out and PRUNE the unreached
	# originals — the same reach filter the rebuild below applies (intrinsics, verbatim-symbol
	# floor fns, and `main` survive unconditionally). A reachable-only program passes through
	# byte-identical as before; a program carrying unused declarations stops EMITTING them (an
	# unused aggregate-constructing fn has no geometry ambient here and would trip emit's
	# retired-cf_alloc backstop). The pruned decls come back as `dropped` — typecheck still
	# validates them (`check_unreachable!`), so their errors surface.
	# A `main([Str] args)` program keeps `reserve_ret__pg` alive for the pre-main argv bridge.
	if Iarch(fbn.len) + Iarch(fxn.len) + Iarch(eln.len) + Iarch(pgn.len) == 0 && !page_active then {
		let [Func] bkeep = []
		let [Func] bdrop = []
		let Iarch bi = 0

		loop {
			if bi >= nf then break
			# a page-module fn (`*__pg`) is NOT pruned here — the strip below owns its fate
			# (`reserve_ret__pg` survives for the argv bridge), exactly as before this filter
			if bi == mi ||
				reach[bi * 5] ||
				prog.funcs[bi].is_intrinsic ||
				!eq(prog.funcs[bi].asm_sym, "") ||
				name_ends_pg(prog.funcs[bi].name) then {
				bkeep = [...bkeep, prog.funcs[bi]]
			} else {
				bdrop = [...bdrop, prog.funcs[bi]]
			}
			bi = bi + 1
		}

		const Program bprog = Program({
			imports: prog.imports,
			recs: prog.recs,
			unions: prog.unions,
			funcs: bkeep,
			groups: prog.groups,
		})

		if main_argv
			then return Mat({ prog: strip_pg_keep_reserve(bprog), names: no_strs, geoms: no_strs, dropped: bdrop })

		return Mat({ prog: strip_pg(bprog), names: no_strs, geoms: no_strs, dropped: bdrop })
	}

	# parent-axis: an arena's parent is a comptime fact of its CONSTRUCTION AMBIENT — the tag the
	# function holding `of__fx`/`of__el` runs under. Each carve draws from its IMMEDIATE parent through
	# the parent's PUBLISHED reserve entry (parent+32, followed as a pointer at runtime), so no
	# per-parent carve copy is minted anymore. The one thing still needed here: whether any arena is
	# carved from the PAGE ambient — then `reserve_ret__pg` (the page's published entry) must be kept.
	# (Loop vars hoisted — runs over every construction site × tag.)
	let Bool needs_pg_reserve = false
	let Iarch aps = 0
	let Iarch apo = 0
	let Iarch apt = 0

	loop {
		if aps >= Iarch(sites.len) then break
		if eq(sites[aps].callee, "of__fx") || eq(sites[aps].callee, "of__el") then {
			apo = sites[aps].fnidx
			apt = 0

			loop {
				if apt >= 5 then break
				if reach[apo * 5 + apt] && eq(tag_ambient_name(apt), "pg") then needs_pg_reserve = true
				apt = apt + 1
			}
		}
		aps = aps + 1
	}

	# rebuild the table as the reachable variants: legacy originals in table order (bodies with
	# seed `in b` sites are rewritten so they point at the twins; everything else is SHARED,
	# not copied), with `main` emitted in place at its own slot (pg when active, else legacy),
	# then the fb copies, the fx copies, the el copies, and the pg copies.
	let [Func] out = []
	let [Str] cnames = []
	let [Str] cgeoms = []
	# the originals the reach filter drops: never emitted, but still WRITTEN declarations —
	# typecheck validates them after the pass (their errors must not vanish with the pruning)
	let [Func] dropped = []
	let Iarch fi = 0

	loop {
		if fi >= nf then break
		if fi == mi then {
			const Func fm = prog.funcs[mi]
			let Str mtag = ""
			if page_active then mtag = "pg"
			const Rt rcm = Rt({
				fbn: fbn,
				fxn: fxn,
				eln: eln,
				pgn: pgn,
				bnames: bind_names_of(gbinds, mi),
				bgeoms: bind_geoms_of(gbinds, mi),
				tag: mtag,
			})
			out = [
				...out,
				Func({
					name: "main",
					is_pub: fm.is_pub,
					ret_name: fm.ret_name,
					ret_elem: fm.ret_elem,
					params: fm.params,
					body: rt_stmts(fm.body, rcm),
					is_asm: false,
					asm_body: fm.asm_body,
					is_value: fm.is_value,
					ret_telems: fm.ret_telems,
					typarams: fm.typarams,
					tbounds: fm.tbounds,
					ret_size: fm.ret_size,
					is_intrinsic: fm.is_intrinsic,
					asm_sym: fm.asm_sym,
					dfile: fm.dfile,
					dline: fm.dline,
					dcol: fm.dcol,
				}),
			]
			if page_active then {
				cnames = [...cnames, "main"]
				cgeoms = [...cgeoms, "pg"]
			}
		}
		# a declared INTRINSIC always survives the rebuild: it emits no code, but typecheck/emit
		# gate their token lowerings on resolving it (`is_intrinsic`), so it must stay in the table.
		# A verbatim-symbol floor fn (`asm_sym` set) likewise survives unconditionally: it is reached
		# only by fixed asm symbol (the entry, `raw::grow`/`raw::trap`), invisible to this cf-call walk.
		if fi != mi &&
			!reach[fi * 5] && !prog.funcs[fi].is_intrinsic && eq(prog.funcs[fi].asm_sym, "")
				then dropped = [...dropped, prog.funcs[fi]]
		if fi != mi &&
			(reach[fi * 5] || prog.funcs[fi].is_intrinsic || !eq(prog.funcs[fi].asm_sym, "")) then {
			const Func f = prog.funcs[fi]
			const [Str] bn = bind_names_of(gbinds, fi)
			if f.is_asm || Iarch(bn.len) == 0 then out = [...out, f]
			if !f.is_asm && Iarch(bn.len) > 0 then {
				const Rt rc0 = Rt({
					fbn: fbn,
					fxn: fxn,
					eln: eln,
					pgn: pgn,
					bnames: bn,
					bgeoms: bind_geoms_of(gbinds, fi),
					tag: "",
				})
				out = [
					...out,
					Func({
						name: f.name,
						is_pub: f.is_pub,
						ret_name: f.ret_name,
						ret_elem: f.ret_elem,
						params: f.params,
						body: rt_stmts(f.body, rc0),
						is_asm: false,
						asm_body: f.asm_body,
						is_value: f.is_value,
						ret_telems: f.ret_telems,
						typarams: f.typarams,
						tbounds: f.tbounds,
						ret_size: f.ret_size,
						is_intrinsic: f.is_intrinsic,
						asm_sym: f.asm_sym,
						dfile: f.dfile,
						dline: f.dline,
						dcol: f.dcol,
					}),
				]
			}
		}
		fi = fi + 1
	}

	let Iarch cf = 0

	loop {
		if cf >= nf then break
		if reach[cf * 5 + 1] then {
			const Func f = prog.funcs[cf]
			const Rt rcf = Rt({
				fbn: fbn,
				fxn: fxn,
				eln: eln,
				pgn: pgn,
				bnames: bind_names_of(gbinds, cf),
				bgeoms: bind_geoms_of(gbinds, cf),
				tag: "fb",
			})
			const Str cnf = "${f.name}__fb"
			out = [
				...out,
				Func({
					name: cnf,
					is_pub: false,
					ret_name: f.ret_name,
					ret_elem: f.ret_elem,
					params: f.params,
					body: rt_stmts(f.body, rcf),
					is_asm: false,
					asm_body: f.asm_body,
					is_value: false,
					ret_telems: f.ret_telems,
					typarams: f.typarams,
					tbounds: f.tbounds,
					ret_size: f.ret_size,
					is_intrinsic: f.is_intrinsic,
					asm_sym: f.asm_sym,
					dfile: f.dfile,
					dline: f.dline,
					dcol: f.dcol,
				}),
			]
			cnames = [...cnames, cnf]
			cgeoms = [...cgeoms, "fb"]
		}
		cf = cf + 1
	}

	let Iarch cx = 0

	loop {
		if cx >= nf then break
		if reach[cx * 5 + 2] then {
			const Func f = prog.funcs[cx]
			const Rt rcx = Rt({
				fbn: fbn,
				fxn: fxn,
				eln: eln,
				pgn: pgn,
				bnames: bind_names_of(gbinds, cx),
				bgeoms: bind_geoms_of(gbinds, cx),
				tag: "fx",
			})
			const Str cnx = "${f.name}__fx"
			out = [
				...out,
				Func({
					name: cnx,
					is_pub: false,
					ret_name: f.ret_name,
					ret_elem: f.ret_elem,
					params: f.params,
					body: rt_stmts(f.body, rcx),
					is_asm: false,
					asm_body: f.asm_body,
					is_value: false,
					ret_telems: f.ret_telems,
					typarams: f.typarams,
					tbounds: f.tbounds,
					ret_size: f.ret_size,
					is_intrinsic: f.is_intrinsic,
					asm_sym: f.asm_sym,
					dfile: f.dfile,
					dline: f.dline,
					dcol: f.dcol,
				}),
			]
			cnames = [...cnames, cnx]
			cgeoms = [...cgeoms, "fx"]
		}
		cx = cx + 1
	}

	let Iarch ce = 0

	loop {
		if ce >= nf then break
		if reach[ce * 5 + 3] then {
			const Func f = prog.funcs[ce]
			const Rt rce = Rt({
				fbn: fbn,
				fxn: fxn,
				eln: eln,
				pgn: pgn,
				bnames: bind_names_of(gbinds, ce),
				bgeoms: bind_geoms_of(gbinds, ce),
				tag: "el",
			})
			const Str cne = "${f.name}__el"
			out = [
				...out,
				Func({
					name: cne,
					is_pub: false,
					ret_name: f.ret_name,
					ret_elem: f.ret_elem,
					params: f.params,
					body: rt_stmts(f.body, rce),
					is_asm: false,
					asm_body: f.asm_body,
					is_value: false,
					ret_telems: f.ret_telems,
					typarams: f.typarams,
					tbounds: f.tbounds,
					ret_size: f.ret_size,
					is_intrinsic: f.is_intrinsic,
					asm_sym: f.asm_sym,
					dfile: f.dfile,
					dline: f.dline,
					dcol: f.dcol,
				}),
			]
			cnames = [...cnames, cne]
			cgeoms = [...cgeoms, "el"]
		}
		ce = ce + 1
	}

	let Iarch cp = 0

	loop {
		if cp >= nf then break
		if cp != mi && reach[cp * 5 + 4] then {
			const Func f = prog.funcs[cp]
			const Rt rcp = Rt({
				fbn: fbn,
				fxn: fxn,
				eln: eln,
				pgn: pgn,
				bnames: bind_names_of(gbinds, cp),
				bgeoms: bind_geoms_of(gbinds, cp),
				tag: "pg",
			})
			const Str cnp = "${f.name}__pg"
			out = [
				...out,
				Func({
					name: cnp,
					is_pub: false,
					ret_name: f.ret_name,
					ret_elem: f.ret_elem,
					params: f.params,
					body: rt_stmts(f.body, rcp),
					is_asm: false,
					asm_body: f.asm_body,
					is_value: false,
					ret_telems: f.ret_telems,
					typarams: f.typarams,
					tbounds: f.tbounds,
					ret_size: f.ret_size,
					is_intrinsic: f.is_intrinsic,
					asm_sym: f.asm_sym,
					dfile: f.dfile,
					dline: f.dline,
					dcol: f.dcol,
				}),
			]
			cnames = [...cnames, cnp]
			cgeoms = [...cgeoms, "pg"]
		}
		cp = cp + 1
	}

	# keep the page's reserves. `reserve_ret__pg` (survivor) covers a colorless pg frame's records
	# and the argv bridge; `reserve_alloc__pg` (residue) covers a `!` pg frame — a `!` function
	# reached under the ROOT page (e.g. a `!` fn-value handed to a bare-from-main HOF, whose residue
	# the retarget lowers to the page's own residue side, reclaimed through `on_scope_exit__pg` like an
	# arena). Both are leaves (only `mem::raw::*`). Also kept when `main([Str] args)` takes argv
	# (`main_argv`): the pre-main bridge (`cf_build_args`) builds its `[Str]` through `reserve_ret__pg`.
	if page_active || needs_pg_reserve || main_argv then {
		const Iarch rrp = find_fn(prog.funcs, "reserve_ret__pg")
		if rrp < 0
			then die("cf: materialize: the page geometry module is missing `reserve_ret__pg` (stale std source?)\n")
		out = [...out, prog.funcs[rrp]]
		const Iarch rap = find_fn(prog.funcs, "reserve_alloc__pg")
		if rap < 0
			then die("cf: materialize: the page geometry module is missing `reserve_alloc__pg` (stale std source?)\n")
		out = [...out, prog.funcs[rap]]
	}
	# a `!` pg frame (page_active) rewinds its residue bracket through `on_scope_exit__pg`, so keep
	# it too — a leaf (only `mem::raw::*`). Not needed for the argv/needs-reserve cases (no `!` pg frame).
	if page_active then {
		const Iarch xpg = find_fn(prog.funcs, "on_scope_exit__pg")
		if xpg < 0
			then die("cf: materialize: the page geometry module is missing `on_scope_exit__pg` (stale std source?)\n")
		out = [...out, prog.funcs[xpg]]
	}
	# the per-geometry claim-type sets, swept from the minted copies (and pg-main) by name
	let [Str] tys_fb = []
	let [Str] tys_fx = []
	let [Str] tys_el = []
	let [Str] tys_pg = []
	let Iarch ci = 0

	loop {
		if ci >= Iarch(cnames.len) then break
		const Iarch oj = find_fn(out, cnames[ci])
		if oj >= 0 then {
			if eq(cgeoms[ci], "fb") then tys_fb = claim_tys!(out[oj], out, prog.recs, tys_fb)
			if eq(cgeoms[ci], "fx") then tys_fx = claim_tys!(out[oj], out, prog.recs, tys_fx)
			if eq(cgeoms[ci], "el") then tys_el = claim_tys!(out[oj], out, prog.recs, tys_el)
			if eq(cgeoms[ci], "pg") then tys_pg = claim_tys!(out[oj], out, prog.recs, tys_pg)
		}
		ci = ci + 1
	}

	# only record types place through value hooks in this stage; everything else stays on
	# the legacy floor (matching emit's wrap rule), so filter the sets to declared records
	let [Str] rty_fb = []
	let Iarch tf = 0

	loop {
		if tf >= Iarch(tys_fb.len) then break
		if rec_named(prog.recs, tys_fb[tf]) then rty_fb = [...rty_fb, tys_fb[tf]]
		tf = tf + 1
	}

	let [Str] rty_fx = []
	let Iarch tx = 0

	loop {
		if tx >= Iarch(tys_fx.len) then break
		if rec_named(prog.recs, tys_fx[tx]) then rty_fx = [...rty_fx, tys_fx[tx]]
		tx = tx + 1
	}

	let [Str] rty_el = []
	let Iarch te = 0

	loop {
		if te >= Iarch(tys_el.len) then break
		if rec_named(prog.recs, tys_el[te]) then rty_el = [...rty_el, tys_el[te]]
		te = te + 1
	}

	let [Str] rty_pg = []
	let Iarch tp = 0

	loop {
		if tp >= Iarch(tys_pg.len) then break
		if rec_named(prog.recs, tys_pg[tp]) then rty_pg = [...rty_pg, tys_pg[tp]]
		tp = tp + 1
	}

	# mint the per-type claim instances from the PRE-mono templates (the other value hooks
	# stay uninstantiated: fold-lite renders their placements as fused reserve + build)
	const Iarch arf = find_fn(raw.funcs, "on_alloc_ret__fb")
	const Iarch arx = find_fn(raw.funcs, "on_alloc_ret__fx")
	const Iarch are = find_fn(raw.funcs, "on_alloc_ret__el")
	const Iarch arp = find_fn(raw.funcs, "on_alloc_ret__pg")
	if Iarch(rty_fb.len) > 0 && arf < 0
		then die("cf: materialize: the fixed_buffer geometry module is missing its value hooks (stale std source?)\n")
	if Iarch(rty_fx.len) > 0 && arx < 0
		then die("cf: materialize: the fixed_arena geometry module is missing its value hooks (stale std source?)\n")
	if Iarch(rty_el.len) > 0 && are < 0
		then die("cf: materialize: the elastic_arena geometry module is missing its value hooks (stale std source?)\n")
	if Iarch(rty_pg.len) > 0 && arp < 0
		then die("cf: materialize: the page geometry module is missing its value hooks (stale std source?)\n")
	let Iarch hf = 0

	loop {
		if hf >= Iarch(rty_fb.len) then break
		out = [...out, hook_instance(raw.funcs[arf], "on_alloc_ret__fb$${rty_fb[hf]}", rty_fb[hf])]
		hf = hf + 1
	}

	let Iarch hx = 0

	loop {
		if hx >= Iarch(rty_fx.len) then break
		out = [...out, hook_instance(raw.funcs[arx], "on_alloc_ret__fx$${rty_fx[hx]}", rty_fx[hx])]
		hx = hx + 1
	}

	let Iarch he = 0

	loop {
		if he >= Iarch(rty_el.len) then break
		out = [...out, hook_instance(raw.funcs[are], "on_alloc_ret__el$${rty_el[he]}", rty_el[he])]
		he = he + 1
	}

	let Iarch hp = 0

	loop {
		if hp >= Iarch(rty_pg.len) then break
		out = [...out, hook_instance(raw.funcs[arp], "on_alloc_ret__pg$${rty_pg[hp]}", rty_pg[hp])]
		hp = hp + 1
	}

	const Program p2 = Program({
		imports: prog.imports,
		recs: prog.recs,
		unions: prog.unions,
		funcs: out,
		groups: prog.groups,
	})

	return Mat({ prog: p2, names: cnames, geoms: cgeoms, dropped: dropped })
}
