# ast — the expression abstract syntax tree.
#
# An AST is a union of node types (type_system §8 — the spec's canonical use of
# unions), walked by `match`. Recursive `Expr` payloads auto-box to arena
# pointers, so the parser builds a tree by returning and combining `Expr` values
# directly and the emitter walks it with `match`.
#
# It grows a node per language construct as the front end fills in. `Var` names a
# local binding (interned from the source); `Lit` is an integer literal.
# `BoolLit` (not `Bool`) — a member named `Bool` would read as the type `Bool`
# (like `IntLit` vs the type `Int`). It carries the literal `true`/`false`.
# `Record` is a data literal `{ f: v, ... }`. `Field(base, f)` is `base.f` — a record
# field read, or a tag-only-member union construction (`Color.Red`); the typecheck
# phase disambiguates. `UnionMk` is a payload-member construction `Node.IntLit(42)`.
# `Match` dispatches on a union's tag. `IndexField(arr, i, f)` is `arr[i].f` — a field
# read off a record element of a dynamic array (the element is an arena pointer, so it
# is loaded and then the field is read; a bare `arr[i]` cannot host a `.f` since its
# base is not a name). `StrLit` is a string literal (its decoded bytes); `FieldExpr(e,
# f)` is `e.f` on a general expression base — used for `.len` on a string literal or a
# parenthesised string, where the base is not a bare name (a name base uses `Field`).
# `IndexExpr(base, i)` is `base[i]` on a general expression base (`p.toks[p.pos]`,
# `prog.recs[r]`) — the postfix `[i]` chained off a field read or another index, where
# the base is not a bare name (a name base uses the wired `Index`/`IndexField` forms).
pub union Expr = {
	Lit(Iarch),
	BoolLit(Bool),
	Var(Str),
	StrLit([Uint8]),
	FloatLit(Str),
	Record(Str, [FieldInit]),
	Field(Str, Str),
	FieldExpr(Expr, Str),
	UnionMk(Str, Str, [Expr]),
	Match(Expr, [MatchArm]),
	ArrayLit(Bool, Expr, [Expr], Str),
	Index(Str, Expr),
	IndexField(Str, Expr, Str),
	IndexExpr(Expr, Expr),
	Interp([Seg]),
	Tuple([Expr]),
	Spread(Expr),
	Unit,
	Loop([Stmt]),
	Buffer(Expr),
	Addr(Str),
	Neg(Expr),
	Not(Expr),
	BitNot(Expr),
	Add(Expr, Expr),
	Sub(Expr, Expr),
	Mul(Expr, Expr),
	Div(Expr, Expr),
	Mod(Expr, Expr),
	BitAnd(Expr, Expr),
	BitOr(Expr, Expr),
	BitXor(Expr, Expr),
	Shl(Expr, Expr),
	Shr(Expr, Expr),
	CmpEq(Expr, Expr),
	CmpNe(Expr, Expr),
	CmpLt(Expr, Expr),
	CmpGt(Expr, Expr),
	CmpLe(Expr, Expr),
	CmpGe(Expr, Expr),
	And(Expr, Expr),
	Or(Expr, Expr),
	# `Call(callee, tyargs, args, geom)` — `geom` is the `in <geometry>` binding name governing this
	# call (memory_model §4), or "" for the ambient node. It rides the call from the parser to emit,
	# which threads the named node instead of `%node_0`; passes that rebuild a call carry it via
	# `with_geom`. A dropped geom is not a miscompile — it just falls back to the ambient node.
	If(Expr, Expr, Expr),
	Call(Str, [Str], [Expr], Str),
	# `DeferTap(fn, args)` is `defer fn(args)` in VALUE position (or a `|> defer fn` pipe target):
	# it schedules `fn(args)` at scope exit AND evaluates to the TAPPED value — its last argument.
	# The hoist_defertap.cf pass (after typecheck, before the defer lowering) lifts it to
	# `const $tap = <last arg>; defer fn(..., $tap)` and replaces the expression with `$tap`, so no
	# `DeferTap` reaches emit.
	DeferTap(Str, [Expr]),
}

# One segment of an interpolated string `"...${expr}..."`: a literal byte-run (`is_hole`
# false, bytes in `lit`) or a hole (`is_hole` true). A string-interpolation hole carries a
# full expression in `expr` (`${a + 8}`, `${ctx.next}` — a bare `${x}` is just `Expr.Var`);
# an assembly-body hole (`Seg` is reused for `-> asm "..."` bodies) instead carries a bare
# parameter name in `name` (substituted positionally, not evaluated) and leaves `expr` an
# unused `Expr.Lit(0)`. Built in source order; the whole string is `Expr.Interp([Seg])`,
# assembled at RUNTIME (literals appended byte-wise, a hole via itoa / its Str bytes).
pub data Seg = { Bool is_hole, [Uint8] lit, Str name, Expr expr }

# A `[T]` dynamic-array literal. `[a, b]` lists elements; `[]` is empty; `[...src, e]`
# spreads the source array `src` (a self-growth `xs = [...xs, e]` in this brick) then
# appends `elems`. `elem_type` is the element type NAME from a `let [Elem] x = ...`
# annotation (`""` when unannotated — the element type is then inferred from the
# elements, or defaults to `Iarch` for an empty `[]`). It names the record type when
# the elements are records, so an empty `[P]` still knows its element layout.

# One arm of a `match`: a wildcard `_` (`is_wild`), or an or-pattern of one or more
# members `Type.a | Type.b` (their shared union type name + the member names). A
# single-member arm may also bind its member's payload positionally — `binds` holds
# a name per payload field (`"_"` ignores one); it is empty for a tag-only member or
# an or-pattern. The arm yields `body`. The match holds the scrutinee and its arms.
pub data MatchArm = { Bool is_wild, Str type_name, [Str] members, [Str] binds, Expr body }

# One arm of a STATEMENT-position `match` — same pattern shape as `MatchArm` (a wildcard
# `_`, or an or-pattern of members with an optional single-member payload binding), but its
# body is a statement list (a `{ ... }` block evaluated for EFFECT), not a value expression.
# A statement `match` dispatches for effect (its arms mutate/return/call); no arm yields a
# value and the arms need not share a type. Used for the `match s { Stmt.X -> { ... } }`
# dispatch cf's own emit/typecheck are built on.
pub data StmtArm = { Bool is_wild, Str type_name, [Str] members, [Str] binds, [Stmt] body }

# A function call `callee(args)`. A `[T]` cannot be a union payload directly, so the
# argument list rides in this record and the `Expr.Call` payload is the record.

# One `field: value` in a data literal, and the whole literal (its declared type
# name + the field initializers, order-independent — mapped to declaration order).
pub data FieldInit = { Str field, Expr value }

# The types cf's typecheck phase tracks: an integer (`Int`/`Iarch`, a word), a
# `Bool`, an opaque pointer (`*[Str]` argv/envp — carries no usable value), or a
# record type named by its declaration (`TRec("Point")`). Every expression has one;
# the checker enforces their discipline (no truthiness, integer arithmetic, matching
# `if` branches, an `Int` exit code, a field read only on a record, ...).
# A tuple type's per-position element, carried structurally so tuples nest to any depth.
# `name` is a leaf type name (`Iarch`/`Bool`/`Str`/a record, or `""` for a word in emit's
# canonical form) with an empty `sub`; a NESTED tuple position has `name = "$tuple"` and
# `sub` = its own positions. Helpers `tel_leaf`/`tel_nest` build them; `.name`/`.sub` read.
pub data TupElem = { Str name, [TupElem] sub }

# `TTuple(elems)` is a positional tuple `(a, b, ...)` — an arena aggregate of N 8-byte
# slots; `elems` names each position's type (`Iarch`/`Bool`/`Str`/a record). It is a
# distinct, comptime-indexed, const-only value (not an `Iarch`, not a record).
# `TFixed(bits, signed)` is one of the eight fixed-width integer leaves (`Int8`...`Uint64`) —
# a DISTINCT type from the register-width word `TInt` (`Iarch`/`Int`/`Uarch`): it carries a
# width and a signedness that drive range checks, wrap, and signed-vs-unsigned codegen.
# `TFn(sig)` is a function VALUE type — a first-class callable passed to / returned from a
# higher-order function. `sig` is the positional signature as `TupElem` leaves: positions
# `0..n-2` are the argument types and the LAST position is the return type (arity = `len-1`).
# The names are nominal (a function's signature distinguishes `Iarch` from `Uarch`), so two
# `TFn`s are equal iff their sigs match name-for-name (`tuple_elems_eq`). cf's HOF brick:
# a `(A, ...) -> R` PARAMETER, a top-level function passed by name, and an indirect call.
pub union Ty = {
	TInt,
	TBool,
	TPtr,
	TRec(Str),
	TUnion(Str),
	TDyn(Str),
	TStr,
	TUnit,
	TFixed(Iarch, Bool),
	TFloat(Iarch),
	TTuple([TupElem]),
	TFn([TupElem]),
	TNever,
}

# A record declaration `data Name = { Iarch a, Str b, [Elem] c }` — its type name, its
# ordered field names, and the parallel field type names (`ftypes`) and `[T]` element
# names (`felems`, "" for a non-array field). A field's byte offset is its index × 8 (a
# uniform 8-byte slot per field): a word field (`Iarch`/`Bool`) rides in the low 4 bytes,
# a pointer field (`Str`, `[T]`, a record, a boxed union) is a full 8-byte pointer.
# `ftelems` carries a tuple FIELD's per-position type names (`ftype` `"$tuple"`); the empty
# list for every non-tuple field.
# `fptrs` marks each field that was declared an aggregate POINTER `*Record`/`*Union` (a reference to
# a referent, not an owned value) — the star cf otherwise elides from `ftypes` (a `*Inner` field and
# a bare `Inner` field share ftype "Inner"). `false` for every value / scalar / array / `$ptr` field.
# It lets typecheck tell a reference-field read (`o.p`, which binds `const` — no repointing) from a
# value-field read; the parallel array stays in lockstep with `fields`/`ftypes`.
# `typarams` are the declared type variables of a GENERIC record (`data Pair['A, 'B]` →
# `["'A", "'B"]`) — empty for a non-generic record. Like a generic function, a generic record
# is a template the monomorphization pass clones per distinct type-argument set.
# `tbounds` are the per-type-parameter BOUNDS (`data Tagged[Color 'T]` → `["Color"]`; the empty
# string for an unbounded parameter) — a bound names a union the type argument must satisfy.
# `fsizes` marks each INLINE fixed-array field `[N Elem]` (ftype `"$fix"`) with its comptime length
# `N` — the field occupies `align8(N × stride)` bytes IN the record body (not an 8-byte pointer slot),
# so `field_offset` becomes a running sum rather than `index × 8`. `0` for every ordinary field (an
# 8-byte slot). `felems` still names the element type (its stride); reading such a field yields the
# INLINE byte address (like a `*[Elem]` pointer whose pointee is the field's own storage).
pub data RecDecl = {
	Str name,
	[Str] fields,
	[Str] ftypes,
	[Str] felems,
	[[TupElem]] ftelems,
	[Bool] fptrs,
	[Str] typarams,
	[Str] tbounds,
	[Iarch] fsizes,
}

# A union member: its name and its payload field TYPE names (empty for a tag-only
# member like `Nil`). And a union declaration `union Name = { A, B(Iarch), ... }` — its
# type name and ordered members. A member's tag is its index. A union with NO payload
# member anywhere is a bare word tag; otherwise every value is a boxed `{tag, ...}`
# arena pointer. `payloads` are the positional payload TYPE names; `pelems` the parallel
# `[T]` element names ("" for a non-array payload) — so a member payload may be any type
# (a word, a `Str`, a `[T]`, a record, a recursive union), laid out in 8-byte slots.
# `ptelems` carries a tuple PAYLOAD's per-position type names (its `payload` is `"$tuple"`);
# the empty list for every non-tuple payload position.
pub data UnionMember = { Str name, [Str] payloads, [Str] pelems, [[TupElem]] ptelems }
# A union declaration `union Name = { A, B(Iarch), ... }` — its type name and ordered `members`
# (a member's tag is its index). `typarams` are the declared type variables of a GENERIC union
# (`union Opt['T]` → `["'T"]`; empty otherwise) and `tbounds` their per-parameter bounds; like a
# generic record it is a template the monomorphization pass clones per type-argument set.
pub data UnionDecl = { Str name, [UnionMember] members, [Str] typarams, [Str] tbounds }

# A statement in a block body. `Let(name, mutable, ann, init)` binds a local (`mutable`
# distinguishes `let` from `const`; `ann` is the written type-name annotation or `""` — used
# for fixed-width literal adoption, `const Int8 x = 100`); `Assign(name, value)` reassigns a `let`;
# `FieldAssign(base, field, value)` mutates a `let` record's field (`base.field =
# value`), where `base` is a NAME. `DeepFieldAssign(baseExpr, field, value)` is the CHAINED lvalue
# `a.b.c... = value` — `baseExpr` is the record-pointer expression (a `Field`/`FieldExpr` chain)
# addressing the penultimate record and `field` its final member; in cf's arena model each hop is an
# 8-byte pointer load, so a store into the last field mutates the original aggregate. `Return(value)`
# yields the function's result. `IfThen(cond, stmt)` is a
# statement-position `if cond then <stmt>` guard — it runs the single guarded
# statement (an early `return`, an assignment, or a loop exit `break`/`continue`)
# only when the condition holds, then falls through; the guard itself never
# terminates the enclosing flow (an unconditional `return` still must follow).
# `Do(call)` is a call-for-effect statement — a bare `f(args)` evaluated for its side
# effect with the result discarded (e.g. `die(msg)`, `close(fd)`, `emit_program(...)`).
# `Block(stmts)` is a brace-delimited group of statements (its own scope) — the body of a
# statement-`if`/`else` written `if c then { ... }`; it is terminal iff its last statement is.
# `IfElse(cond, then, else)` adds the else branch (each an ordinary statement, so
# `else if ...` chains); when BOTH branches terminate (return/break/continue) the whole
# statement is terminal, and a following statement is unreachable.
# `Match(scrut, arms)` is a statement-position `match` — a union tag-dispatch evaluated
# for effect (each `StmtArm` body is a `{ ... }` block); it is terminal iff every arm is.
# `Closure(name, params, ret_name, body)` is a LOCAL lambda binding `const name = (params)
# -> body` (memory_model §7). It captures enclosing locals/parameters BY REFERENCE — the
# lift pass (closures.cf, after typecheck) turns each into a top-level function whose captures
# become trailing hidden parameters (a scalar by its slot address, an aggregate by its
# pointer) and rewrites the call sites to pass them; there is no runtime closure object. v1:
# `const`-bound, called directly, no nesting, no first-class value (typecheck enforces).
# `Defer(body)` schedules `body` (a call `defer f(x)` lowered to `[Do]`, or a `defer { ... }`
# block) to run at scope exit, in LIFO order, AFTER the return value is fixed. v1: only a
# direct function-body statement (not in a loop / nested in a defer; typecheck enforces), and
# its body may not `return`. The defer.cf pass (after typecheck, before the closure lift)
# lowers each `return e` in a defer-bearing function into `{ const $ret = e; <defers>; return
# $ret }`, snapshotting the value then running the pending defers — so no `Defer` reaches emit.
pub union Stmt = {
	Let(Str, Bool, Str, Expr),
	Assign(Str, Expr),
	FieldAssign(Str, Str, Expr),
	DeepFieldAssign(Expr, Str, Expr),
	IndexAssign(Str, Expr, Expr),
	Return(Expr),
	ForIn(Str, Str, [Stmt]),
	Loop([Stmt]),
	Break,
	Continue,
	IfThen(Expr, Stmt),
	IfElse(Expr, Stmt, Stmt),
	Do(Expr),
	Block([Stmt]),
	Match(Expr, [StmtArm]),
	Destructure([Str], Bool, Expr),
	Yield(Expr),
	Closure(Str, [Param], Str, [Stmt]),
	Defer([Stmt]),
}

# A function parameter. `is_ptr` marks an opaque pointer (`*[Str]` argv/envp — no
# usable value). `type_name` is the written type name for a non-pointer parameter
# (`Iarch`, `Bool`, or a record type like `Point`), resolved to a `Ty` at typecheck
# (a declared record → `TRec`) — so a record parameter is passed by pointer and its
# fields are readable.
# fields are readable.) For a dynamic-array parameter `[Elem]`, `type_name` is the
# marker `"$dyn"` and `elem` names the element type (`Iarch`/a record/`Str`); `elem` is
# "" for a non-array parameter. A `(A, B) name` tuple parameter uses `type_name` `"$tuple"`
# and carries each position's type name in `telems` (empty otherwise); it is passed by
# pointer like a record.
pub data Param = { Str name, Bool is_ptr, Str type_name, Str elem, [TupElem] telems, Iarch size }

# A whole parsed function: its name, whether it was declared `pub`, its declared
# return type NAME (`""` for `main`'s implicit `Int`; resolved to a `Ty` at
# typecheck, like a parameter — so a record/union return type resolves even when
# declared after this function), and — for a `[Elem]` dynamic-array return (`ret_name`
# is `"$dyn"`) — `ret_elem`, the element type name (else ""); its parameter list, and
# its block body. A program is a list of these; one must be `pub const main`.
# An `-> asm "..."` function (ebnf § Assembly) sets `is_asm` and carries its verbatim body in
# `asm_body` as segments (literal runs + `${param}` holes, reusing `Seg`); its `body` is
# empty and it is emitted naked into the asm floor, not through QBE. A non-asm function has
# `is_asm` false and an empty `asm_body`.
# `asm_sym` (usually "") pins an asm function's EXACT emitted symbol instead of the positional
# `f<idx>`: a privileged floor module (`std::rt::floor::*`, tagged in resolve) sets it to the
# function's source name so `_start` / `cf_root_page_init` link by the fixed name the entry and
# the `raw::grow`/`raw::trap` lowerings reference. Ignored for non-asm functions and for asm
# functions that cf code calls (those keep positional linkage). Survives name mangling (mangling
# rewrites `name`, not this). `is_value` marks a top-level VALUE const (`const x
# = <expr>`, modeled as a nullary function returning the value, referenced bare and
# auto-called) — distinct from a genuine zero-arg function; the flatten leaves a value
# const's name UN-mangled (its bare `Var` reference is not rewritten), unlike a nullary
# function whose `Call` sites are.
# `ret_telems` names each position's type when `ret_name` is `"$tuple"` (a tuple return);
# the empty list otherwise.
# `typarams` are the declared type variables (`['T]` → `["'T"]`) — empty for a non-generic
# function. A generic function is a TEMPLATE: the monomorphization pass clones it per distinct
# type-argument set (substituting each `'T`) into concrete instances before typecheck/emit.
pub data Func = {
	Str name,
	Bool is_pub,
	Str ret_name,
	Str ret_elem,
	[Param] params,
	[Stmt] body,
	Bool is_asm,
	[Seg] asm_body,
	Bool is_value,
	[TupElem] ret_telems,
	[Str] typarams,
	[Str] tbounds,
	Iarch ret_size,
	Bool is_intrinsic,
	Str asm_sym,
}

# A parsed return annotation: the type NAME (`"$dyn"` for a `[Elem]` array, `"$tuple"` for a
# `(A, B)` tuple), an array's element type name (else ""), and a tuple's position types.
pub data RetSig = { Str name, Str elem, [TupElem] telems, Iarch size }

# A top-level import `import a::b::{ x, Y }` (destructured), `import a::b as ns` / `import a::b`
# (namespace — `alias` is the `as` name or the last segment), or `import a::b as *` (wildcard) —
# the `/`-joined module path, the destructured member names (empty otherwise), the namespace
# `alias` (empty for destructured/wildcard), and `wildcard` (a `as *` splices the target's WHOLE
# exported surface flat into this module — no nesting, no enumeration; module_system §5). The
# resolver (§8) loads the named module and flattens its declarations. `alias` lets a NAMESPACE
# REEXPORT (`pub import m as io`) be followed by name through a nested `foo::io::member` path.
pub data Import = { Str path, [Str] names, Str alias, Bool wildcard }

# The whole program: its imports (consumed and emptied by the resolver), record
# declarations, union declarations, and functions — all visible whole-program (a type
# may be declared after the function that uses it).
# `groups` are grouped-parameter `type X = { ... }` declarations (type_system §7): record-shaped
# parameter bundles that resolve SPLATS into individual parameters (a `(X g)` param becomes the
# group's fields) and expands a `{ ... }` call argument into positional values. They are fully
# CONSUMED by resolve — `groups` is empty in the Program every later pass sees.
pub data Program = {
	[Import] imports,
	[RecDecl] recs,
	[UnionDecl] unions,
	[Func] funcs,
	[RecDecl] groups,
}

# Read / re-apply the `in <geometry>` binding name on a call (Expr.Call's `geom` field). A pass that
# rebuilds a call from a matched one wraps its result in `with_geom(..., g)` so the annotation survives
# to emit; a non-call is returned unchanged.
pub const call_geom = (Expr e): Str -> match e { Expr.Call(_, _, _, g) -> g, _ -> "" }

# Re-apply an `in <geometry>` binding name `g` to a call, rebuilding the `Expr.Call` with `g` in
# its `geom` field; a non-call is returned unchanged. The counterpart to `call_geom`.
pub const with_geom = (Expr e, Str g): Expr -> match e {
	Expr.Call(n, ta, args, _) -> Expr.Call(n, ta, args, g),
	_ -> e,
}
