# alloc — the `!` allocation algebra, checked both ways (memory_model §5).
#
# A function is `!` ("colored") when it NEEDS memory: it holds at least one aggregate that
# lives and dies within its own frame (residue that never escapes), OR it calls another
# concrete `!` function (not one received as a parameter), OR it passes a `!` function VALUE
# as a call argument (the effect rides the visibly-`!` argument). The color propagates up the
# call chain and terminates at `main`, which the runtime runs under the root — so `main` is the
# one exemption. The marker `!` is part of the function's NAME (ebnf § Identifiers), written by
# the user; this pass validates it BOTH WAYS — a missing `!` on an allocator is an error, and a
# redundant `!` on a colorless function is an error.
#
# UNCONDITIONAL. The whole tree (compiler + lib + corpus) is colored, so this runs on every
# compile with no flag. Runs PRE-monomorphization so the color is per SOURCE function, and the
# companion root-page rule (check_root_program!) runs alongside it — both are mandatory.
#
# Escape (memory_model §5): a value escapes by RETURNING (handed to the caller) or REHOMING
# (stored into a caller-owned aggregate — an assignment into a parameter aggregate). Allocation
# that escapes is charged to the destination's owner, not the allocator. So a constructed
# aggregate is RESIDUE iff it is trapped — neither returned nor rehomed. `compute_esc` finds the
# local names that escape; `scan_trapped`/`scan_escaping` then decide whether any construction is
# trapped. A `defer` body is analyzed in the enclosing frame (its residence is the function's); a
# closure body is analyzed with its OWN context and a `!` closure colors the function that holds it.

import std::compiler::ast::{
	Expr,
	Stmt,
	MatchArm,
	StmtArm,
	Seg,
	FieldInit,
	Param,
	UnionDecl,
	UnionMember,
	Func,
	Program,
}
import std::data::str::{ eq }
import std::io::console::{ die }
import std::compiler::diag::{ Diag }
import std::compiler::spans::{ unat, line_col_of, SrcMap, LC }

# A name carries the allocation marker iff it contains a `!` (byte 33). The marker rides directly
# after the base name in the source (`alloc!`); monomorphization then appends an instance suffix
# (`alloc!__0`), so the `!` need not be the last byte — but the suffix (`__N`) never contains one,
# so scanning for any `!` faithfully recovers the declared color.
const is_bang_name = (Str n): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(n.len) then break
		if Iarch(n[i]) == 33 then return true
		i = i + 1
	}

	return false
}

# A binding whose name carries the leading `$` STACK marker (byte 36): its storage is on the machine
# stack (freed at frame exit), so — like a scalar — it is NOT residue and does not color the
# function.
const is_stack_name = (Str n): Bool -> if Iarch(n.len) == 0 then false else Iarch(n[0]) == 36

const has_name = ([Str] xs, Str s): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(xs.len) then break
		if eq(xs[i], s) then return true
		i = i + 1
	}

	return false
}

# Typed empty lists — a bare `[]` in expression position defaults to `[Iarch]`, so a
# `[Str]`/`[Expr]`
# result must be produced through an annotated binding.
const no_strs = (): [Str] -> {
	let [Str] e = []

	return e
}

const no_exprs = (): [Expr] -> {
	let [Expr] e = []

	return e
}

# Concatenate two lists. Built from a FRESH `[]` — `let r = a; r = [...r, x]` would alias and mutate
# the caller's `a` in place (the array-aliasing hazard), corrupting a list read again later.
const cat_e = ([Expr] a, [Expr] b): [Expr] -> {
	let [Expr] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(a.len) then break
		r = [...r, a[i]]
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(b.len) then break
		r = [...r, b[j]]
		j = j + 1
	}

	return r
}

const cat_s = ([Str] a, [Str] b): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(a.len) then break
		r = [...r, a[i]]
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(b.len) then break
		r = [...r, b[j]]
		j = j + 1
	}

	return r
}

# Add each name in `b` not already present in `a` (a monotone set union). Fresh backing, as above.
const union_names = ([Str] a, [Str] b): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(a.len) then break
		r = [...r, a[i]]
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(b.len) then break
		if !has_name(r, b[j]) then r = [...r, b[j]]
		j = j + 1
	}

	return r
}

# A union is BOXED (its values are `{tag, ...}` arena pointers, so a construction allocates) iff any
# member anywhere carries a payload; a union with no payload anywhere is a bare word tag.
const union_boxed = ([UnionDecl] unions, Str name): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(unions.len) then break
		if eq(unions[i].name, name) then {
			let Iarch j = 0

			loop {
				if j >= Iarch(unions[i].members.len) then break
				if Iarch(unions[i].members[j].payloads.len) > 0 then return true
				j = j + 1
			}

			return false
		}
		i = i + 1
	}

	return false
}

# The read-only context threaded through the residue scan: the union table (to tell a boxed
# construction from a bare-word one), the current function's parameter names (a rehome target),
# and the set of local names that escape.
data ACtx = { [UnionDecl] unions, [Str] params, [Str] esc }

# The immediate EXPRESSION children of `e`, for the generic residue / call recursion. Every
# recursive expr form except a value block `Expr.Loop` (which holds STATEMENTS, walked specially)
# lists its sub-expressions here; leaves return `[]`. Match arm BODIES are expressions.
const field_values = ([FieldInit] fs): [Expr] -> {
	let [Expr] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		r = [...r, fs[i].value]
		i = i + 1
	}

	return r
}

const hole_exprs = ([Seg] segs): [Expr] -> {
	let [Expr] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		if segs[i].is_hole then r = [...r, segs[i].expr]
		i = i + 1
	}

	return r
}

const arm_bodies = ([MatchArm] arms): [Expr] -> {
	let [Expr] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		r = [...r, arms[i].body]
		i = i + 1
	}

	return r
}

# A single-element list `[a]` sets its element type from `a`; longer lists are grown by spread, so a
# multi-element `[Expr]` of a union type is built through these rather than a plain `[a, b]`
# literal.
const exl_one = (Expr a): [Expr] -> {
	let [Expr] r = [a]

	return r
}

const exl_two = (Expr a, Expr b): [Expr] -> {
	let [Expr] r = [a]

	return [...r, b]
}

const exl_three = (Expr a, Expr b, Expr c): [Expr] -> {
	let [Expr] r = [a]
	r = [...r, b]

	return [...r, c]
}

const expr_children = (Expr e): [Expr] -> match unat(e) {
	Expr.Record(_, inits) -> field_values(inits),
	Expr.ArrayLit(_, sp, elems, _) -> cat_e(exl_one(sp), elems),
	Expr.Tuple(elems) -> elems,
	Expr.UnionMk(_, _, args) -> args,
	Expr.Interp(segs) -> hole_exprs(segs),
	Expr.Buffer(sz) -> exl_one(sz),
	Expr.Match(s, arms) -> cat_e(exl_one(s), arm_bodies(arms)),
	Expr.If(c, t, el) -> exl_three(c, t, el),
	Expr.Call(_, _, args, _) -> args,
	Expr.DeferTap(_, args) -> args,
	Expr.FieldExpr(b, _) -> exl_one(b),
	Expr.Index(_, i) -> exl_one(i),
	Expr.IndexField(_, i, _) -> exl_one(i),
	Expr.IndexExpr(b, i) -> exl_two(b, i),
	Expr.Spread(x) -> exl_one(x),
	Expr.Neg(x) -> exl_one(x),
	Expr.Not(x) -> exl_one(x),
	Expr.BitNot(x) -> exl_one(x),
	Expr.Add(a, b) -> exl_two(a, b),
	Expr.Sub(a, b) -> exl_two(a, b),
	Expr.Mul(a, b) -> exl_two(a, b),
	Expr.Div(a, b) -> exl_two(a, b),
	Expr.Mod(a, b) -> exl_two(a, b),
	Expr.BitAnd(a, b) -> exl_two(a, b),
	Expr.BitOr(a, b) -> exl_two(a, b),
	Expr.BitXor(a, b) -> exl_two(a, b),
	Expr.Shl(a, b) -> exl_two(a, b),
	Expr.Shr(a, b) -> exl_two(a, b),
	Expr.CmpEq(a, b) -> exl_two(a, b),
	Expr.CmpNe(a, b) -> exl_two(a, b),
	Expr.CmpLt(a, b) -> exl_two(a, b),
	Expr.CmpGt(a, b) -> exl_two(a, b),
	Expr.CmpLe(a, b) -> exl_two(a, b),
	Expr.CmpGe(a, b) -> exl_two(a, b),
	Expr.And(a, b) -> exl_two(a, b),
	Expr.Or(a, b) -> exl_two(a, b),
	_ -> no_exprs(),
}

# Does `e` CONSTRUCT an aggregate at this node? Records, arrays, tuples, byte buffers, and
# runtime-built (interpolated) strings always do; a union construction does iff its union is boxed.
# A string LITERAL is static data, not residue.
const is_construction = (ACtx cx, Expr e): Bool -> match unat(e) {
	Expr.Record(_, _) -> true,
	Expr.ArrayLit(_, _, _, _) -> true,
	Expr.Tuple(_) -> true,
	Expr.Buffer(_) -> true,
	Expr.Interp(_) -> true,
	Expr.UnionMk(u, _, _) -> union_boxed(cx.unions, u),
	_ -> false,
}

# Whether ANY of `es` traps a residue (non-escaping context).
const any_trapped! = (ACtx cx, [Expr] es): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if scan_trapped!(cx, es[i]) then return true
		i = i + 1
	}

	return false
}

# `e` is in a NON-escaping position: a construction here is trapped residue, and everything
# within is likewise non-escaping. Returns whether any trapped construction exists.
const scan_trapped! = (ACtx cx, Expr e): Bool -> {
	if is_construction(cx, e) then return true

	return match unat(e) {
		Expr.Loop(ss) -> body_traps!(cx, false, ss),
		_ -> any_trapped!(cx, expr_children(e)),
	}
}

# Whether ANY of `es` traps a residue while itself in an ESCAPING position.
const any_escaping! = (ACtx cx, [Expr] es): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if scan_escaping!(cx, es[i]) then return true
		i = i + 1
	}

	return false
}

# `e` is in an ESCAPING position (its value is returned or rehomed): a construction HERE is not
# residue, but a construction inside a call argument, a read base, or an if-condition IS. Returns
# whether any trapped construction exists within.
const scan_escaping! = (ACtx cx, Expr e): Bool -> match unat(e) {
	Expr.Record(_, inits) -> any_escaping!(cx, field_values(inits)),
	Expr.ArrayLit(_, sp, elems, _) -> scan_trapped!(cx, sp) || any_escaping!(cx, elems),
	Expr.Tuple(elems) -> any_escaping!(cx, elems),
	Expr.UnionMk(_, _, args) -> any_escaping!(cx, args),
	Expr.Buffer(sz) -> scan_trapped!(cx, sz),
	Expr.Interp(segs) -> any_trapped!(cx, hole_exprs(segs)),
	Expr.If(c, t, el) -> scan_trapped!(cx, c) || scan_escaping!(cx, t) || scan_escaping!(cx, el),
	Expr.Match(s, arms) -> scan_trapped!(cx, s) || any_escaping!(cx, arm_bodies(arms)),
	Expr.Loop(ss) -> body_traps!(cx, true, ss),
	Expr.Call(_, _, args, _) -> any_trapped!(cx, args),
	_ -> scan_trapped!(cx, e),
}

# A `$`-Let with a LITERAL aggregate initializer builds on the machine STACK: emit's `alloc_stack`
# flag rides through the WHOLE initializer (nested literals included), so record/array/buffer
# literals anywhere inside are stack storage, not node residue. But three forms draw on the NODE
# even under the flag — an interpolated Str (the cf_str floor helpers), a tuple, and a boxed-union
# construction (their emit paths never consult the flag) — and a value block's statements are
# ordinary frame code. Scan for exactly those, descending the literal spine and call arguments
# (which ride the flag too).
const scan_stack_init! = (ACtx cx, Expr e): Bool -> match unat(e) {
	Expr.Record(_, inits) -> stack_scan_list!(cx, field_values(inits)),
	Expr.ArrayLit(_, sp, elems, _) -> scan_stack_init!(cx, sp) || stack_scan_list!(cx, elems),
	Expr.Buffer(sz) -> scan_stack_init!(cx, sz),
	Expr.Interp(_) -> true,
	Expr.Tuple(_) -> true,
	Expr.UnionMk(u, _, args) -> if union_boxed(cx.unions, u) then true else stack_scan_list!(cx, args),
	Expr.Loop(ss) -> body_traps!(cx, false, ss),
	_ -> stack_scan_list!(cx, expr_children(e)),
}

const stack_scan_list! = (ACtx cx, [Expr] es): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if scan_stack_init!(cx, es[i]) then return true
		i = i + 1
	}

	return false
}

# Route a `$`-Let's initializer: a top-level literal aggregate takes emit's stack branch (the
# `alloc_stack` flag is set for the whole init), so it scans in stack mode; any other form —
# a scalar expression, a call, an if/match aggregate — takes emit's scalar/normal path where
# the flag is never set, so every construction inside is ordinary node residue (this is what
# made `const $n = "x${y}z".len` allocate invisibly — the old arm skipped the init entirely).
const scan_stack_let! = (ACtx cx, Expr init): Bool -> match unat(init) {
	Expr.Record(_, _) -> scan_stack_init!(cx, init),
	Expr.ArrayLit(_, _, _, _) -> scan_stack_init!(cx, init),
	Expr.Buffer(_) -> scan_stack_init!(cx, init),
	_ -> scan_trapped!(cx, init),
}

# The root NAME of a chained lvalue's base (`a.b.c... = v` — the Var/name at the bottom of the
# Field/Index chain), or "" when the base is not name-rooted (a non-name root is never a
# parameter, so "" safely reads as non-escaping).
const deep_root = (Expr e): Str -> match unat(e) {
	Expr.Var(n) -> n,
	Expr.Field(b, _) -> b,
	Expr.FieldExpr(b, _) -> deep_root(b),
	Expr.Index(b, _) -> b,
	Expr.IndexField(b, _, _) -> b,
	Expr.IndexExpr(b, _) -> deep_root(b),
	_ -> "",
}

# Walk a statement list for trapped residue. `yesc` says whether a `<- v` yield escapes (true when
# the enclosing value block is itself in an escaping position).
const body_traps! = (ACtx cx, Bool yesc, [Stmt] ss): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		if stmt_traps!(cx, yesc, ss[i]) then return true
		i = i + 1
	}

	return false
}

const stmtarms_traps! = (ACtx cx, Bool yesc, [StmtArm] arms): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if body_traps!(cx, yesc, arms[i].body) then return true
		i = i + 1
	}

	return false
}

# A binding target escapes if it is a parameter (rehome into a caller aggregate) or a local already
# known to escape (its value flows to a return / rehome).
const target_escapes = (ACtx cx, Str name): Bool ->
	has_name(cx.params, name) || has_name(cx.esc, name)

const stmt_traps! = (ACtx cx, Bool yesc, Stmt s): Bool -> match s {
	Stmt.Return(e) -> scan_escaping!(cx, e),
	Stmt.Yield(e) -> if yesc then scan_escaping!(cx, e) else scan_trapped!(cx, e),
	Stmt.Let(name, _, _, init) -> if has_name(cx.esc, name)
		then scan_escaping!(cx, init)
		else if is_stack_name(name)
			then scan_stack_let!(cx, init)
			else scan_trapped!(cx, init),
	Stmt.Assign(name, val) -> if target_escapes(cx, name)
		then scan_escaping!(cx, val)
		else scan_trapped!(cx, val),
	Stmt.FieldAssign(base, _, val) -> if target_escapes(cx, base)
		then scan_escaping!(cx, val)
		else scan_trapped!(cx, val),
	Stmt.DeepFieldAssign(be, _, val) -> if target_escapes(cx, deep_root(be))
		then scan_trapped!(cx, be) || scan_escaping!(cx, val)
		else scan_trapped!(cx, be) || scan_trapped!(cx, val),
	Stmt.IndexAssign(base, idx, val) ->
		scan_trapped!(cx, idx) ||
		(if target_escapes(cx, base) then scan_escaping!(cx, val) else scan_trapped!(cx, val)),
	Stmt.Do(e) -> scan_trapped!(cx, e),
	Stmt.IfThen(c, s2) -> scan_trapped!(cx, c) || stmt_traps!(cx, yesc, s2),
	Stmt.IfElse(c, t, el) ->
		scan_trapped!(cx, c) || stmt_traps!(cx, yesc, t) || stmt_traps!(cx, yesc, el),
	Stmt.Block(ss) -> body_traps!(cx, yesc, ss),
	Stmt.Loop(ll_, ss) -> body_traps!(cx, yesc, ss),
	Stmt.ForIn(_, _, ss) -> body_traps!(cx, yesc, ss),
	Stmt.Match(sc, arms) -> scan_trapped!(cx, sc) || stmtarms_traps!(cx, yesc, arms),
	Stmt.Destructure(_, _, e) -> scan_trapped!(cx, e),
	# a `defer` body runs in THIS frame at scope exit (for effect, never returning), so its residue
	# is the enclosing function's — descend with the same context
	Stmt.Defer(ss) -> body_traps!(cx, false, ss),
	# a closure's residue is its own; analyze it with its own context and let a `!` closure color us
	Stmt.Closure(_, cps, _, cbody) -> closure_traps!(cx.unions, cps, cbody),
	_ -> false,
}

# The local names that escape when `e` is in an escaping position: bare `Var`s reachable through
# aggregate components / branches / value-block yields (NOT through call arguments or read bases,
# which do not escape).
# A `<- v` yield may sit inside a nested if/block/match (mirroring typecheck's stmt_yields_local)
# — but NOT inside a nested loop, which opens its own value context. A yield buried in a branch
# escapes exactly like a top-level one.
const yield_vars_stmt = (Stmt s): [Str] -> match s {
	Stmt.Yield(e) -> esc_vars(e),
	Stmt.IfThen(_, b) -> yield_vars_stmt(b),
	Stmt.IfElse(_, t, el) -> cat_s(yield_vars_stmt(t), yield_vars_stmt(el)),
	Stmt.Block(ss) -> yield_vars(ss),
	Stmt.Match(_, arms) -> yield_vars_stmtarms(arms),
	_ -> no_strs(),
}

const yield_vars_stmtarms = ([StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, yield_vars(arms[i].body))
		i = i + 1
	}

	return r
}

const yield_vars = ([Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, yield_vars_stmt(ss[i]))
		i = i + 1
	}

	return r
}

const esc_vars = (Expr e): [Str] -> match unat(e) {
	Expr.Var(n) -> [n],
	Expr.Record(_, inits) -> vars_of(field_values(inits)),
	# a spread `[...src, elems]` in escaping position carries its SOURCE out too (the source's
	# backing becomes the returned/rehomed array's own), so `src`'s vars escape alongside the
	# trailing elements — without this, `return [...xs, x]` leaves `xs` looking trapped and the
	# frame is spuriously colored `!` for residue it does not actually hold.
	Expr.ArrayLit(hs, sp, elems, _) -> if hs
		then cat_s(esc_vars(sp), vars_of(elems))
		else vars_of(elems),
	Expr.Tuple(elems) -> vars_of(elems),
	Expr.UnionMk(_, _, args) -> vars_of(args),
	Expr.If(_, t, el) -> cat_s(esc_vars(t), esc_vars(el)),
	Expr.Match(_, arms) -> vars_of(arm_bodies(arms)),
	Expr.Loop(ss) -> yield_vars(ss),
	Expr.Spread(x) -> esc_vars(x),
	_ -> no_strs(),
}

const vars_of = ([Expr] es): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		r = cat_s(r, esc_vars(es[i]))
		i = i + 1
	}

	return r
}

# One pass collecting escape roots and closing aliasing: a return/yield escapes its value's vars; a
# rehome (assign / field / deep-field / index into a parameter or escaping aggregate) escapes the
# stored vars; a binding to an already-escaping name escapes its initializer's vars. Iterated to a
# fixpoint. Every statement's EXPRESSIONS are also walked for embedded value blocks (`Expr.Loop`),
# whose statement bodies share this frame's params/locals — a rehome inside one escapes exactly
# like a top-level rehome (it was invisible before: the walk never descended into expressions).
const esc_roots_stmt = ([Str] params, [Str] esc, Stmt s): [Str] -> match s {
	Stmt.Return(e) -> esc_vars(e),
	Stmt.Yield(e) -> esc_vars(e),
	Stmt.Assign(name, val) -> if has_name(params, name) || has_name(esc, name)
		then esc_vars(val)
		else no_strs(),
	Stmt.FieldAssign(base, _, val) -> if has_name(params, base) || has_name(esc, base)
		then esc_vars(val)
		else no_strs(),
	Stmt.IndexAssign(base, _, val) -> if has_name(params, base) || has_name(esc, base)
		then esc_vars(val)
		else no_strs(),
	Stmt.DeepFieldAssign(be, _, val) ->
		if has_name(params, deep_root(be)) || has_name(esc, deep_root(be))
			then esc_vars(val)
			else no_strs(),
	Stmt.Let(name, _, _, init) -> if has_name(esc, name) then esc_vars(init) else no_strs(),
	Stmt.IfThen(_, s2) -> esc_roots_stmt(params, esc, s2),
	Stmt.IfElse(_, t, el) -> cat_s(esc_roots_stmt(params, esc, t), esc_roots_stmt(params, esc, el)),
	Stmt.Block(ss) -> esc_roots_body(params, esc, ss),
	Stmt.Loop(ll_, ss) -> esc_roots_body(params, esc, ss),
	Stmt.ForIn(_, _, ss) -> esc_roots_body(params, esc, ss),
	Stmt.Match(_, arms) -> esc_roots_stmtarms(params, esc, arms),
	# a `defer` body shares this frame's locals/params, so a rehome inside it escapes too
	Stmt.Defer(ss) -> esc_roots_body(params, esc, ss),
	_ -> no_strs(),
}

# The expressions a statement holds directly — walked for embedded value-block bodies.
const stmt_exprs = (Stmt s): [Expr] -> match s {
	Stmt.Return(e) -> exl_one(e),
	Stmt.Yield(e) -> exl_one(e),
	Stmt.Let(_, _, _, init) -> exl_one(init),
	Stmt.Assign(_, val) -> exl_one(val),
	Stmt.FieldAssign(_, _, val) -> exl_one(val),
	Stmt.DeepFieldAssign(be, _, val) -> exl_two(be, val),
	Stmt.IndexAssign(_, idx, val) -> exl_two(idx, val),
	Stmt.Do(e) -> exl_one(e),
	Stmt.IfThen(c, _) -> exl_one(c),
	Stmt.IfElse(c, _, _) -> exl_one(c),
	Stmt.Match(sc, _) -> exl_one(sc),
	Stmt.Destructure(_, _, e) -> exl_one(e),
	_ -> no_exprs(),
}

const esc_roots_expr = ([Str] params, [Str] esc, Expr e): [Str] -> match unat(e) {
	Expr.Loop(ss) -> esc_roots_body(params, esc, ss),
	_ -> esc_roots_elist(params, esc, expr_children(e)),
}

const esc_roots_elist = ([Str] params, [Str] esc, [Expr] es): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		r = cat_s(r, esc_roots_expr(params, esc, es[i]))
		i = i + 1
	}

	return r
}

const esc_roots_body = ([Str] params, [Str] esc, [Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, esc_roots_stmt(params, esc, ss[i]))
		r = cat_s(r, esc_roots_elist(params, esc, stmt_exprs(ss[i])))
		i = i + 1
	}

	return r
}

const esc_roots_stmtarms = ([Str] params, [Str] esc, [StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, esc_roots_body(params, esc, arms[i].body))
		i = i + 1
	}

	return r
}

# The local names that ESCAPE the frame — returned, yielded, or rehomed into a parameter or an
# already-escaping aggregate — closed to a fixpoint (a store into an escaping name escapes its
# stored value in turn). A construction whose value never reaches one of these is trapped residue.
pub const compute_esc = ([Str] params, [Stmt] body): [Str] -> {
	let [Str] esc = []

	loop {
		const [Str] add = esc_roots_body(params, esc, body)
		const [Str] merged = union_names(esc, add)
		if Iarch(merged.len) == Iarch(esc.len) then break
		esc = merged
	}

	return esc
}

const var_refs_expr = (Expr e): [Str] -> match unat(e) {
	Expr.Var(n) -> exl_one_s(n),
	Expr.Loop(ss) -> var_refs_body(ss),
	_ -> var_refs_list(expr_children(e)),
}

const var_refs_list = ([Expr] es): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		r = cat_s(r, var_refs_expr(es[i]))
		i = i + 1
	}

	return r
}

const var_refs_arms = ([StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, var_refs_body(arms[i].body))
		i = i + 1
	}

	return r
}

const var_refs_stmt = (Stmt s): [Str] -> match s {
	Stmt.Return(e) -> var_refs_expr(e),
	Stmt.Yield(e) -> var_refs_expr(e),
	Stmt.Let(_, _, _, init) -> var_refs_expr(init),
	Stmt.Assign(_, val) -> var_refs_expr(val),
	Stmt.FieldAssign(_, _, val) -> var_refs_expr(val),
	Stmt.DeepFieldAssign(be, _, val) -> cat_s(var_refs_expr(be), var_refs_expr(val)),
	Stmt.IndexAssign(_, idx, val) -> cat_s(var_refs_expr(idx), var_refs_expr(val)),
	Stmt.Do(e) -> var_refs_expr(e),
	Stmt.IfThen(c, s2) -> cat_s(var_refs_expr(c), var_refs_stmt(s2)),
	Stmt.IfElse(c, t, el) -> cat_s(var_refs_expr(c), cat_s(var_refs_stmt(t), var_refs_stmt(el))),
	Stmt.Block(ss) -> var_refs_body(ss),
	Stmt.Loop(ll_, ss) -> var_refs_body(ss),
	Stmt.ForIn(_, _, ss) -> var_refs_body(ss),
	Stmt.Match(sc, arms) -> cat_s(var_refs_expr(sc), var_refs_arms(arms)),
	Stmt.Destructure(_, _, e) -> var_refs_expr(e),
	Stmt.Defer(ss) -> var_refs_body(ss),
	Stmt.Closure(_, _, _, cbody) -> var_refs_body(cbody),
	_ -> no_strs(),
}

const var_refs_body = ([Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, var_refs_stmt(ss[i]))
		i = i + 1
	}

	return r
}

# The set of names used as a VALUE (an `Expr.Var`) anywhere in the program. A direct call's callee
# is
# a bare Str in the AST, not a Var, so a FUNCTION name lands here ONLY when it is taken as a value
# (passed to a HOF, bound, returned). Emit consults it: an address-taken function is reachable by an
# indirect call, whose site cannot claim, so such a function must NOT reset (on_ret/on_alloc_ret
# pairs
# only at direct call sites in this step).
pub const address_taken = (Program prog): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(prog.funcs.len) then break
		if !prog.funcs[i].is_asm then r = union_names(r, var_refs_body(prog.funcs[i].body))
		i = i + 1
	}

	return r
}

const plist_names = ([Param] ps): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ps.len) then break
		r = [...r, ps[i].name]
		i = i + 1
	}

	return r
}

const param_names = (Func f): [Str] -> plist_names(f.params)

# A local closure (memory_model §7) is lifted to its own top-level function; its residence is its
# own, escaping to the enclosing caller only when returned. Analyze the body with the CLOSURE's own
# parameters and a fresh escape set — if it traps residue, the enclosing function (which defines and
# invokes it) is colored `!`, exactly as if it called a `!` function. Closures do not nest in v1.
const closure_traps! = ([UnionDecl] unions, [Param] cps, [Stmt] cbody): Bool -> {
	const [Str] cparams = plist_names(cps)
	const [Str] cesc = compute_esc(cparams, cbody)
	const ACtx cx2 = ACtx({ unions: unions, params: cparams, esc: cesc })

	return body_traps!(cx2, false, cbody)
}

# Does function `f` hold a trapped (non-escaping) aggregate residence of its own?
const local_residue! = ([UnionDecl] unions, Func f): Bool -> {
	const [Str] params = param_names(f)
	const [Str] esc = compute_esc(params, f.body)
	const ACtx cx = ACtx({ unions: unions, params: params, esc: esc })

	return body_traps!(cx, false, f.body)
}

# The call-side effect check. A call is effectful when its concrete (non-parameter) callee is `!`,
# or when it hands a `!` function VALUE as an argument. Definition-side: calling a `!` value
# received as a PARAMETER does NOT color (that effect rides the argument at the call site instead).
const find_func = ([Func] funcs, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(funcs.len) then break
		if eq(funcs[i].name, name) then return i
		i = i + 1
	}

	return -1
}

const named_fn_is_bang = ([Func] funcs, [Bool] bang, Str vn): Bool -> {
	const Iarch k = find_func(funcs, vn)
	if k < 0 then return false

	return bang[k]
}

const arg_is_bang_fnval = ([Func] funcs, [Bool] bang, Expr arg): Bool -> match unat(arg) {
	Expr.Var(vn) -> named_fn_is_bang(funcs, bang, vn),
	_ -> false,
}

const args_pass_bang = ([Func] funcs, [Bool] bang, [Expr] args): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(args.len) then break
		if arg_is_bang_fnval(funcs, bang, args[i]) then return true
		i = i + 1
	}

	return false
}

const call_is_effectful = ([Func] funcs, [Bool] bang, [Str] params, Str name, [Expr] args): Bool -> {
	if !has_name(params, name) then {
		const Iarch k = find_func(funcs, name)
		if k >= 0 && bang[k] then return true
	}

	return args_pass_bang(funcs, bang, args)
}

const list_calls_bang = ([Func] funcs, [Bool] bang, [Str] params, [Expr] es): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if expr_calls_bang(funcs, bang, params, es[i]) then return true
		i = i + 1
	}

	return false
}

const expr_calls_bang = ([Func] funcs, [Bool] bang, [Str] params, Expr e): Bool -> {
	const Bool here = match unat(e) {
		Expr.Call(name, _, args, _) -> call_is_effectful(funcs, bang, params, name, args),
		Expr.DeferTap(name, args) -> call_is_effectful(funcs, bang, params, name, args),
		_ -> false,
	}

	if here then return true

	return match unat(e) {
		Expr.Loop(ss) -> body_calls_bang(funcs, bang, params, ss),
		_ -> list_calls_bang(funcs, bang, params, expr_children(e)),
	}
}

const body_calls_bang = ([Func] funcs, [Bool] bang, [Str] params, [Stmt] ss): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		if stmt_calls_bang(funcs, bang, params, ss[i]) then return true
		i = i + 1
	}

	return false
}

const stmtarms_calls_bang = ([Func] funcs, [Bool] bang, [Str] params, [StmtArm] arms): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if body_calls_bang(funcs, bang, params, arms[i].body) then return true
		i = i + 1
	}

	return false
}

const stmt_calls_bang = ([Func] funcs, [Bool] bang, [Str] params, Stmt s): Bool -> match s {
	Stmt.Return(e) -> expr_calls_bang(funcs, bang, params, e),
	Stmt.Yield(e) -> expr_calls_bang(funcs, bang, params, e),
	Stmt.Let(_, _, _, init) -> expr_calls_bang(funcs, bang, params, init),
	Stmt.Assign(_, val) -> expr_calls_bang(funcs, bang, params, val),
	Stmt.FieldAssign(_, _, val) -> expr_calls_bang(funcs, bang, params, val),
	Stmt.DeepFieldAssign(be, _, val) ->
		expr_calls_bang(funcs, bang, params, be) || expr_calls_bang(funcs, bang, params, val),
	Stmt.IndexAssign(_, idx, val) ->
		expr_calls_bang(funcs, bang, params, idx) || expr_calls_bang(funcs, bang, params, val),
	Stmt.Do(e) -> expr_calls_bang(funcs, bang, params, e),
	Stmt.IfThen(c, s2) ->
		expr_calls_bang(funcs, bang, params, c) || stmt_calls_bang(funcs, bang, params, s2),
	Stmt.IfElse(c, t, el) ->
		expr_calls_bang(funcs, bang, params, c) ||
		stmt_calls_bang(funcs, bang, params, t) ||
		stmt_calls_bang(funcs, bang, params, el),
	Stmt.Block(ss) -> body_calls_bang(funcs, bang, params, ss),
	Stmt.Loop(ll_, ss) -> body_calls_bang(funcs, bang, params, ss),
	Stmt.ForIn(_, _, ss) -> body_calls_bang(funcs, bang, params, ss),
	Stmt.Match(sc, arms) ->
		expr_calls_bang(funcs, bang, params, sc) || stmtarms_calls_bang(funcs, bang, params, arms),
	Stmt.Destructure(_, _, e) -> expr_calls_bang(funcs, bang, params, e),
	# a `!` call inside a `defer` or a closure body colors the enclosing function; the closure's own
	# parameters join the indirect set so calling a closure fn-value parameter does not count
	Stmt.Defer(ss) -> body_calls_bang(funcs, bang, params, ss),
	Stmt.Closure(_, cps, _, cbody) ->
		body_calls_bang(funcs, bang, cat_s(params, plist_names(cps)), cbody),
	_ -> false,
}

const is_main = (Func f): Bool -> eq(f.name, "main")

# The color of every function, as a `[Bool]` parallel to `prog.funcs`. Seeded bottom-up from local
# residue (an asm/intrinsic body cannot be analyzed, so its declared marker is TRUSTED), then the
# color is propagated UP the call chain to a fixpoint: a function is `!` if it locally allocates, or
# transitively makes an effectful call (a concrete `!` callee, or a `!` function VALUE argument).
const compute_bang! = (Program prog): [Bool] -> {
	const [Func] funcs = prog.funcs
	const Iarch n = Iarch(funcs.len)
	let [Bool] bang = []
	let Iarch i = 0

	loop {
		if i >= n then break
		const Bool seed = if funcs[i].is_asm
			then is_bang_name(funcs[i].name)
			else local_residue!(prog.unions, funcs[i])
		bang = [...bang, seed]
		i = i + 1
	}

	loop {
		let Bool changed = false
		let [Bool] nb = []
		let Iarch k = 0

		loop {
			if k >= n then break
			let Bool v = bang[k]
			if !funcs[k].is_asm && !v then {
				if body_calls_bang(funcs, bang, param_names(funcs[k]), funcs[k].body) then v = true
			}
			# the color is monotone (only false → true), so a change is exactly v rising over bang[k]
			if v && !bang[k] then changed = true
			nb = [...nb, v]
			k = k + 1
		}

		bang = nb
		if !changed then break
	}

	return bang
}

# ── Evidence probes ────────────────────────────────────────────────────────────────────────────
# When a gate rejection fires, walk the body once more to find the STATEMENT that introduced the
# color and anchor the report at its top expression's `At` span (the gates run pre-strip, so the
# spans are still in the tree). Every descent decision REUSES the bool scanners above — the
# probes add no analysis of their own, so they cannot drift from the enforcement; a probe that
# finds no span (-1) leaves the report on the declaration stamp.

const at_off = (Expr e): Iarch -> match e { Expr.At(o, _) -> o, _ -> -1 }

# The first span among a statement's own expressions — the statement's source anchor.
const stmt_off = (Stmt s): Iarch -> {
	const [Expr] es = stmt_exprs(s)
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if at_off(es[i]) >= 0 then return at_off(es[i])
		i = i + 1
	}

	return -1
}

# The anchor of the first trapping statement in `ss` (or -1), guided by `stmt_traps!`.
const why_body! = (ACtx cx, Bool yesc, [Stmt] ss): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		if stmt_traps!(cx, yesc, ss[i]) then return why_stmt!(cx, yesc, ss[i])
		i = i + 1
	}

	return -1
}

const why_arms! = (ACtx cx, Bool yesc, [StmtArm] arms): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if body_traps!(cx, yesc, arms[i].body) then return why_body!(cx, yesc, arms[i].body)
		i = i + 1
	}

	return -1
}

# The span of the first trapped construction within `e`, itself in a NON-escaping position —
# the position mirror of `scan_trapped!`.
const wt_expr! = (ACtx cx, Expr e): Iarch -> {
	if is_construction(cx, e) then return at_off(e)

	return match unat(e) {
		Expr.Loop(ss) -> why_body!(cx, false, ss),
		_ -> wt_list!(cx, expr_children(e)),
	}
}

const wt_list! = (ACtx cx, [Expr] es): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if scan_trapped!(cx, es[i]) then return wt_expr!(cx, es[i])
		i = i + 1
	}

	return -1
}

# The span of the first trapped construction within `e` in an ESCAPING position — the position
# mirror of `scan_escaping!` (the construction itself escapes; residue hides in arguments,
# read bases, and conditions).
const we_expr! = (ACtx cx, Expr e): Iarch -> match unat(e) {
	Expr.Record(_, inits) -> we_list!(cx, field_values(inits)),
	Expr.ArrayLit(_, sp, elems, _) -> if scan_trapped!(cx, sp)
		then wt_expr!(cx, sp)
		else we_list!(cx, elems),
	Expr.Tuple(elems) -> we_list!(cx, elems),
	Expr.UnionMk(_, _, args) -> we_list!(cx, args),
	Expr.Buffer(sz) -> wt_expr!(cx, sz),
	Expr.Interp(segs) -> wt_list!(cx, hole_exprs(segs)),
	Expr.If(c, t, el) -> if scan_trapped!(cx, c)
		then wt_expr!(cx, c)
		else if scan_escaping!(cx, t) then we_expr!(cx, t) else we_expr!(cx, el),
	Expr.Match(s, arms) -> if scan_trapped!(cx, s) then wt_expr!(cx, s) else we_arms!(cx, arms),
	Expr.Loop(ss) -> why_body!(cx, true, ss),
	Expr.Call(_, _, args, _) -> wt_list!(cx, args),
	_ -> wt_expr!(cx, e),
}

const we_list! = (ACtx cx, [Expr] es): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if scan_escaping!(cx, es[i]) then return we_expr!(cx, es[i])
		i = i + 1
	}

	return -1
}

const we_arms! = (ACtx cx, [MatchArm] arms): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if scan_escaping!(cx, arms[i].body) then return we_expr!(cx, arms[i].body)
		i = i + 1
	}

	return -1
}

# Descend to the trapped construction, mirroring `stmt_traps!`'s positions arm for arm; when
# the mirror finds no span the statement's own anchor stands in. `$`-stack initializers keep
# the statement anchor (their stack-mode scan has no position mirror; the whole init is the
# offender).
const why_stmt! = (ACtx cx, Bool yesc, Stmt s): Iarch -> {
	const Iarch deep = match s {
		Stmt.Return(e) -> we_expr!(cx, e),
		Stmt.Yield(e) -> if yesc then we_expr!(cx, e) else wt_expr!(cx, e),
		Stmt.Let(name, _, _, init) -> if has_name(cx.esc, name)
			then we_expr!(cx, init)
			else if is_stack_name(name) then at_off(init) else wt_expr!(cx, init),
		Stmt.Assign(name, val) -> if target_escapes(cx, name)
			then we_expr!(cx, val)
			else wt_expr!(cx, val),
		Stmt.FieldAssign(base, _, val) -> if target_escapes(cx, base)
			then we_expr!(cx, val)
			else wt_expr!(cx, val),
		Stmt.DeepFieldAssign(be, _, val) -> if scan_trapped!(cx, be)
			then wt_expr!(cx, be)
			else if target_escapes(cx, deep_root(be)) then we_expr!(cx, val) else wt_expr!(cx, val),
		Stmt.IndexAssign(base, idx, val) -> if scan_trapped!(cx, idx)
			then wt_expr!(cx, idx)
			else if target_escapes(cx, base) then we_expr!(cx, val) else wt_expr!(cx, val),
		Stmt.Do(e) -> wt_expr!(cx, e),
		Stmt.IfThen(c, s2) -> if scan_trapped!(cx, c)
			then wt_expr!(cx, c)
			else why_stmt!(cx, yesc, s2),
		Stmt.IfElse(c, t, el) -> if scan_trapped!(cx, c)
			then wt_expr!(cx, c)
			else if stmt_traps!(cx, yesc, t) then why_stmt!(cx, yesc, t) else why_stmt!(cx, yesc, el),
		Stmt.Block(ss) -> why_body!(cx, yesc, ss),
		Stmt.Loop(ll_, ss) -> why_body!(cx, yesc, ss),
		Stmt.ForIn(_, _, ss) -> why_body!(cx, yesc, ss),
		Stmt.Match(sc, arms) -> if scan_trapped!(cx, sc)
			then wt_expr!(cx, sc)
			else why_arms!(cx, yesc, arms),
		Stmt.Destructure(_, _, e) -> wt_expr!(cx, e),
		Stmt.Defer(ss) -> why_body!(cx, false, ss),
		Stmt.Closure(_, cps, _, cbody) -> why_closure!(cx, cps, cbody),
		_ -> -1,
	}
	if deep >= 0 then return deep

	return stmt_off(s)
}

# A closure's residue is found with its own context, exactly as `closure_traps!` colors it.
const why_closure! = (ACtx cx, [Param] cps, [Stmt] cbody): Iarch -> {
	const [Str] cparams = plist_names(cps)
	const [Str] cesc = compute_esc(cparams, cbody)
	const ACtx cx2 = ACtx({ unions: cx.unions, params: cparams, esc: cesc })

	return why_body!(cx2, false, cbody)
}

# The anchor of the first effectful call in `ss` (or -1), guided by `stmt_calls_bang`.
const whyc_body = ([Func] funcs, [Bool] bang, [Str] params, [Stmt] ss): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		if stmt_calls_bang(funcs, bang, params, ss[i])
			then return whyc_stmt(funcs, bang, params, ss[i])
		i = i + 1
	}

	return -1
}

const whyc_arms = ([Func] funcs, [Bool] bang, [Str] params, [StmtArm] arms): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if body_calls_bang(funcs, bang, params, arms[i].body)
			then return whyc_body(funcs, bang, params, arms[i].body)
		i = i + 1
	}

	return -1
}

# The guilty call's own span: the node where `call_is_effectful` answers, else the first
# guilty child (a nested call in an argument).
const whyc_expr = ([Func] funcs, [Bool] bang, [Str] params, Expr e): Iarch -> {
	const Bool here = match unat(e) {
		Expr.Call(name, _, args, _) -> call_is_effectful(funcs, bang, params, name, args),
		Expr.DeferTap(name, args) -> call_is_effectful(funcs, bang, params, name, args),
		_ -> false,
	}
	if here then return at_off(e)

	return match unat(e) {
		Expr.Loop(ss) -> whyc_body(funcs, bang, params, ss),
		_ -> whyc_list(funcs, bang, params, expr_children(e)),
	}
}

const whyc_list = ([Func] funcs, [Bool] bang, [Str] params, [Expr] es): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		if expr_calls_bang(funcs, bang, params, es[i])
			then return whyc_expr(funcs, bang, params, es[i])
		i = i + 1
	}

	return -1
}

const whyc_stmt = ([Func] funcs, [Bool] bang, [Str] params, Stmt s): Iarch -> {
	const Iarch sub = match s {
		Stmt.IfThen(_, s2) -> if stmt_calls_bang(funcs, bang, params, s2)
			then whyc_stmt(funcs, bang, params, s2)
			else -1,
		Stmt.IfElse(_, t, el) -> if stmt_calls_bang(funcs, bang, params, t)
			then whyc_stmt(funcs, bang, params, t)
			else if stmt_calls_bang(funcs, bang, params, el)
				then whyc_stmt(funcs, bang, params, el)
				else -1,
		Stmt.Block(ss) -> whyc_body(funcs, bang, params, ss),
		Stmt.Loop(ll_, ss) -> whyc_body(funcs, bang, params, ss),
		Stmt.ForIn(_, _, ss) -> whyc_body(funcs, bang, params, ss),
		Stmt.Match(_, arms) -> whyc_arms(funcs, bang, params, arms),
		Stmt.Defer(ss) -> whyc_body(funcs, bang, params, ss),
		Stmt.Closure(_, cps, _, cbody) ->
			whyc_body(funcs, bang, cat_s(params, plist_names(cps)), cbody),
		_ -> -1,
	}
	if sub >= 0 then return sub

	const Iarch own = whyc_list(funcs, bang, params, stmt_exprs(s))
	if own >= 0 then return own

	return stmt_off(s)
}

# A gate diagnostic anchored at `off` when it maps into `f`'s file, else at the declaration.
const gate_diag = ([SrcMap] maps, Func f, Iarch off, Str msg): Diag -> {
	if off >= 0 then {
		const LC lc = line_col_of(maps, f.dfile, off)
		if lc.line > 0
			then return Diag({ file: f.dfile, line: lc.line, col: lc.col, msg: msg, what: "" })
	}

	return Diag({ file: f.dfile, line: f.dline, col: f.dcol, msg: msg, what: "" })
}

# Validate the declared `!` marker against the computed color, both ways. `main` is exempt; an
# `asm`/intrinsic body trusts its own marker (it is not re-derived). Rejections are COLLECTED —
# the color is a per-fn classification already computed, so one run reports every mis-marked
# declaration instead of dying at the first (each used to cost a full rebuild cycle).
pub const check_alloc_program! = (Program prog, [SrcMap] maps): [Diag] -> {
	const [Func] funcs = prog.funcs
	const [Bool] bang = compute_bang!(prog)
	let [Diag] diags = []
	let Iarch j = 0

	loop {
		if j >= Iarch(funcs.len) then break
		if !funcs[j].is_asm && !is_main(funcs[j]) then {
			const Bool decl = is_bang_name(funcs[j].name)
			# a redundant marker's fix is at the declaration — the marker itself is the offender
			if decl && !bang[j]
				then diags = [
				...diags,
				Diag({
					file: funcs[j].dfile,
					line: funcs[j].dline,
					col: funcs[j].dcol,
					msg: "cf: alloc: `${funcs[j].name}` is marked `!` but allocates no residue — drop the marker\n",
					what: "",
				}),
			]
			# a missing marker anchors at the EVIDENCE: the first trapped construction, else the
			# first effectful call — the declaration stamp only when neither carries a span
			if !decl && bang[j] then {
				const [Str] params = param_names(funcs[j])
				const ACtx cx = ACtx({
					unions: prog.unions,
					params: params,
					esc: compute_esc(params, funcs[j].body),
				})
				let Iarch off = why_body!(cx, false, funcs[j].body)
				if off < 0 then off = whyc_body(funcs, bang, params, funcs[j].body)
				diags = [
					...diags,
					gate_diag(
						maps,
						funcs[j],
						off,
						"cf: alloc: `${funcs[j].name}` allocates residue (or calls a `!` function) but is not marked `!`\n",
					),
				]
			}
		}
		j = j + 1
	}

	return diags
}

# ── Root-allocation check (memory_model §2) ────────────────────────────────────────────────────
# `main` runs under the ROOT page, and the user cannot allocate there — a program must graft a
# geometry (an `in <geometry>` clause) before any residue is placed. The ambient node propagates
# down
# BARE calls (no `in`); an `in`-grafted call switches its subtree to the arena. So the set of
# functions that can run under the root is the closure of `main` over bare callees; if any of them
# holds trapped residue, that residue would land on the root — a compile error. An `in`-grafted
# call's ARGUMENTS still evaluate in the caller's ambient, so they keep propagating.
const bare_calls_expr = (Expr e): [Str] -> match unat(e) {
	Expr.Call(n, _, args, g) -> if eq(g, "")
		then cat_s(exl_one_s(n), bare_calls_list(args))
		else bare_calls_list(args),
	Expr.DeferTap(_, args) -> bare_calls_list(args),
	Expr.Loop(ss) -> bare_calls_body(ss),
	_ -> bare_calls_list(expr_children(e)),
}

const exl_one_s = (Str a): [Str] -> {
	let [Str] r = [a]

	return r
}

const bare_calls_list = ([Expr] es): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		r = cat_s(r, bare_calls_expr(es[i]))
		i = i + 1
	}

	return r
}

const bare_calls_arms = ([StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, bare_calls_body(arms[i].body))
		i = i + 1
	}

	return r
}

const bare_calls_stmt = (Stmt s): [Str] -> match s {
	Stmt.Return(e) -> bare_calls_expr(e),
	Stmt.Yield(e) -> bare_calls_expr(e),
	Stmt.Let(_, _, _, init) -> bare_calls_expr(init),
	Stmt.Assign(_, val) -> bare_calls_expr(val),
	Stmt.FieldAssign(_, _, val) -> bare_calls_expr(val),
	Stmt.DeepFieldAssign(be, _, val) -> cat_s(bare_calls_expr(be), bare_calls_expr(val)),
	Stmt.IndexAssign(_, idx, val) -> cat_s(bare_calls_expr(idx), bare_calls_expr(val)),
	Stmt.Do(e) -> bare_calls_expr(e),
	Stmt.IfThen(c, s2) -> cat_s(bare_calls_expr(c), bare_calls_stmt(s2)),
	Stmt.IfElse(c, t, el) -> cat_s(bare_calls_expr(c), cat_s(bare_calls_stmt(t), bare_calls_stmt(el))),
	Stmt.Block(ss) -> bare_calls_body(ss),
	Stmt.Loop(ll_, ss) -> bare_calls_body(ss),
	Stmt.ForIn(_, _, ss) -> bare_calls_body(ss),
	Stmt.Match(sc, arms) -> cat_s(bare_calls_expr(sc), bare_calls_arms(arms)),
	Stmt.Destructure(_, _, e) -> bare_calls_expr(e),
	Stmt.Defer(ss) -> bare_calls_body(ss),
	Stmt.Closure(_, _, _, cbody) -> bare_calls_body(cbody),
	_ -> no_strs(),
}

const bare_calls_body = ([Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, bare_calls_stmt(ss[i]))
		i = i + 1
	}

	return r
}

# The set of functions reachable from `main` through bare (non-`in`) calls — those that can run
# under the root page. Grown to a fixpoint over the whole program.
const root_ambient_set! = (Program prog): [Str] -> {
	const [Func] funcs = prog.funcs
	let [Str] r = exl_one_s("main")

	loop {
		let [Str] add = []
		let Iarch i = 0

		loop {
			if i >= Iarch(r.len) then break
			const Iarch fi = find_func(funcs, r[i])
			if fi >= 0 && !funcs[fi].is_asm then add = cat_s(add, bare_calls_body(funcs[fi].body))
			i = i + 1
		}

		const [Str] merged = union_names(r, add)
		if Iarch(merged.len) == Iarch(r.len) then break
		r = merged
	}

	return r
}

# Enforce the root-page rule (memory_model §2): reject a `!` function reached from `main` by BARE
# (non-`in`) calls — residue must run under a grafted geometry, never on the root page. In
# `zero_root` mode the root has no bytes, so it tightens to reject ANY page use: an arena graft or
# a root-ambient function that constructs residue on the page.
pub const check_root_program! = (Program prog, Bool zero_root, [SrcMap] maps): [Diag] -> {
	let [Diag] diags = []
	const [Func] funcs = prog.funcs
	const [Str] root = root_ambient_set!(prog)
	# ZERO-ROOT mode (`--root-size 0` on `Bare`): the root page has no bytes, so NO page use is legal.
	# An arena graft carves its header from the ambient node — bare (root-ambient) it draws on the
	# page. The root-ambient set already collects bare-called names, so a page-carving arena intrinsic
	# reached without an `in` clause shows up here by name. Reject it up front.
	if zero_root && (has_name(root, "of__fx") || has_name(root, "of__el"))
		then die("cf: zero-root: an arena grafts its header from the root page, but `--root-size 0` forbids all page use — drop the arena and allocate only in `$`-stack, `static`, or a `fixed_buffer`\n")
	let Iarch i = 0

	loop {
		if i >= Iarch(root.len) then break
		const Iarch fi = find_func(funcs, root[i])
		# ROOT does not propagate into `!` functions (memory_model §2): `main` (and any colorless
		# function) may allocate on the root page freely, but a `!` function — one that HOLDS residue —
		# must run under a geometry. So the violation is a `!` function reached from `main` by BARE
		# calls (the root-ambient set closes over bare calls only; an `in` clause leaves the set). `main`
		# is never `!`, so it is exempt and may open buffers/records directly on the root.
		if fi >= 0 && !funcs[fi].is_asm && is_bang_name(funcs[fi].name)
			then diags = [
			...diags,
			Diag({
				file: funcs[fi].dfile,
				line: funcs[fi].dline,
				col: funcs[fi].dcol,
				msg: "cf: root: `${funcs[fi].name}` is a `!` function reached without a geometry — call it `in <geometry>` (root does not propagate into `!` functions)\n",
				what: "",
			}),
		]
		# In zero-root there is no page to spill onto, so `main`'s own exemption is revoked too: ANY
		# root-ambient function that constructs a residue aggregate on the page is rejected. Legal
		# storage (`$`, `static`, `fixed_buffer` allocations run `in fb`) never lands here — the first
		# two aren't residue, and a `fixed_buffer` sink is reached `in fb`, off the root-ambient set.
		if zero_root && fi >= 0 && !funcs[fi].is_asm && local_residue!(prog.unions, funcs[fi]) then {
			const [Str] params = param_names(funcs[fi])
			const ACtx cx = ACtx({
				unions: prog.unions,
				params: params,
				esc: compute_esc(params, funcs[fi].body),
			})
			diags = [
				...diags,
				gate_diag(
					maps,
					funcs[fi],
					why_body!(cx, false, funcs[fi].body),
					"cf: zero-root: `${funcs[fi].name}` allocates residue on the root page, but `--root-size 0` forbids it — use `$`-stack, `static`, or a `fixed_buffer` instead\n",
				),
			]
		}
		i = i + 1
	}

	return diags
}
