# closures — lift local closures to top-level functions (memory_model §7), after typecheck.
#
# A `const f = (params) -> body` captures enclosing locals/parameters. C! closures are FAKE:
# there is no runtime closure object. This pass lowers each closure into an ordinary top-level
# function whose captures become trailing HIDDEN parameters, and rewrites the call sites to pass
# them. Capture is BY REFERENCE:
#   - a captured SCALAR (a word/Bool/fixed/float) is passed by its SLOT ADDRESS (`$capref`) — the
#     lifted body reads/writes THROUGH it, so a mutation is observed by the enclosing scope.
#   - a captured AGGREGATE (a record or `Str`) is passed by its POINTER (`$capagg`) — field writes
#     land in the shared arena record, observed by the enclosing scope.
# At each call site the capture argument is `&x` (`Expr.Addr`) — emit yields the binding's slot
# temp (the address for a scalar cell, the pointer for an aggregate), passed without a copy.
#
# v1 scope (typecheck enforces): a closure is `const`-bound, called directly, not nested in
# another closure, and not a first-class value. A captured local must be annotated (its type is
# read from the annotation / parameter). Runs AFTER typecheck (validated) and BEFORE emit.

import std::compiler::ast::{
	Expr,
	Stmt,
	MatchArm,
	StmtArm,
	Seg,
	FieldInit,
	TupElem,
	Param,
	RecDecl,
	UnionDecl,
	Func,
	Import,
	Program,
	with_geom,
}
import std::data::str::{ eq, starts_with }
import std::io::console::{ die }

const no_names = (): [Str] -> {
	let [Str] e = []

	return e
}

# Byte-wise Str equality.

const in_list = ([Str] xs, Str n): Bool -> {
	for x in xs if eq(x, n) then return true

	return false
}

const cat = ([Str] a, [Str] b): [Str] -> [...a, ...b]

const find_rec = ([RecDecl] recs, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(recs.len) then break
		if eq(recs[i].name, name) then return i
		i = i + 1
	}

	return -1
}

# --- referenced-name collection (a closure's free variables) -----------------------------
# Every bare name a body READS or WRITES — Var, a field/index/assign base, an `&` operand, a
# call callee, a `for ... in` array. A captured variable is one of these that names an enclosing
# binding (and is not the closure's own parameter/local). Over-collecting a top-level function
# name (a call callee) is harmless: it is not in the enclosing local scope, so it is filtered.
const uses_exprs! = ([Expr] es): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		out = cat(out, uses_expr!(es[i]))
		i = i + 1
	}

	return out
}

const uses_fieldinits! = ([FieldInit] fs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		out = cat(out, uses_expr!(fs[i].value))
		i = i + 1
	}

	return out
}

const uses_segs! = ([Seg] segs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		out = cat(out, uses_expr!(segs[i].expr))
		i = i + 1
	}

	return out
}

const uses_match_arms! = ([MatchArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		out = cat(out, uses_expr!(arms[i].body))
		i = i + 1
	}

	return out
}

const uses_stmt_arms! = ([StmtArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		out = cat(out, uses_stmts!(arms[i].body))
		i = i + 1
	}

	return out
}

const uses_stmts! = ([Stmt] ss): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = cat(out, uses_stmt!(ss[i]))
		i = i + 1
	}

	return out
}

const uses_expr! = (Expr e): [Str] -> match e {
	Expr.Lit(v) -> no_names(),
	Expr.BoolLit(b) -> no_names(),
	Expr.Var(n) -> [n],
	Expr.StrLit(bs) -> no_names(),
	Expr.FloatLit(t) -> no_names(),
	Expr.Record(n, fs) -> uses_fieldinits!(fs),
	Expr.Field(b, f) -> [b],
	Expr.FieldExpr(b, f) -> uses_expr!(b),
	Expr.UnionMk(t, m, args) -> uses_exprs!(args),
	Expr.Match(scrut, arms) -> cat(uses_expr!(scrut), uses_match_arms!(arms)),
	Expr.ArrayLit(hs, sn, elems, et) -> cat(uses_expr!(sn), uses_exprs!(elems)),
	Expr.Index(a, i) -> cat([a], uses_expr!(i)),
	Expr.IndexField(a, i, f) -> cat([a], uses_expr!(i)),
	Expr.IndexExpr(b, i) -> cat(uses_expr!(b), uses_expr!(i)),
	Expr.Interp(segs) -> uses_segs!(segs),
	Expr.Tuple(elems) -> uses_exprs!(elems),
	Expr.Spread(x) -> uses_expr!(x),
	Expr.Unit -> no_names(),
	Expr.Loop(body) -> uses_stmts!(body),
	Expr.Buffer(sz) -> uses_expr!(sz),
	Expr.Addr(name) -> [name],
	Expr.Neg(x) -> uses_expr!(x),
	Expr.Not(x) -> uses_expr!(x),
	Expr.BitNot(x) -> uses_expr!(x),
	Expr.Add(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.Sub(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.Mul(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.Div(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.Mod(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.BitAnd(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.BitOr(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.BitXor(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.Shl(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.Shr(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.CmpEq(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.CmpNe(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.CmpLt(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.CmpGt(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.CmpLe(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.CmpGe(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.And(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.Or(l, r) -> cat(uses_expr!(l), uses_expr!(r)),
	Expr.If(c, t, e2) -> cat(cat(uses_expr!(c), uses_expr!(t)), uses_expr!(e2)),
	Expr.Call(n, ta, args, _) -> cat([n], uses_exprs!(args)),
	Expr.DeferTap(fn, args) -> uses_exprs!(args),
}

const uses_stmt! = (Stmt s): [Str] -> match s {
	Stmt.Let(n, m, ann, e) -> uses_expr!(e),
	Stmt.Destructure(pat, m, e) -> uses_expr!(e),
	Stmt.Assign(n, e) -> cat([n], uses_expr!(e)),
	Stmt.FieldAssign(b, f, e) -> cat([b], uses_expr!(e)),
	Stmt.DeepFieldAssign(be, f, e) -> cat(uses_expr!(be), uses_expr!(e)),
	Stmt.IndexAssign(a, i, v) -> cat([a], cat(uses_expr!(i), uses_expr!(v))),
	Stmt.Return(e) -> uses_expr!(e),
	Stmt.ForIn(v, a, body) -> cat([a], uses_stmts!(body)),
	Stmt.Loop(ll_, body) -> uses_stmts!(body),
	Stmt.Break(bl_) -> no_names(),
	Stmt.Continue(bl_) -> no_names(),
	Stmt.IfThen(c, st) -> cat(uses_expr!(c), uses_stmt!(st)),
	Stmt.IfElse(c, t, e) -> cat(uses_expr!(c), cat(uses_stmt!(t), uses_stmt!(e))),
	Stmt.Do(e) -> uses_expr!(e),
	Stmt.Block(ss) -> uses_stmts!(ss),
	Stmt.Match(scrut, arms) -> cat(uses_expr!(scrut), uses_stmt_arms!(arms)),
	Stmt.Yield(e) -> uses_expr!(e),
	Stmt.Closure(nm, params, ret, body) -> uses_stmts!(body),
	Stmt.Defer(body) -> uses_stmts!(body),
}

# --- closure-local binders (names bound INSIDE the closure — not captures) ----------------
const param_names = ([Param] ps): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ps.len) then break
		out = [...out, ps[i].name]
		i = i + 1
	}

	return out
}

const binds_stmts! = ([Stmt] ss): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = cat(out, binds_stmt!(ss[i]))
		i = i + 1
	}

	return out
}

const binds_stmt! = (Stmt s): [Str] -> match s {
	Stmt.Let(n, m, ann, e) -> [n],
	Stmt.Destructure(pat, m, e) -> pat,
	Stmt.Assign(n, e) -> no_names(),
	Stmt.FieldAssign(b, f, e) -> no_names(),
	Stmt.DeepFieldAssign(be, f, e) -> no_names(),
	Stmt.IndexAssign(a, i, v) -> no_names(),
	Stmt.Return(e) -> no_names(),
	Stmt.ForIn(v, a, body) -> cat([v], binds_stmts!(body)),
	Stmt.Loop(ll_, body) -> binds_stmts!(body),
	Stmt.Break(bl_) -> no_names(),
	Stmt.Continue(bl_) -> no_names(),
	Stmt.IfThen(c, st) -> binds_stmt!(st),
	Stmt.IfElse(c, t, e) -> cat(binds_stmt!(t), binds_stmt!(e)),
	Stmt.Do(e) -> no_names(),
	Stmt.Block(ss) -> binds_stmts!(ss),
	Stmt.Match(scrut, arms) -> stmt_arms_binds!(arms),
	Stmt.Yield(e) -> no_names(),
	Stmt.Closure(nm, params, ret, body) -> [nm],
	Stmt.Defer(body) -> no_names(),
}

const stmt_arms_binds! = ([StmtArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		out = cat(cat(out, arms[i].binds), binds_stmts!(arms[i].body))
		i = i + 1
	}

	return out
}

# --- the enclosing scope (name -> declared type name) -------------------------------------
# Tracks each in-scope local/parameter's declared TYPE NAME so a capture's kind (scalar via
# `$capref`, aggregate via `$capagg`) and element type are known when the closure is lifted.
pub data ScopeVar = { Str name, Str tyname, Str elem }

const scope_find = ([ScopeVar] sc, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(sc.len) then break
		if eq(sc[i].name, name) then return i
		i = i + 1
	}

	return -1
}

# Record a `let`/`const` binding's type for later capture (a bare/array `let`, and a destructured
# binding — which cannot carry a type annotation — are recorded with an empty type that
# `capture_param` rejects cleanly if the closure actually captures them; a v1 limitation).
const add_scope_names = ([ScopeVar] sc, [Str] names): [ScopeVar] -> {
	let [ScopeVar] out = sc
	let Iarch i = 0

	loop {
		if i >= Iarch(names.len) then break
		out = [...out, ScopeVar({ name: names[i], tyname: "", elem: "" })]
		i = i + 1
	}

	return out
}

const extend_scope = ([ScopeVar] sc, Stmt s): [ScopeVar] -> match s {
	Stmt.Let(n, m, ann, e) -> [...sc, ScopeVar({ name: n, tyname: ann, elem: "" })],
	Stmt.ForIn(v, a, body) -> [...sc, ScopeVar({ name: v, tyname: "Iarch", elem: "" })],
	Stmt.Destructure(pat, m, e) -> add_scope_names(sc, pat),
	_ -> sc,
}

# --- call-site rewrite (append capture arguments) -----------------------------------------
# A record mapping a closure NAME to its lifted function name and the ordered capture ARGUMENTS
# to append at each call site: a scalar as `&x` (its slot address, `$capref`), an aggregate as
# `x` (its pointer value, `$capagg`) — matching how the lifted parameter is bound.
pub data CloRef = { Str name, Str lifted, [Expr] capargs }

const clo_find = ([CloRef] m, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(m.len) then break
		if eq(m[i].name, name) then return i
		i = i + 1
	}

	return -1
}

# The rewrite context threaded through the lift: the in-scope closure map, the whole-program
# function table (so a capturing closure passed to a higher-order function can be handled by
# INLINING the HOF at the call site — see `rw_call`), and the current INLINE depth (a recursive HOF
# passed a capturing closure would inline forever — the depth bounds it to a clean diagnostic).
data RwCtx = { [CloRef] clos, [Func] fns, Iarch depth }

const rwctx0 = ([CloRef] clos, [Func] fns): RwCtx -> RwCtx({ clos: clos, fns: fns, depth: 0 })

const find_func = ([Func] fns, Str name): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(fns.len) then break
		if eq(fns[i].name, name) then return i
		i = i + 1
	}

	return -1
}

# The capture argument for a call site: the captured variable by NAME. Emit resolves it to a
# slot address (a scalar `$capref`) or a pointer (an aggregate `$capagg`) by the lifted
# parameter's kind, so the same `Var` serves both.
const cap_arg_expr = (ScopeVar sv): Expr -> Expr.Var(sv.name)

const rw_exprs = ([Expr] es, RwCtx m): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		out = [...out, rw_expr(es[i], m)]
		i = i + 1
	}

	return out
}

const rw_fieldinits = ([FieldInit] fs, RwCtx m): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: rw_expr(fs[i].value, m) })]
		i = i + 1
	}

	return out
}

const rw_segs = ([Seg] segs, RwCtx m): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		const Seg g = segs[i]
		out = [...out, Seg({ is_hole: g.is_hole, lit: g.lit, name: g.name, expr: rw_expr(g.expr, m) })]
		i = i + 1
	}

	return out
}

const rw_match_arms = ([MatchArm] arms, RwCtx m): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [
			...out,
			MatchArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: rw_expr(a.body, m),
			}),
		]
		i = i + 1
	}

	return out
}

const rw_stmt_arms = ([StmtArm] arms, RwCtx m): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [
			...out,
			StmtArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: rw_stmts(a.body, m),
			}),
		]
		i = i + 1
	}

	return out
}

const rw_stmts = ([Stmt] ss, RwCtx m): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		out = [...out, rw_stmt(ss[i], m)]
		i = i + 1
	}

	return out
}

const rw_expr = (Expr e, RwCtx m): Expr -> match e {
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	# a bare reference to a CAPTURE-FREE closure (used as a function VALUE, e.g. passed to a HOF) is
	# its lifted top-level function — a plain code pointer, like a top-level function name. A
	# capturing closure has no bare code address (its captures must be threaded); one reaching here
	# as a value is left for the specialization pass / rejected downstream.
	Expr.Var(n) -> rw_var(n, m),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(n, rw_fieldinits(fs, m)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(rw_expr(b, m), f),
	Expr.UnionMk(t, mm, args) -> Expr.UnionMk(t, mm, rw_exprs(args, m)),
	Expr.Match(scrut, arms) -> Expr.Match(rw_expr(scrut, m), rw_match_arms(arms, m)),
	Expr.ArrayLit(hs, sn, elems, et) -> Expr.ArrayLit(hs, rw_expr(sn, m), rw_exprs(elems, m), et),
	Expr.Index(a, i) -> Expr.Index(a, rw_expr(i, m)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, rw_expr(i, m), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(rw_expr(b, m), rw_expr(i, m)),
	Expr.Interp(segs) -> Expr.Interp(rw_segs(segs, m)),
	Expr.Tuple(elems) -> Expr.Tuple(rw_exprs(elems, m)),
	Expr.Spread(x) -> Expr.Spread(rw_expr(x, m)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(rw_stmts(body, m)),
	Expr.Buffer(sz) -> Expr.Buffer(rw_expr(sz, m)),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(rw_expr(x, m)),
	Expr.Not(x) -> Expr.Not(rw_expr(x, m)),
	Expr.BitNot(x) -> Expr.BitNot(rw_expr(x, m)),
	Expr.Add(l, r) -> Expr.Add(rw_expr(l, m), rw_expr(r, m)),
	Expr.Sub(l, r) -> Expr.Sub(rw_expr(l, m), rw_expr(r, m)),
	Expr.Mul(l, r) -> Expr.Mul(rw_expr(l, m), rw_expr(r, m)),
	Expr.Div(l, r) -> Expr.Div(rw_expr(l, m), rw_expr(r, m)),
	Expr.Mod(l, r) -> Expr.Mod(rw_expr(l, m), rw_expr(r, m)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(rw_expr(l, m), rw_expr(r, m)),
	Expr.BitOr(l, r) -> Expr.BitOr(rw_expr(l, m), rw_expr(r, m)),
	Expr.BitXor(l, r) -> Expr.BitXor(rw_expr(l, m), rw_expr(r, m)),
	Expr.Shl(l, r) -> Expr.Shl(rw_expr(l, m), rw_expr(r, m)),
	Expr.Shr(l, r) -> Expr.Shr(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(rw_expr(l, m), rw_expr(r, m)),
	Expr.And(l, r) -> Expr.And(rw_expr(l, m), rw_expr(r, m)),
	Expr.Or(l, r) -> Expr.Or(rw_expr(l, m), rw_expr(r, m)),
	Expr.If(c, t, e2) -> Expr.If(rw_expr(c, m), rw_expr(t, m), rw_expr(e2, m)),
	Expr.Call(n, ta, args, g) -> with_geom(rw_call(n, ta, rw_exprs(args, m), m), g),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(fn, rw_exprs(args, m)),
}

# A bare closure reference used as a value: a capture-free closure becomes its lifted function name
# (a code pointer); any other name is unchanged.
const rw_var = (Str n, RwCtx m): Expr -> {
	const Iarch ci = clo_find(m.clos, n)
	if ci < 0 then return Expr.Var(n)
	if Iarch(m.clos[ci].capargs.len) == 0 then return Expr.Var(m.clos[ci].lifted)

	return Expr.Var(n)
}

# --- inlining a HOF called with a capturing closure (the fake-closure model) ---------------------
# A capturing closure has no bare code address, so it cannot ride an ordinary function-value
# parameter. Instead, at each call `hof(clo, ...)` the HOF is INLINED: its single-expression body is
# substituted (the function parameter → the closure, the value parameters → the call arguments) and
# re-rewritten, so `f(x)` becomes a direct call to the closure's lifted body with its captures
# threaded. Inlining recurses, so a closure passed through a chain of HOFs (`relay -> apply`) still
# reduces to a direct call.
pub data Subst = { Str param, Expr repl }

const subst_find = ([Subst] su, Str n): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(su.len) then break
		if eq(su[i].param, n) then return i
		i = i + 1
	}

	return -1
}

const repl_name = (Expr e): Str -> match e { Expr.Var(n) -> n, _ -> "" }

const subst_var = (Str n, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, n)
	if si < 0 then return Expr.Var(n)

	return su[si].repl
}

const arg_var_name = (Expr e): Str -> match e { Expr.Var(n) -> n, _ -> "" }

const subst_exprs = ([Expr] es, [Subst] su): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		out = [...out, subst_expr(es[i], su)]
		i = i + 1
	}

	return out
}

# Replace a call's CALLEE too, when it names a substituted function parameter (`f(x)` with `f` bound
# to a closure → `clo(x)`, later redirected to the lifted body). The arguments are already substituted.
const subst_call = (Str c, [Str] ta, [Expr] sargs, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, c)
	if si < 0 then return Expr.Call(c, ta, sargs, "")
	const Str rn = repl_name(su[si].repl)
	if eq(rn, "") then return Expr.Call(c, ta, sargs, "")

	return Expr.Call(rn, ta, sargs, "")
}

# Substitute a bare-name BASE (a `p.f` field, a `p[i]` index, an `&p` address on a parameter name):
# a parameter substituted by a `Var(name)` keeps the name-based form; one substituted by a compound
# expression is rebuilt with the expression-based form (`FieldExpr`/`IndexExpr`).
const subst_field = (Str b, Str f, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, b)
	if si < 0 then return Expr.Field(b, f)
	const Str rn = repl_name(su[si].repl)
	if !eq(rn, "") then return Expr.Field(rn, f)

	return Expr.FieldExpr(su[si].repl, f)
}

const subst_index = (Str a, Expr i, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, a)
	if si < 0 then return Expr.Index(a, subst_expr(i, su))
	const Str rn = repl_name(su[si].repl)
	if !eq(rn, "") then return Expr.Index(rn, subst_expr(i, su))

	return Expr.IndexExpr(su[si].repl, subst_expr(i, su))
}

const subst_indexfield = (Str a, Expr i, Str f, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, a)
	if si < 0 then return Expr.IndexField(a, subst_expr(i, su), f)
	const Str rn = repl_name(su[si].repl)
	if !eq(rn, "") then return Expr.IndexField(rn, subst_expr(i, su), f)

	return Expr.FieldExpr(Expr.IndexExpr(su[si].repl, subst_expr(i, su)), f)
}

const subst_addr = (Str name, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, name)
	if si < 0 then return Expr.Addr(name)
	const Str rn = repl_name(su[si].repl)
	if eq(rn, "")
		then die("cf: closure: cannot take the address of a non-name argument in an inlined HOF (v1)\n")

	return Expr.Addr(rn)
}

const subst_fieldinits = ([FieldInit] fs, [Subst] su): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: subst_expr(fs[i].value, su) })]
		i = i + 1
	}

	return out
}

const subst_match_arms = ([MatchArm] arms, [Subst] su): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [
			...out,
			MatchArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: subst_expr(a.body, su),
			}),
		]
		i = i + 1
	}

	return out
}

const subst_segs = ([Seg] segs, [Subst] su): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		const Seg g = segs[i]
		out = [
			...out,
			Seg({ is_hole: g.is_hole, lit: g.lit, name: g.name, expr: subst_expr(g.expr, su) }),
		]
		i = i + 1
	}

	return out
}

# Apply a substitution `su` (HOF parameter → call argument) throughout an expression, rebuilding
# a call, field, index, or address whose name is a substituted parameter into its expression-based
# form (`subst_call`/`subst_field`/…). The recursive core of HOF inlining.
pub const subst_expr = (Expr e, [Subst] su): Expr -> match e {
	Expr.Var(n) -> subst_var(n, su),
	Expr.Call(c, ta, args, g) -> with_geom(subst_call(c, ta, subst_exprs(args, su), su), g),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(fn, subst_exprs(args, su)),
	Expr.Field(b, f) -> subst_field(b, f, su),
	Expr.Index(a, i) -> subst_index(a, i, su),
	Expr.IndexField(a, i, f) -> subst_indexfield(a, i, f, su),
	Expr.Addr(name) -> subst_addr(name, su),
	Expr.Record(n, fs) -> Expr.Record(n, subst_fieldinits(fs, su)),
	Expr.Match(scrut, arms) -> Expr.Match(subst_expr(scrut, su), subst_match_arms(arms, su)),
	Expr.Interp(segs) -> Expr.Interp(subst_segs(segs, su)),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(subst_expr(b, su), f),
	Expr.UnionMk(t, mm, args) -> Expr.UnionMk(t, mm, subst_exprs(args, su)),
	Expr.ArrayLit(hs, sn, elems, et) ->
		Expr.ArrayLit(hs, subst_expr(sn, su), subst_exprs(elems, su), et),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(subst_expr(b, su), subst_expr(i, su)),
	Expr.Tuple(elems) -> Expr.Tuple(subst_exprs(elems, su)),
	Expr.Spread(x) -> Expr.Spread(subst_expr(x, su)),
	Expr.Buffer(sz) -> Expr.Buffer(subst_expr(sz, su)),
	Expr.Neg(x) -> Expr.Neg(subst_expr(x, su)),
	Expr.Not(x) -> Expr.Not(subst_expr(x, su)),
	Expr.BitNot(x) -> Expr.BitNot(subst_expr(x, su)),
	Expr.Add(l, r) -> Expr.Add(subst_expr(l, su), subst_expr(r, su)),
	Expr.Sub(l, r) -> Expr.Sub(subst_expr(l, su), subst_expr(r, su)),
	Expr.Mul(l, r) -> Expr.Mul(subst_expr(l, su), subst_expr(r, su)),
	Expr.Div(l, r) -> Expr.Div(subst_expr(l, su), subst_expr(r, su)),
	Expr.Mod(l, r) -> Expr.Mod(subst_expr(l, su), subst_expr(r, su)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(subst_expr(l, su), subst_expr(r, su)),
	Expr.BitOr(l, r) -> Expr.BitOr(subst_expr(l, su), subst_expr(r, su)),
	Expr.BitXor(l, r) -> Expr.BitXor(subst_expr(l, su), subst_expr(r, su)),
	Expr.Shl(l, r) -> Expr.Shl(subst_expr(l, su), subst_expr(r, su)),
	Expr.Shr(l, r) -> Expr.Shr(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(subst_expr(l, su), subst_expr(r, su)),
	Expr.And(l, r) -> Expr.And(subst_expr(l, su), subst_expr(r, su)),
	Expr.Or(l, r) -> Expr.Or(subst_expr(l, su), subst_expr(r, su)),
	Expr.If(c, t, e2) -> Expr.If(subst_expr(c, su), subst_expr(t, su), subst_expr(e2, su)),
	_ -> e,
}

# The position of the HOF's function parameter that is receiving a CAPTURING closure at this call
# (or -1). A capture-free closure has been lowered to a code pointer already, so it is not matched.
const capturing_clo_arg = (Func hof, [Expr] args, [CloRef] clos): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(hof.params.len) then break
		if i < Iarch(args.len) then {
			if eq(hof.params[i].type_name, "$fn") then {
				const Iarch ci = clo_find(clos, arg_var_name(args[i]))
				if ci >= 0 then {
					if Iarch(clos[ci].capargs.len) > 0 then return i
				}
			}
		}
		i = i + 1
	}

	return -1
}

const return_expr = (Stmt s): Expr -> match s { Stmt.Return(e) -> e, _ -> Expr.Unit }

# A substitution-safe argument — one that inlining may duplicate (a repeated parameter) without
# changing meaning: a literal or a bare name (no side effect, same value each read).
const is_simple_arg = (Expr e): Bool -> match e {
	Expr.Lit(v) -> true,
	Expr.BoolLit(b) -> true,
	Expr.FloatLit(t) -> true,
	Expr.StrLit(bs) -> true,
	Expr.Var(n) -> true,
	_ -> false,
}

const count_name = ([Str] names, Str n): Iarch -> {
	let Iarch c = 0
	let Iarch i = 0

	loop {
		if i >= Iarch(names.len) then break
		if eq(names[i], n) then c = c + 1
		i = i + 1
	}

	return c
}

# The name of a HOF's clone specialized for one capturing closure: the fn parameter at `cp` is
# gone, the closure's captures ride as appended hidden parameters. The `$` never appears in a
# source name, so the scheme cannot collide; `specialize_hofs!` parses it back apart.
# A materialized HOF's geometry tag is RE-APPENDED at the very end - emit reads the ambient
# geometry off a name's suffix, and buried mid-name it would go unseen (the clone's allocations
# would fall to the retired floor).
const spec_name = (Str hof, Iarch cp, Str lifted): Str -> {
	const Str tag = enclosing_tag(hof)

	if eq(tag, "") then return "${hof}\$w${cp}\$${lifted}"

	return "${hof}\$w${cp}\$${lifted}__${tag}"
}

# A call to a closure name is redirected to its lifted function (captures appended); a HOF called
# with a capturing closure is RETARGETED to a specialized clone (built after the lift by
# `specialize_hofs!` — the fn argument is dropped and the closure's capture arguments appended);
# every other call is unchanged (its arguments already rewritten).
const rw_call = (Str n, [Str] ta, [Expr] args, RwCtx m): Expr -> {
	const Iarch ci = clo_find(m.clos, n)
	if ci >= 0 then {
		let [Expr] all = args
		const [Expr] caps = m.clos[ci].capargs

		for c in caps all = [...all, c]

		return Expr.Call(m.clos[ci].lifted, ta, all, "")
	}
	const Iarch fi = find_func(m.fns, n)
	if fi >= 0 then {
		const Iarch cp = capturing_clo_arg(m.fns[fi], args, m.clos)

		if cp >= 0 then {
			# retarget through EVERY capturing-closure argument, layering the spec name — each
			# round drops one closure arg and appends its captures; the clones build inner-first
			# (`ensure_spec`), so `hof$w0$clo1$w0$clo2` composes
			let Str callee = n
			let [Expr] cur = args

			loop {
				const Iarch ai = first_capturing(cur, m.clos)
				if ai < 0 then break
				const Iarch ci2 = clo_find(m.clos, arg_var_name(cur[ai]))
				const CloRef cr = m.clos[ci2]
				let [Expr] next = []

				for (a, aj) in cur if aj != ai then next = [...next, a]

				for c in cr.capargs next = [...next, c]

				callee = spec_name(callee, ai, cr.lifted)
				cur = next
			}

			return Expr.Call(callee, ta, cur, "")
		}
	}

	return Expr.Call(n, ta, args, "")
}

# The first argument position holding a capturing-closure reference, or -1.
const first_capturing = ([Expr] args, [CloRef] clos): Iarch -> {
	for (a, ai) in args {
		const Iarch ci = clo_find(clos, arg_var_name(a))
		if ci >= 0 then {
			if Iarch(clos[ci].capargs.len) > 0 then return ai
		}
	}

	return -1
}

const rw_stmt = (Stmt s, RwCtx m): Stmt -> match s {
	Stmt.Let(n, mut, ann, e) -> Stmt.Let(n, mut, ann, rw_expr(e, m)),
	Stmt.Destructure(pat, mut, e) -> Stmt.Destructure(pat, mut, rw_expr(e, m)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, rw_expr(e, m)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, rw_expr(e, m)),
	Stmt.DeepFieldAssign(be, f, e) -> Stmt.DeepFieldAssign(rw_expr(be, m), f, rw_expr(e, m)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, rw_expr(i, m), rw_expr(v, m)),
	Stmt.Return(e) -> Stmt.Return(rw_expr(e, m)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, rw_stmts(body, m)),
	Stmt.Loop(ll_, body) -> Stmt.Loop(ll_, rw_stmts(body, m)),
	Stmt.Break(bl_) -> Stmt.Break(bl_),
	Stmt.Continue(bl_) -> Stmt.Continue(bl_),
	Stmt.IfThen(c, st) -> Stmt.IfThen(rw_expr(c, m), rw_stmt(st, m)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(rw_expr(c, m), rw_stmt(t, m), rw_stmt(e, m)),
	Stmt.Do(e) -> Stmt.Do(rw_expr(e, m)),
	Stmt.Block(ss) -> Stmt.Block(rw_stmts(ss, m)),
	Stmt.Match(scrut, arms) -> Stmt.Match(rw_expr(scrut, m), rw_stmt_arms(arms, m)),
	Stmt.Yield(e) -> Stmt.Yield(rw_expr(e, m)),
	Stmt.Closure(nm, params, ret, body) -> Stmt.Closure(nm, params, ret, rw_stmts(body, m)),
	Stmt.Defer(body) -> Stmt.Defer(rw_stmts(body, m)),
}

# --- capture parameter construction -------------------------------------------------------
# The hidden parameter for a captured variable, by its declared type: a record or `Str` rides
# by pointer (`$capagg`, `elem` = the type name); every other scalar (word/Bool/fixed/float)
# rides by slot address (`$capref`, `elem` = the type name). An unannotated or array/tuple
# capture is unsupported in v1.
const capture_param = ([RecDecl] recs, ScopeVar sv): Param -> {
	if eq(sv.tyname, "")
		then die("cf: closure: a captured local must be annotated with its type\n")
	if find_rec(recs, sv.tyname) >= 0
		then return Param({
		name: sv.name,
		is_ptr: false,
		type_name: "$capagg",
		elem: sv.tyname,
		telems: [],
		size: 0,
	})
	if eq(sv.tyname, "Str")
		then return Param({
		name: sv.name,
		is_ptr: false,
		type_name: "$capagg",
		elem: sv.tyname,
		telems: [],
		size: 0,
	})
	if eq(sv.tyname, "$dyn") then die("cf: closure: capturing an array is not supported yet\n")
	if eq(sv.tyname, "$tuple") then die("cf: closure: capturing a tuple is not supported yet\n")
	if eq(sv.tyname, "$ptr") then die("cf: closure: capturing a pointer is not supported yet\n")

	return Param({
		name: sv.name,
		is_ptr: false,
		type_name: "$capref",
		elem: sv.tyname,
		telems: [],
		size: 0,
	})
}

# --- per-function lifting -----------------------------------------------------------------
# The captured variables of a closure body, in enclosing-scope order: an in-scope local/parameter
# that the body references and the closure does not itself bind.
const compute_captures! = ([RecDecl] recs, [Stmt] body, [Param] params, [ScopeVar] scope): [ScopeVar] -> {
	const [Str] used = uses_stmts!(body)
	const [Str] local = cat(param_names(params), binds_stmts!(body))
	let [ScopeVar] caps = []
	let Iarch i = 0

	loop {
		if i >= Iarch(scope.len) then break
		const ScopeVar sv = scope[i]
		if in_list(used, sv.name) then {
			if !in_list(local, sv.name) then caps = [...caps, sv]
		}
		i = i + 1
	}

	return caps
}

# The geometry tag a materialized function name ends in (`run!__el` → "el"), or "" for a legacy
# body. A closure lifted out of a materialized body inherits this — it runs under the same ambient
# (the enclosing body threads it the node), so its own allocations must lower through that
# geometry's reserve, not the `cf_alloc` floor. Emit reads the tag back off the lifted name.
const enclosing_tag = (Str n): Str -> {
	const Iarch l = Iarch(n.len)
	if l < 4 then return ""
	if Iarch(n[l - 4]) != 95 || Iarch(n[l - 3]) != 95 then return ""
	const Iarch a = Iarch(n[l - 2])
	const Iarch b = Iarch(n[l - 1])
	if a == 101 && b == 108 then return "el"
	if a == 102 && b == 120 then return "fx"
	if a == 102 && b == 98 then return "fb"
	if a == 112 && b == 103 then return "pg"

	return ""
}

# One lifted function name per closure — unique across the program via the enclosing function
# index and the closure's ordinal within it. A closure lifted from a materialized body carries
# the enclosing geometry tag (`__clo_7_0__el`) so emit lowers its allocations through that reserve.
const lifted_name = (Iarch fi, Iarch ci, Str tag): Str -> if eq(tag, "")
	then "__clo_${fi}_${ci}"
	else "__clo_${fi}_${ci}__${tag}"

# Result of lifting one function's body: the rewritten body (closures removed, calls redirected)
# and the list of lifted top-level functions it produced.
pub data Lifted = { [Stmt] body, [Func] funcs }

const lift_func! = (Func fn, Iarch fi, [RecDecl] recs, [Func] fns): Lifted -> {
	let [ScopeVar] scope = []
	let Iarch p = 0

	loop {
		if p >= Iarch(fn.params.len) then break
		scope = [
			...scope,
			ScopeVar({ name: fn.params[p].name, tyname: fn.params[p].type_name, elem: fn.params[p].elem }),
		]
		p = p + 1
	}

	let [CloRef] cmap = []
	let [Func] lifted = []
	let [Stmt] out = []
	let Iarch ci = 0
	let Iarch i = 0

	loop {
		if i >= Iarch(fn.body.len) then break
		const Stmt s = fn.body[i]

		match s {
			Stmt.Closure(nm, params, ret, body) -> {
				const [ScopeVar] caps = compute_captures!(recs, body, params, scope)
				# a FRESH copy, element by element — `let lparams = params` would alias the
				# closure stmt's own array and the appends below would grow the SHARED storage
				# in place, smashing whatever neighbors it in the arena ([[cf0-array-aliasing]])
				let [Param] lparams = []
				let Iarch lpc = 0

				loop {
					if lpc >= Iarch(params.len) then break
					lparams = [...lparams, params[lpc]]
					lpc = lpc + 1
				}

				let [Expr] capargs = []
				let Iarch c = 0

				loop {
					if c >= Iarch(caps.len) then break
					lparams = [...lparams, capture_param(recs, caps[c])]
					capargs = [...capargs, cap_arg_expr(caps[c])]
					c = c + 1
				}

				const Str ln = lifted_name(fi, ci, enclosing_tag(fn.name))
				# the closure's calls (later in this body) are redirected before its own body is
				# rewritten, so a captured closure that itself calls another already-lifted closure
				# still resolves
				const [Stmt] lbody = rw_stmts(body, rwctx0(cmap, fns))
				const [Seg] noasm = []
				const [Str] no_tp = []
				const [TupElem] no_tel = []
				lifted = [
					...lifted,
					Func({
						name: ln,
						is_pub: false,
						ret_name: ret,
						ret_elem: "",
						params: lparams,
						body: lbody,
						is_asm: false,
						asm_body: noasm,
						is_value: false,
						ret_telems: no_tel,
						typarams: no_tp,
						tbounds: no_tp,
						ret_size: 0,
						is_intrinsic: false,
						asm_sym: "",
						dfile: fn.dfile,
						dline: fn.dline,
						dcol: fn.dcol,
					}),
				]
				cmap = [...cmap, CloRef({ name: nm, lifted: ln, capargs: capargs })]
				ci = ci + 1
			},
			_ -> {
				out = [...out, rw_stmt(s, rwctx0(cmap, fns))]
				scope = extend_scope(scope, s)
			},
		}

		i = i + 1
	}

	return Lifted({ body: out, funcs: lifted })
}

# --- specializing HOFs for capturing closures ----------------------------------------------
# `rw_call` retargeted each `hof(clo, ...)` to a `hof$w<cp>$<lifted>` name; this stage BUILDS
# those clones. A clone is the HOF minus its fn parameter, plus the closure's capture parameters
# (renamed `$sp<i>`); calls through the removed parameter become direct calls to the lifted
# closure with the captures threaded, and the parameter FORWARDED to a further HOF retargets that
# callee's spec name in turn — the worklist then builds it, and the name-keyed dedup terminates
# chains and recursion.

# Does `n` carry a `$w<digits>$` spec marker?
const has_spec_marker = (Str n): Bool -> spec_marker_at(n) >= 0

# The byte index of the LAST `$w<digits>$` marker in `n`, or -1. The last one is the OUTERMOST
# pending layer (`apply$w0$__clo_1_0` splits at 5), and a lifted-closure suffix never contains `$`.
const spec_marker_at = (Str n): Iarch -> {
	let Iarch found = -1
	let Iarch i = 0

	loop {
		if i + 2 >= Iarch(n.len) then break

		if Iarch(n[i]) == 36 && Iarch(n[i + 1]) == 119 then {
			let Iarch j = i + 2
			let Bool digits = false

			loop {
				if j >= Iarch(n.len) then break
				const Iarch c = Iarch(n[j])
				if c == 36 then break
				if c < 48 || c > 57 then {
					digits = false
					j = -1
				} else digits = true
				if j < 0 then break
				j = j + 1
			}

			if digits && j > 0 && j < Iarch(n.len) then found = i
		}

		i = i + 1
	}

	return found
}

# One parsed spec request: the HOF to clone, the fn-parameter position to remove, the lifted
# closure to wire in.
data SpecReq = { Str hof, Iarch cp, Str clo }

const parse_spec = (Str n): SpecReq -> {
	const Iarch at = spec_marker_at(n)
	let [Uint8] hb = []
	let Iarch i = 0

	loop {
		if i >= at then break
		hb = [...hb, n[i]]
		i = i + 1
	}

	let Iarch cp = 0
	let Iarch j = at + 2

	loop {
		const Iarch c = Iarch(n[j])
		if c == 36 then break
		cp = cp * 10 + (c - 48)
		j = j + 1
	}

	const Str hofn = Str({ bytes: hb, len: Iarch(hb.len) })
	# a re-appended geometry tag on the clone name is NOT part of the closure name - strip it
	let Iarch stop = Iarch(n.len)
	if !eq(enclosing_tag(hofn), "") then stop = stop - 4
	let [Uint8] cb = []
	let Iarch k = j + 1

	loop {
		if k >= stop then break
		cb = [...cb, n[k]]
		k = k + 1
	}

	return SpecReq({
		hof: hofn,
		cp: cp,
		clo: Str({ bytes: cb, len: Iarch(cb.len) }),
	})
}

# --- collecting unbuilt spec callees --------------------------------------------------------
const mn_exprs = ([Expr] es): [Str] -> {
	let [Str] out = []

	for e in es out = [...out, ...mn_expr(e)]

	return out
}

const mn_segs = ([Seg] segs): [Str] -> {
	let [Str] out = []

	for s in segs if s.is_hole then out = [...out, ...mn_expr(s.expr)]

	return out
}

const mn_arms = ([MatchArm] arms): [Str] -> {
	let [Str] out = []

	for a in arms out = [...out, ...mn_expr(a.body)]

	return out
}

const mn_stmt_arms = ([StmtArm] arms): [Str] -> {
	let [Str] out = []

	for a in arms out = [...out, ...mn_stmts(a.body)]

	return out
}

# Every call-target NAME in the expression (recursively) that carries a spec marker.
const mn_expr = (Expr e): [Str] -> match e {
	Expr.Call(n, ta, args, g) -> if has_spec_marker(n)
		then [...mn_exprs(args), n]
		else mn_exprs(args),
	Expr.DeferTap(fn, args) -> mn_exprs(args),
	Expr.Match(scrut, arms) -> [...mn_expr(scrut), ...mn_arms(arms)],
	Expr.ArrayLit(hs, sn, elems, et) -> [...mn_expr(sn), ...mn_exprs(elems)],
	Expr.Record(n2, fs) -> mn_fieldinits(fs),
	Expr.FieldExpr(b, f) -> mn_expr(b),
	Expr.UnionMk(t, mm, args) -> mn_exprs(args),
	Expr.Index(a, i) -> mn_expr(i),
	Expr.IndexField(a, i, f) -> mn_expr(i),
	Expr.IndexExpr(b, i) -> [...mn_expr(b), ...mn_expr(i)],
	Expr.Interp(segs) -> mn_segs(segs),
	Expr.Tuple(elems) -> mn_exprs(elems),
	Expr.Spread(x) -> mn_expr(x),
	Expr.Loop(body) -> mn_stmts(body),
	Expr.Buffer(sz) -> mn_expr(sz),
	Expr.Neg(x) -> mn_expr(x),
	Expr.Not(x) -> mn_expr(x),
	Expr.BitNot(x) -> mn_expr(x),
	Expr.Add(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.Sub(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.Mul(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.Div(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.Mod(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.BitAnd(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.BitOr(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.BitXor(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.Shl(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.Shr(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.CmpEq(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.CmpNe(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.CmpLt(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.CmpGt(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.CmpLe(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.CmpGe(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.And(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.Or(l, r) -> [...mn_expr(l), ...mn_expr(r)],
	Expr.If(c, t, e2) -> [...mn_expr(c), ...mn_expr(t), ...mn_expr(e2)],
	_ -> no_names(),
}

const mn_fieldinits = ([FieldInit] fs): [Str] -> {
	let [Str] out = []

	for f in fs out = [...out, ...mn_expr(f.value)]

	return out
}

const mn_stmt = (Stmt s): [Str] -> match s {
	Stmt.Let(n, m, ann, e) -> mn_expr(e),
	Stmt.Destructure(pat, m, e) -> mn_expr(e),
	Stmt.Assign(n, e) -> mn_expr(e),
	Stmt.FieldAssign(b, f, e) -> mn_expr(e),
	Stmt.DeepFieldAssign(be, f, e) -> [...mn_expr(be), ...mn_expr(e)],
	Stmt.IndexAssign(a, i, v) -> [...mn_expr(i), ...mn_expr(v)],
	Stmt.Return(e) -> mn_expr(e),
	Stmt.ForIn(v, a, body) -> mn_stmts(body),
	Stmt.Loop(ll_, body) -> mn_stmts(body),
	Stmt.IfThen(c, st) -> [...mn_expr(c), ...mn_stmt(st)],
	Stmt.IfElse(c, t, e) -> [...mn_expr(c), ...mn_stmt(t), ...mn_stmt(e)],
	Stmt.Do(e) -> mn_expr(e),
	Stmt.Block(ss) -> mn_stmts(ss),
	Stmt.Match(scrut, arms) -> [...mn_expr(scrut), ...mn_stmt_arms(arms)],
	Stmt.Yield(e) -> mn_expr(e),
	Stmt.Closure(nm, params, ret, body) -> mn_stmts(body),
	Stmt.Defer(body) -> mn_stmts(body),
	_ -> no_names(),
}

const mn_stmts = ([Stmt] ss): [Str] -> {
	let [Str] out = []

	for s in ss out = [...out, ...mn_stmt(s)]

	return out
}

# Every spec name called anywhere in the program that has no function yet, deduped.
const missing_specs = ([Func] funcs): [Str] -> {
	let [Str] out = []

	for f in funcs {
		for nm in mn_stmts(f.body) {
			if find_func(funcs, nm) < 0 then {
				if !in_list(out, nm) then out = [...out, nm]
			}
		}
	}

	return out
}

# --- building one specialized clone ---------------------------------------------------------
# The rewrite context: the removed fn parameter's NAME, the lifted closure to call instead, and
# the clone's capture-parameter names to thread along.
data SpCtx = { Str fp, Str clo, [Str] caps }

const sp_cap_vars = (SpCtx c): [Expr] -> {
	let [Expr] out = []

	for n in c.caps out = [...out, Expr.Var(n)]

	return out
}

const sp_exprs! = ([Expr] es, SpCtx c): [Expr] -> {
	let [Expr] out = []

	for e in es out = [...out, sp_expr!(e, c)]

	return out
}

const sp_segs! = ([Seg] segs, SpCtx c): [Seg] -> {
	let [Seg] out = []

	for s in segs {
		if s.is_hole
			then out = [...out, Seg({ is_hole: true, lit: s.lit, name: s.name, expr: sp_expr!(s.expr, c) })]
			else out = [...out, s]
	}

	return out
}

const sp_arms! = ([MatchArm] arms, SpCtx c): [MatchArm] -> {
	let [MatchArm] out = []

	for a in arms {
		out = [
			...out,
			MatchArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: sp_expr!(a.body, c),
			}),
		]
	}

	return out
}

const sp_stmt_arms! = ([StmtArm] arms, SpCtx c): [StmtArm] -> {
	let [StmtArm] out = []

	for a in arms {
		out = [
			...out,
			StmtArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: sp_stmts!(a.body, c),
			}),
		]
	}

	return out
}

const sp_fieldinits! = ([FieldInit] fs, SpCtx c): [FieldInit] -> {
	let [FieldInit] out = []

	for f in fs out = [...out, FieldInit({ field: f.field, value: sp_expr!(f.value, c) })]

	return out
}

const sp_bad_var = (SpCtx c): Expr -> {
	die("cf: closure: a parameter carrying a capturing closure may only be called or passed to a function\n")

	return Expr.Unit
}

# Rewrite one call inside the clone: a call THROUGH the removed parameter becomes a direct call
# to the lifted closure (captures appended); a call FORWARDING the parameter retargets that
# callee's spec name (built by the next worklist round).
const sp_call! = (Str n, [Str] ta, [Expr] args, Str g, SpCtx c): Expr -> {
	if eq(n, c.fp) then {
		let [Expr] all = sp_exprs!(args, c)

		for v in sp_cap_vars(c) all = [...all, v]

		return with_geom(Expr.Call(c.clo, ta, all, ""), g)
	}

	let Iarch fwd = -1

	for (a, ai) in args {
		const Str an = arg_var_name(a)
		if eq(an, c.fp) then fwd = ai
	}

	if fwd < 0 then return with_geom(Expr.Call(n, ta, sp_exprs!(args, c), ""), g)
	let [Expr] rest = []

	for (a, ai) in args if ai != fwd then rest = [...rest, sp_expr!(a, c)]

	for v in sp_cap_vars(c) rest = [...rest, v]

	return with_geom(Expr.Call(spec_name(n, fwd, c.clo), ta, rest, ""), g)
}

const sp_expr! = (Expr e, SpCtx c): Expr -> match e {
	Expr.Var(n) -> if eq(n, c.fp) then sp_bad_var(c) else e,
	Expr.Call(n, ta, args, g) -> sp_call!(n, ta, args, g, c),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(fn, sp_exprs!(args, c)),
	Expr.Match(scrut, arms) -> Expr.Match(sp_expr!(scrut, c), sp_arms!(arms, c)),
	Expr.ArrayLit(hs, sn, elems, et) -> Expr.ArrayLit(hs, sp_expr!(sn, c), sp_exprs!(elems, c), et),
	Expr.Record(n2, fs) -> Expr.Record(n2, sp_fieldinits!(fs, c)),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(sp_expr!(b, c), f),
	Expr.UnionMk(t, mm, args) -> Expr.UnionMk(t, mm, sp_exprs!(args, c)),
	Expr.Index(a, i) -> Expr.Index(a, sp_expr!(i, c)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, sp_expr!(i, c), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(sp_expr!(b, c), sp_expr!(i, c)),
	Expr.Interp(segs) -> Expr.Interp(sp_segs!(segs, c)),
	Expr.Tuple(elems) -> Expr.Tuple(sp_exprs!(elems, c)),
	Expr.Spread(x) -> Expr.Spread(sp_expr!(x, c)),
	Expr.Loop(body) -> Expr.Loop(sp_stmts!(body, c)),
	Expr.Buffer(sz) -> Expr.Buffer(sp_expr!(sz, c)),
	Expr.Neg(x) -> Expr.Neg(sp_expr!(x, c)),
	Expr.Not(x) -> Expr.Not(sp_expr!(x, c)),
	Expr.BitNot(x) -> Expr.BitNot(sp_expr!(x, c)),
	Expr.Add(l, r) -> Expr.Add(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.Sub(l, r) -> Expr.Sub(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.Mul(l, r) -> Expr.Mul(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.Div(l, r) -> Expr.Div(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.Mod(l, r) -> Expr.Mod(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.BitOr(l, r) -> Expr.BitOr(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.BitXor(l, r) -> Expr.BitXor(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.Shl(l, r) -> Expr.Shl(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.Shr(l, r) -> Expr.Shr(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.And(l, r) -> Expr.And(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.Or(l, r) -> Expr.Or(sp_expr!(l, c), sp_expr!(r, c)),
	Expr.If(cx, t, e2) -> Expr.If(sp_expr!(cx, c), sp_expr!(t, c), sp_expr!(e2, c)),
	_ -> e,
}

const sp_stmt! = (Stmt s, SpCtx c): Stmt -> match s {
	Stmt.Let(n, m, ann, e) -> Stmt.Let(n, m, ann, sp_expr!(e, c)),
	Stmt.Destructure(pat, m, e) -> Stmt.Destructure(pat, m, sp_expr!(e, c)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, sp_expr!(e, c)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, sp_expr!(e, c)),
	Stmt.DeepFieldAssign(be, f, e) -> Stmt.DeepFieldAssign(sp_expr!(be, c), f, sp_expr!(e, c)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, sp_expr!(i, c), sp_expr!(v, c)),
	Stmt.Return(e) -> Stmt.Return(sp_expr!(e, c)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, sp_stmts!(body, c)),
	Stmt.Loop(ll_, body) -> Stmt.Loop(ll_, sp_stmts!(body, c)),
	Stmt.IfThen(cx, st) -> Stmt.IfThen(sp_expr!(cx, c), sp_stmt!(st, c)),
	Stmt.IfElse(cx, t, e) -> Stmt.IfElse(sp_expr!(cx, c), sp_stmt!(t, c), sp_stmt!(e, c)),
	Stmt.Do(e) -> Stmt.Do(sp_expr!(e, c)),
	Stmt.Block(ss) -> Stmt.Block(sp_stmts!(ss, c)),
	Stmt.Match(scrut, arms) -> Stmt.Match(sp_expr!(scrut, c), sp_stmt_arms!(arms, c)),
	Stmt.Yield(e) -> Stmt.Yield(sp_expr!(e, c)),
	Stmt.Closure(nm, params, ret, body) -> Stmt.Closure(nm, params, ret, sp_stmts!(body, c)),
	Stmt.Defer(body) -> Stmt.Defer(sp_stmts!(body, c)),
	_ -> s,
}

const sp_stmts! = ([Stmt] ss, SpCtx c): [Stmt] -> {
	let [Stmt] out = []

	for s in ss out = [...out, sp_stmt!(s, c)]

	return out
}

# The clone's next capture-parameter ordinal: past every `$sp<i>` an inner layer already carries.
const count_sp = ([Param] ps): Iarch -> {
	let Iarch k = 0

	for pp in ps if starts_with("\$sp", pp.name) then k = k + 1

	return k
}

# Build the clone a spec name asks for. The closure's capture parameters (its `$capref`/`$capagg`
# tail) are re-minted as `$sp<i>` parameters of the clone — same kinds, collision-free names.
const build_spec! = ([Func] funcs, Str nm): Func -> {
	const SpecReq rq = parse_spec(nm)
	const Iarch hi = find_func(funcs, rq.hof)
	if hi < 0 then die("cf: closure: internal: a specialized call names no function (${rq.hof})\n")
	const Iarch ci = find_func(funcs, rq.clo)
	if ci < 0 then die("cf: closure: internal: a specialized call names no lifted closure\n")
	const Func hof = funcs[hi]
	const Func clo = funcs[ci]
	let [Param] params = []

	for (pp, pi) in hof.params if pi != rq.cp then params = [...params, pp]

	let [Str] capnames = []
	let Iarch k = 0

	for pp in clo.params {
		if eq(pp.type_name, "$capref") || eq(pp.type_name, "$capagg") then {
			const Str cn = "\$sp${count_sp(params)}"
			params = [
				...params,
				Param({
					name: cn,
					is_ptr: pp.is_ptr,
					type_name: pp.type_name,
					elem: pp.elem,
					telems: pp.telems,
					size: pp.size,
				}),
			]
			capnames = [...capnames, cn]
			k = k + 1
		}
	}

	const SpCtx c = SpCtx({ fp: hof.params[rq.cp].name, clo: rq.clo, caps: capnames })

	return Func({
		name: nm,
		is_pub: false,
		ret_name: hof.ret_name,
		ret_elem: hof.ret_elem,
		params: params,
		body: sp_stmts!(hof.body, c),
		is_asm: false,
		asm_body: hof.asm_body,
		is_value: hof.is_value,
		ret_telems: hof.ret_telems,
		typarams: hof.typarams,
		tbounds: hof.tbounds,
		ret_size: hof.ret_size,
		is_intrinsic: false,
		asm_sym: "",
		dfile: hof.dfile,
		dline: hof.dline,
		dcol: hof.dcol,
	})
}

# Build every requested specialization to a fixpoint: a clone's own body may forward the closure
# to a further HOF (a fresh spec name), so sweep until no call names a missing spec.
# Build `nm` and, first, any INNER layer its hof half names (`hof$w0$clo1$w0$clo2` needs the
# `hof$w0$clo1` clone in place before its own clone derives from it).
const ensure_spec! = ([Func] funcs0, Str nm): [Func] -> {
	if find_func(funcs0, nm) >= 0 then return funcs0
	const SpecReq rq = parse_spec(nm)
	let [Func] funcs = funcs0

	if find_func(funcs, rq.hof) < 0 && has_spec_marker(rq.hof)
		then funcs = ensure_spec!(funcs, rq.hof)

	return [...funcs, build_spec!(funcs, nm)]
}

const specialize_hofs! = ([Func] funcs0): [Func] -> {
	let [Func] funcs = funcs0

	loop {
		const [Str] want = missing_specs(funcs)
		if Iarch(want.len) == 0 then break

		for w in want funcs = ensure_spec!(funcs, w)
	}

	return funcs
}

# Lift every function's closures and append the lifted functions to the program. An asm-bodied
# function has no closures. The lifted functions carry `$capref`/`$capagg` parameters that emit
# lowers (a scalar-address cell / an aggregate pointer); they are already type-validated as the
# original closures, so they are not re-checked.
pub const lift_program! = (Program prog): Program -> {
	let [Func] funcs = []
	let [Func] extra = []
	let Iarch i = 0

	loop {
		if i >= Iarch(prog.funcs.len) then break
		const Func fn = prog.funcs[i]

		if fn.is_asm then {
			funcs = [...funcs, fn]
		} else {
			const Lifted lf = lift_func!(fn, i, prog.recs, prog.funcs)
			funcs = [
				...funcs,
				Func({
					name: fn.name,
					is_pub: fn.is_pub,
					ret_name: fn.ret_name,
					ret_elem: fn.ret_elem,
					params: fn.params,
					body: lf.body,
					is_asm: false,
					asm_body: fn.asm_body,
					is_value: fn.is_value,
					ret_telems: fn.ret_telems,
					typarams: fn.typarams,
					tbounds: fn.tbounds,
					ret_size: fn.ret_size,
					is_intrinsic: fn.is_intrinsic,
					asm_sym: fn.asm_sym,
					dfile: fn.dfile,
					dline: fn.dline,
					dcol: fn.dcol,
				}),
			]
			let Iarch k = 0

			loop {
				if k >= Iarch(lf.funcs.len) then break
				extra = [...extra, lf.funcs[k]]
				k = k + 1
			}
		}

		i = i + 1
	}

	let Iarch e = 0

	loop {
		if e >= Iarch(extra.len) then break
		funcs = [...funcs, extra[e]]
		e = e + 1
	}

	# build the HOF clones the capturing-closure call sites now name
	funcs = specialize_hofs!(funcs)

	return Program({
		imports: prog.imports,
		recs: prog.recs,
		unions: prog.unions,
		funcs: funcs,
		groups: prog.groups,
	})
}
