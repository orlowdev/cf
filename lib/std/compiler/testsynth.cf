# std::compiler::testsynth — synthesize the `cf test` runner (testing.md §6).
#
# The parser turns each top-level `case!`/`todo!` into two functions: `__cf_case_<n>` holding the
# body verbatim, and `__cf_run_<n>!` — the wrapper that opens a `test_arena`, provides a fresh
# verdict
# accumulator, runs the body, reports the verdict, and returns the case's fail count. Under `cf
# test`
# this pass adds the entry `main` that drives every `__cf_run_*!` in declaration order, sums the
# fails, and returns a non-zero exit code iff any case failed. The module's own `main`, if any,
# steps
# aside (its name is changed so it is no longer the entry, then dropped as unreachable). Any other
# build never runs this pass, so the cases stay unreached and cost the artifact nothing.
import std::compiler::ast::{ Program, Func, Stmt, Expr, Import }
import std::data::str::{ eq, starts_with, ends_with, contains }

const run_prefix = "__cf_run_"

# The module name of the file DECLARING a case, as the report's per-line prefix (testing.md §5):
# the path with a leading `./` dropped, the `.cf` extension dropped, and `/` rewritten `::` —
# exactly how a module name is formed (module_system) — then ` -> `. Derived per run wrapper from
# its `dfile` stamp (the parser records the declaring file), so a MERGED test build — one binary
# importing many test modules — prefixes every line with the right module. The runner prints it
# before each case; the case's own teardown (or `todo!`) completes the line with its mark and
# description — the walker headers the report, the case reports the verdict (testing.md §1/§3).
const module_prefix = (Str input): [Uint8] -> {
	let Iarch start = 0
	if Iarch(input.len) >= 2 && Iarch(input[0]) == 46 && Iarch(input[1]) == 47 then start = 2
	let Iarch stop = Iarch(input.len)
	# a module path built by resolve carries a trailing NUL for the raw `open` syscall — trim it
	if stop > 0 && Iarch(input[stop - 1]) == 0 then stop = stop - 1
	if stop >= 3 && Iarch(input[stop - 3]) == 46 && Iarch(input[stop - 2]) == 99
	&& Iarch(input[stop - 1]) == 102
			then stop = stop - 3
	let [Uint8] out = []
	let Iarch i = start

	loop {
		if i >= stop then break

		if Iarch(input[i]) == 47 then {
			out = [...out, 58, 58]
		} else {
			out = [...out, input[i]]
		}

		i = i + 1
	}

	out = [...out, 32, 45, 62, 32]

	return out
}

# A Func with its `name` replaced — used to step the module's own `main` aside. cf has no
# record-value
# spread, so every field is carried explicitly.
const renamed = (Func f, Str name): Func -> Func({
	name: name,
	is_pub: f.is_pub,
	ret_name: f.ret_name,
	ret_elem: f.ret_elem,
	params: f.params,
	body: f.body,
	uses: f.uses,
	is_asm: f.is_asm,
	asm_body: f.asm_body,
	is_value: f.is_value,
	ret_telems: f.ret_telems,
	typarams: f.typarams,
	tbounds: f.tbounds,
	ret_size: f.ret_size,
	is_intrinsic: f.is_intrinsic,
	asm_sym: f.asm_sym,
	dfile: f.dfile,
	dline: f.dline,
	dcol: f.dcol,
})

const mk_main = ([Stmt] body): Func -> Func({
	name: "main",
	is_pub: true,
	ret_name: "",
	ret_elem: "",
	params: [],
	body: body,
	uses: [],
	is_asm: false,
	asm_body: [],
	is_value: false,
	ret_telems: [],
	typarams: [],
	tbounds: [],
	ret_size: 0,
	is_intrinsic: false,
	asm_sym: "",
	dfile: "",
	dline: 0,
	dcol: 0,
})

# Add the `cf test` runner `main` over the parser's `__cf_run_*!` wrappers — matched ANYWHERE in
# the name, since a wrapper declared in an IMPORTED test module carries its module's flat mangle
# prefix (a merged test build imports every test file; the entry's own wrappers stay bare).
# `bail` stops the run at the first failing case (cf_cli §7).
# A module path as resolve records it may carry a trailing NUL (the raw `open` syscall's
# terminator) — compare paths with it trimmed.
const path_eq = (Str a, Str b): Bool -> {
	let Iarch an = Iarch(a.len)
	if an > 0 && Iarch(a[an - 1]) == 0 then an = an - 1
	let Iarch bn = Iarch(b.len)
	if bn > 0 && Iarch(b[bn - 1]) == 0 then bn = bn - 1
	if an != bn then return false
	let Iarch i = 0

	loop {
		if i >= an then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}

	return true
}

const requested = ([Str] only, Str dfile): Bool -> {
	if Iarch(only.len) == 0 then return true
	for o in only if path_eq(o, dfile) then return true

	return false
}

pub const inject_test_runner! = (Program p, Bool bail, [Str] only): Program -> {
	let [Str] runs = []
	let [Str] rfiles = []
	let Iarch i = 0

	# only the REQUESTED files' cases run (`only` empty = all): a module the target's import tree
	# merely reaches (std::data::str under nearly everything) carries its own cases, and running a
	# dependency's suite uninvited is noise — its cases run when IT is the target
	loop {
		if i >= Iarch(p.funcs.len) then break
		if contains(run_prefix, p.funcs[i].name) && !p.funcs[i].is_asm && !p.funcs[i].is_value
		&& requested(only, p.funcs[i].dfile) then {
			runs = [...runs, p.funcs[i].name]
			rfiles = [...rfiles, p.funcs[i].dfile]
		}
		i = i + 1
	}

	# ZERO cases: still a test build — synthesize a runner that reports nothing and exits 0, so a
	# caseless file under `cf test` (a library module in a directory walk, a file whose only
	# `case!` text sits in a comment) neither demands a `main` nor runs one it happens to have.
	if Iarch(runs.len) == 0 then {
		let [Func] fs0 = []
		let Iarch j0 = 0

		loop {
			if j0 >= Iarch(p.funcs.len) then break
			if eq(p.funcs[j0].name, "main") then fs0 = [...fs0, renamed(p.funcs[j0], "__cf_user_main")]
			else fs0 = [...fs0, p.funcs[j0]]
			j0 = j0 + 1
		}

		const [Stmt] mb = [Stmt.Return(Expr.Lit(0))]

		return Program({
			imports: p.imports,
			recs: p.recs,
			unions: p.unions,
			funcs: [...fs0, mk_main(mb)],
			groups: p.groups,
		})
	}

	# step the module's own `main` aside — the runner is the sole entry
	let [Func] fs = []
	let Iarch j = 0

	loop {
		if j >= Iarch(p.funcs.len) then break
		if eq(p.funcs[j].name, "main") then fs = [...fs, renamed(p.funcs[j], "__cf_user_main")]
		else fs = [...fs, p.funcs[j]]
		j = j + 1
	}

	# the runner body: a root arena, a running fail tally, one `__cf_run_*!() in root` per case, and a
	# 0/1 exit code. Each wrapper carves its own `test_arena` from `root`, so every case runs in it.
	let [Stmt] body = [
		Stmt.Let("root", false, "", Expr.Call("of__el", [], [Expr.Lit(1048576)], "")),
		Stmt.Let("fails", true, "Uarch", Expr.Lit(0)),
	]
	let Iarch r = 0

	loop {
		if r >= Iarch(runs.len) then break
		body = [
			...body,
			Stmt.Do(Expr.Call("std_test_report_prefix", [], [Expr.StrLit(module_prefix(rfiles[r]))], "")),
			Stmt.Assign("fails", Expr.Add(Expr.Var("fails"), Expr.Call(runs[r], [], [], "root"))),
		]
		# `--bail`: the first failing case ends the run — the tally is already non-zero
		if bail
			then body = [
			...body,
			Stmt.IfThen(Expr.CmpGt(Expr.Var("fails"), Expr.Lit(0)), Stmt.Return(Expr.Lit(1))),
		]
		r = r + 1
	}

	body = [
		...body,
		Stmt.Return(Expr.If(Expr.CmpGt(Expr.Var("fails"), Expr.Lit(0)), Expr.Lit(1), Expr.Lit(0))),
	]
	const [Func] withmain = [...fs, mk_main(body)]
	const [Import] imps = [
		...p.imports,
		Import({
			path: "std/mem/arena/growing_arena",
			names: [],
			alias: "",
			wildcard: false,
			dline: 0,
			dcol: 0,
		}),
	]

	return Program({ imports: imps, recs: p.recs, unions: p.unions, funcs: withmain, groups: p.groups })
}
