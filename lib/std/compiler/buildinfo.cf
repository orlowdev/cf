# std::compiler::buildinfo — the compiler's own version stamp.
#
# `compiler_version` is the GenVer version THIS cf binary was built as. Bootstrap and local builds
# (build.sh / reseed.sh) leave the `0.0.0-dev` default; a release build stamps the ring tag into this
# one literal before compiling the compiler (the CI release job rewrites it), so a released cf reports
# that version through `std::comptime::version::compiler` in every program it compiles. Keeping it a
# plain `Str` const — not an intrinsic used in the compiler's own source — is deliberate: the compiler
# never references the version intrinsics, so adding them needs only a normal strict reseed.
pub const compiler_version = "0.0.0-dev"
