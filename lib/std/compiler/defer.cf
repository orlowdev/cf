# defer — lower `defer` statements to explicit scope-exit code (memory_model §6), after typecheck.
#
# A `defer f(x)` / `defer { ... }` schedules work to run when the enclosing function returns, in
# LIFO order, AFTER the return value is fixed. This pass removes every `Defer` node and rewrites
# each `return e` reachable with pending defers into
#     { const __cf_dret = e; <defers, last-declared first>; return __cf_dret }
# The `__cf_dret` binding SNAPSHOTS the value before the defers run: a word return keeps the value
# it read (a later mutation of the source does not change it), while a record return keeps the
# arena POINTER — so defers that mutate the record through it are observed by the caller.
# The name must NOT be `$`-prefixed: emit reads a leading `$` as the user's stack-binding marker
# (`ctx.alloc_stack`), which built a literal return value ON THE DYING FRAME — a dangling pointer
# the caller then read as garbage (the old name `$ret` did exactly that).
#
# v1 (typecheck enforces): a `defer` is only a direct function-body statement, so defers accumulate
# purely along the top-level statement list. A `return` nested in a loop / `if` still fires the
# defers declared before the enclosing construct (they are threaded in as `pending`); one declared
# after that construct is not yet pending, so it does not fire. Runs BEFORE the closure lift, so a
# `defer f()` calling a local closure is a plain call site the lift then redirects.

import std::data::str::{ eq }
import std::compiler::ast::{
	Expr,
	Stmt,
	MatchArm,
	StmtArm,
	Seg,
	FieldInit,
	TupElem,
	Param,
	RecDecl,
	UnionDecl,
	Func,
	Import,
	Program,
}

# Does a function body contain a `defer` anywhere? (Only funcs that do are rewritten; every other
# is returned byte-identical.) A defer is top-level, but scan recursively to be safe.
const stmts_have_defer = ([Stmt] ss): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		if stmt_has_defer(ss[i]) then return true
		i = i + 1
	}

	return false
}

const arms_have_defer = ([StmtArm] arms): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if stmts_have_defer(arms[i].body) then return true
		i = i + 1
	}

	return false
}

const stmt_has_defer = (Stmt s): Bool -> match s {
	Stmt.Defer(ss) -> true,
	Stmt.Block(ss) -> stmts_have_defer(ss),
	Stmt.Loop(ll_, ss) -> stmts_have_defer(ss),
	Stmt.ForIn(v, a, body) -> stmts_have_defer(body),
	Stmt.IfThen(c, st) -> stmt_has_defer(st),
	Stmt.IfElse(c, t, e) -> stmt_has_defer(t) || stmt_has_defer(e),
	Stmt.Match(scrut, arms) -> arms_have_defer(arms),
	_ -> false,
}

# A fresh copy of a pending-defers list — never `let cur = pending` then append, which would grow
# the caller's list in place (cf-array-aliasing-hazard); build from `[]` and copy so the local
# accumulator is unaliased.
const clone_pending = ([[Stmt]] xs): [[Stmt]] -> [...xs]

# `{ const __cf_dret = e; <defers LIFO>; return __cf_dret }` — snapshot the return value, run the
# pending
# defers last-declared-first, then return the snapshot. Each defer body is spliced as its OWN
# `Stmt.Block` (its own scope), matching the source: two sibling `defer { ... }` blocks are separate
# scopes that typecheck validated independently, so each may reuse a local name — flattening them
# into one scope would collide those names (typecheck already ran, so the clash would slip to emit).
const synth_return = (Expr e, [[Stmt]] pending): Stmt -> {
	let [Stmt] blk = [Stmt.Let("__cf_dret", false, "", e)]
	let Iarch i = Iarch(pending.len) - 1

	loop {
		if i < 0 then break
		blk = [...blk, Stmt.Block(pending[i])]
		i = i - 1
	}

	blk = [...blk, Stmt.Return(Expr.Var("__cf_dret"))]

	return Stmt.Block(blk)
}

const rw_arms! = ([StmtArm] arms, [[Stmt]] cur, Iarch loop_base, [LB] lbs): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [
			...out,
			StmtArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: rw_stmts!(a.body, cur, loop_base, lbs),
			}),
		]
		i = i + 1
	}

	return out
}

# Fire the defer bodies `cur[from:]` in LIFO order (last-declared first), each spliced as its OWN
# `Stmt.Block` scope (sibling defers are independent scopes that may reuse a local name; flattening
# would collide them). `from` bounds how far down to fire: a scope's fall-through end fires its OWN
# defers (from the scope's entry depth); a `break`/`continue` fires every defer down to the
# enclosing
# loop's entry depth (`loop_base`).
const fire_from = ([[Stmt]] cur, Iarch from): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = Iarch(cur.len) - 1

	loop {
		if i < from then break
		out = [...out, Stmt.Block(cur[i])]
		i = i - 1
	}

	return out
}

const append_stmts = ([Stmt] a, [Stmt] b): [Stmt] -> [...a, ...b]

# Does a scope's rewritten body ALWAYS exit (never falls through its end)? A trailing `return` /
# `break` / `continue` — or a block ending in one, or an if/else whose branches both do — means the
# fall-through end is unreachable, so the fall-through defer fire must NOT be appended after it
# (QBE rejects a statement after a terminator). A `return` also already fired the pending defers.
const stmt_terminal = (Stmt s): Bool -> match s {
	Stmt.Return(e) -> true,
	Stmt.Break(bl_) -> true,
	Stmt.Continue(bl_) -> true,
	Stmt.Block(ss) -> stmts_terminal(ss),
	Stmt.IfElse(c, t, e) -> stmt_terminal(t) && stmt_terminal(e),
	_ -> false,
}

const stmts_terminal = ([Stmt] ss): Bool -> {
	if Iarch(ss.len) == 0 then return false

	return stmt_terminal(ss[Iarch(ss.len) - 1])
}

# Rewrite a single statement in TAIL position (an `if`/`else` branch): it holds no own defers, but
# its exits must fire what is pending — a `return` fires ALL of `cur`, a `break`/`continue` fires
# down to the enclosing loop's `loop_base` — and nested loops/blocks recurse (a loop resets
# `loop_base` to the depth at its entry).
# A one-element `[Stmt]` — annotated so a single-element literal of a union member types as the
# union (a fresh literal has no context to infer it).
const stmt_singleton = (Stmt s): [Stmt] -> {
	const [Stmt] r = [s]

	return r
}

# A LABELED loop's entry depth: `break outer` fires the pending defers down to `outer`'s base, not
# just the nearest loop's. One entry per labeled loop currently open (lexically).
data LB = { Str name, Iarch base }

const no_lbs = (): [LB] -> {
	const [LB] r = []

	return r
}

# Push a loop's label onto the open-label stack — an unlabeled loop ("") pushes nothing.
const push_lb = ([LB] lbs, Str l, Iarch base): [LB] -> {
	if Iarch(l.len) == 0 then return [...lbs]

	return [...lbs, LB({ name: l, base: base })]
}

# The defer-stack depth a `break`/`continue` fires down to: the LABELED loop's entry depth when a
# label is given (innermost match wins), else the nearest loop's `loop_base`.
const exit_base = ([LB] lbs, Str l, Iarch loop_base): Iarch -> {
	if Iarch(l.len) == 0 then return loop_base

	let Iarch i = Iarch(lbs.len)

	loop {
		if i <= 0 then return loop_base
		i = i - 1
		if eq(lbs[i].name, l) then return lbs[i].base
	}

	return loop_base
}

# ── Expression recursion: a VALUE loop (`Expr.Loop`) nests statements inside an expression, and
# a `return` inside its body must fire the pending defers exactly like any other return — it used
# to slip through untouched (the defers were silently skipped on that path). The walkers rebuild
# every expression, entering a value-loop body through `rw_stmts!` with the discipline a statement
# loop gets (`loop_base` = the entry depth). A closure body is NOT entered — its returns belong to
# the closure's own scope, not this function's defer stack.
const rw_exprs! = ([Expr] es, [[Stmt]] cur, Iarch lb, [LB] lbs): [Expr] -> {
	let [Expr] out = []

	for e in es {
		out = [...out, rw_expr!(e, cur, lb, lbs)]
	}

	return out
}

const rw_fields! = ([FieldInit] fs, [[Stmt]] cur, Iarch lb, [LB] lbs): [FieldInit] -> {
	let [FieldInit] out = []

	for f in fs {
		out = [...out, FieldInit({ field: f.field, value: rw_expr!(f.value, cur, lb, lbs) })]
	}

	return out
}

const rw_segs! = ([Seg] segs, [[Stmt]] cur, Iarch lb, [LB] lbs): [Seg] -> {
	let [Seg] out = []

	for s in segs {
		out = [
			...out,
			Seg({ is_hole: s.is_hole, lit: s.lit, name: s.name, expr: rw_expr!(s.expr, cur, lb, lbs) }),
		]
	}

	return out
}

const rw_earms! = ([MatchArm] arms, [[Stmt]] cur, Iarch lb, [LB] lbs): [MatchArm] -> {
	let [MatchArm] out = []

	for a in arms {
		out = [
			...out,
			MatchArm({
				is_wild: a.is_wild,
				type_name: a.type_name,
				members: a.members,
				binds: a.binds,
				body: rw_expr!(a.body, cur, lb, lbs),
			}),
		]
	}

	return out
}

const rw_expr! = (Expr e, [[Stmt]] cur, Iarch lb, [LB] lbs): Expr -> match e {
	Expr.At(off, inner) -> Expr.At(off, rw_expr!(inner, cur, lb, lbs)),
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	Expr.Var(n) -> Expr.Var(n),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(n, rw_fields!(fs, cur, lb, lbs)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(rw_expr!(b, cur, lb, lbs), f),
	Expr.UnionMk(t, m, args) -> Expr.UnionMk(t, m, rw_exprs!(args, cur, lb, lbs)),
	Expr.Match(scrut, arms) ->
		Expr.Match(rw_expr!(scrut, cur, lb, lbs), rw_earms!(arms, cur, lb, lbs)),
	Expr.ArrayLit(hs, sp, elems, et) ->
		Expr.ArrayLit(hs, rw_expr!(sp, cur, lb, lbs), rw_exprs!(elems, cur, lb, lbs), et),
	Expr.Index(a, i) -> Expr.Index(a, rw_expr!(i, cur, lb, lbs)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, rw_expr!(i, cur, lb, lbs), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(rw_expr!(b, cur, lb, lbs), rw_expr!(i, cur, lb, lbs)),
	Expr.Interp(segs) -> Expr.Interp(rw_segs!(segs, cur, lb, lbs)),
	Expr.Tuple(elems) -> Expr.Tuple(rw_exprs!(elems, cur, lb, lbs)),
	Expr.Spread(x) -> Expr.Spread(rw_expr!(x, cur, lb, lbs)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(ss) -> Expr.Loop(rw_stmts!(ss, cur, Iarch(cur.len), lbs)),
	Expr.Buffer(sz) -> Expr.Buffer(rw_expr!(sz, cur, lb, lbs)),
	Expr.Addr(n) -> Expr.Addr(n),
	Expr.Neg(x) -> Expr.Neg(rw_expr!(x, cur, lb, lbs)),
	Expr.Not(x) -> Expr.Not(rw_expr!(x, cur, lb, lbs)),
	Expr.BitNot(x) -> Expr.BitNot(rw_expr!(x, cur, lb, lbs)),
	Expr.Add(l, r) -> Expr.Add(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.Sub(l, r) -> Expr.Sub(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.Mul(l, r) -> Expr.Mul(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.Div(l, r) -> Expr.Div(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.Mod(l, r) -> Expr.Mod(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.BitOr(l, r) -> Expr.BitOr(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.BitXor(l, r) -> Expr.BitXor(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.Shl(l, r) -> Expr.Shl(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.Shr(l, r) -> Expr.Shr(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.And(l, r) -> Expr.And(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.Or(l, r) -> Expr.Or(rw_expr!(l, cur, lb, lbs), rw_expr!(r, cur, lb, lbs)),
	Expr.If(c, t, el) ->
		Expr.If(rw_expr!(c, cur, lb, lbs), rw_expr!(t, cur, lb, lbs), rw_expr!(el, cur, lb, lbs)),
	Expr.Call(n, ta, args, g) -> Expr.Call(n, ta, rw_exprs!(args, cur, lb, lbs), g),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(fn, rw_exprs!(args, cur, lb, lbs)),
}

# The expression positions of a NON-exit statement, rewritten in place (the statement itself
# neither fires nor accumulates — only value loops inside its expressions matter).
const rw_stmt_exprs! = (Stmt s, [[Stmt]] cur, Iarch lb, [LB] lbs): Stmt -> match s {
	Stmt.Let(n, m, ann, init) -> Stmt.Let(n, m, ann, rw_expr!(init, cur, lb, lbs)),
	Stmt.Assign(n, v) -> Stmt.Assign(n, rw_expr!(v, cur, lb, lbs)),
	Stmt.FieldAssign(b, f, v) -> Stmt.FieldAssign(b, f, rw_expr!(v, cur, lb, lbs)),
	Stmt.DeepFieldAssign(b, f, v) ->
		Stmt.DeepFieldAssign(rw_expr!(b, cur, lb, lbs), f, rw_expr!(v, cur, lb, lbs)),
	Stmt.IndexAssign(n, ix, v) ->
		Stmt.IndexAssign(n, rw_expr!(ix, cur, lb, lbs), rw_expr!(v, cur, lb, lbs)),
	Stmt.Do(e) -> Stmt.Do(rw_expr!(e, cur, lb, lbs)),
	Stmt.Destructure(ns, m, e) -> Stmt.Destructure(ns, m, rw_expr!(e, cur, lb, lbs)),
	Stmt.Yield(e) -> Stmt.Yield(rw_expr!(e, cur, lb, lbs)),
	_ -> s,
}

const rw_stmt_in! = (Stmt s, [[Stmt]] cur, Iarch loop_base, [LB] lbs): Stmt -> match s {
	Stmt.Return(e) -> if Iarch(cur.len) == 0
		then Stmt.Return(rw_expr!(e, cur, loop_base, lbs))
	else synth_return(rw_expr!(e, cur, loop_base, lbs), cur),
	Stmt.Break(bl_) ->
		Stmt.Block(append_stmts(fire_from(cur, exit_base(lbs, bl_, loop_base)), stmt_singleton(s))),
	Stmt.Continue(bl_) ->
		Stmt.Block(append_stmts(fire_from(cur, exit_base(lbs, bl_, loop_base)), stmt_singleton(s))),
	Stmt.Block(ss) -> Stmt.Block(rw_stmts!(ss, cur, loop_base, lbs)),
	Stmt.Loop(ll_, bd) ->
		Stmt.Loop(ll_, rw_stmts!(bd, cur, Iarch(cur.len), push_lb(lbs, ll_, Iarch(cur.len)))),
	Stmt.ForIn(v, a, bd) -> Stmt.ForIn(v, a, rw_stmts!(bd, cur, Iarch(cur.len), lbs)),
	Stmt.IfThen(c, st) ->
		Stmt.IfThen(rw_expr!(c, cur, loop_base, lbs), rw_stmt_in!(st, cur, loop_base, lbs)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(
		rw_expr!(c, cur, loop_base, lbs),
		rw_stmt_in!(t, cur, loop_base, lbs),
		rw_stmt_in!(e, cur, loop_base, lbs),
	),
	Stmt.Match(scrut, arms) ->
		Stmt.Match(rw_expr!(scrut, cur, loop_base, lbs), rw_arms!(arms, cur, loop_base, lbs)),
	_ -> rw_stmt_exprs!(s, cur, loop_base, lbs),
}

# Rewrite a scope's statement list (v2 — block/loop-scoped defer): accumulate the defers DECLARED
# here into `cur` (dropping each `Defer` node), rewrite every exit to fire what is pending, and at
# the fall-through END fire this scope's OWN defers (`cur[own_start:]`, LIFO). So a LOOP body fires
# them at each back-edge (per-iteration teardown), a BLOCK at its close, a MATCH arm at the arm's
# end — and the function body only past its final `return` (dead code: a returning body already
# fired at the `return`). A `return` fires ALL pending (own + inherited); a `break`/`continue` fires
# down to the enclosing loop's entry depth. `loop_base` is that depth (-1 outside any loop).
const rw_stmts! = ([Stmt] stmts, [[Stmt]] inherited, Iarch loop_base, [LB] lbs): [Stmt] -> {
	let [Stmt] out = []
	let [[Stmt]] cur = clone_pending(inherited)
	const Iarch own_start = Iarch(inherited.len)
	let Iarch i = 0

	loop {
		if i >= Iarch(stmts.len) then break
		const Stmt s = stmts[i]

		match s {
			Stmt.Defer(dbody) -> {
				cur = [...cur, dbody]
			},
			Stmt.Return(e) -> {
				if Iarch(cur.len) == 0
					then out = [...out, Stmt.Return(rw_expr!(e, cur, loop_base, lbs))]
				else out = [...out, synth_return(rw_expr!(e, cur, loop_base, lbs), cur)]
			},
			Stmt.Break(bl_) -> {
				out = append_stmts(out, fire_from(cur, exit_base(lbs, bl_, loop_base)))
				out = [...out, s]
			},
			Stmt.Continue(bl_) -> {
				out = append_stmts(out, fire_from(cur, exit_base(lbs, bl_, loop_base)))
				out = [...out, s]
			},
			Stmt.Loop(ll_, bd) -> {
				out = [
					...out,
					Stmt.Loop(ll_, rw_stmts!(bd, cur, Iarch(cur.len), push_lb(lbs, ll_, Iarch(cur.len)))),
				]
			},
			Stmt.ForIn(v, a, bd) -> {
				out = [...out, Stmt.ForIn(v, a, rw_stmts!(bd, cur, Iarch(cur.len), lbs))]
			},
			Stmt.IfThen(c, st) -> {
				out = [
					...out,
					Stmt.IfThen(rw_expr!(c, cur, loop_base, lbs), rw_stmt_in!(st, cur, loop_base, lbs)),
				]
			},
			Stmt.IfElse(c, t, e) -> {
				out = [
					...out,
					Stmt.IfElse(
						rw_expr!(c, cur, loop_base, lbs),
						rw_stmt_in!(t, cur, loop_base, lbs),
						rw_stmt_in!(e, cur, loop_base, lbs),
					),
				]
			},
			Stmt.Block(ss) -> {
				out = [...out, Stmt.Block(rw_stmts!(ss, cur, loop_base, lbs))]
			},
			Stmt.Match(scrut, arms) -> {
				out = [
					...out,
					Stmt.Match(rw_expr!(scrut, cur, loop_base, lbs), rw_arms!(arms, cur, loop_base, lbs)),
				]
			},
			_ -> {
				out = [...out, rw_stmt_exprs!(s, cur, loop_base, lbs)]
			},
		}

		i = i + 1
	}

	# fire this scope's OWN defers at the fall-through end — but only if the end is REACHABLE (the
	# body does not already exit unconditionally; an exit already fired what it needed).
	if !stmts_terminal(out) then out = append_stmts(out, fire_from(cur, own_start))

	return out
}

# Lower every defer-bearing function's body; leave defer-free functions (and asm bodies) untouched.
pub const lower_defers! = (Program prog): Program -> {
	let [Func] funcs = []
	let Iarch i = 0

	loop {
		if i >= Iarch(prog.funcs.len) then break
		const Func fn = prog.funcs[i]

		if fn.is_asm then {
			funcs = [...funcs, fn]
		} else if !stmts_have_defer(fn.body) then {
			funcs = [...funcs, fn]
		} else {
			const [[Stmt]] none = []
			const [Stmt] nb = rw_stmts!(fn.body, none, -1, no_lbs())
			funcs = [
				...funcs,
				Func({
					name: fn.name,
					is_pub: fn.is_pub,
					ret_name: fn.ret_name,
					ret_elem: fn.ret_elem,
					params: fn.params,
					body: nb,
					is_asm: false,
					asm_body: fn.asm_body,
					is_value: fn.is_value,
					ret_telems: fn.ret_telems,
					typarams: fn.typarams,
					tbounds: fn.tbounds,
					ret_size: fn.ret_size,
					is_intrinsic: fn.is_intrinsic,
					asm_sym: fn.asm_sym,
					dfile: fn.dfile,
					dline: fn.dline,
					dcol: fn.dcol,
					uses: fn.uses,
				}),
			]
		}

		i = i + 1
	}

	return Program({
		imports: prog.imports,
		recs: prog.recs,
		unions: prog.unions,
		funcs: funcs,
		groups: prog.groups,
	})
}
