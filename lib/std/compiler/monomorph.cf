# monomorph — clone-based monomorphization of generic functions (type_system §8.1, seed_subset).
#
# A generic function `id = ['T]('T x): 'T -> x` is a TEMPLATE. This pass runs between resolve
# and typecheck: it removes the templates and, for every distinct set of type ARGUMENTS a
# template is called with, emits a concrete CLONE with each `'T` substituted by the argument
# (e.g. `id[Iarch]` → a function `id$Iarch` with `Iarch` params/return). Every generic call
# site is rewritten to name its concrete instance (type arguments stripped), so typecheck and
# emit see only ordinary functions. Instances are deduped, and a clone's own body is scanned
# for further generic calls (transitive instantiation) to a fixpoint.
#
# Type arguments are given EXPLICITLY (`id[Iarch](x)`) or INFERRED (`id(x)`). Inference derives
# each argument's type with the typechecker's own `type_of` over a threaded value environment
# (parameters + `let`/match/`for`/destructure binders) and reads each type variable out of the
# parameter's SHAPE — the whole type, a `['T]` array element, a tuple position, or a function
# signature position (`('A) -> 'B` fixed by a lambda's / a named function's declared types, so a
# HOF call like `map(f, xs)` needs no brackets). Generic DATA/UNION types, array-typed type
# variables, and union BOUNDS (`[Color 'T]`) are supported; a tuple-typed type variable is a
# later brick.

import std::compiler::diag::{ Diag, DiagBag, record_dg }
import std::compiler::spans::{ no_maps, unat }
import std::data::str::{ eq, ends_with }
import std::compiler::ast::{
	Expr,
	Stmt,
	Param,
	Func,
	MatchArm,
	StmtArm,
	Seg,
	FieldInit,
	RecDecl,
	UnionDecl,
	UnionMember,
	TupElem,
	Import,
	Program,
	Ty,
	with_geom,
}
import std::compiler::astutil::{ is_fixed_name, is_float_name }
# The monomorph pass infers a generic call's type arguments by deriving argument types with the
# SAME `type_of` the typechecker uses (types flow, not a parallel guesser). `Ctx`/`VarTy` are the
# shared typing vocabulary; the helpers build the pieces `type_of` needs from a binding.
import std::compiler::typecheck::{
	type_of!,
	ty_name,
	Ctx,
	VarTy,
	named_ty,
	param_ty!,
	binding_ty!,
	closure_tfn,
	fn_ty_of_func!,
	arm_bind_env,
	check_destructure!,
	dyn_of,
	tuple_elems,
	elem_ty!,
}
import std::compiler::closures::{ Subst, subst_expr }

# The accumulating state, threaded by pointer: the generic FUNCTION templates + their instance
# clones (with a dedup key set); the generic RECORD/UNION templates + their instance clones (with
# a shared key set) — a generic application `Box[Iarch]` clones template `Box` into `Box$Iarch`;
# and the program's CONCRETE (non-generic) functions/records/unions, which — together with the
# instances — form the `Ctx` the shared `type_of` resolves inference against. `has_gen` is false
# for a program with no templates (cf's own source): the inference machinery is then never
# engaged and the pass is a byte-identical identity.
data MonoCtx = {
	[Func] templates,
	[Str] keys,
	[Func] instances,
	[Str] unions,
	[RecDecl] rec_templates,
	[Str] type_keys,
	[RecDecl] rec_instances,
	[UnionDecl] union_templates,
	[UnionDecl] union_instances,
	[Func] cfuncs,
	[RecDecl] crecs,
	[UnionDecl] cunions,
	Bool has_gen,
	# the CURRENTLY-WALKED body's local closure declarations (name + the mono'd `Stmt.Closure`),
	# newest-first on lookup — the lambda-body inference (`infer_from_lam_body!`) reads a lambda
	# argument's parameters and first return through them. Reset per `mono_func!` body walk and
	# saved/restored around it (nested instantiations via `ensure_instance!` re-enter).
	[Str] lam_names,
	[Stmt] lam_decls,
	# the CURRENTLY-WALKED declaration's source stamp (retargeted as each template / concrete
	# declaration is processed), so a rejection anywhere below names its enclosing decl
	Str dfile,
	Iarch dline,
	Iarch dcol,
	# the SINGLE-SLOT latched rejection (first error since the last flush wins — recording is
	# colorless field stores through the ctx pointer) and the flushed collection the pass
	# returns; the drivers flush between walk items, one error per declaration/instantiation
	Bool mhot,
	Str mefile,
	Iarch meline,
	Iarch mecol,
	Str memsg,
	[Diag] mdiags,
}

# The context threaded through a function body: the active type-variable substitution (when
# cloning a template) plus the local value environment (`[VarTy]`, seeded from parameters and
# extended by `let`/match/`for`/destructure binders) and the enclosing function's return type —
# together everything the shared `type_of` needs to derive an argument's type for inference.
data MonoEnv = { [Str] tvars, [Str] tvals, [VarTy] venv, Ty ret, [Str] vpnames, [Iarch] vpvals }

# Latch a rejection stamped `path:line:col` at an explicit position (a template's own stamp),
# first-wins until the driver flushes. Colorless — plain stores through the ctx pointer.
const mrec_at = (*MonoCtx m, Str file, Iarch line, Iarch col, Str msg): () -> {
	if m.mhot then return ()
	m.mhot = true
	m.mefile = file
	m.meline = line
	m.mecol = col
	m.memsg = msg
}

# Latch a rejection at the currently-walked declaration (`m`'s stamp). Every recording site
# RETURNS an inert value immediately after (the variants below), so no code that assumed the
# old fail-fast divergence runs on — the pass stops after collection anyway (its output is
# discarded when any diagnostic is present).
const mrec = (*MonoCtx m, Str msg): () -> mrec_at(m, m.dfile, m.dline, m.dcol, msg)

const mrec_i = (*MonoCtx m, Str msg): Iarch -> {
	mrec(m, msg)

	return 0
}

# the NAME flavor: hand back the caller-supplied inert name (an instance key, a callee)
const mrec_s = (*MonoCtx m, Str msg, Str inert): Str -> {
	mrec(m, msg)

	return inert
}

# the EXPR flavor: hand back a caller-supplied in-scope expression
const mrec_x = (*MonoCtx m, Str msg, Expr inert): Expr -> {
	mrec(m, msg)

	return inert
}

const mrec_ty = (*MonoCtx m, Str msg): Ty -> {
	mrec(m, msg)

	return Ty.TNever
}

# Move the latched rejection into the collected list, skipping an exact duplicate (a
# template's error repeats per instantiation). Called by the drivers between walk items.
const flush_mono = (*MonoCtx m): () -> {
	if !m.mhot then return ()
	m.mhot = false

	for d in m.mdiags {
		if eq(d.file, m.mefile) && d.line == m.meline && d.col == m.mecol && eq(d.msg, m.memsg)
			then return ()
	}

	m.mdiags = [
		...m.mdiags,
		Diag({ file: m.mefile, line: m.meline, col: m.mecol, msg: m.memsg, what: "" }),
	]
}

# Retarget `m`'s current-declaration stamp.
const set_stamp = (*MonoCtx m, Str df, Iarch dl, Iarch dc): () -> {
	m.dfile = df
	m.dline = dl
	m.dcol = dc
}

const find_template = ([Func] templates, Str n): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(templates.len) then break
		if eq(templates[i].name, n) then return i
		i = i + 1
	}

	return -1
}

const key_seen = (*MonoCtx m, Str mn): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(m.keys.len) then break
		if eq(m.keys[i], mn) then return true
		i = i + 1
	}

	return false
}

# The intrinsic numeric-union bounds (§8.6): `Int`/`Uint`/`Number` are the standard numeric tower,
# not declared in source. Their MEMBERS are the concrete width leaves (compose-over §8.1): `Int` the
# signed widths, `Uint` the unsigned, `Number` the whole tower including the floats. They are never
# CONSTRUCTED (only a generic BOUND and a numeric type-switch's arm type), so they carry no runtime
# layout — they exist here purely for `is_union_name` / `union_mem_names` (bounds + type-switch).
const numeric_union_members = (Str n): [Str] -> {
	if eq(n, "Int") then return ["Int8", "Int16", "Int32", "Int64", "Iarch"]
	if eq(n, "Uint") then return ["Uint8", "Uint16", "Uint32", "Uint64", "Uarch"]
	if eq(n, "Number")
		then return [
		"Int8",
		"Int16",
		"Int32",
		"Int64",
		"Iarch",
		"Uint8",
		"Uint16",
		"Uint32",
		"Uint64",
		"Uarch",
		"Float32",
		"Float64",
	]
	const [Str] none = []

	return none
}

const is_numeric_union = (Str n): Bool -> Iarch(numeric_union_members(n).len) > 0

const is_union_name = (*MonoCtx m, Str n): Bool -> {
	if is_numeric_union(n) then return true
	let Iarch i = 0

	loop {
		if i >= Iarch(m.unions.len) then break
		if eq(m.unions[i], n) then return true
		i = i + 1
	}

	return false
}

# Every non-empty bound in a declaration must name a union — validated at DECL time (like the
# type-variable checks) so a malformed bound is rejected even if the template is never used.
const check_bound_list = (*MonoCtx m, [Str] typarams, [Str] tbounds): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(tbounds.len) then break
		if !eq(tbounds[i], "") then {
			# a TYPE parameter's bound must name a union; a VALUE parameter's type must be Iarch/Uarch
			if is_tvar(typarams[i]) then {
				if !is_union_name(m, tbounds[i]) then mrec(m, "cf: type: a generic bound must name a union\n")
			} else {
				if !eq(tbounds[i], "Iarch") && !eq(tbounds[i], "Uarch")
					then return mrec_i(m, "cf: type: a comptime value parameter must be typed Iarch or Uarch\n")
			}
		}
		i = i + 1
	}

	return 0
}

const check_template_bounds = (*MonoCtx m): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(m.templates.len) then break
		set_stamp(m, m.templates[i].dfile, m.templates[i].dline, m.templates[i].dcol)
		check_bound_list(m, m.templates[i].typarams, m.templates[i].tbounds)
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(m.rec_templates.len) then break
		set_stamp(m, m.rec_templates[j].dfile, m.rec_templates[j].dline, m.rec_templates[j].dcol)
		check_bound_list(m, m.rec_templates[j].typarams, m.rec_templates[j].tbounds)
		j = j + 1
	}

	let Iarch k = 0

	loop {
		if k >= Iarch(m.union_templates.len) then break
		set_stamp(m, m.union_templates[k].dfile, m.union_templates[k].dline, m.union_templates[k].dcol)
		check_bound_list(m, m.union_templates[k].typarams, m.union_templates[k].tbounds)
		k = k + 1
	}

	return 0
}

# A std geometry module's private name (resolve's FIXED mangle tags "fb"/"fx"/"el"/"pg"): generic
# fns
# under these tags are the value-hook templates the Materialize pass owns — see the template
# split in mono_program!.
const geom_hook_tmpl = (Str n): Bool ->
	ends_with("__fb", n) || ends_with("__fx", n) || ends_with("__el", n) || ends_with("__pg", n)

# The member NAMES of a union named `uname` (concrete, or a generic template). Members are the
# post-spread set (resolve.cf's `expand_unions` runs before this pass, so `...Other` is already
# flattened in). Empty if the name is not a union.
const union_mem_names = (*MonoCtx m, Str uname): [Str] -> {
	if is_numeric_union(uname) then return numeric_union_members(uname)
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(m.cunions.len) then break
		if eq(m.cunions[i].name, uname) then {
			let Iarch j = 0

			loop {
				if j >= Iarch(m.cunions[i].members.len) then break
				out = [...out, m.cunions[i].members[j].name]
				j = j + 1
			}

			return out
		}
		i = i + 1
	}

	let Iarch k = 0

	loop {
		if k >= Iarch(m.union_templates.len) then break
		if eq(m.union_templates[k].name, uname) then {
			let Iarch j = 0

			loop {
				if j >= Iarch(m.union_templates[k].members.len) then break
				out = [...out, m.union_templates[k].members[j].name]
				j = j + 1
			}

			return out
		}
		k = k + 1
	}

	return out
}

const str_in = (Str x, [Str] xs): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(xs.len) then break
		if eq(xs[i], x) then return true
		i = i + 1
	}

	return false
}

# Does type argument `arg` satisfy a bound naming union `b`? The subtyping relation of §8.2:
#   - reflexive: `arg == b` (a union satisfies its own bound);
#   - member→union: `arg` is a member of `b` (`Int8 <: Int` — a compose-over leaf);
#   - union→superunion: `arg` is a union whose members are a SUBSET of `b`'s (`Int <: Number`).
# Member identity is by NAME. A shared member reaches `b` either by `...spread` or, since
# compose-over
# (§8.1, resolve.cf `compose_member`), by a bare member naming a record/union — the member→union
# branch below correctly accepts such a compose-over arg (`Circle` satisfying `[Shape 'T]`). The
# branch is guarded to a NON-union arg so a union named the same as one of `b`'s members routes
# through the subset check instead, not the member shortcut. Residual laxity: two independently
# -declared unions with identical member-NAME sets read as sub/supertypes though their inline
# members
# are (union,name)-scoped distinct — harmless (a bound is a comptime gate, §8.5).
const bound_satisfied = (*MonoCtx m, Str arg, Str b): Bool -> {
	if eq(arg, b) then return true
	const [Str] bmem = union_mem_names(m, b)
	if !is_union_name(m, arg) && str_in(arg, bmem) then return true
	if is_union_name(m, arg) then {
		const [Str] amem = union_mem_names(m, arg)
		if Iarch(amem.len) == 0 then return false
		let Iarch i = 0

		loop {
			if i >= Iarch(amem.len) then break
			if !str_in(amem[i], bmem) then return false
			i = i + 1
		}

		return true
	}

	return false
}

# Check each type argument satisfies its parameter's BOUND (`[Color 'T]`) by the §8.2 subtyping
# relation (reflexive, member→union, union→superunion — see `bound_satisfied`). An unbounded
# parameter (`""`) accepts any argument. (The bound-is-a-union check is done at decl time above.)
const check_params = (*MonoCtx m, [Str] typarams, [Str] tbounds, [Str] margs): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(typarams.len) then break
		if i >= Iarch(margs.len) then return mrec_i(m, "cf: type: a generic parameter has no argument\n")
		const Str arg = margs[i]
		if is_tvar(typarams[i]) then {
			# a TYPE parameter — its argument must be a type (not a value), and satisfy any bound
			if is_num_arg(arg)
				then return mrec_i(m, "cf: type: a comptime value was given where a type is expected\n")
			const Str b = tbounds[i]
			if !eq(b, "") then {
				if !is_union_name(m, b) then return mrec_i(m, "cf: type: a generic bound must name a union\n")
				if !bound_satisfied(m, arg, b)
					then return mrec_i(m, "cf: type: a type argument does not satisfy its bound\n")
			}
		}
		if !is_tvar(typarams[i]) then {
			# a comptime VALUE parameter — its type must be Iarch/Uarch and its argument a value
			const Str vt = tbounds[i]
			if !eq(vt, "Iarch") && !eq(vt, "Uarch")
				then return mrec_i(m, "cf: type: a comptime value parameter must be typed Iarch or Uarch\n")
			if !is_num_arg(arg)
				then return mrec_i(m, "cf: type: a type was given where a comptime value is expected\n")
		}
		i = i + 1
	}

	return 0
}

# A bare or negated integer literal — a WEAK inference source: it fixes a type variable only
# when no non-literal argument does, since an integer literal ADOPTS its context's width
# (`hash(x, 0)` with `x : Uint8` infers `Uint8`, not `Iarch`, from `x`).
const is_int_lit = (Expr e): Bool -> match unat(e) {
	Expr.Lit(v) -> true,
	Expr.Neg(x) -> match unat(x) { Expr.Lit(v) -> true, _ -> false },
	_ -> false,
}

# A TYPE-parameter name (`'T`, apostrophe-led) vs a comptime VALUE-parameter name (a plain ident).
const is_tvar = (Str s): Bool -> {
	if Iarch(s.len) == 0 then return false

	return Iarch(s[0]) == 39
}

# A comptime VALUE argument — an int-literal source string (`8`) — vs a TYPE argument (a name).
const is_num_arg = (Str s): Bool -> {
	if Iarch(s.len) == 0 then return false
	const Iarch c = Iarch(s[0])

	return c >= 48 && c <= 57
}

# Decimal string → integer (a value argument's literal, folded into the instance body).
const str_to_int = (Str s): Iarch -> {
	let Iarch v = 0
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break
		const Iarch c = Iarch(s[i])
		if c >= 48 && c <= 57 then v = v * 10 + (c - 48)
		i = i + 1
	}

	return v
}

const name_in_venv = (Str n, [VarTy] venv): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(venv.len) then break
		if eq(venv[i].name, n) then return true
		i = i + 1
	}

	return false
}

# Fold a variable reference: a comptime value parameter (`n`) becomes its literal — UNLESS a real
# local/parameter of the same name shadows it (inner binding wins), in which case it is left as
# the variable reference. Anything else is unchanged.
const vp_fold = (Str n, MonoEnv env): Expr -> {
	if name_in_venv(n, env.venv) then return Expr.Var(n)
	let Iarch i = 0

	loop {
		if i >= Iarch(env.vpnames.len) then break
		if eq(env.vpnames[i], n) then return Expr.Lit(env.vpvals[i])
		i = i + 1
	}

	return Expr.Var(n)
}

# --- substitution --------------------------------------------------------------------------

const subst_ty = (Str name, [Str] tvars, [Str] tvals): Str -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(tvars.len) then break
		if eq(tvars[i], name) then return tvals[i]
		i = i + 1
	}

	return name
}

const subst_tys = ([Str] names, [Str] tvars, [Str] tvals): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(names.len) then break
		out = [...out, subst_ty(names[i], tvars, tvals)]
		i = i + 1
	}

	return out
}

# Substitute type variables inside a tuple's position list — a nested position recurses, a leaf
# MANGLES its name — so a `('T, Iarch)` param/return in a generic instance is concretized, and an
# APPLICATION leaf (`Maybe['B]` in a fn-type return position) resolves to its registered instance.
const subst_telems! = (*MonoCtx m, [TupElem] tels, [Str] tvars, [Str] tvals): [TupElem] -> {
	let [TupElem] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(tels.len) then break
		const TupElem t = tels[i]
		# a nested TUPLE or nested FUNCTION-TYPE position keeps its structure — recurse into `sub` so
		# a `((A) -> B) -> R` function-type component survives monomorphization (a leaf drops `sub`)
		if eq(t.name, "$tuple")
			then out = [...out, TupElem({ name: "$tuple", sub: subst_telems!(m, t.sub, tvars, tvals) })]
		if eq(t.name, "$fn")
			then out = [...out, TupElem({ name: "$fn", sub: subst_telems!(m, t.sub, tvars, tvals) })]
		if !eq(t.name, "$tuple") && !eq(t.name, "$fn") then {
			let [TupElem] none = []
			out = [...out, TupElem({ name: mangle_type!(m, t.name, tvars, tvals), sub: none })]
		}
		i = i + 1
	}

	return out
}

# Substitute across a per-position tuple-type list (a record's `ftelems` / a union member's
# `ptelems`, one `[TupElem]` per field/payload position), concretizing a `('T, Iarch)` tuple
# field/payload when a generic record/union is cloned.
const subst_telemss! = (*MonoCtx m, [[TupElem]] tlss, [Str] tvars, [Str] tvals): [[TupElem]] -> {
	let [[TupElem]] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(tlss.len) then break
		out = [...out, subst_telems!(m, tlss[i], tvars, tvals)]
		i = i + 1
	}

	return out
}

# --- array-typed type variables --------------------------------------------------------------
# A type variable may be instantiated to an ARRAY type, encoded as an EMPTY-base bracket string
# `[Elem]` (`[Iarch]`, `[Point]`) — the form `ty_name` produces for a `TDyn`. It is distinct
# from a generic application `Base[Args]` (non-empty base) and a scalar name (no bracket).
const is_arr_enc = (Str s): Bool -> {
	if Iarch(s.len) == 0 then return false

	return Iarch(s[0]) == 91  # '['
}

# The element of an array encoding — `[Iarch]` → `Iarch`, `[[Iarch]]` → `[Iarch]`.
const arr_elem! = (Str s): Str -> {
	let [Uint8] out = []
	let Iarch i = 1

	loop {
		if i + 1 >= Iarch(s.len) then break
		out = [...out, s[i]]
		i = i + 1
	}

	return Str(out)
}

# A fully-substituted type SLOT — the `type_name`/`elem`/`telems` trio a parameter, return,
# field, or payload occupies (cf splits a type across these three positions).
data TySlot = { Str name, Str elem, [TupElem] telems }

# Substitute type variables across a whole type slot. A bare type variable may resolve to a
# COMPOUND type — an array `[X]` becomes a `$dyn` slot with element X — so the ENTIRE trio is
# rewritten, not just the scalar name. A type variable bound to a TUPLE, or nested as a `[...]`
# element (`['T]` at `'T = [Iarch]` → a dynamic array of arrays), is a later brick — the latter
# is cleanly rejected here.
const subst_slot! = (*MonoCtx m, Str name, Str elem, [TupElem] telems, [Str] tvars, [Str] tvals): TySlot -> {
	const [TupElem] no_tel = []
	# an array slot `[E]` — the element is substituted as a name (a type variable there may itself
	# expand to an array, `['T]` at `'T = [Iarch]` → the element `[Iarch]`, i.e. a nested dynamic
	# array — `mangle_type`'s empty-base branch produces the nested encoding, which emit supports)
	if eq(name, "$dyn")
		then return TySlot({ name: "$dyn", elem: mangle_type!(m, elem, tvars, tvals), telems: no_tel })
	# a tuple slot `(...)` — substitute each position (leaves stay scalar; see the later-brick note)
	if eq(name, "$tuple")
		then return TySlot({ name: "$tuple", elem: elem, telems: subst_telems!(m, telems, tvars, tvals) })
	# a bare name — a type variable here may expand to an ARRAY type
	const Str bound = subst_ty(name, tvars, tvals)
	if is_arr_enc(bound)
		then return TySlot({
		name: "$dyn",
		elem: mangle_type!(m, arr_elem!(bound), tvars, tvals),
		telems: no_tel,
	})

	# scalar / record / union / generic application
	return TySlot({
		name: mangle_type!(m, name, tvars, tvals),
		elem: subst_ty(elem, tvars, tvals),
		telems: subst_telems!(m, telems, tvars, tvals),
	})
}

# The three parallel per-position slot lists (a record's `ftypes`/`felems`/`ftelems`, a union
# member's `payloads`/`pelems`/`ptelems`), each position substituted as a whole slot.
data SlotList = { [Str] names, [Str] elems, [[TupElem]] telemss }

const subst_slots! = (
	*MonoCtx m,
	[Str] names,
	[Str] elems,
	[[TupElem]] telemss,
	[Str] tvars,
	[Str] tvals,
): SlotList -> {
	let [Str] ns = []
	let [Str] es = []
	let [[TupElem]] ts = []
	let Iarch i = 0

	loop {
		if i >= Iarch(names.len) then break
		const TySlot s = subst_slot!(m, names[i], elems[i], telemss[i], tvars, tvals)
		ns = [...ns, s.name]
		es = [...es, s.elem]
		ts = [...ts, s.telems]
		i = i + 1
	}

	return SlotList({ names: ns, elems: es, telemss: ts })
}

# The concrete instance name for `gname` applied to `tyargs` — `id[Iarch]` → `id$Iarch`,
# `pair[Iarch, Color]` → `pair$Iarch$Color`. The `$` separator never occurs in a source name or
# in resolve's `__<tag>` private-mangling, so (template, args) → name is injective (no collision
# between `pair[Iarch, Str]` and a `pair__Iarch[Str]`). The name is only a resolution key —
# emit names every function positionally (`$f<idx>`), so the `$` never reaches a QBE symbol.
const mangle_instance = (Str gname, [Str] tyargs): Str -> {
	let Str s = gname
	let Iarch i = 0

	loop {
		if i >= Iarch(tyargs.len) then break
		s = "${s}$${tyargs[i]}"
		i = i + 1
	}

	return s
}

# --- generic TYPE applications ('Base[a, b]', a bracketed string from the parser) ------------

# Whether a type reference is a generic application (`Box[Iarch]`) rather than a bare name.
const is_type_app = (Str s): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break
		if Iarch(s[i]) == 91 then return true  # '['
		i = i + 1
	}

	return false
}

# The base name of a type application — `Box[Iarch]` → `Box`.
const type_base! = (Str s): Str -> {
	let [Uint8] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break
		if Iarch(s[i]) == 91 then break
		out = [...out, s[i]]
		i = i + 1
	}

	return Str(out)
}

# The top-level argument type references of a type application — `Box[Pair[Iarch,Iarch]]` →
# `["Pair[Iarch,Iarch]"]`, splitting only at depth-1 commas so nested applications stay whole.
const type_args! = (Str s): [Str] -> {
	let Iarch start = 0

	loop {
		if start >= Iarch(s.len) then break
		if Iarch(s[start]) == 91 then break
		start = start + 1
	}

	let [Str] out = []
	let [Uint8] cur = []
	let Iarch depth = 0
	let Iarch i = start

	loop {
		if i >= Iarch(s.len) then break
		const Iarch c = Iarch(s[i])
		if c == 91 then {
			depth = depth + 1
			if depth > 1 then cur = [...cur, s[i]]
		}
		if c == 93 then {
			depth = depth - 1
			if depth >= 1 then cur = [...cur, s[i]]
		}
		if c == 44 && depth == 1 then {
			out = [...out, Str(cur)]
			cur = []
		}
		if c != 91 && c != 93 && !(c == 44 && depth == 1) then cur = [...cur, s[i]]
		i = i + 1
	}

	if Iarch(cur.len) > 0 then out = [...out, Str(cur)]

	return out
}

const find_rec_template = ([RecDecl] recs, Str n): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(recs.len) then break
		if eq(recs[i].name, n) then return i
		i = i + 1
	}

	return -1
}

const type_key_seen = (*MonoCtx m, Str mn): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(m.type_keys.len) then break
		if eq(m.type_keys[i], mn) then return true
		i = i + 1
	}

	return false
}

# Resolve a type reference to its concrete name, substituting type variables and mangling any
# generic application to its instance (`'T` → `Iarch`; `Box['T]` → `Box$Iarch`, generating the
# `Box$Iarch` record). Recurses through nested applications and registers each instance.
const mangle_type! = (*MonoCtx m, Str name, [Str] tvars, [Str] tvals): Str -> {
	if !is_type_app(name) then return subst_ty(name, tvars, tvals)
	const Str base = type_base!(name)
	# an EMPTY base is the array encoding `[Elem]` (not a generic application) — mangle the
	# element and keep the encoding; `subst_slot` later expands it into a `$dyn` type slot
	if eq(base, "") then return "[${mangle_type!(m, arr_elem!(name), tvars, tvals)}]"
	const [Str] args = type_args!(name)
	let [Str] margs = []
	let Iarch i = 0

	loop {
		if i >= Iarch(args.len) then break
		margs = [...margs, mangle_type!(m, args[i], tvars, tvals)]
		i = i + 1
	}

	return ensure_type_instance!(m, base, margs)
}

const find_union_template = ([UnionDecl] unions, Str n): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(unions.len) then break
		if eq(unions[i].name, n) then return i
		i = i + 1
	}

	return -1
}

# Is a declared type NAME a well-formed generic application (or not an application at all)? A
# `Base[args]` must name a generic record/union TEMPLATE; the empty-base `[Elem]` is the array
# encoding, not an application. Applying `[...]` to a non-generic (or undeclared) type is an error
# (247) — and is otherwise missed for a declaration that is never instantiated (a non-generic
# program never runs `mangle_concrete_sigs`).
const type_app_ok! = (*MonoCtx m, Str name): Bool -> {
	if !is_type_app(name) then return true
	const Str base = type_base!(name)
	if eq(base, "") then return true

	return find_rec_template(m.rec_templates, base) >= 0 ||
		find_union_template(m.union_templates, base) >= 0
}

const check_names_type_apps! = (*MonoCtx m, [Str] names): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(names.len) then break
		if !type_app_ok!(m, names[i])
			then mrec(m, "cf: type: a generic type application names a non-generic or undeclared type\n")
		i = i + 1
	}

	return 0
}

# Validate every generic type-application named in a CONCRETE declaration — record fields, union
# member payloads, and function parameter/return types — so an unused bogus application (247) is
# still rejected.
const check_concrete_type_apps! = (*MonoCtx m): Iarch -> {
	let Iarch r = 0

	loop {
		if r >= Iarch(m.crecs.len) then break
		set_stamp(m, m.crecs[r].dfile, m.crecs[r].dline, m.crecs[r].dcol)
		check_names_type_apps!(m, m.crecs[r].ftypes)
		r = r + 1
	}

	let Iarch u = 0

	loop {
		if u >= Iarch(m.cunions.len) then break
		set_stamp(m, m.cunions[u].dfile, m.cunions[u].dline, m.cunions[u].dcol)
		let Iarch mi = 0

		loop {
			if mi >= Iarch(m.cunions[u].members.len) then break
			check_names_type_apps!(m, m.cunions[u].members[mi].payloads)
			mi = mi + 1
		}

		u = u + 1
	}

	let Iarch f = 0

	loop {
		if f >= Iarch(m.cfuncs.len) then break
		set_stamp(m, m.cfuncs[f].dfile, m.cfuncs[f].dline, m.cfuncs[f].dcol)
		let Iarch pi = 0

		loop {
			if pi >= Iarch(m.cfuncs[f].params.len) then break
			if !type_app_ok!(m, m.cfuncs[f].params[pi].type_name)
				then mrec(m, "cf: type: a generic type application names a non-generic or undeclared type\n")
			pi = pi + 1
		}

		if !type_app_ok!(m, m.cfuncs[f].ret_name)
			then mrec(m, "cf: type: a generic type application names a non-generic or undeclared type\n")
		f = f + 1
	}

	return 0
}

# A generic type application resolves to a concrete record OR union instance.
const ensure_type_instance! = (*MonoCtx m, Str base, [Str] margs): Str -> {
	if find_rec_template(m.rec_templates, base) >= 0 then return ensure_rec_instance!(m, base, margs)
	if find_union_template(m.union_templates, base) >= 0
		then return ensure_union_instance!(m, base, margs)

	return mrec_s(
		m,
		"cf: type: a generic type application names a non-generic or undeclared type\n",
		base,
	)
}

# Ensure the concrete union instance `base[margs]` exists (cloning the template, substituting
# its type parameters in every member payload type — which may register further instances, e.g.
# a recursive `List['T]` referencing `List['T]`) and return its mangled name.
const ensure_union_instance! = (*MonoCtx m, Str base, [Str] margs): Str -> {
	const Str mn = mangle_instance(base, margs)
	if type_key_seen(m, mn) then return mn
	m.type_keys = [...m.type_keys, mn]  # mark before recursing so a recursive union terminates
	const Iarch ui = find_union_template(m.union_templates, base)
	const UnionDecl tmpl = m.union_templates[ui]
	if Iarch(tmpl.typarams.len) != Iarch(margs.len)
		then return mrec_s(m, "cf: type: wrong number of type arguments for a generic type\n", mn)
	check_params(m, tmpl.typarams, tmpl.tbounds, margs)
	let [UnionMember] members = []
	let Iarch mi = 0

	loop {
		if mi >= Iarch(tmpl.members.len) then break
		const UnionMember um = tmpl.members[mi]
		const SlotList ps = subst_slots!(m, um.payloads, um.pelems, um.ptelems, tmpl.typarams, margs)
		members = [
			...members,
			UnionMember({ name: um.name, payloads: ps.names, pelems: ps.elems, ptelems: ps.telemss }),
		]
		mi = mi + 1
	}

	const [Str] no_tp = []
	m.union_instances = [
		...m.union_instances,
		UnionDecl({
			name: mn,
			members: members,
			typarams: no_tp,
			tbounds: no_tp,
			dfile: tmpl.dfile,
			dline: tmpl.dline,
			dcol: tmpl.dcol,
		}),
	]

	return mn
}

const mangle_types! = (*MonoCtx m, [Str] names, [Str] tvars, [Str] tvals): [Str] -> {
	let [Str] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(names.len) then break
		out = [...out, mangle_type!(m, names[i], tvars, tvals)]
		i = i + 1
	}

	return out
}

# Ensure the concrete record instance `base[margs]` exists (cloning the template, substituting
# its type parameters in every field type — which may register further instances) and return
# its mangled name.
const ensure_rec_instance! = (*MonoCtx m, Str base, [Str] margs): Str -> {
	const Str mn = mangle_instance(base, margs)
	if type_key_seen(m, mn) then return mn
	m.type_keys = [...m.type_keys, mn]  # mark before recursing (a self-referential type terminates)
	const Iarch ri = find_rec_template(m.rec_templates, base)
	if ri < 0
		then return mrec_s(
		m,
		"cf: type: a generic type application names a non-generic or undeclared type\n",
		mn,
	)
	const RecDecl tmpl = m.rec_templates[ri]
	if Iarch(tmpl.typarams.len) != Iarch(margs.len)
		then return mrec_s(m, "cf: type: wrong number of type arguments for a generic type\n", mn)
	check_params(m, tmpl.typarams, tmpl.tbounds, margs)
	const SlotList fs = subst_slots!(m, tmpl.ftypes, tmpl.felems, tmpl.ftelems, tmpl.typarams, margs)
	const [Str] no_tp = []
	m.rec_instances = [
		...m.rec_instances,
		RecDecl({
			name: mn,
			fields: tmpl.fields,
			ftypes: fs.names,
			felems: fs.elems,
			ftelems: fs.telemss,
			fptrs: tmpl.fptrs,
			typarams: no_tp,
			tbounds: no_tp,
			fsizes: tmpl.fsizes,
			dfile: tmpl.dfile,
			dline: tmpl.dline,
			dcol: tmpl.dcol,
		}),
	]

	return mn
}

# --- local type environment (for inference) ------------------------------------------------

# List concatenation (cf has no `[...a, ...b]` double-spread); used to assemble the whole-
# program `Ctx` from the concrete declarations plus the instances generated so far.
# NB: build a fresh array from `[]` and copy BOTH inputs — `let o = a` would alias `a`'s backing
# store, and the in-place spread-append would then grow (mutate) the caller's array.
const cat_funcs = ([Func] a, [Func] b): [Func] -> {
	let [Func] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(a.len) then break
		o = [...o, a[i]]
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(b.len) then break
		o = [...o, b[j]]
		j = j + 1
	}

	return o
}

const cat_recs = ([RecDecl] a, [RecDecl] b): [RecDecl] -> {
	let [RecDecl] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(a.len) then break
		o = [...o, a[i]]
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(b.len) then break
		o = [...o, b[j]]
		j = j + 1
	}

	return o
}

const cat_unions = ([UnionDecl] a, [UnionDecl] b): [UnionDecl] -> {
	let [UnionDecl] o = []
	let Iarch i = 0

	loop {
		if i >= Iarch(a.len) then break
		o = [...o, a[i]]
		i = i + 1
	}

	let Iarch j = 0

	loop {
		if j >= Iarch(b.len) then break
		o = [...o, b[j]]
		j = j + 1
	}

	return o
}

const all_recs = (*MonoCtx m): [RecDecl] -> cat_recs(m.crecs, m.rec_instances)

const all_unions = (*MonoCtx m): [UnionDecl] -> cat_unions(m.cunions, m.union_instances)

# The whole-program typing context the shared `type_of` needs: every concrete function/record/
# union PLUS every instance generated so far (so a call to an already-instantiated generic, or a
# field of a generated record instance, resolves). `frt` is the enclosing function's return type.
const build_ctx = (*MonoCtx m, Ty ret): Ctx -> Ctx({
	funcs: cat_funcs(m.cfuncs, m.instances),
	recs: all_recs(m),
	unions: all_unions(m),
	frt: ret,
	frsize: 0,
	# the CURRENT-DECL stamp rides along, so a shared-helper rejection during inference
	# (latched via a recording bag) names the declaration being walked, not `:0:0`
	dfile: m.dfile,
	dline: m.dline,
	dcol: m.dcol,
	# no source tables here — a span offset cannot map, so inference rejections keep the
	# declaration stamp (line_col_of returns line 0 on an empty table)
	maps: no_maps(),
})

# The enclosing function's return type as a `Ty` (for `Ctx.frt`, which `type_of` consults for a
# value-yielding loop that `return`s): a tuple return is its position list, an empty name is the
# implicit `Int`, otherwise the named scalar/record/union/array type.
const ret_ty = (*MonoCtx m, Str rn, Str re, [TupElem] rtel): Ty -> {
	if Iarch(rtel.len) > 0 then return Ty.TTuple(rtel)
	if Iarch(rn.len) == 0 then return Ty.TInt
	# a `'T` surviving to here means inference could not pin it — say so at the declaration
	# being walked instead of falling into `named_ty`'s unlocated backstop
	if Iarch(rn.len) > 0 && Iarch(rn[0]) == 39
		then return mrec_ty(
		m,
		"cf: type: a generic call's type argument could not be inferred — annotate the binding or pass the type argument explicitly\n",
	)

	return named_ty(rn, re, all_recs(m), all_unions(m))
}

# A concrete declaration's own signature may still NAME a generic type (a function returning
# `Maybe[Iarch]`, a record field of type `Box[Iarch]`). The shared `type_of` needs those names
# already resolved to their instances, so pre-mangle every concrete signature (which also
# registers the referenced instances). Bodies are irrelevant to `type_of`, so a function keeps
# only its signature here (the OUTPUT still comes from `mono_func`, with the body intact).
const mangle_func_sig! = (*MonoCtx m, Func f): Func -> {
	const [Str] nt = []
	let [Param] ps = []
	let Iarch i = 0

	loop {
		if i >= Iarch(f.params.len) then break
		const Param p = f.params[i]
		ps = [
			...ps,
			Param({
				name: p.name,
				is_ptr: p.is_ptr,
				type_name: mangle_type!(m, p.type_name, nt, nt),
				elem: mangle_type!(m, p.elem, nt, nt),
				telems: p.telems,
				size: p.size,
			}),
		]
		i = i + 1
	}

	const [Stmt] nobody = []

	return Func({
		name: f.name,
		is_pub: f.is_pub,
		ret_name: mangle_type!(m, f.ret_name, nt, nt),
		ret_elem: mangle_type!(m, f.ret_elem, nt, nt),
		params: ps,
		body: nobody,
		is_asm: f.is_asm,
		asm_body: f.asm_body,
		is_value: f.is_value,
		ret_telems: f.ret_telems,
		typarams: f.typarams,
		tbounds: f.tbounds,
		ret_size: f.ret_size,
		is_intrinsic: f.is_intrinsic,
		asm_sym: f.asm_sym,
		dfile: f.dfile,
		dline: f.dline,
		dcol: f.dcol,
	})
}

const mangle_rec_sig! = (*MonoCtx m, RecDecl r): RecDecl -> {
	const [Str] nt = []

	return RecDecl({
		name: r.name,
		fields: r.fields,
		ftypes: mangle_types!(m, r.ftypes, nt, nt),
		felems: mangle_types!(m, r.felems, nt, nt),
		ftelems: r.ftelems,
		fptrs: r.fptrs,
		typarams: r.typarams,
		tbounds: r.tbounds,
		fsizes: r.fsizes,
		dfile: r.dfile,
		dline: r.dline,
		dcol: r.dcol,
	})
}

const mangle_union_sig! = (*MonoCtx m, UnionDecl u): UnionDecl -> {
	const [Str] nt = []
	let [UnionMember] mem = []
	let Iarch i = 0

	loop {
		if i >= Iarch(u.members.len) then break
		const UnionMember um = u.members[i]
		mem = [
			...mem,
			UnionMember({
				name: um.name,
				payloads: mangle_types!(m, um.payloads, nt, nt),
				pelems: mangle_types!(m, um.pelems, nt, nt),
				ptelems: um.ptelems,
			}),
		]
		i = i + 1
	}

	return UnionDecl({
		name: u.name,
		members: mem,
		typarams: u.typarams,
		tbounds: u.tbounds,
		dfile: u.dfile,
		dline: u.dline,
		dcol: u.dcol,
	})
}

# Replace the concrete declarations in `m` with their signature-mangled forms (§ above).
const mangle_concrete_sigs! = (*MonoCtx m): Iarch -> {
	let [Func] fs = []
	let Iarch i = 0

	loop {
		if i >= Iarch(m.cfuncs.len) then break
		fs = [...fs, mangle_func_sig!(m, m.cfuncs[i])]
		i = i + 1
	}

	m.cfuncs = fs
	let [RecDecl] rs = []
	let Iarch j = 0

	loop {
		if j >= Iarch(m.crecs.len) then break
		rs = [...rs, mangle_rec_sig!(m, m.crecs[j])]
		j = j + 1
	}

	m.crecs = rs
	let [UnionDecl] us = []
	let Iarch k = 0

	loop {
		if k >= Iarch(m.cunions.len) then break
		us = [...us, mangle_union_sig!(m, m.cunions[k])]
		k = k + 1
	}

	m.cunions = us

	return 0
}

const env_bind = (MonoEnv e, Str name, Ty ty): MonoEnv -> MonoEnv({
	tvars: e.tvars,
	tvals: e.tvals,
	venv: [
		...e.venv,
		VarTy({
			name: name,
			ty: ty,
			mutable: false,
			esc: false,
			outer: false,
			fixed: false,
			is_ref: false,
			fsize: 0,
			elem: "",
		}),
	],
	ret: e.ret,
	vpnames: e.vpnames,
	vpvals: e.vpvals,
})

# The concrete type NAME an argument denotes, for inference — derived by the SAME `type_of` the
# typechecker uses, over the threaded `[VarTy]` environment (parameters + `let`/match/`for`/
# destructure binders) and the whole-program context. So a field read `p.x`, a call result
# `f(x)`, a match/loop binder, etc. all resolve, not just the literal/var/construction cases a
# shallow guesser could see. This is only ever reached under generic instantiation — a program
# with no templates (cf's own source) has nothing to infer, so `type_of` is never invoked there
# and the pass stays a byte-identical identity on it. A `""` result denotes an array/tuple/
# pointer type (no type variable is inferred to one — that structural inference is a later brick).
const arg_ty! = (*MonoCtx m, Expr e, MonoEnv env): Str -> {
	if !m.has_gen then return ""
	let DiagBag fdg = record_dg()
	const Str r = ty_name(type_of!(e, env.venv, build_ctx(m, env.ret), &fdg))
	if fdg.hot then mrec_at(m, fdg.file, fdg.line, fdg.col, fdg.msg)

	return r
}

# Infer a generic call's type arguments: for each type variable, a parameter whose declared
# type IS that variable fixes it to the corresponding argument's type. A variable no parameter
# mentions (or whose argument type is unknown) cannot be inferred — an error.
# --- structural type-argument inference -----------------------------------------------------
# Peel one `[...]` bracket level off a type-name STRING (`"[Iarch]"` → `"Iarch"`, `"[[X]]"` →
# `"[X]"`);
# "" if the string does not name a bracketed array.
const bracket_inner! = (Str s): Str -> {
	const Iarch n = Iarch(s.len)
	if n < 2 then return ""
	if Iarch(s[0]) != 91 then return ""
	if Iarch(s[n - 1]) != 93 then return ""
	let [Uint8] out = []
	let Iarch i = 1

	loop {
		if i >= n - 1 then break
		out = [...out, s[i]]
		i = i + 1
	}

	return Str(out)
}

# Match a `[...]` parameter element STRING `pe` (which mentions the type variable `tv`, possibly
# under
# more brackets) against an argument array's element STRING `ae`, returning what `tv` binds to — or
# "" if `pe` does not mention `tv` or the array nesting does not line up.
const infer_from_elem! = (Str tv, Str pe, Str ae): Str -> {
	if eq(pe, tv) then return ae
	const Str pin = bracket_inner!(pe)
	if eq(pin, "") then return ""
	const Str ain = bracket_inner!(ae)
	if eq(ain, "") then return ""

	return infer_from_elem!(tv, pin, ain)
}

# A signature-position name a type variable may bind to: a concrete component name — not the
# empty name and not a `$`-marker leaf (`$dyn`/`$tuple`, which a closure binding carries for an
# aggregate parameter and which names no nominal type).
const bindable_name = (Str n): Bool -> {
	if Iarch(n.len) == 0 then return false

	return Iarch(n[0]) != 36
}

# Match a tuple (or function-signature) parameter's element list `ptel` against an argument's
# `atel`, returning what `tv` binds to at the first position that mentions it (or "").
const infer_from_telems! = (Str tv, [TupElem] ptel, [TupElem] atel): Str -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ptel.len) then break
		if i < Iarch(atel.len) then {
			if eq(ptel[i].name, tv) && bindable_name(atel[i].name) then return atel[i].name

			if eq(ptel[i].name, "$tuple") || eq(ptel[i].name, "$fn") then {
				const Str b = infer_from_telems!(tv, ptel[i].sub, atel[i].sub)
				if !eq(b, "") then return b
			} else {
				const Str eb = infer_from_elem!(tv, ptel[i].name, atel[i].name)
				if !eq(eb, "") then return eb
			}
		}
		i = i + 1
	}

	return ""
}

# What the type variable `tv` binds to given a template parameter and its argument's inferred type —
# by STRUCTURE: the whole parameter (`'T`), an array element (`['T]`, `[['T]]`), or a tuple position
# (`('T, Iarch)`). "" if the parameter does not mention `tv`.
const infer_from_param! = (Str tv, Param p, Ty at): Str -> {
	if eq(p.type_name, tv) then return ty_name(at)
	if eq(p.type_name, "$dyn") then {
		const Str ae = dyn_of(at)
		if eq(ae, "") then return ""

		return infer_from_elem!(tv, p.elem, ae)
	}
	if eq(p.type_name, "$tuple") then return infer_from_telems!(tv, p.telems, tuple_elems(at))

	return ""
}

# The signature telems (`[args..., ret]`) a function-VALUE argument carries, for `$fn`-parameter
# inference: a hoisted lambda / forwarded function parameter is a `TFn` binding in the value
# environment (newest-first, shadowing), and a bare top-level function name contributes its
# declared signature. Any other argument carries none (the parameter then fixes no variable).
const fn_arg_sig! = (*MonoCtx m, Expr e, MonoEnv env): [TupElem] -> {
	let [TupElem] sig = []
	const Str nm = match unat(e) { Expr.Var(n) -> n, _ -> "" }
	if eq(nm, "") then return sig
	let Iarch i = Iarch(env.venv.len) - 1

	loop {
		if i < 0 then break
		if eq(env.venv[i].name, nm) then {
			match env.venv[i].ty { Ty.TFn(s) -> { sig = s }, _ -> {} }

			return sig
		}
		i = i - 1
	}

	let Iarch f = 0

	loop {
		if f >= Iarch(m.cfuncs.len) then break
		if eq(m.cfuncs[f].name, nm) then {
			match fn_ty_of_func!(m.cfuncs[f]) { Ty.TFn(s) -> { sig = s }, _ -> {} }

			return sig
		}
		f = f + 1
	}

	return sig
}

const infer_tyargs! = (*MonoCtx m, Func tmpl, [Expr] args, MonoEnv env): [Str] -> {
	let [Str] tvals = []
	let Iarch t = 0

	loop {
		if t >= Iarch(tmpl.typarams.len) then break
		const Str tv = tmpl.typarams[t]
		# a NON-literal argument fixes the variable authoritatively; an integer literal only
		# fixes it if nothing else does (it would otherwise adopt, not pin, the width). A type
		# variable may sit anywhere in a parameter's type — the whole type, a `['T]` array element,
		# or a `('T, ...)` tuple position — so the binding is read out STRUCTURALLY.
		let Str strong = ""
		let Str weak = ""
		let Iarch p = 0

		loop {
			if p >= Iarch(tmpl.params.len) then break
			# a binding can only come from a parameter whose type is the variable itself, an array /
			# tuple that could nest it, or a FUNCTION type mentioning it (`('A) -> 'B`) — skip every
			# other parameter WITHOUT typing its argument. A function-value argument is a bare name
			# `type_of` rejects, so its signature is read directly (a lambda's declared types, a
			# named function's) and matched structurally like a tuple's positions.
			const Str pn = tmpl.params[p].type_name
			if eq(pn, "$fn") && p < Iarch(args.len) then {
				const Str fb = infer_from_telems!(tv, tmpl.params[p].telems, fn_arg_sig!(m, args[p], env))
				if !eq(fb, "") then strong = fb
			}
			const Bool shaped = eq(pn, tv) || eq(pn, "$dyn") || eq(pn, "$tuple")
			if shaped && p < Iarch(args.len) then {
				let DiagBag fdg = record_dg()
				const Ty at = type_of!(args[p], env.venv, build_ctx(m, env.ret), &fdg)
				if fdg.hot then mrec_at(m, fdg.file, fdg.line, fdg.col, fdg.msg)
				const Str b = infer_from_param!(tv, tmpl.params[p], at)
				if !eq(b, "") then {
					# only a bare integer literal filling the WHOLE `'T` parameter is weak
					if eq(pn, tv) && is_int_lit(args[p]) then weak = b
						else strong = b
				}
			}
			p = p + 1
		}

		let Str bound = strong
		if eq(bound, "") then bound = weak
		tvals = [...tvals, bound]
		t = t + 1
	}

	# phase 2: a variable no ordinary argument pinned may still be derivable from a lambda
	# argument's BODY (type_system §5.2 — the expected function type gives the params their
	# types, and the body then yields the return): substitute the pinned variables into the
	# `$fn` parameter's argument positions, type the lambda's parameters from them, then type
	# the (already-monomorphized) body's first return under that environment — the result pins
	# the variable sitting in the signature's return position.
	let Iarch t2 = 0

	loop {
		if t2 >= Iarch(tmpl.typarams.len) then break
		if eq(tvals[t2], "")
			then tvals = set_at(tvals, t2, infer_from_lam_body!(m, tmpl, tmpl.typarams[t2], args, env, tvals))
		t2 = t2 + 1
	}

	let Iarch t3 = 0

	loop {
		if t3 >= Iarch(tvals.len) then break
		if eq(tvals[t3], "")
			then tvals = set_at(
			tvals,
			t3,
			mrec_s(m, "cf: type: cannot infer a type argument for a generic call\n", "Iarch"),
		)
		t3 = t3 + 1
	}

	return tvals
}

const set_at = ([Str] xs, Iarch i, Str v): [Str] -> {
	let [Str] out = []
	let Iarch j = 0

	loop {
		if j >= Iarch(xs.len) then break
		if j == i then out = [...out, v]
			else out = [...out, xs[j]]
		j = j + 1
	}

	return out
}

# Whether a telem tree is free of type variables (a leaf name never starts `'`, at any depth).
const telems_concrete = ([TupElem] tel): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(tel.len) then break
		const Str n = tel[i].name
		if Iarch(n.len) > 0 && Iarch(n[0]) == 39 then return false
		if Iarch(n.len) > 1 && Iarch(n[0]) == 91 && Iarch(n[1]) == 39 then return false
		if !telems_concrete(tel[i].sub) then return false
		i = i + 1
	}

	return true
}

# The `Ty` of one signature-position telem (concrete names only — checked by the caller).
const sig_pos_ty! = (*MonoCtx m, TupElem te): Ty -> {
	if eq(te.name, "$fn") then return Ty.TFn(te.sub)
	if eq(te.name, "$tuple") then return Ty.TTuple(te.sub)
	if Iarch(te.name.len) > 1 && Iarch(te.name[0]) == 91 then return Ty.TDyn(bracket_inner!(te.name))

	return named_ty(te.name, "", all_recs(m), all_unions(m))
}

# Derive `tv` from a lambda argument's body: find a `$fn` parameter whose RETURN position
# mentions `tv`, resolve its argument to a locally-declared closure, type the closure's
# parameters (its own annotations first, else the pinned-substituted argument positions),
# then type the body's first `return` under them. "" when no lambda argument decides it.
const infer_from_lam_body! = (
	*MonoCtx m,
	Func tmpl,
	Str tv,
	[Expr] args,
	MonoEnv env,
	[Str] tvals,
): Str -> {
	# the pinned-only substitution pairs
	let [Str] ptvars = []
	let [Str] ptvals = []
	let Iarch pv = 0

	loop {
		if pv >= Iarch(tvals.len) then break
		if !eq(tvals[pv], "") then {
			ptvars = [...ptvars, tmpl.typarams[pv]]
			ptvals = [...ptvals, tvals[pv]]
		}
		pv = pv + 1
	}

	let Iarch p = 0

	loop {
		if p >= Iarch(tmpl.params.len) then break
		if eq(tmpl.params[p].type_name, "$fn") && p < Iarch(args.len) then {
			const Str b = lam_ret_bind!(m, tmpl.params[p].telems, tv, args[p], env, ptvars, ptvals)
			if !eq(b, "") then return b
		}
		p = p + 1
	}

	return ""
}

const lam_ret_bind! = (
	*MonoCtx m,
	[TupElem] ptel,
	Str tv,
	Expr arg,
	MonoEnv env,
	[Str] ptvars,
	[Str] ptvals,
): Str -> {
	const Iarch n = Iarch(ptel.len)
	if n < 1 then return ""
	# the return position must mention the variable (else this parameter decides nothing)
	if !mentions_tv!(ptel[n - 1].name, tv) then return ""
	const Str nm = match unat(arg) { Expr.Var(vn) -> vn, _ -> "" }
	if eq(nm, "") then return ""
	const Iarch li = find_lam(m, nm)
	if li < 0 then return ""

	return match m.lam_decls[li] {
		Stmt.Closure(cn, cps, cret, cbody) ->
			lam_body_ret!(m, ptel, tv, cps, cbody, env, ptvars, ptvals),
		_ -> "",
	}
}

# Whether a leaf name mentions `tv` (bare or under array brackets).
const mentions_tv! = (Str n, Str tv): Bool -> {
	if eq(n, tv) then return true
	const Str inner = bracket_inner!(n)
	if eq(inner, "") then return false

	return mentions_tv!(inner, tv)
}

const lam_body_ret! = (
	*MonoCtx m,
	[TupElem] ptel,
	Str tv,
	[Param] cps,
	[Stmt] cbody,
	MonoEnv env,
	[Str] ptvars,
	[Str] ptvals,
): Str -> {
	const [TupElem] stel = subst_telems!(m, ptel, ptvars, ptvals)
	const Iarch arity = Iarch(stel.len) - 1
	if Iarch(cps.len) != arity then return ""
	# every argument position must be concrete after substitution — the lambda's parameters
	# type from them (its own annotation wins where present)
	let [VarTy] cenv = [...env.venv]
	let Iarch i = 0

	loop {
		if i >= arity then break
		let Ty pt = Ty.TNever
		if !eq(cps[i].type_name, "") then pt = param_ty!(cps[i], all_recs(m), all_unions(m))
			else {
			let [TupElem] one = []
			one = [...one, stel[i]]
			if !telems_concrete(one) then return ""
			pt = sig_pos_ty!(m, stel[i])
		}
		cenv = [
			...cenv,
			VarTy({
				name: cps[i].name,
				ty: pt,
				mutable: false,
				esc: false,
				outer: false,
				fixed: false,
				is_ref: false,
				fsize: 0,
				elem: "",
			}),
		]
		i = i + 1
	}

	# the first top-level `return` decides; a leading sibling closure binds, a `let` binds —
	# anything else gives up (annotate then)
	let Iarch s = 0

	loop {
		if s >= Iarch(cbody.len) then break

		let Str got = "$stop"

		match cbody[s] {
			Stmt.Closure(inm, ips, iret, ibody) -> {
				got = ""
				cenv = [
					...cenv,
					VarTy({
						name: inm,
						ty: closure_tfn(iret, ips),
						mutable: false,
						esc: false,
						outer: false,
						fixed: false,
						is_ref: false,
						fsize: 0,
						elem: "",
					}),
				]
			},
			Stmt.Let(ln, lm, lann, le) -> {
				got = ""
				let DiagBag ldg = record_dg()
				const Ty lt = binding_ty!(lann, le, cenv, build_ctx(m, env.ret), &ldg)
				cenv = [
					...cenv,
					VarTy({
						name: ln,
						ty: lt,
						mutable: false,
						esc: false,
						outer: false,
						fixed: false,
						is_ref: false,
						fsize: 0,
						elem: "",
					}),
				]
			},
			Stmt.Return(re) -> {
				let DiagBag rdg = record_dg()
				const Ty rt = type_of!(re, cenv, build_ctx(m, env.ret), &rdg)
				if !rdg.hot then {
					const Str rn = ty_name(rt)
					if !eq(rn, "") then {
						# read the binding out of the UNsubstituted return position
						const Str pr = ptel[Iarch(ptel.len) - 1].name
						if eq(pr, tv) then got = rn
							else got = infer_from_elem!(tv, pr, rn)
						if eq(got, "") then got = "$stop"
					}
				}
			},
			_ -> {},
		}

		if eq(got, "$stop") then return ""
		if !eq(got, "") then return got
		s = s + 1
	}

	return ""
}

const fresh_lam_names = (): [Str] -> []

const fresh_lam_decls = (): [Stmt] -> []

const find_lam = (*MonoCtx m, Str nm): Iarch -> {
	let Iarch i = Iarch(m.lam_names.len) - 1

	loop {
		if i < 0 then break
		if eq(m.lam_names[i], nm) then return i
		i = i - 1
	}

	return -1
}

# --- cloning + rewriting -------------------------------------------------------------------

# Ensure the instance of `gname` with concrete `tyargs` exists (generating it, and transitively
# any instance its body needs), and return its mangled name.
const ensure_instance! = (*MonoCtx m, Str gname, [Str] tyargs): Str -> {
	const Str mn = mangle_instance(gname, tyargs)
	if key_seen(m, mn) then return mn
	m.keys = [...m.keys, mn]  # mark before recursing so a recursive generic terminates
	const Iarch ti = find_template(m.templates, gname)
	const Func tmpl = m.templates[ti]
	if Iarch(tmpl.typarams.len) != Iarch(tyargs.len)
		then return mrec_s(m, "cf: type: a generic call has the wrong number of type arguments\n", mn)
	check_params(m, tmpl.typarams, tmpl.tbounds, tyargs)
	const Func clone = mono_func!(m, tmpl, mn, tmpl.typarams, tyargs)
	m.instances = [...m.instances, clone]

	return mn
}

# Clone a function with `tvars` → `tvals` substituted in every type position (parameters,
# return, local annotations, nested generic call arguments) and its generic calls rewritten to
# instances. `newname` is the (concrete) result name.
const mono_func! = (*MonoCtx m, Func f, Str newname, [Str] tvars, [Str] tvals): Func -> {
	if m.mhot then return f
	# a declared INTRINSIC passes through untouched: its body is empty (nothing to rewrite) and
	# its signature may be generic without the template machinery — the env-seeding below would
	# choke resolving `'T` params it has no substitution for
	if f.is_intrinsic then return f
	# rejections below name this declaration (an instance names its template's decl); the
	# caller's stamp is restored on exit — an instantiation fires mid-walk of another body
	const Str odf = m.dfile
	const Iarch odl = m.dline
	const Iarch odc = m.dcol
	set_stamp(m, f.dfile, f.dline, f.dcol)
	# split the parameters: a TYPE parameter (`'T`) drives type substitution; a comptime VALUE
	# parameter (`n`, its arg an int literal) is FOLDED to its literal in the body — so the two
	# have distinct machineries (`subst_slot` vs a `Var → Lit` fold threaded on the env).
	let [Str] tvars_t = []
	let [Str] tvals_t = []
	let [Str] vpnames = []
	let [Iarch] vpvals = []
	let Iarch ti = 0

	loop {
		if ti >= Iarch(tvars.len) then break

		if is_tvar(tvars[ti]) then {
			tvars_t = [...tvars_t, tvars[ti]]
			tvals_t = [...tvals_t, tvals[ti]]
		} else {
			vpnames = [...vpnames, tvars[ti]]
			vpvals = [...vpvals, str_to_int(tvals[ti])]
		}

		ti = ti + 1
	}

	let [Param] ps = []
	let Iarch i = 0

	loop {
		if i >= Iarch(f.params.len) then break
		const Param p = f.params[i]
		# substitute `'T` across EVERY type position of the parameter as one slot — the scalar/
		# record name (or a generic application → its instance), a `[T]` array element, a tuple,
		# AND the case where `'T` itself resolves to an array type (→ a `$dyn` slot)
		const TySlot pst = subst_slot!(m, p.type_name, p.elem, p.telems, tvars_t, tvals_t)
		ps = [
			...ps,
			Param({
				name: p.name,
				is_ptr: p.is_ptr,
				type_name: pst.name,
				elem: pst.elem,
				telems: pst.telems,
				size: p.size,
			}),
		]
		i = i + 1
	}

	const TySlot rst = subst_slot!(m, f.ret_name, f.ret_elem, f.ret_telems, tvars_t, tvals_t)
	const Str rn = rst.name
	const Str re = rst.elem
	const [TupElem] rtel = rst.telems
	# seed the local value env with the (substituted) parameter types, so a generic call in the
	# body can infer from a parameter reference. Only under generics: a non-generic function has
	# nothing to instantiate, so the env stays empty and `type_of` is never invoked on it.
	let Ty ret = Ty.TInt
	let [VarTy] venv = []
	if m.has_gen then {
		ret = ret_ty(m, rn, re, rtel)
		let Iarch pi = 0

		loop {
			if pi >= Iarch(ps.len) then break
			# mirror typecheck's own param env: a `*T` param is a reference (is_ref/outer), so a
			# type_of! walk over the body accepts forwarded pointers exactly as check_func! does —
			# with is_ref stuck false, the first program mixing generics (which seed this env) and
			# `*Record` forwarding dies in the §700 bare-value check during instantiation
			venv = [
				...venv,
				VarTy({
					name: ps[pi].name,
					ty: param_ty!(ps[pi], all_recs(m), all_unions(m)),
					mutable: false,
					esc: false,
					outer: ps[pi].is_ptr,
					fixed: false,
					is_ref: ps[pi].is_ptr,
					fsize: 0,
					elem: ps[pi].elem,
				}),
			]
			pi = pi + 1
		}
	}
	const MonoEnv env = MonoEnv({
		tvars: tvars_t,
		tvals: tvals_t,
		venv: venv,
		ret: ret,
		vpnames: vpnames,
		vpvals: vpvals,
	})
	# the closure table is per-BODY: save the (suspended) outer walk's, start fresh, restore
	# after — `ensure_instance!` re-enters this fn mid-walk
	const [Str] slnames = m.lam_names
	const [Stmt] sldecls = m.lam_decls
	m.lam_names = fresh_lam_names()
	m.lam_decls = fresh_lam_decls()
	const [Stmt] body = mono_stmts!(m, f.body, env)
	m.lam_names = slnames
	m.lam_decls = sldecls
	const [Str] no_tp = []
	set_stamp(m, odf, odl, odc)

	return Func({
		name: newname,
		is_pub: f.is_pub,
		ret_name: rn,
		ret_elem: re,
		params: ps,
		body: body,
		is_asm: f.is_asm,
		asm_body: f.asm_body,
		is_value: f.is_value,
		ret_telems: rtel,
		typarams: no_tp,
		tbounds: no_tp,
		ret_size: f.ret_size,
		is_intrinsic: f.is_intrinsic,
		asm_sym: f.asm_sym,
		dfile: f.dfile,
		dline: f.dline,
		dcol: f.dcol,
	})
}

# Resolve a callee name to its concrete instance: a generic callee is instantiated (type args
# explicit, or inferred from the ALREADY-monomorphized arguments `margs` — so a nested generic
# argument's result type is knowable), a non-generic one passes through; type args on a
# non-generic function are an error. Shared by an ordinary call and a `defer`-tap call.
const mono_callee! = (*MonoCtx m, Str n, [Str] ta, [Expr] margs, MonoEnv env): Str -> {
	# mangle (not just substitute) the explicit type arguments: an APPLICATION argument
	# (`map[Iarch, Maybe[Iarch]]`) resolves to its registered instance name, so the fn instance's
	# own mangled name stays bracket-free and its type values are concrete declared types
	const [Str] rty = mangle_types!(m, ta, env.tvars, env.tvals)
	const Iarch ti = find_template(m.templates, n)
	if ti >= 0 then {
		let [Str] fty = rty
		if Iarch(rty.len) == 0 then fty = infer_tyargs!(m, m.templates[ti], margs, env)

		return ensure_instance!(m, n, fty)
	}
	if Iarch(rty.len) > 0
		then return mrec_s(m, "cf: type: type arguments on a non-generic function\n", n)

	return n
}

# Rewrite a call: monomorphize the arguments, then rename the callee to its concrete instance.
const mono_call! = (*MonoCtx m, Str n, [Str] ta, [Expr] args, MonoEnv env): Expr -> {
	const [Expr] margs = mono_exprs!(m, args, env)
	const [Str] no_ty = []

	return Expr.Call(mono_callee!(m, n, ta, margs, env), no_ty, margs, "")
}

# Rewrite a `defer`-tap: like a call (a generic callee is instantiated), but there are no explicit
# type args (the pipe/prefix syntax carries none), so the callee is always inferred from `margs`.
const mono_defertap! = (*MonoCtx m, Str fn, [Expr] args, MonoEnv env): Expr -> {
	const [Expr] margs = mono_exprs!(m, args, env)
	const [Str] no_ta = []

	return Expr.DeferTap(mono_callee!(m, fn, no_ta, margs, env), margs)
}

# A bare generic-union construction `Maybe.Just(5)` (no explicit `Maybe[Iarch]`): infer the union's
# type arguments from the member's payload arg types. For each type parameter, the FIRST payload
# position that IS exactly that variable (`Just('T)` → position 0; a `Cons('T, *List['T])`'s nested
# `*List['T]` position is NOT a bare `'T` and is skipped, 929) fixes it to that argument's concrete
# type. Then resolve/register the concrete instance, exactly as an explicit application would.
const infer_union_instance! = (*MonoCtx m, Str base, Str mem, [Expr] margs, MonoEnv env): Str -> {
	const Iarch ui = find_union_template(m.union_templates, base)
	const UnionDecl tmpl = m.union_templates[ui]
	let Iarch mmi = -1
	let Iarch k = 0

	loop {
		if k >= Iarch(tmpl.members.len) then break
		if eq(tmpl.members[k].name, mem) then mmi = k
		k = k + 1
	}

	if mmi < 0
		then return mrec_s(m, "cf: type: a generic union construction names an unknown member\n", base)
	const UnionMember um = tmpl.members[mmi]
	let [Str] targs = []
	let Iarch ti = 0

	loop {
		if ti >= Iarch(tmpl.typarams.len) then break
		const Str tv = tmpl.typarams[ti]
		let Str bound = ""
		let Iarch pi = 0

		loop {
			if pi >= Iarch(um.payloads.len) then break
			if eq(bound, "") && eq(um.payloads[pi], tv) && pi < Iarch(margs.len)
				then bound = arg_ty!(m, margs[pi], env)
			pi = pi + 1
		}

		if eq(bound, "")
			then bound = mrec_s(
			m,
			"cf: type: cannot infer a generic union's type argument from its construction\n",
			"Iarch",
		)
		targs = [...targs, bound]
		ti = ti + 1
	}

	return ensure_union_instance!(m, base, targs)
}

const mono_unionmk! = (*MonoCtx m, Str t, Str mem, [Expr] args, MonoEnv env): Expr -> {
	const [Expr] margs = mono_exprs!(m, args, env)
	# a bare generic-union template name (no `[...]` args) — infer its instance from the payloads
	if !is_type_app(t) && find_union_template(m.union_templates, t) >= 0
		then return Expr.UnionMk(infer_union_instance!(m, t, mem, margs, env), mem, margs)

	return Expr.UnionMk(mangle_type!(m, t, env.tvars, env.tvals), mem, margs)
}

const mono_expr! = (*MonoCtx m, Expr e, MonoEnv env): Expr -> match e {
	Expr.At(o, inner) -> Expr.At(o, mono_expr!(m, inner, env)),
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	Expr.Var(n) -> vp_fold(n, env),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) ->
		Expr.Record(mangle_type!(m, n, env.tvars, env.tvals), mono_fields!(m, fs, env)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(mono_expr!(m, b, env), f),
	Expr.UnionMk(t, mem, args) -> mono_unionmk!(m, t, mem, args, env),
	Expr.Match(scrut, arms) -> mono_match!(m, scrut, arms, env),
	# the element tag (a `let ['T] out = []` annotation pushed into the literal) substitutes like
	# any type position — left raw, a generic clone's local array would keep a type-variable element
	Expr.ArrayLit(hs, sn, elems, et) ->
		Expr.ArrayLit(
		hs,
		mono_expr!(m, sn, env),
		mono_exprs!(m, elems, env),
		mangle_type!(m, et, env.tvars, env.tvals),
	),
	Expr.Index(a, i) -> Expr.Index(a, mono_expr!(m, i, env)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, mono_expr!(m, i, env), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(mono_expr!(m, b, env), mono_expr!(m, i, env)),
	Expr.Tuple(elems) -> Expr.Tuple(mono_exprs!(m, elems, env)),
	Expr.Spread(x) -> Expr.Spread(mono_expr!(m, x, env)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(mono_stmts!(m, body, env)),
	Expr.Interp(segs) -> Expr.Interp(mono_segs!(m, segs, env)),
	Expr.Buffer(sz) -> Expr.Buffer(mono_expr!(m, sz, env)),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(mono_expr!(m, x, env)),
	Expr.Not(x) -> Expr.Not(mono_expr!(m, x, env)),
	Expr.BitNot(x) -> Expr.BitNot(mono_expr!(m, x, env)),
	Expr.Add(l, r) -> Expr.Add(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.Sub(l, r) -> Expr.Sub(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.Mul(l, r) -> Expr.Mul(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.Div(l, r) -> Expr.Div(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.Mod(l, r) -> Expr.Mod(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.BitOr(l, r) -> Expr.BitOr(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.BitXor(l, r) -> Expr.BitXor(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.Shl(l, r) -> Expr.Shl(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.Shr(l, r) -> Expr.Shr(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.And(l, r) -> Expr.And(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.Or(l, r) -> Expr.Or(mono_expr!(m, l, env), mono_expr!(m, r, env)),
	Expr.If(c, t, e2) -> Expr.If(mono_expr!(m, c, env), mono_expr!(m, t, env), mono_expr!(m, e2, env)),
	Expr.Call(n, ta, args, g) -> with_geom(mono_call!(m, n, ta, args, env), g),
	Expr.DeferTap(fn, args) -> mono_defertap!(m, fn, args, env),
}

const mono_exprs! = (*MonoCtx m, [Expr] es, MonoEnv env): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(es.len) then break
		out = [...out, mono_expr!(m, es[i], env)]
		i = i + 1
	}

	return out
}

const mono_fields! = (*MonoCtx m, [FieldInit] fs, MonoEnv env): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: mono_expr!(m, fs[i].value, env) })]
		i = i + 1
	}

	return out
}

const mono_segs! = (*MonoCtx m, [Seg] segs, MonoEnv env): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(segs.len) then break
		const Seg sg = segs[i]
		out = [
			...out,
			Seg({ is_hole: sg.is_hole, lit: sg.lit, name: sg.name, expr: mono_expr!(m, sg.expr, env) }),
		]
		i = i + 1
	}

	return out
}

# The concrete union a match arm names: an explicitly-qualified `Maybe[Iarch]` is mangled; an
# unqualified `Maybe` on a generic union takes the SCRUTINEE's concrete instance type — itself
# mangled, since the scrutinee type may still be a raw application `Maybe[Iarch]` (a UnionMk or
# unannotated-`let` scrutinee) rather than an already-mangled `Maybe$Iarch` (a parameter); every
# other (a non-generic union, or a `_`) is unchanged.
const arm_type! = (*MonoCtx m, Str tn, Str scrut_ty, MonoEnv env): Str -> {
	if eq(tn, "") then return tn
	if is_type_app(tn) then return mangle_type!(m, tn, env.tvars, env.tvals)   # explicitly-qualified `Maybe[Iarch]`
	# an unqualified generic union resolves to the scrutinee's concrete instance. When the
	# scrutinee's type is NOT a known union here — typically it flows from an omitted return
	# type the retfill pass (which runs after this one) has not filled — the arms cannot
	# resolve; say what to annotate instead of leaking the template name downstream.
	if find_union_template(m.union_templates, tn) >= 0 then {
		if !names_known_union(m, scrut_ty)
			then return mrec_s(
			m,
			"cf: type: a `match` arm's generic union cannot be resolved from the scrutinee — annotate the scrutinee's binding (or the return type of the function it flows from)\n",
			tn,
		)

		return scrut_ty
	}

	return tn
}

const names_known_union = (*MonoCtx m, Str n): Bool -> {
	const [UnionDecl] us = all_unions(m)
	let Iarch i = 0

	loop {
		if i >= Iarch(us.len) then break
		if eq(us[i].name, n) then return true
		i = i + 1
	}

	return false
}

# Extend the environment with a match arm's payload bindings, so a generic call inside the arm
# body can infer from a bound name (`match m { Just(v) -> id(v) }`). Reuses the typechecker's
# `arm_bind_env` over the arm's CONCRETE union (`tn`); only engaged under generics.
const arm_env = (*MonoCtx m, Str tn, [Str] members, [Str] binds, MonoEnv env): MonoEnv -> {
	if !m.has_gen then return env
	if eq(tn, "") then return env
	if Iarch(binds.len) == 0 then return env
	# silent on failure — see `for_env!`: typecheck re-binds the arm post-fill
	let DiagBag fdg = record_dg()
	const [VarTy] nv = arm_bind_env(tn, members, binds, env.venv, build_ctx(m, env.ret), &fdg)

	return MonoEnv({
		tvars: env.tvars,
		tvals: env.tvals,
		venv: nv,
		ret: env.ret,
		vpnames: env.vpnames,
		vpvals: env.vpvals,
	})
}

const mono_arms! = (*MonoCtx m, [MatchArm] arms, MonoEnv env, Str scrut_ty): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		const Str at = arm_type!(m, a.type_name, scrut_ty, env)
		out = [
			...out,
			MatchArm({
				is_wild: a.is_wild,
				type_name: at,
				members: a.members,
				binds: a.binds,
				body: mono_expr!(m, a.body, arm_env(m, at, a.members, a.binds, env)),
			}),
		]
		i = i + 1
	}

	return out
}

# --- numeric type-switch (§8.3/§8.5) --------------------------------------------------------
# A comptime match over a numeric-bounded `'T`: `match x { Int.Int8(v) -> ..., Int.Int16(v) -> ...
# }`.
# After the scrutinee monomorphizes to a concrete width, exactly one arm is live (the rest are
# dead code), so it is RESOLVED here — before typecheck ever sees a match on a non-union scrutinee.
# A type-switch is detected by an arm naming an intrinsic numeric union (Int/Uint/Number).
const is_numeric_width = (Str s): Bool -> str_in(s, numeric_union_members("Number"))

const arms_name_numeric_union = ([MatchArm] arms): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		if is_numeric_union(arms[i].type_name) then return true
		i = i + 1
	}

	return false
}

# Comptime-select the arm matching width `st` (or the `_` wildcard), bind its value var to the
# scrutinee `ms` (`v := x`), and monomorphize the resulting body. Validates that each arm names a
# width IN its bound union (774) and that some arm covers `st` (773 exhaustiveness).
const resolve_numeric_typeswitch! = (*MonoCtx m, Expr ms, [MatchArm] arms, Str st, MonoEnv env): Expr -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		if !a.is_wild && Iarch(a.members.len) > 0 then {
			if !str_in(a.members[0], numeric_union_members(a.type_name))
				then mrec(m, "cf: type: a numeric type-switch arm names a width outside its bound union\n")
		}
		i = i + 1
	}

	let Iarch wi = -1
	let Iarch mi = -1
	let Iarch j = 0

	loop {
		if j >= Iarch(arms.len) then break
		const MatchArm a = arms[j]
		if a.is_wild
			then wi = j else {
			if Iarch(a.members.len) > 0 && eq(a.members[0], st) then mi = j
		}
		j = j + 1
	}

	let Iarch sel = mi
	if sel < 0 then sel = wi
	if sel < 0
		then return mrec_x(
		m,
		"cf: type: a numeric type-switch has no arm for the instantiated width and no `_`\n",
		ms,
	)
	const MatchArm chosen = arms[sel]
	let Expr body = chosen.body
	if !chosen.is_wild && Iarch(chosen.binds.len) > 0 then {
		const [Subst] su = [Subst({ param: chosen.binds[0], repl: ms })]
		body = subst_expr(body, su)
	}

	return mono_expr!(m, body, env)
}

# A match's arms name their union UNQUALIFIED; the concrete instance is the (monomorphized)
# scrutinee's type, derived by `type_of` over `ms` — so a match on a call result / constructed
# value / `let` binding all resolve, not only a bare parameter.
const mono_match! = (*MonoCtx m, Expr scrut, [MatchArm] arms, MonoEnv env): Expr -> {
	const Expr ms = mono_expr!(m, scrut, env)
	const Str st = arg_ty!(m, ms, env)
	if arms_name_numeric_union(arms) && is_numeric_width(st)
		then return resolve_numeric_typeswitch!(m, ms, arms, st, env)

	return Expr.Match(ms, mono_arms!(m, arms, env, st))
}

# Bind a `for x in xs` loop variable for the body's environment. cf binds EVERY `for` variable
# to a word (`check_for_body` — a genesis narrowing, regardless of the array's element type), so
# the inference env must bind it the same way; else a generic call on the binder would infer an
# instance the typechecker (which sees a word) rejects.
const venv_ty = ([VarTy] venv, Str name): Ty -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(venv.len) then break
		if eq(venv[i].name, name) then return venv[i].ty
		i = i + 1
	}

	return Ty.TInt
}

const for_env! = (*MonoCtx m, Str v, Str a, MonoEnv env): MonoEnv -> {
	if !m.has_gen then return env
	# bind the `for` variable at the array's ELEMENT type (matching typecheck's `check_for_body`), so a
	# generic call on the binder resolves the right instance (`for w in [Str]` → `id(w)` picks
	# `id[Str]`).
	const Str en = dyn_of(venv_ty(env.venv, a))
	# a failure binds the poison silently — the typechecker rebuilds this same environment
	# AFTER the retfill pass (an unannotated return reads as the word here) and reports for real
	let DiagBag fdg = record_dg()
	const Ty et = elem_ty!(en, build_ctx(m, env.ret), &fdg)

	return env_bind(env, v, et)
}

const mono_stmt! = (*MonoCtx m, Stmt s, MonoEnv env): Stmt -> match s {
	Stmt.Let(n, mut, ann, e) ->
		Stmt.Let(n, mut, mangle_type!(m, ann, env.tvars, env.tvals), mono_expr!(m, e, env)),
	Stmt.Destructure(pat, mut, e) -> Stmt.Destructure(pat, mut, mono_expr!(m, e, env)),
	Stmt.Yield(e) -> Stmt.Yield(mono_expr!(m, e, env)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, mono_expr!(m, e, env)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, mono_expr!(m, e, env)),
	Stmt.DeepFieldAssign(be, f, e) ->
		Stmt.DeepFieldAssign(mono_expr!(m, be, env), f, mono_expr!(m, e, env)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, mono_expr!(m, i, env), mono_expr!(m, v, env)),
	Stmt.Return(e) -> Stmt.Return(mono_expr!(m, e, env)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, mono_stmts!(m, body, for_env!(m, v, a, env))),
	Stmt.Loop(ll_, body) -> Stmt.Loop(ll_, mono_stmts!(m, body, env)),
	Stmt.Break(bl_) -> Stmt.Break(bl_),
	Stmt.Continue(bl_) -> Stmt.Continue(bl_),
	Stmt.IfThen(c, st) -> Stmt.IfThen(mono_expr!(m, c, env), mono_stmt!(m, st, env)),
	Stmt.IfElse(c, t, e) ->
		Stmt.IfElse(mono_expr!(m, c, env), mono_stmt!(m, t, env), mono_stmt!(m, e, env)),
	Stmt.Do(e) -> Stmt.Do(mono_expr!(m, e, env)),
	Stmt.Block(stmts) -> Stmt.Block(mono_stmts!(m, stmts, env)),
	Stmt.Match(scrut, arms) -> mono_stmt_match!(m, scrut, arms, env),
	Stmt.Closure(nm, params, ret, body) -> Stmt.Closure(nm, params, ret, mono_stmts!(m, body, env)),
	Stmt.Defer(body) -> Stmt.Defer(mono_stmts!(m, body, env)),
}

const mono_stmt_arms! = (*MonoCtx m, [StmtArm] arms, MonoEnv env, Str scrut_ty): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		const Str at = arm_type!(m, a.type_name, scrut_ty, env)
		out = [
			...out,
			StmtArm({
				is_wild: a.is_wild,
				type_name: at,
				members: a.members,
				binds: a.binds,
				body: mono_stmts!(m, a.body, arm_env(m, at, a.members, a.binds, env)),
			}),
		]
		i = i + 1
	}

	return out
}

const mono_stmt_match! = (*MonoCtx m, Expr scrut, [StmtArm] arms, MonoEnv env): Stmt -> {
	const Expr ms = mono_expr!(m, scrut, env)
	const Str st = arg_ty!(m, ms, env)

	return Stmt.Match(ms, mono_stmt_arms!(m, arms, env, st))
}

# Extend the environment for the statements after a destructure — the tuple binders' types via
# the typechecker's `check_destructure` over the (monomorphized) initializer.
const destr_env! = (*MonoCtx m, [Str] pat, Bool mut, Expr e, MonoEnv env): MonoEnv -> {
	# silent on failure — see `for_env!`: a destructure over a return the retfill pass has not
	# filled yet would otherwise reject a valid program; typecheck re-validates post-fill
	let DiagBag fdg = record_dg()
	const [VarTy] nv = check_destructure!(pat, mut, e, env.venv, build_ctx(m, env.ret), &fdg)

	return MonoEnv({
		tvars: env.tvars,
		tvals: env.tvals,
		venv: nv,
		ret: env.ret,
		vpnames: env.vpnames,
		vpvals: env.vpvals,
	})
}

# After a `let` / destructure, record the binding's type (via the typechecker's `binding_ty` /
# `check_destructure` over the monomorphized statement) so a later generic call can infer from it.
# Only under generics; a non-generic program never consults the environment, so this is skipped.
# The `let` binder's type via the typechecker's `binding_ty` (a rejection latches into `m`).
const let_env! = (*MonoCtx m, Str n, Str ann, Expr e, MonoEnv env): MonoEnv -> {
	# silent on failure — see `for_env!`: typecheck re-validates the binding post-fill
	let DiagBag fdg = record_dg()
	const Ty t = binding_ty!(ann, e, env.venv, build_ctx(m, env.ret), &fdg)

	return env_bind(env, n, t)
}

const mono_extend! = (*MonoCtx m, Stmt s, MonoEnv env): MonoEnv -> {
	if !m.has_gen then return env

	return match s {
		Stmt.Let(n, mut, ann, e) ->
			let_env!(m, n, ann, e, env),
		Stmt.Destructure(pat, mut, e) -> destr_env!(m, pat, mut, e, env),
		# a local closure enters the value env as its function type, so a later statement may
		# pass it (or an anonymous lambda's hoisted name) to a generic function
		Stmt.Closure(nm, params, ret, body) -> env_bind(env, nm, closure_tfn(ret, params)),
		_ -> env,
	}
}

const mono_stmts! = (*MonoCtx m, [Stmt] ss, MonoEnv env0): [Stmt] -> {
	let MonoEnv env = env0
	let [Stmt] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(ss.len) then break
		const Stmt ms = mono_stmt!(m, ss[i], env)
		out = [...out, ms]
		# record a local closure for the lambda-body inference (its consumers follow it)
		if m.has_gen then {
			match ms {
				Stmt.Closure(cn, cp, cr, cb) -> {
					m.lam_names = [...m.lam_names, cn]
					m.lam_decls = [...m.lam_decls, ms]
				},
				_ -> {},
			}
		}
		env = mono_extend!(m, ms, env)  # extend using the MONO'd statement (concrete types) for the rest
		i = i + 1
	}

	return out
}

# Whether every type variable mentioned in a type reference (a bare `'X` or the arguments of a
# generic application) is among `typarams` — used to reject a generic declaration's field/payload
# type that names an undeclared type variable.
const typevar_declared! = (Str name, [Str] typarams): Bool -> {
	if is_type_app(name) then {
		const [Str] args = type_args!(name)
		let Iarch i = 0

		loop {
			if i >= Iarch(args.len) then break
			if !typevar_declared!(args[i], typarams) then return false
			i = i + 1
		}

		return true
	}
	if Iarch(name.len) == 0 then return true
	if Iarch(name[0]) != 39 then return true
	let Iarch j = 0

	loop {
		if j >= Iarch(typarams.len) then break
		if eq(typarams[j], name) then return true
		j = j + 1
	}

	return false
}

const check_rec_templates! = (*MonoCtx m): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(m.rec_templates.len) then break
		const RecDecl r = m.rec_templates[i]
		let Iarch f = 0

		loop {
			if f >= Iarch(r.ftypes.len) then break
			if !typevar_declared!(r.ftypes[f], r.typarams)
				then mrec_at(
				m,
				r.dfile,
				r.dline,
				r.dcol,
				"cf: type: an undeclared type variable in a generic record field\n",
			)
			f = f + 1
		}

		flush_mono(m)
		i = i + 1
	}

	return 0
}

const check_union_templates! = (*MonoCtx m): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(m.union_templates.len) then break
		const UnionDecl un = m.union_templates[i]
		let Iarch mi = 0

		loop {
			if mi >= Iarch(un.members.len) then break
			let Iarch pj = 0

			loop {
				if pj >= Iarch(un.members[mi].payloads.len) then break
				if !typevar_declared!(un.members[mi].payloads[pj], un.typarams)
					then mrec_at(
					m,
					un.dfile,
					un.dline,
					un.dcol,
					"cf: type: an undeclared type variable in a generic union payload\n",
				)
				pj = pj + 1
			}

			mi = mi + 1
		}

		flush_mono(m)
		i = i + 1
	}

	return 0
}

# Monomorphize the program: drop the generic templates, rewrite every concrete function's body
# (registering the instances its generic calls need, transitively), then append all generated
# concrete instances. The result has no generic functions.
# The pass result: the monomorphized program plus the collected rejections. A non-empty
# `diags` means instantiation failed somewhere — the OUTPUT PROGRAM IS NOT USABLE then (a
# poisoned walk hands back inputs unsubstituted, and a failed instance is simply missing);
# the caller stops after this pass rather than let typecheck cascade on absent functions.
pub data MonoOut = { Program prog, [Diag] diags }

pub const mono_program! = (Program prog): MonoOut -> {
	let [Func] templates = []
	let [Func] concrete = []
	let Iarch i = 0

	loop {
		if i >= Iarch(prog.funcs.len) then break
		# a generic INTRINSIC (a declared bodyless token — raw ops like `place['T]`) is NOT a
		# template: its behavior is compiler-supplied at the call site, so there is nothing to
		# instantiate; it stays a concrete (skipped-body) function for the later gates to resolve.
		const Bool gen = Iarch(prog.funcs[i].typarams.len) > 0 && !prog.funcs[i].is_intrinsic
		# a std geometry module's generic value hooks (`on_alloc__fb`, `on_ret__el`, ... —
		# resolve gives those modules FIXED mangle tags, so the suffix identifies them) are
		# NOT mono templates: nothing in the AST ever calls them (the Materialize pass
		# instantiates them from the RAW program per placed type), and letting the dormant
		# trio into `templates` flips `has_gen` — switching every arena-using compile into
		# the full inference regime (+164MB RSS on a self-compile, measured). They are
		# dropped here exactly like an uninstantiated template after the pass.
		if gen && !geom_hook_tmpl(prog.funcs[i].name) then templates = [...templates, prog.funcs[i]]
		if !gen then concrete = [...concrete, prog.funcs[i]]
		i = i + 1
	}

	let [Str] unames = []
	let Iarch u = 0

	loop {
		if u >= Iarch(prog.unions.len) then break
		unames = [...unames, prog.unions[u].name]
		u = u + 1
	}

	# split generic RECORD templates from the concrete records the output keeps
	let [RecDecl] rec_templates = []
	let [RecDecl] concrete_recs = []
	let Iarch ri = 0

	loop {
		if ri >= Iarch(prog.recs.len) then break
		if Iarch(prog.recs[ri].typarams.len) > 0 then rec_templates = [...rec_templates, prog.recs[ri]]
			else concrete_recs = [...concrete_recs, prog.recs[ri]]
		ri = ri + 1
	}

	# and generic UNION templates from the concrete unions
	let [UnionDecl] union_templates = []
	let [UnionDecl] concrete_unions = []
	let Iarch vi = 0

	loop {
		if vi >= Iarch(prog.unions.len) then break
		if Iarch(prog.unions[vi].typarams.len) > 0
			then union_templates = [...union_templates, prog.unions[vi]]
			else concrete_unions = [...concrete_unions, prog.unions[vi]]
		vi = vi + 1
	}

	const [Diag] no_diags = []
	let [Func] no_inst = []
	let [Str] no_keys = []
	let [RecDecl] no_recinst = []
	let [Str] no_tk = []
	let [UnionDecl] no_uni = []
	const [Str] no_lnames = []
	const [Stmt] no_ldecls = []
	# whether the program has ANY generic template — if not (cf's own source), the inference
	# machinery (which drives the shared `type_of`) is never engaged and the pass is an identity
	let Bool has_gen = false
	if Iarch(templates.len) > 0 then has_gen = true
	if Iarch(rec_templates.len) > 0 then has_gen = true
	if Iarch(union_templates.len) > 0 then has_gen = true
	let MonoCtx m = MonoCtx({
		templates: templates,
		keys: no_keys,
		instances: no_inst,
		unions: unames,
		rec_templates: rec_templates,
		type_keys: no_tk,
		rec_instances: no_recinst,
		union_templates: union_templates,
		union_instances: no_uni,
		cfuncs: concrete,
		crecs: concrete_recs,
		cunions: concrete_unions,
		has_gen: has_gen,
		lam_names: no_lnames,
		lam_decls: no_ldecls,
		dfile: "",
		dline: 0,
		dcol: 0,
		mhot: false,
		mefile: "",
		meline: 0,
		mecol: 0,
		memsg: "",
		mdiags: no_diags,
	})
	# reject a generic record/union template whose field/payload names an undeclared type variable
	check_rec_templates!(&m)
	check_union_templates!(&m)
	check_template_bounds(&m)
	flush_mono(&m)
	# reject applying type arguments to a non-generic type in any concrete declaration (247)
	check_concrete_type_apps!(&m)
	flush_mono(&m)
	# resolve any generic type NAMED in a concrete signature to its instance, so the shared
	# `type_of` sees only concrete decls (skipped when there are no generics — the identity path)
	if has_gen then mangle_concrete_sigs!(&m)
	const [Str] no_tv = []
	let [Func] out = []
	let Iarch j = 0

	loop {
		if j >= Iarch(concrete.len) then break
		out = [...out, mono_func!(&m, concrete[j], concrete[j].name, no_tv, no_tv)]
		# one error per walked declaration (nested instantiations latch under the stamp that
		# was current when they failed — the template's, by the save/restore discipline)
		flush_mono(&m)
		j = j + 1
	}

	let Iarch k = 0

	loop {
		if k >= Iarch(m.instances.len) then break
		out = [...out, m.instances[k]]
		k = k + 1
	}

	# the output records: the concrete ones plus every generated generic-record instance
	let [RecDecl] out_recs = concrete_recs
	let Iarch g = 0

	loop {
		if g >= Iarch(m.rec_instances.len) then break
		out_recs = [...out_recs, m.rec_instances[g]]
		g = g + 1
	}

	# the output unions: the concrete ones plus every generated generic-union instance
	let [UnionDecl] out_unions = concrete_unions
	let Iarch h = 0

	loop {
		if h >= Iarch(m.union_instances.len) then break
		out_unions = [...out_unions, m.union_instances[h]]
		h = h + 1
	}

	flush_mono(&m)

	return MonoOut({
		prog: Program({
			imports: prog.imports,
			recs: out_recs,
			unions: out_unions,
			funcs: out,
			groups: prog.groups,
		}),
		diags: m.mdiags,
	})
}
