# Console barrel: re-export `print` from the platform implementation chosen at compile time by the
# fixed target (module_system). Only the winning branch is resolved — the losing branch is parsed
# to skip past it but its module file is never opened, so a target whose implementation does not
# exist yet costs nothing here.
import std::comptime::os
import std::sys::{ Os }

if os::target == Os.Darwin then {
	pub import std::io::console::arm64::darwin::{ print }
} else {
	pub import std::io::console::amd64::linux::{ print }
}
