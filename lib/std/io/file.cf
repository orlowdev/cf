# File barrel: re-export the WHOLE surface of the platform file module chosen at compile time by the
# fixed target (module_system). `as *` splices every member of the winning module in flat, so a new
# operation is never forgotten here. Only the winning branch is resolved; the loser is parsed to skip
# past it but its module file is never opened, so an unimplemented target costs nothing.
import std::comptime::os
import std::sys::{ Os }

if os::target == Os.Darwin then {
	pub import std::io::file::arm64::darwin as *
} else {
	if os::target == Os.Linux then {
		pub import std::io::file::linux as *
	}
}
