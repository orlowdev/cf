# std::io::fd — the shared IO carriers, platform-independent.
#
# `Fd` is a typed file descriptor: a newtype over the kernel's integer handle, so an fd can never be
# confused with an ordinary number (a byte count, a flag) at a call boundary. `file::open_read`/
# `create` mint one; `read`/`write`/`close` and the console take one.
#
# `IoErr` carries the failure of a fallible IO operation: the negated kernel `errno` (darwin returns
# `-errno` from a failed syscall, kept verbatim so the code is inspectable). Fallible operations in
# `std::io` return `Either[IoErr, T]` (std::data) — `Left(err)` on failure, `Right(value)` on success.
#
# `stdin`/`stdout`/`stderr` are the three POSIX standard descriptors as typed `Fd` values.
pub data Fd = { Uarch n }
pub data IoErr = { Iarch errno }

pub const stdin = Fd({ n: Uarch(0) })
pub const stdout = Fd({ n: Uarch(1) })
pub const stderr = Fd({ n: Uarch(2) })

# The positive errno an `IoErr` carries (the kernel returns it negated). `.errno` is the raw negative
# value; `code` flips it back for display or comparison against a POSIX number.
pub const code = (IoErr e): Iarch -> 0 - e.errno

# Meaning of a failure, so a caller branches on the cause instead of a raw number. The values below
# are the POSIX-common low errno numbers (identical on darwin and linux); higher-numbered codes
# diverge per platform and are not surfaced here yet.
pub const is_not_found = (IoErr e): Bool -> e.errno == 0 - 2
pub const is_permission = (IoErr e): Bool -> e.errno == 0 - 13 || e.errno == 0 - 1
pub const is_exists = (IoErr e): Bool -> e.errno == 0 - 17
pub const is_a_directory = (IoErr e): Bool -> e.errno == 0 - 21
pub const is_not_a_directory = (IoErr e): Bool -> e.errno == 0 - 20
pub const is_no_space = (IoErr e): Bool -> e.errno == 0 - 28

# Metadata about a filesystem entry, from `std::io::fs::stat!`. `size` is the byte length; `mode` is
# the raw permission-and-type word (POSIX `st_mode`). The file-type predicates read the top nibble of
# `mode` (`mode / 4096`): 4 = directory (S_IFDIR), 8 = regular file (S_IFREG), 10 = symlink (S_IFLNK).
pub data Stat = { Iarch size, Iarch mode }

pub const is_dir = (Stat s): Bool -> s.mode / 4096 == 4
pub const is_regular = (Stat s): Bool -> s.mode / 4096 == 8
pub const is_symlink = (Stat s): Bool -> s.mode / 4096 == 10
