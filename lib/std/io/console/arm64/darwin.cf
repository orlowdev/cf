# Console output for arm64/darwin. `print` writes a string to standard output (fd 1) with the
# darwin `write` system call (number 4), passing the string's byte buffer and length straight to
# the kernel. It yields unit — the write is an effect, not a value.
import "std/sys" as { syscall6 }
pub const print = (Str s): () -> {
	syscall6(4, 1, s.bytes, s.len, 0, 0, 0)
	return ()
}
