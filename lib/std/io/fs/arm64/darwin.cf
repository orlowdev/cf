# Filesystem operations for arm64/darwin — metadata and directory manipulation, over the raw BSD
# syscalls. Every fallible call returns `Either[IoRrr, T]` (darwin returns a negated errno on
# failure). `stat!` reads the 144-byte darwin `struct stat` (stat64 = syscall 338 on arm64; the
# legacy 188 returns garbage) and surfaces `st_size` (offset 96, i64) and `st_mode` (offset 4, u16).
import std::sys::{ syscall6 }
import std::data::{ Either }
import std::io::fd::{ IoRrr, rrr_of, Stat, DirEntry }

# Assemble a little-endian integer of `width` bytes from `buf` starting at `at`.
const le = (*[Uint8] buf, Iarch at, Iarch width): Iarch -> {
	let Iarch v = 0
	let Iarch mul = 1
	let Iarch k = 0

	loop {
		if k >= width then break

		v = v + Iarch(buf[at + k]) * mul
		mul = mul * 256
		k = k + 1
	}

	return v
}

# stat64() into `buf`. The `*[Uint8]` parameter is the hop a `[144 Uint8]` local needs to reach
# `syscall6`'s `Uarch` operand (a local array does not coerce to `Uarch` directly).
const stat_raw = (Str path, *[Uint8] buf): Iarch -> syscall6(338, path.bytes, buf, 0, 0, 0, 0)

# stat() a path (follows symlinks). `Right` carries a `Stat`; `Left` an error (e.g. IoRrr.NotFound).
pub const stat! = (Str path): Either[IoRrr, Stat] -> {
	let [144 Uint8] st
	const Iarch r = stat_raw(path, st)

	if r < 0 then return Either[IoRrr, Stat].Left(rrr_of(r))

	const Iarch size = le(st, 96, 8)
	const Iarch mode = le(st, 4, 2)

	return Either[IoRrr, Stat].Right(Stat({ size: size, mode: mode }))
}

# Does `path` exist (as anything)? A stat that succeeds means yes; any error (not just is_not_found)
# means the caller cannot see it, so `false`.
pub const exists! = (Str path): Bool -> match stat!(path) {
	Either.Left(e) -> false,
	Either.Right(s) -> true,
}

# The byte size of the file at `path`, or the stat error.
pub const file_size! = (Str path): Either[IoRrr, Iarch] -> match stat!(path) {
	Either.Left(e) -> Either[IoRrr, Iarch].Left(e),
	Either.Right(s) -> Either[IoRrr, Iarch].Right(s.size),
}

# mkdir() a directory at `path` with mode 0755 (= 493). `Right(0)` on success; `Left` an error
# (is_exists if it already exists).
pub const mkdir = (Str path): Either[IoRrr, Iarch] -> {
	const Iarch r = syscall6(136, path.bytes, 493, 0, 0, 0, 0)

	if r < 0 then return Either[IoRrr, Iarch].Left(rrr_of(r))

	return Either[IoRrr, Iarch].Right(r)
}

# rmdir() an empty directory at `path`.
pub const rmdir = (Str path): Either[IoRrr, Iarch] -> {
	const Iarch r = syscall6(137, path.bytes, 0, 0, 0, 0, 0)

	if r < 0 then return Either[IoRrr, Iarch].Left(rrr_of(r))

	return Either[IoRrr, Iarch].Right(r)
}

# access() — test the calling process's permission for `path`. `mode` is a bitmask: 1 = X_OK
# (executable), 2 = W_OK (writable), 4 = R_OK (readable), 0 = F_OK (exists). `true` when the
# check passes (the syscall returns 0), `false` on any error — so a missing or non-executable
# file both read as `false`. Used to resolve a program name against `PATH`.
pub const access = (Str path, Iarch mode): Bool ->
	syscall6(33, path.bytes, Uarch(mode), 0, 0, 0, 0) == 0

# unlink() — remove a file (not a directory) at `path`.
pub const remove = (Str path): Either[IoRrr, Iarch] -> {
	const Iarch r = syscall6(10, path.bytes, 0, 0, 0, 0, 0)

	if r < 0 then return Either[IoRrr, Iarch].Left(rrr_of(r))

	return Either[IoRrr, Iarch].Right(r)
}

# rename() `old` to `new` (moves across names on the same filesystem).
pub const rename = (Str old, Str new): Either[IoRrr, Iarch] -> {
	const Iarch r = syscall6(128, old.bytes, new.bytes, 0, 0, 0, 0)

	if r < 0 then return Either[IoRrr, Iarch].Left(rrr_of(r))

	return Either[IoRrr, Iarch].Right(r)
}

# chdir() — change the process working directory to `path`.
pub const chdir = (Str path): Either[IoRrr, Iarch] -> {
	const Iarch r = syscall6(12, path.bytes, 0, 0, 0, 0, 0)

	if r < 0 then return Either[IoRrr, Iarch].Left(rrr_of(r))

	return Either[IoRrr, Iarch].Right(r)
}

# getdirentries() into `buf`, returning bytes read (0 at end) or a negated errno. `fd` is an open
# directory; `basep` is an 8-byte scratch the kernel tracks position in. The `*[Uint8]` parameters
# are
# the hop the `[N Uint8]` locals need to reach `syscall6`'s `Uarch` operands.
const getdents_raw = (Iarch fd, *[Uint8] buf, Uarch n, *[Uint8] basep): Iarch ->
	syscall6(196, Uarch(fd), buf, n, basep, 0, 0)

# Copy `len` bytes from `buf` starting at `start` into a fresh owned `Str` — the raw directory
# buffer
# is scratch, so an entry name is lifted out of it before the buffer is reused.
const slice_str = (*[Uint8] buf, Iarch start, Iarch len): Str -> {
	let [Uint8] out = []
	let Iarch i = 0

	loop {
		if i >= len then break

		out = [...out, buf[start + i]]
		i = i + 1
	}

	return Str({ bytes: out, len: Iarch(out.len) })
}

# List a directory: `Right` carries a `[DirEntry]` (each with an owned `name` and a `kind`,
# including
# `.` and `..`); `Left` an error. Reads the legacy darwin dirent stream (getdirentries = syscall
# 196:
# d_reclen@4, d_type@6, d_namlen@7, d_name@8) in 8 KiB batches until it drains.
pub const read_dir! = (Str path): Either[IoRrr, [DirEntry]] -> {
	const Iarch fd = syscall6(5, path.bytes, 0, 0, 0, 0, 0)

	if fd < 0 then return Either[IoRrr, [DirEntry]].Left(rrr_of(fd))

	let [DirEntry] entries = []
	let [8192 Uint8] buf
	let [8 Uint8] basep = [0, 0, 0, 0, 0, 0, 0, 0]
	let Iarch err = 0

	loop {
		const Iarch n = getdents_raw(fd, buf, Uarch(8192), basep)

		if n < 0 then {
			err = n

			break
		}

		if n == 0 then break

		let Iarch off = 0

		loop {
			if off >= n then break

			const Iarch reclen = le(buf, off + 4, 2)
			const Iarch kind = Iarch(buf[off + 6])
			const Iarch namlen = Iarch(buf[off + 7])
			const Str name = slice_str(buf, off + 8, namlen)

			entries = [...entries, DirEntry({ name: name, kind: kind })]
			off = off + reclen
		}
	}

	syscall6(6, Uarch(fd), 0, 0, 0, 0, 0)

	if err < 0 then return Either[IoRrr, [DirEntry]].Left(rrr_of(err))

	return Either[IoRrr, [DirEntry]].Right(entries)
}
