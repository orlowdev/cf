# std::process — process-level control. `exit` terminates the running process with a status code.
# Platform-dispatched like `std::io::console`: only the winning target's module is opened, its whole
# surface spliced in flat, so a new process primitive is never forgotten here. `argv`/`env`/`spawn`
# will join this module as they land.
import std::comptime::os
import std::comptime::arch
import std::sys::{ Os, Arch }

if os::target == Os.Darwin then {
	pub import std::process::arm64::darwin as *
} else {
	if os::target == Os.Linux then {
		if arch::target == Arch.Amd64 then {
			pub import std::process::amd64::linux as *
		} else {
			pub import std::process::linux as *
		}
	}
}
