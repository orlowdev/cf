# The build's processor-architecture target descriptor (module_system §7.2). `target` is the arch
# the program is compiled FOR; `current` is the arch the compiler runs ON. Compiler-supplied
# comptime intrinsics, folded at parse against `--target` — never emitted. Reached by `::`:
# `import std::comptime::arch` then `arch::target == Arch.Arm64`.
import std::sys::{ Arch }

pub intrinsic target: Arch
pub intrinsic current: Arch
