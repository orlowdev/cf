# The build's operating-system target descriptor (module_system §7.2). `target` is the OS the
# program is compiled FOR; `current` is the OS the compiler runs ON (equal on a non-cross build).
# Both are compiler-supplied comptime intrinsics — a `comptime_if` condition folds them at parse
# against the `--target`, so they are never emitted. Reached by `::`: `import std::comptime::os`
# then `os::target == Os.Darwin`.
import std::sys::{ Os }

pub intrinsic target: Os
pub intrinsic current: Os
