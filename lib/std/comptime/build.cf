# The build CONFIGURATION descriptor: comptime facts about how THIS compile was invoked,
# beside `os`/`arch` (the target) and `version` (the program). Both are compiler-supplied
# intrinsics: a `comptime_if` folds them at parse (`if build::debug then ... else ...`
# selects declarations, the losing branch never emitted), and a VALUE-position reference
# folds to a `0`/`1` immediate — so gating costs nothing when the gate is off. Reached by
# `::`: `import std::comptime::build` then `build::debug`.

# True under `--debug`/`-g` — the build carries debug information (real symbol names, line
# directives). PASSIVE observability: gate extra assertions or diagnostics on it, never
# behavior a release build must keep.
pub intrinsic debug: Bool

# True under `--instrument` — the build asks for ACTIVE instrumentation (the memory
# geometries swap in accounting variants of their hooks). Distinct from `debug` because
# instrumentation perturbs the measured program — a time profile wants `--debug` alone.
pub intrinsic instrument: Bool
