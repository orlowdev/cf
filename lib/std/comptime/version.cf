# std::comptime::version — the version stamps the compiler bakes at the call site (module_system §7).
#
# `current` is the version of the PROGRAM being compiled: the string given to `cf … --version <v>`,
# defaulting to `0.0.0-dev` when the flag is absent. `compiler` is the version of the cf binary doing
# the compiling. Both are compiler-supplied comptime intrinsics — a bare reference materializes to a
# baked `Str` literal at the call site, exactly like a string literal: colorless, no `!`, nothing read
# at run time. Reached by `::`: `import std::comptime::version` then `version::current`.

# The version of the program being compiled, from `cf … --version` (default `0.0.0-dev`).
pub intrinsic current: Str
# The version of the cf compiler that is compiling this program.
pub intrinsic compiler: Str
