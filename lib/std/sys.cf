# The raw system-call primitive and the target-descriptor enums (module_system). `syscall6`
# traps into the kernel with up to six arguments; on darwin/arm64 the call number goes in `x16`
# and the arguments in `x0`–`x5`, dispatched by `svc #0x80`. Higher-level modules wrap it — user
# code should reach for `std/io/console` and friends, not this floor.
#
# LIFETIME NOTE: the compiler treats an asm body (this one included) as retaining nothing, so a
# buffer passed here is freed on its normal scope exit. That is correct for a SYNCHRONOUS syscall
# (the kernel copies/fills during the trap and keeps no pointer). It is NOT safe for an ASYNCHRONOUS
# one — the compiler does not track a value's survivability across a call whose completion outlives
# the trap. Async I/O must be driven by a wrapper that owns the buffer's lifetime until completion.
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Iarch ->
	asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	b.cc 1f
	neg x0, x0
1:
	ret
"

# The operating system and processor architecture a build targets. `comptime::os`/`comptime::arch`
# compare against these variants to select a platform implementation at compile time.
# `Bare` is the "OS" for a freestanding target — bare metal (no syscalls, a static root, MMIO) and,
# since it has no operating system either, Wasm (arch `Wasm`). `comptime::os::target == Os.Bare`
# selects the freestanding floor.
pub union Os = {
	# Apple's macOS/iOS kernel — the primary hosted target today.
	Darwin,
	# The Linux kernel.
	Linux,
	# No operating system — a freestanding target: bare metal (a static root, MMIO, no syscalls) and
	# Wasm, which likewise has no OS beneath it.
	Bare,
}
# The processor architecture a build targets. `comptime::arch::target` compares against these to pick
# instruction-level or ABI-specific code at compile time. `Wasm` pairs with `Os.Bare` — a WebAssembly
# target has a processor but no operating system.
pub union Arch = {
	# 64-bit ARM (AArch64) — the primary target today.
	Arm64,
	# 64-bit x86 (x86-64).
	Amd64,
	# 64-bit RISC-V.
	Riscv64,
	# WebAssembly — a virtual instruction set, always paired with `Os.Bare`.
	Wasm,
}
