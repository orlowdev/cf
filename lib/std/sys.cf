import std::comptime::os
import std::comptime::arch

if os::target == Os.Darwin
	then if arch::target == Arch.Amd64 then pub import std::sys::amd64::darwin as * 		# darwin/amd64
	else pub import std::sys::arm64::darwin as * 																				# darwin/arm64
else if os::target == Os.Linux
	then if arch::target == Arch.Amd64 then pub import std::sys::amd64::linux as * 			# linux/amd64
	else if arch::target == Arch.Riscv64 then pub import std::sys::riscv64::linux as *	# linux/riscv64
	else pub import std::sys::arm64::linux as * 																				# linux/arm64

# Union of operating system variants supported by the compiler.
#
# **NOTE**: member ORDER is ABI — emit folds a value-position `os::target` to the member's tag
# index (emit.cf's comptime cases). Append, never reorder.
pub union Os = {
	# Apple's macOS/iOS kernel — the primary hosted target today.
	Darwin,
	# The Linux kernel.
	Linux,
	# No operating system — a freestanding target: bare metal (a static root, MMIO, no syscalls) and
	# Wasm, which likewise has no OS beneath it.
	Bare,
}

# Union of processor architecture variants supported by the compiler.
#
# **NOTE**: member ORDER is ABI — emit folds a value-position `arch::target` to the member's tag
# index (emit.cf's comptime cases). Append, never reorder.
pub union Arch = {
	# 64-bit ARM (AArch64) — the primary target today.
	Arm64,
	# 64-bit x86 (x86-64).
	Amd64,
	# 64-bit RISC-V.
	Riscv64,
	# WebAssembly — a virtual instruction set, always paired with `Os.Bare`.
	Wasm,
}
