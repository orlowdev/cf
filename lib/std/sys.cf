# The raw system-call primitive and the target-descriptor enums (module_system). `syscall6` traps
# into the kernel with up to six arguments; its trap convention (call-number register, dispatch
# instruction, how failure is reported) is per-(arch, os), so the primitive itself lives in a
# platform module and this barrel re-exports the one the fixed target selects. `Bare` has no OS, so
# it gets NO `syscall6` — a freestanding program reaches the machine through `std::mem::raw` and
# MMIO
# instead. Higher-level modules wrap it — user code should reach for `std::io::console` and friends,
# not this floor. Only the winning branch is resolved; the losing branch's module file is never
# opened
# (parser discards it), so an unimplemented target costs nothing here.
#
# `syscall6` is the ONE piece that is genuinely per-(arch, os): the trap instruction and the
# call-number register differ by arch (arm64 `svc #0`/`x8`, riscv64 `ecall`/`a7`) and the failure
# convention by os. So it dispatches on both — the linux branch further on `arch::target`.
# Everything
# above it (std::io::*, std::process) rides linux's arch-independent generic ABI and is NOT
# arch-split.
# darwin dispatches on arch too (arm64 and amd64 share BSD syscall NUMBERS — the amd64 trap only
# differs
# in the `syscall` instruction and the `0x2000000` Unix-class bit — so only `syscall6` is
# arch-split).
import std::comptime::os
import std::comptime::arch

if os::target == Os.Darwin then {
	if arch::target == Arch.Amd64 then {
		pub import std::sys::amd64::darwin as *
	} else {
		pub import std::sys::arm64::darwin as *
	}
} else {
	if os::target == Os.Linux then {
		if arch::target == Arch.Riscv64 then {
			pub import std::sys::riscv64::linux as *
		} else {
			if arch::target == Arch.Amd64 then {
				pub import std::sys::amd64::linux as *
			} else {
				pub import std::sys::arm64::linux as *
			}
		}
	}
}

# The operating system and processor architecture a build targets. `comptime::os`/`comptime::arch`
# compare against these variants to select a platform implementation at compile time.
# `Bare` is the "OS" for a freestanding target — bare metal (no syscalls, a static root, MMIO) and,
# since it has no operating system either, Wasm (arch `Wasm`). `comptime::os::target == Os.Bare`
# selects the freestanding floor.
# NOTE: member ORDER (here and in `Arch`) is ABI — emit folds a value-position `os::target`/
# `arch::target` to the member's tag index (emit.cf's comptime cases). Append, never reorder.
pub union Os = {
	# Apple's macOS/iOS kernel — the primary hosted target today.
	Darwin,
	# The Linux kernel.
	Linux,
	# No operating system — a freestanding target: bare metal (a static root, MMIO, no syscalls) and
	# Wasm, which likewise has no OS beneath it.
	Bare,
}
# The processor architecture a build targets. `comptime::arch::target` compares against these to
# pick
# instruction-level or ABI-specific code at compile time. `Wasm` pairs with `Os.Bare` — a
# WebAssembly
# target has a processor but no operating system.
pub union Arch = {
	# 64-bit ARM (AArch64) — the primary target today.
	Arm64,
	# 64-bit x86 (x86-64).
	Amd64,
	# 64-bit RISC-V.
	Riscv64,
	# WebAssembly — a virtual instruction set, always paired with `Os.Bare`.
	Wasm,
}
