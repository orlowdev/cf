# std — the standard library's front door. Each area lives in its own barrel — `io` (files,
# streams, the terminal), `data` (the algebraic carriers, arrays, strings, json), `math`,
# `process` (process-level control), `sys` (the target's syscall surface), `comptime` (facilities
# the compiler supplies at the call site), `compiler` (the cf compiler as a library), `test` —
# and this barrel re-exports them all, so `import std` opens the whole tree as `std::io::…`,
# `std::data::…`, and the rest. Importing an area's own barrel directly stays the everyday
# spelling; this root exists so the surface is one structure, not a directory listing.

pub import std::comptime
pub import std::compiler
pub import std::data
pub import std::io
pub import std::math
pub import std::process
pub import std::sys
pub import std::test
