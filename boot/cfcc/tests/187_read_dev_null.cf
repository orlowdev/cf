# reading /dev/null yields 0 bytes (immediate EOF); exit 0 — exercises open+read+close
# expect: exit 0
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Int -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const open = (*[Uint8] path, Uarch flags, Uarch mode): Int -> syscall6(5, path, flags, mode, 0, 0, 0)
pub const read = (Uarch fd, *[Uint8] buf, Uarch n): Int -> syscall6(3, fd, buf, n, 0, 0, 0)
pub const close = (Uarch fd): Int -> syscall6(6, fd, 0, 0, 0, 0, 0)
pub const main = () -> {
	const Int fd = open("/dev/null".bytes, 0, 0)
	let [16 Uint8] buf
	const Int n = read(fd, buf, 16)
	close(fd)
	return n
}
