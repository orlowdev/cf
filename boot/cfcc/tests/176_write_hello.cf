# write to stdout via a syscall6 asm floor; exit code = bytes written (6)
# syscall6/write return Int as a test convenience (exit code = byte count, no Uarch cast
# needed); the ratified floor returns Uarch — see 177 for the spec-faithful shape.
# expect: exit 6
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Int -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const write = (Uarch fd, *[Uint8] buf, Uarch n): Int -> {
	return syscall6(4, fd, buf, n, 0, 0, 0)
}
pub const main = () -> {
	const Str msg = "hello\n"
	return write(1, msg.bytes, msg.len)
}
