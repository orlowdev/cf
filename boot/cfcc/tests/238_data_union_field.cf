# a record field may be a tag-only union (a word field carrying the tag)
# expect: exit 105
union Color = { Red, Green, Blue }
data Cell = { Int n, Color c }
pub const main = () -> {
	const Cell cell = { n: 5, c: Color.Green }
	return cell.n + (match cell.c {
		Color.Red -> 0,
		Color.Green -> 100,
		Color.Blue -> 200,
	})
}
