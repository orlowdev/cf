# an aggregate field may be spread-updated when it is explicitly overridden (not copied)
# expect: exit 11
data Point = { Int x, Int y }
data Box = { Point p, Int tag }
const mk = (Int a): Point -> {
	const Point q = { x: a, y: a }
	return q
}
pub const main = () -> {
	const Box b1 = { p: mk(1), tag: 5 }
	const Box b2 = { ...b1, p: mk(3) }
	return b2.p.x + b2.p.y + b2.tag
}
