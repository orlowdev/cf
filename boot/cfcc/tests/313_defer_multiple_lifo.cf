# Several defers (call and block forms interleaved) fire LIFO; the call form taps
# no state, so only the three block mutations show: 0*3+3=3, 3*3+2=11, 11*3+1=34.
# expect: exit 34
data Cell = { Int v }
const noop = (Int x): Int -> x
const run = (): Cell -> {
	let Cell c = { v: 0 }
	defer { c.v = c.v * 3 + 1 }
	defer noop(7)
	defer { c.v = c.v * 3 + 2 }
	defer { c.v = c.v * 3 + 3 }
	return c
}
pub const main = () -> run().v
