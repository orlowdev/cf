# a generic type instantiated at an aggregate (`Box[Point]` — a pointer field)
# expect: exit 7
data Point = { Int x, Int y }
data Box['T] = { 'T v }
const mkp = (Int a, Int b) Point -> {
	const Point p = { x: a, y: b }
	return p
}
pub const main = () -> {
	const Box[Point] b = { v: mkp(3, 4) }
	return b.v.x + b.v.y
}
