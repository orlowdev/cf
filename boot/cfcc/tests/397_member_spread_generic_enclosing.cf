# a generic union may spread a concrete source; the spliced members monomorphize
# expect: exit 91
union Small = { A, B }
union Wrap['T] = { ...Small, Val('T) }
const f = (Wrap[Iarch] w): Iarch -> match w {
	Wrap.A -> 1,
	Wrap.B -> 2,
	Wrap.Val(v) -> v,
}
pub const main = () -> {
	const Wrap[Iarch] w = Wrap[Iarch].Val(9)
	const Wrap[Iarch] a = Wrap[Iarch].A
	return f(w) * 10 + f(a)
}
