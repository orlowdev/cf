# a generic union may spread a concrete source; the spliced members monomorphize
# expect: exit 91
union Small = { A, B }
union Wrap['T] = { ...Small, Val('T) }
const f = (Wrap[Int] w): Int -> match w {
	Wrap.A -> 1,
	Wrap.B -> 2,
	Wrap.Val(v) -> v,
}
pub const main = () -> {
	const Wrap[Int] w = Wrap[Int].Val(9)
	const Wrap[Int] a = Wrap[Int].A
	return f(w) * 10 + f(a)
}
