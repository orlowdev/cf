# a negative literal at a SIGNED binding: cfcc rejects `const Int8 x = -5` because `-5` is
# `EX_NEG` (an `Int` expression), which takes the exact-type branch — NOT the non-negative
# literal-adoption path. ⚠ cf0 must NOT inherit: §3 adopts negatives too (`const Int32 x = -5`
# is valid there); in cfcc, write `Int8(-5)`. This test pins the disclaimed narrowing.
# expect: error
pub const main = () -> {
	const Int8 x = -5
	return Int(x)
}
