# members before and after the spread keep their declaration-order tags
# expect: exit 123
union Mid = { M }
union Full = { First, ...Mid, Last }
const rank = (Full f): Int -> match f {
	Full.First -> 1,
	Full.M -> 2,
	Full.Last -> 3,
}
pub const main = () -> {
	const Full a = Full.First
	const Full b = Full.M
	const Full c = Full.Last
	return rank(a) * 100 + rank(b) * 10 + rank(c)
}
