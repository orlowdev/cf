# all eight fixed-width integer leaves coexist as locals; cast each to Int and sum (1..8 = 36)
# expect: exit 36
pub const main = () -> {
	const Int8 a = 1
	const Int16 b = 2
	const Int32 c = 3
	const Int64 d = 4
	const Uint8 e = 5
	const Uint16 f = 6
	const Uint32 g = 7
	const Uint64 h = 8
	return Int(a) + Int(b) + Int(c) + Int(d) + Int(e) + Int(f) + Int(g) + Int(h)
}
