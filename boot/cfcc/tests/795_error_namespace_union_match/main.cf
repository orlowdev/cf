# matching a namespaced union's member (`Ns.Union.Member`, three levels) is not
# supported yet — the union must be destructured (`import … as { Dir }`) to match it
# expect: error
import "dir" as D

const w = (D.Dir d): Iarch -> match d {
	D.Dir.North -> 40,
	D.Dir.South -> 2,
}

pub const main = () -> w(D.Dir.North)
