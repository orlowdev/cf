# a spread-copied aggregate field is rejected (a shallow copy would alias)
# expect: error
data Point = { Int x, Int y }
data Box = { Point p, Int tag }
const mk = (Int a): Point -> {
	const Point q = { x: a, y: a }
	return q
}
pub const main = () -> {
	const Box b1 = { p: mk(1), tag: 5 }
	const Box b2 = { ...b1, tag: 9 }
	return b2.tag
}
