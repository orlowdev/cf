# A recursive union via an EXPLICIT `*List` payload (the owner-confirmed cf0 form for
# self-referential unions): a linked list summed by matching, binding the tail as a `*List`
# and recursing on it.
# expect: exit 7
union List = { Cons(Int, *List), Nil }
const sum = (List l): Int -> match l {
	List.Cons(n, rest) -> n + sum(rest),
	List.Nil -> 0,
}
pub const main = () -> {
	const List a = List.Cons(3, List.Cons(4, List.Nil))
	return sum(a)
}
