# A `*Box` pointer to a BOXED union: a parameter, a return type (`&` mints it), and `match`
# directly on the pointer scrutinee.
# expect: exit 4
union Box = { Val(Int), Empty }
const get = (*Box b): Int -> match b {
	Box.Val(n) -> n,
	Box.Empty -> 0,
}
const mk = (Int x): *Box -> &Box.Val(x)
pub const main = () -> get(mk(4))
