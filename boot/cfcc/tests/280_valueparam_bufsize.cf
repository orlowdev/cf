# a value parameter sizes a `[n Uint8]` byte buffer (the spec's `[n 'T]` array motive,
# narrowed to Uint8): read n bytes of /dev/zero into an n-sized buffer; exit = bytes read.
# syscall wrappers return Int as the usual test convenience.
# expect: exit 8
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5) Int -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const open = (*[Uint8] path, Uarch flags, Uarch mode) Int -> syscall6(5, path, flags, mode, 0, 0, 0)
pub const read = (Uarch fd, *[Uint8] buf, Uarch n) Int -> syscall6(3, fd, buf, n, 0, 0, 0)
pub const readn = [Uarch n](Uarch fd) Int -> {
	let [n Uint8] buf
	return read(fd, buf, n)
}
pub const main = () -> {
	const Int fd = open("/dev/zero".bytes, 0, 0)
	return readn[8](fd)
}
