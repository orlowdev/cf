# the spec-faithful floor: syscall6/write return Uarch; write called for effect
# expect: exit 0
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5) Uarch -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const write = (Uarch fd, *[Uint8] buf, Uarch n) Uarch -> {
	return syscall6(4, fd, buf, n, 0, 0, 0)
}
pub const main = () -> {
	const Str msg = "hi\n"
	write(1, msg.bytes, msg.len)
	return 0
}
