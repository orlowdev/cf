# the spec-faithful shape: open/read/write return Uarch. With no Uarch locals, fd and the
# read count are threaded by nesting the calls (open -> read -> write); the buffer is
# filled by read before write echoes it. Reads /dev/zero, writes 16 zero bytes; exits 0.
# expect: exit 0
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5) Uarch -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const open = (*[Uint8] path, Uarch flags, Uarch mode) Uarch -> syscall6(5, path, flags, mode, 0, 0, 0)
pub const read = (Uarch fd, *[Uint8] buf, Uarch n) Uarch -> syscall6(3, fd, buf, n, 0, 0, 0)
pub const write = (Uarch fd, *[Uint8] buf, Uarch n) Uarch -> syscall6(4, fd, buf, n, 0, 0, 0)
pub const main = () -> {
	let [16 Uint8] buf
	write(1, buf, read(open("/dev/zero".bytes, 0, 0), buf, 16))
	return 0
}
