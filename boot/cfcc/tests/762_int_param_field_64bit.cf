# a plain `Int` parameter and an `Int` record field are now 64-bit (Iarch): a product past
# 2^31 survives round-trips through the param and the field without truncation.
# expect: exit 7
data Box = { Int v }
pub const scale = (Int a): Int -> a * 1000000
pub const main = () -> {
	const Box b = Box({ v: scale(5000) })
	return if b.v > 2000000000 then 7 else 0
}
