# The headline idiom: `of(N) |> defer destroy` binds the fresh arena (the tapped
# value) while destroy(arena) is queued for scope exit. The record flows to the
# binding; its field reads back as N.
# expect: exit 42
data Arena = { Int mark }
const of = (Int n) Arena -> {
	const Arena a = { mark: n }
	return a
}
const destroy = (Arena a) Int -> a.mark
const run = () Int -> {
	const Arena arena = of(42) |> defer destroy
	return arena.mark
}
pub const main = () -> run()
