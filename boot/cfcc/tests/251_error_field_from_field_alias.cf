# a record field initialized from another record's field aliases it — rejected
# expect: error
data Point = { Int x, Int y }
data Line = { Point a, Point b }
const mk = (Int x, Int y) Point -> {
	const Point p = { x: x, y: y }
	return p
}
pub const main = () -> {
	const Line src = { a: mk(1, 2), b: mk(3, 4) }
	const Line dst = { a: src.a, b: mk(5, 6) }
	return dst.a.x
}
