# a generic function monomorphized over two types (Int, a union): id[T](x) = x
# expect: exit 43
union Color = { Red, Green, Blue }
pub const id = ['T]('T x): 'T -> x
pub const rank = (Color c): Int -> match c { Color.Red -> 1, Color.Green -> 2, Color.Blue -> 3 }
pub const main = () -> {
	const Int n = id[Int](40)
	const Color c = id[Color](Color.Blue)
	return n + rank(id[Color](c))
}
