# a numeric comptime TYPE-SWITCH (§8.3/§8.5) narrows a numeric-bounded 'T: the arm matching the
# instantiation's concrete width is live (the rest are dead-code). Here Int16 -> 16.
# expect: exit 16
pub const bits = [Int 'T]('T x): Iarch -> match x {
	Int.Int8(v) -> 8,
	Int.Int16(v) -> 16,
	Int.Int32(v) -> 32,
	Int.Int64(v) -> 64,
	Int.Iarch(v) -> 0,
}
pub const main = () -> bits[Int16](Int16(5))
