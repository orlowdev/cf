# a tuple's record element may itself hold a record (implicit-pointer aggregate field)
# expect: exit 15
data Inner = { Iarch v }
data Outer = { Iarch k, Inner in }
const mkI = (Iarch v): Inner -> Inner({ v: v })
const mkO = (Iarch k, Iarch v): Outer -> Outer({ k: k, in: mkI(v) })
pub const main = () -> {
	const t = (5, mkO(4, 6))
	return t[0] + t[1].k + t[1].in.v
}
