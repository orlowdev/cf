# a tuple's record element may itself hold a record (implicit-pointer aggregate field)
# expect: exit 15
data Inner = { Int v }
data Outer = { Int k, Inner in }
const mkI = (Int v): Inner -> Inner({ v: v })
const mkO = (Int k, Int v): Outer -> Outer({ k: k, in: mkI(v) })
pub const main = () -> {
	const t = (5, mkO(4, 6))
	return t[0] + t[1].k + t[1].in.v
}
