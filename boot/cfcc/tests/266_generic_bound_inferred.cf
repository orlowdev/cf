# a bounded generic function called WITHOUT explicit type args — inferred to the bound union
# expect: exit 3
union Color = { Red, Green, Blue }
pub const rank = [Color 'T]('T c) Int -> match c {
	Color.Red -> 1,
	Color.Green -> 2,
	Color.Blue -> 3,
}
pub const main = () -> {
	return rank(Color.Blue)
}
