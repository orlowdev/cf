# a bound on a generic UNION type parameter `union Wrapper[Color 'T]`
# expect: exit 2
union Color = { Red, Green, Blue }
union Wrapper[Color 'T] = { Hold('T), Empty }
pub const main = () -> {
	const Wrapper[Color] w = Wrapper[Color].Hold(Color.Green)
	return match w {
		Wrapper.Hold(c) -> match c { Color.Red -> 1, Color.Green -> 2, Color.Blue -> 3 },
		Wrapper.Empty -> 0,
	}
}
