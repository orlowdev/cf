# a value-if inside a long loop must not leak stack (merge slots are hoisted):
# 50000 iterations, counting evens -> 25000, mod 256 = 168
# expect: exit 168
pub const main = () -> {
	let sum = 0
	let i = 0
	loop {
		if i >= 50000 then break
		sum = sum + (if i % 2 == 0 then 1 else 0)
		i = i + 1
	}
	return sum % 256
}
