# continue steers a value loop; `<- sum` yields the running total once done
# (evens in 0..9: 0+2+4+6+8 = 20)
# expect: exit 20
pub const main = () -> {
	let sum = 0
	let i = 0
	let r = loop {
		if i >= 10 then <- sum
		let cur = i
		i = i + 1
		if cur % 2 == 1 then continue
		sum = sum + cur
	}
	return r
}
