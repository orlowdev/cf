# an alias of a tuple type in parameter + return position; the result is bound by
# inference (cfcc has no tuple-typed local annotation) and indexed.
# expect: exit 30
type Pair = (Int, Int)
const mk = (Int a, Int b): Pair -> (a, b)
const fst = (Pair p): Int -> p[0]
pub const main = () -> {
	const p = mk(10, 20)
	return fst(p) + p[1]
}
