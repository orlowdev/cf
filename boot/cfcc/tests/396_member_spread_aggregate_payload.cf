# member spread carries a member with an aggregate (record) payload
# expect: exit 7
data Point = { Iarch x, Iarch y }
union Shapes = { Dot(Point) }
union Geo = { ...Shapes, Empty }
const mk = (Iarch a, Iarch b): Point -> {
	const Point p = { x: a, y: b }
	return p
}
const area = (Geo g): Iarch -> match g {
	Geo.Dot(p) -> p.x + p.y,
	Geo.Empty -> 0,
}
pub const main = () -> {
	const Geo g = Geo.Dot(mk(3, 4))
	return area(g)
}
