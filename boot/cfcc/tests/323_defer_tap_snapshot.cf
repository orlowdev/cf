# The tap yields the value at the defer point: `v` captures n's value (5) then,
# after n is reassigned to 99, `v + n` is 5 + 99 = 104 — the tap did not re-read n.
# expect: exit 104
const tap = (Int x): Int -> x
const run = (): Int -> {
	let Int n = 5
	const Int v = n |> defer tap
	n = 99
	return v + n
}
pub const main = () -> run()
