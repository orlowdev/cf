# a by-value `[N T]` array param is read-only — writing through it (which would clobber the
# caller's array, since cfcc passes it as a no-copy borrow) is rejected
# expect: error
const clobber = ([3 Iarch] xs): Iarch -> {
	xs[0] = 999
	return xs[0]
}
pub const main = () -> {
	let [3 Iarch] a = [1, 2, 3]
	return clobber(a)
}
