# a bounded generic function `[Color 'T]` — the bound union satisfies itself (reflexive),
# and 'T is narrowed by match inside the body (type_system §8.5)
# expect: exit 2
union Color = { Red, Green, Blue }
pub const rank = [Color 'T]('T c): Iarch -> match c {
	Color.Red -> 1,
	Color.Green -> 2,
	Color.Blue -> 3,
}
pub const main = () -> {
	return rank[Color](Color.Green)
}
