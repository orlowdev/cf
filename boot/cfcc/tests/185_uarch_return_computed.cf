# a Uarch-returning function may return a computed Int value (widened w->l before ret,
# not a bare w temp that qbe would reject); called for effect here
# expect: exit 0
pub const scaled = (Uarch base) Uarch -> {
	let Int a = 3
	a = a + 4
	return a + 1
}
pub const main = () -> {
	scaled(10)
	return 0
}
