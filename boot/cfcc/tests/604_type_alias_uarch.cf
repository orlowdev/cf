# an alias of `Uarch` carries the register-width kind through, not a record —
# proving the erasure precedes parse_param_type's kind dispatch. An Int literal
# widens into the `Size` (Uarch) parameter, and `Int(...)` narrows the result back.
# expect: exit 9
type Size = Uarch
const id = (Size s): Size -> s
pub const main = () -> Int(id(9))
