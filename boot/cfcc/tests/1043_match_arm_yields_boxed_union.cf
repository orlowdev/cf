# a `match` arm may yield a bound BOXED-UNION payload (a nested union value), aliasing it through
# the `%m` merge slot. `unwrap` returns the inner Shape; its Circle carries v=9.
# expect: exit 9
data Node = { Iarch v }
union Shape = { Circle(Node), Square(Node) }
union Wrap = { One(Shape), Two(Shape) }
const unwrap = (Wrap w): Shape -> match w {
	Wrap.One(s) -> s,
	Wrap.Two(s) -> s
}
const val = (Shape s): Iarch -> match s {
	Shape.Circle(n) -> n.v,
	Shape.Square(n) -> n.v
}
pub const main = () -> {
	const Wrap w = Wrap.Two(Shape.Circle(Node({ v: 9 })))
	return val(unwrap(w))
}
