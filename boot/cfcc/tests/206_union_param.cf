# a tag-only union crosses a function boundary as a word tag; match on the param
# expect: exit 2
union Color = { Red, Green, Blue }
pub const rank = (Color c): Int -> match c {
	Color.Red -> 1,
	Color.Green -> 2,
	Color.Blue -> 3,
}
pub const main = () -> {
	const Color g = Color.Green
	return rank(g)
}
