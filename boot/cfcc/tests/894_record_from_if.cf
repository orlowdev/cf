# a record yielded from an `if` (both branches build a FRESH record) — return + read
# expect: exit 11
data Node = { Iarch tag, Iarch val }
const mk = (Iarch t, Iarch v): Node -> Node({ tag: t, val: v })
const build = (Iarch c): Node -> if c > 0 then mk(1, 10) else mk(2, 20)
pub const main = () -> {
	const Node n = build(1)
	return n.tag + n.val
}
