# binding a record local from a field access aliases the aggregate — rejected
# expect: error
data Point = { Iarch x, Iarch y }
data Line = { Point a, Point b }
const mk = (Iarch x, Iarch y): Point -> {
	const Point p = { x: x, y: y }
	return p
}
pub const main = () -> {
	const Line l = { a: mk(1, 2), b: mk(3, 4) }
	const Point q = l.a
	return q.x
}
