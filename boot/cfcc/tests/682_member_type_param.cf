# A parameter annotated with a generic member type (`Maybe[Int].Just`) behaves as the
# union parameter.
# expect: exit 7
union Maybe['V] = { Just('V), Nothing }
const unwrap = (Maybe[Int].Just m): Int -> match m {
	Maybe.Just(v) -> v,
	Maybe.Nothing -> 0,
}
pub const main = () -> unwrap(Maybe[Int].Just(7))
