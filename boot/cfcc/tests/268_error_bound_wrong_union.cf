# a type argument from a DIFFERENT union does not satisfy the bound.
# body is bound-agnostic (`-> 0`), so rejection is due to the bound alone
# expect: error
union Color = { Red, Green }
union Mood = { Happy, Sad }
pub const f = [Color 'T]('T c) Int -> 0
pub const main = () -> {
	return f[Mood](Mood.Happy)
}
