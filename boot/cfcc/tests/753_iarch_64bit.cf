# Iarch is genuinely 64-bit: 2e9 + 2e9 = 4e9 stays positive (a 32-bit type would wrap to a
# negative), so the comparison against 2e9 is 1. This distinguishes 64-bit from 32-bit.
# expect: exit 1
pub const main = () -> {
	const Iarch s = Iarch(2000000000) + Iarch(2000000000)
	return Int(s > Iarch(2000000000))
}
