# a field initializer's type must match the declared aggregate field type
# expect: error
data Point = { Int x, Int y }
data Rect = { Int w, Int h }
data Box = { Point p }
const mkr = (): Rect -> {
	const Rect r = { w: 1, h: 2 }
	return r
}
pub const main = () -> {
	const Box b = { p: mkr() }
	return 0
}
