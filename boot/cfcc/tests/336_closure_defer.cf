# A deferred closure call fires at scope exit — AFTER the return value is fixed.
# The immediate bump() sets i = 10 (seen by the return); the deferred bump() runs
# after the snapshot, so it does not change the result.
# expect: exit 10
const verify = (): Int -> {
	let Int i = 0
	const bump = () -> {
		i = i + 10
		return i
	}
	const a = bump()
	defer bump()
	return i
}
pub const main = () -> verify()
