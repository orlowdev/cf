# A capturing closure has no runtime representation, so it cannot be passed as a
# function value yet (only capture-free functions can).
# expect: error
const apply = ((Int) -> Int f, Int x): Int -> f(x)
const run = (): Int -> {
	let Int base = 10
	const addbase = (Int k) -> base + k
	return apply(addbase, 5)
}
pub const main = () -> run()
