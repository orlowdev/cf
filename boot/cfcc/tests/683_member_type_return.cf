# A return type may be a member type (`Maybe[Int].Just`); it collapses to the union return.
# expect: exit 9
union Maybe['V] = { Just('V), Nothing }
const mk = (Int n): Maybe[Int].Just -> Maybe[Int].Just(n)
const unwrap = (Maybe[Int] m): Int -> match m {
	Maybe.Just(v) -> v,
	Maybe.Nothing -> 0,
}
pub const main = () -> unwrap(mk(9))
