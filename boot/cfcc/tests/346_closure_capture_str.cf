# A closure captures a `Str` by reference (its slot address) and reads it — `s.len` of "hi" is 2.
# (Was an error test when captures were Iarch/record-only; widened in the closure-capture brick.)
# expect: exit 2
const run = (): Iarch -> {
	const Str s = "hi"
	const f = () -> Iarch(s.len)
	return f()
}
pub const main = () -> run()
