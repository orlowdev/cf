# whole-reassigning a captured-by-reference record is rejected: a captured record is a borrow
# (no reassignable `%s_` slot), so `cap = mk(9)` has no storage to repoint. (Field mutation
# through the capture is a separate, supported path.)
# expect: error
data P = { Iarch x }
const mk = (Iarch v): P -> P({ x: v })
const run = (): Iarch -> {
	let P cap = mk(1)
	const use = (): Iarch -> {
		cap = mk(9)
		return cap.x
	}
	return use()
}
pub const main = () -> run()
