# a `[Number 'T]` type-switch dispatches over the whole numeric tower, including floats: the
# Float64 instantiation binds the float and truncates it (41.9 -> 41)
# expect: exit 41
pub const trunc = [Number 'T]('T x): Iarch -> match x {
	Number.Float64(v) -> Iarch(Int32(v)),
	Number.Iarch(v) -> Iarch(v),
	_ -> 0,
}
pub const main = () -> trunc[Float64](41.9)
