# member spread carries payload members, bound + read in a match
# expect: exit 16
union Leaf = { Lit(Int), Nil }
union Node = { ...Leaf, Pair(Int, Int) }
const eval = (Node n): Int -> match n {
	Node.Lit(v) -> v,
	Node.Nil -> 0,
	Node.Pair(a, b) -> a + b,
}
pub const main = () -> {
	const Node p = Node.Pair(4, 5)
	const Node l = Node.Lit(7)
	return eval(p) + eval(l)
}
