# a function may return a union (a word tag); a match arm may yield a union
# expect: exit 1
union Color = { Red, Green, Blue }
pub const swap = (Color c): Color -> match c {
	Color.Red -> Color.Blue,
	Color.Blue -> Color.Red,
	_ -> c,
}
pub const rank = (Color c): Int -> match c {
	Color.Red -> 1,
	Color.Green -> 2,
	Color.Blue -> 3,
}
pub const main = () -> {
	const Color b = Color.Blue
	return rank(swap(b))
}
