# top-level VALUE consts (`const NAME = <expr>`, no `(params) ->`) referenced bare and
# auto-called: a `pub` one and a private one, used in arithmetic and as a call argument.
# expect: exit 42
pub const forty = 40
const two = 2
const add = (Iarch a, Iarch b): Iarch -> a + b
pub const main = () -> add(forty, two)
