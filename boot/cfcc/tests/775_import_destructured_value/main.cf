# destructured value imports: two sibling modules each expose a `pub` entry point
# that calls its own module-private `helper`. Flatten mangles the two `helper`s
# apart (a_helper vs b_helper), so both survive and main sums 40 + 2 = 42.
# expect: exit 42
import "a" as { one }
import "b" as { two }

pub const main = () -> one() + two()
