# An explicit `*Point` pointer: a parameter, a return type, and field access through it.
# `mk` returns a `*Point` (the directly-returned literal adopts the pointee record); `at`
# reads fields through the pointer.
# expect: exit 7
data Point = { Int x, Int y }
const at = (*Point p): Int -> p.x + p.y
const mk = (Int a, Int b): *Point -> ({ x: a, y: b })
pub const main = () -> at(mk(3, 4))
