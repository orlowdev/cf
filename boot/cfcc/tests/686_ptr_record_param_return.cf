# An explicit `*Point` pointer: a parameter, a return type (`&` makes the pointer), and field
# access through it. `mk` returns `&Point({…})`; `at` reads fields through the pointer.
# expect: exit 7
data Point = { Int x, Int y }
const at = (*Point p): Int -> p.x + p.y
const mk = (Int a, Int b): *Point -> &Point({ x: a, y: b })
pub const main = () -> at(mk(3, 4))
