# a spread carries an aggregate (record-typed) field, not just Int fields
# expect: exit 10
data Point = { Int x, Int y }
data WithOrigin = { Point origin, Int id }
data Ext = { ...WithOrigin, Int extra }
const mk = (Int a, Int b): Point -> {
	const Point p = { x: a, y: b }
	return p
}
pub const main = () -> {
	const Ext e = { origin: mk(1, 2), id: 3, extra: 4 }
	return e.origin.x + e.origin.y + e.id + e.extra
}
