# a generic pointer-recursive union `List['T]`, summed at Iarch
# expect: exit 6
union List['T] = { Cons('T, List['T]), Nil }
const sum = (List[Iarch] l): Iarch -> match l {
	List.Cons(h, t) -> h + sum(t),
	List.Nil -> 0,
}
pub const main = () -> {
	const List[Iarch] l = List[Iarch].Cons(1, List[Iarch].Cons(2, List[Iarch].Cons(3, List[Iarch].Nil)))
	return sum(l)
}
