# a generic pointer-recursive union `List['T]`, summed at Int
# expect: exit 6
union List['T] = { Cons('T, List['T]), Nil }
const sum = (List[Int] l): Int -> match l {
	List.Cons(h, t) -> h + sum(t),
	List.Nil -> 0,
}
pub const main = () -> {
	const List[Int] l = List[Int].Cons(1, List[Int].Cons(2, List[Int].Cons(3, List[Int].Nil)))
	return sum(l)
}
