# a type namespace used in a return-type annotation, filled by a value-namespace call
# that returns the same imported record (the module builds it from a private helper)
# expect: exit 2
import "shapes" as Shapes
import "shapes" as sh

const get = (): Shapes.Point -> sh.origin()

pub const main = () -> {
	const Shapes.Point o = get()
	return o.x + o.y
}
