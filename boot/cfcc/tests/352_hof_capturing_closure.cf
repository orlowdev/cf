# HOF v2: a capturing closure passed to a higher-order function is specialized —
# its captures become hidden parameters threaded through a clone of the callee
# (the fake-closure model). apply(addbase, 5) yields base + 5 = 15.
# expect: exit 15
const apply = ((Int) -> Int f, Int x): Int -> f(x)
const run = (): Int -> {
	let Int base = 10
	const addbase = (Int k): Int -> base + k
	return apply(addbase, 5)
}
pub const main = () -> run()
