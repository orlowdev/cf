# A HOF that passes its function parameter to another HOF: the capture threads
# through both specializations (the fake-closure fixpoint). relay -> apply -> addbase.
# expect: exit 42
const apply = ((Int) -> Int f, Int x): Int -> f(x)
const relay = ((Int) -> Int g, Int y): Int -> apply(g, y)
const run = (): Int -> {
	let Int base = 40
	const addbase = (Int k): Int -> base + k
	return relay(addbase, 2)
}
pub const main = () -> run()
