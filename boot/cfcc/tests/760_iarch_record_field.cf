# an `Iarch` record field is a genuine 64-bit slot (storel/loadl): a value past 2^31 survives
# the round-trip, which a 32-bit field would truncate
# expect: exit 1
data B = { Iarch v }
pub const mk = (): B -> B({ v: Iarch(2000000000) })
pub const main = () -> {
	const B b = mk()
	return Int(b.v > Iarch(1000000000))
}
