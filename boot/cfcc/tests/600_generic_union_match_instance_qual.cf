# a match arm may qualify by the union's exact instance (`U[Int].Pair`), not only its base
# name (`U.Pair`) — the two are interchangeable, matching construction's `U[Int].Pair(...)`
# expect: exit 30
union U['T] = { Pair((Int, 'T)), Empty }
const sum = (U[Int] u): Int -> match u {
	U[Int].Pair(p) -> p[0] + p[1],
	U.Empty -> 0,
}
pub const main = () -> sum(U[Int].Pair((10, 20)))
