# aliasing a union: the alias expands as the match scrutinee's type and as the
# member-qualifier LHS (`Colour.Red` -> `Color.Red`); the member after `.` is kept.
# expect: exit 20
union Color = { Red, Green, Blue }
type Colour = Color
pub const main = () -> {
	const Colour c = Colour.Green
	return match c {
		Color.Red -> 10,
		Color.Green -> 20,
		Color.Blue -> 30,
	}
}
