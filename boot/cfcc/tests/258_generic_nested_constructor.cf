# a nested type constructor `Box[Pair[Int, Int]]`
# expect: exit 30
data Pair['A, 'B] = { 'A a, 'B b }
data Box['T] = { 'T v }
const mkpair = (Int a, Int b): Pair[Int, Int] -> {
	const Pair[Int, Int] p = { a: a, b: b }
	return p
}
pub const main = () -> {
	const Box[Pair[Int, Int]] b = { v: mkpair(10, 20) }
	return b.v.a + b.v.b
}
