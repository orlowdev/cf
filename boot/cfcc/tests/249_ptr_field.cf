# An explicit `*Point` pointer FIELD (the explicit form of a recursive/aggregate reference;
# a bare `Point` field is the G3a implicit-pointer form). Read a field through the pointer.
# expect: exit 5
data Point = { Int x }
data Box = { Int k, *Point p }
const readit = (Box b): Int -> b.k + b.p.x
pub const main = () -> readit(Box({ k: 2, p: Point({ x: 3 }) }))
