# A `*Point` may be returned as a bare parameter (a pointer is explicitly an alias, unlike a
# by-value record return) and forwarded through another function.
# expect: exit 9
data Point = { Int x, Int y }
const forward = (*Point p): *Point -> p
const sum = (*Point p): Int -> p.x + p.y
const mk = (Int a, Int b): *Point -> ({ x: a, y: b })
pub const main = () -> sum(forward(mk(8, 1)))
