# a `let` record's aggregate field can be reassigned to a fresh value
# expect: exit 10
data Point = { Int x, Int y }
data Box = { Point p }
const mk = (Int a): Point -> {
	const Point q = { x: a, y: a }
	return q
}
pub const main = () -> {
	let Box b = { p: mk(1) }
	b.p = mk(5)
	return b.p.x + b.p.y
}
