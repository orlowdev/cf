# Iarch is usable directly as a condition and an array index (the operable-default surface the
# other fixed-width leaves lack) — it is the pointer-width default in the making
# expect: exit 30
pub const main = () -> {
	const [3 Iarch] xs = [10, 20, 30]
	const Iarch i = 2
	const Iarch flag = 1
	return if flag then xs[i] else 0
}
