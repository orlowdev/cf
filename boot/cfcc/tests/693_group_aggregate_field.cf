# A grouped-params `type` with an AGGREGATE field (a record that itself holds a union) — the
# splatted field param must be classified cleanly (a regression guard: a Param's `is_ptr` flag
# must default off for group fields, which reuse parse_param, not just for `Int` fields).
# expect: exit 5
union Tag = { A, B }
data Rec = { Int n, Tag t }
type Grp = { Rec r, Int extra }
const useit = (Grp placeholder) -> r.n + extra
pub const main = () -> {
	const Rec myrec = { n: 3, t: Tag.A }
	return useit({ r: myrec, extra: 2 })
}
