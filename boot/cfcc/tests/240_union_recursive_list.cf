# a union member may carry its own union payload — a pointer-recursive linked list
# expect: exit 60
union List = { Cons(Int, List), Nil }
const sum = (List l): Int -> match l {
	List.Cons(h, t) -> h + sum(t),
	List.Nil -> 0,
}
pub const main = () -> {
	const List l = List.Cons(10, List.Cons(20, List.Cons(30, List.Nil)))
	return sum(l)
}
