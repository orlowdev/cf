# a RECURSIVE union payload — a member carrying its own union type (like ast.cf's Expr):
# construct a nest and fold it with a recursive match.
# expect: exit 100
union E = { Lit(Iarch), Neg(E) }
const eval = (E e): Iarch -> match e {
	E.Lit(n) -> n,
	E.Neg(inner) -> 0 - eval(inner),
}
pub const main = () -> {
	const E a = E.Lit(5)
	const E b = E.Neg(a)
	const E c = E.Neg(b)
	return eval(c) + 95
}
