# A closure with no explicit parameters, capturing `i` by reference. Three calls
# bump it to 3.
# expect: exit 3
const run = (): Iarch -> {
	let Iarch i = 0
	const tick = () -> {
		i = i + 1
		return i
	}
	const a = tick()
	const b = tick()
	const c = tick()
	return i
}
pub const main = () -> run()
