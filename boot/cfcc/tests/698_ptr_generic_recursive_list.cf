# A GENERIC recursive union with an explicit `*List['T]` self-pointer payload — the generic
# analogue of 694. Guards that concretization strips the leading `*` before instantiating the
# pointee (`*List.1.Int` → the `List[Int]` instance).
# expect: exit 9
union List['T] = { Cons('T, *List['T]), Nil }
const sum = (List[Int] l): Int -> match l {
	List.Cons(n, rest) -> n + sum(rest),
	List.Nil -> 0,
}
pub const main = () -> {
	const List[Int] xs = List[Int].Cons(4, List[Int].Cons(5, List[Int].Nil))
	return sum(xs)
}
