# A GENERIC recursive union with an explicit `*List['T]` self-pointer payload (the generic
# analogue of 694), built with `&`. Guards that concretization strips the leading `*`.
# expect: exit 9
union List['T] = { Cons('T, *List['T]), Nil }
const sum = (List[Iarch] l): Iarch -> match l {
	List.Cons(n, rest) -> n + sum(rest),
	List.Nil -> 0,
}
pub const main = () -> {
	const List[Iarch] xs = List[Iarch].Cons(4, &List[Iarch].Cons(5, &List[Iarch].Nil))
	return sum(xs)
}
