# A closure may capture both a record (mutated) and a word (mutated) at once.
# step(10), step(20): c.v = 30, n = 2, so c.v + n = 32.
# expect: exit 32
data Cell = { Int v }
const run = (): Int -> {
	let Cell c = { v: 0 }
	let Int n = 0
	const step = (Int k) -> {
		c.v = c.v + k
		n = n + 1
		return c.v
	}
	const a = step(10)
	const b = step(20)
	return c.v + n
}
pub const main = () -> run()
