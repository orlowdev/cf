# A record value and an explicit `*Record` interconvert (cfcc represents both as the arena
# pointer): a `Point` local satisfies a `*Point` parameter, and a `*Point` satisfies a
# `Point` parameter.
# expect: exit 11
data Point = { Int x, Int y }
const useVal = (Point p): Int -> p.x
const usePtr = (*Point p): Int -> p.y
const relay = (*Point p): Int -> useVal(p) + usePtr(p)
pub const main = () -> {
	const Point pt = { x: 5, y: 6 }
	return relay(pt)
}
