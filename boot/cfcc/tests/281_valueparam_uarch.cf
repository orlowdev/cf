# a `Uarch`-typed value parameter returned through a Uarch function (spec example uses
# `Uarch n`); the fold produces the literal, widened to the l return, then an explicit
# `Int(...)` narrowing cast (type_system §4) brings it back to the Int exit code.
# expect: exit 42
pub const width = [Uarch n]() Uarch -> n
pub const main = () -> {
	const Int w = Int(width[42]())
	return w
}
