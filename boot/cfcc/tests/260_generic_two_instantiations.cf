# one generic data type at two instantiations, and a `'T`-returning generic function
# expect: exit 107
data Point = { Int x, Int y }
data Box['T] = { 'T v }
const mkp = (Int a, Int b) Point -> {
	const Point p = { x: a, y: b }
	return p
}
const unbox = ['T](Box['T] b) 'T -> b.v
pub const main = () -> {
	const Box[Int] bi = { v: 100 }
	const Box[Point] bp = { v: mkp(3, 4) }
	const Point p = unbox[Point](bp)
	return unbox[Int](bi) + p.x + p.y
}
