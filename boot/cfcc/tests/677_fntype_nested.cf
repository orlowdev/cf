# A nested function type: `f` is itself a function that takes a function value.
# `run(applyInc)` = applyInc(inc) = inc(5) = 6.
# expect: exit 6
const inc = (Int n) -> n + 1
const applyInc = ((Int) -> Int g): Int -> g(5)
const run = (((Int) -> Int) -> Int f): Int -> f(inc)
pub const main = () -> run(applyInc)
