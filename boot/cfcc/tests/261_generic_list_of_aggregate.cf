# a generic recursive union at an aggregate element type (`List[Point]`)
# expect: exit 10
data Point = { Int x, Int y }
union List['T] = { Cons('T, List['T]), Nil }
const mkp = (Int a, Int b) Point -> {
	const Point p = { x: a, y: b }
	return p
}
const total = (List[Point] l) Int -> match l {
	List.Cons(h, t) -> h.x + h.y + total(t),
	List.Nil -> 0,
}
pub const main = () -> {
	const List[Point] l = List[Point].Cons(mkp(1, 2), List[Point].Cons(mkp(3, 4), List[Point].Nil))
	return total(l)
}
