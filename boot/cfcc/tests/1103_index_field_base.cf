# Indexing a general expression base: `r.xs[i]` rides a `[i]` on a field read, not a bare
# name (the `p.toks[p.pos]` shape cf0's own parser needs). The index is itself an
# expression (a variable, and an arithmetic form).
# expect: exit 8
data R = { [Iarch] xs }
pub const main = () -> {
	let [Iarch] a = [3, 4, 5]
	const R r = R({ xs: a })
	const Iarch i = 2
	return r.xs[i] + r.xs[i - 2]
}
