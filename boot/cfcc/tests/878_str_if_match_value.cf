# a Str yielded from an `if` and a `match` (Str is a mergeable `l` scalar)
# expect: exit 5
union Kind = { Kw, Id }
const label = (Kind k): Str -> match k {
	Kind.Kw -> "keyword",
	Kind.Id -> "id"
}
pub const main = () -> {
	const Str a = if 1 > 0 then "abc" else "de"
	return a.len + label(Kind.Id).len
}
