# mutating a captured `let Uarch` through the closure writes back to the enclosing scope
# (by-reference capture): bump()+bump() sees 1 then 2 = 3
# expect: exit 3
const run = (): Iarch -> {
	let Uarch c = Uarch(0)
	const bump = (): Iarch -> {
		c = c + Uarch(1)
		return Iarch(c)
	}
	return bump() + bump()
}
pub const main = () -> run()
