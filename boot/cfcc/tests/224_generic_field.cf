# cfcc typechecks each clone's body per-instantiation (a throwaway degeneracy — cf0
# checks at the definition site with bounds), so `.v` on 'T=Box happens to resolve here
# expect: exit 9
data Box = { Int v }
pub const unbox = ['T]('T b) Int -> b.v
pub const main = () -> {
	const Box b = { v: 9 }
	return unbox[Box](b)
}
