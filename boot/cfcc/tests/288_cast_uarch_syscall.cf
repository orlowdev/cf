# explicit `Uarch(...)` casts at a syscall boundary — the spec-faithful form (type_system
# §4) of what cfcc otherwise does with a disclaimed implicit Int->Uarch widen. Writes
# "hey" to stdout; exit = bytes written (Int-return convenience).
# expect: exit 3
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Int -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const write = (Uarch fd, *[Uint8] buf, Uarch n): Int -> syscall6(4, fd, buf, n, 0, 0, 0)
pub const main = () -> {
	return write(Uarch(1), "hey".bytes, Uarch("hey".len))
}
