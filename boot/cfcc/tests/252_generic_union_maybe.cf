# a generic union `Maybe['V]`, instantiated and matched at Iarch
# expect: exit 42
union Maybe['V] = { Just('V), Nothing }
const unwrap = (Maybe[Iarch] m): Iarch -> match m {
	Maybe.Just(v) -> v,
	Maybe.Nothing -> 0,
}
pub const main = () -> {
	const Maybe[Iarch] a = Maybe[Iarch].Just(42)
	const Maybe[Iarch] b = Maybe[Iarch].Nothing
	return unwrap(a) + unwrap(b)
}
