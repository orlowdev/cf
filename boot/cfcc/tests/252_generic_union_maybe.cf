# a generic union `Maybe['V]`, instantiated and matched at Int
# expect: exit 42
union Maybe['V] = { Just('V), Nothing }
const unwrap = (Maybe[Int] m): Int -> match m {
	Maybe.Just(v) -> v,
	Maybe.Nothing -> 0,
}
pub const main = () -> {
	const Maybe[Int] a = Maybe[Int].Just(42)
	const Maybe[Int] b = Maybe[Int].Nothing
	return unwrap(a) + unwrap(b)
}
