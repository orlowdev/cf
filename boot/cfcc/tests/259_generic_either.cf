# a generic union with two type parameters, dispatched by match
# expect: exit 205
union Either['L, 'R] = { Left('L), Right('R) }
const pick = (Either[Iarch, Iarch] e): Iarch -> match e {
	Either.Left(x) -> x,
	Either.Right(y) -> y * 100,
}
pub const main = () -> {
	const Either[Iarch, Iarch] a = Either[Iarch, Iarch].Left(5)
	const Either[Iarch, Iarch] b = Either[Iarch, Iarch].Right(2)
	return pick(a) + pick(b)
}
