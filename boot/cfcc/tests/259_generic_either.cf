# a generic union with two type parameters, dispatched by match
# expect: exit 205
union Either['L, 'R] = { Left('L), Right('R) }
const pick = (Either[Int, Int] e): Int -> match e {
	Either.Left(x) -> x,
	Either.Right(y) -> y * 100,
}
pub const main = () -> {
	const Either[Int, Int] a = Either[Int, Int].Left(5)
	const Either[Int, Int] b = Either[Int, Int].Right(2)
	return pick(a) + pick(b)
}
