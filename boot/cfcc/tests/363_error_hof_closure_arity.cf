# A capturing closure passed to a HOF must still match the function-type parameter's
# arity — checked at the call site.
# expect: error
const apply = ((Int) -> Int f, Int x): Int -> f(x)
const run = (): Int -> {
	let Int base = 1
	const f = (Int a, Int b): Int -> base + a + b
	return apply(f, 5)
}
pub const main = () -> run()
