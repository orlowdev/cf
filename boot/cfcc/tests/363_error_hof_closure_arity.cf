# A capturing closure passed to a HOF must still match the function-type parameter's
# arity — checked at the call site.
# expect: error
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const run = (): Iarch -> {
	let Iarch base = 1
	const f = (Iarch a, Iarch b): Iarch -> base + a + b
	return apply(f, 5)
}
pub const main = () -> run()
