# One HOF used both ways: with a top-level function (a plain code pointer, v1) and
# with a capturing closure (specialized, v2). dbl(6) = 12, addbase(5) = 15.
# expect: exit 27
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const dbl = (Iarch n): Iarch -> n * 2
const run = (): Iarch -> {
	let Iarch base = 10
	const addbase = (Iarch k): Iarch -> base + k
	return apply(dbl, 6) + apply(addbase, 5)
}
pub const main = () -> run()
