# A `*Point` record-pointer as a UNION payload (`&` builds it), read through the bound pointer.
# expect: exit 8
data Point = { Int x, Int y }
union Holder = { Has(*Point), None }
const val = (Holder h): Int -> match h {
	Holder.Has(p) -> p.x + p.y,
	Holder.None -> 0,
}
pub const main = () -> val(Holder.Has(&Point({ x: 5, y: 3 })))
