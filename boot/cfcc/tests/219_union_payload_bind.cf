# a match arm binds its payload positionally; `_` ignores a field
# expect: exit 21
union Node = { IntLit(Int), BinOp(Int, Int, Int), Nil }
pub const eval = (Node n) Int -> match n {
	Node.IntLit(v) -> v,
	Node.BinOp(a, b, c) -> a + b * c,
	Node.Nil -> 0,
}
pub const main = () -> {
	const Node x = Node.IntLit(7)
	const Node y = Node.BinOp(2, 3, 4)
	const Node z = Node.Nil
	return eval(x) + eval(y) + eval(z)
}
