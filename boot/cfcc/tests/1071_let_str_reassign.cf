# a `let Str` may be reassigned — its `%s_` slot holds the header pointer, repointed on
# each assignment; here `msg` ends bound to "longer" (length 6)
# expect: exit 6
pub const main = () -> {
	let Str msg = "hi"
	let Iarch i = 0
	loop {
		if i >= 3 then break
		msg = "longer"
		i = i + 1
	}
	return msg.len
}
