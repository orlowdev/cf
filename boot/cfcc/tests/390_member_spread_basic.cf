# union member spread splices another union's tag-only members in place
# expect: exit 13
union Small = { A, B }
union Big = { ...Small, C }
const rank = (Big b): Int -> match b {
	Big.A -> 1,
	Big.B -> 2,
	Big.C -> 3,
}
pub const main = () -> {
	const Big x = Big.A
	const Big y = Big.C
	return rank(x) * 10 + rank(y)
}
