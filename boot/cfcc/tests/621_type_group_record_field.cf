# a group field may be a record type; the group literal carries the record value.
# expect: exit 7
data Point = { Int x, Int y }
type Boxed = { Point p, Int extra }
const use = (Boxed b): Int -> p.x + p.y + extra
pub const main = () -> {
	const Point pt = { x: 1, y: 2 }
	return use({ p: pt, extra: 4 })
}
