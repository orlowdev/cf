# nested field access reaches through a record parameter's aggregate fields
# expect: exit 10
data Point = { Int x, Int y }
data Line = { Point a, Point b }
const mk = (Int x, Int y): Point -> {
	const Point p = { x: x, y: y }
	return p
}
const total = (Line l): Int -> l.a.x + l.a.y + l.b.x + l.b.y
pub const main = () -> {
	const Line l = { a: mk(1, 2), b: mk(3, 4) }
	return total(l)
}
