# type arguments are inferred from the argument types (no explicit [T] needed)
# expect: exit 45
union Color = { Red, Green, Blue }
data Box = { Int v }
pub const id = ['T]('T x): 'T -> x
pub const unbox = ['T]('T b): Int -> b.v
pub const rank = (Color c): Int -> match c { Color.Red -> 1, Color.Green -> 2, Color.Blue -> 3 }
pub const main = () -> {
	const Int n = id(40)
	const Box b = { v: 3 }
	const Color c = id(Color.Green)
	return n + unbox(b) + rank(c)
}
