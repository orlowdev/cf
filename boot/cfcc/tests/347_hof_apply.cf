# A higher-order function: `(Int) Int f` is a function-value parameter, called
# indirectly. Different top-level functions are passed by name.
# expect: exit 41
const apply = ((Int) Int f, Int x) Int -> f(x)
const inc = (Int n) -> n + 1
const dbl = (Int n) -> n * 2
pub const main = () -> apply(inc, 20) + apply(dbl, 10)
