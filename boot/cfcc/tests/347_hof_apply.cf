# A higher-order function: `(Iarch) -> Iarch f` is a function-value parameter, called
# indirectly. Different top-level functions are passed by name.
# expect: exit 41
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const inc = (Iarch n) -> n + 1
const dbl = (Iarch n) -> n * 2
pub const main = () -> apply(inc, 20) + apply(dbl, 10)
