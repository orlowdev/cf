# Two closures capturing the same variable share its storage: inc, inc, dec leaves n at 1.
# expect: exit 1
const run = (): Int -> {
	let Int n = 0
	const inc = () -> {
		n = n + 1
		return n
	}
	const dec = () -> {
		n = n - 1
		return n
	}
	const a = inc()
	const b = inc()
	const c = dec()
	return n
}
pub const main = () -> run()
