	%r =l urem %v, 10
	%rc =w copy %r
	%ch =w add %rc, 48
	%i =l loadl %ip
	%da =l add %buf, %i
	storeb %ch, %da
	%i1 =l add %i, 1
	storel %i1, %ip
	storel %q, %vp
	jmp @extract
@emit
	%cnt =l loadl %ip
	storel %cnt, %vp
@eloop
