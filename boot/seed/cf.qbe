	%c8 =l add %hdr, 8
	storel %end, %c8
	%c16 =l add %hdr, 16
	storel %end, %c16
	%c24 =l add %hdr, 24
	storel %node, %c24
	%c32 =l add %hdr, 32
	storel 0, %c32
	%c40 =l add %hdr, 40
	storel 0, %c40
	ret %hdr
}
function l $cf_arena_grow(l %node, w %n) {
@start
	%r7 =w add %n, 7
	%ra =w and %r7, -8
