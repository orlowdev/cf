	%z =w ceql %cap, 0
	%zl =l extuw %z
	%z4 =l mul %zl, 4
	%ncap =l add %dbl, %z4
	%nbytes =l mul %ncap, %es
	%nbw =w copy %nbytes
	%ndata =l call $cf_alloc(l %node, w %nbw)
	%odata =l loadl %hdr
	%obytes =l mul %len, %es
	storel 0, %ip
@copytop
