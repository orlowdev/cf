}
function $cf_int_append(l %node, l %vhdr, l %val) {
@start
	%neg =w csltl %val, 0
	jnz %neg, @isneg, @pos
@isneg
	%s =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 45, %s
	%nv =l sub 0, %val
	call $cf_uint_append(l %node, l %vhdr, l %nv)
	ret
@pos
	call $cf_uint_append(l %node, l %vhdr, l %val)
	ret
}
function $cf_bool_append(l %node, l %vhdr, l %val) {
@start
