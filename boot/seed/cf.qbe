function l $cf_dyn_push(l %node, l %hdr, w %esize) {
@start
	%ip =l alloc8 8
	%es =l extuw %esize
	%hlen =l add %hdr, 8
	%hcap =l add %hdr, 16
	%len =l loadl %hlen
