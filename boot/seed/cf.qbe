export data $cf_page = { l 0, l 0, l 0, l 0, l 0, l 0 }
function l $cf_alloc(l %node, w %n) {
@start
	%r7 =w add %n, 7
	%ra =w and %r7, -8
	%sz =l extuw %ra
	%p =l loadl %node
	%nt =l add %p, %sz
	%limp =l add %node, 16
	%lim =l loadl %limp
	%ok =w culel %nt, %lim
	jnz %ok, @inbounds, @over
@over
	%kp =l add %node, 32
	%kind =l loadl %kp
	%elastic =w cnel %kind, 0
	jnz %elastic, @pull, @oom
@pull
	call $cf_arena_pull(l %node, l %sz)
	%p2 =l loadl %node
	%nt2 =l add %p2, %sz
	storel %nt2, %node
	ret %p2
@oom
	call $cf_oom()
	ret %p
@inbounds
	%commp =l add %node, 8
	%comm =l loadl %commp
	%need =w cugtl %nt, %comm
	jnz %need, @grow, @store
@grow
	call $cf_grow(l %node, l %nt)
	jmp @store
@store
	storel %nt, %node
	ret %p
}
function $cf_arena_pull(l %node, l %sz) {
@start
	%chunkp =l add %node, 40
	%chunk =l loadl %chunkp
	%usec =w culel %sz, %chunk
	jnz %usec, @c, @s
@c
	%bc =l copy %chunk
	jmp @al
@s
	%bs =l copy %sz
	jmp @al
@al
	%blksz =l phi @c %bc, @s %bs
	%parentp =l add %node, 24
	%parent =l loadl %parentp
	%bw =w copy %blksz
	%block =l call $cf_alloc(l %parent, w %bw)
	storel %block, %node
	%end =l add %block, %blksz
	%ecommp =l add %node, 8
	storel %end, %ecommp
	%elimp =l add %node, 16
	storel %end, %elimp
	ret
}
function l $cf_arena_of(l %node, w %n) {
@start
	%r7 =w add %n, 7
	%ra =w and %r7, -8
	%sz =l extuw %ra
	%hdr =l call $cf_alloc(l %node, w 48)
