export data $cf_page = { l 0, l 0, l 0, l 0, l 0, l 0, l 0, l 0, l 0, l 0, l 0, l 0 }
function l $cf_alloc(l %node, w %n) {
@start
	%r7 =w add %n, 7
	%ra =w and %r7, -8
	%sz =l extuw %ra
	%kp =l add %node, 32
	%kind =l loadl %kp
	%isplain =w cultl %kind, 2
	jnz %isplain, @up, @ext
@ext
	%isup4 =w ceql %kind, 4
	jnz %isup4, @up4, @down
@up4
	%p4 =l loadl %node
	%nt4 =l add %p4, %sz
	%sib4 =l add %node, 48
	%rtop =l loadl %sib4
	%ok4 =w culel %nt4, %rtop
	jnz %ok4, @up4ok, @oom
@up4ok
	storel %nt4, %node
	ret %p4
@up
	%p =l loadl %node
	%nt =l add %p, %sz
	%limp =l add %node, 16
	%lim =l loadl %limp
	%ok =w culel %nt, %lim
	jnz %ok, @inbounds, @over
@down
	%dt =l loadl %node
	%dn =l sub %dt, %sz
	%sib =l sub %node, 48
	%stop =l loadl %sib
	%dok =w cugel %dn, %stop
	jnz %dok, @downok, @oom
@downok
	storel %dn, %node
	ret %dn
@over
	%elastic =w cnel %kind, 0
	jnz %elastic, @pull, @oom
@pull
	call $cf_arena_pull(l %node, l %sz)
	%p2 =l loadl %node
	%nt2 =l add %p2, %sz
	storel %nt2, %node
	ret %p2
@oom
	call $cf_oom()
	ret 0
@inbounds
	%commp =l add %node, 8
	%comm =l loadl %commp
	%need =w cugtl %nt, %comm
	jnz %need, @grow, @store
@grow
	call $cf_grow(l %node, l %nt)
	jmp @store
@store
	storel %nt, %node
	ret %p
}
function $cf_reset(l %node, l %top, l %comm, l %lim) {
@start
	%limp =l add %node, 16
	%cur =l loadl %limp
	%same =w ceql %cur, %lim
	jnz %same, @toponly, @skip
@toponly
	storel %top, %node
	ret
@skip
	ret
}
function $cf_arena_pull(l %node, l %sz) {
@start
	%chunkp =l add %node, 40
	%chunk =l loadl %chunkp
	%usec =w culel %sz, %chunk
	jnz %usec, @c, @s
@c
	%bc =l copy %chunk
	jmp @al
@s
	%bs =l copy %sz
	jmp @al
@al
	%blksz =l phi @c %bc, @s %bs
	%parentp =l add %node, 24
	%parent =l loadl %parentp
	%bw =w copy %blksz
	%block =l call $cf_alloc(l %parent, w %bw)
	storel %block, %node
	%end =l add %block, %blksz
	%ecommp =l add %node, 8
	storel %end, %ecommp
	%elimp =l add %node, 16
	storel %end, %elimp
	ret
}
function l $cf_dyn_push(l %node, l %hdr, w %esize) {
@start
	%ip =l alloc8 8
	%es =l extuw %esize
	%hlen =l add %hdr, 8
	%hcap =l add %hdr, 16
	%len =l loadl %hlen
	%cap =l loadl %hcap
	%full =w ceql %len, %cap
	jnz %full, @grow, @store
@grow
	%dbl =l mul %cap, 2
	%z =w ceql %cap, 0
	%zl =l extuw %z
	%z4 =l mul %zl, 4
	%ncap =l add %dbl, %z4
	%nbytes =l mul %ncap, %es
	%nbw =w copy %nbytes
	%ndata =l call $cf_alloc(l %node, w %nbw)
	%odata =l loadl %hdr
	%obytes =l mul %len, %es
	storel 0, %ip
@copytop
	%ci =l loadl %ip
	%cdone =w cugel %ci, %obytes
	jnz %cdone, @copydone, @copybody
@copybody
	%src =l add %odata, %ci
	%dst =l add %ndata, %ci
	%cb =w loadub %src
	storeb %cb, %dst
	%ci1 =l add %ci, 1
	storel %ci1, %ip
	jmp @copytop
@copydone
	storel %ndata, %hdr
	storel %ncap, %hcap
	jmp @store
@store
	%data =l loadl %hdr
	%len2 =l loadl %hlen
	%soff =l mul %len2, %es
	%slot =l add %data, %soff
	%len3 =l add %len2, 1
	storel %len3, %hlen
	ret %slot
}
function $cf_uint_append(l %node, l %vhdr, l %val) {
@start
	%buf =l alloc4 24
	%ip =l alloc8 8
	%vp =l alloc8 8
	storel %val, %vp
	storel 0, %ip
	%z =w ceql %val, 0
	jnz %z, @zero, @extract
@zero
	%sz =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 48, %sz
	ret
@extract
	%v =l loadl %vp
	%done =w ceql %v, 0
	jnz %done, @emit, @digit
@digit
	%q =l udiv %v, 10
	%r =l urem %v, 10
	%rc =w copy %r
	%ch =w add %rc, 48
	%i =l loadl %ip
	%da =l add %buf, %i
	storeb %ch, %da
	%i1 =l add %i, 1
	storel %i1, %ip
	storel %q, %vp
	jmp @extract
@emit
	%cnt =l loadl %ip
	storel %cnt, %vp
@eloop
	%k =l loadl %vp
	%kz =w ceql %k, 0
	jnz %kz, @edone, @estep
@estep
	%k1 =l sub %k, 1
	%dap =l add %buf, %k1
	%dch =w loadub %dap
	%es =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb %dch, %es
	storel %k1, %vp
	jmp @eloop
@edone
	ret
}
function $cf_int_append(l %node, l %vhdr, l %val) {
@start
	%neg =w csltl %val, 0
	jnz %neg, @isneg, @pos
@isneg
	%s =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 45, %s
	%nv =l sub 0, %val
	call $cf_uint_append(l %node, l %vhdr, l %nv)
	ret
@pos
	call $cf_uint_append(l %node, l %vhdr, l %val)
	ret
}
function $cf_bool_append(l %node, l %vhdr, l %val) {
@start
	%nz =w cnel %val, 0
	jnz %nz, @true, @false
@true
	%t0 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 116, %t0
	%t1 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 114, %t1
	%t2 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 117, %t2
	%t3 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 101, %t3
	ret
@false
	%f0 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 102, %f0
	%f1 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 97, %f1
	%f2 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 108, %f2
	%f3 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 115, %f3
	%f4 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 101, %f4
	ret
}
function $cf_float_append(l %node, l %vhdr, d %val) {
@start
	%bslot =l alloc8 8
	stored %val, %bslot
	%bits =l loadl %bslot
	%exps =l shr %bits, 52
	%exp =l and %exps, 2047
	%mant =l and %bits, 4503599627370495
	%special =w ceql %exp, 2047
	jnz %special, @spec, @finite
@spec
	%isnan =w cnel %mant, 0
	jnz %isnan, @nan, @inf
@nan
	%n0 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 78, %n0
	%n1 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 97, %n1
	%n2 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 78, %n2
	ret
@inf
	%sgn =l shr %bits, 63
	jnz %sgn, @neginf, @posinf
@neginf
	%mm0 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 45, %mm0
	jmp @posinf
@posinf
	%i0 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 73, %i0
	%i1 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 110, %i1
	%i2 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 102, %i2
	ret
@finite
	%vs =l alloc8 8
	stored %val, %vs
	%isneg =w cltd %val, d_0
	jnz %isneg, @doneg, @pos
@doneg
	%s0 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 45, %s0
	%vld =d loadd %vs
	%vng =d neg %vld
	stored %vng, %vs
	jmp @pos
@pos
	%vv =d loadd %vs
	%ip =l dtosi %vv
	call $cf_uint_append(l %node, l %vhdr, l %ip)
	%dot =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 46, %dot
	%ipf =d sltof %ip
	%frac =d sub %vv, %ipf
	%fbuf =l alloc4 8
	%fs =l alloc8 8
	stored %frac, %fs
	%ci =l alloc8 8
	storel 0, %ci
@floop
	%i =l loadl %ci
	%fdone =w csgel %i, 6
	jnz %fdone, @trim, @fstep
@fstep
	%fr =d loadd %fs
	%fr10 =d mul %fr, d_10.0
	%dg =l dtosi %fr10
	%dgc =l add %dg, 48
	%faddr =l add %fbuf, %i
	storeb %dgc, %faddr
	%dgf =d sltof %dg
	%rem =d sub %fr10, %dgf
	stored %rem, %fs
	%i1f =l add %i, 1
	storel %i1f, %ci
	jmp @floop
@trim
	%last =l alloc8 8
	storel -1, %last
	%tj =l alloc8 8
	storel 0, %tj
@tloop
	%j =l loadl %tj
	%tdone =w csgel %j, 6
	jnz %tdone, @emit, @tstep
@tstep
	%ja =l add %fbuf, %j
	%jc =w loadub %ja
	%isz =w ceqw %jc, 48
	jnz %isz, @tskip, @tset
@tset
	storel %j, %last
@tskip
	%j1 =l add %j, 1
	storel %j1, %tj
	jmp @tloop
@emit
	%ln =l loadl %last
	%allz =w csltl %ln, 0
	jnz %allz, @zero, @digits
@zero
	%z0 =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb 48, %z0
	ret
@digits
	%ei =l alloc8 8
	storel 0, %ei
@eloop
	%e =l loadl %ei
	%eend =w csgtl %e, %ln
	jnz %eend, @edone, @estep
@estep
	%ea =l add %fbuf, %e
	%ec =w loadub %ea
	%esl =l call $cf_dyn_push(l %node, l %vhdr, w 1)
	storeb %ec, %esl
	%e1 =l add %e, 1
	storel %e1, %ei
	jmp @eloop
@edone
	ret
}
function $cf_str_append(l %node, l %vhdr, l %str) {
@start
	%bytes =l loadl %str
	%la =l add %str, 8
	%lenw =w loadw %la
	%len =l extuw %lenw
	%ip =l alloc8 8
	storel 0, %ip
@sloop
	%i =l loadl %ip
	%d =w cugel %i, %len
	jnz %d, @sdone, @sstep
@sstep
