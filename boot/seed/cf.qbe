export data $cf_page = { l 0, l 0, l 0, l 0, l 0, l 0 }
function l $cf_alloc(l %node, w %n) {
@start
	%r7 =w add %n, 7
	%ra =w and %r7, -8
	%sz =l extuw %ra
	%p =l loadl %node
	%nt =l add %p, %sz
	%limp =l add %node, 16
	%lim =l loadl %limp
	%ok =w culel %nt, %lim
	jnz %ok, @inbounds, @over
@over
	%kp =l add %node, 32
	%kind =l loadl %kp
	%elastic =w cnel %kind, 0
	jnz %elastic, @pull, @oom
@pull
	call $cf_arena_pull(l %node, l %sz)
	%p2 =l loadl %node
	%nt2 =l add %p2, %sz
	storel %nt2, %node
	ret %p2
@oom
	call $cf_oom()
	ret %p
@inbounds
	%commp =l add %node, 8
	%comm =l loadl %commp
	%need =w cugtl %nt, %comm
	jnz %need, @grow, @store
@grow
	call $cf_grow(l %node, l %nt)
	jmp @store
@store
	storel %nt, %node
	ret %p
}
function $cf_arena_pull(l %node, l %sz) {
@start
	%chunkp =l add %node, 40
	%chunk =l loadl %chunkp
	%usec =w culel %sz, %chunk
	jnz %usec, @c, @s
@c
	%bc =l copy %chunk
	jmp @al
@s
	%bs =l copy %sz
	jmp @al
@al
	%blksz =l phi @c %bc, @s %bs
	%parentp =l add %node, 24
	%parent =l loadl %parentp
	%bw =w copy %blksz
	%block =l call $cf_alloc(l %parent, w %bw)
	storel %block, %node
	%end =l add %block, %blksz
	%ecommp =l add %node, 8
	storel %end, %ecommp
	%elimp =l add %node, 16
	storel %end, %elimp
	ret
}
function l $cf_arena_of(l %node, w %n) {
@start
	%r7 =w add %n, 7
	%ra =w and %r7, -8
	%sz =l extuw %ra
	%hdr =l call $cf_alloc(l %node, w 48)
	%blk =l call $cf_alloc(l %node, w %n)
	storel %blk, %hdr
	%end =l add %blk, %sz
	%c8 =l add %hdr, 8
	storel %end, %c8
	%c16 =l add %hdr, 16
	storel %end, %c16
	%c24 =l add %hdr, 24
	storel %node, %c24
	%c32 =l add %hdr, 32
	storel 0, %c32
	%c40 =l add %hdr, 40
	storel 0, %c40
	ret %hdr
}
function l $cf_arena_grow(l %node, w %n) {
@start
	%r7 =w add %n, 7
	%ra =w and %r7, -8
	%sz =l extuw %ra
	%hdr =l call $cf_alloc(l %node, w 48)
	%blk =l call $cf_alloc(l %node, w %n)
	storel %blk, %hdr
	%end =l add %blk, %sz
	%g8 =l add %hdr, 8
	storel %end, %g8
	%g16 =l add %hdr, 16
	storel %end, %g16
	%g24 =l add %hdr, 24
	storel %node, %g24
	%g32 =l add %hdr, 32
	storel 1, %g32
	%g40 =l add %hdr, 40
	storel %sz, %g40
	ret %hdr
}
function l $cf_buffer_of(l %node, l %buf) {
@start
	%data =l loadl %buf
