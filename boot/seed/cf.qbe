	%c8 =l add %hdr, 8
	storel %end, %c8
	%c16 =l add %hdr, 16
	storel %end, %c16
	%c24 =l add %hdr, 24
	storel %node, %c24
	%c32 =l add %hdr, 32
	storel 0, %c32
