# an aggregate field may be spread-updated when it is explicitly overridden (not copied)
# expect: exit 11
import std::mem::arena::growing_arena
data Point = { Iarch x, Iarch y }
data Box = { Point p, Iarch tag }
const mk = (Iarch a): Point -> {
	const Point q = { x: a, y: a }
	return q
}

const main_body! = (): Iarch -> {
	const Box b1 = { p: mk(1), tag: 5 }
	const Box b2 = { ...b1, p: mk(3) }
	return b2.p.x + b2.p.y + b2.tag
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
