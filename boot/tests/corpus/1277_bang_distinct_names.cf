# `foo` and `foo!` are DISTINCT identifiers — the trailing `!` is part of the name, so the two
# functions coexist and resolve independently. `dub!` genuinely allocates (a trapped `Sq`), so the
# marker is valid under the allocation algebra.
# expect: exit 22
import "std/mem/arena/fixed_arena" as fixed_arena
data Sq = { Iarch v }
const dub = (Iarch x): Iarch -> x + x
const dub! = (Iarch x): Iarch -> {
	const Sq s = { v: x * x }
	return s.v
}
const main_body! = (): Iarch -> dub(3) + dub!(4)
pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
