# an array-return literal may hold computed elements; sum the returned array (4+20+30+42)
# expect: exit 96
const evens = (): [4 Iarch] -> [2 + 2, 20, 30, 42]

const sum4 = ([4 Iarch] xs): Iarch -> {
	let Iarch acc = 0
	for x in xs {
		acc += x
	}
	return acc
}

pub const main = () -> sum4(evens())
