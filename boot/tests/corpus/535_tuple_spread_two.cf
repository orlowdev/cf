# two spreads concatenate both tuples
# expect: exit 6

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const a = (1, 2)
	const b = (3, 0)
	const c = (...a, ...b)
	return c[0] + c[1] + c[2] + c[3]
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
