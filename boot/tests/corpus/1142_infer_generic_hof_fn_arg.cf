# Type-argument inference must not type a function-value argument: a generic function with BOTH a
# `'T` parameter and a function-type parameter passed a bare function name infers 'T from the other
# argument (5 → Iarch) and leaves the fn name alone. apply(5, inc) = inc(3) + 4 = 8.
# expect: exit 8
const inc = (Iarch n): Iarch -> n + 1
const apply = ['T]('T x, (Iarch) -> Iarch f): Iarch -> f(3) + 4
pub const main = () -> apply(5, inc)
