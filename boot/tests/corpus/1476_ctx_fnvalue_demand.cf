# A demand-carrying function cannot be taken as a VALUE: its ABI differs by its hidden demand
# arguments, which an indirect call site cannot supply (context.md §4).
# expect: error
import std::mem::ctx

data Cfg = { Str host }

pub const reader = (Iarch n): Iarch uses Cfg -> {
	const c = std::mem::ctx::consume(Cfg)

	return n + Iarch(c.host.len)
}

const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)

pub const main = () -> {
	return apply(reader, 3)
}
