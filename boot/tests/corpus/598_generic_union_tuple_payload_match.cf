# a generic union with a tuple payload constructs and matches (arms use the BASE name)
# expect: exit 30
import std::mem::arena::fixed_arena
union U['T] = { Pair((Iarch, 'T)), Empty }
const sum = (U[Iarch] u): Iarch -> match u {
	U.Pair(p) -> p[0] + p[1],
	U.Empty -> 0,
}

const main_body! = (): Iarch -> sum(U[Iarch].Pair((10, 20)))

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
