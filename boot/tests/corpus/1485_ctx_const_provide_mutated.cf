# A consumer mutates a context type provided `const` — the mode is the mutability line (context.md
# §3/§4): a mutating demand is discharged only by a `let` provide, so the const provide is rejected.
# expect: error
import std::mem::arena::growing_arena
import std::mem::ctx

data St = { Iarch n }

pub const bump = (): () uses St -> {
	let s = std::mem::ctx::consume(St)
	s.n = s.n + 1
}

pub const main = () -> {
	let St st = { n: 0 }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(st)
	bump()

	return 0
}
