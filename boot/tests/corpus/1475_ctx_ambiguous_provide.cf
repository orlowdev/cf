# Two provides in one scope can each discharge a `uses SentryConfig` demand — a direct provide of
# `SentryConfig` next to one of `AppConfig`, which embeds it by spread. Ambiguous (context.md §5).
# expect: error
import std::mem::arena::growing_arena
import std::mem::ctx

data SentryConfig = { Str sentry_host }
data AppConfig = { ...SentryConfig, Iarch flags }

pub const log = (): Str uses SentryConfig -> {
	const c = std::mem::ctx::consume(SentryConfig)

	return c.sentry_host
}

pub const main = () -> {
	const AppConfig app = { sentry_host: "ingest", flags: 3 }
	const SentryConfig sc = { sentry_host: "other" }
	const a = growing_arena::of(1024)
		|> std::mem::ctx::provide(app)
		|> std::mem::ctx::provide(sc)
	const Str h = log()

	return Iarch(h.len)
}
