# UPPER_SNAKE_CASE aggregate value consts: a record construction, a payload union member, a
# tag-only member, a Str/Bool/Int literal, and a chained const reading a field off another.
# Each reference constructs afresh in the referencing body (fold semantics = the old nullary
# auto-call), so locals bound off one are independent values.
# expect: exit 6
data Fd = { Uarch n }
union Color = { Red, Boxed(Fd) }
pub const STDOUT = Fd({ n: Uarch(1) })
pub const RED = Color.Red
pub const BOXED = Color.Boxed(Fd({ n: Uarch(4) }))
pub const CHAIN = STDOUT.n
pub const GREETING = "hi"
pub const LIMIT = 2
pub const ON = true

const pick = (): Fd -> STDOUT

pub const main = (): Iarch -> {
	let Iarch acc = 0
	acc = acc + Iarch(STDOUT.n)
	const Fd f = pick()
	acc = acc + Iarch(f.n) + Iarch(CHAIN) - 1
	acc = acc + match RED { Color.Red -> 1, _ -> 100 }
	acc = acc + match BOXED { Color.Boxed(b) -> Iarch(b.n) - 3, _ -> 100 }
	if ON then acc = acc + LIMIT
	if Iarch(GREETING.len) != 2 then acc = 100

	return acc
}
