# two modules each declare a type named `Pair`; flatten mangles them apart (a_Pair vs
# b_Pair) so both coexist — main imports a's Pair by name and uses b's only internally
# expect: exit 42
import a::{ Pair, mk, sum }
import b::{ val }

pub const main = () -> {
	const Pair p = mk()
	return sum(p) + val()
}
