# Str construction `Str({ bytes, len })`: a Str is a builtin `{bytes@0, len@8}` header, now buildable
# from a byte pointer/array and a length. Build a byte vector in the arena, wrap it, and read the
# length back; also wrap a fixed array and confirm its bytes print. exit = built-Str length (5).
# expect: exit 5
import std::io::console::{ print }
import std::mem::arena::growing_arena

const make = (): Str -> {
	let [Uint8] out = []
	out = [...out, Uint8(104)]
	out = [...out, Uint8(101)]
	out = [...out, Uint8(108)]
	out = [...out, Uint8(108)]
	out = [...out, Uint8(111)]

	return Str({ bytes: out, len: Iarch(out.len) })
}

const run! = (): Iarch -> {
	const Str s = make()

	print("${s}\n")

	let [3 Uint8] b = [99, 102, 33]
	const Str t = Str({ bytes: b, len: 3 })

	print("${t}\n")

	return Iarch(s.len)
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return run!() in a
}
