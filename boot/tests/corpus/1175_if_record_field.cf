# a field read on an `if` that YIELDS a record (`(if … ).v`) — the branch's record type is
# recovered so the field dispatches (previously the type was lost and cf dereferenced recs[-1])
# expect: exit 9
data Bag = { Iarch v }
pub const main = () -> {
	let Bag p = Bag({ v: 5 })
	let Bag q = Bag({ v: 9 })
	return (if false then p else q).v
}
