# a record field may be a tag-only union (a word field carrying the tag)
# expect: exit 105
import "std/mem/arena/fixed_arena" as fixed_arena
union Color = { Red, Green, Blue }
data Cell = { Iarch n, Color c }

const main_body! = (): Iarch -> {
	const Cell cell = { n: 5, c: Color.Green }
	return cell.n + (match cell.c {
		Color.Red -> 0,
		Color.Green -> 100,
		Color.Blue -> 200,
	})
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
