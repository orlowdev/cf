# A defer fires AFTER the return value is fixed: `return c.v` snapshots 7 into the
# result before the defer zeroes the field, so the caller still sees 7.
# expect: exit 7
# check: root
data Cell = { Iarch v }
const run! = (): Iarch -> {
	let Cell c = { v: 7 }
	defer { c.v = 0 }
	return c.v
}

const main_body! = (): Iarch -> run!()

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
