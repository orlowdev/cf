# a `*[T]` parameter accepts a CALL result (an array-returning function) as its argument
# expect: exit 45
const mk = (): [Iarch] -> [5, 15, 25]
const sum = (*[Iarch] xs, Iarch n): Iarch -> {
	let s = 0
	let i = 0
	loop {
		if i >= n then break
		s = s + xs[i]
		i = i + 1
	}
	return s
}
pub const main = () -> sum(mk(), 3)
