# scan a Str for a char with char-literal comparisons (the lexer pattern), by index
# expect: exit 2
pub const main = () -> {
	const Str src = "a,b,c"
	let Iarch commas = 0
	let Iarch i = 0
	loop {
		if i >= src.len then break
		if src[i] == ',' then commas = commas + 1
		i = i + 1
	}
	return commas
}
