# a `let Str` is reassigned any Str-valued expression — a literal, an interpolation, and
# another Str variable — ending at "xyz" (length 3)
# expect: exit 3

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let Str s = "a"
	const Iarch n = 42
	s = "n=${n}"
	const Str other = "xyz"
	s = other
	return s.len
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
