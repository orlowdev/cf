# An `if` EXPRESSION whose branches are value BLOCKS `{ … <- v }` (a nested scope that yields
# with `<-`, per ebnf.md §Control Flow): each branch runs statements then yields the merge value.
# expect: exit 42
pub const main = () -> {
	let Iarch n = 0
	let Iarch x = if n == 0 then { let Iarch t = 40 <- t + 2 } else { <- 1 }
	return x
}
