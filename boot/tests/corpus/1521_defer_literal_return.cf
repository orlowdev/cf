# a defer-carrying `return <literal>` must build the value in the arena, not on the dying frame:
# the lowering's snapshot binding (`__cf_dret`) must not trip the `$`-stack path (the old `$ret`
# name did — the caller read clobbered garbage; the union/array shapes died in emit). The clobber
# recursion scribbles over the dead frame before the fields are read.
# expect: exit 0
import std::io::console::{ println }

data Point = { Int x, Int y }

union Box = { Some(Int), Nada }

const mk = (): Point -> {
	defer println("defer ran")

	return Point({ x: 11, y: 22 })
}

const mk_arr = (): [Iarch] -> {
	defer println("arr defer ran")

	return [7, 8, 9]
}

const mk_box = (): Box -> {
	defer println("box defer ran")

	return Box.Some(55)
}

const clobber = (Int d): Int -> {
	if d == 0 then return 7

	return clobber(d - 1) + d
}

pub const main = (): Int -> {
	const p = mk()
	const xs = mk_arr()
	const b = mk_box()
	const c = clobber(50)
	if c == 0 then return 8
	if p.x != 11 then return 1
	if p.y != 22 then return 2
	if xs[0] + xs[1] + xs[2] != 24 then return 5

	return match b {
		Box.Some(v) -> if v == 55 then 0 else 6,
		Box.Nada -> 7,
	}
}
