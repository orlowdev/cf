# a generic function's type argument is inferred from a match-arm payload binder (`id(v)`)
# expect: exit 42
union Maybe['V] = { Just('V), Nothing }
const id = ['T]('T v): 'T -> v
pub const main = (): Iarch -> {
	const Maybe[Iarch] m = Maybe[Iarch].Just(42)
	return match m { Maybe.Just(v) -> id(v), Maybe.Nothing -> 0 }
}
