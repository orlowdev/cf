# `for x in xs` iterates a scalar-element `[Iarch]` param (the loop var is the element).
# expect: exit 6
import std::mem::arena::growing_arena
const sumd = ([Iarch] xs): Iarch -> {
	let Iarch acc = 0
	for x in xs {
		acc = acc + x
	}
	return acc
}

const main_body! = (): Iarch -> {
	let [Iarch] xs = [1, 2, 3]
	return sumd(xs)
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
