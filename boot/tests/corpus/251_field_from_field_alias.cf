# a record field value may be another record's field (an alias) — the borrowed arena
# record rides into the new aggregate; safe in the never-freed bump arena (M0)
# expect: exit 1
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
data Line = { Point a, Point b }
const mk = (Iarch x, Iarch y): Point -> {
	const Point p = { x: x, y: y }
	return p
}

const main_body! = (): Iarch -> {
	const Line src = { a: mk(1, 2), b: mk(3, 4) }
	const Line dst = { a: src.a, b: mk(5, 6) }
	return dst.a.x
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
