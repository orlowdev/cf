# Stage 0 of the geometry-modules arc: the raw-memory substrate (`mem.raw.*`, `size_of`)
# drives through std/mem/probe — a store/load roundtrip in raw bytes, a record placed at
# a raw address and read back through the placed copy, and the record's slot size.
# 17 (roundtrip) + 12 + 13 (placed fields) + 16 (size_of Probe) + 2 = 60.
# expect: exit 60
import "std/mem/probe" as { Probe, raw_roundtrip, probe_size, place_probe }

const main_body! = (): Iarch -> {
	let [32 Uint8] buf
	const Uarch w = raw_roundtrip(buf, 17)
	const Probe p = Probe({ a: 12, b: 13 })
	const Probe q = place_probe(buf, p)
	return Iarch(w) + q.a + q.b + Iarch(probe_size(p)) + 2
}
pub const main = () -> {
	const a = mem.arena.of(65536)
	return main_body!() in a
}
