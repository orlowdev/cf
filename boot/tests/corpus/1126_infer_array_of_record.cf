# a type variable inferred to an array of a RECORD (`'T = [Point]`)
# expect: exit 42
import "std/mem/arena/growing_arena" as growing_arena
data Point = { Iarch x }
const id = ['T]('T v): 'T -> v

const main_body! = (): Iarch -> {
	let [Point] ps = []
	ps = [...ps, Point({ x: 42 })]
	const [Point] qs = id(ps)
	return qs[0].x
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
