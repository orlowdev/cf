# puns and explicit `field: value` entries may be mixed
# expect: exit 6
data V = { Iarch a, Iarch b, Iarch c }

const main_body! = (): Iarch -> {
	const Iarch a = 1
	const Iarch c = 3
	const V v = { a, b: 2, c }
	return v.a + v.b + v.c
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
