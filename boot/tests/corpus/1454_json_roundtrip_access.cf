# std::data::json: a document parses to a value, renders back BYTE-IDENTICAL (numbers keep
# their lexemes, object order is preserved), and get/at/as_int walk into it
# expect: exit 0
import std::mem::arena::growing_arena
import std::data::{ Either, Maybe }
import std::data::json::{ Json, parse!, render!, get, at, as_int }
import std::data::str::{ eq }
import std::io::console::{ println }

const demo! = (): Iarch -> {
	const Str doc = "{\"name\":\"cf\",\"tags\":[\"lang\",\"compiler\"],\"version\":{\"major\":3,\"minor\":14},\"ok\":true,\"note\":null}"

	const Json j = match parse!(doc) {
		Either.Left(e) -> {
			println("parse failed: ${e.msg} at ${e.off}")

			<- Json.Null
		},
		Either.Right(v) -> v,
	}

	const Str back = render!(j)
	println(back)
	if !eq(back, doc) then return 1

	const Iarch major = match get("version", j) {
		Maybe.Just(v) -> match get("major", v) {
			Maybe.Just(mj) -> match as_int(mj) {
				Either.Right(n) -> n,
				Either.Left(e2) -> -1,
			},
			Maybe.Nothing -> -1,
		},
		Maybe.Nothing -> -1,
	}

	const Json tags = match get("tags", j) { Maybe.Just(t) -> t, Maybe.Nothing -> Json.Null }
	const Json tag1 = match at(1, tags) { Maybe.Just(t) -> t, Maybe.Nothing -> Json.Null }
	const Str tag = match tag1 { Json.JStr(s) -> s, _ -> "" }

	println("major=${major} tag=${tag}")
	if major != 3 then return 2
	if !eq(tag, "compiler") then return 3

	return 0
}

pub const main = (): Iarch -> {
	const a = growing_arena::of(1048576)

	return demo!() in a
}
