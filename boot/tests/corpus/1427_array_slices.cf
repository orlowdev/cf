# std::data::array order and range operations: `reverse` flips into a fresh array, `slice` copies
# a clamped [start, stop) window, `take`/`drop` split off a prefix/suffix, `range` builds the
# integers [from, to). 3 + 8 + 7 - 7 + 1 + 2 + 4 + 5 = 23.
# expect: exit 23
import std::mem::arena::growing_arena
import std::data::array::{ reverse, slice, take, drop, range, is_empty }

const main_body! = (): Iarch -> {
	const xs = range(1, 6)

	const r = reverse([1, 2, 3])
	if r[2] != 1 then return 1

	const sl = slice(1, 3, [9, 8, 7, 6])
	if Iarch(sl.len) != 2 then return 2

	const wide = slice(2, 99, [9, 8, 7, 6])
	if Iarch(wide.len) != 2 then return 3

	const tk = take(2, xs)
	const dr = drop(3, xs)
	if !is_empty(drop(9, xs)) then return 4
	if Iarch(take(9, xs).len) != 5 then return 5

	return r[0] + sl[0] + sl[1] - 7 + tk[0] + tk[1] + dr[0] + dr[1]
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body!() in ar
}
