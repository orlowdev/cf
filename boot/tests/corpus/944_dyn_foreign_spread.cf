# a `[T]` may be reassigned a copy-append from a FOREIGN source (`ys = [...xs, e]`) —
# the source is COPIED (not aliased) and the extra element appended; ys = [1,2,5]
# expect: exit 3

const main_body! = (): Iarch -> {
	let [Iarch] xs = [1, 2]
	let [Iarch] ys = [3, 4]
	ys = [...xs, 5]
	return ys.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
