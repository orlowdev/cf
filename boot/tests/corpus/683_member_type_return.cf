# A return type may be a member type (`Maybe[Iarch].Just`); it collapses to the union return.
# expect: exit 9
union Maybe['V] = { Just('V), Nothing }
const mk = (Iarch n): Maybe[Iarch].Just -> Maybe[Iarch].Just(n)
const unwrap = (Maybe[Iarch] m): Iarch -> match m {
	Maybe.Just(v) -> v,
	Maybe.Nothing -> 0,
}
pub const main = () -> unwrap(mk(9))
