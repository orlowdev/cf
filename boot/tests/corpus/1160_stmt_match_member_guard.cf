# a STATEMENT-position guarded match: a nested member sub-pattern guards on a
# union-typed payload field's tag, dispatched for effect (each arm mutates `a`)
# expect: exit 42
import std::mem::arena::growing_arena
union Op = { Add, Sub }
union Expr = { Lit(Iarch), Bin(Op, Iarch, Iarch) }
const eval = (Expr e): Iarch -> {
	let Iarch a = 0
	match e {
		Expr.Lit(v) -> { a = v },
		Expr.Bin(Add, l, r) -> { a = l + r },
		Expr.Bin(Sub, l, r) -> { a = l - r },
		_ -> { a = 0 },
	}
	return a
}

const main_body! = (): Iarch -> eval(Expr.Bin(Op.Add, 40, 2)) + eval(Expr.Bin(Op.Sub, 5, 5))

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
