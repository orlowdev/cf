# a `!` function passed by name as a function-value argument: the marker rides the name through
# resolution and the indirect call dispatches to it. `sq!` genuinely allocates (a trapped `Sq`);
# `apply` only invokes its callback parameter, so it stays colorless (HOF definition-side rule).
# check: alloc
# expect: exit 25
data Sq = { Iarch v }
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const sq! = (Iarch x): Iarch -> {
	const Sq s = { v: x * x }
	return s.v
}
pub const main = () -> apply(sq!, 5)
