# a `!` function passed by name as a function-value argument: the marker rides the name
# through resolution and the indirect call dispatches to it.
# expect: exit 25
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const sq! = (Iarch x): Iarch -> x * x
pub const main = () -> apply(sq!, 5)
