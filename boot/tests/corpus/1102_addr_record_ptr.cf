# *Record pointer param + &address-of: mutate a field through the pointer, twice
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
data Counter = { Iarch n }
const inc = (*Counter c): Iarch -> {
	c.n = c.n + 1
	return c.n
}

const main_body! = (): Iarch -> {
	let Counter c = Counter({ n: 40 })
	const Iarch a = inc(&c)
	const Iarch b = inc(&c)
	return b
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
