# An explicit `*Point` pointer FIELD (the explicit form of a recursive/aggregate reference; a
# bare `Point` field is the G3a implicit-pointer form). Build the pointer with `&`, then read
# a field through it.
# expect: exit 5
data Point = { Iarch x }
data Box = { Iarch k, *Point p }
const readit = (Box b): Iarch -> b.k + b.p.x

const main_body! = (): Iarch -> readit(Box({ k: 2, p: &Point({ x: 3 }) }))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
