# A statement-position `match` dispatched for EFFECT: each arm is a `{ ... }` block that
# mutates an outer `let`, one arm binds a payload, one is the `_` wildcard.
# expect: exit 7
import std::mem::arena::growing_arena
union Shape = { Dot, Circle(Iarch), Square(Iarch) }
const area = (Shape s): Iarch -> {
	let Iarch a = 0
	match s {
		Shape.Circle(r) -> { a = r + r },
		Shape.Square(w) -> { a = w },
		_ -> { a = 0 }
	}
	return a
}

const main_body! = (): Iarch -> {
	return area(Shape.Circle(2)) + area(Shape.Square(3)) + area(Shape.Dot)
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
