# a `Bool` union payload, recovered by `match` and used in the arm.
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
union M = { B(Bool), Z }

const main_body! = (): Iarch -> {
	const M m = M.B(true)
	return match m {
		M.B(f) -> if f then 7 else 0,
		M.Z -> 0
	}
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
