# a `Float32` tuple element (QBE `s`, `stores`/`loads`), built with an explicit `Float32(...)` cast.
# expect: exit 9

# check: root
const main_body! = (): Iarch -> {
	const t = (Float32(7.5), 2)
	return Iarch(t[0]) + t[1]
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
