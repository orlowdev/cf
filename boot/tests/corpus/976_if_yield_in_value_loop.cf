# a value-yielding loop whose `<- v` sits inside an `if` block-branch (same loop scope)
# expect: exit 25
pub const first_over = (Iarch limit): Iarch -> {
	let Iarch i = 0
	const Iarch found = loop {
		if i * i > limit then {
			<- i
		}
		i = i + 1
	}
	return found
}
pub const main = () -> {
	let Iarch acc = first_over(20)
	return acc * 5
}
