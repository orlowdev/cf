# Stage 4, aggregate coverage — the RESIDUE side: frame-local arrays and tuples built in a loop
# body under `fixed_buffer` reserve through `reserve_alloc` (bump the residue cursor DOWN) and
# are reclaimed in bulk by the loop's `on_scope_enter`/`on_scope_exit` bracket each iteration —
# the same fold-lite records already took, now for aggregates. Each iteration bumps a 24+32-byte
# array (header + backing) and a 16-byte tuple onto the residue side of a 2 KiB two-ended pool;
# 1000 iterations fit ONLY because the exit hook rewinds the cursor every pass. A non-reserved
# (floor `cf_alloc`) or non-reclaimed aggregate would overflow the block and trap.
# expect: exit 0
import std::mem::fixed_buffer

const churn! = (Iarch n): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const [Iarch] xs = [i, i + 1, i + 2, i + 3]
		const t = (i * 5, i * 7)
		acc = acc + xs[0] + xs[1] + xs[2] + xs[3] + t[0] + t[1]
		i = i + 1
	}
	return acc
}

static [2048 Uint8] pool
pub const main = () -> {
	const fb = fixed_buffer::of(pool)
	# per i: (4i+6) + (12i) = 16i+6; sum i=0..999 = 16*499500 + 6000 = 7998000
	const Iarch total = churn!(1000) in fb
	return total - 7998000
}
