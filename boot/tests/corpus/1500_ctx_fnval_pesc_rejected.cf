# A demand-carrying flow into a fn-typed parameter that itself ESCAPES as a value cannot be
# tracked to its call sites (context.md §4) — rejected at the flow.
# expect: error
import std::mem::arena::fixed_arena
import std::mem::arena::test_arena
import std::mem::ctx
import std::test::{ Verdicts, equals }

const val = (Iarch x): Iarch -> x

const checker = (): () -> {
	val(1) |> equals(1)
}

const runner! = (() -> () cb): Uarch -> {
	let Verdicts vd = { desc: "r", count: 0, fails: 0 }
	const ta = test_arena::of(65536) |> std::mem::ctx::provide(let vd)
	const held = cb
	test_arena::destroy(ta)
	return vd.fails
}

const main_body! = (): Uarch -> runner!(checker)

pub const main = () -> {
	const a = fixed_arena::of(1048576)
	const Uarch f = main_body!() in a
	return Iarch(f)
}
