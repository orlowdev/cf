# a heterogeneous tuple: an Iarch and a fresh record; index the record then read a field
# expect: exit 47
data P = { Iarch x, Iarch y }
const mk = (Iarch a, Iarch b): P -> P({ x: a, y: b })

const main_body! = (): Iarch -> {
	const t = (5, mk(42, 100))
	return t[0] + t[1].x
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
