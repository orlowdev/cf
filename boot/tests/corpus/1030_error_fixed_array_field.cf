# an inline fixed-array field `[N T]` holds a flat byte span indexed by element width, so its
# element must be a word scalar — an aggregate element (here a record) has no inline stride and is
# rejected with a helpful message.
# expect: error
data Point = { Iarch x, Iarch y }
data Ctx = { [3 Point] xs }
pub const main = () -> 0
