# a `[Float64]` array iterated with `for` (each element binds a float local) plus `.len`. The sum
# 1+2+3 = 6, plus length 3 = 9.
# expect: exit 9

const main_body! = (): Iarch -> {
	let [Float64] xs = [1.0, 2.0, 3.0]
	let Float64 acc = 0.0
	for x in xs {
		acc = acc + x
	}
	return Iarch(acc) + Iarch(xs.len)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
