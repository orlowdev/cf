# std::data::maybe::catas — the forks out of `Maybe`: `fold` collapses both cases, `or_else`
# defaults an absence, `to_either` explains it (via the full path — `either::catas` and
# `maybe::catas` share member names, so one side goes unimported), `to_tuple` hands back
# `(present, value)`. 20 + 9 + 7 + 5 + 1 = 42.
# expect: exit 42
import std::data::{ Either, Maybe }
import std::data::maybe::ops::{ of }
import std::data::maybe::catas::{ fold, or_else, to_either, to_tuple }

const double = (Iarch n): Iarch -> n * 2

pub const main = () -> {
	const Maybe[Iarch] none = Maybe[Iarch].Nothing

	const a = of[Iarch](10) |> fold[Iarch, Iarch](double, 9)
	const b = none |> fold[Iarch, Iarch](double, 9)
	const c = or_else[Iarch](7, none)

	const Either[Str, Iarch] explained = of[Iarch](5) |> to_either[Str, Iarch]("gone")
	const d = std::data::either::catas::or_else[Str, Iarch](0, explained)

	const (ok, v) = to_tuple[Iarch](3, of[Iarch](4))
	const (ok2, v2) = to_tuple[Iarch](3, none)

	if !ok || ok2 || v != 4 then return 1

	return a + b + c + d + v2 - 2
}
