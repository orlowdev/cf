# the flip side: a return-position spread is NOT residue, so marking its producer `!` is a
# redundant-marker error. Guards the escape analysis that credits the spread's source as escaping.
# expect: error
import std::mem::arena::growing_arena
const build! = (Iarch n): [Uint8] -> {
	let [Uint8] out = []
	let Iarch k = 0
	loop {
		if k >= n then break
		out = [...out, Uint8(65)]
		k = k + 1
	}
	return [...out, Uint8(90)]
}
pub const main = () -> {
	const a = growing_arena::of(4096)
	return Iarch(build!(1).len) in a
}
