# build "Hi" + newline byte by byte in a buffer, write() it to stdout (string-output payoff)
# expect: exit 3
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Iarch -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const write = (Uarch fd, *[Uint8] buf, Uarch n): Iarch -> syscall6(4, fd, buf, n, 0, 0, 0)

const main_body! = (): Iarch -> {
	let [8 Uint8] buf
	buf[0] = 72
	buf[1] = 105
	buf[2] = 10
	return write(Uarch(1), buf, Uarch(3))
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
