# a nested type constructor `Box[Pair[Iarch, Iarch]]`
# expect: exit 30
import "std/mem/arena/fixed_arena" as fixed_arena
data Pair['A, 'B] = { 'A a, 'B b }
data Box['T] = { 'T v }
const mkpair = (Iarch a, Iarch b): Pair[Iarch, Iarch] -> {
	const Pair[Iarch, Iarch] p = { a: a, b: b }
	return p
}

const main_body! = (): Iarch -> {
	const Box[Pair[Iarch, Iarch]] b = { v: mkpair(10, 20) }
	return b.v.a + b.v.b
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
