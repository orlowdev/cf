# an else-if chain of returns (nested statement-if in the else branch)
# expect: exit 20
pub const grade = (Iarch n): Iarch -> {
	if n >= 90 then return 4 else if n >= 80 then return 3 else if n >= 70 then return 2 else return 1
}
pub const main = () -> grade(95) * 1 + grade(85) * 2 + grade(60) * 10
