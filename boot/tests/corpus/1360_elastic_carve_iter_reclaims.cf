# The elastic residue-carve: a per-iteration elastic child whose handle is geom-only routes
# residue-side — header, initial block AND pull chunks die at each back-edge — even though
# the survivor loop mark is disqualified (&acc). 200 x ~36KiB through a 256KiB parent fits
# only under the interlock (the pre-interlock compiler exits 70).
# expect: exit 42
data Acc = { Iarch n }
const work! = (Iarch k): Iarch -> {
	let [Iarch] xs = []
	let Iarch i = 0
	loop {
		if i >= 4000 then break
		xs = [...xs, i]
		i = i + 1
	}
	return xs[k]
}
const bump = (*Acc a): Iarch -> {
	a.n = a.n + 1
	return 0
}
const run! = (Iarch n): Iarch -> {
	let Acc acc = Acc({ n: 0 })
	let Iarch s = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const b = mem.arena.grow(4096)
		const Iarch w = work!(2) in b
		s = s + w
		bump(&acc)
		i = i + 1
	}
	return s / n + acc.n - n + 40
}
pub const main = () -> {
	const a = mem.arena.of(262144)
	return run!(200) in a
}
