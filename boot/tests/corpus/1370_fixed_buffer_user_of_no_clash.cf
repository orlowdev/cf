# The auto-loaded geometry module's internals are tag-mangled (`of` → `of__fb`), so a user
# function sharing a hook's name never collides with the geometry source — auto-load adds
# no names to the user's namespace at all. 30+3 stored through the pool, exit 33.
# expect: exit 33
data Box = { Iarch v }
const of = (Iarch n): Iarch -> n + 3
const body! = (): Iarch -> {
	const Box b = { v: of(30) }
	return b.v
}
static [2048 Uint8] pool
pub const main = () -> {
	const fb = mem.fixed_buffer.of(pool)
	return body!() in fb
}
