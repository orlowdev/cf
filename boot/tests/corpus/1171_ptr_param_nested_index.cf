# a `*[T]` parameter accepts an INDEX read into a `[[T]]` (`m[1]` yields a `[Iarch]` row) — its
# data pointer is passed
# expect: exit 100
# check: root
const sum = (*[Iarch] xs, Iarch n): Iarch -> {
	let s = 0
	let i = 0
	loop {
		if i >= n then break
		s = s + xs[i]
		i = i + 1
	}
	return s
}

const main_body! = (): Iarch -> {
	let [2 Iarch] r0 = [1, 2]
	let [2 Iarch] r1 = [30, 70]
	let [[Iarch]] m = [r0, r1]
	return sum(m[1], 2)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
