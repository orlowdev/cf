# The spec'd for-loop forms beyond a block over a name: a ONE-LINE body (the body is a branch —
# a single same-line statement), and a full EXPRESSION iterable (a call result, bound behind the
# scenes). 4 + 15 + 30 - 7 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::array::{ range }

const main_body! = (): Iarch -> {
	let Iarch s = 0
	const [Iarch] xs = [1, 2, 3]

	for x in xs if x != 2 then s = s + x
	for x in range(1, 6) { s = s + x }
	for x in range(0, 3) s = s + x * 10

	return s - 7
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body!() in ar
}
