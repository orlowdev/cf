# a `*[T]` parameter accepts a record FIELD read (`b.items`) as its argument — the array field's
# data pointer is passed
# expect: exit 100
import std::mem::arena::growing_arena
data Bag = { [Iarch] items }
const sum = (*[Iarch] xs, Iarch n): Iarch -> {
	let s = 0
	let i = 0
	loop {
		if i >= n then break
		s = s + xs[i]
		i = i + 1
	}
	return s
}

const main_body! = (): Iarch -> {
	const Bag b = Bag({ items: [1, 2, 3, 4, 90] })
	return sum(b.items, 5)
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
