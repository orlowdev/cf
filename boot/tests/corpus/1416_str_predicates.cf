# std::str predicates ride data-last: the subject string is the final argument, so a value pipes
# into a preconfigured check (`s |> ends_with(".cf")`). `contains`/`index_of` scan for a needle
# (`not_found` on a miss), `slice` clamps its byte range to the string.
# expect: exit 42
import std::str::{ eq, is_empty, starts_with, ends_with, contains, index_of, not_found, slice }

pub const main = () -> {
	const Bool piped = "hello.cf" |> ends_with(".cf")

	if !piped then return 1
	if !starts_with("pub ", "pub const x") then return 2
	if starts_with("pub const x too long", "pub") then return 3
	if !contains("lo w", "hello world") then return 4
	if contains("xyz", "hello world") then return 5
	if index_of("world", "hello world") != 6 then return 6
	if index_of("xyz", "hello world") != not_found then return 7
	if index_of("", "abc") != 0 then return 8
	if !is_empty("") then return 9
	if is_empty("a") then return 10
	if !eq(slice(6, 11, "hello world"), "world") then return 11
	if !eq(slice(6, 99, "hello world"), "world") then return 12
	if !is_empty(slice(3, 3, "abc")) then return 13

	return 42
}
