# the expanded std::io::console surface: print (no newline), println (adds one), and the stderr
# variants eprint/eprintln — all fire-and-forget, yielding unit. Exit 0 proves the whole barrel →
# platform → syscall chain for every member.
# expect: exit 0
import std::io::console::{ print, println, eprint, eprintln }
pub const main = (): Iarch -> {
	print("no-newline ")
	println("then a line")
	eprint("stderr ")
	eprintln("also a line")
	return 0
}
