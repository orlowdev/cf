# a field read is an Iarch, so it may be a call argument
# expect: exit 12
import std::mem::arena::fixed_arena
data Point = { Iarch x, Iarch y }
const twice = (Iarch n): Iarch -> n + n

const main_body! = (): Iarch -> {
	const Point p = { x: 6, y: 1 }
	return twice(p.x)
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
