# a group field may be a record type; the group literal carries the record value.
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
type Boxed = { Point p, Iarch extra }
const use = (Boxed b): Iarch -> p.x + p.y + extra

const main_body! = (): Iarch -> {
	const Point pt = { x: 1, y: 2 }
	return use({ p: pt, extra: 4 })
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
