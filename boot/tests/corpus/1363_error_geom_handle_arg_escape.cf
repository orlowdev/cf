# A geometry handle may not be handed to a callee as a value: passing the node out lets the callee
# use it as an ambient the compiler cannot trace to a constructor (and could stash it past a reset).
# A geometry is spent in place — run work `... in b` and reclaim with `defer destroy(b)`. Forwarding
# the handle itself is rejected at compile time (geometry_lowering §1). The `... in b` ambient is not
# an argument, so it is unaffected; only the bare value use `peek(b)` trips the rule.
# expect: error
import std::mem::arena::growing_arena
const peek = (Iarch h): Iarch -> h - h
pub const main = () -> {
	const b = growing_arena::of(4096)
	return peek(b)
}
