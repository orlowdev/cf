# `os::target` / `arch::target` in VALUE position: emit folds each bare reference to the target's
# tag immediate (the member's index in std::sys — tag-only unions are their tag word), so the
# intrinsics work as ordinary `Os`/`Arch` values — a `let` initializer, a `match` subject, an
# argument — not only inside a module-level comptime `if` condition. The assertions compare the
# folded VALUE against the fold at another use site, so the test passes on every `--target`.
# expect: exit 7
import std::sys::{ Os, Arch }
import std::comptime::os
import std::comptime::arch

const os_name = (Os o): Str -> match o {
	Os.Darwin -> "darwin",
	Os.Linux -> "linux",
	Os.Bare -> "bare",
}

pub const main = (): Iarch -> {
	let Os t = os::target
	let Arch a = arch::target

	# the value equals the intrinsic at another use site, and flows through a call
	if t == os::target && a == arch::target && Iarch(os_name(t).len) > 0 then return 7

	return 1
}
