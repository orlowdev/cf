# element assignment into a `let [N Int16]` array stores at the element width
# expect: exit 54

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	let [3 Int16] xs = [1, 2, 3]
	xs[1] = Int16(50)
	return Iarch(xs[0]) + Iarch(xs[1]) + Iarch(xs[2])
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
