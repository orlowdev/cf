# `mem.fixed_buffer.of(buf)` wraps a caller-provided `[N Uint8]` buffer as a bounded bump geometry —
# the last bump-family member (geometry_lowering §5). Creating it allocates nothing: the node header
# is laid over the FRONT of the buffer and blocks are handed out after it. Here `run!` (grafted under
# a real arena so the buffer itself is not root residue) wraps a 4 KiB scratch buffer and runs
# `build!` in it; the Box lives in the buffer and only the scalar 28 - 7 = 21 leaves.
# expect: exit 21
data Box = { Iarch lo, Iarch hi }
const build! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 4 }
	return b.hi - b.lo
}
const run! = (Iarch n): Iarch -> {
	let [4096 Uint8] scratch
	const fb = mem.fixed_buffer.of(scratch)
	return build!(n) in fb
}
pub const main = () -> {
	const a = mem.arena.grow(65536)
	return run!(7) in a
}
