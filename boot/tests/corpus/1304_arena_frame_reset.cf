# Per-frame reset (geometry_lowering §2): a `!` function that returns a SCALAR and takes no writable
# pointer holds only trapped residue, so its frame is rewound to the entry cursor at return. Here a
# 100 KiB scratch buffer is allocated 50 times in a 1 MiB FIXED arena — 5 MiB total. Without the
# reset it would overflow and trap; with it each frame is reclaimed, peak stays ~100 KiB, exit 42.
# expect: exit 42
const scratch! = (Iarch k): Iarch -> {
	let [102400 Uint8] buf
	return k
}
pub const main = () -> {
	const a = mem.arena.of(1048576)
	let Iarch j = 0
	loop {
		if j >= 50 then break
		const Iarch r = scratch!(j) in a
		j = j + 1
	}
	return 42
}
