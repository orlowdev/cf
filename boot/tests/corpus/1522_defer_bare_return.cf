# a BARE record literal adopts the type its position supplies (barefill) even when a lowering
# moves it: defer snapshots the return value into a fresh binding, and the stamped name rides
# with the literal — `return ({...})` + defer used to die in emit ("record type is unknown").
# Nested bare literals resolve through the stamped root; a value-loop return stamps too.
# expect: exit 0
import std::io::console::{ println }

data Point = { Int x, Int y }

data Wrap = { Point inner, Int tag }

const mk_bare = (): Point -> {
	defer println("bare defer ran")

	return ({ x: 33, y: 44 })
}

const mk_nest = (): Wrap -> {
	defer println("nest defer ran")

	return ({ inner: ({ x: 5, y: 6 }), tag: 9 })
}

const mk_loop = (Int n): Point -> {
	const k = loop {
		if n > 0 then return ({ x: 77, y: 88 })
		<- 1
	}

	return Point({ x: k, y: 0 })
}

const clobber = (Int d): Int -> {
	if d == 0 then return 7

	return clobber(d - 1) + d
}

pub const main = (): Int -> {
	const q = mk_bare()
	const w = mk_nest()
	const v = mk_loop(1)
	const c = clobber(50)
	if c == 0 then return 9
	if q.x != 33 then return 1
	if q.y != 44 then return 2
	if w.inner.x != 5 then return 3
	if w.inner.y != 6 then return 4
	if w.tag != 9 then return 5
	if v.x != 77 then return 6
	if v.y != 88 then return 7

	return 0
}
