# `&` produces a `*Point`; the reverse (deref) is implicit: a `*Point` value satisfies a
# by-value `Point` parameter. `relay` takes the pointer and forwards it both ways.
# expect: exit 11
import std::mem::arena::fixed_arena
data Point = { Iarch x, Iarch y }
const use_val = (Point p): Iarch -> p.x
const use_ptr = (*Point p): Iarch -> p.y
const relay = (*Point p): Iarch -> use_val(p) + use_ptr(p)

const main_body! = (): Iarch -> {
	const Point pt = { x: 5, y: 6 }
	return relay(&pt)
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
