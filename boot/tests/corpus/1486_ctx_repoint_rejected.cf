# Mutation of a `let` provide is IN-PLACE ONLY (context.md §3): repointing an aggregate field at a
# consumer-fresh value is rejected — the fresh value is born in a descendant arena that dies before
# the provider's, so the record would outlive what it points at.
# expect: error
import std::mem::arena::growing_arena
import std::mem::ctx

data Inner = { Iarch v }
data St = { Inner inner }

pub const repoint! = (): () uses St -> {
	let s = std::mem::ctx::consume(St)
	s.inner = Inner({ v: 9 })
}

pub const main = () -> {
	let St st = { inner: Inner({ v: 0 }) }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(let st)
	repoint!()

	return 0
}
