# A type argument is inferred STRUCTURALLY from a `['T]` parameter (the variable is the array's
# ELEMENT, not the whole parameter): first(a) with a `[Iarch]` binds 'T = Iarch, no explicit `[…]`.
# expect: exit 10
# check: root
const first = ['T](['T] xs): 'T -> xs[0]

const main_body! = (): Iarch -> {
	let [Iarch] a = [10, 20]
	return first(a)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
