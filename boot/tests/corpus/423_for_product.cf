# accumulate a running product across the array
# expect: exit 24

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	const [4 Iarch] xs = [1, 2, 3, 4]
	let Iarch p = 1
	for x in xs {
		p = p * x
	}
	return p
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
