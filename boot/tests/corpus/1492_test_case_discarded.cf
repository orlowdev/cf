# A top-level `case!`/`todo!` (testing.md §1) is thrown away by an ordinary build — only `cf test`
# builds the runner over them. Here a normal `cf <file> -o <bin>` compiles the module: the cases are
# parsed and type-checked (so `equals` must resolve) but left unreached, and the module's own `main`
# is the entry. Exit is main's 7, proving the cases contributed nothing.
# expect: exit 7
import std::test::{ equals }

const add = (Iarch a, Iarch b): Iarch -> a + b

std::test::case!("adds", () -> {
	add(2, 2) |> equals(4)
})

std::test::todo!("pending", () -> {
	add(1, 1) |> equals(3)
})

pub const main = () -> {
	return 7
}
