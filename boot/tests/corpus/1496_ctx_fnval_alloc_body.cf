# An ALLOCATING case body through the specialization: `cb() in ta` BINDS (the specialized callee
# is `!`), the body's constructions land in the te arena and reclaim at destroy — 20 rounds
# through a 1 MiB parent stay bounded. 1 mismatch per round -> exit 20.
# expect: exit 20
import std::mem::arena::fixed_arena
import std::mem::arena::test_arena
import std::mem::ctx
import std::test::{ Verdicts, equals }

const val = (Iarch v): Iarch -> v
data Pt = { Iarch x, Iarch y }

const body_alloc! = (): () -> {
	let [102400 Uint8] junk
	const Pt expected = Pt({ x: 1, y: 2 })
	const Pt actual = Pt({ x: 1, y: 3 })
	val(actual.x) |> equals(expected.x)
	val(actual.y) |> equals(expected.y)
}

const case2! = (Str desc, () -> () cb): Uarch -> {
	let Verdicts vd = { desc: desc, count: 0, fails: 0 }
	const ta = test_arena::of(262144)
		|> std::mem::ctx::provide(let vd)
		|> defer test_arena::destroy
	cb() in ta
	return vd.fails
}

const main_body! = (): Uarch -> {
	let Uarch fails = 0
	let Iarch i = 0
	loop {
		if i >= 20 then break
		fails = fails + case2!("alloc case", body_alloc!)
		i = i + 1
	}
	return fails
}

pub const main = () -> {
	const a = fixed_arena::of(1048576)
	const Uarch f = main_body!() in a
	return Iarch(f)
}
