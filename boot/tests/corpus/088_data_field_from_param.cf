# a field value is an ordinary Iarch expression: it may read a parameter
# expect: exit 10
import std::mem::arena::fixed_arena
data Point = { Iarch x, Iarch y }
const mk! = (Iarch n): Iarch -> {
	const Point p = { x: n, y: n }
	return p.x + p.y
}

const main_body! = (): Iarch -> mk!(5)

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
