# end-to-end: build an interpolated line and write() it — the QBE-emitter payoff.
# "t${a} =w add %${b}, %${c}\n" with a=3,b=1,c=2 -> "t3 =w add %1, %2\n" (17 bytes)
# expect: exit 17
import std::mem::arena::growing_arena
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Iarch -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	svc #0x80
	ret
"
pub const write = (Uarch fd, *[Uint8] buf, Uarch n): Iarch -> syscall6(4, fd, buf, n, 0, 0, 0)

const main_body! = (): Iarch -> {
	let Iarch a = 3
	let Iarch b = 1
	let Iarch c = 2
	const Str line = "t${a} =w add %${b}, %${c}\n"
	return write(Uarch(1), line.bytes, Uarch(line.len))
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
