# Aggregate-type resolution through a deep field/index chain on a `[T]` param root:
# `outers[ui].members[i].payloads.len` — `outers[ui].members` is an IndexField whose element
# type must flow so the following `[i].payloads.len` binds correctly (cf's own emit/typecheck
# read `unions[ui].members[i].payloads.len` this way).
# expect: exit 1
data Inner = { Str name, [Str] payloads }
data Outer = { Str tag, [Inner] members }
const boxed = ([Outer] outers, Iarch ui, Iarch i): Iarch -> {
	if Iarch(outers[ui].members[i].payloads.len) > 0 then return 1
	return 0
}

const main_body! = (): Iarch -> {
	let [Str] ps = []
	ps = [...ps, "x"]
	const Inner inn = Inner({ name: "n", payloads: ps })
	let [Inner] ms = []
	ms = [...ms, inn]
	const Outer o = Outer({ tag: "t", members: ms })
	let [Outer] its = []
	its = [...its, o]
	return boxed(its, 0, 0)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
