# growth across the amortized-doubling boundary (cap 0->4->8->16)
# expect: exit 39

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let [Iarch] xs = []
	let Iarch i = 0
	loop {
		if i >= 10 then break
		xs = [...xs, i * i]
		i = i + 1
	}
	let Iarch acc = 0
	acc = acc + xs.len
	for x in xs {
		acc = acc + x
	}
	return acc
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
