# a comptime branch may brace a group of items — here an import and a `data` decl, both
# of which survive when the branch is selected
# expect: exit 42
import comptime::{ arch, Arch }

if arch.target == Arch.Arm64 then {
	import impl::{ v }
	data Tag = { Iarch t }
}
else import "nope" as { v }

pub const main = () -> {
	const Tag g = Tag({ t: v() })
	return g.t
}
