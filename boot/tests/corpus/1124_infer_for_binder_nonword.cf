# a generic call on a `for` binder over a non-`[Iarch]` array: the binder binds at the array's
# ELEMENT type, and inference instantiates the call at it — the program compiles (regression:
# the generic call must NOT be rejected). The binding's annotation states the element type
# (an annotation is enforced, so the word-era `Iarch` decoration is no longer accepted).
# expect: exit 2
import std::mem::arena::growing_arena
const id = ['T]('T x): 'T -> x

const main_body! = (): Iarch -> {
	let [Str] xs = []
	xs = [...xs, "a"]
	xs = [...xs, "b"]
	let Iarch n = 0
	for w in xs {
		const Str got = id(w)
		n = n + 1
	}
	return n
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
