# a generic call on a `for` binder over a non-`[Iarch]` array: cf binds every `for` variable
# to a word (a genesis narrowing), so inference must too — the call resolves to the word
# instance and the program compiles (regression: it must NOT be rejected)
# expect: exit 2
import std::mem::arena::growing_arena
const id = ['T]('T x): 'T -> x

const main_body! = (): Iarch -> {
	let [Str] xs = []
	xs = [...xs, "a"]
	xs = [...xs, "b"]
	let Iarch n = 0
	for w in xs {
		const Iarch got = id(w)
		n = n + 1
	}
	return n
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
