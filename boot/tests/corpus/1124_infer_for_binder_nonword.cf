# a generic call on a `for` binder over a non-`[Iarch]` array: cf0 binds every `for` variable
# to a word (a genesis narrowing), so inference must too — the call resolves to the word
# instance and the program compiles (regression: it must NOT be rejected)
# expect: exit 2
const id = ['T]('T x): 'T -> x
pub const main = (): Iarch -> {
	let [Str] xs = []
	xs = [...xs, "a"]
	xs = [...xs, "b"]
	let Iarch n = 0
	for w in xs {
		const Iarch got = id(w)
		n = n + 1
	}
	return n
}
