# whole-vector reassignment of a `[T]` dynamic-array field — `c.xs = ys` through a `*Ctx` — repoints
# the field at a different vector (like cf0's own `m.cfuncs = fs`). After the swap the field is
# [5, 6, 7]: len 3 + xs[0] 5 + xs[2] 7 = 15.
# expect: exit 15
data Ctx = { [Iarch] xs, Iarch pos }
const swap = (*Ctx c, [Iarch] ys): Iarch -> {
	c.xs = ys
	return 0
}
pub const main = () -> {
	let Ctx c = Ctx({ xs: [1], pos: 0 })
	let [Iarch] fresh = [5, 6, 7]
	const w = swap(&c, fresh)
	return Iarch(c.xs.len) + c.xs[0] + c.xs[2]
}
