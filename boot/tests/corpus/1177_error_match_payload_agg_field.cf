# an aggregate bound from a `match` PAYLOAD (`M.Some(x) -> x`) then field-accessed — emit cannot
# recover the payload's record type from the outer env, so it is a clean error (not a segfault)
# expect: error
data Bag = { Iarch v }
union M = { Some(Bag), None }
pub const main = () -> {
	let Bag d0 = Bag({ v: 3 })
	let M m = M.Some(Bag({ v: 8 }))
	let Bag r = match m { M.Some(x) -> x, M.None -> d0 }
	return r.v
}
