# a STATEMENT-position integer-literal match: single literals, an or-pattern
# `1 | 2 | 3`, and a mandatory `_`, dispatched for effect
# expect: exit 15
const classify = (Iarch n): Iarch -> {
	let Iarch a = 0
	match n {
		0 -> { a = 5 },
		1 | 2 | 3 -> { a = 10 },
		_ -> { a = 99 },
	}
	return a
}
pub const main = () -> classify(0) + classify(2)
