# The same dangle through a CLOSURE CAPTURE: `put` captures `b` by reference (a hidden
# `$capagg` parameter after the lift — no `&` visible at the rewritten call site, so the old
# `&`-only gate missed it) and rehomes a fresh record into it each iteration. The loop must
# not reset, or the record it rehomed is freed and the post-loop allocation clobbers it.
# expect: exit 59
import std::mem::arena::growing_arena
data P = { Iarch v }
data Big = { P inner }
const mkp = (Iarch x): P -> P({ v: x })
const main_body! = (): Iarch -> {
	let Big b = Big({ inner: P({ v: 1 }) })
	const put = (Iarch k) -> {
		b.inner = mkp(k + 50)
		return 0
	}
	let Iarch i = 0
	loop {
		if i >= 3 then break
		put(i)
		i = i + 1
	}
	const P q = P({ v: 7 })
	return b.inner.v + q.v
}
pub const main = () -> {
	const a = growing_arena::of(65536)
	return main_body!() in a
}
