# region-outlives permits the normal escape: returning a local aggregate BY VALUE re-homes it upward
# (it holds no pointer into a local), so it is allowed.
# expect: exit 7
data Point = { Iarch x, Iarch y }
const mk = (): Point -> {
	let Point local = { x: 3, y: 4 }
	return local
}
pub const main = () -> { let Point p = mk() return p.x + p.y }
