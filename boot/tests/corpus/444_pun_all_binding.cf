# an all-pun literal in an annotated binding
# expect: exit 30
# check: root
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Iarch x = 10
	const Iarch y = 20
	const Point p = { x, y }
	return p.x + p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
