# Uarch record fields, read + arithmetic through a `*Region` pointer (4096+100=4196, low byte 100)
# expect: exit 100
data Region = { Uarch base, Uarch size }
const endof = (*Region r): Uarch -> r.base + r.size
pub const main = () -> {
	const reg = Region({ base: Uarch(4096), size: Uarch(100) })
	return Iarch(endof(&reg))
}
