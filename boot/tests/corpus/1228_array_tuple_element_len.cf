# an array tuple element answers `.len` directly (`t[0].len`, the header length at +8). 4 + 8 = 12.
# expect: exit 12

# check: root
const main_body! = (): Iarch -> {
	const t = ([1, 2, 3, 4], 8)
	return Iarch(t[0].len) + t[1]
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
