# the subtyping is SUBSET, not overlap: a SUPER-union does not satisfy a bound naming a
# sub-union (`Big` has `Blue`, absent from `Small`), so `f[Big]` against bound `Small` is rejected
# expect: error
union Small = { Red, Green }
union Big = { ...Small, Blue }
pub const f = [Small 'T]('T x): Iarch -> 0
pub const main = () -> f[Big](Big.Red)
