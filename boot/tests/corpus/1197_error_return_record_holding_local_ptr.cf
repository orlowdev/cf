# region-outlives: a returned record carrying a `*T` field set to `&local` escapes the pointer —
# it dangles once the call returns (memory_model §6).
# expect: error
data Point = { Iarch x }
data Holder = { *Point p }
const mk = (): Holder -> {
	let Point local = { x: 7 }
	return Holder({ p: &local })
}
pub const main = () -> mk().p.x
