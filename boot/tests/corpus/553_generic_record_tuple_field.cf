# a concrete tuple field rides through a generic record's instantiation unchanged
# expect: exit 16
import "std/mem/arena/fixed_arena" as fixed_arena
data Box['T] = { (Iarch, Iarch) meta, 'T v }

const main_body! = (): Iarch -> {
	const Box[Iarch] b = { meta: (3, 4), v: 9 }
	return b.meta[0] + b.meta[1] + b.v
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
