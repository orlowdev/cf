# an explicit construction infers the binding's type from the constructor
# expect: exit 11
# check: root
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const p = Point({ x: 5, y: 6 })
	return p.x + p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
