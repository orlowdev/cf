# mutate a fixed-width field through a `*C` pointer (sub-word storew/loadw round-trip)
# expect: exit 42
# check: root
data C = { Uint8 n }
const bump = (*C c): Iarch -> {
	c.n = c.n + Uint8(1)
	return Iarch(c.n)
}

const main_body! = (): Iarch -> {
	let cc = C({ n: 41 })
	return bump(&cc)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
