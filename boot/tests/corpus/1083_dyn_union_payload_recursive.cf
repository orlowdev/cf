# a recursive `[Union]` payload (`Sum([E])`) and a `[Record]` payload (`Pt([P])`) — the AST
# shape cf needs; construct, match-bind, index with `.field`
# expect: exit 24
data P = { Iarch x, Iarch y }
union E = { Lit(Iarch), Sum([E]), Pt([P]) }
const eval = (E e): Iarch -> match e {
	E.Lit(v) -> v,
	E.Sum(es) -> {
		let Iarch acc = 0
		let Iarch i = 0
		loop {
			if i >= Iarch(es.len) then break
			acc = acc + eval(es[i])
			i = i + 1
		}
		<- acc
	},
	E.Pt(ps) -> {
		let Iarch acc = 0
		let Iarch i = 0
		loop {
			if i >= Iarch(ps.len) then break
			acc = acc + ps[i].x + ps[i].y
			i = i + 1
		}
		<- acc
	}
}
pub const main = () -> {
	let [E] terms = [E.Lit(5), E.Lit(9)]
	const E s = E.Sum(terms)
	let [P] pts = [P({ x: 1, y: 2 }), P({ x: 3, y: 4 })]
	const E p = E.Pt(pts)
	return eval(s) + eval(p)
}
