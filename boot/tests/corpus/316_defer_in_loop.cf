# `defer` is block/loop-scoped (v2): a `defer` in a loop body fires at each back-edge — a
# per-iteration teardown — not once at the function's end. `count!` defers `bump(&ctr)` each of 5
# iterations, so the counter reaches 5. (Under the old v1 rule a `defer` in a loop was a compile
# error; that restriction is retired.)
# expect: exit 5
import std::mem::arena::fixed_arena
data Ctr = { Iarch n }
const bump = (*Ctr c): Iarch -> {
	c.n = c.n + 1
	return 0
}
const count! = (Iarch k): Iarch -> {
	let Ctr ctr = Ctr({ n: 0 })
	let Iarch i = 0
	loop {
		if i >= k then break
		defer bump(&ctr)
		i = i + 1
	}
	return ctr.n
}
pub const main = () -> {
	const a = fixed_arena::of(4096)
	return count!(5) in a
}
