# The two-binder for (`for (x, i) in xs`, a tuple-shaped pattern): the element first, its
# zero-based index (an Iarch) second — per-iteration constants. A `continue` still advances the index;
# the form composes with one-line bodies and expression iterables. 80 + 2 + 21 + 60 - 121 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::array::{ range }

const main_body! = (): Iarch -> {
	const [Iarch] xs = [10, 20, 30]
	let Iarch s = 0

	for (x, i) in xs {
		s = s + i * x
	}

	let Iarch t = 0

	for (x, i) in xs {
		if x == 20 then continue
		t = t + i
	}

	let Iarch u = 0

	for (x, i) in range(5, 8) u = u + i + x

	let Iarch v = 0

	for x in xs v = v + x

	return s + t + u + v - 121
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body!() in ar
}
