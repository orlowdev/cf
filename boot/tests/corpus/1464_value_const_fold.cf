# A literal value const folds to its literal at every bare reference (no nullary
# auto-call), and a like-named LOCAL shadows the const from its binding onward —
# the loop reads the folded 100 (sum 4950), the tail reads the local 7.
# expect: exit 7
const lim = 100

pub const main = (): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0

	loop {
		if i >= lim then break
		acc = acc + i
		i = i + 1
	}

	const Iarch lim = 7

	return acc - 4950 + lim
}
