# a `type` alias of a record type: construct + read fields through the alias name.
# expect: exit 30
# check: root
data Point = { Iarch x, Iarch y }
type P = Point

const main_body! = (): Iarch -> {
	const P p = { x: 10, y: 20 }
	return p.x + p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
