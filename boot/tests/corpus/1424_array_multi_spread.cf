# A `...` spread may sit at ANY element position of a dynamic-array literal (ebnf: every element
# may be a spread): interleaved `[...a, 10, ...b, 20]`, after a plain lead `[5, ...a]`, and in a
# self-append `grow = [...grow, ...b, 7]` (grow stays in place, b's elements are spliced on).
# 40 + 8 + 114 - 120 = 42.
# expect: exit 42
import std::mem::arena::growing_arena

const main_body! = (): Iarch -> {
	const [Iarch] a = [1, 2]
	const [Iarch] b = [3, 4]
	const [Iarch] mixed = [...a, 10, ...b, 20]
	const [Iarch] led = [5, ...a]
	let [Iarch] grow = [100]
	grow = [...grow, ...b, 7]

	let Iarch s = 0

	for x in mixed { s = s + x }
	for x in led { s = s + x }
	for x in grow { s = s + x }

	return s - 120
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body!() in ar
}
