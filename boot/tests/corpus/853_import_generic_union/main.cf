# a generic union imported from a module: construct + match across the boundary
# expect: exit 7
import "maybe" as { Maybe }
pub const get = (Maybe[Iarch] m): Iarch -> match m {
	Maybe.Some(v) -> v,
	Maybe.None -> 0
}
pub const main = () -> {
	const Maybe[Iarch] m = Maybe[Iarch].Some(7)
	return get(m)
}
