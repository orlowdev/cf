# Smart arena (zero-cost return): a non-escaping flat-record scratch (`tmp`) inside an
# AGGREGATE-returning frame is auto-built on the stack, so it never enters the arena — only the
# returned `Box` does. Verifies the promoted scratch and the escaping return coexist correctly (the
# scratch's stack storage neither corrupts nor is corrupted by the returned aggregate).
# expect: exit 21
data Box = { Iarch lo, Iarch hi }
data Pair = { Iarch a, Iarch b }
const build! = (Iarch n): Box -> {
	const Pair tmp = { a: n, b: n * 4 }
	const Box r = { lo: tmp.a, hi: tmp.b }
	return r
}
pub const main = () -> {
	const a = mem.arena.grow(4096)
	const x = build!(7) in a
	return x.hi - x.lo
}
