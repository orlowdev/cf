# A deep-field store through a writable pointer param (`t.m.l = Leaf({...})`) REHOMES the
# constructed record into the caller's aggregate — an escape, charged to the caller (memory_model
# §5). The coloring pass used to scan a DeepFieldAssign's value as trapped residue and demand a
# spurious `!` on this rehome-only function.
# expect: exit 9
data Leaf = { Iarch v }
data Mid = { Leaf l }
data Top = { Mid m }
const put = (*Top t): Iarch -> {
	t.m.l = Leaf({ v: 9 })
	return 0
}
const main_body! = (): Iarch -> {
	let Top b = Top({ m: Mid({ l: Leaf({ v: 1 }) }) })
	const Iarch z = put(&b)
	return b.m.l.v + z
}
pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
