# Loop-scope SURVIVOR marks (geometry_lowering §2, the probe-A economics): a loop from which
# nothing escapes brackets the survivor triple too, so a callee's DROPPED returns die at each
# back edge. 5000 dropped records (plus callee scratch) through a 64 KiB fixed arena fit only
# because both sides of the iteration are reclaimed; without the survivor mark the returns
# are immortal and the arena traps.
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Iarch x, Iarch y }
const mk! = (Iarch k): P -> {
	let [Iarch] pad = [k, k, k]
	return P({ x: k, y: pad[0] })
}
const main_body! = (): Iarch -> {
	let Iarch s = 0
	let Iarch i = 0
	loop {
		if i >= 5000 then break
		const P p = mk!(i)
		s = s + p.x - i
		i = i + 1
	}
	return s + 42
}
pub const main = () -> {
	const a = fixed_arena.of(65536)
	return main_body!() in a
}
