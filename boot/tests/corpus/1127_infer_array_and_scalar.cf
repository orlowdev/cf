# two type variables, one inferred to an array and one to a scalar in the same call
# expect: exit 42
import std::mem::arena::fixed_arena
const pair = ['A, 'B]('A a, 'B b): 'A -> a

const main_body! = (): Iarch -> {
	const [Iarch] xs = [42, 1]
	const [Iarch] ys = pair(xs, 7)
	return ys[0]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
