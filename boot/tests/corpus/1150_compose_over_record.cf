# compose-over members (type_system §8.1 resolve-or-create): a bare union member whose name is a
# declared record COMPOSES OVER it — the member's payload IS a value of that record (§8.3). Here
# `Circle`/`Square` compose over the data types; `Empty` denotes nothing, so it stays a nullary tag.
# Constructed by application `Shape.Circle(Circle({…}))` and matched with a payload binding.
# expect: exit 8
# check: root
data Circle = { Iarch r }
data Square = { Iarch s }
union Shape = { Circle, Square, Empty }
const area = (Shape sh): Iarch -> match sh {
	Shape.Circle(c) -> c.r,
	Shape.Square(sq) -> sq.s,
	Shape.Empty -> 0,
}

const main_body! = (): Iarch -> area(Shape.Circle(Circle({ r: 5 }))) + area(Shape.Square(Square({ s: 3 })))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
