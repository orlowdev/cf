# byte-index a Str (`s[i]` → Uint8) and scan it in a loop (the lexer pattern)
# expect: exit 3
const count = (Str s, Iarch target): Iarch -> {
	let n = 0
	let i = 0
	loop {
		if i >= s.len then break
		n = n + (if Iarch(s[i]) == target then 1 else 0)
		i = i + 1
	}
	return n
}
pub const main = () -> count("banana", 97)
