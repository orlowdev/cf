# a STATEMENT match arm naming a nonexistent union member is rejected located — indexing
# the member table with -1 was a compiler segfault (2026-08-31)
# expect: error
union U = { A, B(Iarch) }

const pick = (U u): Iarch -> {
	match u {
		U.Nope(x) -> {
			return x
		},
		_ -> {},
	}

	return 0
}

pub const main = (): Iarch -> {
	return pick(U.A)
}
