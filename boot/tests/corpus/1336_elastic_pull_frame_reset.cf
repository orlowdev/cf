# A resettable `!` frame whose residue overflows its ELASTIC arena's chunk triggers cf_arena_pull,
# which relocates the node's {top, committed, limit} to a fresh block. The frame's exit reset must
# restore the full saved triple — a top-only restore leaves top in the old block with the new
# block's limit, and later allocations bump unboundedly across sibling arenas (this program
# segfaulted before cf_reset). guard lives in sibling arena b and must survive a's pulls.
# expect: exit 42
import "std/mem/arena/growing_arena" as growing_arena
data R = { Iarch a, Iarch b }
const fill = (): [R] -> {
	let [R] xs = []
	let Iarch i = 0
	loop {
		if i >= 8 then break
		xs = [...xs, R({ a: 42, b: 42 })]
		i = i + 1
	}
	return xs
}
const eat! = (): Iarch -> {
	let [R] junk = []
	let Iarch i = 0
	loop {
		if i >= 60 then break
		junk = [...junk, R({ a: i, b: i })]
		i = i + 1
	}
	return 7
}
const flood! = (): Iarch -> {
	let [R] f = []
	let Iarch i = 0
	loop {
		if i >= 400 then break
		f = [...f, R({ a: i, b: i })]
		i = i + 1
	}
	return f[399].a
}
const main_body! = (): Iarch -> {
	const a = growing_arena.of(64)
	const b = growing_arena.of(64)
	const [R] guard = fill() in b
	const Iarch g = eat!() in a
	const Iarch fl = flood!() in a
	if g != 7 then return 2
	if fl != 399 then return 3
	return guard[3].a
}
pub const main = () -> {
	const root = growing_arena.of(1048576)
	return main_body!() in root
}
