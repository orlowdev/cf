# A nested scratch arena is reclaimed at its grafting scope's exit — for free. helper! carves a
# 512 KiB arena `b` from its ambient node, does its work `in b`, and returns a scalar; `b`'s block
# sits ABOVE helper!'s frame mark, so helper!'s per-frame reset rewinds past it, freeing the whole
# arena. Called 20× (10 MiB total) inside a 1 MiB outer arena, it stays bounded — the nested arena
# composes with the reclamation machinery rather than needing its own teardown.
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
const eat! = (Iarch k): Iarch -> {
	let [102400 Uint8] buf
	return k
}
const helper! = (Iarch k): Iarch -> {
	const b = fixed_arena.of(524288)
	const Iarch r = eat!(k) in b
	return r
}
pub const main = () -> {
	const a = fixed_arena.of(1048576)
	let Iarch i = 0
	loop {
		if i >= 20 then break
		const Iarch r = helper!(i) in a
		i = i + 1
	}
	return 42
}
