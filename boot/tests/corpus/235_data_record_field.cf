# a record field may itself be a record (an aggregate field is an implicit pointer)
# expect: exit 10
# check: root
data Point = { Iarch x, Iarch y }
data Line = { Point a, Point b }
const mk = (Iarch x, Iarch y): Point -> {
	const Point p = { x: x, y: y }
	return p
}

const main_body! = (): Iarch -> {
	const Line l = { a: mk(1, 2), b: mk(3, 4) }
	return l.a.x + l.a.y + l.b.x + l.b.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
