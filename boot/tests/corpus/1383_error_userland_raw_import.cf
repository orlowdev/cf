# `std/mem/raw` is the privileged substrate: importing it outside the geometry modules under
# `std/mem/` is rejected at resolve — userland allocates through the geometry surface (the
# constructors and the `!` algebra), never through raw addresses.
# expect: error
import "std/mem/raw" as raw

pub const main = (): Iarch -> Iarch(raw.load(4096))
