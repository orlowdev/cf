# comptime `if`: the darwin (true) branch is taken. The else branch imports a module file that
# does NOT exist — proving the losing branch is parsed but never resolved (no file is opened).
# expect: exit 7
import std::comptime::os
import std::sys::{ Os }

if os::target == Os.Darwin then import impl_darwin::{ v } else import impl_absent::{ v }
pub const main = (): Iarch -> v
