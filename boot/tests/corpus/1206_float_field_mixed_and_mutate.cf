# a record mixing a `Float64` field and an `Iarch` field; the float field is mutated in place
# (`p.v = p.v + 40.5`) and read back alongside the word field. 41 + 5 = 46.
# expect: exit 46
import std::mem::arena::fixed_arena
data P = { Float64 v, Iarch n }

const main_body! = (): Iarch -> {
	let P p = P({ v: 1.0, n: 5 })
	p.v = p.v + 40.5
	return Iarch(p.v) + p.n
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
