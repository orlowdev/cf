# a float rides the recursive stringifier as an aggregate leaf: `(1.5, true)` (11 bytes)
# expect: exit 11

# check: root
const main_body! = (): Iarch -> {
	const t = (1.5, true)
	const Str m = "${t}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
