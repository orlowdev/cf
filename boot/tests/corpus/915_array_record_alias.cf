# a record array element may be a bare record variable (an alias) — the arena record
# rides into the element slot without an explicit copy; safe in the bump arena (M0)
# expect: exit 7
data P = { Iarch x }
const mk = (Iarch a): P -> ({ x: a })
pub const main = () -> {
	const P q = mk(5)
	const [2 P] ps = [q, mk(2)]
	return ps[0].x + ps[1].x
}
