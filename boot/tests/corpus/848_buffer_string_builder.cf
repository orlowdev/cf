# a string-builder: fill "ABCDE" in a loop (bytes need the faithful Uint8() cast), write it
# expect: exit 6
import std::mem::arena::growing_arena
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Iarch -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const write = (Uarch fd, *[Uint8] buf, Uarch n): Iarch -> syscall6(4, fd, buf, n, 0, 0, 0)

const main_body! = (): Iarch -> {
	let [16 Uint8] buf
	let i = 0
	loop {
		if i >= 5 then break
		buf[i] = Uint8(65 + i)
		i = i + 1
	}
	buf[5] = 10
	return write(Uarch(1), buf, Uarch(6))
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
