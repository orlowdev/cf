# A HOF parameter used more than once with a side-effecting argument and a capturing closure:
# specialization passes arguments ONCE (no inlining duplication), so `tick()` is evaluated once
# and the repeated `f(x)` calls the closure twice. twice(addbase, tick()) = 101 + 101 = 202 → 202
# mod 256 = 202... kept under 256: base 20 → 21 + 21 = 42. (Formerly a v1 inlining rejection.)
# expect: exit 42
const twice = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x) + f(x)
const tick = (): Iarch -> 1

const run = (): Iarch -> {
	let Iarch base = 20
	const addbase = (Iarch k): Iarch -> base + k

	return twice(addbase, tick())
}

pub const main = () -> run()
