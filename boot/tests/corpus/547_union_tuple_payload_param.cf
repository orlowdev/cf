# a union with a heterogeneous tuple payload, passed and matched
# expect: exit 9
import "std/mem/arena/growing_arena" as growing_arena
union B = { Pair((Iarch, Str)), None }
const get = (B b): Iarch -> match b {
	B.Pair(p) -> p[0] + p[1].len,
	B.None -> 0,
}

const main_body! = (): Iarch -> get(B.Pair((6, "abc")))

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
