# An aggregate array element value must match the element type — a `[P]` slot cannot take a Str.
# expect: error
data P = { Iarch v }
const main_body! = (): Iarch -> {
	let [P] ps = [P({ v: 1 })]
	ps[0] = "nope"
	return 0
}
pub const main = () -> {
	const a = mem.arena.grow(8192)
	return main_body!() in a
}
