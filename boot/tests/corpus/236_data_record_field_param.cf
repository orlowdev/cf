# nested field access reaches through a record parameter's aggregate fields
# expect: exit 10
import std::mem::arena::fixed_arena
data Point = { Iarch x, Iarch y }
data Line = { Point a, Point b }
const mk = (Iarch x, Iarch y): Point -> {
	const Point p = { x: x, y: y }
	return p
}
const total = (Line l): Iarch -> l.a.x + l.a.y + l.b.x + l.b.y

const main_body! = (): Iarch -> {
	const Line l = { a: mk(1, 2), b: mk(3, 4) }
	return total(l)
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
