# a value-yielding `loop` may now yield a RECORD (an 8-byte arena pointer through the merge slot);
# binding it then field-accessing the result dispatches
# expect: exit 7
import "std/mem/arena/growing_arena" as growing_arena
data Bag = { Iarch v }

const main_body! = (): Iarch -> {
	let Bag r = loop {
		<- Bag({ v: 7 })
	}
	return r.v
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
