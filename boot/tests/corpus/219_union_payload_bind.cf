# a match arm binds its payload positionally; `_` ignores a field
# expect: exit 21
union Node = { IntLit(Iarch), BinOp(Iarch, Iarch, Iarch), Nil }
pub const eval = (Node n): Iarch -> match n {
	Node.IntLit(v) -> v,
	Node.BinOp(a, b, c) -> a + b * c,
	Node.Nil -> 0,
}

const main_body! = (): Iarch -> {
	const Node x = Node.IntLit(7)
	const Node y = Node.BinOp(2, 3, 4)
	const Node z = Node.Nil
	return eval(x) + eval(y) + eval(z)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
