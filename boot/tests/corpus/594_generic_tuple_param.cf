# a generic function may take a tuple parameter with a `'T` element
# expect: exit 30
import std::mem::arena::fixed_arena
const fst = ['T](('T, Iarch) p): Iarch -> p[1]

const main_body! = (): Iarch -> fst[Iarch]((10, 30)) + fst[Unit](((), 0))

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
