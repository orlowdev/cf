# value-level array spread in BINDING position: `const [T] two = [...one, e]` copies `one` and
# appends. one stays length 1; two is length 2 holding 7 and 35. 1 + 2 + 7 + 35 = 45.
# expect: exit 45
pub const main = () -> {
	const [Iarch] one = [7]
	const [Iarch] two = [...one, 35]
	return Iarch(one.len) + Iarch(two.len) + two[0] + two[1]
}
