# A demand-carrying function may become a value ONLY as a call argument into a fn-typed
# parameter (context.md §4). Binding it (`const h = checker`) is a value position that survives
# to runtime dispatch — rejected at the demand check.
# expect: error
import std::mem::arena::test_arena
import std::mem::ctx
import std::test::{ Verdicts, equals }

const val = (Iarch x): Iarch -> x

const checker = (): () -> {
	val(1) |> equals(1)
}

const runner! = (() -> () cb): Uarch -> {
	let Verdicts vd = { desc: "r", count: 0, fails: 0 }
	const ta = test_arena::of(65536) |> std::mem::ctx::provide(let vd)
	cb()
	test_arena::destroy(ta)
	return vd.fails
}

import std::mem::arena::fixed_arena

const main_body! = (): Uarch -> {
	const h = checker
	return runner!(h)
}

pub const main = () -> {
	const a = fixed_arena::of(1048576)
	const Uarch f = main_body!() in a
	return Iarch(f)
}
