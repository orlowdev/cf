# a `return` buried in a VALUE loop fires the pending defers like any other return — the
# lowering used to skip expression-nested loop bodies entirely, silently dropping the teardown.
# The defer's effect is asserted through a pointer (not stdout): the counter must be bumped
# exactly once per call, on both the loop-return and the fall-through paths.
# expect: exit 0
data Counter = { Int n }

data Point = { Int x, Int y }

const bump = (*Counter c): Int -> {
	c.n = c.n + 1

	return 0
}

const mk_loop = (*Counter c, Int n): Point -> {
	defer bump(c)

	const k = loop {
		if n > 0 then return Point({ x: 77, y: 88 })
		<- 1
	}

	return Point({ x: k, y: 0 })
}

pub const main = (): Int -> {
	let Counter tally = Counter({ n: 0 })
	const v = mk_loop(&tally, 1)
	if v.x != 77 then return 1
	if tally.n != 1 then return 2
	const w = mk_loop(&tally, 0)
	if w.x != 1 then return 3
	if tally.n != 2 then return 4

	return 0
}
