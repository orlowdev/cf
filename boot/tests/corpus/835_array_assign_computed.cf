# a computed index and value, read back after the write
# expect: exit 99

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	let [4 Iarch] xs = [0, 0, 0, 0]
	let k = 1 + 2
	xs[k] = 99
	return xs[3]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
