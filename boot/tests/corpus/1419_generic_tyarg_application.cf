# A generic APPLICATION may sit in a call-site type argument (`map[Iarch, Maybe[Iarch]]`), in a
# fn-type component's return position (`('A) -> Maybe['B] f`), and a `|>` target may carry explicit
# type arguments (including a bare `f[T]` whose one slot the piped value fills). 21*2=42 → half →
# 21 → half → Just(10) → flatten → 10*4+2 = 42.
# expect: exit 42
union Maybe['V] = { Just('V), Nothing }

const map = ['A, 'B](('A) -> 'B f, Maybe['A] m): Maybe['B] -> match m {
	Maybe.Just(v) -> Maybe['B].Just(f(v)),
	Maybe.Nothing -> Maybe['B].Nothing,
}

const chain = ['A, 'B](('A) -> Maybe['B] f, Maybe['A] m): Maybe['B] -> match m {
	Maybe.Just(v) -> f(v),
	Maybe.Nothing -> Maybe['B].Nothing,
}

const flatten = ['A](Maybe[Maybe['A]] mm): Maybe['A] -> match mm {
	Maybe.Just(inner) -> inner,
	Maybe.Nothing -> Maybe['A].Nothing,
}

const double = (Iarch n): Iarch -> n * 2
const half = (Iarch n): Maybe[Iarch] -> if n == 0 then Maybe[Iarch].Nothing else Maybe[Iarch].Just(n / 2)

pub const main = () -> {
	const Maybe[Iarch] m = Maybe[Iarch].Just(21)
	const out = m
		|> map[Iarch, Iarch](double)
		|> chain[Iarch, Iarch](half)
		|> map[Iarch, Maybe[Iarch]](half)
		|> flatten[Iarch]

	return match out {
		Maybe.Just(v) -> v * 4 + 2,
		Maybe.Nothing -> 0,
	}
}
