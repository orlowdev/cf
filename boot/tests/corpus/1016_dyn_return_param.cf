# a `[T]` dynamic array crosses function boundaries: build() returns one, sum_sq consumes
# it as a param. Element sum 0*0 + 1*1 + 2*2 = 5.
# expect: exit 5
data Token = { Iarch kind, Iarch ival }

const build = (): [Token] -> {
	let [Token] ts = []
	let Iarch i = 0
	loop {
		if i >= 3 then break
		ts = [...ts, Token({kind: i, ival: i * i})]
		i = i + 1
	}
	return ts
}

const sum_sq = ([Token] ts): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(ts.len) then break
		acc = acc + ts[i].ival
		i = i + 1
	}
	return acc
}

pub const main = () -> sum_sq(build())
