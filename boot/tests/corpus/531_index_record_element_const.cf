# a record tuple element can be bound to a `const` local by direct index too
# expect: exit 20
# check: root
data P = { Iarch x }
const mk = (Iarch a): P -> P({ x: a })

const main_body! = (): Iarch -> {
	const t = (0, mk(20))
	const p = t[1]
	return p.x
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
