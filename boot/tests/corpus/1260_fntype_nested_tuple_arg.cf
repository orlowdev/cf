# A tuple component of a function type nests to any depth: `(((Iarch, Iarch), Iarch)) -> Iarch`.
# The fn value indexes the outer then the inner tuple. apply(f, ((1, 2), 3)) = 1 + 2 + 3 = 6.
# expect: exit 6
const f = (((Iarch, Iarch), Iarch) t): Iarch -> t[0][0] + t[0][1] + t[1]
const apply = ((((Iarch, Iarch), Iarch)) -> Iarch g, ((Iarch, Iarch), Iarch) q): Iarch -> g(q)
pub const main = () -> apply(f, ((1, 2), 3))
