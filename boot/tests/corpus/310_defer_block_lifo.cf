# `defer { ... }` blocks run at scope exit in LIFO order (last deferred, first run).
# The mutations land on the returned arena record, so main observes them: the
# second defer runs first (0*10+2 = 2), then the first (2*10+1 = 21).
# expect: exit 21
data Cell = { Iarch v }
const run = (): Cell -> {
	let Cell c = { v: 0 }
	defer { c.v = c.v * 10 + 1 }
	defer { c.v = c.v * 10 + 2 }
	return c
}
pub const main = () -> run().v
