# A general spread `[...src, e]` into a FRESH binding (not a self-append `xs = [...xs, e]`)
# copies the source's elements then appends — cf's own `check_for_body` extends a borrowed
# env via `[...env, VarTy(...)]`. Build a base, spread it into a new list with an extra elem.
# expect: exit 10

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let [Iarch] xs = [1, 2, 3]
	const [Iarch] ys = [...xs, 4]
	let Iarch acc = 0
	for y in ys {
		acc = acc + y
	}
	return acc
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
