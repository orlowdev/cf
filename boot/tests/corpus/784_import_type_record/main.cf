# a pub record type imported across a module boundary: constructed and field-accessed
# in main, and returned by an imported value that builds it from its own private helper
# expect: exit 44
import "std/mem/arena/fixed_arena" as fixed_arena
import "shapes" as { Point, origin }

const main_body! = (): Iarch -> {
	const Point p = Point({ x: 40, y: 2 })
	const Point o = origin()
	return p.x + p.y + o.x
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
