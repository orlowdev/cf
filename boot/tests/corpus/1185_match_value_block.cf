# An expression `match` whose arms are value BLOCKS `{ ... <- v }` instead of bare expressions.
# expect: exit 42
union Color = { Red, Blue }
pub const main = () -> {
	let Color c = Color.Red
	let Iarch x = match c {
		Color.Red -> {
			let Iarch t = 21
			<- t + t
		},
		Color.Blue -> { <- 1 }
	}
	return x
}
