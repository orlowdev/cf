# the spread is a genuine copy — mutating the copy leaves the source untouched
# expect: exit 101
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point a = { x: 1, y: 2 }
	let Point b = { ...a }
	b.x = 100
	return a.x + b.x
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
