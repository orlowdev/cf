# A `*Point` may be returned as a bare parameter (a pointer is explicitly an alias) and
# forwarded through another function. `mk` mints the pointer with `&`.
# expect: exit 9
data Point = { Iarch x, Iarch y }
const forward = (*Point p): *Point -> p
const sum = (*Point p): Iarch -> p.x + p.y
const mk = (Iarch a, Iarch b): *Point -> &Point({ x: a, y: b })
pub const main = () -> sum(forward(mk(8, 1)))
