# a `!` self-tail-call lowers to a frame-reusing loop too (TCO v2): register-only params
# rewind the residue bracket (and survivor mark) per iteration — 500k allocating iterations
# would overflow the stack as calls and bloat the arena without the rewind — while an
# AGGREGATE param (the carried Str) skips the rewind so the value survives into the next
# iteration instead of being reclaimed under the loop's feet.
# expect: exit 0
import std::data::str::{ eq }
import std::mem::arena::growing_arena

const churn! = (Int n, Int acc): Int -> {
	if n == 0 then return acc
	const Str scratch = "iteration ${n} scratch"
	const w = Iarch(scratch.len)

	return churn!(n - 1, acc + w)
}

const carry! = (Int n, Str s): Str -> {
	if n == 0 then return s
	const Str t = "carry ${n}"

	return carry!(n - 1, t)
}

pub const main = (): Int -> {
	const a = growing_arena::of(4096)
	const total = churn!(500000, 0) in a
	const b = growing_arena::of(4096)
	const Str last = carry!(50000, "seed") in b
	if !eq(last, "carry 1") then return 1
	if total < 10000000 then return 2

	return 0
}
