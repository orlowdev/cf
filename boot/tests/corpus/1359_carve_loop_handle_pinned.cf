# The carve interlock's iteration gate: a fixed carve ASSIGNED inside a marked loop to an
# OUTER handle must stay SURVIVOR — the back-edge frees a residue carve, and iteration 1
# would then allocate its scratch (xs) over b's freed block, and clob!'s writes through b
# clobber it (this shape segfaulted before the interlock). Sound: xs[0] survives -> 42.
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
const clob! = (Iarch v): Iarch -> {
	let [Iarch] ys = []
	let Iarch i = 0
	loop {
		if i >= 32 then break
		ys = [...ys, v]
		i = i + 1
	}
	return 0
}
const run! = (): Iarch -> {
	let Iarch b = 0
	let Iarch i = 0
	let Iarch got = 0
	loop {
		if i >= 2 then break
		if i == 0 then b = fixed_arena.of(512)
		if i == 1 then {
			let [Iarch] xs = []
			xs = [...xs, 41]
			const Iarch z = clob!(7) in b
			got = xs[0] + 1 + z
		}
		i = i + 1
	}
	return got
}
pub const main = () -> {
	const a = fixed_arena.of(1048576)
	return run!() in a
}
