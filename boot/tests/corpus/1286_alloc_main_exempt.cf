# `main` is the one exemption from the marker (memory_model §5) — the runtime runs it under the
# root, so a `main` that allocates neither needs nor carries a `!`.
# check: alloc
# expect: exit 3
data Point = { Iarch x, Iarch y }
pub const main = () -> {
	const Point p = { x: 3, y: 4 }
	return p.x
}
