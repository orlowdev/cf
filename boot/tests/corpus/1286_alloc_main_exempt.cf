# `main` is exempt from the `!` marker (memory_model §5) AND may allocate on the ROOT page directly:
# root does not propagate into `!` functions, but `main` itself is the root frame, so a record built
# inline in `main` needs neither a `!` nor a grafted geometry.
# expect: exit 3
data Point = { Iarch x, Iarch y }
pub const main = () -> {
	const Point p = { x: 3, y: 4 }
	return p.x
}
