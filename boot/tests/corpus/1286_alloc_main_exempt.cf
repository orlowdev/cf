# `main` is exempt from the `!` MARKER (memory_model §5) — it needs no trailing `!` even when it
# allocates — but it is NOT exempt from the ROOT rule (§2): residue may never land on the root page.
# The two are independent, so a `main` that allocates inline is now rejected outright — it must graft
# a geometry and run its allocating work `in <arena>` (see 1280 for the accepted shape).
# expect: error
data Point = { Iarch x, Iarch y }
pub const main = () -> {
	const Point p = { x: 3, y: 4 }
	return p.x
}
