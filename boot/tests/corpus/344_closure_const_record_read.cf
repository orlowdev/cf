# A `const` record may be captured and READ (not mutated) by a closure.
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
const run! = (): Iarch -> {
	const Point p = { x: 3, y: 4 }
	const sum = () -> p.x + p.y
	return sum()
}

const main_body! = (): Iarch -> run!()

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
