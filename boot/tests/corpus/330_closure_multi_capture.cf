# A closure captures two variables — mutating one (i), reading the other (j).
# combine(5): i becomes 15, returns i + j = 115.
# expect: exit 115
const run = (): Iarch -> {
	let Iarch i = 10
	let Iarch j = 100
	const combine = (Iarch k) -> {
		i = i + k
		return i + j
	}
	return combine(5)
}
pub const main = () -> run()
