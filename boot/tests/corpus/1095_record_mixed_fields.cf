# a record with MIXED-WIDTH fields — Bool + Iarch (words) and Str + [Iarch] (8-byte
# pointers) — constructed and read back, each field bound to a local of its own type.
# expect: exit 11
data Seg = { Bool is_hole, Str name, [Iarch] xs, Iarch b }

const main_body! = (): Iarch -> {
	let [Iarch] arr = [10, 20, 30]
	const Seg s = Seg({ is_hole: true, name: "hi", xs: arr, b: 5 })
	const Str nm = s.name
	const [Iarch] ys = s.xs
	let Iarch acc = s.b
	acc = acc + Iarch(nm.len)
	acc = acc + Iarch(ys.len)
	if s.is_hole then acc = acc + 1
	return acc
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
