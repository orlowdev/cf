# a `const` pattern may bind a record position (an immutable alias of the tuple slot)
# expect: exit 25
data P = { Iarch x, Iarch y }
const mk = (Iarch a, Iarch b): P -> P({ x: a, y: b })

const main_body! = (): Iarch -> {
	const (n, p) = (5, mk(8, 12))
	return n + p.x + p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
