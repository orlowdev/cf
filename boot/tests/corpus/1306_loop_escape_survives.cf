# Soundness of per-loop-iteration reset: a loop that GROWS an outer aggregate must NOT reset — the
# value grown across iterations escapes the iteration. Here the first loop does `xs = [...xs, i]`
# into an outer `xs`, so the escape check disqualifies it (the array must survive); the second loop
# only reads and updates a scalar sum, so it may reset harmlessly. The sum proves xs survived intact.
# expect: exit 45
import std::mem::arena::fixed_arena
const build! = (Iarch n): Iarch -> {
	let [Iarch] xs = []
	let Iarch i = 0
	loop {
		if i >= n then break
		xs = [...xs, i]
		i = i + 1
	}
	let Iarch sum = 0
	let Iarch j = 0
	loop {
		if j >= Iarch(xs.len) then break
		sum = sum + xs[j]
		j = j + 1
	}
	return sum
}
pub const main = () -> {
	const a = fixed_arena::of(1048576)
	const Iarch r = build!(10) in a
	return r
}
