# several fields of one record, each mutated
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
data V = { Iarch a, Iarch b, Iarch c }

const main_body! = (): Iarch -> {
	let V v = { a: 0, b: 0, c: 0 }
	v.a = 40
	v.b = 2
	v.c = v.a + v.b
	return v.a + v.b - v.c + 42
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
