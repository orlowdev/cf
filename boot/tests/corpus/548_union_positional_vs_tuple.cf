# a positional two-Iarch payload `Two(Iarch, Iarch)` stays distinct from a one-tuple payload
# expect: exit 7
import std::mem::arena::fixed_arena
union B = { Two(Iarch, Iarch) }
const get = (B b): Iarch -> match b {
	B.Two(a, c) -> a + c,
}

const main_body! = (): Iarch -> get(B.Two(3, 4))

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
