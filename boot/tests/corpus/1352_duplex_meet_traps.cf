# A two-ended fixed arena's cursors MEET at cf_oom: one frame's residue larger than of(n)'s
# remaining capacity trips the down-bump boundary check — of(n) still means n bytes TOTAL.
# expect: exit 70
import "std/mem/arena/fixed_arena" as fixed_arena
const eat! = (Iarch k): Iarch -> {
	let [307200 Uint8] junk
	return k
}
pub const main = () -> {
	const a = fixed_arena.of(262144)
	return eat!(7) in a
}
