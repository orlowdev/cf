# A `defer`-tap value must be the WHOLE bound/returned value (or a pipe target), not embedded in a
# larger expression — the hoist pass lifts only the top expression and call arguments (v1).
# expect: error
const tap = (Iarch x): Iarch -> x
pub const main = () -> {
	const Iarch v = defer tap(7) + 1
	return v
}
