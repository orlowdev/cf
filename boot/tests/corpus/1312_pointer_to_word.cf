# A pointer may widen to a register word: `Uarch(p)` / `Iarch(p)` views an address as a number
# (type_system §6.4 — the memory model only bars the dangerous direction, number→pointer, which has
# no cast at all). Here a `*[Uint8]` param's address is read as a `Uarch`; a valid buffer's data
# pointer is nonzero, so the guard returns 9. Pointer arithmetic stays unavailable (a later intrinsic).
# expect: exit 9
import std::mem::arena::growing_arena
const addr = (*[Uint8] p): Iarch -> {
	if Uarch(p) != 0 then return 9
	return 0
}
const use! = (): Iarch -> {
	let [8 Uint8] buf
	return addr(buf)
}
pub const main = () -> {
	const a = growing_arena::of(4096)
	return use!() in a
}
