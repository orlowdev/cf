# a union member may carry a `Unit` payload; construct and match it
# expect: exit 7
# check: root
union U = { Wrap(Unit), Empty }

const main_body! = (): Iarch -> {
	const U u = U.Wrap(())
	return match u {
		U.Wrap(x) -> 7,
		U.Empty -> 0,
	}
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
