# a union member may carry a `Unit` payload; construct and match it
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
union U = { Wrap(Unit), Empty }

const main_body! = (): Iarch -> {
	const U u = U.Wrap(())
	return match u {
		U.Wrap(x) -> 7,
		U.Empty -> 0,
	}
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
