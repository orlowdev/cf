# std::io::fs::read_dir! lists a directory as Either[IoRrr, [DirEntry]] (the natural signature, now
# that a dynamic array can be a generic type argument). Every directory contains exactly one `.` and
# one `..`; list the root, count them by matching the entry name, and confirm both appear once →
# exit 42.
# expect: exit 42
import std::data::{ Either }
import std::io::fs::{ read_dir! }
import std::io::fd::{ IoRrr, DirEntry }
import std::mem::arena::growing_arena

const tally = ([DirEntry] es): Iarch -> {
	let Iarch dots = 0
	let Iarch dotdots = 0

	for e in es {
		match e.name {
			"." -> dots = dots + 1,
			".." -> dotdots = dotdots + 1,
			_ -> dots = dots,
		}
	}

	if dots == 1 && dotdots == 1 then return 42

	return 0
}

const run! = (): Iarch -> {
	const Either[IoRrr, [DirEntry]] r = read_dir!("/")

	return match r {
		Either.Left(e) -> 0 - 1,
		Either.Right(es) -> tally(es),
	}
}

pub const main = () -> {
	const a = growing_arena::of(4194304)

	return run!() in a
}
