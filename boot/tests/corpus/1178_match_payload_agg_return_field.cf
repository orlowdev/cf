# a function returns a `match`-payload aggregate; the caller field-accesses the result, on both the
# payload arm and the default arm
# expect: exit 43
import std::mem::arena::fixed_arena
data Bag = { Iarch v }
union M = { Some(Bag), None }
const pick = (M m, Bag d): Bag -> match m { M.Some(x) -> x, M.None -> d }

const main_body! = (): Iarch -> {
	let Bag d0 = Bag({ v: 3 })
	return pick(M.None, d0).v + pick(M.Some(Bag({ v: 40 })), d0).v
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
