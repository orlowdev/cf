# nested value loops: the inner loop's yielded value feeds the outer yield
# inner yields 3; when i reaches 2 the outer yields inner + i = 5
# expect: exit 5
pub const main = () -> {
	let i = 0
	let r = loop {
		let j = 0
		let inner = loop {
			if j >= 3 then <- j
			j = j + 1
		}
		if i >= 2 then <- inner + i
		i = i + 1
	}
	return r
}
