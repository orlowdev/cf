# the `'T` tuple element may be instantiated at a record, then indexed and field-accessed
# expect: exit 25
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
data Box['T] = { (Iarch, 'T) p }

const main_body! = (): Iarch -> {
	const Box[Point] b = { p: (5, Point({ x: 8, y: 12 })) }
	return b.p[0] + b.p[1].x + b.p[1].y
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
