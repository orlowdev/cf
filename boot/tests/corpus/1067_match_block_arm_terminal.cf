# a block match arm may end in a terminator (`return`/`break`/`continue`) — the match must
# not append a store after the arm's own QBE terminator; a mix of terminal and fall-through
# arms in one statement-position match
# expect: exit 101
import "std/mem/arena/growing_arena" as growing_arena
union K = { A, B, C }

const main_body! = (): Iarch -> {
	let Iarch acc = 0
	let [K] ks = [K.A, K.C, K.B]
	let Iarch i = 0
	loop {
		if i >= Iarch(ks.len) then break
		const K k = ks[i]
		match k {
			K.A -> { acc = acc + 1 },
			K.B -> {
				i = i + 1
				continue
			},
			K.C -> { acc = acc + 100 },
		}
		i = i + 1
	}
	return acc
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
