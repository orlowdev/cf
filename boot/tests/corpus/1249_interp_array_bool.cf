# array elements ride the same stringifier: `[true, false]` (13 bytes)
# expect: exit 13

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let [Bool] xs = [true, false]
	const Str m = "${xs}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
