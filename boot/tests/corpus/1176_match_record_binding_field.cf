# a record bound from a `match` (each arm yields an outer record variable), then field-accessed
# expect: exit 5
data Bag = { Iarch v }
pub const main = () -> {
	let Bag p = Bag({ v: 5 })
	let Bag q = Bag({ v: 9 })
	let Bool b = true
	let Bag r = match b { Bool.True -> p, Bool.False -> q }
	return r.v
}
