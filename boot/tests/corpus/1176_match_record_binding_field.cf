# a record bound from a `match` (each arm yields an outer record variable), then field-accessed
# expect: exit 5
import std::mem::arena::fixed_arena
data Bag = { Iarch v }

const main_body! = (): Iarch -> {
	let Bag p = Bag({ v: 5 })
	let Bag q = Bag({ v: 9 })
	let Bool b = true
	let Bag r = match b { Bool.True -> p, Bool.False -> q }
	return r.v
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
