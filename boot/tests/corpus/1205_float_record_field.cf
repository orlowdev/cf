# a `Float64` record field: constructed, read back, and used in float arithmetic (the field
# stores/loads with `stored`/`loadd`, not the uniform word `storel`/`loadl`).
# expect: exit 4
data P = { Float64 x, Float64 y }
pub const main = () -> {
	let P p = P({ x: 1.5, y: 2.75 })
	return Iarch(p.x + p.y)
}
