# a STATEMENT-position integer sub-pattern guard on a payload field: a miss falls
# through to a later arm for the same tag (which fully covers it, so no `_` needed)
# expect: exit 111
union M = { A(Iarch), B }
const f = (M m): Iarch -> {
	let Iarch a = 0
	match m {
		M.A(0) -> { a = 99 },
		M.A(n) -> { a = n },
		M.B -> { a = 7 },
	}
	return a
}

const main_body! = (): Iarch -> f(M.A(0)) + f(M.A(5)) + f(M.B)

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
