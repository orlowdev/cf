# The page geometry's bare-call subtree + return claim. main builds `seed` on its own ambient
# (an inline record → the page is ACTIVE, main is tagged `pg`), then calls `build` — bare-
# reachable and returning a record that ESCAPES, so a root-ambient allocator copied as
# `build__pg`, its Box built in a `reserve_ret__pg` reservation on the root's kind-0 survivor
# lane. main claims the returned value through `on_alloc_ret__pg$Box` (the identity — the value
# was born survivor-side, which outlives the call). Nothing is `!`: a page-ambient (colorless)
# frame never holds residue, so the survivor lane only bumps up and no escape is overwritten.
# expect: exit 42
data Box = { Iarch lo, Iarch hi }
const build = (Iarch n): Box -> {
	return Box({ lo: n, hi: n * 5 })
}
pub const main = () -> {
	const Box seed = Box({ lo: 2, hi: 2 })
	const Box b = build(seed.hi * 5)
	return b.hi - b.lo + seed.lo
}
