# a `*[T]` record FIELD stores a non-variable array expression (another record's array field);
# the stored data pointer indexes correctly
# expect: exit 47
import std::mem::arena::fixed_arena
data Bag = { [Iarch] items }
data Ref = { *[Iarch] p }

const main_body! = (): Iarch -> {
	const Bag b = Bag({ items: [7, 8, 9, 40] })
	const Ref r = Ref({ p: b.items })
	return r.p[0] + r.p[3]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
