# comptime `if` nested os-AND-arch: darwin then arm64 selects the darwin/arm64 backing module.
# The other branches import module files that do NOT exist — proving they are never resolved.
# expect: exit 9
if comptime.os.target == Os.Darwin then if comptime.arch.target == Arch.Arm64 then import "impl_darm" as { v } else import "impl_absent_a" as { v } else import "impl_absent_b" as { v }
pub const main = (): Iarch -> v
