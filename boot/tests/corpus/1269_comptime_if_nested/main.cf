# comptime `if` nested os-AND-arch: darwin then arm64 selects the darwin/arm64 backing module.
# The other branches import module files that do NOT exist — proving they are never resolved.
# expect: exit 9
import std::comptime::os
import std::comptime::arch
import std::sys::{ Os, Arch }

if os::target == Os.Darwin then if arch::target == Arch.Arm64 then import impl_darm::{ V } else import impl_absent_a::{ V } else import impl_absent_b::{ V }
pub const main = (): Iarch -> V
