# a function taking both a record and an Iarch parameter
# expect: exit 42
# check: root
data Box = { Iarch w, Iarch h }
const scale = (Box b, Iarch k): Iarch -> (b.w + b.h) * k

const main_body! = (): Iarch -> {
	let Box b = { w: 3, h: 4 }
	return scale(b, 6)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
