# the generic union's tuple payload element may be `Unit`
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
union U['T] = { Pair((Iarch, 'T)), Empty }
const first = (U[Unit] u): Iarch -> match u {
	U.Pair(p) -> p[0],
	U.Empty -> 0,
}

const main_body! = (): Iarch -> first(U[Unit].Pair((7, ())))

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
