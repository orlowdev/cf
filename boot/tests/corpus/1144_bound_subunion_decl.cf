# §8.2 union→superunion subtyping on a generic DATA declaration bound: `data Tagged[Big 'T]`
# accepts `Tagged[Small]` because `Small`'s members are a subset of `Big`'s (spread).
# expect: exit 9
union Small = { Red, Green }
union Big = { ...Small, Blue }
data Tagged[Big 'T] = { 'T c, Iarch n }

const main_body! = (): Iarch -> {
	const Tagged[Small] t = { c: Small.Red, n: 9 }
	return t.n
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
