# a parameter type may nest tuples
# expect: exit 10
import "std/mem/arena/fixed_arena" as fixed_arena
const f = (((Iarch, Iarch), Iarch) t): Iarch -> t[0][0] + t[0][1] + t[1]

const main_body! = (): Iarch -> f(((3, 4), 3))

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
