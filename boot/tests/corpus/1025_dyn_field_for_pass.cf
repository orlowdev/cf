# a by-value record with a `[T]` field: read the field, `for` over it, and pass the field
# vector on to a `[T]` param. 1 + 2 + 3 = 6.
# expect: exit 6
import std::mem::arena::growing_arena
data Ctx = { [Iarch] xs, Iarch pos }
const sumit = ([Iarch] ys): Iarch -> {
	let Iarch a = 0
	for y in ys {
		a = a + y
	}
	return a
}

const main_body! = (): Iarch -> {
	let [Iarch] v = [1, 2, 3]
	const Ctx c = Ctx({xs: v, pos: 0})
	return sumit(c.xs)
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
