# Stage 4, aggregate coverage — the DYNAMIC half on the RESIDUE side: frame-local interpolated
# strings and `[T]` vectors built in a loop under `fixed_buffer` grow through the residue reserve
# pointer (`reserve_alloc__fb`, threaded into `cf_dyn_push_g` / `cf_*_append_g`) and are reclaimed
# in bulk by the loop's `on_scope_enter`/`on_scope_exit` bracket each iteration. 200 iterations —
# each building a fresh string (whose backing reallocates as it grows) and a two-element vector —
# fit in a 4 KiB pool ONLY because the exit hook rewinds the residue cursor every pass; a grow that
# reserved on the wrong side, or a leak, would overflow the two-ended block and trap.
# expect: exit 48
import std::mem::fixed_buffer

const churn! = (Iarch n): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const s = "i=${i} sq=${i * i}"
		let [Iarch] v = []
		v = [...v, i]
		v = [...v, i + 1]
		acc = acc + Iarch(s.len) + v[0] + v[1]
		i = i + 1
	}
	return acc
}

static [4096 Uint8] pool
pub const main = () -> {
	const fb = fixed_buffer::of(pool)
	return churn!(200) in fb
}
