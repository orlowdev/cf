# `import "lib" as lib` binds a namespace: `lib.add`/`lib.answer` reach the module's members.
# A plain field read (`p.a`, `p.b`) on a local proves the namespace strip touches only the alias
# prefix, not ordinary `.field` access.
# expect: exit 42
import "lib" as lib
pub data Pair = { Iarch a, Iarch b }

const main_body! = (): Iarch -> {
	const Pair p = Pair({ a: 40, b: 2 })
	const Iarch base = lib.add(p.a, p.b)
	if base == lib.answer() then return base
	return 0
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
