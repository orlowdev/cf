# an alias of `Uarch` carries the register-width kind through, not a record —
# proving the erasure precedes parse_param_type's kind dispatch. An Iarch literal
# widens into the `Size` (Uarch) parameter, and `Iarch(...)` narrows the result back.
# expect: exit 9
type Size = Uarch
const id = (Size s): Size -> s
pub const main = () -> Iarch(id(9))
