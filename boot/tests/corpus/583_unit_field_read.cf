# a `Unit` field reads back the unit value into a `Unit` local
# expect: exit 3
import std::mem::arena::fixed_arena
data R = { Unit u, Iarch n }

const main_body! = (): Iarch -> {
	const r = R({ u: (), n: 3 })
	const x = r.u
	return r.n
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
