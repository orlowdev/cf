# A function type may RETURN a tuple: `(Iarch) -> (Iarch, Iarch)`. The caller binds the returned
# tuple and indexes it. apply(mk, 10) calls mk(10) = (10, 11), then 10 + 11 = 21.
# expect: exit 21
const mk = (Iarch n): (Iarch, Iarch) -> (n, n + 1)
const apply = ((Iarch) -> (Iarch, Iarch) f, Iarch x): Iarch -> {
	const t = f(x)
	return t[0] + t[1]
}
pub const main = () -> apply(mk, 10)
