# A record component in a function type: `((Point) -> Iarch) f` — the fn value takes a record.
# `apply(sumit, {2,3})` calls f({2,3}) = 2+3 = 5.
# expect: exit 5
data Point = { Iarch x, Iarch y }
const sumit = (Point p): Iarch -> p.x + p.y
const apply = ((Point) -> Iarch f, Point q): Iarch -> f(q)

const main_body! = (): Iarch -> apply(sumit, Point({ x: 2, y: 3 }))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
