# The PAGE geometry through the std-source module (geometry_lowering §5, `page`): a NON-`!`
# main that builds a record directly on its own ambient (the root page) is materialized under
# the `pg` tag — the record literal builds in a `reserve_ret__pg` reservation (fold-lite) on
# the root's kind-0 survivor lane instead of the shared `cf_alloc` floor. No arena is grafted:
# main IS the page ambient, and check_root permits a colorless frame to allocate there.
# expect: exit 42
data Box = { Iarch lo, Iarch hi }
pub const main = () -> {
	const Box b = Box({ lo: 10, hi: 52 })
	return b.hi - b.lo
}
