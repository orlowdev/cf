# a spread carries an aggregate (record-typed) field, not just Iarch fields
# expect: exit 10
data Point = { Iarch x, Iarch y }
data WithOrigin = { Point origin, Iarch id }
data Ext = { ...WithOrigin, Iarch extra }
const mk = (Iarch a, Iarch b): Point -> {
	const Point p = { x: a, y: b }
	return p
}

const main_body! = (): Iarch -> {
	const Ext e = { origin: mk(1, 2), id: 3, extra: 4 }
	return e.origin.x + e.origin.y + e.id + e.extra
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
