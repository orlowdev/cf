# an aggregate const referenced inside a `!` helper run under an arena graft: the reference
# counts as the helper's own construction (alloc coloring + materialize's may-allocate scan),
# so the helper brackets, materializes under the arena, and the spliced record reserves there
# expect: exit 5
import std::mem::arena::growing_arena
data Pt = { Iarch x, Iarch y }
pub const ORIGIN = Pt({ x: 2, y: 3 })

const total! = (): Iarch -> {
	const Pt p = ORIGIN

	return p.x + p.y
}

pub const main = (): Iarch -> {
	const a = growing_arena::of(4096)

	return total!() in a
}
