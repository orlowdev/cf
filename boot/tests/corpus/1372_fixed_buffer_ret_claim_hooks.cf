# The return protocol through real hook calls (geometry_lowering §3): `make!` is materialized
# as `make!__fb`, its escaping Box is placed by `on_ret` (survivor side, birth placement) while
# its dead scratch is `on_alloc`-placed residue; the caller's claim wraps the call in
# `on_alloc_ret` (the bump identity). `churn!` then burns the reclaimed residue region — if the
# kept Box had been misplaced residue-side, its bytes would be overwritten and the sum wrong.
# expect: exit 42
import "std/mem/fixed_buffer" as fixed_buffer
data Box = { Iarch lo, Iarch hi }
const make! = (Iarch n): Box -> {
	const Box junk = Box({ lo: n, hi: n })
	const Box b = Box({ lo: n + junk.lo - junk.hi, hi: n * 5 })
	return b
}
const churn! = (Iarch n): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const Box s = Box({ lo: i, hi: i })
		acc = acc + s.hi - s.lo
		i = i + 1
	}
	return acc
}
const run! = (Iarch n): Iarch -> {
	const Box kept = make!(n)
	const Iarch z = churn!(50)
	return kept.hi - kept.lo - z
}
static [4096 Uint8] pool
pub const main = () -> {
	const fb = fixed_buffer.of(pool)
	const Iarch r = run!(10) in fb
	return r + 2
}
