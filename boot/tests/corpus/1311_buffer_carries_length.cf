# A `[N Uint8]` byte buffer is a real length-carrying array — a `{data, len, cap}` header, not a
# bare pointer. `buf.len` reports its capacity N (like any array), while the buffer still decays to a
# raw `*[Uint8]` at the I/O boundary. Here a 100-byte buffer takes an indexed write and reports
# len 100 through the ordinary array path.
# expect: exit 100
const use! = (): Iarch -> {
	let [100 Uint8] buf
	buf[3] = 200
	return Iarch(buf.len)
}
pub const main = () -> {
	const a = mem.arena.grow(4096)
	return use!() in a
}
