# two independent records of the same type keep separate storage
# expect: exit 21
# check: root
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point a = { x: 1, y: 2 }
	const Point b = { x: 10, y: 20 }
	return a.x + b.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
