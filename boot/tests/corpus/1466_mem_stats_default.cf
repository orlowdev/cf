# `std::mem::observe::node(a)` — the instrumented-build accounting query (the
# sanitizer model: the compiler injects observer calls; this module is their
# readable runtime). In this default (uninstrumented) corpus build it folds to
# zeros at comptime; passing the handle to the query is one of the two legal
# handle-consumer forms (the other is `destroy`).
# expect: exit 0
import std::mem::arena::growing_arena
import std::mem::observe

data P = { Iarch x }

const work! = (): Iarch -> {
	let [P] ps = []
	ps = [...ps, P({ x: 7 })]

	return ps[0].x
}

pub const main = (): Iarch -> {
	const a = growing_arena::of(4096)
	const Iarch r = work!() in a
	const (c, b) = observe::node(a)

	return r - 7 + c + b
}
