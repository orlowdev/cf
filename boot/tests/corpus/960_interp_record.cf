# a record interpolation hole renders structurally: `Point({ x: 3, y: 4 })` (21 bytes)
# expect: exit 21
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point p = Point({ x: 3, y: 4 })
	const Str m = "${p}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
