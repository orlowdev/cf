# `as` composes with namespace reexport (module_system §4/§5): `top` reexports `impl_darwin` as the
# renamed namespace `console`, so a single window over `top` traverses `top::console::thing`. The
# rename is what the platform-dispatch barrel pattern needs (`pub import …::darwin::arm64 as console`).
# expect: exit 42
import top

pub const main = (): Iarch -> top::console::thing()
