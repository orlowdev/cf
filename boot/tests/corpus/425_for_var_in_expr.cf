# the loop variable is an ordinary Iarch usable in expressions
# expect: exit 14

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [3 Iarch] xs = [1, 2, 3]
	let Iarch sum = 0
	for x in xs {
		sum += x * x
	}
	return sum
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
