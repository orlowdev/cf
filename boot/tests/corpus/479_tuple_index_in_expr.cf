# tuple indexing composes inside arithmetic and as a call argument
# expect: exit 12
import std::mem::arena::fixed_arena
const dbl = (Iarch n): Iarch -> n * 2

const main_body! = (): Iarch -> {
	const t = (4, 2)
	return dbl(t[0]) + t[1] * (t[0] - t[1])
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
