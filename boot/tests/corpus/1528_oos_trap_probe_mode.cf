# the `--oos-probe` PATH PIN: probes are the portable trap definition (the future bare/wasm
# mechanism, and the escape hatch for hosts that must not own the SIGSEGV handler), but the
# guard-page handler is the hosted default — so nothing else in the corpus exercises the
# probe emission. Same runaway recursion as 1525, same observable (exit 72), probe-delivered.
# cf-flags: --oos-probe
# expect: exit 72
const deep = (Int n): Int -> {
	if n == 0 then return 0

	return deep(n - 1) + 1
}

pub const main = (): Int -> {
	if deep(1000) != 1000 then return 1

	return deep(100000000)
}
