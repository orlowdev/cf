# a boxed-UNION tuple element (previously a rejected "later brick"): the union value rides in the
# position's 8-byte slot as its box pointer, recovered by `match t[0]`. 7 + 3 = 10.
# expect: exit 10
import std::mem::arena::fixed_arena
union N = { I(Iarch), Z }

const main_body! = (): Iarch -> {
	const t = (N.I(7), 3)
	return match t[0] { N.I(v) -> v, N.Z -> 0 } + t[1]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
