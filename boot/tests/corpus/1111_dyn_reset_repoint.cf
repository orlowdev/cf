# `xs = []` resets a `[T]` local to a FRESH empty array (repointing its slot), leaving the
# old header intact for anything that captured it — the parser's `Seg({lit: cur}); cur = []`
# pattern. `a` captures cur at len 2; after the reset + rebuild, `a` must still read 2.
# expect: exit 3
data Cap = { [Uint8] bytes }
pub const main = () -> {
	let [Uint8] cur = []
	cur = [...cur, Uint8(1)]
	cur = [...cur, Uint8(2)]
	const Cap a = Cap({ bytes: cur })
	cur = []
	cur = [...cur, Uint8(9)]
	const Cap b = Cap({ bytes: cur })
	return Iarch(a.bytes.len) + Iarch(b.bytes.len)
}
