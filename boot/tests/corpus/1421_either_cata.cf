# std::data::either::cata — the forks out of `Either`: `fold` collapses both lanes through their
# handlers, `or_else` defaults a `Left`, `to_maybe` forgets the error, `to_tuple` fills the absent
# lane with its default. 21 - 21 + 20 + 9 + (9 + 1) + 3 = 42.
# expect: exit 42
import std::data::{ Either, Maybe }
import std::data::either::ops::{ of, of_left }
import std::data::either::cata::{ fold, or_else, to_maybe, to_tuple }

const neg = (Iarch n): Iarch -> 0 - n
const idn = (Iarch n): Iarch -> n

pub const main = () -> {
	const a = of[Iarch, Iarch](21) |> fold[Iarch, Iarch, Iarch](neg, idn)
	const b = of_left[Iarch, Iarch](21) |> fold[Iarch, Iarch, Iarch](neg, idn)

	const Maybe[Iarch] mj = of[Str, Iarch](20) |> to_maybe[Str, Iarch]
	const mv = match mj {
		Maybe.Just(v) -> v,
		Maybe.Nothing -> 0,
	}

	const c = or_else[Str, Iarch](9, of_left[Str, Iarch]("gone"))

	const (l, r) = of[Iarch, Iarch](1) |> to_tuple[Iarch, Iarch](9, 0)
	const (l2, r2) = of_left[Iarch, Iarch](3) |> to_tuple[Iarch, Iarch](9, 0)

	return a + b + mv + c + l + r + l2 + r2
}
