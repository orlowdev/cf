# `consume(T)` where `T` is not a declared record — context carries nominal aggregates only
# (context.md §3), so the name must resolve to a record.
# expect: error
import std::mem::ctx

pub const use_it = (): Iarch uses Missing -> {
	const c = std::mem::ctx::consume(Missing)

	return 0
}

pub const main = () -> {
	return use_it()
}
