# The Materialize stage (geometry-modules arc): under fixed_buffer the loop residue bracket
# is the geometry's OWN hooks — `on_scope_enter`/`on_scope_exit` from lib/std/mem/fixed_buffer.cf,
# placed by emit around every marked loop. 1000 iterations of a 16-byte Box (plus its scratch
# copy — the value-level tax) through a 2 KiB pool fit ONLY if each iteration's exit hook
# restores the residue cursor; a broken bracket overflows the two-ended block and traps.
# expect: exit 42
data Box = { Iarch lo, Iarch hi }
const churn! = (Iarch n): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const Box b = Box({ lo: i, hi: i * 3 })
		acc = acc + b.hi - b.lo
		i = i + 1
	}
	return acc
}
static [2048 Uint8] pool
pub const main = () -> {
	const fb = mem.fixed_buffer.of(pool)
	const Iarch total = churn!(1000) in fb
	return total - 998958
}
