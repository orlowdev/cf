# the monomorph pass COLLECTS: every failed instantiation (one per declaration walked)
# reports in ONE run instead of dying at the first — and the pass stops before typecheck,
# so a missing instance never cascades into "undefined function" noise
# expect: error
pub const id = ['T]('T x): 'T -> x

pub const pick = ['T]('T a, 'T b): 'T -> a

const first_bad = (): Iarch -> id[Iarch, Str](1)

const second_bad = (): Iarch -> pick[Iarch, Str, Bool](1, 2)

pub const main = (): Iarch -> {
	return first_bad() + second_bad()
}
