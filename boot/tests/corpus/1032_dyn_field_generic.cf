# a `[T]` field in a GENERIC record: the element type-variable `'T` is substituted at
# monomorphization (like a generic tuple field), so `['T]` becomes `[Iarch]` in Ctx[Iarch].
# expect: exit 42
data Ctx['T] = { ['T] xs, Iarch pos }
const first = (*Ctx[Iarch] c): Iarch -> c.xs[0]

const main_body! = (): Iarch -> {
	let [Iarch] v = [42, 2]
	const Ctx[Iarch] c = { xs: v, pos: 0 }
	return first(&c)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
