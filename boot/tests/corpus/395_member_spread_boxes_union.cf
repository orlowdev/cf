# a spliced payload member boxes the whole union (a nullary member coexists)
# expect: exit 42
union P = { Has(Iarch) }
union Q = { ...P, None }
const eval = (Q q): Iarch -> match q {
	Q.Has(v) -> v,
	Q.None -> 0,
}

const main_body! = (): Iarch -> {
	const Q q = Q.Has(42)
	return eval(q)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
