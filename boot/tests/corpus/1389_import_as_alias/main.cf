# `as` rename on a namespace import (module_system §4): `import std::comptime::os as comptime_os`
# binds the alias `comptime_os` (not the last segment `os`) over the `std::comptime::os` module, so
# a `comptime_os::target` use resolves through it. The darwin (true) branch imports a helper module;
# the loser is parsed but never resolved. A `as`-renamed destructured import is exercised too.
# expect: exit 7
import std::comptime::os as comptime_os
import std::sys::{ Os }

if comptime_os::target == Os.Darwin then import impl_darwin::{ v } else import impl_absent::{ v }

pub const main = (): Iarch -> v
