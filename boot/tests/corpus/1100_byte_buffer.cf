# byte-buffer subsystem: a [N Uint8] buffer written and read by byte, passed as a
# *[Uint8] record field and a *[Uint8] parameter (the shape cf's own read buffers use).
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
data Buf = { *[Uint8] data, Iarch n }
const sum2 = (*[Uint8] p): Iarch -> Iarch(p[0]) + Iarch(p[1])

const main_body! = (): Iarch -> {
	let [8 Uint8] b
	b[0] = 40
	b[1] = 2
	const Buf bx = Buf({ data: b, n: 8 })
	return sum2(bx.data)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
