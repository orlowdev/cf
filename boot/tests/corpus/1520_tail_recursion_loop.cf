# a colorless self-tail-call (`return f(...)`) lowers to a frame-reusing loop (TCO): depth no
# longer consumes stack (2M frames segfaulted before), and arguments are all read before any
# parameter is overwritten (the swap), including aggregate parameters (the array rides through)
# expect: exit 42

const deep = (Int n, Int acc): Int -> {
	if n == 0 then return acc

	return deep(n - 1, acc + 1)
}

const swapper = (Int a, Int b, Int n): Int -> {
	if n == 0 then return a - b

	return swapper(b, a, n - 1)
}

const sum_from = ([Iarch] xs, Int i, Int acc): Int -> {
	if i >= Iarch(xs.len) then return acc

	return sum_from(xs, i + 1, acc + xs[i])
}

pub const main = (): Int -> {
	if deep(2000000, 0) != 2000000 then return 1
	if swapper(3, 10, 1000000) != -7 then return 2
	if swapper(3, 10, 1000001) != 7 then return 3
	if sum_from([5, 6, 7, 8], 0, 0) != 26 then return 4

	return 42
}
