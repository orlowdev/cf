# std::data::array transforms, data-last and piped: `map`/`filter` rebuild, `reduce` collapses
# left to right, `chain` flat-maps, `flatten` splices one nesting level, `of`/`push`/`concat`
# build. Every type argument here is spelled EXPLICITLY — exercising that form; none are
# required (1467 runs the same chains inferred). 30 + 9 + 12 + 10 + 6 - 25 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::array::{ of, push, concat, map, filter, reduce, chain, flatten, range }

const double = (Iarch n): Iarch -> n * 2

const odd = (Iarch n): Bool -> n - (n / 2) * 2 == 1

const add = (Iarch a, Iarch b): Iarch -> a + b

const pair = (Iarch n): [Iarch] -> [n, n]

const main_body! = (): Iarch -> {
	const xs = range(1, 6)
	const s1 = xs |> map[Iarch, Iarch](double) |> reduce[Iarch, Iarch](add, 0)
	const s2 = xs |> filter[Iarch](odd) |> reduce[Iarch, Iarch](add, 0)
	const s3 = of(7) |> push[Iarch](3) |> concat[Iarch]([1, 1]) |> reduce[Iarch, Iarch](add, 0)
	const s4 = [2, 3] |> chain[Iarch, Iarch](pair) |> reduce[Iarch, Iarch](add, 0)

	let [[Iarch]] nest = []
	nest = [...nest, [1, 2]]
	nest = [...nest, [3]]
	const s5 = nest |> flatten[Iarch] |> reduce[Iarch, Iarch](add, 0)

	return s1 + s2 + s3 + s4 + s5 - 25
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body!() in ar
}
