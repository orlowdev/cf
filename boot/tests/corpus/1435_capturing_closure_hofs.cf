# CAPTURING closures (named or anonymous) pass into ANY higher-order function: each `hof(clo, …)`
# retargets a specialized clone with the captures threaded as hidden parameters — block bodies,
# loops inside the HOF, generic instances, and HOF-to-HOF forwarding chains all work, and a
# mutation through a capture is observed by the enclosing scope. 45 + 12 - 15 - 5 + 31 - 26 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::array::{ map, filter, reduce, range }

const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> {
	const Iarch r = f(x)

	return r + 1
}

const relay = ((Iarch) -> Iarch g, Iarch y): Iarch -> {
	const Iarch a = apply(g, y)
	const Iarch b = apply(g, y + 1)

	return a + b
}

const main_body = (): Iarch -> {
	const xs = range(1, 6)
	const Iarch factor = 3
	const Iarch floor2 = 2

	const s1 = xs
		|> map[Iarch, Iarch]((Iarch n): Iarch -> n * factor)
		|> reduce[Iarch, Iarch]((Iarch a, Iarch b): Iarch -> a + b, 0)

	const s2 = xs
		|> filter[Iarch]((Iarch n): Bool -> n > floor2)
		|> reduce[Iarch, Iarch]((Iarch a, Iarch b): Iarch -> a + b, 0)

	let Iarch hits = 0
	const bump = (Iarch n): Iarch -> {
		hits = hits + 1
		return n
	}
	const s3 = xs |> map[Iarch, Iarch](bump) |> reduce[Iarch, Iarch]((Iarch a, Iarch b): Iarch -> a + b, 0)

	const Iarch base = 10
	const chained = relay((Iarch n): Iarch -> n + base, 4)

	return s1 + s2 - s3 - hits + chained - 26
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body() in ar
}
