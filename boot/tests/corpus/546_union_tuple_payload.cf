# a union member may carry a tuple payload; construct, match, and index it
# expect: exit 30
# check: root
union B = { Wrap((Iarch, Iarch)), Empty }

const main_body! = (): Iarch -> {
	const B b = B.Wrap((10, 20))
	return match b {
		B.Wrap(p) -> p[0] + p[1],
		B.Empty -> 0,
	}
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
