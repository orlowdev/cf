# A rehome (`b.p = t`) inside a VALUE BLOCK's statement body shares the frame's params and
# escapes `t` into the caller-owned Box like any top-level rehome. The escape-root walk never
# descended into expressions, so `t` read as trapped residue and this rehome-only function was
# wrongly required to wear `!`.
# expect: exit 8
data P = { Iarch v }
data Box = { P p }
const put = (*Box b): Iarch -> {
	const Iarch x = loop {
		const P t = P({ v: 9 })
		b.p = t
		<- 1
	}
	return x
}
const main_body! = (): Iarch -> {
	let Box bx = Box({ p: P({ v: 1 }) })
	const Iarch z = put(&bx)
	return bx.p.v - z
}
pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
