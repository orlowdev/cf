# A `defer`-tap whose callee is a GENERIC function resolves to the concrete instance: the
# monomorphizer must instantiate the deferred call's callee (inferred from the tapped argument),
# not just its arguments. `7 |> defer id` schedules id[Iarch](7) and taps 7 through.
# expect: exit 7
pub const id = ['T]('T x): 'T -> x
pub const run = (): Iarch -> {
	const Iarch v = 7 |> defer id
	return v
}
pub const main = () -> run()
