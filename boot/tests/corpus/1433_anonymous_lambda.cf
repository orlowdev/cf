# An ANONYMOUS function value in expression position (ebnf Functions: a function is just a value):
# a lambda rides straight into a HOF argument — concrete or generic, direct or through a `|>`
# chain — without a named binding. A lambda passed to a single-expression HOF may capture an
# enclosing local. 30 + 9 + 3 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::array::{ map, filter, reduce, range }

const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)

const main_body = (): Iarch -> {
	const xs = range(1, 6)

	const s1 = xs
		|> map[Iarch, Iarch]((Iarch n): Iarch -> n * 2)
		|> reduce[Iarch, Iarch]((Iarch a, Iarch b): Iarch -> a + b, 0)

	const s2 = xs
		|> filter[Iarch]((Iarch n): Bool -> n - (n / 2) * 2 == 1)
		|> reduce[Iarch, Iarch]((Iarch a, Iarch b): Iarch -> a + b, 0)

	const Iarch base = 1
	const c = apply((Iarch n): Iarch -> n + base, 2)

	return s1 + s2 + c
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body() in ar
}
