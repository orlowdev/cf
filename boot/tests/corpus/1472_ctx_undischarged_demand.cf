# A `consume(T)` reached from main with no `provide(T)` in scope — an undischarged context demand
# (context.md §4). The demand propagates up the call chain to main, where nothing provides it.
# expect: error
import std::mem::ctx

data Cfg = { Str host }

pub const use_it = (): Str uses Cfg -> {
	const c = std::mem::ctx::consume(Cfg)

	return c.host
}

pub const main = () -> {
	const Str h = use_it()

	return Iarch(h.len)
}
