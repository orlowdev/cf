# a declaration nothing calls is still checked: the reach filter prunes it from EMISSION, but
# its errors must not vanish with the pruning (check_unreachable! over the dropped originals)
# expect: error
import std::mem::arena::growing_arena

const dead_bad = (Iarch a): Iarch -> {
	return a + "no"
}

const live! = (): Iarch -> {
	const [Iarch] xs = [1, 2]

	return xs[0]
}

pub const main = (): Iarch -> {
	const a = growing_arena::of(4096)

	return live!() in a
}
