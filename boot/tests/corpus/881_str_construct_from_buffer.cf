# construct a Str from a runtime byte buffer via `Str(buf, n)` (the file-read → Str path)
# expect: exit 74

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let [8 Uint8] buf
	buf[0] = 72
	buf[1] = 105
	const Str s = Str(buf, 2)
	return s.len + Iarch(s[0])
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
