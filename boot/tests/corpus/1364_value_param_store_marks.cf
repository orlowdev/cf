# The survivor-mark store gate: an aliased self-append (`let a = acc; a = [...a, v]`) grows
# CALLER-reachable storage through a plain value param — a legal store channel the old
# signature-only gates missed. add1!'s own summary (stores acc) must refuse its frame
# survivor mark, and build!'s loop must refuse its survivor loop mark for calling it —
# else the doubled blocks are freed mid-walk (this shape segfaulted before the fix).
# expect: exit 42
const same = (Str a, Str b): Bool -> {
	if Iarch(a.len) != Iarch(b.len) then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}
const has_it = ([Str] xs, Str s): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(xs.len) then break
		if same(xs[i], s) then return true
		i = i + 1
	}
	return false
}
const add1! = ([Str] acc, Str v): Iarch -> {
	if has_it(acc, v) then return 0
	let [Str] a = acc
	a = [...a, v]
	return 0
}
const lvl2! = ([Str] acc, Str v): Iarch -> add1!(acc, v)
const lvl3! = ([Str] acc, Iarch k): Iarch -> {
	lvl2!(acc, "s${k}")
	return 0
}
const build! = (): Iarch -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= 200 then break
		lvl3!(r, i * 1000 + 7)
		i = i + 1
	}
	let Iarch t = 0
	let Iarch j = 0
	loop {
		if j >= Iarch(r.len) then break
		t = t + Iarch(r[j].len)
		j = j + 1
	}
	if t == 1287 then return 42
	return 1
}
pub const main = () -> {
	const a = mem.arena.grow(16777216)
	return build!() in a
}
