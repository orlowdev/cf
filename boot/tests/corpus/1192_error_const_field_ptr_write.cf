# write-through-`const`: a `*[T]` borrowed from a `const` aggregate's field is read-only, so
# handing it to a parameter that writes through it is rejected (memory_model §6).
# expect: error
data Bag = { [Iarch] items }
const fill = (*[Iarch] xs, Iarch n): Iarch -> {
	xs[0] = 9
	return n
}
pub const main = () -> {
	const Bag b = Bag({ items: [0, 0] })
	const w = fill(b.items, 2)
	return b.items[0]
}
