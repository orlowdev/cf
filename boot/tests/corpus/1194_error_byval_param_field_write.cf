# a by-value parameter is a read-only view (memory_model §6), so a `*[T]` borrowed from one of its
# fields may not be handed to a writer — even though the caller's own binding is a `let`.
# expect: error
data Bag = { [Iarch] items }
const fill = (*[Iarch] xs): Iarch -> {
	xs[0] = 9
	return 0
}
const use = (Bag b): Iarch -> {
	const w = fill(b.items)
	return b.items[0]
}
pub const main = () -> {
	let Bag bb = Bag({ items: [1, 2] })
	return use(bb)
}
