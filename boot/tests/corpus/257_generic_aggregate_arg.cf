# a generic type instantiated at an aggregate (`Box[Point]` — a pointer field)
# expect: exit 7
# check: root
data Point = { Iarch x, Iarch y }
data Box['T] = { 'T v }
const mkp = (Iarch a, Iarch b): Point -> {
	const Point p = { x: a, y: b }
	return p
}

const main_body! = (): Iarch -> {
	const Box[Point] b = { v: mkp(3, 4) }
	return b.v.x + b.v.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
