# call-side both-ways: passing a `!` function value makes the call effectful, so an unmarked caller
# is an error.
# check: alloc
# expect: error
data Point = { Iarch x, Iarch y }
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const sq! = (Iarch n): Iarch -> {
	const Point p = { x: n, y: n }
	return p.x * n
}
const run = (): Iarch -> apply(sq!, 5)
pub const main = () -> run()
