# One function reachable under BOTH std-source geometries: `run!`/`make!` get a `__fb` AND an
# `__ar` twin from the two seeds, each lowered to its own module's reserves and hooks, and the
# two ambients compute independently — the (fn × geometry) axis end-to-end.
# expect: exit 42
data Box = { Iarch lo, Iarch hi }
const make! = (Iarch n): Box -> {
	const Box junk = Box({ lo: n, hi: n + 1 })
	return Box({ lo: n + junk.hi - junk.lo - 1, hi: n * 3 })
}
const run! = (Iarch n): Iarch -> {
	const Box kept = make!(n)
	return kept.hi - kept.lo
}
static [4096 Uint8] pool
pub const main = () -> {
	const fb = mem.fixed_buffer.of(pool)
	const ar = mem.arena.of(2048)
	const Iarch a = run!(7) in fb
	const Iarch b = run!(14) in ar
	return a + b
}
