# value-level array spread `[...src, e]` in RETURN position — copies the source vector and
# appends, so the source is UNCHANGED (a fresh `[T]`, not in-place growth). `grow(base, 40)`
# returns a 4-element copy; base stays length 3 with its data intact. 3 (base.len) + 4
# (grown.len) + 60 (base sum 10+20+30) = 67.
# expect: exit 67
import std::mem::arena::growing_arena
const sumv = ([Iarch] xs): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(xs.len) then break
		acc = acc + xs[i]
		i = i + 1
	}
	return acc
}
const grow = ([Iarch] src, Iarch e): [Iarch] -> [...src, e]

const main_body! = (): Iarch -> {
	const [Iarch] base = [10, 20, 30]
	const [Iarch] grown = grow(base, 40)
	return Iarch(base.len) + Iarch(grown.len) + sumv(base)
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
