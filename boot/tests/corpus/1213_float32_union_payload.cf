# a `Float32` union payload (QBE `s`, `stores`/`loads`), built with an explicit `Float32(...)` cast.
# expect: exit 7
union N = { F(Float32), Z }

const main_body! = (): Iarch -> {
	const N n = N.F(Float32(7.5))
	return match n {
		N.F(f) -> Iarch(f),
		N.Z -> 0
	}
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
