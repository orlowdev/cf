# a `Float64` field read through an array element, `ps[i].x` (the `IndexField` load path). 7 + 2 = 9.
# expect: exit 9
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Float64 x }

const main_body! = (): Iarch -> {
	let [P] ps = [P({ x: 7.5 }), P({ x: 2.0 })]
	return Iarch(ps[0].x) + Iarch(ps[1].x)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
