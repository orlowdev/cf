# A record captured by a closure is threaded through the HOF as a pointer; calling
# the closure through the HOF mutates the record. Two calls take c.v from 0 to 30.
# expect: exit 30
# check: root
data Cell = { Iarch v }
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const run! = (): Iarch -> {
	let Cell c = { v: 0 }
	const bump = (Iarch k): Iarch -> {
		c.v = c.v + k
		return c.v
	}
	const a = apply(bump, 10)
	const b = apply(bump, 20)
	return c.v
}

const main_body! = (): Iarch -> run!()

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
