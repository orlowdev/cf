# a `*[T]` parameter accepts a field read on a CALL result (`mk().items`, a `FieldExpr`) — the
# array field's data pointer is passed
# expect: exit 100
data Bag = { [Iarch] items }
const mk = (): Bag -> Bag({ items: [4, 6, 90] })
const sum = (*[Iarch] xs, Iarch n): Iarch -> {
	let s = 0
	let i = 0
	loop {
		if i >= n then break
		s = s + xs[i]
		i = i + 1
	}
	return s
}
pub const main = () -> sum(mk().items, 3)
