# a `Bool` record field: constructed, read back, and used as an `if` condition (a Bool rides the
# word slot 0/1 like any scalar field).
# expect: exit 5
import "std/mem/arena/fixed_arena" as fixed_arena
data R = { Bool flag, Iarch n }

const main_body! = (): Iarch -> {
	let R r = R({ flag: true, n: 5 })
	return if r.flag then r.n else 0
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
