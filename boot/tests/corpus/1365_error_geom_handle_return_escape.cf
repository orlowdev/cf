# A geometry is a comptime ambient spent IN PLACE, not a first-class value: a callee may not mint
# an arena and RETURN its handle. A returned handle would let the caller run `... in h` under a
# geometry the compiler cannot trace to a constructor — the minted-handle gap that once fell back
# to a runtime-dispatch cf_alloc. Forbidding the escape (geometry_lowering §1) keeps every handle
# statically traceable, so materialize always resolves the ambient. Rejected at compile time.
# expect: error
import std::mem::arena::fixed_arena
const mk = (): Iarch -> {
	const b = fixed_arena::of(4096)
	return b
}
pub const main = () -> {
	const a = fixed_arena::of(65536)
	const Iarch h = mk() in a
	return 0
}
