# a nullary function type `() -> ()` as a parameter — an effect thunk passed to a HOF. Both the empty
# argument list and the `Unit` return parse (parser) and type-check (a `() -> ()` component is well
# formed). The HOF calls the thunk, which bumps a shared counter through a `*Acc`; 3 calls -> exit 3.
# expect: exit 3
data Acc = { Iarch n }
const thrice = (() -> () f): () -> {
	f()
	f()
	f()
}
pub const main = () -> {
	let Acc a = { n: 0 }
	const bump = (): () -> {
		a.n = a.n + 1
	}
	thrice(bump)

	return a.n
}
