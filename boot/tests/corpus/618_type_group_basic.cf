# a grouped-params `type`: the callee `(Opts o)` splats to `(Iarch a, Iarch b)`; the caller
# passes ONE `{ a: …, b: … }` literal, desugared to positional field values.
# expect: exit 30
type Opts = { Iarch a, Iarch b }
const sum = (Opts o): Iarch -> a + b
pub const main = () -> sum({ a: 10, b: 20 })
