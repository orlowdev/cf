# a `[N Record]` array: elements are fresh records (arena pointers), indexed + field-read
# expect: exit 140
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Iarch x, Iarch y }
const mk = (Iarch a, Iarch b): P -> ({ x: a, y: b })

const main_body! = (): Iarch -> {
	const [3 P] ps = [mk(1, 2), mk(10, 20), mk(100, 40)]
	return ps[2].x + ps[2].y
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
