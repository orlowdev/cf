# several member spreads compose into one flat member set
# expect: exit 41
union A = { X, Y }
union B = { Z, W }
union C = { ...A, ...B }
const rank = (C c): Iarch -> match c {
	C.X -> 1,
	C.Y -> 2,
	C.Z -> 3,
	C.W -> 4,
}
pub const main = () -> {
	const C p = C.W
	const C q = C.X
	return rank(p) * 10 + rank(q)
}
