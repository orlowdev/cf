# A parameter annotated with a generic member type (`Maybe[Iarch].Just`) behaves as the
# union parameter.
# expect: exit 7
union Maybe['V] = { Just('V), Nothing }
const unwrap = (Maybe[Iarch].Just m): Iarch -> match m {
	Maybe.Just(v) -> v,
	Maybe.Nothing -> 0,
}
pub const main = () -> unwrap(Maybe[Iarch].Just(7))
