# a Str bundled as a record field, read through a `*Token` pointer
# expect: exit 5
data Token = { Str text, Iarch kind }
const textlen = (*Token t): Iarch -> t.text.len

const main_body! = (): Iarch -> {
	const tok = Token({ text: "while", kind: 1 })
	return textlen(&tok)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
