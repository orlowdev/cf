# a heterogeneous (Iarch, Str) tuple parameter
# expect: exit 8
import "std/mem/arena/growing_arena" as growing_arena
const f = ((Iarch, Str) p): Iarch -> p[0] + p[1].len

const main_body! = (): Iarch -> f((5, "abc"))

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
