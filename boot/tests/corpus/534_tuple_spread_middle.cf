# a spread may sit between explicit elements (prepend/append around it)
# expect: exit 30

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	const t = (10, 20)
	const u = (5, ...t, 100)
	return u[1] + u[2]
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
