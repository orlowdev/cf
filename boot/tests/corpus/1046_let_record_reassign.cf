# a whole record `let` local can be reassigned to a fresh record (the old value orphaned in the
# arena). `p` starts {1,2}, is reassigned {10,20}; field mutation still works after. 10+20 = 30.
# expect: exit 30
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	let P p = P({ x: 1, y: 2 })
	p = P({ x: 5, y: 20 })
	p.x = 10
	return p.x + p.y
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
