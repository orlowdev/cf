# A pointer widens to a FULL register word only — narrowing an address to a sub-word integer is
# rejected (it would truncate/garble the address). `Int8(p)` on a `*[Uint8]` is an error; the
# accepted forms are `Uarch(p)` / `Iarch(p)` (see 1312).
# expect: error
import "std/mem/arena/growing_arena" as growing_arena
const bad = (*[Uint8] p): Iarch -> Iarch(Int8(p))
const use! = (): Iarch -> {
	let [8 Uint8] buf
	return bad(buf)
}
pub const main = () -> {
	const a = growing_arena.of(4096)
	return use!() in a
}
