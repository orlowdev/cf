# a `Float64` union PAYLOAD: constructed with `N.F(40.5)` (stored `stored` into the box) and
# recovered in a `match` arm where the bound payload `f` reloads as a float (`loadd`). Iarch(40.5)=40.
# expect: exit 40
union N = { I(Iarch), F(Float64) }
pub const main = () -> {
	const N n = N.F(40.5)
	return match n {
		N.I(v) -> v,
		N.F(f) -> Iarch(f)
	}
}
