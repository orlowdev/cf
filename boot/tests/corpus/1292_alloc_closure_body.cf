# closure/defer descent (memory_model §5/§7): a function is `!` when a closure it defines allocates,
# even if the function's own top-level body allocates nothing. `mk` traps a `P` (returns only a
# scalar), so `run!` carries the marker.
# check: alloc
# expect: exit 5
data P = { Iarch v }
const run! = (): Iarch -> {
	const mk = (Iarch x): Iarch -> {
		const P p = { v: x }
		return p.v
	}
	return mk(5)
}
pub const main = () -> run!()
