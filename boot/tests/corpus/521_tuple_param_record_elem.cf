# a tuple parameter carrying a record element; index it and read fields
# expect: exit 25
# check: root
data P = { Iarch x, Iarch y }
const mk = (Iarch a, Iarch b): P -> P({ x: a, y: b })
const sum = ((Iarch, P) t): Iarch -> t[0] + t[1].x + t[1].y

const main_body! = (): Iarch -> sum((5, mk(8, 12)))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
