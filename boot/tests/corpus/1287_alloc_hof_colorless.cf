# HOF definition-side rule: a function is `!` only when it calls a CONCRETE `!` function — not when
# it merely invokes a `!` value received as a parameter. `apply` calling its callback stays colorless.
# expect: exit 5
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const inc = (Iarch n): Iarch -> n + 1
pub const main = () -> apply(inc, 4)
