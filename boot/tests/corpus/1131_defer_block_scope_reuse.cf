# Two sibling `defer { ... }` blocks are independent scopes, so each may reuse a local name.
# The defer.cf lowering must splice each body as its OWN block, not flatten both into one
# scope (which would collide the two `t` bindings). LIFO: second defer runs first (0*10+2=2),
# then the first (2*10+1=21).
# expect: exit 21
data Cell = { Iarch v }
const run = (): Cell -> {
	let Cell c = { v: 0 }
	defer {
		const t = c.v
		c.v = t * 10 + 1
	}
	defer {
		const t = c.v
		c.v = t * 10 + 2
	}
	return c
}
pub const main = () -> run().v
