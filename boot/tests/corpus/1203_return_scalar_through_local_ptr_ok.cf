# region-outlives permits returning a SCALAR read through a pointer into a local — only a pointer
# that outlives its target escapes; a copied-out scalar value carries no reference.
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x }
data Pair = { *Point a, *Point b }
const first = (*Pair pr): Iarch -> pr.a.x

const main_body! = (): Iarch -> {
	let Point p1 = { x: 7 }
	let Point p2 = { x: 4 }
	let Pair pp = Pair({ a: &p1, b: &p2 })
	return first(&pp)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
