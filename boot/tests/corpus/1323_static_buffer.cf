# A module-level `static [N Uint8]` buffer lives in the binary's BSS — program-lifetime, off every
# geometry node, zero-initialized. A bare reference auto-yields its `{data,len,cap}` header, so
# `POOL.len` reads its size and passing it to a `*[Uint8]` reader decays to its data. It needs no
# geometry and no `!` marker — legal directly in `main` (it never dangles).
# expect: exit 64
static [64 Uint8] POOL
const first = (*[Uint8] p): Iarch -> Iarch(p[0])
pub const main = () -> first(POOL) + Iarch(POOL.len)
