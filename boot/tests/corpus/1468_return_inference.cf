# Return-type inference from the body (type_system §5.1: an omitted return type is INFERRED,
# universally): named functions returning Str (with interpolation over another inferred call),
# a record, an array, and a tuple all omit the annotation; a lambda's `Bool` predicate result
# infers too (no `: Bool`), and the destructure/pipe consumers see the filled types. The retfill
# pass runs post-monomorph; typecheck reads only filled signatures.
# 41 + 9 + 30 - 38 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::str::{ eq }
import std::data::array::{ map, filter, reduce, range }

data Point = { Iarch x, Iarch y }

const greet = () -> "hello"
const shout = () -> "${greet()}!"
const mk = (Iarch x) -> Point({ x: x, y: x * 2 })
const evens = () -> [2, 4, 6]
const pairup = (Iarch a) -> (a, a + 1)

const main_body = () -> {
	if !eq(shout(), "hello!") then return 1
	const p = mk(3)
	if p.y != 6 then return 2
	const es = evens()
	if Iarch(es.len) != 3 then return 3
	const (lo, hi) = pairup(20)
	const odds = range(1, 6) |> filter((Iarch n) -> n - (n / 2) * 2 == 1)
	const s = range(1, 6)
		|> map((Iarch n) -> n * 2)
		|> reduce((Iarch a, Iarch b) -> a + b, 0)

	return lo + hi + Iarch(odds.len) * 3 + s - 38
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body() in ar
}
