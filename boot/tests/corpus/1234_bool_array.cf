# a `[Bool]` dynamic array (previously rejected — its element typed as a word, mismatching the Bool
# literals). Elements ride the word slot; `xs[i]` reads a Bool.
# expect: exit 4

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	const [Bool] xs = [true, false, true]
	return if xs[0] then 4 else 0
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
