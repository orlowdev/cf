# The closure law under value-level hooks (geometry_lowering §1): a returned Pair's INNER
# records escape with it, so every construction in the chain is `on_ret`-placed survivor-side
# in turn — the outer's field words then point at already-placed inners of the same lifetime
# (classification is transitive; the hook's shallow copy is sound by construction). The churn
# overwrites the reclaimed residue region, so a misplaced inner reads back garbage.
# expect: exit 42
data Inner = { Iarch v }
data Pair = { Inner a, Inner b }
const make = (Iarch n): Pair -> {
	const Pair p = Pair({ a: Inner({ v: n }), b: Inner({ v: n * 5 }) })
	return p
}
const churn! = (Iarch n): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const Inner s = Inner({ v: i })
		acc = acc + s.v - i
		i = i + 1
	}
	return acc
}
const run! = (Iarch n): Iarch -> {
	const Pair kept = make(n)
	const Iarch z = churn!(60)
	return kept.b.v - kept.a.v - z
}
static [4096 Uint8] pool
pub const main = () -> {
	const fb = mem.fixed_buffer.of(pool)
	const Iarch r = run!(10) in fb
	return r + 2
}
