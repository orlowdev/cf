# a `Float64` TUPLE element (previously a rejected "later brick"): stored `stored` into its 8-byte
# slot and read via `t[k]` with `loadd`. 40 + 3 = 43.
# expect: exit 43

const main_body! = (): Iarch -> {
	const t = (40.5, 3)
	return Iarch(t[0]) + t[1]
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
