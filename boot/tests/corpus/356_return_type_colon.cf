# A stated return type is set off with a colon before the `->` body arrow:
# `(params): Ret -> body`. Here a record return.
# expect: exit 15
data Point = { Iarch x, Iarch y }
const mk = (Iarch a): Point -> {
	const Point p = { x: a, y: a }
	return p
}
pub const main = () -> {
	let Point p = mk(5)
	p.x = 10
	return p.x + p.y
}
