# Two modules each export a `ping` — impossible under the old flat namespace ("two functions
# share a name"), now valid: path-prefix mangling keeps them apart and the namespace qualifier
# selects which. `a.ping()` (40) + `b.ping()` (2) = 42.
# expect: exit 42
import "a" as a
import "b" as b

pub const main = (): Iarch -> a.ping() + b.ping()
