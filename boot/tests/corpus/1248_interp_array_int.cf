# an array interpolation hole renders `[1, 2, 3]` via a runtime loop (9 bytes)
# expect: exit 9

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let [Iarch] xs = [1, 2, 3]
	const Str m = "${xs}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
