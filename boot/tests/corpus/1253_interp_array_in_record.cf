# an array-typed record field stringifies through the recursive path: `B({ ns: [1, 2] })` (17 bytes)
# expect: exit 17
# check: root
data B = { [Iarch] ns }

const main_body! = (): Iarch -> {
	const B b = B({ ns: [1, 2] })
	const Str m = "${b}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
