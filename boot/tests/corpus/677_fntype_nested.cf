# A nested function type: `f` is itself a function that takes a function value.
# `run(apply_inc)` = apply_inc(inc) = inc(5) = 6.
# expect: exit 6
const inc = (Iarch n) -> n + 1
const apply_inc = ((Iarch) -> Iarch g): Iarch -> g(5)
const run = (((Iarch) -> Iarch) -> Iarch f): Iarch -> f(inc)
pub const main = () -> run(apply_inc)
