# An inline fixed-array field `[N Uint8]` stores its N bytes IN the record body (not an 8-byte
# pointer), so fields declared before and after it sit at running-sum offsets. Reading the field
# yields the address of its inline bytes: it passes to a `*[Uint8]` helper (edited in place) and to
# a `Str`'s `bytes`. Here `a`/`b`/`c` bracket a 16-byte inline buffer; writing two bytes into the
# buffer must leave the scalar fields intact.
# expect: exit 154
import std::mem::arena::growing_arena

data R = { Iarch a, [16 Uint8] buf, Iarch b, Iarch c }

const put_byte = (*[Uint8] buf, Iarch at, Iarch b): () -> {
	buf[at] = Uint8(b)
}

const run! = (): Iarch -> {
	let R r = R({ a: 111, b: 222, c: 333 })

	put_byte(r.buf, 0, 65)
	put_byte(r.buf, 1, 66)

	# the inline buffer read back as a 2-byte Str must be "AB" (65, 66)
	const Str s = Str({ bytes: r.buf, len: 2 })

	if Iarch(s.len) != 2 then return 1
	if Iarch(s[0]) != 65 then return 2
	if Iarch(s[1]) != 66 then return 3

	# the scalar fields around the inline buffer are undisturbed → 111 + 222 + 333 = 666 (& 255 = 154)
	return r.a + r.b + r.c
}

pub const main = () -> {
	const g = growing_arena::of(65536)

	return run!() in g
}
