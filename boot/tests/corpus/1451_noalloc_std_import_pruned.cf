# a NO-geometry program may import a std module whose unused fns construct aggregates: the
# dormant-page path prunes unreached declarations (they are typechecked, not emitted), so the
# import costs nothing and the standard descriptors mint on demand.
# expect: exit 3
import std::io::fd::{ Fd, stdout }
import std::io::file::{ write_str }

pub const main = (): Iarch -> {
	write_str(stdout(), "fd\n")

	return 3
}
