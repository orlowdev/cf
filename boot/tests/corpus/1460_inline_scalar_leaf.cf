# The pre-emit inliner (M0): scalar leaf helpers — field reads, casts, nested
# inlinable calls, duplicated and dropped parameters — must behave exactly like the
# out-of-line calls they replace.
# expect: exit 164
data P = { Iarch pos, Iarch lim }

const peek = (P p): Iarch -> if p.pos < p.lim then p.pos else -1

const hexv = (Iarch c): Iarch -> if c >= 48 && c <= 57
	then c - 48
	else if c >= 97 && c <= 102 then c - 87 else -1

const masked = (Iarch x, Iarch m): Iarch -> (x & m) | (x >> 8)

const pick = (Bool b, Iarch a, Iarch c): Iarch -> if b then a else c

const doubled = (Iarch x): Iarch -> x + x

const second = (Iarch a, Iarch b): Iarch -> b

pub const main = (): Iarch -> {
	const P p = P({ pos: 53, lim: 60 })
	const Iarch a = peek(p)
	const Iarch n = hexv(peek(p))
	const Iarch b = hexv(102)
	const Iarch c = masked(4660, 255)
	const Iarch d = pick(a < b, 10, 20)
	const Iarch dd = doubled(n)
	const Iarch sv = second(999, 7)

	return a + n + b + c + d + dd + sv
}
