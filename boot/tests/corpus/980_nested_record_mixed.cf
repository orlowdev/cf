# a nested-literal field and a constructor-call field mix in one literal
# expect: exit 12
data V = { Iarch v }
data Pair = { V a, V b }
pub const mk_v = (Iarch n): V -> V({ v: n })

const main_body! = (): Iarch -> {
	const Pair p = { a: { v: 5 }, b: mk_v(7) }
	return p.a.v + p.b.v
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
