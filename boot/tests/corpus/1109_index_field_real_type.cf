# `arr[i].field` yields the field's REAL declared type (here a `Str`, not a word), and a
# `.len` chains off that Str element field.
# expect: exit 5
import "std/mem/arena/growing_arena" as growing_arena
data P = { Iarch n, Str tag }

const main_body! = (): Iarch -> {
	let [P] ps = [P({ n: 1, tag: "ab" }), P({ n: 2, tag: "xyz" })]
	return Iarch(ps[0].tag.len) + Iarch(ps[1].tag.len)
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
