# a float interpolation hole renders via a naive `%f`: `x=1.5` (5 bytes)
# expect: exit 5

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let Float64 x = 1.5
	const Str m = "x=${x}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
