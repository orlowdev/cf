# a tuple-type parameter coexists with a function-type parameter (the `->` disambiguates)
# expect: exit 20
import std::mem::arena::fixed_arena
const apply = ((Iarch) -> Iarch f, (Iarch, Iarch) p): Iarch -> f(p[0]) + p[1]
const dbl = (Iarch n): Iarch -> n * 2

const main_body! = (): Iarch -> apply(dbl, (7, 6))

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
