# a record parameter may be passed on to another function (still by pointer)
# expect: exit 99
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Iarch x }
const inner = (P p): Iarch -> p.x
const outer = (P p): Iarch -> inner(p)

const main_body! = (): Iarch -> {
	let P p = { x: 99 }
	return outer(p)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
