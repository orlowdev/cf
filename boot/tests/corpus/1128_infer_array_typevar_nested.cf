# a type variable inferred to a NESTED array type: `'T = [Iarch]` used as an array element
# (`['T]` return → `[[Iarch]]`) — emit supports nested dynamic arrays, so this compiles
# expect: exit 42
const wrapv = ['T]('T v): ['T] -> [v]
pub const main = (): Iarch -> {
	const [Iarch] xs = [42, 1]
	const [[Iarch]] r = wrapv(xs)
	return r[0][0]
}
