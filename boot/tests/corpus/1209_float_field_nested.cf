# a `Float64` field of a nested record, reached through a field chain `a.b.v` (the `FieldExpr`
# load path). 41 + 1 = 42.
# expect: exit 42
data B = { Float64 v }
data A = { B b, Iarch n }

const main_body! = (): Iarch -> {
	let A a = A({ b: B({ v: 41.5 }), n: 1 })
	return Iarch(a.b.v) + a.n
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
