# Reassigning a mutable `let` aggregate repoints it (cf's parser folds `acc = Expr.Or(acc,
# …)` this way). A `let` union local is rebound to a fresh value; the new value is read back.
# expect: exit 2
import std::mem::arena::fixed_arena
union U = { A(Iarch), B(Iarch) }
const val = (U u): Iarch -> {
	let Iarch r = 0
	match u {
		U.A(x) -> { r = x },
		U.B(y) -> { r = y }
	}
	return r
}

const main_body! = (): Iarch -> {
	let U acc = U.A(9)
	acc = U.B(2)
	return val(acc)
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
