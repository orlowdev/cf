# a record built inside a callee (trapped residue — only a scalar returns)
# expect: exit 6
# args: x y
import "std/mem/arena/fixed_arena" as fixed_arena
data Box = { Iarch lo, Iarch hi }
const span! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 3 }
	return b.hi - b.lo
}

const main_body! = (Iarch argc): Iarch -> span!(argc)

pub const main = (Iarch argc) -> {
	const a = fixed_arena.of(4096)
	return main_body!(argc) in a
}
