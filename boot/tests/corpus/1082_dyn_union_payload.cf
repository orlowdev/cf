# a `[T]` dynamic array may be a union member payload (a boxed 8-byte header pointer, like
# a record/Str payload) — constructed from a `[T]` value, bound in a match arm, indexed
# expect: exit 60
# check: root
union Node = { Block([Iarch]), Leaf(Iarch) }
const sum = (Node n): Iarch -> match n {
	Node.Block(xs) -> {
		let Iarch acc = 0
		let Iarch i = 0
		loop {
			if i >= Iarch(xs.len) then break
			acc = acc + xs[i]
			i = i + 1
		}
		<- acc
	},
	Node.Leaf(v) -> v
}

const main_body! = (): Iarch -> {
	let [Iarch] ys = [10, 20, 30]
	const Node n = Node.Block(ys)
	return sum(n)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
