# comptime `if` over the `::` surface (module_system §6/§7): import the real `std::comptime::os`
# module and read `os::target` (a value-intrinsic `Os`); the darwin (true) branch is taken, and the
# else branch imports a module that does NOT exist — proving the loser is parsed but never resolved.
# expect: exit 7
import std::comptime::os
import std::sys::{ Os }

if os::target == Os.Darwin then import impl_darwin::{ v } else import impl_absent::{ v }

pub const main = (): Iarch -> v
