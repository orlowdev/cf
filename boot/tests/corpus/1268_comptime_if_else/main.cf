# comptime `if`: a false condition (`== Os.Linux`) selects the else branch. The then branch
# imports a module file that does NOT exist — proving the losing branch is never resolved.
# expect: exit 5
import std::comptime::os
import std::sys::{ Os }

if os::target == Os.Linux then import impl_absent::{ V } else import impl_else::{ V }
pub const main = (): Iarch -> V
