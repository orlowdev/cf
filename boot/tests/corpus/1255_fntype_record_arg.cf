# a function type may take a RECORD argument: `(Point) -> Iarch`. `applyp(sumit, {3,4})` = 3+4 = 7.
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
const sumit = (Point p): Iarch -> p.x + p.y
const applyp = ((Point) -> Iarch g, Point q): Iarch -> g(q)

const main_body! = (): Iarch -> applyp(sumit, Point({ x: 3, y: 4 }))

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
