# a `match` arm yields the BOUND PAYLOAD directly (`Shape.Circle(n) -> n`) — an arena-safe alias,
# not a fresh construction. This is the pattern cf's `stmt_expr` extractor needs. inner(sh) pulls
# the Node out of the Square arm (v=7); pick's if selects a bare aggregate var. 7 + 5 = 12.
# expect: exit 12
data Node = { Iarch v }
union Shape = { Circle(Node), Square(Node) }
const inner = (Shape s): Node -> match s {
	Shape.Circle(n) -> n,
	Shape.Square(n) -> n
}
const pick = (Node a, Node b, Iarch c): Node -> if c > 0 then a else b
pub const main = () -> {
	const Shape sh = Shape.Square(Node({ v: 7 }))
	const Node got = inner(sh)
	const Node p = pick(Node({ v: 3 }), Node({ v: 5 }), 0)
	return got.v + p.v
}
