# an array yielded by an `if` expression cannot be passed to a `*[T]` parameter — emit cannot
# classify the opaque header, so it is rejected rather than miscompiled (a follow-up)
# expect: error
const first = (*[Iarch] xs): Iarch -> xs[0]
pub const main = () -> {
	let [2 Iarch] a = [7, 8]
	let [2 Iarch] b = [9, 10]
	return first(if true then a else b)
}
