# A `fixed_buffer` is BOUNDED by the wrapped buffer (committed == limit, kind 0), so an allocation
# past its end is a hard trap — the same cf_oom (70) a fixed arena fires (1300). Here `fill!` asks
# for an 8 KiB block inside a 4 KiB fixed_buffer, so the bump overruns the buffer and traps. This
# also proves the buffer's static size threads to the geometry: an unbounded wrap would not trap.
# expect: exit 70
const fill! = (Iarch k): Iarch -> {
	let [8192 Uint8] big
	return k
}
const run! = (Iarch n): Iarch -> {
	let [4096 Uint8] scratch
	const fb = mem.fixed_buffer.of(scratch)
	return fill!(n) in fb
}
pub const main = () -> {
	const a = mem.arena.grow(65536)
	return run!(5) in a
}
