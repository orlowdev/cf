# itoa content: "${n}" with n=42 -> "42"; m[0] is '4' (ASCII 52)
# expect: exit 52

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let Iarch n = 42
	const Str m = "${n}"
	return Iarch(m[0])
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
