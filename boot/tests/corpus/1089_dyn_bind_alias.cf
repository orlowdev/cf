# a `[T]` local may BIND (alias) an existing `[T]` parameter, then grow it — the
# list-concat idiom cf's module resolver leans on (`let out = dst; out = [...out, e]`).
# expect: exit 6
const cat = ([Iarch] dst, [Iarch] src): [Iarch] -> {
	let [Iarch] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}

const main_body! = (): Iarch -> {
	let [Iarch] a = [1, 2]
	let [Iarch] b = [3]
	const [Iarch] c = cat(a, b)
	return Iarch(c.len) + c[2]
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
