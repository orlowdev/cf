# region-outlives permits handing `&local` DOWN to a callee — the callee is shorter-lived than the
# local (the tree invariant), so the pointer never outlives its target.
# expect: exit 42
data Point = { Iarch x }
const rd = (*Point p): Iarch -> p.x
const use = (): Iarch -> {
	let Point local = { x: 42 }
	return rd(&local)
}
pub const main = () -> use()
