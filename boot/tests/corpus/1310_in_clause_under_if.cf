# An `in <arena>` clause grafts a geometry onto a statement guarded by `if … then`, not only a
# top-level const/return/call. Here the allocating call `span!(7)` runs `in a` inside the `then`
# arm of an `if`; the parser must carry the `in` clause through the guard and emit the grafted node.
# span! traps a Box (only the scalar hi - lo = 28 - 7 = 21 leaves), so main stays root-clean.
# expect: exit 21
data Box = { Iarch lo, Iarch hi }
const span! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 4 }
	return b.hi - b.lo
}
pub const main = () -> {
	const a = mem.arena.of(4096)
	let Iarch r = 0
	if true then r = span!(7) in a
	return r
}
