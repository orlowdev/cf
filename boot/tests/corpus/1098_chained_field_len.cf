# chained field access: a record's [T] field's .len, and a record's Str field's .len
# expect: exit 5
# check: root
data R = { [Iarch] xs, Str name }

const main_body! = (): Iarch -> {
	let [Iarch] a = [1, 2, 3]
	const R r = R({ xs: a, name: "hi" })
	return Iarch(r.xs.len) + Iarch(r.name.len)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
