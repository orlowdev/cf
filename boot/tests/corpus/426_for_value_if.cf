# count even elements with a value-if in the body
# expect: exit 3

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [6 Iarch] xs = [1, 2, 3, 4, 5, 6]
	let Iarch evens = 0
	for x in xs {
		evens += if x % 2 == 0 then 1 else 0
	}
	return evens
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
