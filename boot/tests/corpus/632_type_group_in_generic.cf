# a grouped-params `type` splats inside a generic function alongside a `'T` parameter;
# the group literal desugars before monomorphization, so generics + groups compose.
# expect: exit 30
type G = { Iarch a, Iarch b }
const f = ['T](G g, 'T x): Iarch -> a + b
pub const main = () -> f({ a: 10, b: 20 }, 99)
