# a negative float leads with `-`: `-0.25`, so m[0] is ASCII 45
# expect: exit 45

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let Float64 x = -0.25
	const Str m = "${x}"
	return Iarch(m[0])
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
