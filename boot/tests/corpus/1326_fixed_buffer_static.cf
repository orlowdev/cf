# `fixed_buffer.of(buf)` wraps a caller `[Uint8]` buffer as a bounded bump geometry — the last
# bump-family member (§5), and the no-heap embedded allocator. Here it wraps a `static` BSS pool and
# `span!` allocates its `Box` INTO the pool (no heap, no arena carve); only the scalar 28-7=21 leaves.
# The buffer carries its own length, so nothing is passed but the buffer.
# expect: exit 21
import "std/mem/fixed_buffer" as fixed_buffer
data Box = { Iarch lo, Iarch hi }
const span! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 4 }
	return b.hi - b.lo
}
static [4096 Uint8] pool
pub const main = () -> {
	const fb = fixed_buffer.of(pool)
	return span!(7) in fb
}
