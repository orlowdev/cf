# The `in <geometry>` clause attaches ONLY at a call site (memory_model §4). A record
# literal has no geom slot; the clause used to be consumed and silently DROPPED — the
# allocation fell back to the ambient node while the source read as if it went to `b`.
# Now a loud parse error.
# expect: error
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
const run! = (): Iarch -> {
	const b = fixed_arena.of(4096)
	const Point p = Point({ x: 40, y: 2 }) in b
	return p.x + p.y
}
pub const main = () -> {
	const a = fixed_arena.of(65536)
	return run!() in a
}
