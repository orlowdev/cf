# a nested member guard reads the tag of a BOXED (payload-carrying) union field
# expect: exit 62
union Inner = { Circle, Square, Sized(Iarch) }
union Outer = { Box(Inner, Iarch) }
pub const f = (Outer o): Iarch -> match o {
	Outer.Box(Circle, k) -> k,
	Outer.Box(Square, k) -> k * 2,
	_ -> 0,
}

const main_body! = (): Iarch -> {
	const Outer x = Outer.Box(Inner.Circle, 42)
	const Outer y = Outer.Box(Inner.Square, 10)
	return f(x) + f(y)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
