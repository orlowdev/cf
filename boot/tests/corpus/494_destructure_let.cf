# a `let` pattern binds reassignable Iarch positions (a value copy, sound)
# expect: exit 9

import "std/mem/arena/fixed_arena" as fixed_arena
const main_body! = (): Iarch -> {
	let (a, b) = (3, 4)
	a = a + 2
	return a + b
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
