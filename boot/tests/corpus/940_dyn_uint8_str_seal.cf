# build a `[Uint8]` byte vector, seal to a Str with `Str(xs)`, write to stdout
# (the string-builder finish — the QBE-emitter payoff). exit = bytes written.
# expect: exit 4
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Iarch -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const write = (Uarch fd, *[Uint8] buf, Uarch n): Iarch -> syscall6(4, fd, buf, n, 0, 0, 0)

const main_body! = (): Iarch -> {
	let [Uint8] bytes = []
	bytes = [...bytes, 72]
	bytes = [...bytes, 105]
	bytes = [...bytes, 33]
	bytes = [...bytes, 10]
	bytes[2] = 46
	const Str s = Str(bytes)
	return write(Uarch(1), s.bytes, Uarch(s.len))
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
