# a `Unit`-payload union flows through a parameter and matches
# expect: exit 8
import "std/mem/arena/fixed_arena" as fixed_arena
union U = { Wrap(Unit), Empty }
const pick = (U v): Iarch -> match v {
	U.Wrap(x) -> 8,
	U.Empty -> 1,
}

const main_body! = (): Iarch -> pick(U.Wrap(()))

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
