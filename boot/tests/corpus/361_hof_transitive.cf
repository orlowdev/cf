# A HOF that passes its function parameter to another HOF: the capture threads
# through both specializations (the fake-closure fixpoint). relay -> apply -> addbase.
# expect: exit 42
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const relay = ((Iarch) -> Iarch g, Iarch y): Iarch -> apply(g, y)
const run = (): Iarch -> {
	let Iarch base = 40
	const addbase = (Iarch k): Iarch -> base + k
	return relay(addbase, 2)
}
pub const main = () -> run()
