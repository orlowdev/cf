# The survivor-mark mint gate: a callee-minted arena handle rides out as a plain WORD, so a
# caller's survivor loop mark would free the child's storage at the back-edge — the second
# iteration's carve then lands at the SAME address and the two "distinct" arenas silently
# alias (h == h2 read 99 before the fix). The transitive fmints bit refuses the marks.
# expect: exit 42
data Box = { Iarch v }
const mk = (): Iarch -> {
	const b = mem.arena.of(4096)
	return b
}
const put = (Iarch n): Box -> Box({ v: n })
const eat! = (Iarch k): Iarch -> {
	let [2500 Uint8] buf
	return k
}
const run! = (): Iarch -> {
	let [Iarch] junk = [1]
	let Iarch h = 0
	let Iarch h2 = 0
	let Iarch i = 0
	loop {
		if i >= 2 then break
		if i == 0 then h = mk()
		if i == 1 then h2 = mk()
		i = i + 1
	}
	if h == h2 then return 99
	const Iarch r1 = eat!(20) in h
	const Iarch r2 = eat!(22) in h2
	return r1 + r2 + junk[0] - 1
}
pub const main = () -> {
	const a = mem.arena.of(65536)
	return run!() in a
}
