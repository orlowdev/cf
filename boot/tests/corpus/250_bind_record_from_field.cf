# a record local may bind (alias) a record-typed field — a read-only borrow of the
# field's arena storage, no explicit copy (M0)
# expect: exit 1
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
data Line = { Point a, Point b }
const mk = (Iarch x, Iarch y): Point -> {
	const Point p = { x: x, y: y }
	return p
}

const main_body! = (): Iarch -> {
	const Line l = { a: mk(1, 2), b: mk(3, 4) }
	const Point q = l.a
	return q.x
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
