# a `Float32` record field (QBE `s`, `stores`/`loads`). Its value is built with an explicit
# `Float32(...)` cast, as Float32 always is (a bare literal is Float64). 3.5 + 6.5 = 10.
# expect: exit 10
data Q = { Float32 a, Float32 b }

const main_body! = (): Iarch -> {
	const Q q = Q({ a: Float32(3.5), b: Float32(6.5) })
	return Iarch(q.a + q.b)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
