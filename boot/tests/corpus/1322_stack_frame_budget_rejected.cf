# A function's TOTAL `$`-stack use is capped (256 KiB per frame), so many small stack bindings can't
# blow the frame either. Five ~60 KB buffers exceed the budget and are rejected — move some scratch
# into a geometry.
# expect: error
const work = (): Iarch -> {
	let [60000 Uint8] $a
	let [60000 Uint8] $b
	let [60000 Uint8] $c
	let [60000 Uint8] $d
	let [60000 Uint8] $e
	return Iarch($a.len)
}
pub const main = () -> work()
