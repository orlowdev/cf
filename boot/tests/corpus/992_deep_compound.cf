# compound assignment reaches a DEEP field target: `p.a.v += 9` reads-then-writes through the chain
# expect: exit 10
import std::mem::arena::fixed_arena
data V = { Iarch v }
data P = { V a }

const main_body! = (): Iarch -> {
	let P p = { a: { v: 1 } }
	p.a.v += 9
	return p.a.v
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
