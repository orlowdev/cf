# a spread copies a tag-only union field (a word tag, not just Iarch)
# expect: exit 109
union Color = { Red, Green, Blue }
data Cell = { Iarch n, Color c }
pub const main = () -> {
	const Cell base = { n: 5, c: Color.Green }
	const Cell up = { ...base, n: 9 }
	return up.n + (match up.c {
		Color.Red -> 0,
		Color.Green -> 100,
		Color.Blue -> 200,
	})
}
