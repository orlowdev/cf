# a TAG-ONLY union member (`Flag.On`, a bare tag word, not a `UnionMk`) is a fresh construction, so
# it is a valid tuple element. 40 + 5 = 45.
# expect: exit 45
import "std/mem/arena/fixed_arena" as fixed_arena
union Flag = { On, Off }

const main_body! = (): Iarch -> {
	const t = (Flag.On, 5)
	return match t[0] { Flag.On -> 40, Flag.Off -> 0 } + t[1]
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
