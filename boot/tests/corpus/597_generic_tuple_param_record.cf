# a `'T` tuple-parameter element instantiated at a record is indexed and field-accessed
# expect: exit 20
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
const px = ['T]((Iarch, 'T) p): Iarch -> p[0]

const main_body! = (): Iarch -> px[Point]((20, Point({ x: 1, y: 2 })))

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
