# a `*[Iarch]` param inside a generic function (is_words survives monomorphization)
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
const first_or = ['T](*[Iarch] xs, 'T tag): Iarch -> xs[0]

const main_body! = (): Iarch -> {
	let [2 Iarch] a = [42, 0]
	return first_or[Iarch](a, 5)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
