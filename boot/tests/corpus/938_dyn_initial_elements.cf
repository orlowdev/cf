# a `[T]` bound to an initial literal, then grown further
# expect: exit 60

const main_body! = (): Iarch -> {
	let [Iarch] xs = [10, 20]
	xs = [...xs, 30]
	let Iarch acc = 0
	for x in xs {
		acc = acc + x
	}
	return acc
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
