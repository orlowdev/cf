# a member mixing a scalar/Str payload with a `[T]` payload (`Call(Str, [Iarch])`) — cf's
# Call/UnionMk shape
# expect: exit 32
union Node = { Call(Str, [Iarch]), Nil }
const run = (Node n): Iarch -> match n {
	Node.Call(name, args) -> {
		let Iarch acc = name.len
		let Iarch i = 0
		loop {
			if i >= Iarch(args.len) then break
			acc = acc + args[i]
			i = i + 1
		}
		<- acc
	},
	Node.Nil -> 0
}
pub const main = () -> {
	let [Iarch] a = [10, 20]
	const Node n = Node.Call("hi", a)
	return run(n)
}
