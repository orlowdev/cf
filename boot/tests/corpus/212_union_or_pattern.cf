# an or-pattern `A | B` matches any listed member; two arms cover all 7 members
# expect: exit 10
union Day = { Mon, Tue, Wed, Thu, Fri, Sat, Sun }
pub const kind = (Day d): Iarch -> match d {
	Day.Sat | Day.Sun -> 0,
	Day.Mon | Day.Tue | Day.Wed | Day.Thu | Day.Fri -> 1,
}
pub const main = () -> {
	const Day a = Day.Sun
	const Day b = Day.Wed
	return kind(a) + kind(b) * 10
}
