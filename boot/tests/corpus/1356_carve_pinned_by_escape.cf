# The tightening's dangle detector: an `in b` call with an AGGREGATE return hands out a
# pointer into b's node, so returning it pins `b` (the geom-channel rule) and the carve
# stays SURVIVOR-side — make!'s frame bracket must not free it. The post-return scratch
# buffer would clobber p/q if the carve were misrouted.
# expect: exit 42
import std::mem::arena::fixed_arena
import std::mem::arena::growing_arena
data P = { Iarch v }
const mkp! = (Iarch k): P -> {
	let [Iarch] junk = [k, k]
	return P({ v: k + junk[0] })
}
const make! = (Iarch k): P -> {
	const b = fixed_arena::of(4096)
	return mkp!(k) in b
}
const main_body! = (): Iarch -> {
	const P p = make!(10)
	const P q = make!(11)
	let [4096 Uint8] pad
	return p.v + q.v + Iarch(pad[0])
}
pub const main = () -> {
	const a = growing_arena::of(65536)
	return main_body!() in a
}
