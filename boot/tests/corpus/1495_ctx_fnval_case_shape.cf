# The full case! shape in user code (testing.md §3): provide piped over of__te with a deferred
# reporting teardown, the body pinned by `cb() in ta` — INERT here (the specialized callee is
# colorless; memory_model §6 node side). One pass + one mismatch -> exit 1.
# expect: exit 1
import std::mem::arena::fixed_arena
import std::mem::arena::test_arena
import std::mem::ctx
import std::test::{ Verdicts, equals }

const val = (Iarch x): Iarch -> x

const body1 = (): () -> {
	val(1) |> equals(1)
	val(1) |> equals(2)
}

const case2! = (Str desc, () -> () cb): Uarch -> {
	let Verdicts vd = { desc: desc, count: 0, fails: 0 }
	const ta = test_arena::of(65536)
		|> std::mem::ctx::provide(let vd)
		|> defer test_arena::destroy
	cb() in ta
	return vd.fails
}

const main_body! = (): Uarch -> case2!("probe2", body1)

pub const main = () -> {
	const a = fixed_arena::of(1048576)
	const Uarch f = main_body!() in a
	return Iarch(f)
}
