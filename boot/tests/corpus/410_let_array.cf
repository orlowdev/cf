# a `let` array is now allowed — its elements are mutable (element-assign brick)
# expect: exit 6

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	let [3 Iarch] xs = [1, 2, 3]
	return xs[0] + xs[1] + xs[2]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
