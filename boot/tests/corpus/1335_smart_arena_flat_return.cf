# Smart arena (on_ret / on_alloc_ret, geometry_lowering §3): a flat-record `!` frame RESETS at exit,
# reclaiming its own trapped scratch (`junk`), while the returned record survives — the caller claims
# it (`cf_claim`) across the reset→claim window, whose no-allocation rule keeps the return's bytes
# intact. Only the return leaves the frame; the scratch dies with it. Verifies the reset+claim pair.
# expect: exit 21
data Pair = { Iarch a, Iarch b }
const build! = (Iarch n): Pair -> {
	const Pair junk = { a: 9, b: 9 }
	const Pair r = { a: n, b: n * 4 }
	return r
}
pub const main = () -> {
	const a = mem.arena.grow(4096)
	const p = build!(7) in a
	return p.b - p.a
}
