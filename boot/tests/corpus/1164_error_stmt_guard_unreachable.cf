# a statement guarded arm after an earlier unguarded arm already fully covered its
# member is unreachable
# expect: error
union M = { A(Iarch), B }
const f = (M m): Iarch -> {
	let Iarch a = 0
	match m { M.A(n) -> { a = n }, M.A(0) -> { a = 1 }, M.B -> { a = 2 } }
	return a
}
pub const main = () -> f(M.B)
