# §8.2 union→superunion subtyping: a sub-union satisfies a bound naming its super-union.
# `Big` splices `Small`'s members by spread, so `Small <: Big` and `f[Small]` is accepted;
# 'T = Small threads through the `'T` return and is matched at the concrete call site.
# expect: exit 2
union Small = { Red, Green }
union Big = { ...Small, Blue }
pub const f = [Big 'T]('T x): 'T -> x
pub const main = () -> {
	const Small s = f[Small](Small.Green)
	return match s { Small.Red -> 1, Small.Green -> 2 }
}
