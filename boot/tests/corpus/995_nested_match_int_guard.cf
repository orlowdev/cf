# an integer sub-pattern guards a payload field; a miss falls through to a
# later arm for the same tag (which fully covers it, so no `_` is needed)
# expect: exit 111
union M = { A(Iarch), B }
pub const f = (M m): Iarch -> match m {
	M.A(0) -> 99,
	M.A(n) -> n,
	M.B -> 7,
}
pub const main = () -> f(M.A(0)) + f(M.A(5)) + f(M.B)
