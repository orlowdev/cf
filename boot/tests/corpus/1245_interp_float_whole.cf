# a whole-valued float trims trailing zeros but keeps one fractional digit: `2.0` (3 bytes)
# expect: exit 3

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let Float64 x = 2.0
	const Str m = "${x}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
