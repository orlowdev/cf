# a whole-valued float trims trailing zeros but keeps one fractional digit: `2.0` (3 bytes)
# expect: exit 3

# check: root
const main_body! = (): Iarch -> {
	let Float64 x = 2.0
	const Str m = "${x}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
