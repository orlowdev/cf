# A `!` consumer (it allocates residue) that ALSO consumes context, run under a geometry (`in a`):
# it receives BOTH hidden arguments — the ambient node AND the context pointer — and is materialized
# under the arena like any allocating function (context.md §1: `!` and `uses` are orthogonal colors).
# expect: exit 42
import std::mem::arena::growing_arena
import std::mem::ctx

data Cfg = { Iarch n }

pub const build! = (): Iarch uses Cfg -> {
	const c = std::mem::ctx::consume(Cfg)
	const [Iarch] xs = [c.n, c.n]

	return xs[0] + xs[1]
}

pub const main = () -> {
	const Cfg cfg = { n: 21 }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(cfg)

	return build!() in a
}
