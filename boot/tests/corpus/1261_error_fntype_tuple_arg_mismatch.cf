# A function passed to a tuple-component function-type parameter must match the tuple signature
# nominally: `sumit` takes `(Iarch, Iarch)` but the parameter expects `(Str, Iarch)`, so the
# argument is rejected.
# expect: error
const sumit = ((Iarch, Iarch) t): Iarch -> t[0] + t[1]
const apply = (((Str, Iarch)) -> Iarch f, (Str, Iarch) q): Iarch -> f(q)
pub const main = () -> apply(sumit, ("x", 3))
