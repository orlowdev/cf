# nested `for` loops with distinct loop variables
# expect: exit 45

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [2 Iarch] xs = [2, 3]
	const [2 Iarch] ys = [4, 5]
	let Iarch acc = 0
	for a in xs {
		for b in ys {
			acc += a * b
		}
	}
	return acc
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
