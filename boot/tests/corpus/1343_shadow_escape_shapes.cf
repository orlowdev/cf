# The duplex-router escape shapes the `!`-oracle cannot see (red-team probes p1/p2/p4/p10):
# a call returning its argument, an escaping projection, a for-variable flowing to the
# return, and a store through a forward alias of a *T param. All four values must be
# classified SURVIVOR by the shadow routing pass (routing.cf) — this test pins the running
# behavior so the Stage-2 codegen flip turns any misrouting into a visible failure here.
# expect: exit 18
import std::mem::arena::growing_arena
data P = { Iarch v }
data Big = { P inner }
const id = (P p): P -> p
# p1: call-arg aliasing — t must escape
const c1! = (): P -> {
	const P t = P({ v: 3 })
	return id(t)
}
# p2: projection — o must escape
const c2! = (): P -> {
	const Big o = Big({ inner: P({ v: 7 }) })
	return o.inner
}
# p10: forward alias — q must be a target (fwd)
const c3! = (*Big gg): Iarch -> {
	const P scr = P({ v: 1 })
	const q = gg.inner
	return q.v + scr.v
}
# p4: ForIn — r escaping must pin xs
const c4! = (): P -> {
	let [P] xs = [P({ v: 5 })]
	let P r = P({ v: 0 })
	for x in xs {
		r = x
	}
	return r
}
const main_body! = (): Iarch -> {
	let Big b = Big({ inner: P({ v: 2 }) })
	const Iarch z = c3!(&b)
	const P a1 = c1!()
	const P a2 = c2!()
	const P a4 = c4!()
	return a1.v + a2.v + a4.v + z
}
pub const main = () -> {
	const a = growing_arena::of(8192)
	return main_body!() in a
}
