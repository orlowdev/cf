# Indexing a general expression base: `r.xs[i]` rides a `[i]` on a field read, not a bare
# name (the `p.toks[p.pos]` shape cf's own parser needs). The index is itself an
# expression (a variable, and an arithmetic form).
# expect: exit 8
import "std/mem/arena/fixed_arena" as fixed_arena
data R = { [Iarch] xs }

const main_body! = (): Iarch -> {
	let [Iarch] a = [3, 4, 5]
	const R r = R({ xs: a })
	const Iarch i = 2
	return r.xs[i] + r.xs[i - 2]
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
