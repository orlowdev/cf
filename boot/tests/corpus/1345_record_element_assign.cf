# In-place REPLACEMENT of a record element: `ps[i] = P({…})` stores the new record's 8-byte
# arena pointer into the slot (the same store a spread-append does) — was rejected as "an
# array element must be an integer" (the genesis stub test 411 called it "not supported yet").
# expect: exit 11
data P = { Iarch v }
const main_body! = (): Iarch -> {
	let [P] ps = [P({ v: 1 }), P({ v: 2 })]
	ps[0] = P({ v: 9 })
	return ps[0].v + ps[1].v
}
pub const main = () -> {
	const a = mem.arena.grow(8192)
	return main_body!() in a
}
