# the bare-literal default is now Iarch (64-bit): 2e9 + 2e9 = 4e9 stays positive, so it is
# greater than 2e9. A 32-bit default would wrap negative and the comparison would be 0.
# (Literals are capped at INT32_MAX, so the large value is built by addition.)
# expect: exit 1
pub const main = () -> {
	const x = 2000000000 + 2000000000
	return if x > 2000000000 then 1 else 0
}
