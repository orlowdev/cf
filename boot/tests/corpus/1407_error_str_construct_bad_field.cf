# a `Str` literal must set exactly `bytes` (a byte pointer/array) and `len` (an integer). Here `bytes`
# is given an integer, which is neither a pointer nor an array — rejected.
# expect: error
import std::mem::arena::growing_arena

const run! = (): Iarch -> {
	const Str s = Str({ bytes: 5, len: 3 })

	return Iarch(s.len)
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return run!() in a
}
