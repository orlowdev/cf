# a `*[T]` raw-pointer parameter accepts an array LITERAL argument directly (not just a bare
# variable) — its element base (data@0) is passed, the callee indexes it
# expect: exit 100
const sum = (*[Iarch] xs, Iarch n): Iarch -> {
	let s = 0
	let i = 0
	loop {
		if i >= n then break
		s = s + xs[i]
		i = i + 1
	}
	return s
}

const main_body! = (): Iarch -> sum([10, 20, 30, 40], 4)

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
