# a bare generic union member construction infers its type arg from the payload
# (`Maybe.Just(5)` — no explicit `Maybe[Iarch]` needed)
# expect: exit 5
union Maybe['T] = { Just('T), Nothing }
const unbox = ['T](Maybe['T] m, 'T dflt): 'T -> match m {
	Maybe.Just(x) -> x,
	Maybe.Nothing -> dflt,
}
pub const main = () -> {
	const Maybe[Iarch] m = Maybe.Just(5)
	return unbox(m, 0)
}
