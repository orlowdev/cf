# the `'T` tuple element may be instantiated at `Unit`
# expect: exit 12
import std::mem::arena::fixed_arena
data Box['T] = { (Iarch, 'T) p }

const main_body! = (): Iarch -> {
	const Box[Unit] b = { p: (12, ()) }
	return b.p[0]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
