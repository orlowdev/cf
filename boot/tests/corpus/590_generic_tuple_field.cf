# a generic record may have a tuple field with a `'T` element, substituted per instantiation
# expect: exit 30
# check: root
data Box['T] = { (Iarch, 'T) p }

const main_body! = (): Iarch -> {
	const Box[Iarch] b = { p: (10, 20) }
	return b.p[0] + b.p[1]
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
