# a `[Bool]` element assigned in place (`xs[0] = true`) and read; `.len` reads the header length.
# expect: exit 10

import "std/mem/arena/fixed_arena" as fixed_arena
const main_body! = (): Iarch -> {
	let [Bool] xs = [false, false]
	xs[0] = true
	return if xs[0] then Iarch(xs.len) + 8 else 0
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
