# the `!` allocation algebra (memory_model §5): a function holding residue that lives and dies in
# its own frame is correctly marked `!`. `p` is trapped (only the scalar `p.x` leaves).
# expect: exit 7
import std::mem::arena::fixed_arena
data Point = { Iarch x, Iarch y }
const alloc! = (): Iarch -> {
	const Point p = { x: 7, y: 9 }
	return p.x
}
pub const main = () -> {
	const a = fixed_arena::of(4096)
	return alloc!() in a
}
