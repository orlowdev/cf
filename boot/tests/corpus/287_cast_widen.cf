# an explicit widening cast `Uarch(Iarch)` (type_system §4: the cast is the constructor
# call `T(x)`); a widen is exact. Pass it to a Uarch-taking identity and narrow back.
# expect: exit 7
pub const id = (Uarch x): Uarch -> x
pub const main = () -> {
	const Iarch n = 7
	return Iarch(id(Uarch(n)))
}
