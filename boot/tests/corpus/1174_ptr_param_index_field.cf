# a `*[T]` parameter accepts an indexed element's field (`bs[1].items`, an `IndexField`) — the
# array field's data pointer is passed
# expect: exit 100
import std::mem::arena::growing_arena
data Bag = { [Iarch] items }
const sum = (*[Iarch] xs, Iarch n): Iarch -> {
	let s = 0
	let i = 0
	loop {
		if i >= n then break
		s = s + xs[i]
		i = i + 1
	}
	return s
}

const main_body! = (): Iarch -> {
	let Bag b0 = Bag({ items: [1, 1, 1] })
	let Bag b1 = Bag({ items: [10, 30, 60] })
	let [Bag] bs = [b0, b1]
	return sum(bs[1].items, 3)
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
