# The pull-vs-bracket interlock refuses a carve whose geom uses sit in a loop the carve is
# NOT inside: a pull there would land above the loop mark and be freed at the back-edge
# while the child lives. The carve stays survivor — chunks accumulate to a clean oom (70),
# never a dangle.
# expect: exit 70
import std::mem::arena::fixed_arena
import std::mem::arena::growing_arena
data Acc = { Iarch n }
const work! = (Iarch k): Iarch -> {
	let [Iarch] xs = []
	let Iarch i = 0
	loop {
		if i >= 4000 then break
		xs = [...xs, i]
		i = i + 1
	}
	return xs[k]
}
const bump = (*Acc a): Iarch -> {
	a.n = a.n + 1
	return 0
}
const run! = (Iarch n): Iarch -> {
	let Acc acc = Acc({ n: 0 })
	const b = growing_arena::of(4096)
	let Iarch s = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const Iarch w = work!(2) in b
		s = s + w
		bump(&acc)
		i = i + 1
	}
	return s / n + 40
}
pub const main = () -> {
	const a = fixed_arena::of(262144)
	return run!(200) in a
}
