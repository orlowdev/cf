# A `fixed_buffer` over a `$buf` STACK buffer is a frame-local bump allocator — no heap and no
# geometry carve. `run!` wraps a 4 KiB stack buffer and `span!` allocates its Box into it; only the
# scalar result leaves (a `$`-backed buffer's residue must not escape, so aggregates stay inside).
# expect: exit 21
import std::mem::arena::growing_arena
import std::mem::fixed_buffer
data Box = { Iarch lo, Iarch hi }
const span! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 4 }
	return b.hi - b.lo
}
const run! = (Iarch n): Iarch -> {
	let [4096 Uint8] $buf
	const fb = fixed_buffer::of($buf)
	return span!(n) in fb
}
pub const main = () -> {
	const a = growing_arena::of(65536)
	return run!(7) in a
}
