# A labeled `break` crossing loop scopes fires every pending `defer` of the scopes it exits —
# the inner loop's AND the labeled loop's own — before the jump. Three outer iterations (the
# last cut short by `break outer`) fire the outer defer 3 times and the inner defer 3 times:
# 3*10 + 3 + 9 = 42.
# expect: exit 42
const run = (*[Uint8] log): Iarch -> {
	let Iarch n = 0

	loop outer {
		defer { log[0] = Uint8(Iarch(log[0]) + 1) }

		loop {
			defer { log[1] = Uint8(Iarch(log[1]) + 10) }

			n = n + 1
			if n >= 3 then break outer
			break
		}
	}

	return Iarch(log[1]) + Iarch(log[0]) + n * 3
}

pub const main = () -> {
	let [8 Uint8] log
	log[0] = Uint8(0)
	log[1] = Uint8(0)

	return run(log)
}
