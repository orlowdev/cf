# early return inside a loop, coexisting with the compact `if c then break` guard
# expect: exit 5
pub const find = (Iarch target): Iarch -> {
	let Iarch i = 0
	loop {
		if i == target then return i * 10
		if i > 20 then break
		i = i + 1
	}
	return 999
}
pub const main = () -> {
	let Iarch acc = find(3) + find(50)
	return acc % 256
}
