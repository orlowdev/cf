# statement-`if` early return (no else), a block branch, and the trailing return
# expect: exit 135
pub const classify = (Iarch n): Iarch -> {
	if n < 0 then return 100
	if n == 0 then return 200
	if n > 100 then {
		let Iarch big = n - 100
		return 44 + big
	}
	return n
}
pub const main = () -> {
	let Iarch acc = 0
	acc = acc + classify(-5)
	acc = acc + classify(0)
	acc = acc + classify(105)
	acc = acc + classify(42)
	return acc % 256
}
