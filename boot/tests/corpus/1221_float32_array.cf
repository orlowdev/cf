# a `[Float32]` array (QBE `s`, `stores`/`loads`), elements built with an explicit `Float32(...)` cast.
# expect: exit 10

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [Float32] xs = [Float32(3.5), Float32(6.5)]
	return Iarch(xs[0] + xs[1])
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
