# A `*Point` pointer LOCAL — a named reference built with `&`. Passed to a `*Point` param,
# to a by-value `Point` param (deref), and read via field access.
# expect: exit 8
data Point = { Iarch x, Iarch y }
const use = (*Point p): Iarch -> p.x + p.y
pub const main = () -> {
	const Point q = { x: 3, y: 5 }
	const *Point p = &q
	return use(p) + p.x - q.x
}
