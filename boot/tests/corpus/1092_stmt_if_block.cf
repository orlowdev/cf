# statement-position `if` with `{ block }` bodies: a fall-through then-block, and an
# if/else where both blocks return (terminal, no trailing return needed).
# expect: exit 23
const classify = (Iarch n): Iarch -> {
	if n < 0 then {
		const Iarch a = 0 - n
		return a + 100
	} else {
		let Iarch acc = 0
		acc = acc + n
		acc = acc + 3
		return acc
	}
}
pub const main = () -> {
	let Iarch total = 0
	if total == 0 then {
		total = total + classify(20)
	}
	return total
}
