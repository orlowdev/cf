# Stage 4, arena split: `fixed_arena.of` (FIXED) and `growing_arena.of` (ELASTIC) are now two
# separate monomorphic geometries. One `run!`/`make!` reachable under both mints a `__fx` AND a
# `__el` twin — `run!__fx` lowers through fixed_arena's reserves (survivor bumps up toward the
# residue cursor, no kind test) and `run!__el` through elastic_arena's (survivor bumps within
# its block, pulls on overflow, no kind test). The two ambients compute independently; a wrong
# tag split (one twin lowered to the other's reserves) would trap or dangle and break the sum.
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
import "std/mem/arena/growing_arena" as growing_arena
data Box = { Iarch lo, Iarch hi }
const make! = (Iarch n): Box -> {
	const Box junk = Box({ lo: n, hi: n + 2 })
	return Box({ lo: n + junk.hi - junk.lo - 2, hi: n * 3 })
}
const run! = (Iarch n): Iarch -> {
	const Box kept = make!(n)
	return kept.hi - kept.lo
}
pub const main = () -> {
	const fx = fixed_arena.of(2048)
	const el = growing_arena.of(256)
	const Iarch a = run!(7) in fx
	const Iarch b = run!(14) in el
	return a + b
}
