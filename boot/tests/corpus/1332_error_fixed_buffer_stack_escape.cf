# A `fixed_buffer` over a `$buf` STACK buffer is frame-local: aggregates allocated into it live in
# that buffer and die when the frame pops. Returning such an aggregate (`make(n) in fb`, an AGGREGATE
# result) dangles — rejected. (The same program over a `static` pool is fine — see 1334; a SCALAR
# result copies out and is fine — see 1328.)
# expect: error
import "std/mem/arena/growing_arena" as growing_arena
import "std/mem/fixed_buffer" as fixed_buffer
data Box = { Iarch lo, Iarch hi }
const make = (Iarch n): Box -> {
	const Box b = { lo: n, hi: n * 4 }
	return b
}
const run = (Iarch n): Box -> {
	let [4096 Uint8] $buf
	const fb = fixed_buffer.of($buf)
	return make(n) in fb
}
pub const main = () -> {
	const a = growing_arena.of(65536)
	const r = run(7) in a
	return r.hi - r.lo
}
