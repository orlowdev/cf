# a tuple parameter is passed by pointer and indexed at comptime positions
# expect: exit 30
# check: root
const addp = ((Iarch, Iarch) p): Iarch -> p[0] + p[1]

const main_body! = (): Iarch -> {
	const t = (10, 20)
	return addp(t) + addp((0, 0))
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
