# A `fixed_buffer` is BOUNDED by the wrapped buffer (committed == limit, kind 0), so an allocation
# past its end is a hard trap. Here a 1 MiB buffer is requested inside a 4 KiB fixed_buffer pool, so
# the bump overruns and fires cf_oom (70) — proving allocation is drawn from the buffer, not the page.
# expect: exit 70
const fill! = (Iarch k): Iarch -> {
	let [1048576 Uint8] big
	return k
}
static [4096 Uint8] pool
pub const main = () -> {
	const fb = mem.fixed_buffer.of(pool)
	return fill!(5) in fb
}
