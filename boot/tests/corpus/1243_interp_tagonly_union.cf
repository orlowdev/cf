# a TOP-LEVEL tag-only union hole renders the FULL path `Color.Green`, not just `Green` (11 bytes)
# expect: exit 11
union Color = { Red, Green, Blue }

const main_body! = (): Iarch -> {
	const Color c = Color.Green
	const Str m = "${c}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
