# a `...src` spread splices a tuple's elements, then explicit elements follow
# expect: exit 10

# check: root
const main_body! = (): Iarch -> {
	const t = (1, 2, 3)
	const u = (...t, 4)
	return u[0] + u[1] + u[2] + u[3]
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
