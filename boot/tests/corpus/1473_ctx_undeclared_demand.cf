# A `pub` function consumes a context type but does not declare it with a `uses` clause — the
# demand is part of the ABI contract at a module boundary and must be written (context.md §4).
# expect: error
import std::mem::arena::growing_arena
import std::mem::ctx

data Cfg = { Str host }

pub const use_it = (): Str -> {
	const c = std::mem::ctx::consume(Cfg)

	return c.host
}

pub const main = () -> {
	const Cfg cfg = { host: "h" }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(cfg)
	const Str h = use_it()

	return Iarch(h.len)
}
