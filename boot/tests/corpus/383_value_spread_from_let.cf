# the spread source may be a `let` record (its fields are read, not moved)
# expect: exit 7
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	let Point a = { x: 1, y: 2 }
	a.x = 5
	const Point b = { ...a }
	return b.x + b.y
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
