# A tuple returned from a function-type parameter destructures directly: `const (a, b) = f(x)`.
# apply(mk, 10) yields (10, 11), destructured to a + b = 21.
# expect: exit 21
const mk = (Iarch n): (Iarch, Iarch) -> (n, n + 1)
const apply = ((Iarch) -> (Iarch, Iarch) f, Iarch x): Iarch -> {
	const (a, b) = f(x)
	return a + b
}
pub const main = () -> apply(mk, 10)
