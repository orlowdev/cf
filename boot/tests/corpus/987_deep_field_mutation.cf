# deep field mutation `a.b.c = v` (chained lvalue), + a deep read on the RHS
# expect: exit 148
import std::mem::arena::fixed_arena
data V = { Iarch v }
data Pair = { V a, V b }
data Tree = { Pair top, Iarch tag }

const main_body! = (): Iarch -> {
	let Tree t = { top: { a: { v: 3 }, b: { v: 40 } }, tag: 5 }
	t.top.a.v = 100
	t.top.b.v = t.top.b.v + 1
	t.tag = 7
	return t.top.a.v + t.top.b.v + t.tag
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
