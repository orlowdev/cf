# A `static [N Uint8]` buffer is indexable and MUTABLE (it lives in writable BSS): `pool[i] = v`
# stores a byte and `pool[i]` reads it back, resolved through the static's auto-called header. The
# writes persist for the whole program. A value name is lowercase (uppercase-initial is a type).
# expect: exit 42
static [64 Uint8] pool
pub const main = () -> {
	pool[0] = 40
	pool[1] = 2
	return Iarch(pool[0]) + Iarch(pool[1])
}
