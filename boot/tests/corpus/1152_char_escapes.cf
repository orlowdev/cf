# char-literal escapes: `'\''` (an escaped single quote, byte 39), `'\\'` (a backslash, byte 92),
# and `'\t'` (a tab, byte 9). Exercises the escape branch and the `!= backslash` single-char guard.
# expect: exit 140
pub const main = () -> {
	let Iarch q = '\''
	let Iarch bs = '\\'
	let Iarch tab = '\t'
	return q + bs + tab
}
