# The repointing rejection reaches NESTED lvalues (context.md §3): `s.mid.leaf = <fresh>` repoints
# an aggregate field two hops into a `let` provide — the chain's record type is resolved from the
# consume-binding root, and an in-place-only violation is still caught.
# expect: error
import std::mem::arena::growing_arena
import std::mem::ctx

data Leaf = { Iarch v }
data Mid = { Leaf leaf }
data St = { Mid mid }

pub const repoint! = (): () uses St -> {
	let s = std::mem::ctx::consume(St)
	s.mid.leaf = Leaf({ v: 9 })
}

pub const main = () -> {
	let St st = { mid: Mid({ leaf: Leaf({ v: 0 }) }) }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(let st)
	repoint!() in a

	return 0
}
