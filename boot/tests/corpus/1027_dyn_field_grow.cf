# growing a `[T]` dynamic-array field in place — `c.xs = [...c.xs, e]` through a `*Ctx` — copies the
# field vector and appends, storing the fresh vector back into the field. This is the same shape
# cf0's own monomorph uses (`m.instances = [...m.instances, clone]`). After two pushes the field is
# [10, 20, 30, 40]: len 4 + xs[2] 30 + xs[3] 40 = 74.
# expect: exit 74
data Ctx = { [Iarch] xs, Iarch pos }
const push = (*Ctx c, Iarch x): Iarch -> {
	c.xs = [...c.xs, x]
	return 0
}
pub const main = () -> {
	let Ctx c = Ctx({ xs: [10, 20], pos: 0 })
	const w1 = push(&c, 30)
	const w2 = push(&c, 40)
	return Iarch(c.xs.len) + c.xs[2] + c.xs[3]
}
