# `_` ignores a payload field; only the bound one is read
# expect: exit 42
union P = { Pt(Iarch, Iarch, Iarch) }
pub const mid = (P p): Iarch -> match p { P.Pt(_, y, _) -> y }

const main_body! = (): Iarch -> mid(P.Pt(1, 42, 3))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
