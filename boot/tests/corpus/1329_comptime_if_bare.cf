# `Os.Bare` is a valid comptime target — the freestanding platform (bare metal / Wasm), selected by
# `--target bare-arm64`. On the default host build (darwin) the `== Os.Bare` condition is false, so
# the else branch is taken. (A `--target bare-arm64` build would take the then branch.)
# expect: exit 7
import std::comptime::os
import std::sys::{ Os }

if os::target == Os.Bare then {
	const plat = (): Iarch -> 99
} else {
	const plat = (): Iarch -> 7
}
pub const main = () -> plat()
