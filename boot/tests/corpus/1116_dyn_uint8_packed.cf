# A `[Uint8]` dynamic array is byte-PACKED (stride 1), not 8-byte-slotted, so `Str(v)` can
# borrow its backing as contiguous bytes and index it (this is what `intern` relies on — the
# bug whose fix let cf reach a self-compilation fixpoint). Build "ma", read byte 1.
# expect: exit 97

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let [Uint8] v = []
	v = [...v, Uint8(109)]
	v = [...v, Uint8(97)]
	const Str s = Str(v)
	return Iarch(s[0]) + Iarch(v[1]) - Iarch(s.len) - 107
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
