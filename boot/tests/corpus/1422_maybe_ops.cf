# std::data::maybe::ops — data-last operators piped as a chain: `of` lifts, `map` transforms,
# `chain` sequences a step that may come up empty, a `Nothing` short-circuits, `alt` recovers,
# `filter` drops a failing value. 40 + 1 + 1 = 42.
# expect: exit 42
import std::data::{ Maybe }
import std::data::maybe::ops::{ of, map, chain, alt, filter }
import std::data::maybe::cata::{ or_else }

const double = (Iarch n): Iarch -> n * 2
const pos = (Iarch n): Bool -> n > 0
const half = (Iarch n): Maybe[Iarch] ->
	if n == 0 then Maybe[Iarch].Nothing else Maybe[Iarch].Just(n / 2)

pub const main = () -> {
	const a = of[Iarch](40)
		|> map[Iarch, Iarch](double)
		|> chain[Iarch, Iarch](half)
		|> filter[Iarch](pos)
		|> or_else[Iarch](0)

	const b = of[Iarch](0)
		|> chain[Iarch, Iarch](half)
		|> map[Iarch, Iarch](double)
		|> alt[Iarch](of[Iarch](1))
		|> or_else[Iarch](0)

	const c = of[Iarch](0 - 5)
		|> filter[Iarch](pos)
		|> or_else[Iarch](1)

	return a + b + c
}
