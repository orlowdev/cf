# A recursive (self-referential) type has no terminating structural comparison — `equals` on it is
# rejected at type check (testing.md §4). Case bodies are type-checked under every build (1492), so
# an ordinary compile trips it.
# expect: error
import std::test::{ equals }

data Node = { Iarch v, [Node] kids }

const mk = (Iarch v): Node -> {
	let [Node] k = []

	return Node({ v: v, kids: k })
}

case!("recursive type rejected", () -> {
	mk(1) |> equals(mk(1))
})

pub const main = () -> {
	return 0
}
