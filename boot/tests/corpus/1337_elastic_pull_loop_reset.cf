# The per-iteration LOOP reset must also restore the full {top, committed, limit} triple: each
# iteration's residue overflows the elastic chunk (cf_arena_pull relocates the block), and the
# back-edge rewind lands in the marked block. Top-only would desync the node after the first
# iteration and walk over sibling arena b. The loop is reset-safe (junk is iteration-local,
# only scalars leave), so the mark fires per back-edge, keeping all 6 iterations bounded.
# expect: exit 42
import "std/mem/arena/growing_arena" as growing_arena
data R = { Iarch a, Iarch b }
const fill = (): [R] -> {
	let [R] xs = []
	let Iarch i = 0
	loop {
		if i >= 8 then break
		xs = [...xs, R({ a: 42, b: 42 })]
		i = i + 1
	}
	return xs
}
const work! = (): Iarch -> {
	let Iarch total = 0
	let Iarch i = 0
	loop {
		if i >= 6 then break
		let [R] junk = []
		let Iarch j = 0
		loop {
			if j >= 60 then break
			junk = [...junk, R({ a: j, b: j })]
			j = j + 1
		}
		total = total + junk[59].a
		i = i + 1
	}
	return total
}
const main_body! = (): Iarch -> {
	const a = growing_arena.of(64)
	const b = growing_arena.of(64)
	const [R] guard = fill() in b
	const Iarch w = work!() in a
	if w != 354 then return 1
	return guard[3].a
}
pub const main = () -> {
	const root = growing_arena.of(1048576)
	return main_body!() in root
}
