# A `$`-stack aggregate is a fixed frame slot: built once, it cannot be re-pointed (that would need a
# fresh heap block, defeating the stack). Reassigning `$p` is rejected — mutate its fields instead.
# expect: error
data Point = { Iarch x, Iarch y }
const work = (): Iarch -> {
	let $p = Point({ x: 1, y: 2 })
	$p = Point({ x: 3, y: 4 })
	return $p.x
}
pub const main = () -> work()
