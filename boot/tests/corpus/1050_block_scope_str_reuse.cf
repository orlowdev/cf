# block scoping over a `Str` (slot-backed) name reused across sibling blocks — the exact shape
# cf's emit reuses (`const Str v` per branch). Each block builds a `v` and returns its length.
# "hello".len (5) is returned from the k==0 branch.
# expect: exit 5
const pick = (Iarch k): Iarch -> {
	let Iarch r = 0
	if k == 0 then {
		const Str v = "hello"
		r = Iarch(v.len)
	}
	if k == 1 then {
		const Str v = "hi"
		r = Iarch(v.len)
	}
	return r
}
pub const main = () -> pick(0)
