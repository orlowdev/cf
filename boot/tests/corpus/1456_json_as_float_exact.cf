# std::data::json as_float: the EXACT fast path (<=15 significant digits, a decimal power
# within 1e-22..1e22) converts correctly-rounded; beyond the window comes back Left — a
# restriction, never an approximation
# expect: exit 0
import std::mem::arena::growing_arena
import std::data::{ Either }
import std::data::json::{ Json, JsonRrr, parse!, as_float }
import std::io::console::{ println }

const fval! = (Str doc): Float64 -> match parse!(doc) {
	Either.Right(v) -> match as_float(v) {
		Either.Right(f) -> f,
		Either.Left(e) -> Float64(-999999),
	},
	Either.Left(e) -> Float64(-999999),
}

const is_window_left! = (Str doc): Bool -> match parse!(doc) {
	Either.Right(v) -> match as_float(v) { Either.Left(e) -> true, Either.Right(f) -> false },
	Either.Left(e) -> false,
}

const checks! = (): Iarch -> {
	if fval!("3.25") != Float64(325) / Float64(100) then return 1
	if fval!("-2.5e2") != Float64(0) - Float64(250) then return 2
	if fval!("0.001") != Float64(1) / Float64(1000) then return 3
	if fval!("100") != Float64(100) then return 4
	if fval!("0.1") != Float64(1) / Float64(10) then return 5
	if fval!("-0") != 0.0 then return 6

	# outside the exact window: a large power, 16 significant digits
	if !is_window_left!("1e23") then return 7
	if !is_window_left!("1234567890.123456") then return 8
	if is_window_left!("123456789.012345") then return 9

	# not a number value
	const Bool nn = match parse!("\"x\"") {
		Either.Right(v) -> match as_float(v) { Either.Left(e) -> true, Either.Right(f) -> false },
		Either.Left(e) -> false,
	}
	if !nn then return 10

	println("float checks passed")

	return 0
}

pub const main = (): Iarch -> {
	const a = growing_arena::of(1048576)

	return checks!() in a
}
