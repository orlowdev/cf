# a value loop nested inside a statement loop: 3 rounds each yielding 5 -> 15
# expect: exit 15
pub const main = () -> {
	let total = 0
	let k = 0
	loop {
		if k >= 3 then break
		let j = 0
		let got = loop {
			if j >= 5 then <- j
			j = j + 1
		}
		total = total + got
		k = k + 1
	}
	return total
}
