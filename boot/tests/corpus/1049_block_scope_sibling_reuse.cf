# block scoping: a scalar name may be REUSED across sibling `{ }` blocks (each declaration is
# local to its block). `start` is a fresh `const Iarch` in three sibling if-blocks. classify(0)=11,
# classify(1)=22, classify(2)=33; sum 66.
# expect: exit 66
const classify = (Iarch k): Iarch -> {
	let Iarch r = 0
	if k == 0 then {
		const Iarch start = 10
		r = start + 1
	}
	if k == 1 then {
		const Iarch start = 20
		r = start + 2
	}
	if k == 2 then {
		const Iarch start = 30
		r = start + 3
	}
	return r
}
pub const main = () -> classify(0) + classify(1) + classify(2)
