# `xs[i]`/`s[i]` are CLAIMS: a refuted bound exits through `cf_oob` (73) instead of touching a
# neighbor (an OOB read was silent garbage; an OOB write smashed the frame). The negative index
# folds into the same unsigned compare. Guarded induction loops elide their checks (BCE) — the
# sums prove elided accesses still read the right elements.
# expect: exit 73
import std::data::str::{ eq }

const sum = ([Iarch] xs): Iarch -> {
	const n = Iarch(xs.len)
	let acc = 0
	let i = 0

	loop {
		if i >= n then break
		acc = acc + xs[i]
		i = i + 1
	}

	return acc
}

pub const main = ([Str] args): Int -> {
	const [Iarch] xs = [1, 2, 3, 4]
	if sum(xs) != 10 then return 1
	const Str s = "abc"
	if Iarch(s[1]) != 98 then return 2
	let [Iarch] ys = [7]
	ys[0] = 8
	if ys[0] != 8 then return 3

	return xs[Iarch(args.len) + 41]
}
