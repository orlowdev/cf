# `mem.raw` is the privileged raw-memory surface (geometry_lowering §1: hooks work in raw
# memory): legal only inside the std geometry modules (`std/mem/...`). Userland use is a
# LOUD parse error, never a fallback — the no-raw-pointer discipline stays airtight.
# expect: error
pub const main = (): Iarch -> {
	const Uarch x = mem.raw.load(4096)
	return Iarch(x)
}
