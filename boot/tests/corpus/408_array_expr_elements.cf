# array elements are arbitrary Iarch expressions
# expect: exit 18
import "std/mem/arena/fixed_arena" as fixed_arena
const dbl = (Iarch n): Iarch -> n * 2

const main_body! = (): Iarch -> {
	const Iarch a = 3
	const [3 Iarch] xs = [a + 1, dbl(a), 8]
	return xs[0] + xs[1] + xs[2]
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
