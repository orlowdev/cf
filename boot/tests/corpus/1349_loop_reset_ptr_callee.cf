# The loop back-edge reset must NOT fire around a call that can rehome through a pointer
# parameter: `fill` stores a record it allocates (in the CALLER's region, above the loop
# mark) into the outer table through its `*[F]` parameter — resetting each iteration frees
# the records the table now points to (the p5 dangle: silently wrong reads, no crash).
# expect: exit 24
data F = { Iarch a }
const mkf = (Iarch x): F -> F({ a: x })
const fill = (*[F] fs, Iarch k): Iarch -> {
	fs[k] = mkf(k + 10)
	return 0
}
const main_body! = (): Iarch -> {
	let [F] fs = []
	let Iarch p = 0
	loop {
		if p >= 5 then break
		fs = [...fs, mkf(0)]
		p = p + 1
	}
	let Iarch d = 0
	loop {
		if d >= 5 then break
		fill(fs, d)
		d = d + 1
	}
	return fs[4].a + fs[0].a
}
pub const main = () -> {
	const a = mem.arena.grow(65536)
	return main_body!() in a
}
