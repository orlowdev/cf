# The duplex fixed arena is TWO-ENDED in one block (geometry_lowering §5): survivors bump up
# from the base while bracketed callees' trapped scratch bumps down from the tail — sharing
# of(n)'s n bytes total. eat!'s 100 KiB scratch dies at each return (residue side, reclaimed
# by the frame bracket); keep's records accumulate survivor-side. 40 rounds of each through
# a 512 KiB arena fit only because the scratch keeps being reclaimed.
# expect: exit 39
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Iarch v }
const eat! = (Iarch k): Iarch -> {
	let [102400 Uint8] junk
	return k
}
const keep = (Iarch k): P -> {
	const P p = P({ v: k })
	return p
}
const main_body! = (): Iarch -> {
	let [P] ps = []
	let Iarch i = 0
	loop {
		if i >= 40 then break
		eat!(i)
		ps = [...ps, keep(i)]
		i = i + 1
	}
	return ps[39].v + ps[0].v
}
pub const main = () -> {
	const a = fixed_arena.of(524288)
	return main_body!() in a
}
