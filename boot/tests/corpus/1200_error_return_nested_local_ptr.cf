# region-outlives: the escape taint is transitive through arbitrarily nested construction — a `*T`
# field holding `&local` taints every aggregate built around it (memory_model §6).
# expect: error
data Point = { Iarch x }
data Holder = { *Point p }
data Wrap = { Holder h }
const mk = (): Wrap -> {
	let Point local = { x: 7 }
	return Wrap({ h: Holder({ p: &local }) })
}
pub const main = () -> mk().h.p.x
