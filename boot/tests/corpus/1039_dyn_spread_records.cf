# value-level array spread over a `[Record]` vector: copies the record-pointer slots and appends
# a fresh record. Sum of the .v fields: 2 + 3 + 9 = 14.
# expect: exit 14
data Token = { Iarch v }
const total = ([Token] ts): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(ts.len) then break
		acc = acc + ts[i].v
		i = i + 1
	}
	return acc
}
pub const main = () -> {
	const [Token] base = [Token({v: 2}), Token({v: 3})]
	const [Token] more = [...base, Token({v: 9})]
	return total(more)
}
