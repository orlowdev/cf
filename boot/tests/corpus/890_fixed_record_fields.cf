# fixed-width integer record fields (Uint8/Int32), read + arithmetic through a `*Token` pointer
# expect: exit 105
# check: root
data Token = { Uint8 kind, Int32 offset }
const val = (*Token t): Iarch -> Iarch(t.kind) + Iarch(t.offset)

const main_body! = (): Iarch -> {
	const tok = Token({ kind: 5, offset: 100 })
	return val(&tok)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
