# inline literals nest to any depth (record fields resolve recursively)
# expect: exit 48
data V = { Iarch v }
data Pair = { V a, V b }
data Tree = { Pair top, Iarch tag }
pub const main = () -> {
	const Tree t = { top: { a: { v: 3 }, b: { v: 40 } }, tag: 5 }
	return t.top.a.v + t.top.b.v + t.tag
}
