# inline literals nest to any depth (record fields resolve recursively)
# expect: exit 48
import "std/mem/arena/fixed_arena" as fixed_arena
data V = { Iarch v }
data Pair = { V a, V b }
data Tree = { Pair top, Iarch tag }

const main_body! = (): Iarch -> {
	const Tree t = { top: { a: { v: 3 }, b: { v: 40 } }, tag: 5 }
	return t.top.a.v + t.top.b.v + t.tag
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
