# an UPPER_SNAKE const crosses the module boundary all three ways: destructured to a bare
# name, namespace-qualified (`fdmod::STDOUT` — an upper-snake terminal is a VALUE member,
# not a type), and through a chained const; the flatten renames each to the definition
# expect: exit 6
import fdmod
import fdmod::{ Desc, STDOUT }

const pick = (): Desc -> STDOUT

pub const main = (): Iarch -> {
	let Iarch acc = 0
	acc = acc + Iarch(STDOUT.n)
	acc = acc + Iarch(fdmod::STDOUT.n)
	acc = acc + Iarch(fdmod::CHAIN)
	acc = acc + Iarch(pick().n)
	const Desc d = STDOUT
	if Iarch(d.label.len) == 3 then acc = acc + 2

	return acc
}
