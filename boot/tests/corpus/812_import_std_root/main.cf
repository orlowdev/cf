# `std/…` imports resolve under the baked-in lib root (lib/std/…), independent of the
# importing file's location — here std/math's pure integer helpers. Both the destructured
# and namespace forms resolve the same std module. abs(-40) + max(1, 2) = 42.
# expect: exit 42
import std::math::{ abs }
import std::math

pub const main = () -> abs(-40) + math::max(1, 2)
