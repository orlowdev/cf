# a group field may be a tuple type; the group literal carries the tuple value.
# expect: exit 12
import "std/mem/arena/fixed_arena" as fixed_arena
type G = { (Iarch, Iarch) t, Iarch k }
const f = (G g): Iarch -> t[0] + t[1] + k

const main_body! = (): Iarch -> f({ t: (3, 4), k: 5 })

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
