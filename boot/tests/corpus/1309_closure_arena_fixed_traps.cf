# The governance proof for closure descent (1308): the same closure allocation under a FIXED 4 KiB
# arena TRAPS. `blow` (a closure inside `run!`, grafted `in a`) allocates a 1 MiB buffer; a fixed
# arena has committed == limit, so the bump overruns and fires cf_oom (70). This can only happen if
# the closure allocates FROM the grafted arena node — if the node did not thread into the lifted
# closure body it would allocate on the elastic page and succeed. It traps, so the descent holds.
# expect: exit 70
const run! = (Iarch n): Iarch -> {
	const blow = (Iarch x): Iarch -> {
		let [1048576 Uint8] buf
		return x
	}
	return blow(n)
}
pub const main = () -> {
	const a = mem.arena.of(4096)
	return run!(9) in a
}
