# region-outlives: returning a `*T` FIELD read from a local aggregate hands the caller the `&local`
# stored in it — a pointer into a residence that dies once the call returns (memory_model §6). This
# is the field-read analog of returning `&local` (1196) or the whole record holding it (1197).
# expect: error
data Point = { Iarch x }
data Holder = { *Point p }
const leak = (): Point -> {
	let Point local = { x: 7 }
	let Holder h = Holder({ p: &local })
	return h.p
}
pub const main = () -> leak().x
