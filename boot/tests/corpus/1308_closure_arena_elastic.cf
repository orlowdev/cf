# Closure descent under geometry: the hidden node arg threads into a LIFTED closure body, so a
# closure that allocates draws from the ambient arena — not the root page. `blow` is a closure
# defined inside `run!` (grafted `in a`); it allocates a 1 MiB buffer. Under an ELASTIC 4 KiB arena
# the allocation pulls another block and succeeds (the fixed counterpart 1309 traps on the same
# program — which only makes sense if the closure allocates FROM the arena, proving the descent).
# expect: exit 5
import "std/mem/arena/growing_arena" as growing_arena
const run! = (Iarch n): Iarch -> {
	const blow = (Iarch x): Iarch -> {
		let [1048576 Uint8] buf
		return x
	}
	return blow(n)
}
pub const main = () -> {
	const a = growing_arena.of(4096)
	return run!(5) in a
}
