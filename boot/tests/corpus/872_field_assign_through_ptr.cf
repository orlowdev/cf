# mutate a record field through a `*Record` pointer param (a writable borrow)
# expect: exit 6
# check: root
data P = { Iarch x }
const bump = (*P p): Iarch -> {
	p.x = p.x + 1
	return p.x
}

const main_body! = (): Iarch -> {
	let q = P({ x: 5 })
	return bump(&q)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
