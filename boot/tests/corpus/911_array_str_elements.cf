# a `[N Str]` array: Str elements, iterated with `for`, `.len` summed
# expect: exit 6

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [3 Str] ss = ["ab", "cde", "f"]
	let Iarch total = 0
	for s in ss {
		total = total + Iarch(s.len)
	}
	return total
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
