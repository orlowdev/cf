# asm-free hello world: `print` reaches stdout through the `std/io/console` barrel, which selects
# the darwin console implementation at compile time. Exit 0 proves the whole chain — barrel →
# comptime `if` → `pub import` reexport → `syscall6` — compiles and runs with no `asm` in sight.
# expect: exit 0
import std::io::console::{ print }
pub const main = (): Iarch -> {
	print("Hello, world!\n")
	return 0
}
