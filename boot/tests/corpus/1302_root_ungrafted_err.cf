# Root does not propagate into `!` functions (memory_model §2): `main` may allocate on the root
# itself, but a `!` function — one that holds residue — must run under a geometry. Calling the
# allocating `span!` from `main` WITHOUT an `in <arena>` clause is rejected; the fix is
# `span!(3) in a` (see 1301 for the accepted shape).
# expect: error
data Box = { Iarch lo, Iarch hi }
const span! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 3 }
	return b.hi - b.lo
}
pub const main = () -> span!(3)
