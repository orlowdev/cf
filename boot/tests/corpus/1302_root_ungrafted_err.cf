# With `--check-root` on (memory_model §2), residue placed on the ROOT page is rejected: main runs
# under the root and builds a record directly, without grafting a geometry. The compiler must
# refuse it — the fix is to carve an arena and allocate `in` it.
# check: root
# expect: error
data P = { Iarch x, Iarch y }
pub const main = () -> {
	const P p = { x: 3, y: 4 }
	return p.x + p.y
}
