# every member of the argument union must be in the bound: `Small` shares `Red` with `Other`
# but its `Green` is absent, so `Small` is not a subset of `Other` and `f[Small]` is rejected
# expect: error
union Small = { Red, Green }
union Other = { Red, Blue }
pub const f = [Other 'T]('T x): Iarch -> 0
pub const main = () -> f[Small](Small.Red)
