# the allocation-effect marker `!` rides a FUNCTION name (ebnf § Identifiers): `alloc!`
# is one identifier token, defined and called with the `!` attached. Here the residue
# (a Point that lives and dies in the frame) never escapes — only a scalar leaves.
# expect: exit 7
data Point = { Iarch x, Iarch y }
const alloc! = (): Iarch -> {
	const Point p = { x: 7, y: 9 }
	return p.x
}

const main_body! = (): Iarch -> alloc!()

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
