# a `*[Iarch]` param forwarded onward to another helper (pass-through)
# expect: exit 8
# check: root
const at = (*[Iarch] xs, Iarch i): Iarch -> xs[i]
const second = (*[Iarch] xs): Iarch -> at(xs, 1)

const main_body! = (): Iarch -> {
	let [3 Iarch] a = [7, 8, 9]
	return second(a)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
