# destructuring a tuple binds a union position; the bound union is recovered with `match`. 9 + 2 = 11.
# expect: exit 11
# check: root
union N = { I(Iarch), Z }

const main_body! = (): Iarch -> {
	const (u, n) = (N.I(9), 2)
	return match u { N.I(v) -> v, N.Z -> 0 } + n
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
