# destructuring a tuple binds a union position; the bound union is recovered with `match`. 9 + 2 = 11.
# expect: exit 11
import std::mem::arena::fixed_arena
union N = { I(Iarch), Z }

const main_body! = (): Iarch -> {
	const (u, n) = (N.I(9), 2)
	return match u { N.I(v) -> v, N.Z -> 0 } + n
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
