# Stage A of the honest-intrinsics arc: the `intrinsic` declaration form (ebnf § Intrinsics)
# is a real, parsed, typechecked declaration — a signature the compiler supplies the body for,
# not a fabricated `cf__*` callee. Here one is declared (generic + non-generic) but never
# called, so it must typecheck (no body to check) and emit NO standalone function. The program
# just returns 7; the point is that declaring an intrinsic compiles cleanly.
# expect: exit 7
intrinsic scratch = (Uarch x): Uarch
intrinsic peek = ['T](Uarch p): 'T
pub const main = (): Iarch -> {
	return 7
}
