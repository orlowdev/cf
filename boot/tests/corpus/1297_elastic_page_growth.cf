# The root page is elastic: a loop that bumps the cursor well past the old fixed 256 MiB
# mapping (300 × 1 MiB of residue) must grow and exit cleanly, not trap. Each buffer is
# untouched, so this advances the virtual cursor across the commit watermark at ~0 physical
# cost — exercising cf_grow. Under the old bounded mapping this trapped (cf_oom, exit 70).
# expect: exit 0
import std::mem::arena::growing_arena
const eat! = (Iarch k): Iarch -> {
	let [1048576 Uint8] buf
	return k
}

const main_body! = (): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= 300 then break
		const Iarch r = eat!(i)
		i = i + 1
	}
	return 0
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
