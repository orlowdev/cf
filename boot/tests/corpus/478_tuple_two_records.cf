# three positions: Iarch, record, Iarch — offsets and per-position load widths line up
# expect: exit 9
import "std/mem/arena/fixed_arena" as fixed_arena
data Pt = { Iarch x, Iarch y }
const mk = (Iarch a, Iarch b): Pt -> Pt({ x: a, y: b })

const main_body! = (): Iarch -> {
	const t = (2, mk(3, 4), 0)
	return t[0] + t[1].x + t[1].y
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
