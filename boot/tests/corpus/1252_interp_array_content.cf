# a `[Uint8]` renders its bytes as NUMBERS (not text): `[72, 105]`, so m[1] is '7' (ASCII 55)
# expect: exit 55

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let [Uint8] xs = [72, 105]
	const Str m = "${xs}"
	return Iarch(m[1])
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
