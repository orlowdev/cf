# an array tuple element is now supported (was a "later brick"): the second position is a `[Iarch]`
# whose header rides the 8-byte slot; `t[1][2]` indexes into it. 1 + 30 = 31.
# expect: exit 31

# check: root
const main_body! = (): Iarch -> {
	const t = (1, [10, 20, 30])
	return t[0] + t[1][2]
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
