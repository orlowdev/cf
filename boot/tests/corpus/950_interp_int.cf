# interpolate an integer: "n=${n}" with n=42 -> "n=42", length 4
# expect: exit 4

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let Iarch n = 42
	const Str m = "n=${n}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
