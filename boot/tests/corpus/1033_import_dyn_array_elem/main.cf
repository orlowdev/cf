# a `[Token]` dynamic array of an IMPORTED record type crosses the module
# boundary (built in `tok`, consumed here) — the element type name must be
# rewritten by flatten's rename pass. 40 + 2 = 42.
# expect: exit 42
import "tok" as { Token, build }
const sum = ([Token] ts): Iarch -> {
	let Iarch a = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(ts.len) then break
		a = a + ts[i].v
		i = i + 1
	}
	return a
}
pub const main = () -> sum(build())
