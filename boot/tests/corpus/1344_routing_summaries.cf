# Slice-B summary shapes for the shadow routing pass (routing.cf): a mutually recursive pair
# returning an argument (an SCC back-edge — the DFS resolves it to ⊤ at the site, so the
# returned record still classifies SURVIVOR), a helper that STORES its argument into another
# parameter's aggregate (the `stores` bit — unconditional escape at the call site), an
# INDIRECT call through a fn-value parameter (unknown callee ⇒ ⊤), and a read-only helper
# whose arguments must NOT escape (the economics case the summaries unlock). The compile
# itself exercises the summary DFS + the oracle tripwire; the run pins the behavior so the
# Stage-2 codegen flip turns any misrouting into a visible failure here.
# expect: exit 58
import std::mem::arena::growing_arena
data P = { Iarch v }
data Big = { P inner }
# SCC: pick <-> pick2, both return their record argument
const pick = (P a, Iarch n): P -> {
	if n == 0 then return a
	return pick2(a, n - 1)
}
const pick2 = (P a, Iarch n): P -> {
	if n == 0 then return a
	return pick(a, n - 1)
}
# stores its second argument into the first parameter's aggregate — the caller's value escapes
const put = (*Big g, P v): Iarch -> {
	g.inner = v
	return 0
}
# indirect call: the callee rides in as a fn value, so `x` must escape (⊤ callee)
const apply = ((P) -> P f, P x): P -> f(x)
const double = (P x): P -> P({ v: x.v * 2 })
# read-only: neither argument escapes — the summary rows are all-false
const sum = (P a, P b): Iarch -> a.v + b.v
const main_body! = (): Iarch -> {
	let Big b = Big({ inner: P({ v: 2 }) })
	const P w = P({ v: 40 })
	put(&b, w)
	const P a1 = pick(P({ v: 1 }), 3)
	const P a2 = apply(double, P({ v: 3 }))
	const Iarch z = sum(P({ v: 5 }), P({ v: 6 }))
	return b.inner.v + a1.v + a2.v + z
}
pub const main = () -> {
	const a = growing_arena::of(8192)
	return main_body!() in a
}
