# a fixed-width integer record field (fixed-width members are now allowed)
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Int8 x }

const main_body! = (): Iarch -> {
	const p = P({ x: 7 })
	return Iarch(p.x)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
