# a tuple parameter can be destructured in the body (it is an ordinary tuple value)
# expect: exit 30
const f = ((Iarch, Iarch) p): Iarch -> {
	const (a, b) = p
	return a + b
}

const main_body! = (): Iarch -> f((10, 20))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
