# A `<- t` yield nested inside an if/block within a value loop escapes `t` exactly like a
# top-level yield (its value flows into the bound result and out the return). The escape walk
# used to see only top-level yields, so `t` read as trapped residue and this colorless function
# was wrongly required to wear `!`.
# expect: exit 8
data P = { Iarch v }
const pick = (Iarch c): P -> {
	const P t = P({ v: 8 })
	const P r = loop {
		if c > 0 then {
			<- t
		}
		<- P({ v: 0 })
	}
	return r
}
pub const main = () -> {
	const a = mem.arena.grow(4096)
	const P g = pick(1) in a
	return g.v
}
