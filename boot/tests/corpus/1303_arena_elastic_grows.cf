# An ELASTIC arena (`growing_arena.of(n)`) grows instead of trapping: carved with an initial 4 KiB
# block and kind=1, an allocation past the block pulls another block from the parent (cf_arena_pull)
# rather than firing cf_oom. Here a 1 MiB buffer is placed in a 4 KiB elastic arena and succeeds —
# the fixed counterpart (1300) traps on the same program.
# expect: exit 5
import "std/mem/arena/growing_arena" as growing_arena
const fill! = (Iarch k): Iarch -> {
	let [1048576 Uint8] buf
	return k
}
pub const main = () -> {
	const a = growing_arena.of(4096)
	const Iarch r = fill!(5) in a
	return r
}
