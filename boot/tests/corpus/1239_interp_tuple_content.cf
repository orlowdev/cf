# the rendered `(1, true)` has the Bool's `t` at index 4 (ASCII 116) — content, not just length
# expect: exit 116

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	const t = (1, true)
	const Str m = "${t}"
	return Iarch(m[4])
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
