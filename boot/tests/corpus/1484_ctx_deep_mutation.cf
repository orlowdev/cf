# In-place mutation of a NESTED field of a `let` provide (`s.inner.v = ...`) — a deep field write
# through the context pointer, not a repointing. The read-back sees the mutated value (context.md §3).
# expect: exit 42
import std::mem::arena::growing_arena
import std::mem::ctx

data Inner = { Iarch v }
data St = { Inner inner }

pub const tweak = (): () uses St -> {
	let s = std::mem::ctx::consume(St)
	s.inner.v = s.inner.v + 5
}

pub const main = () -> {
	let St st = { inner: Inner({ v: 37 }) }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(let st)
	tweak()
	const r = std::mem::ctx::consume(St)

	return r.inner.v
}
