# string-literal match: keyword dispatch with or-patterns and a `_` default
# expect: exit 85
pub const opcode = (Str s): Iarch -> match s {
	"add" -> 1,
	"sub" -> 2,
	"mul" | "imul" -> 3,
	_ -> 0,
}
pub const main = () -> {
	let Iarch acc = 0
	acc = acc + opcode("add")
	acc = acc + opcode("mul") * 10
	acc = acc + opcode("imul") * 100
	acc = acc + opcode("xyz") * 1000
	acc = acc + opcode("sub") * 5
	return acc
}
