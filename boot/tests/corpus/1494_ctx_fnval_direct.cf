# A demand-carrying fn VALUE at a specialized direct call (context.md §4): `body1` (uses Verdicts)
# flows into `runner!`'s fn-typed param; the call retargets to a `$d` clone whose `cb()` is a
# DIRECT `body1` call, the hidden ctx pointer threaded from the clone's own provide. 1 mismatch.
# expect: exit 1
import std::mem::arena::fixed_arena
import std::mem::arena::test_arena
import std::mem::ctx
import std::test::{ Verdicts, equals }

const val = (Iarch x): Iarch -> x

const body1 = (): () -> {
	val(1) |> equals(1)
	val(1) |> equals(2)
}

const runner! = (Str desc, () -> () cb): Uarch -> {
	let Verdicts vd = { desc: desc, count: 0, fails: 0 }
	const ta = test_arena::of(65536) |> std::mem::ctx::provide(let vd)
	cb()
	test_arena::destroy(ta)
	return vd.fails
}

const main_body! = (): Uarch -> runner!("probe", body1)

pub const main = () -> {
	const a = fixed_arena::of(1048576)
	const Uarch f = main_body!() in a
	return Iarch(f)
}
