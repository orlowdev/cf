# An inlined helper stays a working FUNCTION VALUE: its direct calls are spliced,
# but the definition survives for higher-order use — both paths must agree.
# expect: exit 24
const twice = (Iarch x): Iarch -> x + x

const apply = ((Iarch) -> Iarch f, Iarch v): Iarch -> f(v)

pub const main = (): Iarch -> {
	return twice(6) + apply(twice, 6)
}
