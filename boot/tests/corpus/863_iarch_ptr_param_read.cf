# a helper indexes a `*[Iarch]` word array passed to it (the worklist/token-stream pattern)
# expect: exit 100
const sum = (*[Iarch] xs, Iarch n): Iarch -> {
	let s = 0
	let i = 0
	loop {
		if i >= n then break
		s = s + xs[i]
		i = i + 1
	}
	return s
}

const main_body! = (): Iarch -> {
	let [4 Iarch] a = [10, 20, 30, 40]
	return sum(a, 4)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
