# spreading a heterogeneous tuple preserves per-position types (Iarch, Str)
# expect: exit 9

# check: root
const main_body! = (): Iarch -> {
	const t = (1, "abc")
	const u = (...t, 5)
	return u[0] + u[1].len + u[2]
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
