# spreading a heterogeneous tuple preserves per-position types (Iarch, Str)
# expect: exit 9

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const t = (1, "abc")
	const u = (...t, 5)
	return u[0] + u[1].len + u[2]
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
