# Summary-driven argument routing: a construction passed to an argument the callee neither
# stores nor aliases into its return is statement scratch — born residue-side and reclaimed
# by the iteration bracket. 5000 interpolated strings through a 64 KiB fixed arena fit only
# under that routing (each interp would otherwise be an immortal survivor).
# expect: exit 47
import "std/mem/arena/fixed_arena" as fixed_arena
const sink = (Str s, Iarch k): Iarch -> k
const main_body! = (): Iarch -> {
	let Iarch n = 0
	let Iarch i = 0
	loop {
		if i >= 5000 then break
		n = n + sink("xy${i}z", 1)
		i = i + 1
	}
	return n - 4953
}
pub const main = () -> {
	const a = fixed_arena.of(65536)
	return main_body!() in a
}
