# A recursive union via an EXPLICIT `*List` payload (the owner-confirmed cf0 form): a linked
# list built with `&` on each tail, summed by matching and recursing on the bound `*List`.
# expect: exit 7
union List = { Cons(Iarch, *List), Nil }
const sum = (List l): Iarch -> match l {
	List.Cons(n, rest) -> n + sum(rest),
	List.Nil -> 0,
}
pub const main = () -> {
	const List a = List.Cons(3, &List.Cons(4, &List.Nil))
	return sum(a)
}
