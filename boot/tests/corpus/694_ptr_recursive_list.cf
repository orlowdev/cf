# A recursive union via an EXPLICIT `*List` payload (the owner-confirmed cf form): a linked
# list built with `&` on each tail, summed by matching and recursing on the bound `*List`.
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
union List = { Cons(Iarch, *List), Nil }
const sum = (List l): Iarch -> match l {
	List.Cons(n, rest) -> n + sum(rest),
	List.Nil -> 0,
}

const main_body! = (): Iarch -> {
	const List a = List.Cons(3, &List.Cons(4, &List.Nil))
	return sum(a)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
