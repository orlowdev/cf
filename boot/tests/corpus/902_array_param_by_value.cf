# a by-value `[N Iarch]` parameter: `.len` and `for … in` use its comptime length
# expect: exit 102
import "std/mem/arena/growing_arena" as growing_arena
const total = ([4 Iarch] xs): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= xs.len then break
		acc += xs[i]
		i += 1
	}
	return acc
}

const main_body! = (): Iarch -> {
	const [4 Iarch] ns = [10, 20, 30, 42]
	return total(ns)
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
