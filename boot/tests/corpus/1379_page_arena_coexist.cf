# The page and arena geometries in ONE main: main is page-ambient (it builds `p` on the root
# page → `reserve_ret__pg`) AND grafts an arena for `work!` (`in ar` → the arena twin
# `work!__ar`, whose Box builds in `reserve_ret__ar`). This proves the pg tag coexists with the
# ar tag under a single materialized main — main's inline record takes the page hook while its
# `in ar` call routes to the arena twin, selected by the geometry binding, not main's own tag.
# expect: exit 42
import std::mem::arena::fixed_arena
data Box = { Iarch lo, Iarch hi }
const work! = (Iarch n): Iarch -> {
	const Box junk = Box({ lo: n, hi: n })
	const Box s = Box({ lo: n + junk.lo - junk.hi, hi: n * 2 })
	return s.hi - s.lo
}
pub const main = () -> {
	const Box p = Box({ lo: 0, hi: 20 })
	const ar = fixed_arena::of(4096)
	const Iarch r = work!(10) in ar
	return p.hi + r + 12
}
