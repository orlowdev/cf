# construction inference works with a record payload type (`Box.Wrap(mk(9))` infers `Box[P]`)
# expect: exit 9
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Iarch x }
union Box['T] = { Wrap('T), Empty }
const mk = (Iarch v): P -> ({ x: v })

const main_body! = (): Iarch -> {
	const Box[P] b = Box.Wrap(mk(9))
	return match b {
		Box.Wrap(p) -> p.x,
		Box.Empty -> 0,
	}
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
