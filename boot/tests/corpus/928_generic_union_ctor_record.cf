# construction inference works with a record payload type (`Box.Wrap(mk(9))` infers `Box[P]`)
# expect: exit 9
data P = { Iarch x }
union Box['T] = { Wrap('T), Empty }
const mk = (Iarch v): P -> ({ x: v })
pub const main = () -> {
	const Box[P] b = Box.Wrap(mk(9))
	return match b {
		Box.Wrap(p) -> p.x,
		Box.Empty -> 0,
	}
}
