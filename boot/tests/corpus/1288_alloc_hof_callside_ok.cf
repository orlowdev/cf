# HOF call-side rule: a call is effectful when any argument is a `!` function VALUE. Passing `sq!`
# colors the caller `run!`, which is marked accordingly.
# expect: exit 25
import "std/mem/arena/growing_arena" as growing_arena
data Point = { Iarch x, Iarch y }
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const sq! = (Iarch n): Iarch -> {
	const Point p = { x: n, y: n }
	return p.x * n
}
const run! = (): Iarch -> apply(sq!, 5)
pub const main = () -> {
	const a = growing_arena.of(4096)
	return run!() in a
}
