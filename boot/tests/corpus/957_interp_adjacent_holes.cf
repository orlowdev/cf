# adjacent holes with no literal between: "${a}${b}" a=1 b=2 -> "12", length 2
# expect: exit 2

# check: root
const main_body! = (): Iarch -> {
	let Iarch a = 1
	let Iarch b = 2
	const Str m = "${a}${b}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
