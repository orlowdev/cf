# adjacent holes with no literal between: "${a}${b}" a=1 b=2 -> "12", length 2
# expect: exit 2

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let Iarch a = 1
	let Iarch b = 2
	const Str m = "${a}${b}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
