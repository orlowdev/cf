# a non-`!` function returning a spread `[...xs, x]` is a SURVIVOR producer (the source rides
# out as the returned array's own), so it holds no residue and needs no marker — and the built
# byte array has stride 1. Exercises both the `!` algebra and array-element emit in one shot.
# expect: exit 66
import std::mem::arena::growing_arena
const build = (Iarch n): [Uint8] -> {
	let [Uint8] out = []
	let Iarch k = 0
	loop {
		if k >= n then break
		out = [...out, Uint8(65 + k)]
		k = k + 1
	}
	return [...out, Uint8(90)]
}
pub const main = () -> {
	const a = growing_arena::of(4096)
	const [Uint8] r = build(2) in a
	return Iarch(r[1])
}
