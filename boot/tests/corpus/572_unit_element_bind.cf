# a unit tuple position binds to a `Unit` local (word-repr, but its own type)
# expect: exit 8

import "std/mem/arena/fixed_arena" as fixed_arena
const main_body! = (): Iarch -> {
	const t = (8, ())
	const u = t[1]
	const v = u
	return t[0]
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
