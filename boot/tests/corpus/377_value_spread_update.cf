# value-level spread copies a record and overrides one field (immutable update)
# expect: exit 20
# check: root
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point a = { x: 3, y: 4 }
	const Point b = { ...a, y: 10 }
	return a.x + a.y + b.x + b.y
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
