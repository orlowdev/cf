# Structural inference peels through nested array parameters: a `[['T]]` argument of type
# `[[Iarch]]` binds 'T = Iarch.
# expect: exit 7
import std::mem::arena::fixed_arena
const flat = ['T]([['T]] xss): [Iarch] -> xss[0]

const main_body! = (): Iarch -> {
	let [[Iarch]] xss = [[7, 8], [9]]
	let [Iarch] r = flat(xss)
	return r[0]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
