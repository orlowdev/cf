# a record passed to a function by pointer; the callee reads its fields
# expect: exit 7
import std::mem::arena::fixed_arena
data Point = { Iarch x, Iarch y }
const sum = (Point p): Iarch -> p.x + p.y

const main_body! = (): Iarch -> {
	let Point q = { x: 3, y: 4 }
	return sum(q)
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
