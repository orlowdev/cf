# a record local may bind (alias) an element of a `[Record]` dynamic array — a read-only
# borrow of the element's arena pointer, no explicit copy (M0; the single bump arena
# makes the alias safe). Walking a record vector element-by-element needs this.
# expect: exit 30
import "std/mem/arena/growing_arena" as growing_arena
data P = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	let [P] ps = []
	ps = [...ps, P({ x: 10, y: 20 })]
	const P first = ps[0]
	return first.x + first.y
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
