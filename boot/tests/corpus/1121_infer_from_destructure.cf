# a generic function's type argument is inferred from a destructure binder (`id(a)`)
# expect: exit 42
# check: root
const id = ['T]('T v): 'T -> v

const main_body! = (): Iarch -> {
	const (a, b) = (40, 2)
	return id(a) + id(b)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
