# a tuple field of a `let` record can be reassigned as a whole
# expect: exit 11
# check: root
data R = { (Iarch, Iarch) p }

const main_body! = (): Iarch -> {
	let r = R({ p: (1, 2) })
	r.p = (4, 7)
	return r.p[0] + r.p[1]
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
