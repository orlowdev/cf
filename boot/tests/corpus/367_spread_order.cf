# spread fields keep their positions; a field placed before the spread stays first
# expect: exit 100
import "std/mem/arena/growing_arena" as growing_arena
data Tail = { Iarch y, Iarch z }
data Full = { Iarch x, ...Tail }

const main_body! = (): Iarch -> {
	const Full f = { x: 1, y: 10, z: 100 }
	return f.x * f.z - f.y * f.x + f.y - f.z + f.z
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
