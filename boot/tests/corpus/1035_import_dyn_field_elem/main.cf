# a record FIELD `[Token]` whose element is an imported type — the `[Token]`
# field marker must be rewritten by flatten's rename pass. 7 + 8 = 15.
# expect: exit 15
import "tok" as { Token, Ctx }
const total = (*Ctx c): Iarch -> {
	let Iarch a = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(c.toks.len) then break
		a = a + c.toks[i].v
		i = i + 1
	}
	return a
}
pub const main = () -> {
	let [Token] ts = [Token({ v: 7 }), Token({ v: 8 })]
	let Ctx c = Ctx({ toks: ts, pos: 0 })
	return total(&c)
}
