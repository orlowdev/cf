# one generic data type at two instantiations, and a `'T`-returning generic function
# expect: exit 107
# check: root
data Point = { Iarch x, Iarch y }
data Box['T] = { 'T v }
const mkp = (Iarch a, Iarch b): Point -> {
	const Point p = { x: a, y: b }
	return p
}
const unbox = ['T](Box['T] b): 'T -> b.v

const main_body! = (): Iarch -> {
	const Box[Iarch] bi = { v: 100 }
	const Box[Point] bp = { v: mkp(3, 4) }
	const Point p = unbox[Point](bp)
	return unbox[Iarch](bi) + p.x + p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
