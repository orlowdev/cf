# A `defer` tap may sit mid-chain: it forwards its tapped value, so the pipe
# continues. `3 |> inc |> defer log |> dbl` = dbl(inc(3)) = 8, with log(4) deferred.
# expect: exit 8
const inc = (Iarch x) -> x + 1
const dbl = (Iarch x) -> x * 2
const log = (Iarch x): Iarch -> x
pub const main = () -> {
	return 3 |> inc |> defer log |> dbl
}
