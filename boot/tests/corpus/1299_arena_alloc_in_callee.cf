# A record built inside a callee governed by `in a` lives in the carved arena, not the page:
# main grafts a 4 KiB arena, calls span!() `in a`, and span!'s Box allocates from the arena node
# threaded as its hidden node arg. Only a scalar returns, so the result is unaffected.
# expect: exit 6
import std::mem::arena::fixed_arena
data Box = { Iarch lo, Iarch hi }
const span! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 3 }
	return b.hi - b.lo
}
pub const main = () -> {
	const a = fixed_arena::of(4096)
	const Iarch r = span!(3) in a
	return r
}
