# a record declaration spread splices another record's fields in place
# expect: exit 6
data Point = { Iarch x, Iarch y }
data Labeled = { ...Point, Iarch z }

const main_body! = (): Iarch -> {
	const Labeled p = { x: 1, y: 2, z: 3 }
	return p.x + p.y + p.z
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
