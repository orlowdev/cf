# `for … in` over an array of records binds the loop variable as that record (its fields readable) —
# the for-var now flows its element type through (previously a genesis word-narrowing rejected this).
# expect: exit 3
data P = { Iarch x }
const mk = (Iarch a): P -> ({ x: a })
pub const main = () -> {
	const [2 P] ps = [mk(1), mk(2)]
	let Iarch t = 0
	for p in ps { t = t + p.x }
	return t
}
