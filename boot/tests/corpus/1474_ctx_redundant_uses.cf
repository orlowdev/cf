# A `pub` function declares `uses Cfg` but has no such demand — a redundant declaration, rejected
# both-ways exactly as a redundant `!` marker is (context.md §4).
# expect: error
import std::mem::ctx

data Cfg = { Str host }

pub const noop = (Str s): Str uses Cfg -> s

pub const main = () -> {
	const Str h = noop("x")

	return Iarch(h.len)
}
