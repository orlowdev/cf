# a value-if inside a long value loop must not leak stack (merge slots are hoisted):
# 50000 iterations counting evens -> 25000, mod 256 = 168
# expect: exit 168
pub const main = () -> {
	let sum = 0
	let i = 0
	let r = loop {
		if i >= 50000 then <- sum % 256
		sum = sum + (if i % 2 == 0 then 1 else 0)
		i = i + 1
	}
	return r
}
