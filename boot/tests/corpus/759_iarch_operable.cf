# Iarch is usable directly as an array index (the operable-default surface the other
# fixed-width leaves lack); a Bool condition comes from a comparison (`flag != 0`)
# expect: exit 30

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	const [3 Iarch] xs = [10, 20, 30]
	const Iarch i = 2
	const Iarch flag = 1
	return if flag != 0 then xs[i] else 0
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
