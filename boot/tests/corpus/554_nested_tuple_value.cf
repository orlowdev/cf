# a tuple element may itself be a tuple; index through both levels
# expect: exit 10

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	const t = ((1, 2), 3, (4, 0))
	return t[0][0] + t[0][1] + t[1] + t[2][0]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
