# Indexing a `[Union]` yields the union element (an 8-byte boxed pointer, not a truncated
# word), so the element can be passed to a function taking that union and matched.
# expect: exit 7
# check: root
union Shape = { Dot, Box(Iarch) }
const area = (Shape s): Iarch -> {
	let Iarch a = 0
	match s {
		Shape.Box(w) -> { a = w },
		_ -> { a = 0 }
	}
	return a
}

const main_body! = (): Iarch -> {
	let [Shape] xs = [Shape.Box(3), Shape.Dot, Shape.Box(4)]
	return area(xs[0]) + area(xs[2])
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
