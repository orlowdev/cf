# expect: error
# a value const cannot trap an aggregate inside a wider expression — the read's record would
# have no geometry to live in (make the aggregate the whole value, or read inside a function)
data Pt = { Iarch x, Iarch y }
pub const ORIGIN = Pt({ x: 2, y: 3 })
pub const BAD = ORIGIN.x + 1
pub const main = (): Iarch -> BAD
