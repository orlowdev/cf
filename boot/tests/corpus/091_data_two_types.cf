# two distinct record types coexist
# expect: exit 30
data Point = { Iarch x, Iarch y }
data Rect = { Iarch w, Iarch h }

const main_body! = (): Iarch -> {
	const Point p = { x: 2, y: 3 }
	const Rect r = { w: 4, h: 6 }
	return p.x * p.y + r.w * r.h
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
