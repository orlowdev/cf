# An ELASTIC arena's residue chain under the std-source hooks: `grow(256)` mints a lazy
# kind-1 residue subnode, and the recursion stacks ~40 bracketed frames — each holding its
# 16-byte mark RECORD plus a live Box — far past the 256-byte chunk, so `reserve_alloc__el`
# must PULL fresh chunks from the parent mid-chain while the LIFO unwind restores every
# same-chunk mark and skips the pulled ones (the cf_reset leak-once regime). A wrong mark
# interpretation or a bad pull dangles a frame's Box and breaks the sum.
# expect: exit 42
import std::mem::arena::growing_arena
data Box = { Iarch lo, Iarch hi }
const rec! = (Iarch d): Iarch -> {
	if d == 0 then return 0
	const Box s = Box({ lo: d, hi: d * 2 })
	return s.hi - s.lo + rec!(d - 1)
}
pub const main = () -> {
	const ar = growing_arena::of(256)
	const Iarch r = rec!(40) in ar
	return r - 778
}
