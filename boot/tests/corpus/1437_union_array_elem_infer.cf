# an UNANNOTATED array literal of union values infers the union element type — inline in a
# payload position, spliced through a spread, and nested ctor-in-literal (a recursive union)
# expect: exit 6
import std::mem::arena::fixed_arena

union Json = {
	Null,
	JNum(Iarch),
	JArr([Json]),
}

const total = (Json j): Iarch -> match j {
	Json.JArr(xs) -> {
		let sum = 0
		for x in xs sum = sum + total(x)
		<- sum
	},
	Json.JNum(n) -> n,
	_ -> 0,
}

const body! = (): Iarch -> {
	# the payload's array literal carries no annotation — its element type comes from the elements
	const Json j = Json.JArr([Json.JArr([Json.JNum(1), Json.Null]), Json.JNum(2)])
	let [Json] grown = []
	grown = [...grown, Json.JArr([Json.JNum(3)])]
	grown = [...grown, Json.Null]
	return total(j) + total(Json.JArr(grown))
}

pub const main = () -> {
	const a = fixed_arena::of(65536)
	return body!() in a
}
