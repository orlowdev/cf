# a bound over a PAYLOAD union — match narrows to a member and binds its payload
# expect: exit 7
import std::mem::arena::fixed_arena
union Shape = { Circle(Iarch), Square(Iarch) }
pub const measure = [Shape 'T]('T s): Iarch -> match s {
	Shape.Circle(r) -> r,
	Shape.Square(w) -> w,
}

const main_body! = (): Iarch -> {
	return measure[Shape](Shape.Square(7))
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
