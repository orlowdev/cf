# the stringified content of an expression hole is correct: `${a + b}` with a=40,b=2
# renders "42"; the first byte is '4' (ASCII 52)
# expect: exit 52

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let Iarch a = 40
	let Iarch b = 2
	const Str m = "${a + b}"
	return Iarch(m[0])
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
