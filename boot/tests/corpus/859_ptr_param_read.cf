# a callee indexes a `*[Uint8]` buffer passed to it (the lexer pattern: scan shared bytes)
# expect: exit 132
import "std/mem/arena/fixed_arena" as fixed_arena
const at = (*[Uint8] buf, Iarch i): Iarch -> Iarch(buf[i])

const main_body! = (): Iarch -> {
	let [4 Uint8] b
	b[0] = 65
	b[1] = 66
	b[2] = 67
	return at(b, 0) + at(b, 2)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
