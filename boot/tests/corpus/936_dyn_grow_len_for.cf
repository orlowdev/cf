# `[T]` dynamic array: empty, grow via `xs = [...xs, e]`, `.len`, `for` sum, index
# expect: exit 73

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let [Iarch] xs = []
	xs = [...xs, 10]
	xs = [...xs, 20]
	xs = [...xs, 30]
	let Iarch acc = 0
	acc = acc + xs.len
	for x in xs {
		acc = acc + x
	}
	return acc + xs[0]
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
