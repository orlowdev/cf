# a union member may carry an aggregate (record) payload, bound + read in a match
# expect: exit 12
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
union Shape = { Dot(Point), Empty }
const mk = (Iarch a, Iarch b): Point -> {
	const Point p = { x: a, y: b }
	return p
}
const area = (Shape s): Iarch -> match s {
	Shape.Dot(p) -> p.x * p.y,
	Shape.Empty -> 0,
}

const main_body! = (): Iarch -> {
	const Shape s = Shape.Dot(mk(3, 4))
	return area(s)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
