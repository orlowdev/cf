# a value-yielding `loop` yields a UNION; the result is matched
# expect: exit 9
# check: root
union M = { Some(Iarch), None }

const main_body! = (): Iarch -> {
	let M m = loop { <- M.Some(9) }
	return match m { M.Some(x) -> x, M.None -> 0 }
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
