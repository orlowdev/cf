# a record bundles a `*[Iarch]` word-array pointer + count; a helper sums via `t.cells[i]`
# expect: exit 100
data Toks = { *[Iarch] cells, Iarch count }
const sumtoks = (*Toks t): Iarch -> {
	let s = 0
	let i = 0
	loop {
		if i >= t.count then break
		s = s + t.cells[i]
		i = i + 1
	}
	return s
}
pub const main = () -> {
	let [4 Iarch] a = [10, 20, 30, 40]
	const t = Toks({ cells: a, count: 4 })
	return sumtoks(&t)
}
