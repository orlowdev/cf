# a constructed record is a fresh value
# expect: exit 101
# check: root
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point a = Point({ x: 1, y: 2 })
	let Point b = Point({ x: 9, y: 9 })
	b.x = 100
	return a.x + b.x
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
