# a record assembled via spread is an ordinary record — passes through a function
# expect: exit 6
# check: root
data Point = { Iarch x, Iarch y }
data Labeled = { ...Point, Iarch z }
const total = (Labeled p): Iarch -> p.x + p.y + p.z

const main_body! = (): Iarch -> {
	const Labeled p = { x: 1, y: 2, z: 3 }
	return total(p)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
