# a record's tuple field can be destructured directly
# expect: exit 30
import "std/mem/arena/fixed_arena" as fixed_arena
data R = { (Iarch, Iarch) p }

const main_body! = (): Iarch -> {
	const r = R({ p: (10, 20) })
	const (a, b) = r.p
	return a + b
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
