# three fields at offsets 0, 4, 8 — precedence still applies to field reads
# expect: exit 7
import std::mem::arena::fixed_arena
data V = { Iarch a, Iarch b, Iarch c }

const main_body! = (): Iarch -> {
	const V v = { a: 1, b: 2, c: 3 }
	return v.a + v.b * v.c
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
