# `mk!(…) + mk!(…) in b` is not a governed call either: the trailing `in` clause binds to
# the whole sum, which has no geom slot — each call would need its own clause. Refused
# loudly instead of silently falling back to the ambient node.
# expect: error
const mk! = (Iarch n): Iarch -> {
	let [Str] xs = ["x"]
	return n + Iarch(xs.len)
}
const run! = (): Iarch -> {
	const b = mem.arena.of(4096)
	return mk!(10) + mk!(11) in b
}
pub const main = () -> {
	const a = mem.arena.of(65536)
	return run!() in a
}
