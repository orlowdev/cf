# a `[Float64]` dynamic array (previously rejected — its element typed as a word): built from float
# literals (stored `stored` in 8-byte slots) and read by index. 1.5 + 2.5 + 40.0 = 44.0 -> 44.
# expect: exit 44

const main_body! = (): Iarch -> {
	const [Float64] xs = [1.5, 2.5, 40.0]
	return Iarch(xs[0] + xs[1] + xs[2])
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
