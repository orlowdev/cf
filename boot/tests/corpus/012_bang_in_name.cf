# a trailing `!` is the allocation-effect marker on a FUNCTION name; on any other
# var_name it is grammatically permitted but semantically inert (ebnf § Identifiers).
# Here `x!` is an ordinary parameter of `ident` — the `!` rides the identifier and means
# nothing. With no args the count is 1, so this returns 1.
# expect: exit 1
const ident = (Iarch x!): Iarch -> x!

pub const main = ([Str] args) -> ident(Iarch(args.len))
