# a trailing `!` is the allocation-effect marker on a FUNCTION name; on any other
# var_name it is grammatically permitted but semantically inert (ebnf § Identifiers).
# Here `x!` is an ordinary parameter — the `!` rides the identifier and means nothing.
# main receives argc as its first Iarch, so with no args this returns 1.
# expect: exit 1
pub const main = (Iarch x!) -> x!
