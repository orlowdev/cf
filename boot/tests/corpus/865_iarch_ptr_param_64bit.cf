# a 64-bit word round-trips through the `*[Iarch]` pointer (stride 8, storel/loadl)
# expect: exit 10
import std::mem::arena::fixed_arena
const put = (*[Iarch] xs): Iarch -> {
	xs[0] = 100000 * 100000
	return 0
}

const main_body! = (): Iarch -> {
	let [2 Iarch] a = [0, 0]
	const z = put(a)
	return a[0] / 1000000000
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
