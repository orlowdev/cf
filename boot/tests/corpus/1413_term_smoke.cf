# std::io::term smoke test (non-interactive): the ANSI helpers and the termios/winsize ioctls compile
# and run without crashing. `read_key!` is NOT exercised (it blocks on input). On a non-terminal the
# ioctls fail harmlessly and `size!` reads back 0/0, so the result is size-independent → exit 42.
# expect: exit 42
import std::io::term::{ raw_mode!, restore, size!, clear!, hide_cursor!, show_cursor!, reverse!, reset!, TermSize }
import std::mem::arena::growing_arena

const run! = (): Iarch -> {
	let [72 Uint8] tio

	raw_mode!(tio)
	restore(tio)
	hide_cursor!()
	reverse!()
	reset!()
	show_cursor!()
	clear!()

	const TermSize sz = size!()

	if sz.rows >= 0 && sz.cols >= 0 then return 42

	return 0
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return run!() in a
}
