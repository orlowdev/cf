# The inference loop CLOSED: an array-returning lambda works annotated (`: [Iarch]` rides
# bracket-encoded in the closure's bare ret slot) and fully BARE (`(n) -> [n, n, n]` — the
# element-introducing variable derives from the lambda body's array); a generic TEMPLATE with
# an omitted return derives at instance-clone time, so a `match` on its call resolves its arms
# and a same-shape HOF template infers end to end. 18 + 18 + 40 + 2 - 36 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::str::{ eq }
import std::data::maybe::{ Maybe }
import std::data::array::{ chain, reduce, range }

const wrap = ['A]('A x) -> Maybe.Just(x)

const twice = ['A](('A) -> 'A f, 'A x) -> f(f(x))

const main_body = () -> {
	const xs = range(1, 4)
	const s1 = xs |> chain((Iarch n): [Iarch] -> [n, n, n]) |> reduce((a, b) -> a + b, 0)
	const s2 = xs |> chain((n) -> [n, n, n]) |> reduce((a, b) -> a + b, 0)

	const m = wrap("hi")

	const Iarch got = match m { Maybe.Just(v) -> if eq(v, "hi") then 40 else 1, Maybe.Nothing -> 2 }

	return s1 + s2 + got + twice((n) -> n + 1, 0) - 36
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body() in ar
}
