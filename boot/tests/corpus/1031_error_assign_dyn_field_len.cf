# a computed property (`.len` of a `[T]` field, via a deep field chain) is read-only —
# assigning it must be rejected, not mis-lowered into the header's data pointer.
# expect: error
data Ctx = { [Iarch] xs, Iarch pos }
const bad = (*Ctx c): Iarch -> {
	c.xs.len = 5
	return 0
}
pub const main = () -> 0
