# each `[Str]` arg is a real Str borrowing the argv C-string — args[1] is "Zeta", its
# first byte is 'Z' (90), its length 4, so 90 + 4 = 94
# args: Zeta second
# expect: exit 94
pub const main = ([Str] args) -> {
	if Iarch(args.len) < 2 then return 0
	const Str a = args[1]
	return Iarch(a[0]) + a.len
}
