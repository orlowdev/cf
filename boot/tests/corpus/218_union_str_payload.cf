# a union payload may be a `Str` (first-class Str); match binds it
# expect: exit 5
# check: root
union Node = { Wrap(Str), Nil }
const f = (Node n): Iarch -> match n {
	Node.Wrap(s) -> s.len,
	Node.Nil -> 0
}

const main_body! = (): Iarch -> f(Node.Wrap("hello"))

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
