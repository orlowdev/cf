# an aggregate `if` branch MAY be a bare variable — it aliases an arena aggregate, which is
# memory-safe in cfcc (the single bump arena never frees). `pick` returns whichever param the
# condition selects. c=0 selects `b` (x=5).
# expect: exit 5
data P = { Iarch x }
const pick = (P a, P b, Iarch c): P -> if c > 0 then a else b
pub const main = () -> {
	const P got = pick(P({ x: 3 }), P({ x: 5 }), 0)
	return got.x
}
