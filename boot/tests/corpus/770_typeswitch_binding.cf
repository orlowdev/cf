# a type-switch arm binds the value at its width; the same generic dispatches per instantiation
# (Iarch arm here: 3 * 100 = 300, exit byte 44)
# expect: exit 44
pub const scale = [Int 'T]('T x): Iarch -> match x {
	Int.Int8(v) -> Iarch(v) * 10,
	Int.Iarch(v) -> Iarch(v) * 100,
	_ -> 0,
}
pub const main = () -> scale[Iarch](Iarch(3))
