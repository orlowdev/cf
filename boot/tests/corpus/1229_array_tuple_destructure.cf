# destructuring a tuple binds an array position as a `[T]` local, then indexed as usual. 30 + 2 = 32.
# expect: exit 32

# check: root
const main_body! = (): Iarch -> {
	const (xs, n) = ([10, 20, 30], 2)
	return xs[2] + n
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
