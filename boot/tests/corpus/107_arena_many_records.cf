# several records get distinct arena storage (the bump advances, no overlap)
# expect: exit 100
import std::mem::arena::fixed_arena
data Pair = { Iarch a, Iarch b }

const main_body! = (): Iarch -> {
	const Pair p = { a: 1, b: 2 }
	const Pair q = { a: 10, b: 20 }
	const Pair r = { a: 30, b: 37 }
	return p.a + p.b + q.a + q.b + r.a + r.b
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
