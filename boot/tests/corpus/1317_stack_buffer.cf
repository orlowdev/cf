# A `$[N Uint8]` byte buffer lives on the STACK — the no-heap scratch / embedded case. `$buf` is
# written and read by index and reports `$buf.len` (its fixed capacity), all in a frame slot with no
# geometry and no `cf_alloc`; it is reclaimed when the frame pops.
# expect: exit 106
const work = (): Iarch -> {
	let [64 Uint8] $buf
	$buf[3] = 42
	return Iarch($buf[3]) + Iarch($buf.len)
}
pub const main = () -> work()
