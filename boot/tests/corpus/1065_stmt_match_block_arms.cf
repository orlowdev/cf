# a standalone (statement-position) `match` runs an arm for its side effects, its value
# discarded — each arm is a `{ … }` block reassigning the enclosing `let acc`
# expect: exit 121
# check: root
union K = { A, B, C }

const main_body! = (): Iarch -> {
	let Iarch acc = 0
	let [K] ks = [K.A, K.B, K.C, K.B]
	let Iarch i = 0
	loop {
		if i >= Iarch(ks.len) then break
		const K k = ks[i]
		match k {
			K.A -> { acc = acc + 1 },
			K.B -> { acc = acc + 10 },
			K.C -> { acc = acc + 100 },
		}
		i = i + 1
	}
	return acc
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
