# a RECURSIVE aggregate has no bounded inline textual form (emit_stringify would emit unbounded
# code), so a recursive-union interpolation hole is rejected
# expect: error
union List = { Nil, Cons(Iarch, List) }
pub const main = () -> {
	const List xs = List.Cons(1, List.Nil)
	const Str m = "${xs}"
	return m.len
}
