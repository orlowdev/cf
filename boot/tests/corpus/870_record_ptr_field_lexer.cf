# a record BUNDLES a `*[Uint8]` source pointer + cursor (a Lexer), passed by `*Lexer`;
# peek reads a byte through the field, advance mutates the cursor through the pointer
# expect: exit 209
data Lexer = { *[Uint8] src, Iarch pos, Iarch len }
const peek = (*Lexer lx): Iarch -> Iarch(lx.src[lx.pos])
const advance = (*Lexer lx): Iarch -> {
	lx.pos = lx.pos + 1
	return lx.pos
}

const main_body! = (): Iarch -> {
	let [8 Uint8] buf
	buf[0] = 104
	buf[1] = 105
	let lx = Lexer({ src: buf, pos: 0, len: 2 })
	const c0 = peek(&lx)
	const p = advance(&lx)
	const c1 = peek(&lx)
	return c0 + c1
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
