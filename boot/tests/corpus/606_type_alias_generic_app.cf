# an alias of a generic application `Box[Iarch]` — the mangled instance splices in.
# expect: exit 42
data Box['T] = { 'T v }
type IntBox = Box[Iarch]

const main_body! = (): Iarch -> {
	const IntBox b = { v: 42 }
	return b.v
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
