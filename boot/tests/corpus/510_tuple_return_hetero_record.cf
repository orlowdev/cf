# a returned tuple carrying a record element; index it and read a field
# expect: exit 30
data P = { Iarch x, Iarch y }
const mk = (Iarch a, Iarch b): P -> P({ x: a, y: b })
const split = (Iarch n): (Iarch, P) -> (n, mk(n, n * 2))
pub const main = () -> {
	const t = split(10)
	return t[0] + t[1].y
}
