# After `&` lands, a bare record value no longer implicitly becomes a `*Point` — a `*Point`
# parameter requires an explicit `&`.
# expect: error
data Point = { Iarch x, Iarch y }
const use_ptr = (*Point p): Iarch -> p.x
pub const main = () -> {
	const Point pt = { x: 1, y: 2 }
	return use_ptr(pt)
}
