# A RECURSIVE higher-order function passed a capturing closure: the HOF specializes into a clone
# whose recursive call retargets the same clone (name-keyed dedup), so recursion terminates like
# any other. rec(addbase, 5) = f(5) + rec(f, 0) = 6 + 0 = 6. (Formerly a v1 inlining rejection.)
# expect: exit 6
const rec = ((Iarch) -> Iarch f, Iarch n): Iarch -> if n == 0 then n else f(n) + rec(f, 0)

const run = (): Iarch -> {
	let Iarch base = 1
	const addbase = (Iarch k): Iarch -> base + k

	return rec(addbase, 5)
}

pub const main = () -> run()
