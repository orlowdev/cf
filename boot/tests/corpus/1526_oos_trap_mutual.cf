# MUTUAL runaway recursion traps too: the probe set is a feedback vertex set over the call
# graph (one probed function per cycle), so a ping↔pong loop passes a probe every lap and
# exits through `cf_oos` (72) instead of the raw guard-page SIGSEGV. Shallow mutual recursion
# below the threshold still completes.
# expect: exit 72
const ping = (Int n): Int -> {
	if n == 0 then return 0

	return pong(n - 1) + 1
}

const pong = (Int n): Int -> {
	if n == 0 then return 0

	return ping(n - 1) + 2
}

pub const main = (): Int -> {
	if ping(1000) != 1500 then return 1

	return ping(100000000)
}
