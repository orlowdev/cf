# growing a `[Float64]` array by value-spread `[...xs, e]` copies the float slots and appends a fresh
# float, then a `for` sums them. 1 + 2 + 39 = 42.
# expect: exit 42

# check: root
const main_body! = (): Iarch -> {
	let [Float64] xs = [1.0, 2.0]
	xs = [...xs, 39.0]
	let Float64 acc = 0.0
	for x in xs {
		acc = acc + x
	}
	return Iarch(acc)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
