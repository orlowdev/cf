# growing a `[Float64]` array by value-spread `[...xs, e]` copies the float slots and appends a fresh
# float, then a `for` sums them. 1 + 2 + 39 = 42.
# expect: exit 42
pub const main = () -> {
	let [Float64] xs = [1.0, 2.0]
	xs = [...xs, 39.0]
	let Float64 acc = 0.0
	for x in xs {
		acc = acc + x
	}
	return Iarch(acc)
}
