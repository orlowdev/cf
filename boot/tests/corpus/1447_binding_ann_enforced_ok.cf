# Truthful named annotations bind and run: `Str`/`Bool`/a union/`Iarch`, a `Float64` bare
# literal (the literal default), and a cast `Float32` value.
# expect: exit 7
union Shape = { Dot, Wide }

pub const main = (): Iarch -> {
	const Str s = "hi"
	const Bool b = true
	const Shape sh = Shape.Dot
	const Iarch n = 2
	const Float64 d = 2.5
	const Float32 f = Float32(1.5)
	let Iarch out = 0
	if b then out = out + n
	out = out + Iarch(d + 2.5)
	if Iarch(s.len) == 2 then out = out + Iarch(f - Float32(1.5))

	return out + 0
}
