# bind a `*Record` field to a local, unannotated (`const q = o.p`) — the traversal pattern
# expect: exit 42
import std::mem::arena::fixed_arena
data Inner = { Iarch v }
data Outer = { *Inner p, Iarch tag }

const main_body! = (): Iarch -> {
	let Inner i = { v: 42 }
	let Outer o = { p: &i, tag: 1 }
	const q = o.p
	return q.v
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
