# a fixed-width `Uint8` union payload, constructed and match-bound (sub-word loadw)
# expect: exit 200
union Tok = { Kw(Uint8), Nil }
const f = (Tok t): Iarch -> match t {
	Tok.Kw(k) -> Iarch(k),
	Tok.Nil -> 0
}

const main_body! = (): Iarch -> f(Tok.Kw(Uint8(200)))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
