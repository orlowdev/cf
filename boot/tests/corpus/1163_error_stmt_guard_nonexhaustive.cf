# a statement guarded match where a member is only GUARD-covered (no unguarded arm
# for `A` and no `_`) is not exhaustive
# expect: error
union M = { A(Iarch), B }
const f = (M m): Iarch -> {
	let Iarch a = 0
	match m { M.A(0) -> { a = 1 }, M.B -> { a = 2 } }
	return a
}
pub const main = () -> f(M.B)
