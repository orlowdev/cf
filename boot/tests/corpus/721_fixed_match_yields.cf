# a match arm may yield a fixed-width value (arms merge through the scalar slot)
# expect: exit 20
union Color = { Red, Green, Blue }
pub const f = (Color c): Uint8 -> match c {
	Color.Red -> Uint8(10),
	Color.Green -> Uint8(20),
	Color.Blue -> Uint8(30),
}
pub const main = () -> Iarch(f(Color.Green))
