# a `[Str]` field constructed and read (element 0's length).
# expect: exit 3
data Bag = { [Str] items }

const main_body! = (): Iarch -> {
	let [Str] v = ["abc"]
	const Bag b = Bag({items: v})
	return Iarch(b.items[0].len)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
