# a `defer` body runs in the enclosing frame at scope exit, so residue it constructs is the enclosing
# function's — `run!` is `!` although its main body allocates nothing.
# expect: exit 0
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Iarch v }
const run! = (): Iarch -> {
	defer {
		const P p = { v: 9 }
	}
	return 0
}
pub const main = () -> {
	const a = fixed_arena.of(4096)
	return run!() in a
}
