# destructuring a tuple binds a `Float64` position to a float local (its cell carries the float
# scalar, so it reloads with `loadd`). 41 + 1 = 42.
# expect: exit 42

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	const (a, n) = (41.5, 1)
	return Iarch(a) + n
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
