# a tuple yielded from an `if` (fresh tuple constructions), destructured
# expect: exit 30

import "std/mem/arena/fixed_arena" as fixed_arena
const main_body! = (): Iarch -> {
	const t = if 1 > 0 then (10, 20) else (1, 2)
	const (a, b) = t
	return a + b
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
