# a `Bool` tuple element (`t[0]` reads the word 0/1, used as an `if` condition).
# expect: exit 9

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	const t = (true, 9)
	return if t[0] then t[1] else 0
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
