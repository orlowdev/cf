# The payoff: deferred closure calls mutate a captured record at scope exit. The
# record is returned (a live arena pointer), so the caller reads the post-defer
# value: two deferred bumps take c.v from 0 to 2.
# expect: exit 2
data Cell = { Iarch v }
const run = (): Cell -> {
	let Cell c = { v: 0 }
	const bump = () -> {
		c.v = c.v + 1
		return c.v
	}
	defer bump()
	defer bump()
	return c
}
pub const main = () -> run().v
