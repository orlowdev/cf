# A single `$`-stack allocation is capped (64 KiB) so one binding cannot blow the frame — a buffer
# this large belongs in a geometry. The size is comptime-known, so this is a compile error.
# expect: error
const work = (): Iarch -> {
	let [100000 Uint8] $buf
	return Iarch($buf.len)
}
pub const main = () -> work()
