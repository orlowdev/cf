# The elastic residue-carve, frame slice (test 1355's elastic twin): a per-call elastic
# child in a helper whose survivor mark is DISQUALIFIED (*Acc param) — the frame's residue
# bracket reclaims header + initial block + the pull eat! forces. 20 calls x ~165KiB
# through a 1MiB parent fit only under the interlock.
# expect: exit 42
data Acc = { Iarch n }
const eat! = (Iarch k): Iarch -> {
	let [102400 Uint8] buf
	return k
}
const helper2! = (*Acc a, Iarch k): Iarch -> {
	const b = mem.arena.grow(65536)
	const Iarch r = eat!(k) in b
	a.n = a.n + 1
	return r
}
const main_body! = (): Iarch -> {
	let Acc acc = Acc({ n: 0 })
	let Iarch i = 0
	loop {
		if i >= 20 then break
		helper2!(&acc, i)
		i = i + 1
	}
	return acc.n + 22
}
pub const main = () -> {
	const a = mem.arena.of(1048576)
	return main_body!() in a
}
