# a bound on a generic DATA type parameter `data Tagged[Color 'T]`
# expect: exit 5
# check: root
union Color = { Red, Green, Blue }
data Tagged[Color 'T] = { 'T c, Iarch n }

const main_body! = (): Iarch -> {
	const Tagged[Color] t = { c: Color.Green, n: 5 }
	return t.n
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
