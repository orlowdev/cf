# a `[N *Record]` array: pointer elements (borrowed refs), indexed + field-read
# expect: exit 42
import std::mem::arena::fixed_arena
data Box = { Iarch v }

const main_body! = (): Iarch -> {
	let Box a = { v: 7 }
	let Box b = { v: 35 }
	const [2 *Box] ns = [&a, &b]
	return ns[0].v + ns[1].v
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
