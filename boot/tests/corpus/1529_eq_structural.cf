# `==`/`!=` is STRUCTURAL and near-universal (type_system §5): Bool by value, `Str` by
# bytes, records/arrays/tuples element-wise, unions by tag then payload.
# expect: exit 0
import std::mem::arena::fixed_arena

data P = { Iarch x, Str tag, [Iarch] ns }

union M = { Some(Iarch), None }

const body! = (): Iarch -> {
	const Bool t = true
	if (t == true) != true then return 1
	if t != true then return 2
	const Str a = "hello"
	if a != "hello" then return 3
	if a == "world" then return 4
	const P p1 = P({ x: 4, tag: "k", ns: [1, 2, 3] })
	const P p2 = P({ x: 4, tag: "k", ns: [1, 2, 3] })
	const P p3 = P({ x: 4, tag: "k", ns: [1, 2, 9] })
	if p1 != p2 then return 5
	if p1 == p3 then return 6
	const [Str] xs = ["a", "b"]
	const [Str] ys = ["a", "b"]
	const [Str] zs = ["a", "c"]
	if xs != ys then return 7
	if xs == zs then return 8
	const tu = (7, "q")
	const tv = (7, "q")
	const tw = (8, "q")
	if tu != tv then return 9
	if tu == tw then return 10
	const M m1 = M.Some(5)
	const M m2 = M.Some(5)
	const M m3 = M.Some(6)
	const M m4 = M.None
	if m1 != m2 then return 11
	if m1 == m3 then return 12
	if m1 == m4 then return 13
	if m4 != M.None then return 14

	return 0
}

pub const main = () -> {
	const a = fixed_arena::of(65536)
	return body!() in a
}
