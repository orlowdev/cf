# a parenthesized record literal works in an annotated binding too
# expect: exit 7
# check: root
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point p = ({ x: 3, y: 4 })
	return p.x + p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
