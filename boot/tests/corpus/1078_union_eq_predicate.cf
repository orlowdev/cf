# a tag-equality predicate `is_b(k) = k == K.B` — the pattern cf's token `is_*` use
# expect: exit 7
union K = { A, B, C }
const is_b = (K k): Bool -> k == K.B
pub const main = () -> {
	let Iarch acc = 0
	const K x = K.B
	const K y = K.A
	if is_b(x) then acc = acc + 5
	if is_b(y) then acc = acc + 1
	if !is_b(y) then acc = acc + 2
	return acc
}
