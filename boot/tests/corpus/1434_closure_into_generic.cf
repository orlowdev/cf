# A LOCAL closure (named, or an anonymous lambda's hoisted name) passes to a GENERIC function:
# the monomorph pass types local closures in its value environment, so the argument resolves like
# any function reference. 20 + 22 = 42.
# expect: exit 42
import std::mem::arena::growing_arena

const mymap = ['A, 'B](('A) -> 'B f, ['A] xs): ['B] -> {
	let ['B] out = []

	for x in xs out = [...out, f(x)]

	return out
}

const run! = (): Iarch -> {
	const doubler = (Iarch n): Iarch -> n * 2
	const named = mymap[Iarch, Iarch](doubler, [10, 11])
	const anon = mymap[Iarch, Iarch]((Iarch n): Iarch -> n - 1, [10, 13])

	if anon[0] != 9 || anon[1] != 12 then return 1

	return named[0] + named[1]
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return run!() in a
}
