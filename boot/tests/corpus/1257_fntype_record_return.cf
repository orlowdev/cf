# a function type may RETURN a record: `(Iarch) -> Point`. An indirect call binds the aggregate
# result. `mk(5)` = Point({5,5}); 5+5 = 10.
# expect: exit 10
data Point = { Iarch x, Iarch y }
const mk = (Iarch v): Point -> Point({ x: v, y: v })
const callit = ((Iarch) -> Point g): Iarch -> {
	const Point p = g(5)
	return p.x + p.y
}
pub const main = () -> callit(mk)
