# a boxed union yielded from `match` arms (the AST reclassify pattern) — fresh constructions
# expect: exit 105
import "std/mem/arena/fixed_arena" as fixed_arena
union E = { A(Iarch), B(Iarch) }
const flip = (E e): E -> match e { E.A(n) -> E.B(n), E.B(n) -> E.A(n) }
const unwrap = (E e): Iarch -> match e { E.A(n) -> n, E.B(n) -> n + 100 }

const main_body! = (): Iarch -> {
	const E x = flip(E.A(5))
	return unwrap(x)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
