# a PascalCase type namespace: `import "m" as Shapes` reaches the module's exported
# types as `shapes::Point` — usable as a type annotation and a record constructor,
# both rewritten to the mangled type on flatten
# expect: exit 42
import shapes

const shift = (shapes::Point p): Iarch -> p.x + p.y

pub const main = () -> {
	const shapes::Point q = shapes::Point({ x: 40, y: 2 })
	return shift(q)
}
