# a field value may read an earlier local and compute
# expect: exit 11
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const n = 5
	const Point p = { x: n, y: n + 1 }
	return p.x + p.y
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
