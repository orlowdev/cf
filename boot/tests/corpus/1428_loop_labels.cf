# Loop LABELS (ebnf loop_expr): `loop outer { ... }` opens a target a nested `break outer` /
# `continue outer` may name — break exits the labeled loop, continue jumps to its next iteration.
# An unlabeled exit still targets the nearest loop. 40 + 4 - 2 = 42.
# expect: exit 42
pub const main = () -> {
	let Iarch s = 0
	let Iarch i = 0

	loop outer {
		let Iarch j = 0

		loop {
			if j >= 10 then break
			s = s + 1
			if s >= 40 then break outer
			j = j + 1
		}

		i = i + 1
		if i >= 100 then break
	}

	let Iarch k = 0
	let Iarch c = 0

	loop again {
		k = k + 1
		if k > 4 then break

		loop {
			c = c + 1
			continue again
		}
	}

	return s + c - 2
}
