# std::data::array queries: `find` hands back a `Maybe`, `find_index` an index (`not_found` on a
# miss), `some`/`every` quantify a predicate, `is_empty` checks the length. 1 + 2 + 39 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::{ Maybe }
import std::data::array::{ find, find_index, not_found, some, every, is_empty, range }

const odd = (Iarch n): Bool -> n - (n / 2) * 2 == 1

const main_body! = (): Iarch -> {
	const xs = range(1, 6)

	const hit = xs |> find[Iarch](odd)
	const h = match hit {
		Maybe.Just(v) -> v,
		Maybe.Nothing -> 0,
	}

	const none = [2, 4] |> find[Iarch](odd)
	const miss = match none {
		Maybe.Just(v) -> v,
		Maybe.Nothing -> 39,
	}

	const fi = find_index(odd, [2, 4, 5])
	if find_index(odd, [2, 4]) != not_found then return 1

	if !some(odd, xs) || some(odd, [2, 4]) then return 2
	if !every(odd, [1, 3]) || every(odd, xs) then return 3

	let [Iarch] empty = []
	if !is_empty(empty) || is_empty(xs) then return 4

	return h + fi + miss
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body!() in ar
}
