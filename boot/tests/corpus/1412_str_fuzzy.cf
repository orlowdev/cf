# std::data::str fuzzy matching: `fuzzy_score` is a case-insensitive subsequence score (higher = tighter,
# earlier match), `no_match` for a non-subsequence. "rf" matches "read_file" (r...f) but not "read_dir"
# (no f after r), and matches "read_file" better than "surf" (start bonus). Confirm the ordering →
# exit 42.
# expect: exit 42
import std::data::str::{ fuzzy_score, no_match, eq, starts_with }

pub const main = () -> {
	const Iarch hit = fuzzy_score("rf", "read_file")
	const Iarch miss = fuzzy_score("rf", "read_dir")
	const Iarch late = fuzzy_score("rf", "surf")

	if hit > 0 && miss == no_match && hit > late && eq("ab", "ab") && starts_with("ab", "abc")
		then return 42

	return 0
}
