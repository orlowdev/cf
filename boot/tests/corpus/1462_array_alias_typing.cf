# An aggregate binding from a bare local name keeps its full typing: a record-array
# alias dispatches `qs[i].field`, and a `[Uint8]` alias reads with stride 1 (the
# emit binding propagates the source's element type through `init_elem`).
# expect: exit 47
import std::mem::arena::growing_arena

data Point = { Iarch x }

const body! = (): Iarch -> {
	let [Point] ps = []
	ps = [...ps, Point({ x: 42 })]
	const [Point] qs = ps

	let [Uint8] bs = []
	bs = [...bs, Uint8(2)]
	bs = [...bs, Uint8(3)]
	const [Uint8] cs = bs

	return qs[0].x + Iarch(cs[0]) + Iarch(cs[1])
}

pub const main = (): Iarch -> {
	const a = growing_arena::of(4096)

	return body!() in a
}
