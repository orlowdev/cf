# a recursive generic union infers `'T` from the first bare-`'T` payload position
# (`List.Cons(7, &e)` — the nested `*List['T]` position is skipped)
# expect: exit 7
# check: root
union List['T] = { Cons('T, *List['T]), Nil }
const head = ['T](List['T] xs, 'T d): 'T -> match xs {
	List.Cons(h, t) -> h,
	List.Nil -> d,
}

const main_body! = (): Iarch -> {
	const List[Iarch] e = List[Iarch].Nil
	const List[Iarch] xs = List.Cons(7, &e)
	return head(xs, 0)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
