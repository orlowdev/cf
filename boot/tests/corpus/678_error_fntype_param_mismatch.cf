# A function value whose PARAMETER type differs from the function-type parameter is
# rejected: `wide` takes a `Uarch` where an `(Iarch) -> Iarch` is expected.
# expect: error
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const wide = (Uarch n): Iarch -> 0
pub const main = () -> apply(wide, 5)
