# Type-argument INFERENCE through a function-typed parameter: a HOF call carries no brackets —
# `'A`/`'B` are read out of the function argument's signature (a lambda's declared types, a named
# function's) and the subject array, matched structurally against `('A) -> 'B`. A `Bool`- or
# array-returning position infers the same way (`filter`'s predicate, `chain`'s builder); the
# explicit `map[Iarch, Iarch](f)` spelling stays valid (1425/1433 exercise it).
# 30 + 9 + 10 + 30 - 37 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::array::{ map, filter, reduce, chain, range }

const double = (Iarch n): Iarch -> n * 2
const pair = (Iarch n): [Iarch] -> [n, n]

const main_body! = (): Iarch -> {
	const xs = range(1, 6)

	const s1 = xs
		|> map((Iarch n) -> n * 2)
		|> reduce((Iarch a, Iarch b) -> a + b, 0)

	const s2 = xs
		|> filter((Iarch n): Bool -> n - (n / 2) * 2 == 1)
		|> reduce((Iarch a, Iarch b) -> a + b, 0)

	const s3 = [2, 3] |> chain(pair) |> reduce((Iarch a, Iarch b) -> a + b, 0)
	const s4 = map(double, xs) |> reduce((Iarch a, Iarch b) -> a + b, 0)

	return s1 + s2 + s3 + s4 - 37
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body!() in ar
}
