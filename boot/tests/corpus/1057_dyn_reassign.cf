# a `let [T]` may be reassigned as a whole: reset to empty `[]` then re-grown, and
# repointed to another vector — the slot holds the header pointer, so it repoints
# expect: exit 4

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let [Iarch] xs = [1, 2, 3]
	xs = []
	xs = [...xs, 7]
	xs = [...xs, 8]
	const [Iarch] ys = [9, 9, 9]
	xs = ys
	return xs.len + 1
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
