# ZERO-ROOT mode (`--target bare-arm64 --root-size 0`): the static root page has no bytes, so the
# binary provably never dynamically allocates. `main`'s normal exemption (it may spill onto the root)
# is revoked — constructing a `Box` on the page here is a compile error. Legal storage is `$`-stack,
# `static` BSS, or a `fixed_buffer`. (Under a sized root this same program compiles fine.)
# expect: error
# cf-flags: --target bare-arm64 --root-size 0
data Box = { Iarch lo, Iarch hi }
pub const main = () -> {
	const Box b = { lo: 3, hi: 24 }
	return b.hi - b.lo
}
