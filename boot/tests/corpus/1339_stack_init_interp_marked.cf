# The positive twin of 1338: the same `$`-scalar binding whose initializer interpolates (a node
# allocation) is fine once the function wears the `!` it earns — the residue is the interp Str,
# not the `$` cell.
# expect: exit 4
import "std/mem/arena/growing_arena" as growing_arena
const f! = (Iarch y): Iarch -> {
	const $n = "x${y}z".len
	if $n >= 3 then return 4
	return 0
}
pub const main = () -> {
	const a = growing_arena.of(4096)
	return f!(7) in a
}
