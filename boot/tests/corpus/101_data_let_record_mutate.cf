# a `let` record is mutable: a field may be reassigned with `p.field = expr`
# expect: exit 14
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	let Point p = { x: 3, y: 4 }
	p.x = 10
	return p.x + p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
