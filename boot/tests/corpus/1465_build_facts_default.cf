# The `build::` comptime facts (module_system): a comptime `if` on `build::debug`
# selects declarations at parse (default build: the else branch), and a VALUE
# reference folds to a 0/1 immediate — this unflagged corpus build sees both false.
# expect: exit 3
import std::comptime::build

if build::debug then {
	const mode = (): Iarch -> 1
} else {
	const mode = (): Iarch -> 3
}

pub const main = (): Iarch -> {
	if build::instrument then return 99

	return mode()
}
