# a spread carries a record element's pointer into the new tuple
# expect: exit 27
import "std/mem/arena/growing_arena" as growing_arena
data P = { Iarch x }
const mk = (Iarch a): P -> P({ x: a })

const main_body! = (): Iarch -> {
	const t = (2, mk(25))
	const u = (...t, 0)
	return u[0] + u[1].x
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
