# a record field value may be a bare record variable (an alias) — the same arena record
# rides into both fields; safe in the never-freed bump arena (M0)
# expect: exit 1
import std::mem::arena::fixed_arena
data Point = { Iarch x, Iarch y }
data Line = { Point a, Point b }

const main_body! = (): Iarch -> {
	const Point p = { x: 1, y: 2 }
	const Line l = { a: p, b: p }
	return l.a.x
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
