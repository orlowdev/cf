# std::str transforms build fresh owned strings, data-last: ASCII case folding (`to_lower`/
# `to_upper`), whitespace trims (`trim`/`trim_start`/`trim_end`), `repeat`, and left-to-right
# `replace` that never rescans what a replacement produced.
# expect: exit 42
import std::str::{ eq, is_empty, to_lower, to_upper, trim, trim_start, trim_end, repeat, replace }

pub const main = () -> {
	if !eq(to_lower("Hello, World!"), "hello, world!") then return 1
	if !eq(to_upper("Hello, World!"), "HELLO, WORLD!") then return 2
	if !eq(trim("\t  hi \n"), "hi") then return 3
	if !eq(trim_start("\t hi "), "hi ") then return 4
	if !eq(trim_end(" hi \n"), " hi") then return 5
	if !is_empty(trim("  \n\t ")) then return 6
	if !eq(repeat(3, "ab"), "ababab") then return 7
	if !is_empty(repeat(0, "ab")) then return 8
	if !eq(replace("l", "L", "hello"), "heLLo") then return 9
	if !eq(replace("aa", "b", "aaaa"), "bb") then return 10
	if !eq(replace("x", "y", "hello"), "hello") then return 11

	return 42
}
