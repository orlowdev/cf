# a `let` record's aggregate field can be reassigned to a fresh value
# expect: exit 10
# check: root
data Point = { Iarch x, Iarch y }
data Box = { Point p }
const mk = (Iarch a): Point -> {
	const Point q = { x: a, y: a }
	return q
}

const main_body! = (): Iarch -> {
	let Box b = { p: mk(1) }
	b.p = mk(5)
	return b.p.x + b.p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
