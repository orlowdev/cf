# a `[T]` param forwards to another `[T]` param (the borrow rides through unchanged).
# expect: exit 7
import "std/mem/arena/fixed_arena" as fixed_arena
data Tok = { Iarch v }
const inner = ([Tok] ts): Iarch -> ts[0].v
const outer = ([Tok] ts): Iarch -> inner(ts)

const main_body! = (): Iarch -> {
	let [Tok] t = [Tok({v: 7})]
	return outer(t)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
