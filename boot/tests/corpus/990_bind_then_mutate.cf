# bind a pointer field to a local, then mutate through the borrow
# expect: exit 99
import "std/mem/arena/fixed_arena" as fixed_arena
data Inner = { Iarch v }
data Outer = { *Inner p }

const main_body! = (): Iarch -> {
	let Inner i = { v: 9 }
	let Outer o = { p: &i }
	const q = o.p
	q.v = 99
	return i.v
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
