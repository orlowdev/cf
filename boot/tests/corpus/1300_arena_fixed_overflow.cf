# A FIXED arena is bounded: it is carved with committed == limit, so an allocation past its size
# traps (cf_oom, exit 70) rather than growing. Here a 1 MiB buffer is requested inside a 4 KiB
# arena. The same allocation on the page succeeds — the bound is the arena's, exercised via `in a`.
# expect: exit 70
const fill! = (Iarch k): Iarch -> {
	let [1048576 Uint8] buf
	return k
}
pub const main = () -> {
	const a = mem.arena.of(4096)
	const Iarch r = fill!(7) in a
	return r
}
