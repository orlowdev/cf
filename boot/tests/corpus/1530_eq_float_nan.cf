# floats follow IEEE under `==` (type_system §2.2/§5): `NaN != NaN`, `==` is not
# reflexive, and an aggregate containing NaN is not self-equal.
# expect: exit 0
import std::mem::arena::fixed_arena

data W = { Float64 v }

const body! = (): Iarch -> {
	const Float64 z = 0.0
	const Float64 n = z / z
	if n == n then return 1
	if !(n != n) then return 2
	const W w1 = W({ v: n })
	if w1 == w1 then return 3
	const Float64 x = 1.5
	if x != 1.5 then return 4

	return 0
}

pub const main = () -> {
	const a = fixed_arena::of(65536)
	return body!() in a
}
