# `==` on a payload union is structural (type_system §5): tag first, then the matched
# member's payload
# expect: exit 1
import std::mem::arena::fixed_arena
union N = { Lit(Iarch), Nil }

const body! = (): Iarch -> {
	const N a = N.Lit(7)
	const N b = N.Lit(7)
	const N c = N.Lit(8)
	const N d = N.Nil
	if a != b then return 0
	if a == c then return 0
	if a == d then return 0
	if d != N.Nil then return 0

	return 1
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return body!() in a
}
