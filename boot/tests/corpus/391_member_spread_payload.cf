# member spread carries payload members, bound + read in a match
# expect: exit 16
import std::mem::arena::growing_arena
union Leaf = { Lit(Iarch), Nil }
union Node = { ...Leaf, Pair(Iarch, Iarch) }
const eval = (Node n): Iarch -> match n {
	Node.Lit(v) -> v,
	Node.Nil -> 0,
	Node.Pair(a, b) -> a + b,
}

const main_body! = (): Iarch -> {
	const Node p = Node.Pair(4, 5)
	const Node l = Node.Lit(7)
	return eval(p) + eval(l)
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
