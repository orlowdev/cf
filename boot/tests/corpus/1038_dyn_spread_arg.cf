# value-level array spread in ARGUMENT position: `sumv([...xs, e])` passes a fresh copy-append
# vector as a call argument. 10 + 20 + 30 + 40 = 100.
# expect: exit 100
import std::mem::arena::growing_arena
const sumv = ([Iarch] xs): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(xs.len) then break
		acc = acc + xs[i]
		i = i + 1
	}
	return acc
}

const main_body! = (): Iarch -> {
	const [Iarch] xs = [10, 20, 30]
	return sumv([...xs, 40])
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
