# a statement-position match binds a payload in a block arm and uses it for effect
# expect: exit 9
import "std/mem/arena/growing_arena" as growing_arena
union Ev = { Add(Iarch), Reset }

const main_body! = (): Iarch -> {
	let Iarch acc = 0
	let [Ev] es = [Ev.Add(5), Ev.Add(3), Ev.Reset, Ev.Add(9)]
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		const Ev e = es[i]
		match e {
			Ev.Add(n) -> { acc = acc + n },
			Ev.Reset -> { acc = 0 },
		}
		i = i + 1
	}
	return acc
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
