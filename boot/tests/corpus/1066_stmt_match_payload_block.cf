# a statement-position match binds a payload in a block arm and uses it for effect
# expect: exit 9
union Ev = { Add(Iarch), Reset }
pub const main = () -> {
	let Iarch acc = 0
	let [Ev] es = [Ev.Add(5), Ev.Add(3), Ev.Reset, Ev.Add(9)]
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		const Ev e = es[i]
		match e {
			Ev.Add(n) -> { acc = acc + n },
			Ev.Reset -> { acc = 0 },
		}
		i = i + 1
	}
	return acc
}
