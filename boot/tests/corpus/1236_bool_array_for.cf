# a `for` over a `[Bool]` binds a Bool loop variable; count the true elements. 3 of 4 are true.
# expect: exit 3

const main_body! = (): Iarch -> {
	const [Bool] xs = [true, false, true, true]
	let Iarch c = 0
	for b in xs {
		if b then c = c + 1
	}
	return c
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
