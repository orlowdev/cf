# A closure captures an enclosing `let` by reference; calling it mutates the
# variable, and the enclosing scope observes the change. bump(5) then bump(2)
# drive i from 10 to 17.
# expect: exit 17
const run = (): Iarch -> {
	let Iarch i = 10
	const bump = (Iarch k) -> {
		i = i + k
		return i
	}
	const a = bump(5)
	const b = bump(2)
	return i
}
pub const main = () -> run()
