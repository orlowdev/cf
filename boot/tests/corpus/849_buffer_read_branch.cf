# read a byte and branch on it (the lexer pattern: scan bytes, compare) via a value-if
# expect: exit 98

import std::mem::arena::fixed_arena
const main_body! = (): Iarch -> {
	let [4 Uint8] buf
	buf[0] = 97
	buf[1] = 98
	return if Iarch(buf[0]) == 97 then Iarch(buf[1]) else 0
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
