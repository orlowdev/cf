# a callee writes through a `*[Uint8]` param; the caller sees the mutated bytes (emitter pattern)
# expect: exit 134
# check: root
const fill = (*[Uint8] buf, Iarch n): Iarch -> {
	let i = 0
	loop {
		if i >= n then break
		buf[i] = Uint8(65 + i)
		i = i + 1
	}
	return n
}

const main_body! = (): Iarch -> {
	let [8 Uint8] b
	const w = fill(b, 5)
	return Iarch(b[0]) + Iarch(b[4])
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
