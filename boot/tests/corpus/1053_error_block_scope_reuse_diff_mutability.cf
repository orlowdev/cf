# a reused sibling-block name must keep the same const/let (both share one slot, and resolve_name
# reports the first binding's mutability). Reusing a `let` name as `const` (or vice versa) is
# rejected — otherwise the second block's const could be reassigned via the first's let entry.
# expect: error
pub const main = () -> {
	let Iarch r = 0
	if r == 0 then {
		let Iarch x = 1
		x = 2
	}
	if r == 0 then {
		const Iarch x = 5
		x = 99
		r = x
	}
	return r
}
