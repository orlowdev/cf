# a spread builds the tuple argument for a tuple parameter
# expect: exit 6
import std::mem::arena::growing_arena
const f = ((Iarch, Iarch, Iarch) t): Iarch -> t[0] + t[1] + t[2]

const main_body! = (): Iarch -> {
	const p = (1, 2)
	return f((...p, 3))
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
