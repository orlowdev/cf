# A pointer to an all-tag-only union is illegal (§6.4/§8.4): `Maybe` has no payload member, so it
# lowers to a plain integer tag and `*Maybe` would be a `*Scalar`. A PERMANENT type-gate rejection
# (same rule as 697); the file name's `_deferred` is historical.
# expect: error
union Maybe = { Just, Nothing }
const f = (*Maybe m): Iarch -> 0
pub const main = () -> 0
