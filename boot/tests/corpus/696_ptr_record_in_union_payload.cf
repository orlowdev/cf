# A `*Point` record-pointer as a UNION payload (`&` builds it), read through the bound pointer.
# expect: exit 8
data Point = { Iarch x, Iarch y }
union Holder = { Has(*Point), None }
const val = (Holder h): Iarch -> match h {
	Holder.Has(p) -> p.x + p.y,
	Holder.None -> 0,
}

const main_body! = (): Iarch -> val(Holder.Has(&Point({ x: 5, y: 3 })))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
