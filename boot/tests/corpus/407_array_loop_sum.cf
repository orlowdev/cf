# iterate a fixed array by index, driven by `.len`
# expect: exit 10

const main_body! = (): Iarch -> {
	const [4 Iarch] xs = [1, 2, 3, 4]
	let Iarch sum = 0
	let Iarch i = 0
	loop {
		if i >= xs.len then break
		sum += xs[i]
		i += 1
	}
	return sum
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
