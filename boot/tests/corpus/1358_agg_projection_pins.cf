# The exemption's boundary: an AGGREGATE projection still pins its base — `return o.inner`
# hands out a pointer INTO o's construction, so o is born survivor-side and pick!'s frame
# bracket must spare it. The post-return scratch would clobber a/b if the pin were lost.
# expect: exit 42
data P = { Iarch v }
data Big = { P inner }
const pick! = (Iarch k): P -> {
	let [Iarch] junk = [k, k]
	const Big o = Big({ inner: P({ v: k + junk[1] }) })
	return o.inner
}
const main_body! = (): Iarch -> {
	const P a = pick!(10)
	const P b = pick!(11)
	let [4096 Uint8] pad
	pad[0] = 0
	return a.v + b.v + Iarch(pad[0])
}
pub const main = () -> {
	const a = mem.arena.grow(65536)
	return main_body!() in a
}
