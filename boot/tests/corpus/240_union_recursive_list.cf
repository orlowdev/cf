# a union member may carry its own union payload — a pointer-recursive linked list
# expect: exit 60
import std::mem::arena::fixed_arena
union List = { Cons(Iarch, List), Nil }
const sum = (List l): Iarch -> match l {
	List.Cons(h, t) -> h + sum(t),
	List.Nil -> 0,
}

const main_body! = (): Iarch -> {
	const List l = List.Cons(10, List.Cons(20, List.Cons(30, List.Nil)))
	return sum(l)
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
