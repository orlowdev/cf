# A `$`-stack binding inside a loop is rejected: QBE stack allocations live until the frame pops, so
# a per-iteration `$` would accumulate unbounded. Hoist it out of the loop, or use a geometry (whose
# per-iteration reset reclaims residue).
# expect: error
data Point = { Iarch x, Iarch y }
const work = (): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= 3 then break
		const $p = Point({ x: i, y: i })
		i = i + 1 + $p.x
	}
	return i
}
pub const main = () -> work()
