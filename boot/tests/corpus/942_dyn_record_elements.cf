# record elements (8-byte arena pointers) in a dynamic array
# expect: exit 23
import "std/mem/arena/growing_arena" as growing_arena
data P = { Iarch x, Iarch y }
pub const mk = (Iarch a, Iarch b): P -> P({ x: a, y: b })

const main_body! = (): Iarch -> {
	let [P] ps = []
	ps = [...ps, mk(3, 4)]
	ps = [...ps, mk(10, 20)]
	return ps[0].x + ps[1].y
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
