# std::data::either::ops — data-last operators piped as a chain: `of` lifts, `bimap`/`map` transform
# lanes, `chain` sequences a fallible step, a `Left` short-circuits the rest of the chain untouched,
# `alt` recovers, `swap` exchanges the lanes. 40 + 1 + 1 = 42.
# expect: exit 42
import std::data::{ Either }
import std::data::either::ops::{ of, of_left, map, map_left, bimap, chain, alt, swap }
import std::data::either::catas::{ or_else }

const double = (Iarch n): Iarch -> n * 2
const ids = (Str s): Str -> s
const half = (Iarch n): Either[Str, Iarch] ->
	if n == 0 then Either[Str, Iarch].Left("zero") else Either[Str, Iarch].Right(n / 2)

pub const main = () -> {
	const a = of[Str, Iarch](40)
		|> bimap[Str, Iarch, Str, Iarch](ids, double)
		|> chain[Str, Iarch, Iarch](half)
		|> or_else[Str, Iarch](0)

	const b = of[Str, Iarch](0)
		|> chain[Str, Iarch, Iarch](half)
		|> map[Str, Iarch, Iarch](double)
		|> map_left[Str, Str, Iarch](ids)
		|> alt[Str, Iarch](of[Str, Iarch](1))
		|> or_else[Str, Iarch](0)

	const c = of_left[Iarch, Str](1)
		|> swap[Iarch, Str]
		|> or_else[Str, Iarch](0)

	return a + b + c
}
