# several spreads and own fields compose into one flat field set
# expect: exit 15
# check: root
data A = { Iarch a, Iarch b }
data B = { Iarch c, Iarch d }
data Big = { ...A, ...B, Iarch e }

const main_body! = (): Iarch -> {
	const Big g = { a: 1, b: 2, c: 3, d: 4, e: 5 }
	return g.a + g.b + g.c + g.d + g.e
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
