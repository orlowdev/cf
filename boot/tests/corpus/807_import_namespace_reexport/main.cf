# a NAMESPACE reexport (module_system §5): `barrel` re-exports `impl` as the namespace `io`
# (`pub import "impl" as io`), which joins barrel's surface as a nested namespace. `main` windows
# over barrel as `foo` and traverses the nested namespace to impl's function — `foo.io.thing`.
# expect: exit 42
import "barrel" as foo

pub const main = () -> foo.io.thing()
