# A pointer to an all-tag-only union is illegal (type_system §6.4/§8.4): such a union lowers
# to a plain integer, so `*Flag` would be a `*Scalar`. A PERMANENT type-gate rejection (cf
# rejects it too), not a cfcc narrowing — only a payload-bearing union can be a pointer's referent.
# expect: error
union Flag = { On, Off }
const f = (*Flag x): Iarch -> 0
pub const main = () -> 0
