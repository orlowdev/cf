# The escape taint is specific to a STACK-backed `fixed_buffer`. Over a `static` pool the buffer is
# program-lifetime, so an aggregate allocated into it NEVER dangles — returning it out of `run` is
# fine. This is the positive counterpart to 1332: same shape, static provenance instead of `$buf`.
# expect: exit 21
import std::mem::fixed_buffer
data Box = { Iarch lo, Iarch hi }
const make = (Iarch n): Box -> {
	const Box b = { lo: n, hi: n * 4 }
	return b
}
static [4096 Uint8] pool
const run = (Iarch n): Box -> {
	const fb = fixed_buffer::of(pool)
	return make(n) in fb
}
pub const main = () -> {
	const r = run(7)
	return r.hi - r.lo
}
