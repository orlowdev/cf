# D1 diagnostics: after a rejection is recorded the checker LIMPS ON with inert poison values —
# the statements after the bad one (indexing, calls, a match over the poisoned value) must not
# crash the compiler; the run still fails cleanly.
# expect: error
const walk = ([Iarch] xs): Iarch -> {
	const Iarch bad = xs[0] + "no"
	let Iarch acc = 0

	for x in xs {
		acc = acc + x
	}

	if acc > bad then return acc

	return bad
}

pub const main = (): Iarch -> {
	return walk([1, 2, 3])
}
