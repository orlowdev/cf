# The geometry surface parses (memory_model §4): `mem.arena.of(n)`, `mem.page`, and an `in
# <geometry>` clause on both a binding initializer and a call-for-effect statement. PARSE-ONLY
# for now — the geometry is accepted and dropped, so the program runs on the ambient page and
# the result is unaffected. The real node threading is the memory arc.
# expect: exit 42
data Box = { Iarch v }
const build! = (Iarch n): Iarch -> {
	const Box b = { v: n }
	return b.v
}
pub const main = () -> {
	const a = mem.arena.of(4096)
	const p = mem.page
	const Iarch r = build!(42) in a
	build!(1) in a
	return r
}
