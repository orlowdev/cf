# A FIXED arena through the std-source geometry module (geometry_lowering §5): `run!` is
# materialized as `run!__ar`, its record literals build in `reserve_ret__ar`/`reserve_alloc__ar`
# reservations (fold-lite), and every `!` frame brackets its residue through the arena's own
# `on_scope_enter`/`on_scope_exit` (kind-2 top-only mark). `churn!` burns the reclaimed residue
# region after `make!` returns — if the kept Box had been misplaced residue-side, its bytes
# would be overwritten and the sum wrong.
# expect: exit 42
data Box = { Iarch lo, Iarch hi }
const make! = (Iarch n): Box -> {
	const Box junk = Box({ lo: n, hi: n })
	const Box b = Box({ lo: n + junk.lo - junk.hi, hi: n * 5 })
	return b
}
const churn! = (Iarch n): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const Box s = Box({ lo: i, hi: i })
		acc = acc + s.hi - s.lo
		i = i + 1
	}
	return acc
}
const run! = (Iarch n): Iarch -> {
	const Box kept = make!(n)
	const Iarch z = churn!(50)
	return kept.hi - kept.lo - z
}
pub const main = () -> {
	const ar = mem.arena.of(4096)
	const Iarch r = run!(10) in ar
	return r + 2
}
