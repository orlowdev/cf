# `Unit` may be a generic type argument — a `'T` field becomes a `Unit` field
# expect: exit 5
data Box['T] = { Iarch a, 'T v }

const main_body! = (): Iarch -> {
	const Box[Unit] b = { a: 5, v: () }
	const x = b.v
	return b.a
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
