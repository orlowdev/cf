# a Str hole: "a${s}b" with s="XY" -> "aXYb"; m[2] is 'Y' (ASCII 89)
# expect: exit 89

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const Str s = "XY"
	const Str m = "a${s}b"
	return Iarch(m[2])
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
