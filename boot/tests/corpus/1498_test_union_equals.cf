# structural equality over a PAYLOADED union (testing.md §4): tags compare first, then the matched
# member's payload slots compare by their declared types. Three matches, two mismatches (a payload
# difference and a cross-member) -> 2 fails. The accumulator pipe without `case!`, like 1491.
# expect: exit 2
import std::mem::arena::test_arena
import std::mem::ctx
import std::test::{ Verdicts, equals }

union Shape = { Dot, Line(Iarch), Rect(Iarch, Iarch) }

const mkline = (Iarch n): Shape -> Shape.Line(n)
const mkrect = (Iarch a, Iarch b): Shape -> Shape.Rect(a, b)
const mkdot = (): Shape -> Shape.Dot

pub const body = (): () uses Verdicts -> {
	mkline(3) |> equals(mkline(3))
	mkrect(1, 2) |> equals(mkrect(1, 2))
	mkdot() |> equals(mkdot())
	mkline(3) |> equals(mkline(4))
	mkrect(1, 2) |> equals(mkdot())
}

pub const main = () -> {
	let Verdicts vd = { desc: "unions", count: 0, fails: 0 }
	const a = test_arena::of(65536) |> std::mem::ctx::provide(let vd)
	body()
	const r = std::mem::ctx::consume(Verdicts)

	return Iarch(r.fails)
}
