# The hidden ctx pointer threads through a middle function that does not itself consume — `mid`
# demands `Cfg` transitively (it calls `rd`), so it receives and forwards the pointer (context.md §4).
# expect: exit 7
import std::mem::arena::growing_arena
import std::mem::ctx

data Cfg = { Iarch n }

pub const rd = (): Iarch uses Cfg -> {
	const c = std::mem::ctx::consume(Cfg)

	return c.n
}

pub const mid = (): Iarch uses Cfg -> rd()

pub const main = () -> {
	const Cfg cfg = { n: 7 }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(cfg)

	return mid()
}
