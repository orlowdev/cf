# a generic function's type variable is inferred to and instantiated at an ARRAY type
# (`id(xs)` with `xs : [Iarch]` → `'T = [Iarch]`)
# expect: exit 42
import std::mem::arena::fixed_arena
const id = ['T]('T v): 'T -> v

const main_body! = (): Iarch -> {
	const [Iarch] xs = [40, 2]
	const [Iarch] ys = id(xs)
	return ys[0] + ys[1]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
