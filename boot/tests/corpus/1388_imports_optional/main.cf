# imports are optional (module_system §4): a full `::` path resolves with NO import statement — the
# loader discovers `pkg::util` from the path and loads it, and `pkg::util::val` mangles flat to that
# module's path-prefix-mangled definition. Used twice to exercise the dependency dedup.
# expect: exit 42
pub const main = () -> pkg::util::val() + pkg::util::val() - 38
