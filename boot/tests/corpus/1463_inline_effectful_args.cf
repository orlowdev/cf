# M1 inlining: an EFFECTFUL argument to a spliced leaf binds to a value-block temp —
# each argument evaluates exactly once, in call order, and an unused parameter's
# argument still evaluates (the call's semantics, preserved through the splice).
# expect: exit 19
data C = { Iarch i }

const next = (*C c): Iarch -> {
	c.i = c.i + 1

	return c.i
}

const wsum = (Iarch a, Iarch b): Iarch -> a * 10 + b

const first_of = (Iarch a, Iarch b): Iarch -> a

pub const main = (): Iarch -> {
	let C c = C({ i: 0 })
	const Iarch x = wsum(next(&c), next(&c))
	const Iarch y = first_of(next(&c), next(&c))

	return x + y + c.i
}
