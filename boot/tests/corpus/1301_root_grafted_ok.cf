# Root-page validation (memory_model §2) accepts a program that grafts a geometry before allocating:
# main holds no residue itself and calls the allocating `!` function `in a`, so nothing lands on the
# root page. It then compiles and runs normally.
# expect: exit 6
data Box = { Iarch lo, Iarch hi }
const span! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 3 }
	return b.hi - b.lo
}
pub const main = () -> {
	const a = mem.arena.of(4096)
	const Iarch r = span!(3) in a
	return r
}
