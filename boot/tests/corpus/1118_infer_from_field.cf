# a generic function's type argument is inferred from a field read of a local (`id(p.x)`)
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
const id = ['T]('T v): 'T -> v

const main_body! = (): Iarch -> {
	const Point p = Point({ x: 42, y: 1 })
	return id(p.x)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
