# a top-level const carries a data AGGREGATE: the construction is the const's whole value,
# its type is inferred from the construction, and every reference splices the construction
# into the referencing body (the inline fold), so it builds under that body's ambient
# expect: exit 42
data Point = { Iarch x, Iarch y }
pub const ORIGIN = Point({ x: 40, y: 2 })
pub const main = () -> ORIGIN.x + ORIGIN.y
