# a payload union is a boxed tag+payload aggregate; match dispatches on its tag
# (M1.2a: no payload binding yet — just the tag)
# expect: exit 123
import "std/mem/arena/fixed_arena" as fixed_arena
union Node = { IntLit(Iarch), BinOp(Iarch, Iarch, Iarch), Nil }
pub const tag_of = (Node n): Iarch -> match n {
	Node.IntLit -> 1,
	Node.BinOp -> 2,
	Node.Nil -> 3,
}

const main_body! = (): Iarch -> {
	const Node a = Node.IntLit(42)
	const Node b = Node.BinOp(1, 2, 3)
	const Node c = Node.Nil
	return tag_of(a) * 100 + tag_of(b) * 10 + tag_of(c)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
