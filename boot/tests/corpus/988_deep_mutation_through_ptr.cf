# deep mutation through a `*Record` parameter (a writable borrow)
# expect: exit 15
# check: root
data V = { Iarch v }
data Node = { V val, Iarch id }
pub const bump = (*Node n): Unit -> {
	n.val.v = n.val.v + 10
	return ()
}

const main_body! = (): Iarch -> {
	let Node n = { val: { v: 5 }, id: 1 }
	bump(&n)
	return n.val.v
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
