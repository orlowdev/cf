# a closure is analyzed with its OWN escape context: when it RETURNS its aggregate, that escapes to
# the enclosing caller and the closure stays colorless — so the enclosing function does too.
# check: alloc
# expect: exit 5
data P = { Iarch v }
const run = (): Iarch -> {
	const mk = (Iarch x): P -> {
		const P p = { v: x }
		return p
	}
	return mk(5).v
}
pub const main = () -> run()
