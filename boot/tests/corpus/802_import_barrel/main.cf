# a barrel: `barrel` re-exports a value and a type from `impl` via `pub import`, and
# main imports them FROM the barrel — each is followed to its origin in impl.
# expect: exit 42
import "barrel" as { thing, Point }

pub const main = () -> {
	const Point p = Point({ x: 0, y: 0 })
	return thing() + p.x
}
