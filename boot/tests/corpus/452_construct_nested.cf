# construction nests — aggregate fields built from other constructions
# expect: exit 10
data Point = { Iarch x, Iarch y }
data Line = { Point a, Point b }
const mk = (Iarch x, Iarch y): Point -> Point({ x, y })
const mkline = (): Line -> Line({ a: mk(1, 2), b: mk(3, 4) })
pub const main = () -> {
	const Line l = mkline()
	return l.a.x + l.a.y + l.b.x + l.b.y
}
