# a payload sub-pattern mixes a nested member guard, a bind, and a wildcard;
# guarded arms never prove exhaustiveness, so a `_` is required
# expect: exit 8
# check: root
union Op = { Add, Sub }
union Expr = { Bin(Op, Iarch, Iarch) }
pub const f = (Expr e): Iarch -> match e {
	Expr.Bin(Add, l, _) -> l,
	Expr.Bin(Sub, _, r) -> r,
	_ -> 0,
}

const main_body! = (): Iarch -> f(Expr.Bin(Op.Add, 8, 2))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
