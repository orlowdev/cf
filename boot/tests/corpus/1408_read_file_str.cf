# std::io::file whole-file read into an owned Str: write a 9-byte multi-line file, read it back with
# read_file! (which grows a byte vector and wraps it via Str construction), and return the Str's
# length. A full round-trip through the typed IO surface → exit 9.
# expect: exit 9
import std::data::{ Either }
import std::io::file::{ write_file, read_file! }
import std::io::fd::{ IoRrr }
import std::mem::arena::growing_arena

const run! = (): Iarch -> {
	write_file("/tmp/cf_t1408.txt", "a\nbb\nccc\n")

	const Either[IoRrr, Str] r = read_file!("/tmp/cf_t1408.txt")

	return match r {
		Either.Left(e) -> 0 - 1,
		Either.Right(s) -> Iarch(s.len),
	}
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return run!() in a
}
