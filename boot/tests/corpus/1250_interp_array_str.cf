# a `[Str]` array renders each element's bytes: `[hi, yo]` (8 bytes)
# expect: exit 8

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let [Str] xs = ["hi", "yo"]
	const Str m = "${xs}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
