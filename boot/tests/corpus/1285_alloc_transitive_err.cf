# transitive both-ways: calling a concrete `!` function without carrying the marker is an error.
# check: alloc
# expect: error
data Point = { Iarch x, Iarch y }
const alloc! = (): Iarch -> {
	const Point p = { x: 7, y: 9 }
	return p.x
}
const caller = (): Iarch -> alloc!() + 1
pub const main = () -> caller()
