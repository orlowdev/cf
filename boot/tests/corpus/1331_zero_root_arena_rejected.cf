# ZERO-ROOT mode also forbids grafting an arena: `mem.arena.grow` carves its node header from the
# ambient node, which bare (root-ambient) is the root page — but `--root-size 0` allows no page use
# at all. So even though `span!` allocates `in a` (never on the root), the graft itself is rejected.
# A zero-allocation binary must lean entirely on `$`-stack / `static` / `fixed_buffer`.
# expect: error
# cf-flags: --target bare-arm64 --root-size 0
data Box = { Iarch lo, Iarch hi }
const span! = (Iarch n): Iarch -> {
	const Box b = { lo: n, hi: n * 4 }
	return b.hi - b.lo
}
pub const main = () -> {
	const a = mem.arena.grow(4096)
	return span!(7) in a
}
