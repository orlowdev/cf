# The `--version` flag stamps `std::comptime::version::current` (here `1.22.58-nightly`); the
# compiler's own version rides on `::compiler` (the build default `0.0.0-dev` under the test harness).
# Both bake as static string literals — comptime, no allocation, readable in a bare `main`.
# expect: exit 42
# cf-flags: --version 1.22.58-nightly
import std::comptime::version
import std::str::{ eq }

pub const main = () -> {
	const Str cur = version::current
	const Str cmp = version::compiler

	if !eq(cur, "1.22.58-nightly") then return 1
	if !eq(cmp, "0.0.0-dev") then return 2

	return 42
}
