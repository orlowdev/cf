# an aggregate bound from a `match` PAYLOAD (`M.Some(x) -> x`) then field-accessed — the payload's
# record type is recovered from the union member (via the arm's bind env), so `r.v` dispatches
# expect: exit 8
import "std/mem/arena/fixed_arena" as fixed_arena
data Bag = { Iarch v }
union M = { Some(Bag), None }

const main_body! = (): Iarch -> {
	let Bag d0 = Bag({ v: 3 })
	let M m = M.Some(Bag({ v: 8 }))
	let Bag r = match m { M.Some(x) -> x, M.None -> d0 }
	return r.v
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
