# A closure may capture both a record (mutated) and a word (mutated) at once.
# step(10), step(20): c.v = 30, n = 2, so c.v + n = 32.
# expect: exit 32
import "std/mem/arena/fixed_arena" as fixed_arena
data Cell = { Iarch v }
const run! = (): Iarch -> {
	let Cell c = { v: 0 }
	let Iarch n = 0
	const step = (Iarch k) -> {
		c.v = c.v + k
		n = n + 1
		return c.v
	}
	const a = step(10)
	const b = step(20)
	return c.v + n
}

const main_body! = (): Iarch -> run!()

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
