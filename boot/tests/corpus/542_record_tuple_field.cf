# a record field may be a tuple; construct it, then read and index the field
# expect: exit 13
import std::mem::arena::fixed_arena
data R = { Iarch z, (Iarch, Iarch) pair }

const main_body! = (): Iarch -> {
	const r = R({ z: 3, pair: (4, 6) })
	return r.z + r.pair[0] + r.pair[1]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
