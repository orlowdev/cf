# a record may have a `Unit` field (stored as a word `0`); other fields read as usual
# expect: exit 9
import std::mem::arena::fixed_arena
data R = { Iarch a, Unit u }

const main_body! = (): Iarch -> {
	const r = R({ a: 9, u: () })
	return r.a
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
