# a boxed-union `let` local is reassignable through its pointer slot, and the new value may READ
# the old one (`acc = E.Neg(acc)`) — the left-fold shape cf's parser needs. Three Neg-wraps over
# Lit(7) give depth 3.
# expect: exit 3
# check: root
union E = { Lit(Iarch), Neg(E) }
const depth = (E e): Iarch -> match e {
	E.Lit(v) -> 0,
	E.Neg(inner) -> 1 + depth(inner)
}

const main_body! = (): Iarch -> {
	let E acc = E.Lit(7)
	let Iarch i = 0
	loop {
		if i >= 3 then break
		acc = E.Neg(acc)
		i = i + 1
	}
	return depth(acc)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
