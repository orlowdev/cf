# a comptime condition's variant must belong to its enum — `Os.Arm64` is bogus (Arm64 is an
# Arch, not an Os variant), so it is a parse error, not a silently-false comparison.
# expect: error
import std::comptime::os
import std::sys::{ Os }

if os::target == Os.Arm64 then import a::{ av } else import a::{ av }
pub const main = (): Iarch -> av
