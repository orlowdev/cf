# a generic function's type argument is inferred from a `for` loop binder (`id(x)`)
# expect: exit 42
const id = ['T]('T v): 'T -> v

const main_body! = (): Iarch -> {
	const [Iarch] xs = [40, 2]
	let Iarch s = 0
	for x in xs { s = s + id(x) }
	return s
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
