# a record field type may nest tuples
# expect: exit 10
import std::mem::arena::fixed_arena
data R = { ((Iarch, Iarch), Iarch) nested }

const main_body! = (): Iarch -> {
	const r = R({ nested: ((3, 4), 3) })
	return r.nested[0][0] + r.nested[0][1] + r.nested[1]
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
