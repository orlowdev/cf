# packed 4-byte Int32 elements (stride 4, not uniform-8)
# expect: exit 228

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	let [Int32] xs = []
	xs = [...xs, Int32(1000)]
	xs = [...xs, Int32(2000)]
	xs = [...xs, Int32(300)]
	let Iarch acc = 0
	for x in xs {
		acc = acc + Iarch(x)
	}
	return acc
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
