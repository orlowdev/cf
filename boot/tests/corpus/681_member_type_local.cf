# A member-type annotation (`Color.Red`) names one union variant; cfcc collapses it to
# the union `Color`, so the value is an ordinary tagged union.
# expect: exit 10
union Color = { Red, Green, Blue }
pub const main = () -> {
	const Color.Red c = Color.Red
	return match c {
		Color.Red -> 10,
		Color.Green -> 20,
		Color.Blue -> 30,
	}
}
