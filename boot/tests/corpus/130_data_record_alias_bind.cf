# a record local may bind (alias) another record variable — a read-only borrow of the
# same arena pointer, no explicit copy (M0; the bump arena makes the alias safe)
# expect: exit 1
import "std/mem/arena/fixed_arena" as fixed_arena
data P = { Iarch x }

const main_body! = (): Iarch -> {
	const P a = { x: 1 }
	const P b = a
	return b.x
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
