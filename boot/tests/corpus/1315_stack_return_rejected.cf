# A `$`-stack aggregate cannot escape: its storage pops with the frame, so returning the whole `$p`
# would dangle. The compiler rejects it (a scalar field read like `$p.x` is fine — see 1314); to
# return an aggregate, build it in a geometry.
# expect: error
import std::mem::arena::growing_arena
data Point = { Iarch x, Iarch y }
const work = (): Point -> {
	const $p = Point({ x: 3, y: 4 })
	return $p
}
pub const main = () -> {
	const a = growing_arena::of(4096)
	const Point r = work() in a
	return r.x
}
