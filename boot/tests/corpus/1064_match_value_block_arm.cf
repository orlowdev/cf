# a value-position match arm body may be a `{ … <- v }` block (leading statements, then a
# `<- v` yield) — here Green yields 20+1 = 21
# expect: exit 21
union Color = { Red, Green, Blue }
pub const main = () -> {
	const Color c = Color.Green
	const Iarch r = match c {
		Color.Red -> 1,
		Color.Green -> {
			const Iarch x = 20
			<- x + 1
		},
		_ -> 0,
	}
	return r
}
