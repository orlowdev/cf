# A `$`-stack value may not be stored into a heap aggregate that could outlive the frame — the array
# would keep a pointer to the dead stack slot once the frame pops (the same hazard as returning it).
# `ps = [...ps, $p]` is rejected; collect plain arena values instead, or keep the `$` value frame-local.
# expect: error
import "std/mem/arena/growing_arena" as growing_arena
data Pair = { Iarch a, Iarch b }
const work = (): Iarch -> {
	let [Pair] ps = []
	const $p = Pair({ a: 3, b: 4 })
	ps = [...ps, $p]
	return ps[0].a
}
pub const main = () -> {
	const a = growing_arena.of(4096)
	return work() in a
}
