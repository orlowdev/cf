# a `[T]` dynamic-array record FIELD: a context struct bundles a token vector + a cursor,
# threaded by `*Ctx`; the callee reads the field (index + `.len`). Sum 2 + 3 = 5.
# expect: exit 5
# check: root
data Ctx = { [Token] toks, Iarch pos }
data Token = { Iarch v }
const walk = (*Ctx c): Iarch -> {
	let Iarch acc = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(c.toks.len) then break
		acc = acc + c.toks[i].v
		i = i + 1
	}
	return acc
}

const main_body! = (): Iarch -> {
	let [Token] ts = [Token({v: 2}), Token({v: 3})]
	let Ctx c = Ctx({toks: ts, pos: 0})
	return walk(&c)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
