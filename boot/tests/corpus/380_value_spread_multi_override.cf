# a three-field record: spread copies one field, two are overridden
# expect: exit 32
# check: root
data V = { Iarch a, Iarch b, Iarch c }

const main_body! = (): Iarch -> {
	const V v = { a: 1, b: 2, c: 3 }
	const V w = { ...v, a: 10, c: 20 }
	return w.a + w.b + w.c
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
