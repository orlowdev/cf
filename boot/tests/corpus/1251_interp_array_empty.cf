# an empty array renders `[]` (2 bytes) — the runtime loop body never runs
# expect: exit 2

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	let [Iarch] xs = []
	const Str m = "${xs}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
