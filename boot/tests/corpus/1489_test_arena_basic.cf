# test_arena is the case geometry (testing.md §3) — structurally a growing arena, so it carves,
# allocates, and reclaims exactly like `growing_arena::of`. Here a body runs `in` a test_arena,
# builds a record with a `[T]` field, and sums it: 1 + 2 + 3 = 6. Proves the `te` geometry plumbing
# (of__te reuses the el carve/reserve, materialize folds a te body to el).
# expect: exit 6
import std::mem::arena::test_arena
data Ctx = { [Iarch] xs, Iarch pos }
const sumit = ([Iarch] ys): Iarch -> {
	let Iarch a = 0
	for y in ys {
		a = a + y
	}
	return a
}

const main_body! = (): Iarch -> {
	let [Iarch] v = [1, 2, 3]
	const Ctx c = Ctx({xs: v, pos: 0})
	return sumit(c.xs)
}

pub const main = () -> {
	const a = test_arena::of(4096)
	return main_body!() in a
}
