# a `[T]` dynamic-array union PAYLOAD is now allowed (a boxed 8-byte header pointer) —
# declare it, construct from a `[T]` value, and read the payload's `.len`
# expect: exit 2
import std::mem::arena::fixed_arena
union Node = { Leaf, Branch([Iarch]) }

const main_body! = (): Iarch -> {
	let [Iarch] xs = [7, 9]
	const Node n = Node.Branch(xs)
	return match n {
		Node.Leaf -> 0,
		Node.Branch(ys) -> ys.len
	}
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
