# a tuple's record element may itself hold a record (implicit-pointer aggregate field)
# expect: exit 15
data Inner = { Iarch v }
data Outer = { Iarch k, Inner in }
const mk_i = (Iarch v): Inner -> Inner({ v: v })
const mk_o = (Iarch k, Iarch v): Outer -> Outer({ k: k, in: mk_i(v) })

const main_body! = (): Iarch -> {
	const t = (5, mk_o(4, 6))
	return t[0] + t[1].k + t[1].in.v
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
