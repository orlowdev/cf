# a pub union imported across a module boundary: matched by its members in main, with
# the union qualifier rewritten to the mangled union name on flatten
# expect: exit 42
import dir::{ Dir }

const weight = (Dir d): Iarch -> match d {
	Dir.North -> 40,
	Dir.South -> 2,
}

pub const main = () -> weight(Dir.North) + weight(Dir.South)
