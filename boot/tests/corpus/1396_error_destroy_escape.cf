# `destroy` soundness (geometry_lowering §3): tearing a child arena down is sound only if nothing it
# holds escapes the scope. Here `make()` runs `in b` and returns a `Box` that lives in `b`, so the
# `Box` escapes `leak` — and the `defer destroy(b)` would rewind `b` out from under it, dangling the
# returned pointer. The compiler rejects it (routing already flags `b` as a survivor when an
# aggregate escapes through `in b`).
# expect: error
import std::mem::arena::fixed_arena
data Box = { Iarch v }
const make = (): Box -> Box({ v: 42 })
const leak = (): Box -> {
	const b = fixed_arena::of(4096)
	defer fixed_arena::destroy(b)
	return make() in b
}
pub const main = () -> leak().v
