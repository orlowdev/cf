# `Uarch` (and the integer family) as a parameter/return type — one word, like `Iarch`;
# and the `Str(v)` seal turning a built `[Uint8]` byte vector into a `Str`.
# expect: exit 3
# check: root
const bump = (Uarch n): Uarch -> n + 1

const main_body! = (): Iarch -> {
	let [Uint8] v = []
	v = [...v, Uint8(65)]
	v = [...v, Uint8(66)]
	const Str s = Str(v)
	return Iarch(s.len) + Iarch(bump(0))
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
