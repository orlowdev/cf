# a trailing comma is optional in every comma-separated list — data/union shapes, parameter
# lists, array literals, data literals, and call arguments — so a formatter can lay a long list
# out one item per line. Exercises all of them at once.
# expect: exit 14
import std::mem::arena::growing_arena
data Pt = {
	Iarch x,
	Iarch y,
}
union U = {
	A,
	B,
}
const g! = (
	Iarch a,
	Iarch b,
): Iarch -> {
	const [Iarch] xs = [
		a,
		b,
	]
	const Pt p = {
		x: a,
		y: b,
	}
	return xs[0] + p.y + g2(
		a,
		b,
	)
}
const g2 = (Iarch a, Iarch b): Iarch -> a + b
pub const main = () -> {
	const a = growing_arena::of(4096)
	return g!(3, 4) in a
}
