# Typed element access through a `*[T]` reference parameter (the writable-borrow spelling):
# a `*[P]` parameter stores/reads RECORD elements at their declared type, and a `*[Iarch]`
# parameter stores full words (999 round-trips — the old checker byte-range-gated every
# literal store through a pointer as if it were `*[Uint8]`).
# expect: exit 41
import std::mem::arena::growing_arena
data P = { Iarch v }
const setp = (*[P] ps, Iarch i): Iarch -> {
	ps[i] = P({ v: 40 })
	return 0
}
const setw = (*[Iarch] xs): Iarch -> {
	xs[0] = 999
	return 0
}
const main_body! = (): Iarch -> {
	let [P] ps = [P({ v: 1 }), P({ v: 2 })]
	let [Iarch] xs = [0, 0]
	setp(ps, 1)
	setw(xs)
	let Iarch ok = 0
	if xs[0] == 999 then ok = 1
	return ps[1].v + ok
}
pub const main = () -> {
	const a = growing_arena::of(8192)
	return main_body!() in a
}
