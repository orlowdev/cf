# A `'T` tuple-parameter position is inferred at a RECORD argument and field-accessed through it.
# expect: exit 5
data P = { Iarch x }
const snd = ['T]((Iarch, 'T) p): 'T -> p[1]

const main_body! = (): Iarch -> {
	let P q = snd((9, P({ x: 5 })))
	return q.x
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
