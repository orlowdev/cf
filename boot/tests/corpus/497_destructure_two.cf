# two destructurings in a row reuse the machinery without name clashes
# expect: exit 100

import "std/mem/arena/fixed_arena" as fixed_arena
const main_body! = (): Iarch -> {
	const (a, b) = (10, 20)
	const (c, d) = (30, 40)
	return a + b + c + d
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
