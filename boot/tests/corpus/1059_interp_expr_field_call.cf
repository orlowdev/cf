# an interpolation hole may be a field access `${p.x}` or a call `${dbl(5)}` →
# "x=7 f=10" has length 8
# expect: exit 8
# check: root
data P = { Iarch x, Iarch y }
const dbl = (Iarch n): Iarch -> n * 2

const main_body! = (): Iarch -> {
	const P p = { x: 7, y: 9 }
	const Str m = "x=${p.x} f=${dbl(5)}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
