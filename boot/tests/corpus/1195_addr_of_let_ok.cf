# `&` on a `let` aggregate hands a writable pointer to a `*T` parameter that mutates it.
# expect: exit 5
data Point = { Iarch x }
const bump = (*Point p): Iarch -> {
	p.x = 5
	return p.x
}

const main_body! = (): Iarch -> {
	let Point c = { x: 1 }
	return bump(&c)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
