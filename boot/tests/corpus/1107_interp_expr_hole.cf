# Interpolation holes are full expressions, not just bare names: arithmetic (`${a + b}`),
# a field read (`${p.n}`), an index (`${xs[i]}`), and a Str-valued hole (`${p.tag}`). The
# built string's length is returned to prove it assembled.
# expect: exit 8
data P = { Iarch n, Str tag }

const main_body! = (): Iarch -> {
	let [Iarch] xs = [7, 8, 9]
	const Iarch a = 4
	const Iarch i = 2
	const P p = P({ n: 5, tag: "hi" })
	const Str s = "${a + a}:${p.n}:${xs[i]}:${p.tag}"
	return Iarch(s.len)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
