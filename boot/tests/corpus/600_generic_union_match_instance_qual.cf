# a match arm may qualify by the union's exact instance (`U[Iarch].Pair`), not only its base
# name (`U.Pair`) — the two are interchangeable, matching construction's `U[Iarch].Pair(...)`
# expect: exit 30
import "std/mem/arena/growing_arena" as growing_arena
union U['T] = { Pair((Iarch, 'T)), Empty }
const sum = (U[Iarch] u): Iarch -> match u {
	U[Iarch].Pair(p) -> p[0] + p[1],
	U.Empty -> 0,
}

const main_body! = (): Iarch -> sum(U[Iarch].Pair((10, 20)))

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
