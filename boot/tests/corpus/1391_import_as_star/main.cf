# A wildcard reexport `pub import impl_darwin as *` splices every member of the target flat into the
# barrel `top`, so BOTH members are reachable through `top` with no nesting and without `top` having
# to enumerate them — `top::one` + `top::two` = 42. Adding a member to impl_darwin needs no edit here.
# expect: exit 42
import top

pub const main = (): Iarch -> top::one() + top::two()
