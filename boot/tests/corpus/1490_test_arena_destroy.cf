# test_arena::destroy — the teardown path. A helper carves a per-call test_arena child, works `in`
# it, and tears it down with `|> defer destroy`; 20 calls through a 1 MiB parent stay bounded because
# each destroy__te rewinds its child (today the plain survivor rewind, growing_arena's twin). Proves
# the te teardown lowering. acc.n (20) + 22 = 42.
# expect: exit 42
import std::mem::arena::fixed_arena
import std::mem::arena::test_arena
data Acc = { Iarch n }
const eat! = (Iarch k): Iarch -> {
	let [102400 Uint8] buf
	return k
}
const helper2! = (*Acc a, Iarch k): Iarch -> {
	const b = test_arena::of(65536)
	defer test_arena::destroy(b)
	const Iarch r = eat!(k) in b
	a.n = a.n + 1
	return r
}
const main_body! = (): Iarch -> {
	let Acc acc = Acc({ n: 0 })
	let Iarch i = 0
	loop {
		if i >= 20 then break
		helper2!(&acc, i)
		i = i + 1
	}
	return acc.n + 22
}
pub const main = () -> {
	const a = fixed_arena::of(1048576)
	return main_body!() in a
}
