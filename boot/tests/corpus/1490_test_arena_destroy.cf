# test_arena::destroy — the REPORTING teardown (testing.md §3): a real function `uses Verdicts`, not
# the bodyless rewind intrinsic. A helper provides a `let` accumulator in its own ambient node, opens
# a te child inside the provide's extent, works `in` it, and destroys: destroy CONSUMES the
# accumulator (the same demand chain the assertions use), dumps the verdict, then rewinds the child.
# 20 rounds through a 1 MiB parent stay bounded (each rewind reclaims the child), and the tally reads
# the accumulator AFTER the destroy — it lives one bracket above the arena, so it survives the
# rewind. 1 mismatch per round -> 20 fails; 20 + 22 = 42.
# expect: exit 42
import std::mem::arena::fixed_arena
import std::mem::arena::test_arena
import std::mem::ctx
import std::test::{ Verdicts, equals }

const val = (Iarch x): Iarch -> x

const eat! = (Iarch k): Iarch -> {
	let [102400 Uint8] buf
	return k
}

const round! = (Iarch k): Uarch -> {
	let Verdicts vd = { desc: "round", count: 0, fails: 0 }
	const b = test_arena::of(65536) |> std::mem::ctx::provide(let vd)
	const Iarch r = eat!(k) in b
	val(r) |> equals(k)
	val(r) |> equals(k + 1)
	test_arena::destroy(b)
	return vd.fails
}

const main_body! = (): Iarch -> {
	let Uarch fails = 0
	let Iarch i = 0
	loop {
		if i >= 20 then break
		fails = fails + round!(i)
		i = i + 1
	}
	return Iarch(fails) + 22
}

pub const main = () -> {
	const a = fixed_arena::of(1048576)
	return main_body!() in a
}
