# Spread discharge (context.md §5): `App` embeds `Sentry` by `...Sentry` AFTER a field, so the
# consumer's `uses Sentry` is satisfied by an INTERIOR pointer into the provided `App` (a comptime
# `+ offset`). The exit code is the embedded field, read through that interior pointer.
# expect: exit 99
import std::mem::arena::growing_arena
import std::mem::ctx

data Sentry = { Iarch code }
data App = { Iarch flags, ...Sentry }

pub const rd = (): Iarch uses Sentry -> {
	const c = std::mem::ctx::consume(Sentry)

	return c.code
}

pub const main = () -> {
	const App app = { flags: 5, code: 99 }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(app)

	return rd()
}
