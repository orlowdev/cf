# Stage 4, aggregate coverage — the DYNAMIC half: a body materialized under a geometry now grows
# its `[T]` vectors and builds its interpolated strings through the geometry's OWN bump half, not
# the shared floor `cf_alloc`. The growing collections realloc through `cf_dyn_push`, whose grow
# allocates the bigger block; the `_g` floor variants take the geometry's reserve as a FUNCTION
# POINTER (`reserve_ret__<g>` survivor / `reserve_alloc__<g>` residue) and reserve the block there,
# and the interp append helpers (`cf_*_append_g`) thread the same pointer. `build!` self-appends a
# vector, spread-copies it, and interpolates a string — all under `fixed_arena` (fx) AND
# `growing_arena` (el). The two twins must compute the same value; a wrong reserve pointer or a
# desynced grow would trap or read back garbage.
# expect: exit 0
import std::mem::arena::fixed_arena
import std::mem::arena::growing_arena

const build! = (Iarch n): Iarch -> {
	let [Iarch] xs = []
	let Iarch i = 0
	loop {
		if i >= n then break
		xs = [...xs, i * 2]
		i = i + 1
	}
	const [Iarch] ys = [...xs, 99, 100]
	const s = "n=${n} last=${xs[n - 1]} ylen=${Iarch(ys.len)} flag=${n > 3}"
	let Iarch acc = Iarch(s.len)
	let Iarch k = 0
	loop {
		if k >= Iarch(ys.len) then break
		acc = acc + ys[k]
		k = k + 1
	}
	return acc
}

pub const main = () -> {
	const fx = fixed_arena::of(8192)
	const el = growing_arena::of(256)
	const Iarch a = build!(5) in fx
	const Iarch b = build!(5) in el
	if a != b then return 1
	# xs [0,2,4,6,8]; ys [...,99,100] len 7 sum 219; s "n=5 last=8 ylen=7 flag=true" len 27 -> 246
	if a != 246 then return 2
	return 0
}
