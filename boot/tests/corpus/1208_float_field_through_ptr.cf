# a `Float64` field written and read through a `*P` pointer parameter — the pointer store/load
# uses the field's float type. 21.0 doubled = 42.
# expect: exit 42
data P = { Float64 x }
const dbl = (*P p): Iarch -> {
	p.x = p.x + p.x
	return 0
}
pub const main = () -> {
	let P p = P({ x: 21.0 })
	const w = dbl(&p)
	return Iarch(p.x)
}
