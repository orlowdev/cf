# a guarded break exits the loop mid-iteration
# expect: exit 30

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [4 Iarch] xs = [10, 20, 30, 40]
	let Iarch result = 0
	for x in xs {
		result = x
		if x > 25 then break
	}
	return result
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
