# a generic union matched directly on a call result — the arm's concrete union is the
# call's (monomorphized) return type, not only a bare parameter's
# expect: exit 42
union Maybe['V] = { Just('V), Nothing }
const mk = (Iarch x): Maybe[Iarch] -> Maybe[Iarch].Just(x)
pub const main = (): Iarch -> match mk(42) { Maybe.Just(v) -> v, Maybe.Nothing -> 0 }
