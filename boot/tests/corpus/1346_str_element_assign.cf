# A `[Str]` element takes a Str value — the slot holds the string's pointer.
# expect: exit 5
const main_body! = (): Iarch -> {
	let [Str] ss = ["a", "bc"]
	ss[0] = "xyz"
	return Iarch(ss[0].len) + Iarch(ss[1].len)
}
pub const main = () -> {
	const a = mem.arena.grow(8192)
	return main_body!() in a
}
