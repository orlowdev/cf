# A `let` provide is shared MUTABLE state: a colorless `uses St` consumer binds it `let` and writes
# a field in place through the context pointer; the mutation is visible to a later read (context.md
# §3). The exit code is the accumulated value after three in-place increments.
# expect: exit 3
import std::mem::arena::growing_arena
import std::mem::ctx

data St = { Iarch n }

pub const bump = (): () uses St -> {
	let s = std::mem::ctx::consume(St)
	s.n = s.n + 1
}

pub const main = () -> {
	let St st = { n: 0 }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(let st)
	bump()
	bump()
	bump()
	const r = std::mem::ctx::consume(St)

	return r.n
}
