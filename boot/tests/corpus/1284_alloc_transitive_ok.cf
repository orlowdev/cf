# the color propagates up the call chain: a function that calls a concrete `!` function is itself
# `!`, marked accordingly.
# expect: exit 8
import "std/mem/arena/fixed_arena" as fixed_arena
data Point = { Iarch x, Iarch y }
const alloc! = (): Iarch -> {
	const Point p = { x: 7, y: 9 }
	return p.x
}
const caller! = (): Iarch -> alloc!() + 1
pub const main = () -> {
	const a = fixed_arena.of(4096)
	return caller!() in a
}
