# a tuple interpolation hole renders `(1, true)` — a Bool element rides the same stringifier (9 bytes)
# expect: exit 9

import "std/mem/arena/growing_arena" as growing_arena
const main_body! = (): Iarch -> {
	const t = (1, true)
	const Str m = "${t}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
