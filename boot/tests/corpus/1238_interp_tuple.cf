# a tuple interpolation hole renders `(1, true)` — a Bool element rides the same stringifier (9 bytes)
# expect: exit 9

# check: root
const main_body! = (): Iarch -> {
	const t = (1, true)
	const Str m = "${t}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
