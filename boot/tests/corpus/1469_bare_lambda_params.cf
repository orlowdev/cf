# BARE lambda parameters (type_system §5.2: the expected function type gives the params their
# types): `(n) -> n * 2` types `n` from the consuming call's function-type parameter — through a
# generic HOF (the monomorph pass types the lambda BODY under the pinned substitution to derive
# the element-introducing variable) and through a concrete HOF alike. Params, returns, and type
# arguments are all inferred; nothing is annotated. 30 + 9 + 42 - 39 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::array::{ map, filter, reduce, range }

const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)

const main_body = () -> {
	const xs = range(1, 6)

	const s1 = xs
	|> map((n) -> n * 2)
	|> reduce((a, b) -> a + b, 0)

	const s2 = xs
	|> filter((n) -> n - (n / 2) * 2 == 1)
	|> reduce((a, b) -> a + b, 0)

	const c = apply((n) -> n * 2, 21)

	return s1 + s2 + c - 39
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body() in ar
}
