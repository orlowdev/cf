# cfcc typechecks each clone's body per-instantiation (a throwaway degeneracy — cf
# checks at the definition site with bounds), so `.v` on 'T=Box happens to resolve here
# expect: exit 9
import std::mem::arena::fixed_arena
data Box = { Iarch v }
pub const unbox = ['T]('T b): Iarch -> b.v

const main_body! = (): Iarch -> {
	const Box b = { v: 9 }
	return unbox[Box](b)
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
