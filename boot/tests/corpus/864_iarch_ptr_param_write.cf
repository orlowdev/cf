# a helper writes through a `*[Iarch]` param; the caller sees the filled array
# expect: exit 25
const fill = (*[Iarch] xs, Iarch n): Iarch -> {
	let i = 0
	loop {
		if i >= n then break
		xs[i] = i * i
		i = i + 1
	}
	return n
}

const main_body! = (): Iarch -> {
	let [8 Iarch] a = [0, 0, 0, 0, 0, 0, 0, 0]
	const w = fill(a, 5)
	return a[3] + a[4]
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
