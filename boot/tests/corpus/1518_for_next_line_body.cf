# an unbraced for-loop body may start on the line after the header — the body is ONE
# statement wherever it sits (same line or next), nesting through guards and loops
# expect: exit 0
pub const main = (): Iarch -> {
	const [Iarch] xs = [1, 2, 3]
	let s = 0

	for x in xs
		s = s + x

	let [Iarch] out = []

	for x in xs
		if x != 2 then {
			const y = x * 10

			for z in xs out = [...out, y + z]
		}

	for x in out s = s + x

	for x in xs
		for y in xs
			s = s - 1

	# 6 (first loop) + 132 (out: 11,12,13,31,32,33) - 9 (nested loop) = 129
	return s - 129
}
