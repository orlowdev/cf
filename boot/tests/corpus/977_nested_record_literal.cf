# an inline nested record literal — the field type guides the bare `{ … }`
# expect: exit 43
import std::mem::arena::fixed_arena
data V = { Iarch v }
data Pair = { V a, V b }

const main_body! = (): Iarch -> {
	const Pair p = { a: { v: 3 }, b: { v: 40 } }
	return p.a.v + p.b.v
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
