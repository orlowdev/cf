# element assignment round-trips a 64-bit value (storel/loadl, not a 32-bit word):
# 100000*100000 = 10^10 overflows 32 bits, so a truncating store would misread.
# expect: exit 10
pub const main = () -> {
	let [2 Iarch] xs = [0, 0]
	let big = 100000 * 100000
	xs[0] = big
	return xs[0] / 1000000000
}
