# literal fields may be given in any order — they map to declaration order
# expect: exit 12
# check: root
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point p = { y: 4, x: 3 }
	return p.x * p.y
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
