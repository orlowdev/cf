# element write `xs[i] = v` on a dynamic array
# expect: exit 56

import "std/mem/arena/fixed_arena" as fixed_arena
const main_body! = (): Iarch -> {
	let [Iarch] xs = [1, 2, 3]
	xs[1] = 50
	return xs[0] + xs[1] + xs[2] + xs.len - 1  # 1+50+3+3-1=56
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
