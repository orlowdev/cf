# a bare `[]` empty-array literal is a valid dynamic-array union payload — it adopts the member's
# declared element type (context-directed, as a `[]` record field does) instead of defaulting to
# `[Iarch]` and mismatching. Construct `Right([])`, extract the empty list, push two, and sum → 42.
# expect: exit 42
import std::data::{ Either }
import std::io::fd::{ IoRrr }
import std::mem::arena::growing_arena

const start = (): Either[IoRrr, [Iarch]] -> Either[IoRrr, [Iarch]].Right([])

const run! = (): Iarch -> {
	let [Iarch] xs = match start() {
		Either.Left(e) -> [],
		Either.Right(v) -> v,
	}
	const Iarch was_empty = Iarch(xs.len)

	xs = [...xs, 40]
	xs = [...xs, 2]

	return xs[0] + xs[1] + was_empty
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return run!() in a
}
