# compose-over a UNION (§8.1): a bare member `Inner` composes over the declared union `Inner`, so
# `Outer.Inner(i)` carries an `Inner` value recovered by a nested match. `Done` stays a nullary tag.
# expect: exit 105
# check: root
union Inner = { A(Iarch), B(Iarch) }
union Outer = { Inner, Done }
const get = (Outer o): Iarch -> match o {
	Outer.Inner(i) -> match i { Inner.A(n) -> n, Inner.B(n) -> n + 100 },
	Outer.Done -> 0,
}

const main_body! = (): Iarch -> get(Outer.Inner(Inner.B(5)))

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
