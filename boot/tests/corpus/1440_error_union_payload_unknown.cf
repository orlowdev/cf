# A union member's payload must name a known type AT THE DECLARATION — a never-constructed
# member must not smuggle an unknown type past the checker (a payload is an 8-byte slot, so
# layout never resolves the name).
# expect: error
union U = { A(Nope), B }

pub const main = (): Iarch -> {
	const U u = U.B
	return 0
}
