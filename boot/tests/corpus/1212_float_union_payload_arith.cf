# a matched `Float64` payload used in float arithmetic within the arm — the bound payload carries
# its float scalar type, so `f + 2.5` picks up float codegen. 40.0 + 2.5 = 42.5 -> 42.
# expect: exit 42
union N = { I(Iarch), F(Float64) }
pub const main = () -> {
	const N n = N.F(40.0)
	return match n {
		N.I(v) -> v,
		N.F(f) -> Iarch(f + 2.5)
	}
}
