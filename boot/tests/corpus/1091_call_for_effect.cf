# a call-for-effect statement — a bare `f(args)` evaluated for its side effect with the
# result discarded — both plain and guarded by a statement-`if`. The pervasive `die(...)` /
# `close(...)` shape cf's own source uses. It compiles and runs on both compilers.
# expect: exit 9
const noop = (Iarch x): Iarch -> x + 1
pub const main = () -> {
	noop(5)
	const Iarch y = 4
	if y > 0 then noop(y)
	return 9
}
