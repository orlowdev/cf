# A function type may RETURN a dynamic array: `(Iarch) -> [Iarch]`. The caller binds the result and
# indexes it. apply(mk, 10) calls mk(10) = [10, 10], then 10 + 10 = 20.
# expect: exit 20
const mk = (Iarch n): [Iarch] -> [n, n]
const apply = ((Iarch) -> [Iarch] f, Iarch x): Iarch -> {
	const a = f(x)
	return a[0] + a[1]
}
pub const main = () -> apply(mk, 10)
