# TWO capturing closures in one call (and the same closure twice): the call-site rewrite layers
# the specialization (`combine$w0$clo1$w0$clo2`), clones build inner-first, and each layer's
# capture parameters get fresh `$sp<i>` ordinals. (13 + 29) + (11 + 11) - 22 = 42.
# expect: exit 42
const combine = ((Iarch) -> Iarch f, (Iarch) -> Iarch g, Iarch x): Iarch -> {
	const Iarch a = f(x)
	const Iarch b = g(x)

	return a + b
}

const run = (): Iarch -> {
	const Iarch p = 10
	const Iarch q = 100

	const both = combine((Iarch n): Iarch -> n + p, (Iarch n): Iarch -> n * q - 271, 3)

	const twice_same = (Iarch k): Iarch -> k + p
	const dbl = combine(twice_same, twice_same, 1)

	return both + dbl - 22
}

pub const main = () -> run()
