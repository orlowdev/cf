# a record whose only entry is a spread is valid — it inherits every field
# expect: exit 30
import "std/mem/arena/growing_arena" as growing_arena
data Point = { Iarch x, Iarch y }
data Clone = { ...Point }

const main_body! = (): Iarch -> {
	const Clone c = { x: 10, y: 20 }
	return c.x + c.y
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
