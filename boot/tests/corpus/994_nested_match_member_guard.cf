# a nested member sub-pattern guards on a union-typed payload field's tag
# expect: exit 12
union Op = { Add, Sub, Mul }
union Expr = { Lit(Iarch), Bin(Op, Iarch, Iarch) }
pub const eval = (Expr e): Iarch -> match e {
	Expr.Lit(v) -> v,
	Expr.Bin(Add, l, r) -> l + r,
	Expr.Bin(Sub, l, r) -> l - r,
	Expr.Bin(Mul, l, r) -> l * r,
	_ -> 0,
}
pub const main = () -> {
	const Expr a = Expr.Bin(Op.Add, 3, 4)
	const Expr b = Expr.Bin(Op.Mul, 1, 5)
	return eval(a) + eval(b)
}
