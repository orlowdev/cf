# Two demands, two hidden pointers: a `uses A, B` function receives both, each resolved at the call
# site from its own provide, and reads a field from each (context.md §4).
# expect: exit 30
import std::mem::arena::growing_arena
import std::mem::ctx

data A = { Iarch x }
data B = { Iarch y }

pub const rd = (): Iarch uses A, B -> {
	const a = std::mem::ctx::consume(A)
	const b = std::mem::ctx::consume(B)

	return a.x + b.y
}

pub const main = () -> {
	const A ca = { x: 10 }
	const B cb = { y: 20 }
	const n = growing_arena::of(1024)
		|> std::mem::ctx::provide(ca)
		|> std::mem::ctx::provide(cb)

	return rd()
}
