# A nested namespace access `pal.Color.Green` strips only the leading `pal.`, leaving the union
# member `Color.Green`; `pal.g()` calls the module's accessor. Tag-only union equality then holds.
# expect: exit 7
import "pal" as pal
pub const main = (): Iarch -> {
	if pal.g() == pal.Color.Green then return 7
	return 0
}
