# a generic UNION parameterized by an array-typed type variable: `wrap` returns `Maybe['T]`
# and is called at `'T = [Iarch]`, so the `Maybe$[Iarch]` instance carries a `[Iarch]` payload
# expect: exit 42
union Maybe['V] = { Just('V), Nothing }
const wrap = ['T]('T v): Maybe['T] -> Maybe['T].Just(v)

const main_body! = (): Iarch -> {
	const [Iarch] xs = [42, 1]
	const m = wrap(xs)
	return match m { Maybe.Just(v) -> v[0], Maybe.Nothing -> 0 }
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
