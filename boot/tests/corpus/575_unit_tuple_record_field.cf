# a record field may be a tuple that contains a unit element
# expect: exit 12
import "std/mem/arena/fixed_arena" as fixed_arena
data R = { (Iarch, Unit) p }

const main_body! = (): Iarch -> {
	const r = R({ p: (12, ()) })
	return r.p[0]
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
