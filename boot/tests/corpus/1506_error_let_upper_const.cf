# expect: error
# an aggregate value const cannot initialize a `let` — the mutable copy would masquerade as
# the const (bind it with `const`, or construct the value explicitly)
data Fd = { Uarch n }
pub const STDOUT = Fd({ n: Uarch(1) })

pub const main = (): Iarch -> {
	let Fd f = STDOUT

	return Iarch(f.n)
}
