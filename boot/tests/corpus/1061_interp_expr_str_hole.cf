# an expression hole may itself be a Str-typed expression (here indexing a Str builds
# a byte; a Str value flows through `cf_str_append`). "hi ${s}" with s="yo" → length 5
# expect: exit 5

const main_body! = (): Iarch -> {
	const Str s = "yo"
	const Str m = "hi ${s}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
