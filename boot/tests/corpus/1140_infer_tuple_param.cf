# A type argument is inferred STRUCTURALLY from a tuple parameter position: fst((10, 30)) matches
# the `('T, Iarch)` parameter and binds 'T = Iarch with no explicit type argument.
# expect: exit 30
import std::mem::arena::fixed_arena
const fst = ['T](('T, Iarch) p): Iarch -> p[1]

const main_body! = (): Iarch -> fst((10, 30))

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
