# A `$`-Let's initializer was never scanned by the coloring pass (the is_stack_name early-exit),
# so a node allocation hidden inside it — here the interpolated Str the `.len` reads — escaped the
# `!` algebra entirely: a provably-colorless function silently allocated on the root page, and the
# zero-root "provably never allocates" guarantee was false. The `$` binding itself is stack; the
# interp is not. The function must wear `!`.
# expect: error
const f = (Iarch y): Iarch -> {
	const $n = "x${y}z".len
	if $n >= 3 then return 4
	return 0
}
pub const main = () -> f(7)
