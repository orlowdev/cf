# a one-element array iterates once
# expect: exit 7

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [1 Iarch] xs = [7]
	let Iarch sum = 0
	for x in xs {
		sum += x
	}
	return sum
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
