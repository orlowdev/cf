# a nested tuple `((1, 2), 3)` renders recursively (11 bytes) — the stringifier descends positions
# expect: exit 11

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const t = ((1, 2), 3)
	const Str m = "${t}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
