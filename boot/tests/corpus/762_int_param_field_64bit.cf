# a plain `Iarch` parameter and an `Iarch` record field are now 64-bit (Iarch): a product past
# 2^31 survives round-trips through the param and the field without truncation.
# expect: exit 7
import std::mem::arena::fixed_arena
data Box = { Iarch v }
pub const scale = (Iarch a): Iarch -> a * 1000000

const main_body! = (): Iarch -> {
	const Box b = Box({ v: scale(5000) })
	return if b.v > 2000000000 then 7 else 0
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
