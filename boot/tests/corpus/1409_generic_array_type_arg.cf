# a dynamic-array type as a generic type ARGUMENT: `W[Iarch, [Iarch]]` — the `R` payload carries a
# `[Iarch]`. The array flows through the generic union's instantiation (parser encodes `[Iarch]` as
# the empty-base bracket string, monomorph's subst_slot expands it into a `$dyn` payload). Build
# [7, 35], wrap in R, match it back out, sum → exit 42.
# expect: exit 42
import std::mem::arena::growing_arena

union W['A, 'B] = { L('A), R('B) }

const wrap = ([Iarch] xs): W[Iarch, [Iarch]] -> W[Iarch, [Iarch]].R(xs)

const total = (W[Iarch, [Iarch]] w): Iarch -> match w {
	W.L(a) -> a,
	W.R(xs) -> xs[0] + xs[1],
}

const run! = (): Iarch -> {
	let [Iarch] xs = []
	xs = [...xs, 7]
	xs = [...xs, 35]

	return total(wrap(xs))
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return run!() in a
}
