# open a file, read into a byte buffer, echo it to stdout, close; exit = bytes read (8)
# syscall wrappers return Iarch as a test convenience (fd/count surface as values without a
# Uarch->Iarch cast, which cfcc lacks); the ratified floor returns Uarch.
# expect: exit 8
import std::mem::arena::fixed_arena
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Iarch -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"
pub const open = (*[Uint8] path, Uarch flags, Uarch mode): Iarch -> syscall6(5, path, flags, mode, 0, 0, 0)
pub const read = (Uarch fd, *[Uint8] buf, Uarch n): Iarch -> syscall6(3, fd, buf, n, 0, 0, 0)
pub const write = (Uarch fd, *[Uint8] buf, Uarch n): Iarch -> syscall6(4, fd, buf, n, 0, 0, 0)
pub const close = (Uarch fd): Iarch -> syscall6(6, fd, 0, 0, 0, 0, 0)

const main_body! = (): Iarch -> {
	const Iarch fd = open("/dev/zero".bytes, 0, 0)
	let [8 Uint8] buf
	const Iarch n = read(fd, buf, 8)
	write(1, buf, n)
	close(fd)
	return n
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
