# A value-block arm that binds a payload, runs a statement, and yields a RECORD (an aggregate
# flows through the merge slot as an arena pointer); a later field access reads through it.
# expect: exit 42
data Bag = { Iarch v }
union M = { Some(Iarch), None }
pub const main = () -> {
	let M m = M.Some(40)
	let Bag r = match m {
		M.Some(x) -> {
			let Iarch t = x + 2
			<- Bag({ v: t })
		},
		M.None -> { <- Bag({ v: 0 }) }
	}
	return r.v
}
