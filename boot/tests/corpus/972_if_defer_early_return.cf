# a `defer` fires on an early return inside an `if` branch (after the value snapshot)
# expect: exit 0
import "std/mem/arena/fixed_arena" as fixed_arena
data Box = { Iarch v }
pub const bump = (*Box b): Unit -> {
	b.v = b.v + 1
	return ()
}
pub const f! = (Iarch n): Iarch -> {
	let Box b = Box({ v: 0 })
	defer bump(&b)
	if n > 0 then return b.v
	return 99
}

const main_body! = (): Iarch -> f!(5)

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
