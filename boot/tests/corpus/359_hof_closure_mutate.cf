# A closure passed to a HOF captures BY REFERENCE — calling it through the HOF
# mutates the enclosing variable. apply(bump, 10) then apply(bump, 20): acc = 30.
# expect: exit 30
const apply = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x)
const run = (): Iarch -> {
	let Iarch acc = 0
	const bump = (Iarch k): Iarch -> {
		acc = acc + k
		return acc
	}
	const a = apply(bump, 10)
	const b = apply(bump, 20)
	return acc
}
pub const main = () -> run()
