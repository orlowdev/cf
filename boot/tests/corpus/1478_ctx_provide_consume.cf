# A const provide reaches its consumer: `main` provides `Cfg` on an arena, a colorless `uses Cfg`
# function consumes it and reads a field. The exit code IS the consumed value (context.md §4).
# expect: exit 42
import std::mem::arena::growing_arena
import std::mem::ctx

data Cfg = { Iarch n }

pub const rd = (): Iarch uses Cfg -> {
	const c = std::mem::ctx::consume(Cfg)

	return c.n
}

pub const main = () -> {
	const Cfg cfg = { n: 42 }
	const a = growing_arena::of(1024) |> std::mem::ctx::provide(cfg)

	return rd()
}
