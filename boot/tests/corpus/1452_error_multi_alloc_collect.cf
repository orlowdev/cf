# the `!`-marker gate COLLECTS: every mis-colored declaration (unmarked-but-allocating,
# marked-but-clean) reports in ONE run instead of dying at the first
# expect: error
const keep_a = (Iarch n): Iarch -> {
	const [Iarch] xs = [n, n]

	return xs[0]
}

const keep_b = (Iarch n): Iarch -> {
	const [Iarch] ys = [n, n, n]

	return ys[1]
}

pub const main = (): Iarch -> {
	return keep_a(1) + keep_b(2)
}
