# member identity is nominal, not by bare name: a top-level union named `Green` (colliding with
# bound `Big`'s inline member `Green`) is NOT thereby a member of `Big` — it is checked as a
# sub-union, and `Green`'s `Blue` is absent from `Big`, so `f[Green]` is rejected
# expect: error
union Big = { Red, Green }
union Green = { Red, Blue }
pub const f = [Big 'T]('T x): Iarch -> 0
pub const main = () -> f[Green](Green.Red)
