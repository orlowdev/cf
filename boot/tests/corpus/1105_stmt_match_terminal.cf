# A statement `match` that is EXHAUSTIVE without a `_` (its arms cover every member),
# followed by the explicit trailing `return` a statement match always needs.
# expect: exit 5
import "std/mem/arena/fixed_arena" as fixed_arena
union Opt = { None, Some(Iarch) }
const unwrap = (Opt o): Iarch -> {
	let Iarch r = 0
	match o {
		Opt.Some(v) -> { r = v },
		Opt.None -> { r = 0 }
	}
	return r
}

const main_body! = (): Iarch -> {
	return unwrap(Opt.Some(5)) + unwrap(Opt.None)
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
