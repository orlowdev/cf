# equals appends one verdict per assertion onto the case's `let` verdict provide (testing.md §4),
# consuming it by type at any call depth (here through `body`, itself `uses Verdicts`). The
# accumulator's fail count is the number of mismatches: two matches, two mismatches -> exit 2. This
# is the accumulator pipe (structural_eq -> verdict_push -> ctx) without the `case!` sugar.
# expect: exit 2
import std::mem::arena::test_arena
import std::mem::ctx
import std::test::{ Verdicts, equals }

const val = (Iarch x): Iarch -> x

pub const body = (): () uses Verdicts -> {
	val(1) |> equals(1)
	val(2) |> equals(2)
	val(1) |> equals(2)
	val(5) |> equals(6)
}

pub const main = () -> {
	let Verdicts vd = { desc: "accumulate", count: 0, fails: 0 }
	const a = test_arena::of(4096) |> std::mem::ctx::provide(let vd)
	body()
	const r = std::mem::ctx::consume(Verdicts)

	return Iarch(r.fails)
}
