# A statement `match` is never terminal: a function whose body is only a `match` (even with
# every arm returning) still needs an explicit trailing `return`. Both compilers reject it.
# expect: error
union Opt = { None, Some(Iarch) }
const unwrap = (Opt o): Iarch -> {
	match o {
		Opt.Some(v) -> { return v },
		Opt.None -> { return 0 }
	}
}
pub const main = () -> {
	return unwrap(Opt.Some(5))
}
