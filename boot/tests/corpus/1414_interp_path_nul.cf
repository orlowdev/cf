# an interpolated string is NUL-terminated like a string literal, so a path built with `"${...}"` can
# be handed straight to `open`/`read`/`write` — the syscall reads a C string. Write and read a file
# through interpolated paths and confirm the round-trip → exit 5 ("hello").
# expect: exit 5
import std::data::{ Either }
import std::io::file::{ write_file, read_file! }
import std::io::fd::{ IoRrr }
import std::mem::arena::growing_arena

const run! = (): Iarch -> {
	const Str dir = "/tmp"
	const Str name = "cf_t1414.txt"

	write_file("${dir}/${name}", "hello")

	const Either[IoRrr, Str] r = read_file!("${dir}/${name}")

	return match r {
		Either.Left(e) -> 0 - 1,
		Either.Right(s) -> Iarch(s.len),
	}
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return run!() in a
}
