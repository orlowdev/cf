# region-outlives: laundering `&local` through a pointer binding does not launder its lifetime —
# the binding inherits the local-escape taint, so returning it is still rejected (memory_model §6).
# expect: error
data Point = { Iarch x }
const leak = (): Point -> {
	let Point local = { x: 7 }
	const *Point p = &local
	return p
}
pub const main = () -> leak().x
