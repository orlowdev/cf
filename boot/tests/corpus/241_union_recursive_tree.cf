# a recursive union with a two-way aggregate payload — a binary tree fold
# expect: exit 6
import std::mem::arena::fixed_arena
union Tree = { Leaf(Iarch), Node(Tree, Tree) }
const sum = (Tree t): Iarch -> match t {
	Tree.Leaf(v) -> v,
	Tree.Node(l, r) -> sum(l) + sum(r),
}

const main_body! = (): Iarch -> {
	const Tree t = Tree.Node(Tree.Node(Tree.Leaf(1), Tree.Leaf(2)), Tree.Leaf(3))
	return sum(t)
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
