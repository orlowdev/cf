# type arguments are inferred from the argument types (no explicit [T] needed)
# expect: exit 45
# check: root
union Color = { Red, Green, Blue }
data Box = { Iarch v }
pub const id = ['T]('T x): 'T -> x
pub const unbox = ['T]('T b): Iarch -> b.v
pub const rank = (Color c): Iarch -> match c { Color.Red -> 1, Color.Green -> 2, Color.Blue -> 3 }

const main_body! = (): Iarch -> {
	const Iarch n = id(40)
	const Box b = { v: 3 }
	const Color c = id(Color.Green)
	return n + unbox(b) + rank(c)
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
