# A `$`-marked binding lives on the STACK (`$` — it's in the `$tack`), reclaimed when the frame pops.
# `work` builds a `$p` record with no geometry and no `!` marker: a `$` value is not residue (like a
# scalar), so it doesn't color the function, and `main` may bare-call it. Only the scalar sum leaves.
# expect: exit 7
data Point = { Iarch x, Iarch y }
const work = (): Iarch -> {
	const $p = Point({ x: 3, y: 4 })
	return $p.x + $p.y
}
pub const main = () -> work()
