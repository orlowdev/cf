# nested namespace reexports CHAIN transitively (module_system §5): `top` reexports `mid` as a
# namespace, `mid` reexports `impl` as a namespace. A single window over `top` traverses all three
# hops to impl's function — `t.mid.inner.thing` — resolved through the module graph, no depth limit.
# expect: exit 42
import "top" as t

pub const main = () -> t.mid.inner.thing()
