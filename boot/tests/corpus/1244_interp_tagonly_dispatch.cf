# the runtime tag dispatch selects the right member: `Color.Blue` puts `B` (ASCII 66) after `Color.`
# expect: exit 66
import "std/mem/arena/growing_arena" as growing_arena
union Color = { Red, Green, Blue }

const main_body! = (): Iarch -> {
	const Color c = Color.Blue
	const Str m = "${c}"
	return Iarch(m[6])
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
