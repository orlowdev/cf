# union members with MIXED-WIDTH payloads (the aggregate wall, half 2): a word (Iarch), a
# Str, a [Iarch] dynamic array, and a tag-only member, each constructed and match-bound to
# a local of the payload's own type. cf's AST (ast.cf Expr/Stmt) is built on these.
# expect: exit 116
# check: root
union E = { Num(Iarch), Name(Str), List([Iarch]), Nil }
const val = (E e): Iarch -> match e {
	E.Num(n) -> n,
	E.Name(s) -> Iarch(s.len),
	E.List(xs) -> Iarch(xs.len),
	E.Nil -> 99,
}

const main_body! = (): Iarch -> {
	let [Iarch] arr = [1, 2, 3, 4, 5]
	return val(E.Num(10)) + val(E.Name("hi")) + val(E.List(arr)) + val(E.Nil)
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
