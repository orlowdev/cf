# std::data::str `split` keeps empty pieces (field positions stay aligned) and yields fresh owned
# elements; `join` concatenates with a separator between each pair. Splitting on a separator and
# joining on it round-trips the string.
# expect: exit 42
import std::data::str::{ eq, is_empty, split, join }

pub const main = () -> {
	const [Str] parts = split(",", "a,b,,c")

	if Iarch(parts.len) != 4 then return 1
	if !eq(parts[0], "a") then return 2
	if !eq(parts[1], "b") then return 3
	if !is_empty(parts[2]) then return 4
	if !eq(parts[3], "c") then return 5
	if !eq(join(",", parts), "a,b,,c") then return 6
	if !eq(join(" - ", parts), "a - b -  - c") then return 7

	const [Str] whole = split(";", "abc")

	if Iarch(whole.len) != 1 then return 8
	if !eq(whole[0], "abc") then return 9
	if !eq(join(", ", ["x", "y"]), "x, y") then return 10

	return 42
}
