# a record is declared, constructed with a data literal, and read by field
# expect: exit 7
import std::mem::arena::fixed_arena
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point p = { x: 3, y: 4 }
	return p.x + p.y
}

pub const main = () -> {
	const a = fixed_arena::of(4096)
	return main_body!() in a
}
