# The interlock refuses an elastic carve whose handle is read as a WORD (peek(b)) — the
# handle could be stashed past a reset, and a handed-over handle lets a callee pull inside
# its own bracket. The carve stays survivor and accumulates to a clean oom (70).
# expect: exit 70
import "std/mem/arena/fixed_arena" as fixed_arena
import "std/mem/arena/growing_arena" as growing_arena
data Acc = { Iarch n }
const work! = (Iarch k): Iarch -> {
	let [Iarch] xs = []
	let Iarch i = 0
	loop {
		if i >= 4000 then break
		xs = [...xs, i]
		i = i + 1
	}
	return xs[k]
}
const bump = (*Acc a): Iarch -> {
	a.n = a.n + 1
	return 0
}
const peek = (Iarch h): Iarch -> h - h
const run! = (Iarch n): Iarch -> {
	let Acc acc = Acc({ n: 0 })
	let Iarch s = 0
	let Iarch i = 0
	loop {
		if i >= n then break
		const b = growing_arena.of(4096)
		const Iarch w = work!(2) in b
		s = s + w + peek(b)
		bump(&acc)
		i = i + 1
	}
	return s / n + 40
}
pub const main = () -> {
	const a = fixed_arena.of(262144)
	return run!(200) in a
}
