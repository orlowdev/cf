# An INFERRED return type participating in inference itself: a function whose omitted return
# derives to a generic-union INSTANCE (`Maybe.Just(1)` → `Maybe$Iarch`) is matched directly —
# the graft iteration reruns the monomorph round with the derived return written onto the raw
# program (seeded with the minted type instances), so the match arms resolve; and a `Str`-
# deriving function's result pins a generic call's type argument (`id(g())` → `id[Str]`).
# 1 + 41 = 42.
# expect: exit 42
import std::mem::arena::growing_arena
import std::data::str::{ eq }
import std::data::maybe::{ Maybe }

const id = ['A]('A x): 'A -> x

const g = () -> "hello"

const maybe_one = () -> Maybe.Just(1)

const main_body = () -> {
	const m = maybe_one()

	const Iarch a = match m { Maybe.Just(v) -> v, Maybe.Nothing -> 0 }

	let Iarch b = 0
	if eq(id(g()), "hello") then b = 41

	return a + b
}

pub const main = () -> {
	const ar = growing_arena::of(1048576)

	return main_body() in ar
}
