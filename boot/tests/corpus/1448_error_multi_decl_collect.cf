# D1 diagnostics: the typechecker COLLECTS one located error per declaration instead of dying
# on the first — a record's unknown field type, a union's unknown payload, and two function
# bodies' errors are all reported in one run (errors as values, printed at the CLI edge).
# expect: error
data Point = { Nope x, Iarch y }

union Shape = { Dot, Box(Missing) }

const first_bad = (): Iarch -> {
	const Str s = 42

	return 0
}

const second_bad = (Iarch a): Iarch -> {
	return a + "no"
}

pub const main = (): Iarch -> {
	return first_bad() + second_bad(1)
}
