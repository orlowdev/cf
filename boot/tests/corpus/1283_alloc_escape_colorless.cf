# a constructed aggregate that ESCAPES by returning is charged to the caller, not the allocator, so
# the builder stays colorless — no `!`.
# expect: exit 5
data Point = { Iarch x, Iarch y }
const make = (Iarch a): Point -> {
	const Point p = { x: a, y: a }
	return p
}
pub const main = () -> make(5).x
