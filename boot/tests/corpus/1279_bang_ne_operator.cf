# the `!` name-suffix must not swallow the `!=` operator: `!` joins a name only when the
# next character is not `=`, so `n != 0` and `n!= 0` both stay the not-equal operator.
# expect: exit 7
pub const main = () -> {
	let Iarch n = 5
	let Iarch r = 0
	if n != 0 then r = r + 3
	if n!= 0 then r = r + 4
	return r
}
