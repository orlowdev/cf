# write two bytes into a `[N Uint8]` buffer and read them back (Uint8 element, loadub/storeb)
# expect: exit 177

import "std/mem/arena/fixed_arena" as fixed_arena
const main_body! = (): Iarch -> {
	let [4 Uint8] buf
	buf[0] = 72
	buf[1] = 105
	return Iarch(buf[0]) + Iarch(buf[1])
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
