# mutating one record does not disturb another of the same type
# expect: exit 120
import "std/mem/arena/fixed_arena" as fixed_arena
data Box = { Iarch v }

const main_body! = (): Iarch -> {
	let Box a = { v: 10 }
	let Box b = { v: 20 }
	a.v = 100
	return a.v + b.v
}

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
