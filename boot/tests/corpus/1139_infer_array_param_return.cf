# The inferred element type flows to a `['T]` RETURN: dup(a) returns the same array type.
# expect: exit 42
const dup = ['T](['T] xs): ['T] -> xs

const main_body! = (): Iarch -> {
	let [Iarch] a = [42, 1]
	let [Iarch] b = dup(a)
	return b[0]
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
