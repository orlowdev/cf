# runaway NON-tail recursion (pending `+ 1` per frame — no TCO applies) hits the stack probe
# and exits through the floor's `cf_oos` trap (72, beside `cf_oom`'s 70) instead of running
# into the guard page as a raw SIGSEGV (139). Bounded recursion below the threshold still
# runs to completion — the shallow call proves the probe passes in the success path.
# expect: exit 72
const deep = (Int n): Int -> {
	if n == 0 then return 0

	return deep(n - 1) + 1
}

pub const main = (): Int -> {
	if deep(1000) != 1000 then return 1

	return deep(100000000)
}
