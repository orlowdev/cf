# A function type may take a tuple argument: `((Iarch, Iarch)) -> Iarch`. The fn value receives the
# tuple by pointer and indexes it. `apply(sumit, (2, 3))` = 2 + 3 = 5.
# expect: exit 5
const sumit = ((Iarch, Iarch) t): Iarch -> t[0] + t[1]
const apply = (((Iarch, Iarch)) -> Iarch f, (Iarch, Iarch) q): Iarch -> f(q)
pub const main = () -> apply(sumit, (2, 3))
