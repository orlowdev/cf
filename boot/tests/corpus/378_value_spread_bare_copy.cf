# a bare spread `{ ...a }` copies every field
# expect: exit 3
# check: root
data Point = { Iarch x, Iarch y }

const main_body! = (): Iarch -> {
	const Point a = { x: 1, y: 2 }
	const Point b = { ...a }
	return b.x + b.y
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
