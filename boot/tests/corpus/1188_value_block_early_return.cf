# A value block may take an early `return` on one path and `<- v` on another — the block yields
# on the path that reaches its `<-`, and the function returns on the path that reaches `return`.
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
union M = { Some(Iarch), None }
const f = (M m): Iarch -> {
	let Iarch r = match m {
		M.Some(x) -> {
			if x == 0 then return 99
			<- x + 1
		},
		M.None -> 7
	}
	return r
}

const main_body! = (): Iarch -> f(M.Some(41))

pub const main = () -> {
	const a = fixed_arena.of(4096)
	return main_body!() in a
}
