# A value block may take an early `return` on one path and `<- v` on another — the block yields
# on the path that reaches its `<-`, and the function returns on the path that reaches `return`.
# expect: exit 42
union M = { Some(Iarch), None }
const f = (M m): Iarch -> {
	let Iarch r = match m {
		M.Some(x) -> { if x == 0 then return 99 <- x + 1 },
		M.None -> 7
	}
	return r
}
pub const main = () -> f(M.Some(41))
