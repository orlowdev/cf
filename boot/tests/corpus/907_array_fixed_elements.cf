# a `[N Int32]` array: fixed-width elements, index read + `for` sum
# expect: exit 102

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [4 Int32] xs = [10, 20, 30, 42]
	let Iarch acc = 0
	for x in xs {
		acc = acc + Iarch(x)
	}
	return acc
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
