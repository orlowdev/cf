# an interpolation hole may be a full expression, not just a bare name: `${a + b}`
# and `${a * 2}` → "sum=42, twice=80" has length 16
# expect: exit 16

const main_body! = (): Iarch -> {
	let Iarch a = 40
	let Iarch b = 2
	const Str m = "sum=${a + b}, twice=${a * 2}"
	return m.len
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
