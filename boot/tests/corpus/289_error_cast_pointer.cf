# A pointer widens only to a FULL register word (`Uarch(p)`/`Iarch(p)`) — an address is visible as a
# number. Narrowing it to a sub-word integer truncates the address and is rejected (type_system §6.4);
# the dangerous direction, number→pointer, has no cast at all.
# expect: error
pub const main = () -> {
	return Iarch(Int8("hi".bytes))
}
