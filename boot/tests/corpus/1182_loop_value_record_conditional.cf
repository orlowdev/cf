# a value-yielding `loop` whose `<- v` is an `if` that yields a record on each branch
# expect: exit 42
# check: root
data Bag = { Iarch v }

const main_body! = (): Iarch -> {
	let Iarch n = 0
	let Bag r = loop {
		<- if n == 0 then Bag({ v: 42 }) else Bag({ v: 1 })
	}
	return r.v
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
