# region-outlives: storing `&local` into a caller-provided aggregate (an `outer` `*T` parameter that
# outlives the call) rehomes a pointer into a shorter-lived local — rejected (memory_model §6).
# expect: error
data Point = { Iarch x }
data Holder = { *Point p }
const stash = (*Holder h): Iarch -> {
	let Point local = { x: 7 }
	h.p = &local
	return 0
}
pub const main = () -> {
	let Point keep = { x: 1 }
	let Holder hh = Holder({ p: &keep })
	const w = stash(&hh)
	return hh.p.x
}
