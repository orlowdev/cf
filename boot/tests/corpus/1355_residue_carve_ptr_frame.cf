# The residue-carve tightening (memory_model §8): a per-call child arena whose handle
# provably never escapes is carved from the frame's RESIDUE side, so the frame bracket
# reclaims the whole child — even where the survivor-scope mark is DISQUALIFIED (helper2!
# holds a writable `*Acc`, so nothing else would free the carve before node death). 20
# calls x 512 KiB through a 1 MiB parent fit only under the tightening.
# expect: exit 42
import "std/mem/arena/fixed_arena" as fixed_arena
data Acc = { Iarch n }
const eat! = (Iarch k): Iarch -> {
	let [102400 Uint8] buf
	return k
}
const helper2! = (*Acc a, Iarch k): Iarch -> {
	const b = fixed_arena.of(524288)
	const Iarch r = eat!(k) in b
	a.n = a.n + 1
	return r
}
const main_body! = (): Iarch -> {
	let Acc acc = Acc({ n: 0 })
	let Iarch i = 0
	loop {
		if i >= 20 then break
		helper2!(&acc, i)
		i = i + 1
	}
	return acc.n + 22
}
pub const main = () -> {
	const a = fixed_arena.of(1048576)
	return main_body!() in a
}
