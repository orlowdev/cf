# The scalar-projection exemption (the red-team's p2/p16): `measure` only reads `s.len` — a
# WORD copy, no pointer into `s` survives — so its summary row is clean and the interp
# argument is statement scratch, born residue-side. The call sits in DO position (no scalar
# binding blanket applies) and the rehoming `bump2(&acc, …)` disqualifies the survivor loop
# mark, so the interps are reclaimed ONLY if the exemption keeps them off the survivor side:
# 5000 of them through a 64 KiB fixed arena trap without it (the `.len` pin used to mark
# `s` return-aliased, forcing every interp survivor).
# expect: exit 42
import std::mem::arena::fixed_arena
data Acc = { Iarch n }
const measure = (Str s): Iarch -> Iarch(s.len)
const bump2 = (*Acc a, Iarch k): Iarch -> {
	a.n = a.n + k
	return 0
}
const main_body! = (): Iarch -> {
	let Acc acc = Acc({ n: 0 })
	let Iarch i = 0
	loop {
		if i >= 5000 then break
		bump2(&acc, measure("xy${i}z"))
		i = i + 1
	}
	return acc.n - 33848
}
pub const main = () -> {
	const a = fixed_arena::of(65536)
	return main_body!() in a
}
