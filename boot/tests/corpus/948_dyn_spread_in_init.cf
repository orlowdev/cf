# a `[T]` initializer MAY be a value-level spread `[...src, e]` (general copy-append, distinct
# from in-place growth `xs = [...xs, e]`): `ys` copies `xs` and appends 3. xs stays length 2;
# ys is length 3 = [1, 2, 3]. 2 + 3 + 6 = 11.
# expect: exit 11

const main_body! = (): Iarch -> {
	const [Iarch] xs = [1, 2]
	const [Iarch] ys = [...xs, 3]
	return Iarch(xs.len) + Iarch(ys.len) + ys[0] + ys[1] + ys[2]
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
