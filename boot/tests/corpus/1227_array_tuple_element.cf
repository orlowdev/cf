# a dynamic-ARRAY tuple element (previously a rejected "later brick"): the array header pointer rides
# in the position's 8-byte slot, spelled `[Elem]` so `t[0][i]` indexes into it. t[0][1]=20 + t[1]=5.
# expect: exit 25

const main_body! = (): Iarch -> {
	const t = ([10, 20, 30], 5)
	return t[0][1] + t[1]
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
