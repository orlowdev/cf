# a function returns a `[N Record]` array; the caller binds and indexes it
# expect: exit 9
data P = { Iarch x, Iarch y }
const mk = (Iarch a, Iarch b): P -> ({ x: a, y: b })
const pair = (): [2 P] -> [mk(3, 4), mk(5, 6)]
pub const main = () -> {
	const [2 P] ps = pair()
	return ps[0].x + ps[1].y
}
