# Inlining a HOF called with a capturing closure must substitute a value parameter that appears as
# a FIELD or INDEX base (`f(b.n)`), not just a bare `Var` — else the parameter name leaks into the
# inlined body. apply(addbase, bx) computes base + bx.n = 10 + 7.
# expect: exit 17
data Box = { Iarch n }
const apply = ((Iarch) -> Iarch f, Box b): Iarch -> f(b.n)
const run = (): Iarch -> {
	let Iarch base = 10
	const addbase = (Iarch k): Iarch -> base + k
	let Box bx = { n: 7 }
	return apply(addbase, bx)
}
pub const main = () -> run()
