# assigning a `[Float64]` element in place (`xs[0] = 40.5`) stores the float with `stored`. 40 + 2 = 42.
# expect: exit 42

const main_body! = (): Iarch -> {
	let [Float64] xs = [1.0, 2.0]
	xs[0] = 40.5
	return Iarch(xs[0]) + Iarch(xs[1])
}

pub const main = () -> {
	const a = mem.arena.of(4096)
	return main_body!() in a
}
