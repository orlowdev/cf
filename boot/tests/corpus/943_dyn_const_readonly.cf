# a `const [T]` is an immutable snapshot: reads work, no growth
# expect: exit 6

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [Iarch] xs = [1, 2, 3]
	let Iarch acc = 0
	for x in xs {
		acc = acc + x
	}
	return acc
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
