# The `$buf`-fixed_buffer taint propagates through a binding and blocks REHOMING too: `bx` is an
# aggregate allocated in a stack-backed `fixed_buffer`, so storing it into an outer array (which
# outlives the frame) would leave a dangling element. Rejected at the rehome site.
# expect: error
import "std/mem/arena/growing_arena" as growing_arena
import "std/mem/fixed_buffer" as fixed_buffer
data Box = { Iarch lo, Iarch hi }
const make = (Iarch n): Box -> {
	const Box b = { lo: n, hi: n * 4 }
	return b
}
const run = (): [Box] -> {
	let [4096 Uint8] $buf
	const fb = fixed_buffer.of($buf)
	const bx = make(3) in fb
	let [Box] acc = []
	acc = [...acc, bx]
	return acc
}
pub const main = () -> {
	const a = growing_arena.of(65536)
	const xs = run() in a
	return 0
}
