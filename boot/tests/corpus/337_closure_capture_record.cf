# A closure captures an enclosing record by reference and mutates a field; the
# enclosing scope observes it. bump(5) then bump(2) drive c.v from 10 to 17.
# expect: exit 17
data Cell = { Iarch v }
const run! = (): Iarch -> {
	let Cell c = { v: 10 }
	const bump = (Iarch k) -> {
		c.v = c.v + k
		return c.v
	}
	const a = bump(5)
	const b = bump(2)
	return c.v
}
pub const main = () -> run!()
