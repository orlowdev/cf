# break and continue steer a `for` loop (continue advances to the next element)
# expect: exit 70

# check: root
const main_body! = (): Iarch -> {
	const [5 Iarch] xs = [10, 20, 30, 40, 50]
	let Iarch total = 0
	for x in xs {
		if x == 30 then continue
		if x == 50 then break
		total += x
	}
	return total
}

pub const main = () -> {
	const a = mem.arena.grow(4096)
	return main_body!() in a
}
