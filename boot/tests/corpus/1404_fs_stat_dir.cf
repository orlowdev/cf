# std::io::fs metadata + directory ops: write a 5-byte file and confirm file_size! reads 5; confirm
# /tmp stats as a directory; mkdir a fresh directory, confirm it exists, then rmdir it and confirm it
# is gone. Each check adds to the score → exit 42.
# expect: exit 42
import std::data::{ Either }
import std::io::file::{ write_file }
import std::io::fs::{ file_size!, stat!, exists!, mkdir, rmdir, remove }
import std::io::fd::{ IoRrr, Stat, is_dir }
import std::mem::arena::growing_arena

const probe! = (): Iarch -> {
	write_file("/tmp/cf_t1404.txt", "abcde")

	let Iarch score = 0
	const Either[IoRrr, Iarch] szr = file_size!("/tmp/cf_t1404.txt")
	const Iarch sz = match szr {
		Either.Left(e) -> -1,
		Either.Right(k) -> k,
	}

	if sz == 5 then score = score + 2

	const Either[IoRrr, Stat] tst = stat!("/tmp")
	const Bool tmp_is_dir = match tst {
		Either.Left(e) -> false,
		Either.Right(s) -> is_dir(s),
	}

	if tmp_is_dir then score = score + 20

	mkdir("/tmp/cf_t1404_d")

	if exists!("/tmp/cf_t1404_d") then score = score + 20

	rmdir("/tmp/cf_t1404_d")
	remove("/tmp/cf_t1404.txt")

	return score
}

pub const main = () -> {
	const a = growing_arena::of(1048576)

	return probe!() in a
}
