# a boxed-union interpolation hole renders `E.Right(1)` via a runtime tag dispatch (10 bytes)
# expect: exit 10
import "std/mem/arena/growing_arena" as growing_arena
union E = { Left(Iarch), Right(Iarch) }

const main_body! = (): Iarch -> {
	const E e = E.Right(1)
	const Str m = "${e}"
	return m.len
}

pub const main = () -> {
	const a = growing_arena.of(4096)
	return main_body!() in a
}
