# A function type may take a dynamic-array argument: `([Iarch]) -> Iarch`. `apply(suma, [2, 3])`
# calls suma([2, 3]) = a[0] + a[1] = 5.
# expect: exit 5
const suma = ([Iarch] a): Iarch -> a[0] + a[1]
const apply = (([Iarch]) -> Iarch f, [Iarch] q): Iarch -> f(q)
pub const main = () -> apply(suma, [2, 3])
