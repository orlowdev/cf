# Inlining substitutes a value parameter's argument in place, so a parameter used more than once
# would duplicate a side-effecting argument. With a capturing closure passed, a repeated parameter
# admits only a simple (side-effect-free) argument; a call result is rejected.
# expect: error
const twice = ((Iarch) -> Iarch f, Iarch x): Iarch -> f(x) + f(x)
const tick = (): Iarch -> 1
const run = (): Iarch -> {
	let Iarch base = 100
	const addbase = (Iarch k): Iarch -> base + k
	return twice(addbase, tick())
}
pub const main = () -> run()
