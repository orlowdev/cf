# A recursive higher-order function passed a capturing closure would inline forever (the
# fake-closure model has no runtime value to recurse on); it is rejected as a v1 limitation.
# expect: error
const rec = ((Iarch) -> Iarch f, Iarch n): Iarch -> if n == 0 then n else f(n) + rec(f, 0)
const run = (): Iarch -> {
	let Iarch base = 1
	const addbase = (Iarch k): Iarch -> base + k
	return rec(addbase, 5)
}
pub const main = () -> run()
