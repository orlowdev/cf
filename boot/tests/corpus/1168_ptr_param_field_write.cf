# a `*[T]` parameter sourced from a record FIELD is a live borrow — writes through it mutate the
# caller's field (data@0 is passed, not a copy)
# expect: exit 25
data Bag = { [Iarch] items }
const fill = (*[Iarch] xs, Iarch n): Iarch -> {
	let i = 0
	loop {
		if i >= n then break
		xs[i] = i * i
		i = i + 1
	}
	return n
}
pub const main = () -> {
	let Bag b = Bag({ items: [0, 0, 0, 0, 0] })
	const w = fill(b.items, 5)
	return b.items[3] + b.items[4]
}
