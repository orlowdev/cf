# an integer-literal match whose arms yield fresh records (merge through the `%m` slot)
# expect: exit 30
data P = { Iarch x, Iarch y }
const mk = (Iarch a, Iarch b): P -> ({ x: a, y: b })
const pick = (Iarch n): P -> match n {
	0 -> mk(1, 2),
	1 -> mk(10, 20),
	_ -> mk(0, 0),
}
pub const main = () -> {
	const P p = pick(1)
	return p.x + p.y
}
