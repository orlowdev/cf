# block-scope name reuse is restricted to SCALARS; a record name may not be reused across sibling
# blocks (its parse-time type is provisional, so cfcc cannot prove the two share a layout).
# expect: error
data P = { Iarch x }
data Q = { Iarch y, Iarch z }
const mkp = (): P -> P({ x: 1 })
const mkq = (): Q -> Q({ y: 2, z: 3 })
pub const main = () -> {
	let Iarch r = 0
	if r == 0 then {
		let P a = mkp()
		r = a.x
	}
	if r == 1 then {
		let Q a = mkq()
		r = a.y
	}
	return r
}
