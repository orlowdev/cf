# `for x in xs` iterates a fixed array
# expect: exit 10

import std::mem::arena::growing_arena
const main_body! = (): Iarch -> {
	const [4 Iarch] xs = [1, 2, 3, 4]
	let Iarch sum = 0
	for x in xs {
		sum += x
	}
	return sum
}

pub const main = () -> {
	const a = growing_arena::of(4096)
	return main_body!() in a
}
