# comptime conditional import (nested, spec-shaped). cfcc's target is fixed darwin/arm64,
# so the arm64 branch wins. The losing branches import modules that DO NOT EXIST — proving a
# losing branch dissolves and its files are never resolved.
# expect: exit 42
import comptime::{ os, arch, Os, Arch }

if os.target == Os.Darwin then
  if arch.target == Arch.Arm64 then import "impl" as { read_file }
  else import "does_not_exist_amd64" as { read_file }
else import "does_not_exist_linux" as { read_file }

pub const main = () -> read_file()
