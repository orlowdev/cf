# Per-loop-iteration reset (geometry_lowering §2, scope granularity): a loop whose body allocates
# transient residue that never escapes the iteration rewinds the node cursor each pass. Here work!
# runs `in a` (a 1 MiB arena) and its loop allocates a 100 KiB scratch buffer 50 times — 5 MiB. The
# whole-function frame reset only fires at work!'s exit (too late — the loop overflows first), so it
# is the PER-ITERATION reset that bounds peak to ~100 KiB. Without it, cf_oom (70).
# expect: exit 42
const work! = (Iarch n): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= n then break
		let [102400 Uint8] buf
		i = i + 1
	}
	return n
}
pub const main = () -> {
	const a = mem.arena.of(1048576)
	const Iarch r = work!(50) in a
	return r - 8
}
