# fixture: locals + top-level names for lsp tests

data Point = { Iarch x, Iarch y }

union Shape = { Dot, Line(Iarch) }

pub data Pub = { Iarch z }

const helper = (Iarch a): Iarch -> {
	let Iarch total = a
	total = total + 1

	return total
}

const make = (Iarch v): Point -> Point({ x: helper(v), y: v })

pub const main = ([Str] args, [Str] env) -> {
	const Point p = make(3)
	const Shape sh = Shape.Line(p.x)
	let Iarch acc = 0

	match sh {
		Shape.Line(n) -> {
			acc = acc + n + p.y
		},
		_ -> {},
	}

	const Alias q = make(4)

	return acc
}

type Alias = Point
