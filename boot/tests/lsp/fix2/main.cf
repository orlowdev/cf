# entry for cross-file rename tests

import lib::{ Pair, combine, Op }
import lib as ns

const use_pair = (Iarch n): Iarch -> {
	const Pair p = combine(n, 2)

	return p.a + p.b
}

pub const main = ([Str] args, [Str] env) -> {
	let Iarch twice = 9

	return use_pair(3) + ns::twice(twice) + lib::twice(1) + op_v(Op.Add)
}

const op_v = (Op o): Iarch -> match o {
	Op.Add -> 1,
	Op.Mul(k) -> k,
}
