export data $cf_page = { l 0, l 0, l 0, l 0, l $f1767, l 0, l 0, l 0, l 0 }
function l $cf_dyn_push_g(l %node, l %hdr, w %esize, l %reservefn) {
@start
	%es =l extuw %esize
	%hlen =l add %hdr, 8
	%hcap =l add %hdr, 16
	%len =l loadl %hlen
	%cap =l loadl %hcap
	%soff =l mul %len, %es
	%len1 =l add %len, 1
	%full =w ceql %len, %cap
	jnz %full, @grow, @fast
@fast
	%data =l loadl %hdr
	%slot =l add %data, %soff
	storel %len1, %hlen
	ret %slot
@grow
	%dbl =l mul %cap, 2
	%z =w ceql %cap, 0
	%zl =l extuw %z
	%z4 =l mul %zl, 4
	%ncap =l add %dbl, %z4
	%nbytes =l mul %ncap, %es
	%ndata =l call %reservefn(l %node, l %nbytes)
	%odata =l loadl %hdr
	%ci =l copy 0
@cwtop
	%ci8 =l add %ci, 8
	%wok =w culel %ci8, %soff
	jnz %wok, @cwbody, @cbtop
@cwbody
	%wsrc =l add %odata, %ci
	%wdst =l add %ndata, %ci
	%cw =l loadl %wsrc
	storel %cw, %wdst
	%ci =l copy %ci8
	jmp @cwtop
@cbtop
	%bdone =w cugel %ci, %soff
	jnz %bdone, @copydone, @cbbody
@cbbody
	%bsrc =l add %odata, %ci
	%bdst =l add %ndata, %ci
	%cb =w loadub %bsrc
	storeb %cb, %bdst
	%ci =l add %ci, 1
	jmp @cbtop
@copydone
	storel %ndata, %hdr
	storel %ncap, %hcap
	storel %len1, %hlen
	%gslot =l add %ndata, %soff
	ret %gslot
}
function $cf_uint_append_g(l %node, l %vhdr, l %val, l %reservefn) {
@start
	%buf =l alloc4 24
	%ip =l alloc8 8
	%vp =l alloc8 8
	storel %val, %vp
	storel 0, %ip
	%z =w ceql %val, 0
	jnz %z, @zero, @extract
@zero
	%sz =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 48, %sz
	ret
@extract
	%v =l loadl %vp
	%done =w ceql %v, 0
	jnz %done, @emit, @digit
@digit
	%q =l udiv %v, 10
	%r =l urem %v, 10
	%rc =w copy %r
	%ch =w add %rc, 48
	%i =l loadl %ip
	%da =l add %buf, %i
	storeb %ch, %da
	%i1 =l add %i, 1
	storel %i1, %ip
	storel %q, %vp
	jmp @extract
@emit
	%cnt =l loadl %ip
	storel %cnt, %vp
@eloop
	%k =l loadl %vp
	%kz =w ceql %k, 0
	jnz %kz, @edone, @estep
@estep
	%k1 =l sub %k, 1
	%dap =l add %buf, %k1
	%dch =w loadub %dap
	%es =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb %dch, %es
	storel %k1, %vp
	jmp @eloop
@edone
	ret
}
function $cf_int_append_g(l %node, l %vhdr, l %val, l %reservefn) {
@start
	%neg =w csltl %val, 0
	jnz %neg, @isneg, @pos
@isneg
	%s =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 45, %s
	%nv =l sub 0, %val
	call $cf_uint_append_g(l %node, l %vhdr, l %nv, l %reservefn)
	ret
@pos
	call $cf_uint_append_g(l %node, l %vhdr, l %val, l %reservefn)
	ret
}
function $cf_bool_append_g(l %node, l %vhdr, l %val, l %reservefn) {
@start
	%nz =w cnel %val, 0
	jnz %nz, @true, @false
@true
	%t0 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 116, %t0
	%t1 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 114, %t1
	%t2 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 117, %t2
	%t3 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 101, %t3
	ret
@false
	%f0 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 102, %f0
	%f1 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 97, %f1
	%f2 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 108, %f2
	%f3 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 115, %f3
	%f4 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 101, %f4
	ret
}
function $cf_float_append_g(l %node, l %vhdr, d %val, l %reservefn) {
@start
	%bslot =l alloc8 8
	stored %val, %bslot
	%bits =l loadl %bslot
	%exps =l shr %bits, 52
	%exp =l and %exps, 2047
	%mant =l and %bits, 4503599627370495
	%special =w ceql %exp, 2047
	jnz %special, @spec, @finite
@spec
	%isnan =w cnel %mant, 0
	jnz %isnan, @nan, @inf
@nan
	%n0 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 78, %n0
	%n1 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 97, %n1
	%n2 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 78, %n2
	ret
@inf
	%sgn =l shr %bits, 63
	jnz %sgn, @neginf, @posinf
@neginf
	%mm0 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 45, %mm0
	jmp @posinf
@posinf
	%i0 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 73, %i0
	%i1 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 110, %i1
	%i2 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 102, %i2
	ret
@finite
	%vs =l alloc8 8
	stored %val, %vs
	%isneg =w cltd %val, d_0
	jnz %isneg, @doneg, @pos
@doneg
	%s0 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 45, %s0
	%vld =d loadd %vs
	%vng =d neg %vld
	stored %vng, %vs
	jmp @pos
@pos
	%vv =d loadd %vs
	%ip =l dtosi %vv
	call $cf_uint_append_g(l %node, l %vhdr, l %ip, l %reservefn)
	%dot =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 46, %dot
	%ipf =d sltof %ip
	%frac =d sub %vv, %ipf
	%fbuf =l alloc4 8
	%fs =l alloc8 8
	stored %frac, %fs
	%ci =l alloc8 8
	storel 0, %ci
@floop
	%i =l loadl %ci
	%fdone =w csgel %i, 6
	jnz %fdone, @trim, @fstep
@fstep
	%fr =d loadd %fs
	%fr10 =d mul %fr, d_10.0
	%dg =l dtosi %fr10
	%dgc =l add %dg, 48
	%faddr =l add %fbuf, %i
	storeb %dgc, %faddr
	%dgf =d sltof %dg
	%rem =d sub %fr10, %dgf
	stored %rem, %fs
	%i1f =l add %i, 1
	storel %i1f, %ci
	jmp @floop
@trim
	%last =l alloc8 8
	storel -1, %last
	%tj =l alloc8 8
	storel 0, %tj
@tloop
	%j =l loadl %tj
	%tdone =w csgel %j, 6
	jnz %tdone, @emit, @tstep
@tstep
	%ja =l add %fbuf, %j
	%jc =w loadub %ja
	%isz =w ceqw %jc, 48
	jnz %isz, @tskip, @tset
@tset
	storel %j, %last
@tskip
	%j1 =l add %j, 1
	storel %j1, %tj
	jmp @tloop
@emit
	%ln =l loadl %last
	%allz =w csltl %ln, 0
	jnz %allz, @zero, @digits
@zero
	%z0 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 48, %z0
	ret
@digits
	%ei =l alloc8 8
	storel 0, %ei
@eloop
	%e =l loadl %ei
	%eend =w csgtl %e, %ln
	jnz %eend, @edone, @estep
@estep
	%ea =l add %fbuf, %e
	%ec =w loadub %ea
	%esl =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb %ec, %esl
	%e1 =l add %e, 1
	storel %e1, %ei
	jmp @eloop
@edone
	ret
}
function $cf_str_append_g(l %node, l %vhdr, l %str, l %reservefn) {
@start
	%bytes =l loadl %str
	%la =l add %str, 8
	%lenw =w loadw %la
	%len =l extuw %lenw
	%z =w ceql %len, 0
	jnz %z, @sdone, @scap
@scap
	%vla =l add %vhdr, 8
	%vca =l add %vhdr, 16
	%vl =l loadl %vla
	%vc =l loadl %vca
	%need =l add %vl, %len
	%fits =w culel %need, %vc
	jnz %fits, @scopy, @sgrow
@sgrow
	%nc =l copy %vc
@sgtop
	%ncd =l mul %nc, 2
	%gz =w ceql %nc, 0
	%gzl =l extuw %gz
	%gz4 =l mul %gzl, 4
	%nc =l add %ncd, %gz4
	%gok =w culel %need, %nc
	jnz %gok, @sgres, @sgtop
@sgres
	%ndata =l call %reservefn(l %node, l %nc)
	%odata =l loadl %vhdr
	%gi =l copy 0
@sgwtop
	%gi8 =l add %gi, 8
	%gwok =w culel %gi8, %vl
	jnz %gwok, @sgwbody, @sgbtop
@sgwbody
	%gws =l add %odata, %gi
	%gwd =l add %ndata, %gi
	%gw =l loadl %gws
	storel %gw, %gwd
	%gi =l copy %gi8
	jmp @sgwtop
@sgbtop
	%gbd =w cugel %gi, %vl
	jnz %gbd, @sgdone, @sgbbody
@sgbbody
	%gbs =l add %odata, %gi
	%gbdst =l add %ndata, %gi
	%gb =w loadub %gbs
	storeb %gb, %gbdst
	%gi =l add %gi, 1
	jmp @sgbtop
@sgdone
	storel %ndata, %vhdr
	storel %nc, %vca
	jmp @scopy
@scopy
	%vd =l loadl %vhdr
	%dst0 =l add %vd, %vl
	%si =l copy 0
@swtop
	%si8 =l add %si, 8
	%swok =w culel %si8, %len
	jnz %swok, @swbody, @sbtop
@swbody
	%sws =l add %bytes, %si
	%swd =l add %dst0, %si
	%sw =l loadl %sws
	storel %sw, %swd
	%si =l copy %si8
	jmp @swtop
@sbtop
	%sbd =w cugel %si, %len
	jnz %sbd, @scdone, @sbbody
@sbbody
	%sbs =l add %bytes, %si
	%sbdst =l add %dst0, %si
	%sb =w loadub %sbs
	storeb %sb, %sbdst
	%si =l add %si, 1
	jmp @sbtop
@scdone
	storel %need, %vla
	ret
@sdone
	ret
}
function l $cf_str_eq(l %a, l %b) {
@start
	%la =l add %a, 8
	%law =w loadw %la
	%lb =l add %b, 8
	%lbw =w loadw %lb
	%lne =w cnew %law, %lbw
	jnz %lne, @neq, @lenok
@lenok
	%len =l extuw %law
	%ba =l loadl %a
	%bb =l loadl %b
	%ip =l alloc8 8
	storel 0, %ip
@eloop
	%i =l loadl %ip
	%done =w cugel %i, %len
	jnz %done, @eq, @estep
@estep
	%pa =l add %ba, %i
	%ca =w loadub %pa
	%pb =l add %bb, %i
	%cb =w loadub %pb
	%bne =w cnew %ca, %cb
	jnz %bne, @neq, @econt
@econt
	%i1 =l add %i, 1
	storel %i1, %ip
	jmp @eloop
@eq
	ret 1
@neq
	ret 0
}
