data $sl225 = { l $sld225, l 5 }
data $sld226 = { b "The signed machine word ", b 226, b 128, b 148, b " cf's default integer type. Register-width (64-bit on every current target): arithmetic, comparisons, array indexing, and `.len` all speak it. `Iarch(x)` casts into it.", b 0 }
