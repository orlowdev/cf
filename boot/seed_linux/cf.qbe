	%b =w loadub %ba
	%vla =l add %vhdr, 8
	%vl =l loadl %vla
	%vca =l add %vhdr, 16
	%vc =l loadl %vca
	%sf =w cultl %vl, %vc
	jnz %sf, @sfast, @sslow
@sfast
