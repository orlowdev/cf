	%sl0 =l add %vd, %vl
	%vl1 =l add %vl, 1
	storel %vl1, %vla
	%sl =l copy %sl0
	jmp @spush
@sslow
	%sl =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	jmp @spush
@spush
	storeb %b, %sl
	%i1 =l add %i, 1
	storel %i1, %ip
	jmp @sloop
@sdone
	ret
}
function l $cf_str_eq(l %a, l %b) {
@start
	%la =l add %a, 8
	%law =w loadw %la
	%lb =l add %b, 8
	%lbw =w loadw %lb
	%lne =w cnew %law, %lbw
	jnz %lne, @neq, @lenok
@lenok
	%len =l extuw %law
	%ba =l loadl %a
	%bb =l loadl %b
	%ip =l alloc8 8
	storel 0, %ip
@eloop
	%i =l loadl %ip
	%done =w cugel %i, %len
	jnz %done, @eq, @estep
@estep
	%pa =l add %ba, %i
	%ca =w loadub %pa
	%pb =l add %bb, %i
	%cb =w loadub %pb
	%bne =w cnew %ca, %cb
	jnz %bne, @neq, @econt
@econt
	%i1 =l add %i, 1
	storel %i1, %ip
	jmp @eloop
@eq
	ret 1
@neq
	ret 0
}
