	%frac =d sub %vv, %ipf
	%fbuf =l alloc4 8
	%fs =l alloc8 8
	stored %frac, %fs
	%ci =l alloc8 8
	storel 0, %ci
@floop
	%i =l loadl %ci
	%fdone =w csgel %i, 6
	jnz %fdone, @trim, @fstep
@fstep
