	storeb 73, %i0
	%i1 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 110, %i1
	%i2 =l call $cf_dyn_push_g(l %node, l %vhdr, w 1, l %reservefn)
	storeb 102, %i2
