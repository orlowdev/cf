	%tdone =w csgel %j, 6
	jnz %tdone, @emit, @tstep
@tstep
	%ja =l add %fbuf, %j
	%jc =w loadub %ja
	%isz =w ceqw %jc, 48
	jnz %isz, @tskip, @tset
@tset
	storel %j, %last
@tskip
	%j1 =l add %j, 1
	storel %j1, %tj
	jmp @tloop
@emit
