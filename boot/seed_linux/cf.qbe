function $cf_str_append_g(l %node, l %vhdr, l %str, l %reservefn) {
@start
	%bytes =l loadl %str
	%la =l add %str, 8
	%lenw =w loadw %la
	%len =l extuw %lenw
	%ip =l alloc8 8
	storel 0, %ip
@sloop
	%i =l loadl %ip
	%d =w cugel %i, %len
	jnz %d, @sdone, @sstep
@sstep
