# lexer — source bytes to a token stream.
#
# Tracer-bullet scope: enough of the grammar to lex `pub const main = () -> N`
# and `{ return N }`. It grows into the full lexer as cf0's front end fills in.
# A token records its KIND (a `TokKind` union) plus the (start, len) slice into
# the source buffer; the parser compares identifier slices against keywords, so
# the lexer stays allocation-light (no per-token Str). Integer tokens carry their
# decoded value.

import "io" as { die }
import "token" as { TokKind, Token }

# Byte classes (ASCII).
const is_space = (Iarch c): Bool -> c == 32 || c == 9 || c == 10 || c == 13
const is_digit = (Iarch c): Bool -> c >= 48 && c <= 57
const is_alpha = (Iarch c): Bool -> (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
const is_alnum = (Iarch c): Bool -> is_alpha(c) || is_digit(c)

# Lex the first `n` bytes of `src` into a token stream terminated by `Eof`.
pub const lex = (*[Uint8] src, Iarch n): [Token] -> {
	let [Token] toks = []
	let Iarch i = 0
	loop {
		if i >= n then break
		const Iarch c = Iarch(src[i])
		if is_space(c) then {
			i = i + 1
			continue
		}
		# `#` line comment — skip to end of line (cf0 strips comments like cfcc).
		if c == 35 then {
			loop {
				if i >= n then break
				if Iarch(src[i]) == 10 then break
				i = i + 1
			}
			continue
		}
		# identifier / keyword: [A-Za-z_][A-Za-z0-9_]*
		if is_alpha(c) then {
			const Iarch start = i
			loop {
				if i >= n then break
				if is_alnum(Iarch(src[i])) then i = i + 1 else break
			}
			toks = [...toks, Token({ kind: TokKind.Ident, ival: 0, start: start, len: i - start })]
			continue
		}
		# integer literal: [0-9]+ (decimal, tracer-bullet scope)
		if is_digit(c) then {
			const Iarch start = i
			let Iarch v = 0
			loop {
				if i >= n then break
				const Iarch d = Iarch(src[i])
				if is_digit(d) then {
					v = v * 10 + (d - 48)
					i = i + 1
				} else break
			}
			toks = [...toks, Token({ kind: TokKind.IntLit, ival: v, start: start, len: i - start })]
			continue
		}
		# `-` begins either the arrow `->` or the minus operator (unary/binary).
		if c == 45 then {
			if i + 1 < n && Iarch(src[i + 1]) == 62 then {
				toks = [...toks, Token({ kind: TokKind.Arrow, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			toks = [...toks, Token({ kind: TokKind.Minus, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# arithmetic operators
		if c == 43 then {
			toks = [...toks, Token({ kind: TokKind.Plus, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 42 then {
			toks = [...toks, Token({ kind: TokKind.Star, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 47 then {
			toks = [...toks, Token({ kind: TokKind.Slash, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 37 then {
			toks = [...toks, Token({ kind: TokKind.Percent, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# `&` begins `&&` (logical) or `&` (bitwise).
		if c == 38 then {
			if i + 1 < n && Iarch(src[i + 1]) == 38 then {
				toks = [...toks, Token({ kind: TokKind.LogAnd, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			toks = [...toks, Token({ kind: TokKind.Amp, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# `|` begins `||` (logical) or `|` (bitwise).
		if c == 124 then {
			if i + 1 < n && Iarch(src[i + 1]) == 124 then {
				toks = [...toks, Token({ kind: TokKind.LogOr, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			toks = [...toks, Token({ kind: TokKind.Pipe, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 94 then {
			toks = [...toks, Token({ kind: TokKind.Caret, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# `<` begins `<<` (shift), `<=` (compare), or `<` (compare).
		if c == 60 then {
			if i + 1 < n && Iarch(src[i + 1]) == 60 then {
				toks = [...toks, Token({ kind: TokKind.Shl, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			if i + 1 < n && Iarch(src[i + 1]) == 61 then {
				toks = [...toks, Token({ kind: TokKind.Le, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			toks = [...toks, Token({ kind: TokKind.Lt, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# `>` begins `>>` (shift), `>=` (compare), or `>` (compare).
		if c == 62 then {
			if i + 1 < n && Iarch(src[i + 1]) == 62 then {
				toks = [...toks, Token({ kind: TokKind.Shr, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			if i + 1 < n && Iarch(src[i + 1]) == 61 then {
				toks = [...toks, Token({ kind: TokKind.Ge, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			toks = [...toks, Token({ kind: TokKind.Gt, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# `!` begins `!=` (compare) or `!` (logical not).
		if c == 33 then {
			if i + 1 < n && Iarch(src[i + 1]) == 61 then {
				toks = [...toks, Token({ kind: TokKind.Ne, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			toks = [...toks, Token({ kind: TokKind.Bang, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# `~` — bitwise not.
		if c == 126 then {
			toks = [...toks, Token({ kind: TokKind.Tilde, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# single-character punctuation — one guarded block each (a union has no
		# reassignment, so each kind is constructed and appended in place).
		if c == 40 then {
			toks = [...toks, Token({ kind: TokKind.LParen, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 41 then {
			toks = [...toks, Token({ kind: TokKind.RParen, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 123 then {
			toks = [...toks, Token({ kind: TokKind.LBrace, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 125 then {
			toks = [...toks, Token({ kind: TokKind.RBrace, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 91 then {
			toks = [...toks, Token({ kind: TokKind.LBracket, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 93 then {
			toks = [...toks, Token({ kind: TokKind.RBracket, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 44 then {
			toks = [...toks, Token({ kind: TokKind.Comma, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		if c == 58 then {
			toks = [...toks, Token({ kind: TokKind.Colon, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		# `=` begins `==` (compare) or `=` (binding).
		if c == 61 then {
			if i + 1 < n && Iarch(src[i + 1]) == 61 then {
				toks = [...toks, Token({ kind: TokKind.EqEq, ival: 0, start: i, len: 2 })]
				i = i + 2
				continue
			}
			toks = [...toks, Token({ kind: TokKind.Eq, ival: 0, start: i, len: 1 })]
			i = i + 1
			continue
		}
		die("cf0: lex: unexpected character\n")
	}
	toks = [...toks, Token({ kind: TokKind.Eof, ival: 0, start: n, len: 0 })]
	return toks
}
