# astutil — small pure helpers over the AST that BOTH the type-check and emit passes
# need. Defined once here (imported by each) so the two passes share one definition
# instead of carrying copies that could drift.

import "ast" as { Expr }

# A `...src` tuple-spread element (valid only inside a tuple literal) and its source.
pub const is_spread = (Expr e): Bool -> match e { Expr.Spread(x) -> true, _ -> false }
pub const spread_inner = (Expr e): Expr -> match e { Expr.Spread(x) -> x, _ -> e }

# A destructure pattern token: a `_`-led token (`_` or `_<digits>`) is a skip; a bare name
# binds a position. `skip_count` gives how many positions a skip drops (`_`→1, `_n`→n); the
# parser has already proven a `_`-led token is a well-formed skip.
pub const is_skip = (Str tok): Bool -> if Iarch(tok.len) == 0 then false else Iarch(tok[0]) == 95
pub const skip_count = (Str tok): Iarch -> {
	if Iarch(tok.len) == 1 then return 1
	let Iarch n = 0
	let Iarch i = 1
	loop {
		if i >= Iarch(tok.len) then break
		n = n * 10 + (Iarch(tok[i]) - 48)
		i = i + 1
	}
	return n
}
