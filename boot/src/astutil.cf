# astutil — small pure helpers over the AST that BOTH the type-check and emit passes
# need. Defined once here (imported by each) so the two passes share one definition
# instead of carrying copies that could drift.

import ast::{ Expr, TupElem }

# A leaf tuple position (a scalar/Str/record/word, named `name`, no sub-structure) and a
# NESTED tuple position (its own positions in `sub`). Together these build the recursive
# `[TupElem]` a tuple type carries, so tuples nest to any depth without a parsed string.
pub const tel_leaf = (Str name): TupElem -> {
	let [TupElem] none = []

	return TupElem({ name: name, sub: none })
}

pub const tel_nest = ([TupElem] sub): TupElem -> TupElem({ name: "$tuple", sub: sub })

pub const tel_is_nest = (TupElem t): Bool -> str_eq_tel(t.name, "$tuple")

# A NESTED FUNCTION-TYPE position — a function type used as an argument (or return) component of
# another function type (`((A) -> B) -> R`). Its `sub` is the nested signature: the argument
# positions followed by the return position (the same args-then-return layout `Ty.TFn` uses).
pub const tel_fn = ([TupElem] sub): TupElem -> TupElem({ name: "$fn", sub: sub })

pub const tel_is_fn = (TupElem t): Bool -> str_eq_tel(t.name, "$fn")

# byte-wise Str equality (astutil-local, to avoid importing the typecheck copy)
const str_eq_tel = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0

	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}

	return true
}

# A payload SUB-PATTERN guard, encoded in a match arm's bind string by its first byte: `=` a
# union-member guard (`=Add` bare — owner-ruled to the field's union — or `=Op.Add` qualified),
# `#` an integer guard (`#0`, a signed decimal). A plain name binds the position; `_` skips it.
# A guard constrains a payload field beyond the outer tag (`M.A(0)`, `Expr.Bin(Add, l, r)`).
pub const is_pat_guard = (Str b): Bool -> {
	if Iarch(b.len) == 0 then return false
	const Iarch c = Iarch(b[0])

	return c == 61 || c == 35
}

pub const is_member_guard = (Str b): Bool -> if Iarch(b.len) == 0 then false else Iarch(b[0]) == 61

pub const is_int_guard = (Str b): Bool -> if Iarch(b.len) == 0 then false else Iarch(b[0]) == 35

# The guard's content after the 1-byte kind tag: `=Op.Add` → `Op.Add`, `#0` → `0`.
pub const guard_body! = (Str b): Str -> {
	let [Uint8] out = []
	let Iarch i = 1

	loop {
		if i >= Iarch(b.len) then break
		out = [...out, b[i]]
		i = i + 1
	}

	return Str(out)
}

# A member guard body's qualifier (`Op.Add` → `Op`), "" when bare (`Add`).
pub const guard_qual! = (Str body): Str -> {
	let [Uint8] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(body.len) then break
		if Iarch(body[i]) == 46 then return Str(out)
		out = [...out, body[i]]
		i = i + 1
	}

	return ""
}

# A member guard body's member name (`Op.Add` → `Add`, bare `Add` → `Add`).
pub const guard_member! = (Str body): Str -> {
	let Iarch dot = 0 - 1
	let Iarch i = 0

	loop {
		if i >= Iarch(body.len) then break
		if Iarch(body[i]) == 46 then dot = i
		i = i + 1
	}

	let [Uint8] out = []
	let Iarch j = dot + 1

	loop {
		if j >= Iarch(body.len) then break
		out = [...out, body[j]]
		j = j + 1
	}

	return Str(out)
}

# A `...src` tuple-spread element (valid only inside a tuple literal) and its source.
pub const is_spread = (Expr e): Bool -> match e { Expr.Spread(x) -> true, _ -> false }

pub const spread_inner = (Expr e): Expr -> match e { Expr.Spread(x) -> x, _ -> e }

# A destructure pattern token: a `_`-led token (`_` or `_<digits>`) is a skip; a bare name
# binds a position. `skip_count` gives how many positions a skip drops (`_`→1, `_n`→n); the
# parser has already proven a `_`-led token is a well-formed skip.
# A dynamic array's element type is carried as a NAME. A NESTED array element (an array
# whose element is itself an array) is named by its spelling: `[[Str]]`'s element is the
# name `"[Str]"`. `is_nested` detects such a name (a leading `[`, byte 91) and `nested_inner`
# returns the inner element name (the bytes between the outer brackets).
pub const is_nested = (Str elem): Bool -> if Iarch(elem.len) == 0
	then false
	else Iarch(elem[0]) == 91

pub const nested_inner! = (Str elem): Str -> {
	let [Uint8] buf = []
	let Iarch i = 1
	const Iarch end = Iarch(elem.len) - 1

	loop {
		if i >= end then break
		buf = [...buf, elem[i]]
		i = i + 1
	}

	return Str(buf)
}

# The eight fixed-width integer leaves (`Int8`...`Int64`, `Uint8`...`Uint64`) — each a DISTINCT
# type carrying a bit width and a signedness, unlike the register-width `Iarch`/`Int`/`Uarch`
# word (which stay the operable `TInt`). `fixed_bits` gives the width (8/16/32/64), `fixed_signed`
# whether it is signed. Shared so typecheck (type resolution / range checks) and emit
# (canonicalization width) agree on one table.
pub const is_fixed_name = (Str name): Bool -> fixed_bits(name) != 0

# A binding whose name carries the leading `$` STACK marker (byte 36): its storage lives on the
# machine stack (QBE `alloc`), reclaimed at frame exit, rather than on a geometry node.
pub const is_stack_name = (Str name): Bool -> if Iarch(name.len) == 0
	then false
	else Iarch(name[0]) == 36

pub const fixed_bits = (Str name): Iarch -> {
	if str_eq_tel(name, "Int8") then return 8
	if str_eq_tel(name, "Uint8") then return 8
	if str_eq_tel(name, "Int16") then return 16
	if str_eq_tel(name, "Uint16") then return 16
	if str_eq_tel(name, "Int32") then return 32
	if str_eq_tel(name, "Uint32") then return 32
	if str_eq_tel(name, "Int64") then return 64
	if str_eq_tel(name, "Uint64") then return 64
	# `Uarch` is the pointer-width UNSIGNED integer — a distinct 64-bit fixed leaf (unsigned, since
	# it does not start with `I`), so it no longer mixes with the signed word `Iarch` (type_system §4)
	if str_eq_tel(name, "Uarch") then return 64

	return 0
}

pub const fixed_signed = (Str name): Bool -> {
	if Iarch(name.len) == 0 then return false

	return Iarch(name[0]) == 73
}

# The two floating-point types (`Float32` = IEEE single / QBE `s`, `Float64` = double / `d`),
# a scalar type class distinct from the integers. Shared so typecheck and emit agree on the width.
pub const is_float_name = (Str name): Bool ->
	fixed_bits(name) == 0 && (str_eq_tel(name, "Float32") || str_eq_tel(name, "Float64"))

pub const float_bits = (Str name): Iarch -> {
	if str_eq_tel(name, "Float32") then return 32
	if str_eq_tel(name, "Float64") then return 64

	return 0
}

pub const is_skip = (Str tok): Bool -> if Iarch(tok.len) == 0 then false else Iarch(tok[0]) == 95

pub const skip_count = (Str tok): Iarch -> {
	if Iarch(tok.len) == 1 then return 1
	let Iarch n = 0
	let Iarch i = 1

	loop {
		if i >= Iarch(tok.len) then break
		n = n * 10 + (Iarch(tok[i]) - 48)
		i = i + 1
	}

	return n
}
