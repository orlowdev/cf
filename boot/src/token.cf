# token — the lexical token type, shared by the lexer and parser.
#
# A token's KIND is a tag-only union, not a magic integer: the compiler enforces
# exhaustiveness at every `match` and keeps the kinds out of the value namespace.
# The `is_*` predicates below are the ergonomic bridge for the parser's "expect this
# kind" steps — each a direct `k == TokKind.X` tag comparison (`==`/`!=` on a tag-only
# union compares the tag words, type_system §5).
#
# A token also carries (start, len) — the slice locating its text in the source
# buffer, which the parser compares against keywords — and `ival`, a decoded
# integer literal. Tracer-bullet scope: only the kinds `main -> N` needs.

# `IntLit` (not `Int`) — a bare member named `Int` would read as compose-over of
# the numeric type `Int`, which cfcc does not support.
pub union TokKind = {
	Eof,
	Ident,
	IntLit,
	StrLit,
	LParen,
	RParen,
	LBrace,
	RBrace,
	LBracket,
	RBracket,
	Comma,
	Colon,
	Dot,
	Ellipsis,
	Eq,
	Arrow,
	Plus,
	Minus,
	Star,
	Slash,
	Percent,
	Amp,
	Pipe,
	Caret,
	Tilde,
	Bang,
	Shl,
	Shr,
	EqEq,
	Ne,
	Lt,
	Gt,
	Le,
	Ge,
	LogAnd,
	LogOr,
	Yield,
	FloatLit,
	PipeArrow,
	PathSep,
	# A `#…` line comment. Never produced by the ordinary `lex` (the compile path strips
	# comments, so the parser never sees this kind); only `lex_fmt` emits it, for the
	# formatter, which is the one consumer that must preserve comments verbatim.
	Comment,
}

# `text` is a synthesized-identifier override: normally empty, and the token's text is the
# `src[start..start+len]` byte range. A token-rewriting pass (namespace mangling) sets it to a
# name that does not appear literally in the source (e.g. `std_mem_raw_load` from `raw::load`);
# `tok_text!` returns it verbatim when non-empty.
pub data Token = { TokKind kind, Iarch ival, Iarch start, Iarch len, Str text }

# Per-kind predicates — `match` against the one member, since a union has no `==`.
pub const is_eof = (TokKind k): Bool -> k == TokKind.Eof

pub const is_ident = (TokKind k): Bool -> k == TokKind.Ident

pub const is_intlit = (TokKind k): Bool -> k == TokKind.IntLit

pub const is_strlit = (TokKind k): Bool -> k == TokKind.StrLit

pub const is_lparen = (TokKind k): Bool -> k == TokKind.LParen

pub const is_rparen = (TokKind k): Bool -> k == TokKind.RParen

pub const is_lbrace = (TokKind k): Bool -> k == TokKind.LBrace

pub const is_rbrace = (TokKind k): Bool -> k == TokKind.RBrace

pub const is_lbracket = (TokKind k): Bool -> k == TokKind.LBracket

pub const is_rbracket = (TokKind k): Bool -> k == TokKind.RBracket

pub const is_comma = (TokKind k): Bool -> k == TokKind.Comma

pub const is_colon = (TokKind k): Bool -> k == TokKind.Colon

pub const is_pathsep = (TokKind k): Bool -> k == TokKind.PathSep

pub const is_dot = (TokKind k): Bool -> k == TokKind.Dot

pub const is_ellipsis = (TokKind k): Bool -> k == TokKind.Ellipsis

pub const is_eq = (TokKind k): Bool -> k == TokKind.Eq

pub const is_arrow = (TokKind k): Bool -> k == TokKind.Arrow

pub const is_plus = (TokKind k): Bool -> k == TokKind.Plus

pub const is_minus = (TokKind k): Bool -> k == TokKind.Minus

pub const is_star = (TokKind k): Bool -> k == TokKind.Star

pub const is_slash = (TokKind k): Bool -> k == TokKind.Slash

pub const is_percent = (TokKind k): Bool -> k == TokKind.Percent

pub const is_amp = (TokKind k): Bool -> k == TokKind.Amp

pub const is_pipe = (TokKind k): Bool -> k == TokKind.Pipe

pub const is_caret = (TokKind k): Bool -> k == TokKind.Caret

pub const is_tilde = (TokKind k): Bool -> k == TokKind.Tilde

pub const is_bang = (TokKind k): Bool -> k == TokKind.Bang

pub const is_shl = (TokKind k): Bool -> k == TokKind.Shl

pub const is_shr = (TokKind k): Bool -> k == TokKind.Shr

pub const is_eqeq = (TokKind k): Bool -> k == TokKind.EqEq

pub const is_ne = (TokKind k): Bool -> k == TokKind.Ne

pub const is_lt = (TokKind k): Bool -> k == TokKind.Lt

pub const is_gt = (TokKind k): Bool -> k == TokKind.Gt

pub const is_le = (TokKind k): Bool -> k == TokKind.Le

pub const is_ge = (TokKind k): Bool -> k == TokKind.Ge

pub const is_logand = (TokKind k): Bool -> k == TokKind.LogAnd

pub const is_logor = (TokKind k): Bool -> k == TokKind.LogOr

pub const is_yield = (TokKind k): Bool -> k == TokKind.Yield

pub const is_floatlit = (TokKind k): Bool -> k == TokKind.FloatLit

pub const is_pipearrow = (TokKind k): Bool -> k == TokKind.PipeArrow

pub const is_comment = (TokKind k): Bool -> k == TokKind.Comment
