# token — the lexical token type, shared by the lexer and parser.
#
# A token's KIND is a tag-only union, not a magic integer: the compiler enforces
# exhaustiveness at every `match` and keeps the kinds out of the value namespace.
# (cfcc has no `==` on unions and no union-local reassignment, so dispatch is via
# `match`; the `is_*` predicates below are the ergonomic bridge for the parser's
# "expect this kind" steps.)
#
# A token also carries (start, len) — the slice locating its text in the source
# buffer, which the parser compares against keywords — and `ival`, a decoded
# integer literal. Tracer-bullet scope: only the kinds `main -> N` needs.

# `IntLit` (not `Int`) — a bare member named `Int` would read as compose-over of
# the numeric type `Int`, which cfcc does not support.
pub union TokKind = { Eof, Ident, IntLit, LParen, RParen, LBrace, RBrace, LBracket, RBracket, Comma, Colon, Eq, Arrow, Plus, Minus, Star, Slash, Percent, Amp, Pipe, Caret, Tilde, Bang, Shl, Shr, EqEq, Ne, Lt, Gt, Le, Ge, LogAnd, LogOr }

pub data Token = { TokKind kind, Iarch ival, Iarch start, Iarch len }

# Per-kind predicates — `match` against the one member, since a union has no `==`.
pub const is_eof = (TokKind k): Bool -> match k { TokKind.Eof -> true, _ -> false }
pub const is_ident = (TokKind k): Bool -> match k { TokKind.Ident -> true, _ -> false }
pub const is_intlit = (TokKind k): Bool -> match k { TokKind.IntLit -> true, _ -> false }
pub const is_lparen = (TokKind k): Bool -> match k { TokKind.LParen -> true, _ -> false }
pub const is_rparen = (TokKind k): Bool -> match k { TokKind.RParen -> true, _ -> false }
pub const is_lbrace = (TokKind k): Bool -> match k { TokKind.LBrace -> true, _ -> false }
pub const is_rbrace = (TokKind k): Bool -> match k { TokKind.RBrace -> true, _ -> false }
pub const is_lbracket = (TokKind k): Bool -> match k { TokKind.LBracket -> true, _ -> false }
pub const is_rbracket = (TokKind k): Bool -> match k { TokKind.RBracket -> true, _ -> false }
pub const is_comma = (TokKind k): Bool -> match k { TokKind.Comma -> true, _ -> false }
pub const is_colon = (TokKind k): Bool -> match k { TokKind.Colon -> true, _ -> false }
pub const is_eq = (TokKind k): Bool -> match k { TokKind.Eq -> true, _ -> false }
pub const is_arrow = (TokKind k): Bool -> match k { TokKind.Arrow -> true, _ -> false }
pub const is_plus = (TokKind k): Bool -> match k { TokKind.Plus -> true, _ -> false }
pub const is_minus = (TokKind k): Bool -> match k { TokKind.Minus -> true, _ -> false }
pub const is_star = (TokKind k): Bool -> match k { TokKind.Star -> true, _ -> false }
pub const is_slash = (TokKind k): Bool -> match k { TokKind.Slash -> true, _ -> false }
pub const is_percent = (TokKind k): Bool -> match k { TokKind.Percent -> true, _ -> false }
pub const is_amp = (TokKind k): Bool -> match k { TokKind.Amp -> true, _ -> false }
pub const is_pipe = (TokKind k): Bool -> match k { TokKind.Pipe -> true, _ -> false }
pub const is_caret = (TokKind k): Bool -> match k { TokKind.Caret -> true, _ -> false }
pub const is_tilde = (TokKind k): Bool -> match k { TokKind.Tilde -> true, _ -> false }
pub const is_bang = (TokKind k): Bool -> match k { TokKind.Bang -> true, _ -> false }
pub const is_shl = (TokKind k): Bool -> match k { TokKind.Shl -> true, _ -> false }
pub const is_shr = (TokKind k): Bool -> match k { TokKind.Shr -> true, _ -> false }
pub const is_eqeq = (TokKind k): Bool -> match k { TokKind.EqEq -> true, _ -> false }
pub const is_ne = (TokKind k): Bool -> match k { TokKind.Ne -> true, _ -> false }
pub const is_lt = (TokKind k): Bool -> match k { TokKind.Lt -> true, _ -> false }
pub const is_gt = (TokKind k): Bool -> match k { TokKind.Gt -> true, _ -> false }
pub const is_le = (TokKind k): Bool -> match k { TokKind.Le -> true, _ -> false }
pub const is_ge = (TokKind k): Bool -> match k { TokKind.Ge -> true, _ -> false }
pub const is_logand = (TokKind k): Bool -> match k { TokKind.LogAnd -> true, _ -> false }
pub const is_logor = (TokKind k): Bool -> match k { TokKind.LogOr -> true, _ -> false }
