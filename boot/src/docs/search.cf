# docs::search — filter the scanned corpus by the query.
#
# The list/select modes show `ranked!`'s output; the entry uses `has_exact` to decide whether a
# `cf docs <term>` should open READ mode directly on a named definition.
import docscan::{ Def }
import std::data::str::{ fuzzy_score, no_match, eq }

# The filtered, ranked view of `all` for `query`: every definition whose name fuzzy-matches, ordered
# by score descending (a selection sort — the corpus is small). An empty query lists everything.
pub const ranked! = ([Def] all, Str query): [Def] -> {
	if Iarch(query.len) == 0 then return all

	let [Bool] used = []

	for d in all used = [...used, false]

	let [Def] out = []

	# repeatedly pull the highest-scoring not-yet-taken match (selection sort by fuzzy score)
	loop {
		let Iarch best = -1
		let Iarch best_score = no_match

		for (d, i) in all {
			if !used[i] then {
				const Iarch sc = fuzzy_score(query, d.name)

				if sc > no_match && sc > best_score then {
					best_score = sc
					best = i
				}
			}
		}

		if best < 0 then break

		used[best] = true
		out = [...out, all[best]]
	}

	return out
}

# Is `q` the exact name of some definition?
pub const has_exact = ([Def] all, Str q): Bool -> {
	for d in all if eq(d.name, q) then return true

	return false
}
