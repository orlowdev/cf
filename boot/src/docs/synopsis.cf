# docs::synopsis — parse a definition's one-line signature into the pieces the read view lays out.
#
# The read page rebuilds the SYNOPSIS structurally rather than echoing the raw source line: a
# function
# lists each parameter on its own `-> Type name` row and its return as `<- Type`; a data type lists
# each `- Type name` field; a union lists each `- Variant` with its payload types as `-> Type`; a
# value states `value name: Type`. These helpers do the text extraction; docs::page assembles them.
import docscan::{ split_members_line! }
import std::data::str::{ eq }

# `s[a..b)` as a fresh Str (clamped to the string length).
const slice = (Str s, Iarch a, Iarch b): Str -> {
	let [Uint8] out = []
	let Iarch i = a

	loop {
		if i >= b then break
		if i >= Iarch(s.len) then break

		out = [...out, Uint8(Iarch(s[i]))]
		i = i + 1
	}

	return Str({ bytes: out, len: Iarch(out.len) })
}

# Index of the first `(` in `s`, or -1.
const first_lparen = (Str s): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break
		if Iarch(s[i]) == 40 then return i

		i = i + 1
	}

	return -1
}

# Index of the `)` matching the `(` at `open`, or -1.
const match_rparen = (Str s, Iarch open): Iarch -> {
	let Iarch depth = 0
	let Iarch i = open

	loop {
		if i >= Iarch(s.len) then break

		const Iarch c = Iarch(s[i])

		if c == 40 then depth = depth + 1
		if c == 41 then {
			depth = depth - 1

			if depth == 0 then return i
		}

		i = i + 1
	}

	return -1
}

# The parameter list inside a function/intrinsic's first `(...)`, or "" when there is none.
pub const param_text = (Str sig): Str -> {
	const Iarch lp = first_lparen(sig)

	if lp < 0 then return ""

	const Iarch rp = match_rparen(sig, lp)

	if rp < 0 then return ""

	return slice(sig, lp + 1, rp)
}

# The return type — the text after the parameter list's `): ` up to a ` ->` body arrow or the end.
pub const ret_text = (Str sig): Str -> {
	const Iarch lp = first_lparen(sig)

	if lp < 0 then return ""

	const Iarch rp = match_rparen(sig, lp)

	if rp < 0 then return ""

	# skip past `)`, its `:`, and one space
	let Iarch k = rp + 1

	loop {
		if k >= Iarch(sig.len) then break
		if Iarch(sig[k]) != 32 && Iarch(sig[k]) != 58 then break

		k = k + 1
	}

	# end at a ` ->` body arrow or the end of the string
	let Iarch e = k
	let Bool found = false

	loop {
		if e + 2 >= Iarch(sig.len) then break

		if Iarch(sig[e]) == 32 && Iarch(sig[e + 1]) == 45 && Iarch(sig[e + 2]) == 62 then {
			found = true

			break
		}

		e = e + 1
	}

	if !found then e = Iarch(sig.len)

	return slice(sig, k, e)
}

# The written type of a value or param-less intrinsic — the text after a `: ` annotation (a colon
# FOLLOWED BY a space, so a `::` path is never mistaken for one) up to a ` = ` or the end; "" when
# the
# definition carries no annotation.
pub const value_type = (Str sig): Str -> {
	let Iarch c = -1
	let Iarch i = 0

	loop {
		if i + 1 >= Iarch(sig.len) then break

		if Iarch(sig[i]) == 58 && Iarch(sig[i + 1]) == 32 then {
			c = i

			break
		}

		i = i + 1
	}

	if c < 0 then return ""

	const Iarch k = c + 2
	let Iarch e = k
	let Bool found = false

	loop {
		if e + 2 >= Iarch(sig.len) then break

		if Iarch(sig[e]) == 32 && Iarch(sig[e + 1]) == 61 && Iarch(sig[e + 2]) == 32 then {
			found = true

			break
		}

		e = e + 1
	}

	if !found then e = Iarch(sig.len)

	return slice(sig, k, e)
}

# The display keyword for a definition: `data`/`union`/`intrinsic` verbatim, and a `const` shown as
# `function` when it is a lambda (has a parameter list) or `value` otherwise.
pub const head_word = (Str kind, Str sig): Str -> {
	if eq(kind, "data") then return "data"
	if eq(kind, "union") then return "union"
	if eq(kind, "intrinsic") then return "intrinsic"
	if first_lparen(sig) >= 0 then return "function"

	return "value"
}

# Does this definition render with the function layout (a `-> arg` per parameter, then a `<-
# return`)?
# True for a function and for an intrinsic that takes parameters; false for data/union/value.
pub const fn_layout = (Str kind, Str sig): Bool -> {
	if eq(kind, "data") || eq(kind, "union") then return false

	return first_lparen(sig) >= 0
}

# The tag name of a union variant (`TFixed(Iarch, Bool)` → `TFixed`, `TInt` → `TInt`).
pub const mem_name = (Str m): Str -> {
	const Iarch lp = first_lparen(m)

	if lp < 0 then return m

	return slice(m, 0, lp)
}

# The positional payload types of a union variant (`TFixed(Iarch, Bool)` → `["Iarch", "Bool"]`); the
# empty list for a tag-only variant.
pub const mem_payload! = (Str m): [Str] -> {
	const Iarch lp = first_lparen(m)

	if lp < 0 then return []

	const Iarch rp = match_rparen(m, lp)

	if rp < 0 then return []

	return split_members_line!(slice(m, lp + 1, rp))
}
