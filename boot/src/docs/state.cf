# docs::state — the browser's state model, shared by the renderer, the key dispatch, and the loop.
#
# One immutable `DocState` describes the whole browser; a keystroke produces the NEXT state (see
# docs::keys), and the loop re-renders it. Kept in its own leaf module so `render`, `keys`, and the
# `docs` entry can all depend on it without a cycle.
import docscan::{ Def }

# The three browser modes. `Search` filters as you type; `Select` moves an arrow-key highlight over
# the matches; `Read` shows one definition's man-style page. The mode steers both the renderer and the
# key dispatch, and indexes the mode-specific legend.
pub union Mode = { Search, Select, Read }

# The whole browser state, amended in place through a `*DocState` on every keystroke (see docs::keys):
#   `all`    — every definition `docscan` read from the standard library (scanned once, never mutated).
#   `query`  — the current search text.
#   `mode`   — which of the three modes is active.
#   `sel`    — the highlighted row: an index into the FILTERED view, not into `all`.
#   `scroll` — the read view's top line (0 in the list modes).
pub data DocState = { [Def] all, Str query, Mode mode, Iarch sel, Iarch scroll }
