# docs::state — the browser's state model, shared by the renderer, the key dispatch, and the loop.
#
# One immutable `DocState` describes the whole browser; a keystroke produces the NEXT state (see
# docs::keys), and the loop re-renders it. Kept in its own leaf module so `render`, `keys`, and the
# `docs` entry can all depend on it without a cycle.
import docscan::{ Def }

# The three browser modes. `Search` filters as you type; `Select` moves an arrow-key highlight over
# the matches; `Read` shows one definition's man-style page. The mode steers both the renderer and
# the
# key dispatch, and indexes the mode-specific legend.
pub union Mode = { Search, Select, Read }

# The maximum search-query length — the inline `query` buffer's capacity.
pub const query_cap = (): Iarch -> 128

# The whole browser state, amended in place through a `*DocState` on every keystroke (see
# docs::keys):
#   `all`    — every definition `docscan` read from the standard library (scanned once, never
# mutated).
#   `query`  — the current search text, held as an INLINE fixed byte buffer edited in place (never
#              rebuilt): a keystroke writes one byte and bumps `qlen`, so a long session never
#              accumulates a fresh query string per edit. Its live length is `qlen`.
#   `qlen`   — the number of bytes currently used in `query` (0..128).
#   `mode`   — which of the three modes is active.
#   `sel`    — the highlighted row: an index into the FILTERED view, not into `all`.
#   `scroll` — the read view's top line (0 in the list modes).
pub data DocState = { [Def] all, [128 Uint8] query, Iarch qlen, Mode mode, Iarch sel, Iarch scroll }

# The current search text as a Str VIEW over the inline `query` buffer (`bytes` points INTO the
# state's own storage, `len` is `qlen`). Building this view each render/rank costs only a 16-byte
# header — transient residue reclaimed per loop iteration — never a copy of the query bytes.
pub const query_str = (DocState st): Str -> Str({ bytes: st.query, len: st.qlen })

# Write byte `b` at index `at` of the inline query buffer, in place — the search-box edit primitive.
# `buf` is the buffer's inline address (`st.query`); the write mutates the state's own storage.
pub const put_query_byte = (*[Uint8] buf, Iarch at, Iarch b): () -> {
	buf[at] = Uint8(b)
}
