# routing — the SHADOW residue/survivor classification (memory_model §5, geometry_lowering §2-§3).
#
# The MEMORY MODEL separates every allocation at birth: a value that escapes its frame
# (returned, yielded, or rehomed into a caller-owned aggregate) is a SURVIVOR, placed through
# the geometry's survivor hooks; trapped residue is frame-bounded and reclaimable at scope
# exit. The classification itself is geometry-AGNOSTIC — geometries differ only in what
# keeping a survivor costs (a bump node keeps it until node death, gc traces it, rc counts
# it) and in how residue is wiped. The first consumer is the DUPLEX NODE, the bump family's
# two-sided layout: it trusts these bits blindly (a reset frees residue en masse, with no
# per-object tracking), so routing an escaping value residue is a use-after-free THERE — the
# analysis must be a SOUND OVER-APPROXIMATION: when in doubt, a name ESCAPES (the cost of
# over-approximation is a leak until node death, never a dangle). A tracking geometry would
# consume the same bits as a placement hint only.
#
# SHADOW MODE: this pass currently drives nothing. It runs on the LOWERED program (post
# monomorphization / defer-tap hoist / defer lowering / closure lift — the AST emit actually
# consumes, where a capture is an ordinary hidden parameter), computes each function's escape
# set with the FULL arm coverage the older `!`-oracle (alloc.cf) lacks, and cross-checks:
# every name the oracle says escapes must also escape here (`routing_check!`). A divergence is
# a compiler bug reported at compile time, so the whole corpus plus cf itself exercise the new
# analysis on every build long before any codegen trusts it.
#
# PER-FUNCTION SUMMARIES (slice B): a call argument no longer escapes unconditionally. Each
# function gets a summary computed bottom-up over the call graph — per parameter,
#   ret_al(i)  the return value may ALIAS argument i (identity `_ -> e` rewriters, projections
#              of a parameter, transitive returns through callees), and
#   stores(i)  argument i is STORED beyond the callee's own frame (rehomed into another
#              argument's aggregate or into memory the callee's caller can reach).
# At a call site, a `stores` argument escapes wherever the call sits (position-independent
# sweep); a `ret_al` argument escapes exactly when the call's VALUE does (the ordinary
# escaping-position machinery), and makes a binding of the result a forward alias of the
# argument (`const q = f(gg.inner); q.p = v` rehomes `v` through the call). The polarity is
# fixed: an UNRESOLVED callee — indirect (a fn-value name), recursive/SCC (still in progress
# on the DFS stack), asm (opaque body), or plain unknown — is ⊤: every argument escapes.
# Intrinsics get exact rows: a numeric cast and `Str(v[,n])` and `cf__buffer_of` return
# (an alias of) argument 0 and retain nothing; the arena constructors take only sizes. The
# asm floor whitelists exactly `syscall6`/`exit` (the kernel copies or fills during the call
# and retains no user pointer; exit never returns), which frees the whole write→eprint→die
# chain — every other asm body is ⊤.
#
# The per-function fixpoint splits the escape set by WHY a name escapes:
#   rset  return-reachable (returned/yielded, or flows into a returned name) → the summary's
#         ret_al bits — conditional escape at the call site;
#   sset  stored beyond the frame (rehomed into a parameter/forward alias, or a `stores`
#         call argument) → the summary's stores bits — unconditional escape at the call site.
# esc = rset ∪ sset partitions exactly the one set slice A grew, so the oracle cross-check is
# unchanged. A store into a plain rset name stays return-conditional (the stored value rides
# the return); a store through a forward alias goes to sset (the alias may root in caller
# memory).
#
# Beyond the oracle, this pass closes the alias channels red-teamed against the duplex design:
#   - an escaping PROJECTION pins its base (`return o.a` keeps `o` alive — the interior box
#     lives inside the base's construction);
#   - a match/destructure BIND aliases its scrutinee's payload;
#   - a `for` variable aliases the array's element;
#   - a spread copies the SOURCE array's element pointers into the new spine;
#   - `&x` hands the address out;
#   - FORWARD aliases: a name bound FROM a parameter/escaping aggregate (`const q = gg.inner`)
#     becomes a store TARGET — a rehome through it escapes the stored value (now grown inside
#     value blocks too, and through ret-aliasing call results).
# An interpolation hole is NOT an escape: cf_str_append copies the hole's bytes.
#
# `evars` (the escaping-position walker) is deliberately EXHAUSTIVE with no `_` arm: adding an
# Expr variant fails this compile until the new form is audited for escape behavior.

import "ast" as { Expr, Stmt, MatchArm, StmtArm, Seg, FieldInit, Param, UnionDecl, Func, Program }
import "alloc" as { compute_esc! }
import "io" as { die, eprint }

const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

const has_name = ([Str] xs, Str s): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(xs.len) then break
		if str_eq(xs[i], s) then return true
		i = i + 1
	}
	return false
}

const no_strs = (): [Str] -> {
	let [Str] e = []
	return e
}

const no_exprs = (): [Expr] -> {
	let [Expr] e = []
	return e
}

const one_str = (Str s): [Str] -> {
	let [Str] r = [s]
	return r
}

const cat_s = ([Str] a, [Str] b): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		r = [...r, a[i]]
		i = i + 1
	}
	let Iarch j = 0
	loop {
		if j >= Iarch(b.len) then break
		r = [...r, b[j]]
		j = j + 1
	}
	return r
}

const union_names = ([Str] a, [Str] b): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		r = [...r, a[i]]
		i = i + 1
	}
	let Iarch j = 0
	loop {
		if j >= Iarch(b.len) then break
		if !has_name(r, b[j]) then r = [...r, b[j]]
		j = j + 1
	}
	return r
}

const field_values = ([FieldInit] fs): [Expr] -> {
	let [Expr] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		r = [...r, fs[i].value]
		i = i + 1
	}
	return r
}

const plist_names = ([Param] ps): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ps.len) then break
		r = [...r, ps[i].name]
		i = i + 1
	}
	return r
}

# ── per-function summaries ───────────────────────────────────────────────────────────────────

# One callee's summary: per parameter, may the RETURN value alias it (`ret_al`) and is it
# STORED beyond the callee's frame (`stores`). `all_esc` is ⊤ — every argument escapes — used
# for asm bodies, indirect/unknown callees, and DFS back-edges (recursion/SCC). Out-of-range
# bit reads default to TRUE (bit_at), so an arity surprise degrades to escape, never a miss.
pub data FnSum = { Bool all_esc, [Bool] ret_al, [Bool] stores }

# The small per-function callee table the walkers consult: the DISTINCT callee names of one
# body, resolved once against the whole-program tables (so the fixpoint rounds never re-run
# the global name search).
data Sums = { [Str] names, [FnSum] tbl }

const bit_at = ([Bool] bs, Iarch i): Bool -> if i >= Iarch(bs.len) then true else bs[i]

const top_sum = (): FnSum -> {
	let [Bool] ra = []
	let [Bool] sto = []
	return FnSum({ all_esc: true, ret_al: ra, stores: sto })
}

const none_sum = (Iarch n): FnSum -> {
	let [Bool] ra = []
	let [Bool] sto = []
	let Iarch i = 0
	loop {
		if i >= n then break
		ra = [...ra, false]
		sto = [...sto, false]
		i = i + 1
	}
	return FnSum({ all_esc: false, ret_al: ra, stores: sto })
}

# Result may alias argument 0; nothing is retained beyond the call. `Str(v[,n])` BORROWS a
# byte buffer's backing; `cf__buffer_of` wraps its buffer; a numeric cast is an identity on
# the operand word (`Uarch(p)` IS the pointer). Extra arguments read as TRUE via bit_at —
# for `Str(buf, n)` the length word "escaping" is harmless.
const ret0_sum = (): FnSum -> {
	let [Bool] ra = [true]
	let [Bool] sto = [false]
	return FnSum({ all_esc: false, ret_al: ra, stores: sto })
}

# The builtin numeric cast names (typecheck's is_cast_type set).
const is_cast_name = (Str n): Bool -> {
	if str_eq(n, "Iarch") then return true
	if str_eq(n, "Uarch") then return true
	if str_eq(n, "Int") then return true
	if str_eq(n, "Int8") then return true
	if str_eq(n, "Int16") then return true
	if str_eq(n, "Int32") then return true
	if str_eq(n, "Int64") then return true
	if str_eq(n, "Uint8") then return true
	if str_eq(n, "Uint16") then return true
	if str_eq(n, "Uint32") then return true
	if str_eq(n, "Uint64") then return true
	if str_eq(n, "Float32") then return true
	if str_eq(n, "Float64") then return true
	return false
}

const is_routing_intrinsic = (Str n): Bool -> {
	if is_cast_name(n) then return true
	if str_eq(n, "Str") then return true
	if str_eq(n, "cf__buffer_of") then return true
	if str_eq(n, "cf__arena_of") then return true
	if str_eq(n, "cf__arena_grow") then return true
	if str_eq(n, "cf__page") then return true
	return false
}

const intrinsic_sum = (Str n): FnSum -> {
	if is_cast_name(n) || str_eq(n, "Str") || str_eq(n, "cf__buffer_of") then return ret0_sum()
	# cf__arena_of / cf__arena_grow / cf__page — size or no arguments, nothing retained
	return none_sum(1)
}

# The asm floor whitelist: `syscall6` hands pointers to the KERNEL for the duration of the
# call only (read fills, write copies, open reads the path — nothing is retained after
# return), and `exit` never returns. Every other asm body is opaque ⇒ ⊤.
const asm_sum = (Func f): FnSum -> {
	if str_eq(f.name, "syscall6") || str_eq(f.name, "exit") then return none_sum(Iarch(f.params.len))
	return top_sum()
}

const lookup_sum = (Sums sm, Str n): FnSum -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(sm.names.len) then break
		if str_eq(sm.names[i], n) then return sm.tbl[i]
		i = i + 1
	}
	return top_sum()
}

# The arguments whose values may ride OUT through the call's return value.
const ret_args = (Sums sm, Str callee, [Expr] args): [Expr] -> {
	const FnSum s = lookup_sum(sm, callee)
	if s.all_esc then return args
	let [Expr] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(args.len) then break
		if bit_at(s.ret_al, i) then r = [...r, args[i]]
		i = i + 1
	}
	return r
}

# The arguments the callee stores beyond its own frame — escaping wherever the call sits.
const sto_args = (Sums sm, Str callee, [Expr] args): [Expr] -> {
	const FnSum s = lookup_sum(sm, callee)
	if s.all_esc then return args
	let [Expr] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(args.len) then break
		if bit_at(s.stores, i) then r = [...r, args[i]]
		i = i + 1
	}
	return r
}

# ── evars: the names that escape when `e` sits in an ESCAPING position ───────────────────────
# EXHAUSTIVE over Expr, no wildcard — a new variant fails the build until audited.

const evars_list = (Sums sm, [Expr] es): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		r = cat_s(r, evars(sm, es[i]))
		i = i + 1
	}
	return r
}

const evars_marms = (Sums sm, [MatchArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, evars(sm, arms[i].body))
		i = i + 1
	}
	return r
}

const evars = (Sums sm, Expr e): [Str] -> match e {
	Expr.Lit(_) -> no_strs(),
	Expr.BoolLit(_) -> no_strs(),
	Expr.Var(n) -> one_str(n),
	Expr.StrLit(_) -> no_strs(),
	Expr.FloatLit(_) -> no_strs(),
	Expr.Record(_, inits) -> evars_list(sm, field_values(inits)),
	# an escaping projection pins its BASE: the read interior lives inside the base's block
	Expr.Field(b, _) -> one_str(b),
	Expr.FieldExpr(b, _) -> evars(sm, b),
	Expr.UnionMk(_, _, args) -> evars_list(sm, args),
	# the arm value escapes; a payload bind aliases the scrutinee, so the scrutinee escapes too
	Expr.Match(s, arms) -> cat_s(evars(sm, s), evars_marms(sm, arms)),
	# BOTH the spread source (its element pointers are copied into the new spine) and the elements
	Expr.ArrayLit(_, sp, elems, _) -> cat_s(evars(sm, sp), evars_list(sm, elems)),
	Expr.Index(b, _) -> one_str(b),
	Expr.IndexField(b, _, _) -> one_str(b),
	Expr.IndexExpr(b, _) -> evars(sm, b),
	# a hole's bytes are COPIED into the string (cf_str_append) — no aliasing, no escape
	Expr.Interp(_) -> no_strs(),
	Expr.Tuple(elems) -> evars_list(sm, elems),
	Expr.Spread(x) -> evars(sm, x),
	Expr.Unit -> no_strs(),
	Expr.Loop(ss) -> yvars(sm, ss),
	Expr.Buffer(_) -> no_strs(),
	Expr.Addr(n) -> one_str(n),
	Expr.Neg(_) -> no_strs(),
	Expr.Not(_) -> no_strs(),
	Expr.BitNot(_) -> no_strs(),
	Expr.Add(_, _) -> no_strs(),
	Expr.Sub(_, _) -> no_strs(),
	Expr.Mul(_, _) -> no_strs(),
	Expr.Div(_, _) -> no_strs(),
	Expr.Mod(_, _) -> no_strs(),
	Expr.BitAnd(_, _) -> no_strs(),
	Expr.BitOr(_, _) -> no_strs(),
	Expr.BitXor(_, _) -> no_strs(),
	Expr.Shl(_, _) -> no_strs(),
	Expr.Shr(_, _) -> no_strs(),
	Expr.CmpEq(_, _) -> no_strs(),
	Expr.CmpNe(_, _) -> no_strs(),
	Expr.CmpLt(_, _) -> no_strs(),
	Expr.CmpGt(_, _) -> no_strs(),
	Expr.CmpLe(_, _) -> no_strs(),
	Expr.CmpGe(_, _) -> no_strs(),
	Expr.And(_, _) -> no_strs(),
	Expr.Or(_, _) -> no_strs(),
	Expr.If(_, t, el) -> cat_s(evars(sm, t), evars(sm, el)),
	# only the arguments the callee's summary says may ride out through the RETURN value —
	# a `stores` argument escapes via the position-independent sweep instead
	Expr.Call(n, _, args, _) -> evars_list(sm, ret_args(sm, n, args)),
	# lowered away by hoist_defertap; maximally conservative if ever seen
	Expr.DeferTap(_, args) -> evars_list(sm, args)
}

# `<- v` yields of a value block, recursing into nested if/block/match (NOT a nested loop —
# it opens its own value context), mirroring alloc.cf's yield_vars.
const yvars_stmt = (Sums sm, Stmt s): [Str] -> match s {
	Stmt.Yield(e) -> evars(sm, e),
	Stmt.IfThen(_, b) -> yvars_stmt(sm, b),
	Stmt.IfElse(_, t, el) -> cat_s(yvars_stmt(sm, t), yvars_stmt(sm, el)),
	Stmt.Block(ss) -> yvars(sm, ss),
	Stmt.Match(_, arms) -> yvars_sarms(sm, arms),
	_ -> no_strs()
}

const yvars_sarms = (Sums sm, [StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, yvars(sm, arms[i].body))
		i = i + 1
	}
	return r
}

const yvars = (Sums sm, [Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, yvars_stmt(sm, ss[i]))
		i = i + 1
	}
	return r
}

# ── generic descent helpers ──────────────────────────────────────────────────────────────────

# The immediate expression children (generic recursion for the sweeps / value-block walk).
const kids! = (Expr e): [Expr] -> match e {
	Expr.Record(_, inits) -> field_values(inits),
	Expr.ArrayLit(_, sp, elems, _) -> spread_kids(sp, elems),
	Expr.Tuple(elems) -> elems,
	Expr.UnionMk(_, _, args) -> args,
	Expr.Interp(segs) -> hole_exprs(segs),
	Expr.Buffer(sz) -> one_expr(sz),
	Expr.Match(s, arms) -> marm_exprs(s, arms),
	Expr.If(c, t, el) -> three_exprs!(c, t, el),
	Expr.Call(_, _, args, _) -> args,
	Expr.DeferTap(_, args) -> args,
	Expr.Field(_, _) -> no_exprs(),
	Expr.FieldExpr(b, _) -> one_expr(b),
	Expr.Index(_, i) -> one_expr(i),
	Expr.IndexField(_, i, _) -> one_expr(i),
	Expr.IndexExpr(b, i) -> two_exprs!(b, i),
	Expr.Spread(x) -> one_expr(x),
	Expr.Neg(x) -> one_expr(x),
	Expr.Not(x) -> one_expr(x),
	Expr.BitNot(x) -> one_expr(x),
	Expr.Add(a, b) -> two_exprs!(a, b),
	Expr.Sub(a, b) -> two_exprs!(a, b),
	Expr.Mul(a, b) -> two_exprs!(a, b),
	Expr.Div(a, b) -> two_exprs!(a, b),
	Expr.Mod(a, b) -> two_exprs!(a, b),
	Expr.BitAnd(a, b) -> two_exprs!(a, b),
	Expr.BitOr(a, b) -> two_exprs!(a, b),
	Expr.BitXor(a, b) -> two_exprs!(a, b),
	Expr.Shl(a, b) -> two_exprs!(a, b),
	Expr.Shr(a, b) -> two_exprs!(a, b),
	Expr.CmpEq(a, b) -> two_exprs!(a, b),
	Expr.CmpNe(a, b) -> two_exprs!(a, b),
	Expr.CmpLt(a, b) -> two_exprs!(a, b),
	Expr.CmpGt(a, b) -> two_exprs!(a, b),
	Expr.CmpLe(a, b) -> two_exprs!(a, b),
	Expr.CmpGe(a, b) -> two_exprs!(a, b),
	Expr.And(a, b) -> two_exprs!(a, b),
	Expr.Or(a, b) -> two_exprs!(a, b),
	_ -> no_exprs()
}

const one_expr = (Expr a): [Expr] -> {
	let [Expr] r = [a]
	return r
}

const spread_kids = (Expr sp, [Expr] elems): [Expr] -> {
	let [Expr] r = [sp]
	let Iarch i = 0
	loop {
		if i >= Iarch(elems.len) then break
		r = [...r, elems[i]]
		i = i + 1
	}
	return r
}

const two_exprs! = (Expr a, Expr b): [Expr] -> {
	let [Expr] r = [a]
	return [...r, b]
}

const three_exprs! = (Expr a, Expr b, Expr c): [Expr] -> {
	let [Expr] r = [a]
	r = [...r, b]
	return [...r, c]
}

const hole_exprs = ([Seg] segs): [Expr] -> {
	let [Expr] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(segs.len) then break
		if segs[i].is_hole then r = [...r, segs[i].expr]
		i = i + 1
	}
	return r
}

const marm_exprs = (Expr s, [MatchArm] arms): [Expr] -> {
	let [Expr] r = [s]
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = [...r, arms[i].body]
		i = i + 1
	}
	return r
}

# The expressions a statement holds directly.
const stmt_exprs! = (Stmt s): [Expr] -> match s {
	Stmt.Return(e) -> one_expr(e),
	Stmt.Yield(e) -> one_expr(e),
	Stmt.Let(_, _, _, init) -> one_expr(init),
	Stmt.Assign(_, val) -> one_expr(val),
	Stmt.FieldAssign(_, _, val) -> one_expr(val),
	Stmt.DeepFieldAssign(be, _, val) -> two_exprs!(be, val),
	Stmt.IndexAssign(_, idx, val) -> two_exprs!(idx, val),
	Stmt.Do(e) -> one_expr(e),
	Stmt.IfThen(c, _) -> one_expr(c),
	Stmt.IfElse(c, _, _) -> one_expr(c),
	Stmt.Match(sc, _) -> one_expr(sc),
	Stmt.Destructure(_, _, e) -> one_expr(e),
	_ -> no_exprs()
}

# ── the store sweep ──────────────────────────────────────────────────────────────────────────
# Arguments the callee STORES beyond its own frame escape wherever the call sits — position-
# independent, so collected once per function, outside the fixpoint. A DeferTap (never present
# post-lift) stays maximally conservative.

const sweep_expr! = (Sums sm, Expr e): [Str] -> {
	let [Str] r = match e {
		Expr.Call(n, _, args, _) -> evars_list(sm, sto_args(sm, n, args)),
		Expr.DeferTap(_, args) -> evars_list(sm, args),
		Expr.Loop(ss) -> sweep_body!(sm, ss),
		_ -> no_strs()
	}
	const [Expr] ks = kids!(e)
	let Iarch i = 0
	loop {
		if i >= Iarch(ks.len) then break
		r = cat_s(r, sweep_expr!(sm, ks[i]))
		i = i + 1
	}
	return r
}

const sweep_stmt! = (Sums sm, Stmt s): [Str] -> {
	let [Str] r = []
	const [Expr] es = stmt_exprs!(s)
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		r = cat_s(r, sweep_expr!(sm, es[i]))
		i = i + 1
	}
	r = match s {
		Stmt.IfThen(_, b) -> cat_s(r, sweep_stmt!(sm, b)),
		Stmt.IfElse(_, t, el) -> cat_s(r, cat_s(sweep_stmt!(sm, t), sweep_stmt!(sm, el))),
		Stmt.Block(ss) -> cat_s(r, sweep_body!(sm, ss)),
		Stmt.Loop(ss) -> cat_s(r, sweep_body!(sm, ss)),
		Stmt.ForIn(_, _, ss) -> cat_s(r, sweep_body!(sm, ss)),
		Stmt.Match(_, arms) -> cat_s(r, sweep_sarms!(sm, arms)),
		Stmt.Defer(ss) -> cat_s(r, sweep_body!(sm, ss)),
		Stmt.Closure(_, _, _, cb) -> cat_s(r, sweep_body!(sm, cb)),
		_ -> r
	}
	return r
}

const sweep_sarms! = (Sums sm, [StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, sweep_body!(sm, arms[i].body))
		i = i + 1
	}
	return r
}

const sweep_body! = (Sums sm, [Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, sweep_stmt!(sm, ss[i]))
		i = i + 1
	}
	return r
}

# ── the callee-name walk (for the bottom-up DFS + the per-function table) ────────────────────

const calls_expr! = (Expr e): [Str] -> {
	let [Str] r = match e {
		Expr.Call(n, _, _, _) -> one_str(n),
		Expr.Loop(ss) -> calls_body!(ss),
		_ -> no_strs()
	}
	const [Expr] ks = kids!(e)
	let Iarch i = 0
	loop {
		if i >= Iarch(ks.len) then break
		r = cat_s(r, calls_expr!(ks[i]))
		i = i + 1
	}
	return r
}

const calls_stmt! = (Stmt s): [Str] -> {
	let [Str] r = []
	const [Expr] es = stmt_exprs!(s)
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		r = cat_s(r, calls_expr!(es[i]))
		i = i + 1
	}
	r = match s {
		Stmt.IfThen(_, b) -> cat_s(r, calls_stmt!(b)),
		Stmt.IfElse(_, t, el) -> cat_s(r, cat_s(calls_stmt!(t), calls_stmt!(el))),
		Stmt.Block(ss) -> cat_s(r, calls_body!(ss)),
		Stmt.Loop(ss) -> cat_s(r, calls_body!(ss)),
		Stmt.ForIn(_, _, ss) -> cat_s(r, calls_body!(ss)),
		Stmt.Match(_, arms) -> cat_s(r, calls_sarms!(arms)),
		Stmt.Defer(ss) -> cat_s(r, calls_body!(ss)),
		Stmt.Closure(_, _, _, cb) -> cat_s(r, calls_body!(cb)),
		_ -> r
	}
	return r
}

const calls_sarms! = ([StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, calls_body!(arms[i].body))
		i = i + 1
	}
	return r
}

const calls_body! = ([Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, calls_stmt!(ss[i]))
		i = i + 1
	}
	return r
}

# ── forward aliases ──────────────────────────────────────────────────────────────────────────
# The root names a binding READS from: binding a projection/alias of a store target makes the
# new name a store target too (`const q = gg.inner; q.p = v` rehomes `v` through `q`). A call
# result aliases the arguments the callee's summary says the return may alias.

const aroots = (Sums sm, Expr e): [Str] -> match e {
	Expr.Var(n) -> one_str(n),
	Expr.Field(b, _) -> one_str(b),
	Expr.FieldExpr(b, _) -> aroots(sm, b),
	Expr.Index(b, _) -> one_str(b),
	Expr.IndexField(b, _, _) -> one_str(b),
	Expr.IndexExpr(b, _) -> aroots(sm, b),
	Expr.Spread(x) -> aroots(sm, x),
	Expr.If(_, t, el) -> cat_s(aroots(sm, t), aroots(sm, el)),
	Expr.Match(_, arms) -> aroots_marms(sm, arms),
	Expr.Loop(ss) -> yvars(sm, ss),
	Expr.Call(n, _, args, _) -> aroots_list(sm, ret_args(sm, n, args)),
	_ -> no_strs()
}

const aroots_list = (Sums sm, [Expr] es): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		r = cat_s(r, aroots(sm, es[i]))
		i = i + 1
	}
	return r
}

const aroots_marms = (Sums sm, [MatchArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, aroots(sm, arms[i].body))
		i = i + 1
	}
	return r
}

# ── the per-function fixpoint ────────────────────────────────────────────────────────────────

# The three grown sets: `rset` — names whose values may ride out through the RETURN value;
# `sset` — names whose values are STORED beyond the frame; `fwd` — forward aliases of store
# targets. esc = rset ∪ sset. A store target is a parameter, a stored-beyond name, or a
# forward alias; a store into a plain rset name keeps the stored value return-conditional.
pub data RSets = { [Str] rset, [Str] sset, [Str] fwd }

data RCtx = { Sums sm, [Str] params, [Str] rset, [Str] sset, [Str] fwd }

const is_target = (RCtx cx, Str n): Bool -> has_name(cx.params, n) || has_name(cx.rset, n) || has_name(cx.sset, n) || has_name(cx.fwd, n)

const s_target = (RCtx cx, Str n): Bool -> has_name(cx.params, n) || has_name(cx.sset, n) || has_name(cx.fwd, n)

const any_target = (RCtx cx, [Str] ns): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(ns.len) then break
		if is_target(cx, ns[i]) then return true
		i = i + 1
	}
	return false
}

const any_in = ([Str] set, [Str] ns): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(ns.len) then break
		if has_name(set, ns[i]) then return true
		i = i + 1
	}
	return false
}

const deep_root = (Expr e): Str -> match e {
	Expr.Var(n) -> n,
	Expr.Field(b, _) -> b,
	Expr.FieldExpr(b, _) -> deep_root(b),
	Expr.Index(b, _) -> b,
	Expr.IndexField(b, _, _) -> b,
	Expr.IndexExpr(b, _) -> deep_root(b),
	_ -> ""
}

const sarm_binds = ([StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, arms[i].binds)
		i = i + 1
	}
	return r
}

# Return-reachable roots of one statement (position-sensitive).
const rroots_stmt! = (RCtx cx, Stmt s): [Str] -> match s {
	Stmt.Return(e) -> evars(cx.sm, e),
	Stmt.Yield(e) -> evars(cx.sm, e),
	Stmt.Assign(n, val) -> if has_name(cx.rset, n) then evars(cx.sm, val) else no_strs(),
	Stmt.FieldAssign(b, _, val) -> if has_name(cx.rset, b) then evars(cx.sm, val) else no_strs(),
	Stmt.IndexAssign(b, _, val) -> if has_name(cx.rset, b) then evars(cx.sm, val) else no_strs(),
	Stmt.DeepFieldAssign(be, _, val) -> if has_name(cx.rset, deep_root(be)) then evars(cx.sm, val) else no_strs(),
	Stmt.Let(n, _, _, init) -> if has_name(cx.rset, n) then evars(cx.sm, init) else no_strs(),
	# a bind escaping pins the destructured source
	Stmt.Destructure(binds, _, e) -> if any_in(cx.rset, binds) then evars(cx.sm, e) else no_strs(),
	# the loop variable escaping pins the array (the element lives in the array's block)
	Stmt.ForIn(v, arr, ss) -> if has_name(cx.rset, v) then cat_s(one_str(arr), rroots_body!(cx, ss)) else rroots_body!(cx, ss),
	# a payload bind escaping pins the scrutinee
	Stmt.Match(sc, arms) -> if any_in(cx.rset, sarm_binds(arms)) then cat_s(evars(cx.sm, sc), rroots_sarms!(cx, arms)) else rroots_sarms!(cx, arms),
	Stmt.IfThen(_, b) -> rroots_stmt!(cx, b),
	Stmt.IfElse(_, t, el) -> cat_s(rroots_stmt!(cx, t), rroots_stmt!(cx, el)),
	Stmt.Block(ss) -> rroots_body!(cx, ss),
	Stmt.Loop(ss) -> rroots_body!(cx, ss),
	Stmt.Defer(ss) -> rroots_body!(cx, ss),
	Stmt.Closure(_, _, _, cb) -> rroots_body!(cx, cb),
	Stmt.Do(_) -> no_strs(),
	Stmt.Break -> no_strs(),
	Stmt.Continue -> no_strs()
}

const rroots_sarms! = (RCtx cx, [StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, rroots_body!(cx, arms[i].body))
		i = i + 1
	}
	return r
}

const rvb_expr! = (RCtx cx, Expr e): [Str] -> {
	let [Str] r = match e {
		Expr.Loop(ss) -> rroots_body!(cx, ss),
		_ -> no_strs()
	}
	const [Expr] ks = kids!(e)
	let Iarch i = 0
	loop {
		if i >= Iarch(ks.len) then break
		r = cat_s(r, rvb_expr!(cx, ks[i]))
		i = i + 1
	}
	return r
}

const rroots_body! = (RCtx cx, [Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, rroots_stmt!(cx, ss[i]))
		const [Expr] es = stmt_exprs!(ss[i])
		let Iarch j = 0
		loop {
			if j >= Iarch(es.len) then break
			r = cat_s(r, rvb_expr!(cx, es[j]))
			j = j + 1
		}
		i = i + 1
	}
	return r
}

# Stored-beyond-the-frame roots of one statement (position-sensitive).
const sroots_stmt! = (RCtx cx, Stmt s): [Str] -> match s {
	Stmt.Return(_) -> no_strs(),
	Stmt.Yield(_) -> no_strs(),
	Stmt.Assign(n, val) -> if s_target(cx, n) then evars(cx.sm, val) else no_strs(),
	Stmt.FieldAssign(b, _, val) -> if s_target(cx, b) then evars(cx.sm, val) else no_strs(),
	Stmt.IndexAssign(b, _, val) -> if s_target(cx, b) then evars(cx.sm, val) else no_strs(),
	Stmt.DeepFieldAssign(be, _, val) -> if s_target(cx, deep_root(be)) then evars(cx.sm, val) else no_strs(),
	Stmt.Let(n, _, _, init) -> if has_name(cx.sset, n) then evars(cx.sm, init) else no_strs(),
	Stmt.Destructure(binds, _, e) -> if any_in(cx.sset, binds) then evars(cx.sm, e) else no_strs(),
	Stmt.ForIn(v, arr, ss) -> if has_name(cx.sset, v) then cat_s(one_str(arr), sroots_body!(cx, ss)) else sroots_body!(cx, ss),
	Stmt.Match(sc, arms) -> if any_in(cx.sset, sarm_binds(arms)) then cat_s(evars(cx.sm, sc), sroots_sarms!(cx, arms)) else sroots_sarms!(cx, arms),
	Stmt.IfThen(_, b) -> sroots_stmt!(cx, b),
	Stmt.IfElse(_, t, el) -> cat_s(sroots_stmt!(cx, t), sroots_stmt!(cx, el)),
	Stmt.Block(ss) -> sroots_body!(cx, ss),
	Stmt.Loop(ss) -> sroots_body!(cx, ss),
	Stmt.Defer(ss) -> sroots_body!(cx, ss),
	Stmt.Closure(_, _, _, cb) -> sroots_body!(cx, cb),
	Stmt.Do(_) -> no_strs(),
	Stmt.Break -> no_strs(),
	Stmt.Continue -> no_strs()
}

const sroots_sarms! = (RCtx cx, [StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, sroots_body!(cx, arms[i].body))
		i = i + 1
	}
	return r
}

const svb_expr! = (RCtx cx, Expr e): [Str] -> {
	let [Str] r = match e {
		Expr.Loop(ss) -> sroots_body!(cx, ss),
		_ -> no_strs()
	}
	const [Expr] ks = kids!(e)
	let Iarch i = 0
	loop {
		if i >= Iarch(ks.len) then break
		r = cat_s(r, svb_expr!(cx, ks[i]))
		i = i + 1
	}
	return r
}

const sroots_body! = (RCtx cx, [Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, sroots_stmt!(cx, ss[i]))
		const [Expr] es = stmt_exprs!(ss[i])
		let Iarch j = 0
		loop {
			if j >= Iarch(es.len) then break
			r = cat_s(r, svb_expr!(cx, es[j]))
			j = j + 1
		}
		i = i + 1
	}
	return r
}

# Forward-alias growth of one statement: names bound from a target join the target set.
const fwd_stmt! = (RCtx cx, Stmt s): [Str] -> match s {
	Stmt.Let(n, _, _, init) -> if any_target(cx, aroots(cx.sm, init)) then one_str(n) else no_strs(),
	Stmt.Destructure(binds, _, e) -> if any_target(cx, aroots(cx.sm, e)) then binds else no_strs(),
	Stmt.ForIn(v, arr, ss) -> if is_target(cx, arr) then cat_s(one_str(v), fwd_body!(cx, ss)) else fwd_body!(cx, ss),
	Stmt.Match(sc, arms) -> if any_target(cx, aroots(cx.sm, sc)) then cat_s(sarm_binds(arms), fwd_sarms!(cx, arms)) else fwd_sarms!(cx, arms),
	Stmt.IfThen(_, b) -> fwd_stmt!(cx, b),
	Stmt.IfElse(_, t, el) -> cat_s(fwd_stmt!(cx, t), fwd_stmt!(cx, el)),
	Stmt.Block(ss) -> fwd_body!(cx, ss),
	Stmt.Loop(ss) -> fwd_body!(cx, ss),
	Stmt.Defer(ss) -> fwd_body!(cx, ss),
	Stmt.Closure(_, _, _, cb) -> fwd_body!(cx, cb),
	_ -> no_strs()
}

const fwd_sarms! = (RCtx cx, [StmtArm] arms): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		r = cat_s(r, fwd_body!(cx, arms[i].body))
		i = i + 1
	}
	return r
}

const fvb_expr! = (RCtx cx, Expr e): [Str] -> {
	let [Str] r = match e {
		Expr.Loop(ss) -> fwd_body!(cx, ss),
		_ -> no_strs()
	}
	const [Expr] ks = kids!(e)
	let Iarch i = 0
	loop {
		if i >= Iarch(ks.len) then break
		r = cat_s(r, fvb_expr!(cx, ks[i]))
		i = i + 1
	}
	return r
}

const fwd_body! = (RCtx cx, [Stmt] ss): [Str] -> {
	let [Str] r = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		r = cat_s(r, fwd_stmt!(cx, ss[i]))
		const [Expr] es = stmt_exprs!(ss[i])
		let Iarch j = 0
		loop {
			if j >= Iarch(es.len) then break
			r = cat_s(r, fvb_expr!(cx, es[j]))
			j = j + 1
		}
		i = i + 1
	}
	return r
}

# Compute a function's shadow sets to a joint fixpoint. The store sweep is position-
# independent, so it seeds `sset` once; the root and alias passes iterate.
const shadow_sets! = (Sums sm, [Str] params, [Stmt] body): RSets -> {
	let [Str] sset = sweep_body!(sm, body)
	let [Str] rset = []
	let [Str] fwd = []
	loop {
		const RCtx cx = RCtx({ sm: sm, params: params, rset: rset, sset: sset, fwd: fwd })
		const [Str] radd = rroots_body!(cx, body)
		const [Str] sadd = sroots_body!(cx, body)
		const [Str] fadd = fwd_body!(cx, body)
		const [Str] r2 = union_names(rset, radd)
		const [Str] s2 = union_names(sset, sadd)
		const [Str] f2 = union_names(fwd, fadd)
		if Iarch(r2.len) == Iarch(rset.len) && Iarch(s2.len) == Iarch(sset.len) && Iarch(f2.len) == Iarch(fwd.len) then break
		rset = r2
		sset = s2
		fwd = f2
	}
	return RSets({ rset: rset, sset: sset, fwd: fwd })
}

# ── the bottom-up summary computation ────────────────────────────────────────────────────────

const find_fn = ([Func] funcs, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(funcs.len) then break
		if str_eq(funcs[i].name, name) then return i
		i = i + 1
	}
	return -1
}

# Resolve one body's distinct callee names into the small table the walkers consult. An
# in-progress callee (state 1 — a recursion/SCC back-edge) resolves to ⊤ exactly like an
# unknown one: the memo's "SCC ⇒ all-args-escape", applied at the call site. The state
# tables ride in as `*[T]` references (read here, written by the DFS).
const local_sums = (Program prog, *[FnSum] sums, *[Iarch] st, [Str] cns): Sums -> {
	let [Str] ln = []
	let [FnSum] lt = []
	let Iarch i = 0
	loop {
		if i >= Iarch(cns.len) then break
		if !has_name(ln, cns[i]) then {
			const Iarch j = find_fn(prog.funcs, cns[i])
			let FnSum s = top_sum()
			if j >= 0 then {
				if st[j] == 2 then s = sums[j]
			} else if is_routing_intrinsic(cns[i]) then {
				s = intrinsic_sum(cns[i])
			}
			ln = [...ln, cns[i]]
			lt = [...lt, s]
		}
		i = i + 1
	}
	return Sums({ names: ln, tbl: lt })
}

const mk_summary = ([Str] params, RSets rs): FnSum -> {
	let [Bool] ra = []
	let [Bool] sto = []
	let Iarch i = 0
	loop {
		if i >= Iarch(params.len) then break
		ra = [...ra, has_name(rs.rset, params[i])]
		sto = [...sto, has_name(rs.sset, params[i])]
		i = i + 1
	}
	return FnSum({ all_esc: false, ret_al: ra, stores: sto })
}

const empty_rsets = (): RSets -> {
	let [Str] r = []
	let [Str] s = []
	let [Str] f = []
	return RSets({ rset: r, sset: s, fwd: f })
}

# Post-order DFS over the call graph: summarize every reachable callee first, then analyze
# this body against the resolved table and record its summary + shadow sets. `st` is the
# visit state (0 unvisited, 1 in progress, 2 done); the tables are the caller's preallocated
# arrays, written in place through the `*[T]` references (they are never grown after the
# handoff, so the decayed data pointers stay valid). A callee still on the DFS stack at
# analysis time reads as ⊤ (local_sums), the memo's "SCC ⇒ all-args-escape".
const summarize! = (Program prog, *[FnSum] sums, *[Iarch] st, *[RSets] rsets, Iarch k): Iarch -> {
	if st[k] != 0 then return 0
	st[k] = 1
	if prog.funcs[k].is_asm || prog.funcs[k].is_value then {
		if prog.funcs[k].is_asm then sums[k] = asm_sum(prog.funcs[k]) else sums[k] = none_sum(0)
		st[k] = 2
		return 0
	}
	const [Str] cns = calls_body!(prog.funcs[k].body)
	let Iarch i = 0
	loop {
		if i >= Iarch(cns.len) then break
		const Iarch j = find_fn(prog.funcs, cns[i])
		if j >= 0 then {
			if st[j] == 0 then summarize!(prog, sums, st, rsets, j)
		}
		i = i + 1
	}
	const Sums sm = local_sums(prog, sums, st, cns)
	const [Str] params = plist_names(prog.funcs[k].params)
	const RSets rs = shadow_sets!(sm, params, prog.funcs[k].body)
	sums[k] = mk_summary(params, rs)
	rsets[k] = rs
	st[k] = 2
	return 0
}

# ── entry points ─────────────────────────────────────────────────────────────────────────────

# The divergence tripwire, run on every compile: every name the `!`-oracle (alloc.cf) says
# escapes must also escape per the shadow pass — the shadow set is the sound superset the
# duplex router will trust, so an oracle-escaping name missing here is a compiler bug. The
# oracle never taints a call argument (its esc_vars skips calls), so the summary refinement
# cannot fall below it: every other oracle rule maps into an rset or sset arm.
pub const routing_check! = (Program prog, RouteInfo ri): Iarch -> routing_run!(prog, ri, false)

# Everything the duplex router consults, aligned with prog.funcs: `sets` — each function's
# shadow escape sets (a name outside rset ∪ sset provably never escapes its frame, so emit
# births its construction RESIDUE-side; everything else stays survivor — fail-safe); `sums` —
# each function's summary rows (a construction passed to an argument the callee neither
# stores beyond its frame nor aliases into its return is dead once the call returns, so emit
# births it residue-side too). The always-on oracle tripwire (routing_check!) keeps the same
# analysis honest on every build.
pub data RouteInfo = { [RSets] sets, [FnSum] sums }

pub const routing_tables! = (Program prog): RouteInfo -> {
	const Iarch n = Iarch(prog.funcs.len)
	let [FnSum] sums = []
	let [Iarch] st = []
	let [RSets] rsets = []
	let Iarch p = 0
	loop {
		if p >= n then break
		sums = [...sums, top_sum()]
		st = [...st, 0]
		rsets = [...rsets, empty_rsets()]
		p = p + 1
	}
	let Iarch d = 0
	loop {
		if d >= n then break
		summarize!(prog, sums, st, rsets, d)
		d = d + 1
	}
	return RouteInfo({ sets: rsets, sums: sums })
}

# Inspection hatch (`--dump-routing`, KEPT deliberately now that the router is live — the
# classification drives codegen, so seeing it is a debugging primitive, not scaffolding):
# each function's shadow escape set, forward aliases, and summary bits (`ret:`
# return-may-alias, `sto:` stored-beyond-frame, per parameter).
pub const routing_dump! = (Program prog, RouteInfo ri): Iarch -> routing_run!(prog, ri, true)

# The shared driver: the per-function check or dump over the RECORDED tables (computed ONCE
# per compile by routing_tables! and shared with emit — the analysis used to run twice, and
# the second run's fixpoint garbage lived through the whole emit phase). An SCC member's sets
# were computed with its siblings at ⊤ — deliberately conservative (the memo's SCC rule).
const routing_run! = (Program prog, RouteInfo ri, Bool dump): Iarch -> {
	const Iarch n = Iarch(prog.funcs.len)
	const [RSets] rsets = ri.sets
	const [FnSum] sums = ri.sums
	let Iarch i = 0
	loop {
		if i >= n then break
		if !prog.funcs[i].is_asm && !prog.funcs[i].is_value then {
			const RSets rs = rsets[i]
			const [Str] esc = union_names(rs.rset, rs.sset)
			const [Str] params = plist_names(prog.funcs[i].params)
			if dump then {
				const FnSum fsum = sums[i]
				eprint("routing ${prog.funcs[i].name}:")
				let Iarch j = 0
				loop {
					if j >= Iarch(esc.len) then break
					eprint(" ${esc[j]}")
					j = j + 1
				}
				let Iarch k = 0
				loop {
					if k >= Iarch(rs.fwd.len) then break
					eprint(" fwd:${rs.fwd[k]}")
					k = k + 1
				}
				let Iarch m = 0
				loop {
					if m >= Iarch(params.len) then break
					if bit_at(fsum.ret_al, m) then eprint(" ret:${params[m]}")
					if bit_at(fsum.stores, m) then eprint(" sto:${params[m]}")
					m = m + 1
				}
				eprint("\n")
			} else {
				const [Str] oracle = compute_esc!(params, prog.funcs[i].body)
				let Iarch j = 0
				loop {
					if j >= Iarch(oracle.len) then break
					if !has_name(esc, oracle[j]) then die("cf: routing: internal divergence in `${prog.funcs[i].name}`: `${oracle[j]}` escapes per the oracle but not per the shadow pass\n")
					j = j + 1
				}
			}
		}
		i = i + 1
	}
	return 0
}
