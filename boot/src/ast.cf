# ast — the expression abstract syntax tree.
#
# An AST is a union of node types (type_system §8 — the spec's canonical use of
# unions), walked by `match`. Recursive `Expr` payloads auto-box to arena
# pointers, so the parser builds a tree by returning and combining `Expr` values
# directly and the emitter walks it with `match`.
#
# It grows a node per language construct as the front end fills in. `Var` names a
# local binding (interned from the source); `Lit` is an integer literal.
pub union Expr = { Lit(Iarch), Var(Str), Neg(Expr), Add(Expr, Expr), Sub(Expr, Expr), Mul(Expr, Expr), Div(Expr, Expr), Mod(Expr, Expr), BitAnd(Expr, Expr), BitOr(Expr, Expr), BitXor(Expr, Expr), Shl(Expr, Expr), Shr(Expr, Expr), CmpEq(Expr, Expr), CmpNe(Expr, Expr), CmpLt(Expr, Expr), CmpGt(Expr, Expr), CmpLe(Expr, Expr), CmpGe(Expr, Expr), And(Expr, Expr), Or(Expr, Expr), If(Expr, Expr, Expr), Call(Call) }

# A function call `callee(args)`. A `[T]` cannot be a union payload directly, so the
# argument list rides in this record and the `Expr.Call` payload is the record.
pub data Call = { Str callee, [Expr] args }

# A statement in a block body. `Let(name, mutable, init)` binds a local (`mutable`
# distinguishes `let` from `const`); `Assign(name, value)` reassigns a `let`;
# `Return(value)` yields the function's result.
pub union Stmt = { Let(Str, Bool, Expr), Assign(Str, Expr), Return(Expr) }

# A function parameter. `is_ptr` records the ABI kind that survives to codegen: an
# `Iarch` word (argc, an integer usable in expressions) vs. an opaque pointer
# (`*[Str]` argv/envp — declared but carrying no integer value). The full type is
# not otherwise tracked yet (the typecheck brick); only this word/pointer split,
# which is all the emitter needs to pick `w`/`l` and to reject a pointer used as a
# value.
pub data Param = { Str name, Bool is_ptr }

# A whole parsed function: its name, whether it was declared `pub`, its parameter
# list, and its block body. A program is a list of these; one must be `pub const
# main`. Non-main functions are called by name (resolved whole-program, so forward
# references and recursion work).
pub data Func = { Str name, Bool is_pub, [Param] params, [Stmt] body }
