# ast — the expression abstract syntax tree.
#
# An AST is a union of node types (type_system §8 — the spec's canonical use of
# unions), walked by `match`. Recursive `Expr` payloads auto-box to arena
# pointers, so the parser builds a tree by returning and combining `Expr` values
# directly and the emitter walks it with `match`.
#
# Tracer-bullet scope: integer arithmetic (literals, unary negation, the binary
# operators). It grows a node per language construct as the front end fills in.

pub union Expr = { Lit(Iarch), Neg(Expr), Add(Expr, Expr), Sub(Expr, Expr), Mul(Expr, Expr), Div(Expr, Expr), Mod(Expr, Expr) }
