# parser — token stream to an expression AST.
#
# Recursive descent with a `*Parser` cursor over the token stream. `main`'s body
# is an integer arithmetic expression with the usual precedence: additive over
# multiplicative over unary over primary (a literal or a parenthesised
# expression). It grows a level per construct as the grammar fills in.
#
# Left-associative operators fold in a loop that reassigns an `Expr` accumulator
# (`acc = Expr.Add(acc, rhs)`) — one function per precedence level.

import "io" as { die }
import "token" as { Token, TokKind, is_eof, is_ident, is_intlit, is_lparen, is_rparen, is_lbrace, is_rbrace, is_lbracket, is_rbracket, is_comma, is_colon, is_dot, is_ellipsis, is_eq, is_arrow, is_minus, is_plus, is_star, is_slash, is_percent, is_amp, is_pipe, is_caret, is_tilde, is_bang, is_shl, is_shr, is_eqeq, is_ne, is_lt, is_gt, is_le, is_ge, is_logand, is_logor }
import "ast" as { Expr, Stmt, Param, Func, Call, Ty, FieldInit, RecLit, RecDecl, UnionMember, UnionDecl, UnionMkE, MatchArm, MatchExpr, ArrLit, Body, Program }

# The parse cursor: the token stream, the source (for keyword text), a position.
pub data Parser = { [Token] toks, *[Uint8] src, Iarch pos }

# The current token's kind.
const peek = (*Parser p): TokKind -> p.toks[p.pos].kind

# Is the current token the identifier `kw`?
const kw = (*Parser p, Str word): Bool -> {
	if !is_ident(peek(p)) then return false
	return slice_eq(p.src, p.toks[p.pos].start, p.toks[p.pos].len, word)
}

# Does the token slice at (start, len) equal the keyword `word`?
const slice_eq = (*[Uint8] src, Iarch start, Iarch len, Str word): Bool -> {
	if len != Iarch(word.len) then return false
	let Iarch i = 0
	loop {
		if i >= len then break
		if Iarch(src[start + i]) != Iarch(word[i]) then return false
		i = i + 1
	}
	return true
}

# Intern a source slice into an owned `Str` (a binding name / a variable reference),
# copying the bytes so the name outlives the source buffer.
const intern = (*[Uint8] src, Iarch start, Iarch len): Str -> {
	let [Uint8] v = []
	let Iarch i = 0
	loop {
		if i >= len then break
		v = [...v, src[start + i]]
		i = i + 1
	}
	return Str(v)
}

# The current token's interned text (for a binding name or a variable reference).
const cur_name = (*Parser p): Str -> intern(p.src, p.toks[p.pos].start, p.toks[p.pos].len)

# --- expression grammar --------------------------------------------------------------
# precedence, loosest to tightest:
#   logical-or `||` < logical-and `&&` < comparison `== != < > <= >=`
#     < bit-or `|` < bit-xor `^` < bit-and `&` < shift `<< >>` < additive `+ -`
#     < multiplicative `* / %` < unary `-` < primary
# every binary level except comparison is left-associative, folded by a loop that reassigns
# an `Expr` accumulator (`acc = Expr.Add(acc, rhs)`). Comparison is NON-associative — a single
# compare, no chaining.

const parse_expr = (*Parser p): Expr -> parse_or(p)

const parse_or = (*Parser p): Expr -> {
	let Expr acc = parse_and(p)
	loop {
		if !is_logor(peek(p)) then break
		p.pos = p.pos + 1
		acc = Expr.Or(acc, parse_and(p))
	}
	return acc
}

const parse_and = (*Parser p): Expr -> {
	let Expr acc = parse_comparison(p)
	loop {
		if !is_logand(peek(p)) then break
		p.pos = p.pos + 1
		acc = Expr.And(acc, parse_comparison(p))
	}
	return acc
}

const parse_comparison = (*Parser p): Expr -> {
	const Expr lhs = parse_bitor(p)
	if is_eqeq(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.CmpEq(lhs, parse_bitor(p))
	}
	if is_ne(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.CmpNe(lhs, parse_bitor(p))
	}
	if is_lt(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.CmpLt(lhs, parse_bitor(p))
	}
	if is_gt(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.CmpGt(lhs, parse_bitor(p))
	}
	if is_le(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.CmpLe(lhs, parse_bitor(p))
	}
	if is_ge(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.CmpGe(lhs, parse_bitor(p))
	}
	return lhs
}

const parse_bitor = (*Parser p): Expr -> {
	let Expr acc = parse_bitxor(p)
	loop {
		if !is_pipe(peek(p)) then break
		p.pos = p.pos + 1
		acc = Expr.BitOr(acc, parse_bitxor(p))
	}
	return acc
}

const parse_bitxor = (*Parser p): Expr -> {
	let Expr acc = parse_bitand(p)
	loop {
		if !is_caret(peek(p)) then break
		p.pos = p.pos + 1
		acc = Expr.BitXor(acc, parse_bitand(p))
	}
	return acc
}

const parse_bitand = (*Parser p): Expr -> {
	let Expr acc = parse_shift(p)
	loop {
		if !is_amp(peek(p)) then break
		p.pos = p.pos + 1
		acc = Expr.BitAnd(acc, parse_shift(p))
	}
	return acc
}

const parse_shift = (*Parser p): Expr -> {
	let Expr acc = parse_additive(p)
	loop {
		if is_shl(peek(p)) then {
			p.pos = p.pos + 1
			acc = Expr.Shl(acc, parse_additive(p))
		} else if is_shr(peek(p)) then {
			p.pos = p.pos + 1
			acc = Expr.Shr(acc, parse_additive(p))
		} else break
	}
	return acc
}

const parse_additive = (*Parser p): Expr -> {
	let Expr acc = parse_multiplicative(p)
	loop {
		if is_plus(peek(p)) then {
			p.pos = p.pos + 1
			acc = Expr.Add(acc, parse_multiplicative(p))
		} else if is_minus(peek(p)) then {
			p.pos = p.pos + 1
			acc = Expr.Sub(acc, parse_multiplicative(p))
		} else break
	}
	return acc
}

const parse_multiplicative = (*Parser p): Expr -> {
	let Expr acc = parse_unary(p)
	loop {
		if is_star(peek(p)) then {
			p.pos = p.pos + 1
			acc = Expr.Mul(acc, parse_unary(p))
		} else if is_slash(peek(p)) then {
			p.pos = p.pos + 1
			acc = Expr.Div(acc, parse_unary(p))
		} else if is_percent(peek(p)) then {
			p.pos = p.pos + 1
			acc = Expr.Mod(acc, parse_unary(p))
		} else break
	}
	return acc
}

const parse_unary = (*Parser p): Expr -> {
	if is_minus(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.Neg(parse_unary(p))
	}
	if is_bang(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.Not(parse_unary(p))
	}
	if is_tilde(peek(p)) then {
		p.pos = p.pos + 1
		return Expr.BitNot(parse_unary(p))
	}
	return parse_primary(p)
}

# `if <cond> then <a> else <b>` — a value-producing conditional expression. `else`
# is required (an else-less `if` is an `Option`, a later brick). The condition is a
# `Bool` (a comparison); no truthiness (§5).
const parse_if = (*Parser p): Expr -> {
	p.pos = p.pos + 1 # `if`
	const Expr cond = parse_expr(p)
	if !kw(p, "then") then die("cf0: parse: expected `then`\n")
	p.pos = p.pos + 1
	const Expr thenE = parse_expr(p)
	if !kw(p, "else") then die("cf0: parse: expected `else` (an else-less `if` is a later brick)\n")
	p.pos = p.pos + 1
	const Expr elseE = parse_expr(p)
	return Expr.If(cond, thenE, elseE)
}

# `name(args)` — a call. `(` is already the current token. The callee is resolved
# whole-program at emit time (so forward references and recursion work); here we
# only collect the comma-separated argument expressions.
const parse_call = (*Parser p, Str name): Expr -> {
	p.pos = p.pos + 1 # `(`
	let [Expr] args = []
	if !is_rparen(peek(p)) then {
		loop {
			args = [...args, parse_expr(p)]
			if !is_comma(peek(p)) then break
			p.pos = p.pos + 1
		}
	}
	if !is_rparen(peek(p)) then die("cf0: parse: expected `)` in a call\n")
	p.pos = p.pos + 1
	return Expr.Call(Call({ callee: name, args: args }))
}

# A `[…]` dynamic-array literal: `[]`, `[a, b]`, or a spread `[...src, e, …]`. `[` is
# the current token.
const parse_array_lit = (*Parser p): Expr -> {
	p.pos = p.pos + 1 # `[`
	if is_ellipsis(peek(p)) then {
		p.pos = p.pos + 1
		if !is_ident(peek(p)) then die("cf0: parse: expected a spread source name after `...`\n")
		const Str src = cur_name(p)
		p.pos = p.pos + 1
		let [Expr] sp_elems = []
		loop {
			if !is_comma(peek(p)) then break
			p.pos = p.pos + 1
			sp_elems = [...sp_elems, parse_expr(p)]
		}
		if !is_rbracket(peek(p)) then die("cf0: parse: expected `]` in an array spread\n")
		p.pos = p.pos + 1
		return Expr.ArrayLit(ArrLit({ has_spread: true, spread_name: src, elems: sp_elems }))
	}
	let [Expr] lit_elems = []
	if !is_rbracket(peek(p)) then {
		loop {
			lit_elems = [...lit_elems, parse_expr(p)]
			if !is_comma(peek(p)) then break
			p.pos = p.pos + 1
		}
	}
	if !is_rbracket(peek(p)) then die("cf0: parse: expected `]` in an array literal\n")
	p.pos = p.pos + 1
	return Expr.ArrayLit(ArrLit({ has_spread: false, spread_name: "", elems: lit_elems }))
}

# `Type.member(args)` — a payload-member union construction. `(` is the current token.
const parse_union_mk = (*Parser p, Str type_name, Str member): Expr -> {
	p.pos = p.pos + 1 # `(`
	let [Expr] args = []
	if !is_rparen(peek(p)) then {
		loop {
			args = [...args, parse_expr(p)]
			if !is_comma(peek(p)) then break
			p.pos = p.pos + 1
		}
	}
	if !is_rparen(peek(p)) then die("cf0: parse: expected `)` in a union construction\n")
	p.pos = p.pos + 1
	return Expr.UnionMk(UnionMkE({ type_name: type_name, member: member, args: args }))
}

# One `match` arm: a wildcard `_ -> body`; an or-pattern `Type.a | Type.b -> body`;
# or a single member with a positional payload binding `Type.m(v, _) -> body`.
const parse_arm = (*Parser p): MatchArm -> {
	if !is_ident(peek(p)) then die("cf0: parse: expected a match-arm pattern\n")
	const Str first = cur_name(p)
	p.pos = p.pos + 1
	if is_dot(peek(p)) then {
		p.pos = p.pos + 1
		if !is_ident(peek(p)) then die("cf0: parse: expected a member name after `.`\n")
		let [Str] members = []
		members = [...members, cur_name(p)]
		p.pos = p.pos + 1
		let [Str] binds = []
		if is_lparen(peek(p)) then {
			# a payload binding pattern (single member): names or `_`, positionally
			p.pos = p.pos + 1
			loop {
				if !is_ident(peek(p)) then die("cf0: parse: expected a binding name or `_`\n")
				binds = [...binds, cur_name(p)]
				p.pos = p.pos + 1
				if !is_comma(peek(p)) then break
				p.pos = p.pos + 1
			}
			if !is_rparen(peek(p)) then die("cf0: parse: expected `)` in a payload pattern\n")
			p.pos = p.pos + 1
		} else {
			# an or-pattern: further `Type.member` alternatives sharing the qualifier
			loop {
				if !is_pipe(peek(p)) then break
				p.pos = p.pos + 1
				if !is_ident(peek(p)) then die("cf0: parse: expected `Type.member` after `|`\n")
				const Str q = cur_name(p)
				p.pos = p.pos + 1
				if !str_eq(q, first) then die("cf0: parse: or-pattern alternatives must share the union qualifier\n")
				if !is_dot(peek(p)) then die("cf0: parse: expected `.` in an or-pattern alternative\n")
				p.pos = p.pos + 1
				if !is_ident(peek(p)) then die("cf0: parse: expected a member name after `.`\n")
				members = [...members, cur_name(p)]
				p.pos = p.pos + 1
			}
		}
		if !is_arrow(peek(p)) then die("cf0: parse: expected `->` in a match arm\n")
		p.pos = p.pos + 1
		return MatchArm({ is_wild: false, type_name: first, members: members, binds: binds, body: parse_expr(p) })
	}
	if !str_eq(first, "_") then die("cf0: parse: a match-arm pattern is `_` or `Type.member`\n")
	if is_pipe(peek(p)) then die("cf0: parse: `_` is a standalone wildcard, not an or-pattern alternative\n")
	if !is_arrow(peek(p)) then die("cf0: parse: expected `->` after `_`\n")
	p.pos = p.pos + 1
	const [Str] no_members = []
	const [Str] no_binds = []
	return MatchArm({ is_wild: true, type_name: "", members: no_members, binds: no_binds, body: parse_expr(p) })
}

# `match <scrutinee> { arm, arm, … }` — dispatch on a union value's tag.
const parse_match = (*Parser p): Expr -> {
	p.pos = p.pos + 1 # `match`
	const Expr scrut = parse_expr(p)
	if !is_lbrace(peek(p)) then die("cf0: parse: expected `{` after a match scrutinee\n")
	p.pos = p.pos + 1
	let [MatchArm] arms = []
	loop {
		if is_rbrace(peek(p)) then break
		arms = [...arms, parse_arm(p)]
		if !is_comma(peek(p)) then break
		p.pos = p.pos + 1
	}
	if !is_rbrace(peek(p)) then die("cf0: parse: expected `}` to close a match\n")
	p.pos = p.pos + 1
	return Expr.Match(MatchExpr({ scrut: scrut, arms: arms }))
}

const parse_primary = (*Parser p): Expr -> {
	if kw(p, "if") then return parse_if(p)
	if kw(p, "match") then return parse_match(p)
	if is_lbracket(peek(p)) then return parse_array_lit(p)
	# `true`/`false` — Bool literals. Typed `Bool` by the typecheck phase; lowered to
	# the 1/0 words a Bool is represented by at emit.
	if kw(p, "true") then {
		p.pos = p.pos + 1
		return Expr.BoolLit(true)
	}
	if kw(p, "false") then {
		p.pos = p.pos + 1
		return Expr.BoolLit(false)
	}
	# an identifier — a call `name(args)` if followed by `(`, a field read `name.f` if
	# followed by `.`, else a reference to a local binding / parameter.
	if is_ident(peek(p)) then {
		const Str name = cur_name(p)
		p.pos = p.pos + 1
		if is_lparen(peek(p)) then return parse_call(p, name)
		if is_dot(peek(p)) then {
			p.pos = p.pos + 1
			if !is_ident(peek(p)) then die("cf0: parse: expected a field name after `.`\n")
			const Str field = cur_name(p)
			p.pos = p.pos + 1
			# `Type.member(args)` is a payload-member construction; `base.field` (no
			# args) is a field read or a tag-only-member construction.
			if is_lparen(peek(p)) then return parse_union_mk(p, name, field)
			return Expr.Field(name, field)
		}
		# `name[i]` — a dynamic-array index
		if is_lbracket(peek(p)) then {
			p.pos = p.pos + 1
			const Expr idx = parse_expr(p)
			if !is_rbracket(peek(p)) then die("cf0: parse: expected `]` in an index\n")
			p.pos = p.pos + 1
			return Expr.Index(name, idx)
		}
		return Expr.Var(name)
	}
	if is_intlit(peek(p)) then {
		const Iarch v = p.toks[p.pos].ival
		p.pos = p.pos + 1
		return Expr.Lit(v)
	}
	if is_lparen(peek(p)) then {
		p.pos = p.pos + 1
		const Expr inner = parse_expr(p)
		if !is_rparen(peek(p)) then die("cf0: parse: expected `)`\n")
		p.pos = p.pos + 1
		return inner
	}
	die("cf0: parse: expected an integer or `(`\n")
	return Expr.Lit(0)
}

# --- statements & block bodies --------------------------------------------------------

# `{ field: value, … }` — a data literal for a record of type `type_name`. Fields
# may be given in any order (mapped to declaration order at typecheck); each is
# `name: expr`. A trailing comma is allowed.
const parse_record_lit = (*Parser p, Str type_name): Expr -> {
	p.pos = p.pos + 1 # `{`
	let [FieldInit] inits = []
	loop {
		if is_rbrace(peek(p)) then break
		if !is_ident(peek(p)) then die("cf0: parse: expected a field name in a data literal\n")
		const Str field = cur_name(p)
		p.pos = p.pos + 1
		if !is_colon(peek(p)) then die("cf0: parse: expected `:` after a field name\n")
		p.pos = p.pos + 1
		inits = [...inits, FieldInit({ field: field, value: parse_expr(p) })]
		if !is_comma(peek(p)) then break
		p.pos = p.pos + 1
	}
	if !is_rbrace(peek(p)) then die("cf0: parse: expected `}` in a data literal\n")
	p.pos = p.pos + 1
	return Expr.Record(RecLit({ type_name: type_name, inits: inits }))
}

# A `const`/`let` binding. An optional type annotation (`const Iarch x = …`, or
# `const Point p = …`) is a `TYPE name` pair before the `=`. The type name is
# ignored for a scalar, but names the record type for a data-literal initializer.
# The initializer after `=`: a data literal `{ … }` (a record of type `type_name`,
# which is `""` when there is no annotation — an error caught at typecheck) or an
# ordinary expression.
const parse_init = (*Parser p, Str type_name): Expr -> {
	if is_lbrace(peek(p)) then return parse_record_lit(p, type_name)
	return parse_expr(p)
}

const parse_let = (*Parser p, Bool mutable): Stmt -> {
	# `[Elem] name` — a dynamic-array annotation (consumed; the initializer types it).
	if is_lbracket(peek(p)) then {
		parse_type(p)
		if !is_ident(peek(p)) then die("cf0: parse: expected a binding name\n")
		const Str dname = cur_name(p)
		p.pos = p.pos + 1
		if !is_eq(peek(p)) then die("cf0: parse: expected `=` in a binding\n")
		p.pos = p.pos + 1
		return Stmt.Let(dname, mutable, parse_init(p, ""))
	}
	if !is_ident(peek(p)) then die("cf0: parse: expected a binding name\n")
	# `TYPE name` (an annotation) vs a bare `name` — the token after the first decides.
	# A `Str` local cannot be reassigned, so the annotated and bare paths are separate.
	if is_ident(p.toks[p.pos + 1].kind) then {
		const Str type_name = cur_name(p)
		p.pos = p.pos + 1
		const Str name = cur_name(p)
		p.pos = p.pos + 1
		if !is_eq(peek(p)) then die("cf0: parse: expected `=` in a binding\n")
		p.pos = p.pos + 1
		return Stmt.Let(name, mutable, parse_init(p, type_name))
	}
	const Str name = cur_name(p)
	p.pos = p.pos + 1
	if !is_eq(peek(p)) then die("cf0: parse: expected `=` in a binding\n")
	p.pos = p.pos + 1
	return Stmt.Let(name, mutable, parse_init(p, ""))
}

# `for <var> in <arr> { body }` — iterate a dynamic array's elements.
const parse_for = (*Parser p): Stmt -> {
	p.pos = p.pos + 1 # `for`
	if !is_ident(peek(p)) then die("cf0: parse: expected a loop variable after `for`\n")
	const Str lv = cur_name(p)
	p.pos = p.pos + 1
	if !kw(p, "in") then die("cf0: parse: expected `in` in a for-loop\n")
	p.pos = p.pos + 1
	if !is_ident(peek(p)) then die("cf0: parse: expected an array name after `in`\n")
	const Str arr = cur_name(p)
	p.pos = p.pos + 1
	if !is_lbrace(peek(p)) then die("cf0: parse: expected `{` for a for-loop body\n")
	p.pos = p.pos + 1
	const [Stmt] body = parse_block(p)
	return Stmt.ForIn(lv, arr, Body({ stmts: body }))
}

const parse_stmt = (*Parser p): Stmt -> {
	if kw(p, "const") then {
		p.pos = p.pos + 1
		return parse_let(p, false)
	}
	if kw(p, "let") then {
		p.pos = p.pos + 1
		return parse_let(p, true)
	}
	if kw(p, "for") then return parse_for(p)
	if kw(p, "return") then {
		p.pos = p.pos + 1
		return Stmt.Return(parse_expr(p))
	}
	# otherwise an assignment: a field mutation `name.field = expr` or a whole-name
	# reassignment `name = expr` (a `let` local).
	if is_ident(peek(p)) then {
		const Str name = cur_name(p)
		p.pos = p.pos + 1
		if is_dot(peek(p)) then {
			p.pos = p.pos + 1
			if !is_ident(peek(p)) then die("cf0: parse: expected a field name after `.`\n")
			const Str field = cur_name(p)
			p.pos = p.pos + 1
			if !is_eq(peek(p)) then die("cf0: parse: expected `=` in a field assignment\n")
			p.pos = p.pos + 1
			return Stmt.FieldAssign(name, field, parse_expr(p))
		}
		if !is_eq(peek(p)) then die("cf0: parse: expected `=` in an assignment\n")
		p.pos = p.pos + 1
		return Stmt.Assign(name, parse_expr(p))
	}
	die("cf0: parse: expected a statement\n")
	return Stmt.Return(Expr.Lit(0))
}

# Parse a `{ … }` block into its statement list (statement boundaries are implicit —
# cf0 does not yet track newlines, so a statement ends where its expression does).
const parse_block = (*Parser p): [Stmt] -> {
	let [Stmt] stmts = []
	loop {
		if is_rbrace(peek(p)) then break
		stmts = [...stmts, parse_stmt(p)]
	}
	p.pos = p.pos + 1 # `}`
	return stmts
}

# --- parameters -----------------------------------------------------------------------

# Byte-wise `Str` equality (duplicate-parameter detection).
const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

# Is `name` already among the parameters parsed so far?
const params_has = ([Param] params, Str name): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(params.len) then break
		if str_eq(params[i].name, name) then return true
		i = i + 1
	}
	return false
}

# Parse a type reference into the `Ty` the typecheck phase tracks: a pointer type
# `*[Elem]` (`*[Str]`) or a dynamic-array type `[Elem]` → `TPtr`; a bare `Bool` →
# `TBool`; any other type-name identifier (`Iarch`, `Int`, …) → `TInt`.
const parse_type = (*Parser p): Ty -> {
	if is_star(peek(p)) then {
		p.pos = p.pos + 1
		if !is_lbracket(peek(p)) then die("cf0: parse: expected `[` in a pointer type\n")
		p.pos = p.pos + 1
		if !is_ident(peek(p)) then die("cf0: parse: expected an element type name\n")
		p.pos = p.pos + 1
		if !is_rbracket(peek(p)) then die("cf0: parse: expected `]`\n")
		p.pos = p.pos + 1
		return Ty.TPtr
	}
	if is_lbracket(peek(p)) then {
		p.pos = p.pos + 1
		if !is_ident(peek(p)) then die("cf0: parse: expected an element type name\n")
		const Str elem = cur_name(p)
		p.pos = p.pos + 1
		if !is_rbracket(peek(p)) then die("cf0: parse: expected `]`\n")
		p.pos = p.pos + 1
		return Ty.TDyn(elem)
	}
	if !is_ident(peek(p)) then die("cf0: parse: expected a type\n")
	const Bool is_bool = kw(p, "Bool")
	p.pos = p.pos + 1
	if is_bool then return Ty.TBool
	return Ty.TInt
}

# A single parameter: `<type> <name>`. A pointer type (`*[Elem]`/`[Elem]`) becomes a
# pointer parameter (no type name); a bare type-name identifier (`Iarch`, `Bool`, or
# a record type) is kept in `type_name` for the typecheck phase to resolve.
const parse_param = (*Parser p): Param -> {
	if is_star(peek(p)) then {
		parse_type(p)
		if !is_ident(peek(p)) then die("cf0: parse: expected a parameter name\n")
		const Str name = cur_name(p)
		p.pos = p.pos + 1
		return Param({ name: name, is_ptr: true, type_name: "" })
	}
	if is_lbracket(peek(p)) then {
		parse_type(p)
		if !is_ident(peek(p)) then die("cf0: parse: expected a parameter name\n")
		const Str name = cur_name(p)
		p.pos = p.pos + 1
		return Param({ name: name, is_ptr: true, type_name: "" })
	}
	if !is_ident(peek(p)) then die("cf0: parse: expected a parameter type\n")
	const Str type_name = cur_name(p)
	p.pos = p.pos + 1
	if !is_ident(peek(p)) then die("cf0: parse: expected a parameter name\n")
	const Str name = cur_name(p)
	p.pos = p.pos + 1
	return Param({ name: name, is_ptr: false, type_name: type_name })
}

# The parenthesised parameter list; a repeated name is rejected. Any arity is
# accepted here — `main`'s ≤3 cap is a whole-program rule checked at resolve time.
const parse_params = (*Parser p): [Param] -> {
	let [Param] params = []
	if is_rparen(peek(p)) then return params
	loop {
		const Param pm = parse_param(p)
		if params_has(params, pm.name) then die("cf0: parse: duplicate parameter name\n")
		# append a fresh record literal (an array element must be fresh, not the
		# alias `pm`); the field values are read inline.
		params = [...params, Param({ name: pm.name, is_ptr: pm.is_ptr, type_name: pm.type_name })]
		if !is_comma(peek(p)) then break
		p.pos = p.pos + 1
	}
	return params
}

# --- functions & the whole program ----------------------------------------------------

# The optional `: RetType` return annotation as a raw type NAME: `""` when absent
# (an implicit `Int`, e.g. `main`), else the bare type-name identifier (resolved to a
# `Ty` at typecheck). Pointer/array return types are a later brick.
const parse_ret_name = (*Parser p): Str -> {
	if !is_colon(peek(p)) then return ""
	p.pos = p.pos + 1
	if !is_ident(peek(p)) then die("cf0: parse: expected a return type name after `:`\n")
	const Str n = cur_name(p)
	p.pos = p.pos + 1
	return n
}

# One top-level function: `[pub] const NAME = (params)[: RetType] -> body`. The body
# is a block `{ … }` or a bare expression (sugar for `{ return <expr> }`). The
# return type is parsed and ignored (no typecheck yet; every function returns a word).
const parse_func = (*Parser p): Func -> {
	let Bool is_pub = false
	if kw(p, "pub") then {
		is_pub = true
		p.pos = p.pos + 1
	}
	if !kw(p, "const") then die("cf0: parse: expected `const`\n")
	p.pos = p.pos + 1
	if !is_ident(peek(p)) then die("cf0: parse: expected a function name\n")
	const Str name = cur_name(p)
	p.pos = p.pos + 1
	if !is_eq(peek(p)) then die("cf0: parse: expected `=`\n")
	p.pos = p.pos + 1
	if !is_lparen(peek(p)) then die("cf0: parse: expected `(`\n")
	p.pos = p.pos + 1
	const [Param] params = parse_params(p)
	if !is_rparen(peek(p)) then die("cf0: parse: expected `)`\n")
	p.pos = p.pos + 1
	const Str ret_name = parse_ret_name(p)
	if !is_arrow(peek(p)) then die("cf0: parse: expected `->`\n")
	p.pos = p.pos + 1
	if is_lbrace(peek(p)) then {
		p.pos = p.pos + 1
		const [Stmt] body = parse_block(p)
		return Func({ name: name, is_pub: is_pub, ret_name: ret_name, params: params, body: body })
	}
	const [Stmt] empty = []
	const [Stmt] one = [...empty, Stmt.Return(parse_expr(p))]
	return Func({ name: name, is_pub: is_pub, ret_name: ret_name, params: params, body: one })
}

# `data Name = { Iarch a, Iarch b }` — a record declaration (Iarch fields only, at
# least one; a trailing comma is allowed). The field types are consumed and ignored
# (part 1 assumes every field is an `Iarch` word).
const parse_data = (*Parser p): RecDecl -> {
	p.pos = p.pos + 1 # `data`
	if !is_ident(peek(p)) then die("cf0: parse: expected a record type name\n")
	const Str name = cur_name(p)
	p.pos = p.pos + 1
	if !is_eq(peek(p)) then die("cf0: parse: expected `=` in a data declaration\n")
	p.pos = p.pos + 1
	if !is_lbrace(peek(p)) then die("cf0: parse: expected `{` in a data declaration\n")
	p.pos = p.pos + 1
	let [Str] fields = []
	loop {
		if is_rbrace(peek(p)) then break
		parse_type(p) # the field type (Iarch), consumed and ignored
		if !is_ident(peek(p)) then die("cf0: parse: expected a field name\n")
		fields = [...fields, cur_name(p)]
		p.pos = p.pos + 1
		if !is_comma(peek(p)) then break
		p.pos = p.pos + 1
	}
	if !is_rbrace(peek(p)) then die("cf0: parse: expected `}` in a data declaration\n")
	p.pos = p.pos + 1
	return RecDecl({ name: name, fields: fields })
}

# `union Name = { A, B, C }` — a tag-only union declaration (at least one member; a
# trailing comma and interior newlines are fine). Payload members are a later brick.
const parse_union = (*Parser p): UnionDecl -> {
	p.pos = p.pos + 1 # `union`
	if !is_ident(peek(p)) then die("cf0: parse: expected a union type name\n")
	const Str name = cur_name(p)
	p.pos = p.pos + 1
	if !is_eq(peek(p)) then die("cf0: parse: expected `=` in a union declaration\n")
	p.pos = p.pos + 1
	if !is_lbrace(peek(p)) then die("cf0: parse: expected `{` in a union declaration\n")
	p.pos = p.pos + 1
	let [UnionMember] members = []
	loop {
		if is_rbrace(peek(p)) then break
		if !is_ident(peek(p)) then die("cf0: parse: expected a member name\n")
		const Str mname = cur_name(p)
		p.pos = p.pos + 1
		# an optional payload `(T, T, …)` — the field type names (Iarch in M1.2a)
		let [Str] payloads = []
		if is_lparen(peek(p)) then {
			p.pos = p.pos + 1
			loop {
				if !is_ident(peek(p)) then die("cf0: parse: expected a payload type\n")
				payloads = [...payloads, cur_name(p)]
				p.pos = p.pos + 1
				if !is_comma(peek(p)) then break
				p.pos = p.pos + 1
			}
			if !is_rparen(peek(p)) then die("cf0: parse: expected `)` after a payload\n")
			p.pos = p.pos + 1
		}
		members = [...members, UnionMember({ name: mname, payloads: payloads })]
		if !is_comma(peek(p)) then break
		p.pos = p.pos + 1
	}
	if !is_rbrace(peek(p)) then die("cf0: parse: expected `}` in a union declaration\n")
	p.pos = p.pos + 1
	return UnionDecl({ name: name, members: members })
}

# The whole program: a sequence of top-level `data`/`union` declarations and
# functions, in any order. One function must be `pub const main` (checked later).
pub const parse_program = (*Parser p): Program -> {
	let [RecDecl] recs = []
	let [UnionDecl] unions = []
	let [Func] funcs = []
	loop {
		if is_eof(peek(p)) then break
		if kw(p, "data") then {
			recs = [...recs, parse_data(p)]
		} else if kw(p, "union") then {
			unions = [...unions, parse_union(p)]
		} else {
			funcs = [...funcs, parse_func(p)]
		}
	}
	return Program({ recs: recs, unions: unions, funcs: funcs })
}
