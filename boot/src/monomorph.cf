# monomorph — clone-based monomorphization of generic functions (type_system §8.1, seed_subset).
#
# A generic function `id = ['T]('T x): 'T -> x` is a TEMPLATE. This pass runs between resolve
# and typecheck: it removes the templates and, for every distinct set of type ARGUMENTS a
# template is called with, emits a concrete CLONE with each `'T` substituted by the argument
# (e.g. `id[Iarch]` → a function `id$Iarch` with `Iarch` params/return). Every generic call
# site is rewritten to name its concrete instance (type arguments stripped), so typecheck and
# emit see only ordinary functions. Instances are deduped, and a clone's own body is scanned
# for further generic calls (transitive instantiation) to a fixpoint.
#
# Type arguments are given EXPLICITLY (`id[Iarch](x)`) or INFERRED from the argument types
# (`id(x)`). Inference is shallow — it reads each argument's type from a local environment the
# pass threads (parameters + `let` bindings): a parameter whose declared type IS a type
# variable fixes that variable to the argument's type. Structural inference (through a tuple or
# array parameter), generic DATA/UNION types, and bounds are later bricks.

import "io" as { die }
import "ast" as { Expr, Stmt, Param, Func, MatchArm, StmtArm, Seg, FieldInit, RecDecl, UnionDecl, UnionMember, TupElem, Import, Program }
import "astutil" as { is_fixed_name, is_float_name }

# The accumulating state, threaded by pointer: the generic FUNCTION templates + their instance
# clones (with a dedup key set), the program's union names (to tell a tag-only union member
# `Color.Green` from a field read), and the generic RECORD templates + their instance clones
# (with their own key set) — a generic type application `Box[Iarch]` clones the record template
# `Box` into a concrete `Box$Iarch`.
data MonoCtx = { [Func] templates, [Str] keys, [Func] instances, [Str] unions, [RecDecl] rec_templates, [Str] type_keys, [RecDecl] rec_instances, [UnionDecl] union_templates, [UnionDecl] union_instances }

# The context threaded through a function body: the active substitution (type variable → its
# concrete argument, when cloning a template) and a local TYPE environment (a name → its type
# name, for parameters and `let` bindings) used to infer a generic call's type arguments.
data MonoEnv = { [Str] tvars, [Str] tvals, [Str] enames, [Str] etypes }

const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

const find_template = ([Func] templates, Str n): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(templates.len) then break
		if str_eq(templates[i].name, n) then return i
		i = i + 1
	}
	return 0 - 1
}
const key_seen = (*MonoCtx m, Str mn): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(m.keys.len) then break
		if str_eq(m.keys[i], mn) then return true
		i = i + 1
	}
	return false
}
const is_union_name = (*MonoCtx m, Str n): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(m.unions.len) then break
		if str_eq(m.unions[i], n) then return true
		i = i + 1
	}
	return false
}
# A bare or negated integer literal — a WEAK inference source: it fixes a type variable only
# when no non-literal argument does, since an integer literal ADOPTS its context's width
# (`hash(x, 0)` with `x : Uint8` infers `Uint8`, not `Iarch`, from `x`).
const is_int_lit = (Expr e): Bool -> match e {
	Expr.Lit(v) -> true,
	Expr.Neg(x) -> match x { Expr.Lit(v) -> true, _ -> false },
	_ -> false
}

# --- substitution --------------------------------------------------------------------------

const subst_ty = (Str name, [Str] tvars, [Str] tvals): Str -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(tvars.len) then break
		if str_eq(tvars[i], name) then return tvals[i]
		i = i + 1
	}
	return name
}
const subst_tys = ([Str] names, [Str] tvars, [Str] tvals): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(names.len) then break
		out = [...out, subst_ty(names[i], tvars, tvals)]
		i = i + 1
	}
	return out
}
# Substitute type variables inside a tuple's position list — a nested position recurses, a leaf
# substitutes its name — so a `('T, Iarch)` param/return in a generic instance is concretized.
const subst_telems = ([TupElem] tels, [Str] tvars, [Str] tvals): [TupElem] -> {
	let [TupElem] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(tels.len) then break
		const TupElem t = tels[i]
		if str_eq(t.name, "$tuple") then out = [...out, TupElem({ name: "$tuple", sub: subst_telems(t.sub, tvars, tvals) })]
		if !str_eq(t.name, "$tuple") then {
			let [TupElem] none = []
			out = [...out, TupElem({ name: subst_ty(t.name, tvars, tvals), sub: none })]
		}
		i = i + 1
	}
	return out
}
# Substitute across a per-position tuple-type list (a record's `ftelems` / a union member's
# `ptelems`, one `[TupElem]` per field/payload position), concretizing a `('T, Iarch)` tuple
# field/payload when a generic record/union is cloned.
const subst_telemss = ([[TupElem]] tlss, [Str] tvars, [Str] tvals): [[TupElem]] -> {
	let [[TupElem]] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(tlss.len) then break
		out = [...out, subst_telems(tlss[i], tvars, tvals)]
		i = i + 1
	}
	return out
}

# The concrete instance name for `gname` applied to `tyargs` — `id[Iarch]` → `id$Iarch`,
# `pair[Iarch, Color]` → `pair$Iarch$Color`. The `$` separator never occurs in a source name or
# in resolve's `__<tag>` private-mangling, so (template, args) → name is injective (no collision
# between `pair[Iarch, Str]` and a `pair__Iarch[Str]`). The name is only a resolution key —
# emit names every function positionally (`$f<idx>`), so the `$` never reaches a QBE symbol.
const mangle_instance = (Str gname, [Str] tyargs): Str -> {
	let Str s = gname
	let Iarch i = 0
	loop {
		if i >= Iarch(tyargs.len) then break
		s = "${s}$${tyargs[i]}"
		i = i + 1
	}
	return s
}

# --- generic TYPE applications ('Base[a, b]', a bracketed string from the parser) ------------

# Whether a type reference is a generic application (`Box[Iarch]`) rather than a bare name.
const is_type_app = (Str s): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(s.len) then break
		if Iarch(s[i]) == 91 then return true  # '['
		i = i + 1
	}
	return false
}
# The base name of a type application — `Box[Iarch]` → `Box`.
const type_base = (Str s): Str -> {
	let [Uint8] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(s.len) then break
		if Iarch(s[i]) == 91 then break
		out = [...out, s[i]]
		i = i + 1
	}
	return Str(out)
}
# The top-level argument type references of a type application — `Box[Pair[Iarch,Iarch]]` →
# `["Pair[Iarch,Iarch]"]`, splitting only at depth-1 commas so nested applications stay whole.
const type_args = (Str s): [Str] -> {
	let Iarch start = 0
	loop {
		if start >= Iarch(s.len) then break
		if Iarch(s[start]) == 91 then break
		start = start + 1
	}
	let [Str] out = []
	let [Uint8] cur = []
	let Iarch depth = 0
	let Iarch i = start
	loop {
		if i >= Iarch(s.len) then break
		const Iarch c = Iarch(s[i])
		if c == 91 then { depth = depth + 1 if depth > 1 then cur = [...cur, s[i]] }
		if c == 93 then { depth = depth - 1 if depth >= 1 then cur = [...cur, s[i]] }
		if c == 44 && depth == 1 then { out = [...out, Str(cur)] cur = [] }
		if c != 91 && c != 93 && !(c == 44 && depth == 1) then cur = [...cur, s[i]]
		i = i + 1
	}
	if Iarch(cur.len) > 0 then out = [...out, Str(cur)]
	return out
}

const find_rec_template = ([RecDecl] recs, Str n): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(recs.len) then break
		if str_eq(recs[i].name, n) then return i
		i = i + 1
	}
	return 0 - 1
}
const type_key_seen = (*MonoCtx m, Str mn): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(m.type_keys.len) then break
		if str_eq(m.type_keys[i], mn) then return true
		i = i + 1
	}
	return false
}

# Resolve a type reference to its concrete name, substituting type variables and mangling any
# generic application to its instance (`'T` → `Iarch`; `Box['T]` → `Box$Iarch`, generating the
# `Box$Iarch` record). Recurses through nested applications and registers each instance.
const mangle_type = (*MonoCtx m, Str name, [Str] tvars, [Str] tvals): Str -> {
	if !is_type_app(name) then return subst_ty(name, tvars, tvals)
	const Str base = type_base(name)
	const [Str] args = type_args(name)
	let [Str] margs = []
	let Iarch i = 0
	loop {
		if i >= Iarch(args.len) then break
		margs = [...margs, mangle_type(m, args[i], tvars, tvals)]
		i = i + 1
	}
	return ensure_type_instance(m, base, margs)
}
const find_union_template = ([UnionDecl] unions, Str n): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(unions.len) then break
		if str_eq(unions[i].name, n) then return i
		i = i + 1
	}
	return 0 - 1
}
# A generic type application resolves to a concrete record OR union instance.
const ensure_type_instance = (*MonoCtx m, Str base, [Str] margs): Str -> {
	if find_rec_template(m.rec_templates, base) >= 0 then return ensure_rec_instance(m, base, margs)
	if find_union_template(m.union_templates, base) >= 0 then return ensure_union_instance(m, base, margs)
	die("cf0: type: a generic type application names a non-generic or undeclared type\n")
	return ""
}
# Ensure the concrete union instance `base[margs]` exists (cloning the template, substituting
# its type parameters in every member payload type — which may register further instances, e.g.
# a recursive `List['T]` referencing `List['T]`) and return its mangled name.
const ensure_union_instance = (*MonoCtx m, Str base, [Str] margs): Str -> {
	const Str mn = mangle_instance(base, margs)
	if type_key_seen(m, mn) then return mn
	m.type_keys = [...m.type_keys, mn]  # mark before recursing so a recursive union terminates
	const Iarch ui = find_union_template(m.union_templates, base)
	const UnionDecl tmpl = m.union_templates[ui]
	if Iarch(tmpl.typarams.len) != Iarch(margs.len) then die("cf0: type: wrong number of type arguments for a generic type\n")
	let [UnionMember] members = []
	let Iarch mi = 0
	loop {
		if mi >= Iarch(tmpl.members.len) then break
		const UnionMember um = tmpl.members[mi]
		members = [...members, UnionMember({ name: um.name, payloads: mangle_types(m, um.payloads, tmpl.typarams, margs), pelems: subst_tys(um.pelems, tmpl.typarams, margs), ptelems: subst_telemss(um.ptelems, tmpl.typarams, margs) })]
		mi = mi + 1
	}
	const [Str] no_tp = []
	m.union_instances = [...m.union_instances, UnionDecl({ name: mn, members: members, typarams: no_tp })]
	return mn
}
const mangle_types = (*MonoCtx m, [Str] names, [Str] tvars, [Str] tvals): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(names.len) then break
		out = [...out, mangle_type(m, names[i], tvars, tvals)]
		i = i + 1
	}
	return out
}
# Ensure the concrete record instance `base[margs]` exists (cloning the template, substituting
# its type parameters in every field type — which may register further instances) and return
# its mangled name.
const ensure_rec_instance = (*MonoCtx m, Str base, [Str] margs): Str -> {
	const Str mn = mangle_instance(base, margs)
	if type_key_seen(m, mn) then return mn
	m.type_keys = [...m.type_keys, mn]  # mark before recursing (a self-referential type terminates)
	const Iarch ri = find_rec_template(m.rec_templates, base)
	if ri < 0 then die("cf0: type: a generic type application names a non-generic or undeclared type\n")
	const RecDecl tmpl = m.rec_templates[ri]
	if Iarch(tmpl.typarams.len) != Iarch(margs.len) then die("cf0: type: wrong number of type arguments for a generic type\n")
	let [Str] ftypes = mangle_types(m, tmpl.ftypes, tmpl.typarams, margs)
	let [Str] felems = subst_tys(tmpl.felems, tmpl.typarams, margs)
	let [[TupElem]] ftelems = subst_telemss(tmpl.ftelems, tmpl.typarams, margs)
	const [Str] no_tp = []
	m.rec_instances = [...m.rec_instances, RecDecl({ name: mn, fields: tmpl.fields, ftypes: ftypes, felems: felems, ftelems: ftelems, typarams: no_tp })]
	return mn
}

# --- local type environment (for inference) ------------------------------------------------

const env_add = (MonoEnv e, Str name, Str ty): MonoEnv -> MonoEnv({ tvars: e.tvars, tvals: e.tvals, enames: [...e.enames, name], etypes: [...e.etypes, ty] })
const env_lookup = (MonoEnv e, Str name): Str -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(e.enames.len) then break
		if str_eq(e.enames[i], name) then return e.etypes[i]
		i = i + 1
	}
	return ""
}

# A `base.f` argument: a tag-only union member construction (`Color.Green`, `base` a declared
# union) has the union's type; a field read (`base` a local/param, or anything non-union) has a
# type this shallow pass cannot know, so inference from it is not possible (use explicit args).
const field_arg_ty = (*MonoCtx m, Str base, MonoEnv env): Str -> {
	if !str_eq(env_lookup(env, base), "") then return ""
	if is_union_name(m, base) then return base
	return ""
}
# A numeric cast `T(x)` argument has the obvious type `T`; the width-changing casts are the
# common way to fix a fixed-width/float type argument (`addc(Uint8(a), Uint8(b))` infers Uint8).
const cast_arg_ty = (Str callee): Str -> {
	if is_fixed_name(callee) then return callee
	if is_float_name(callee) then return callee
	if str_eq(callee, "Iarch") then return "Iarch"
	if str_eq(callee, "Int") then return "Iarch"
	if str_eq(callee, "Uarch") then return "Uarch"
	return ""
}
# The type NAME an argument expression denotes, for inference — a literal's builtin type, a
# variable's recorded type, or a record/union construction's type. Anything else yields "" (an
# inference from that argument is not possible, so a fully-unfixed call is an error).
const arg_ty = (*MonoCtx m, Expr e, MonoEnv env): Str -> match e {
	Expr.Lit(v) -> "Iarch",
	Expr.FloatLit(t) -> "Float64",
	Expr.BoolLit(b) -> "Bool",
	Expr.StrLit(bs) -> "Str",
	Expr.Var(n) -> env_lookup(env, n),
	Expr.Record(tn, fs) -> tn,
	Expr.UnionMk(tn, mem, args) -> tn,
	Expr.Field(base, f) -> field_arg_ty(m, base, env),
	Expr.Call(callee, ta, cargs) -> cast_arg_ty(callee),
	Expr.Neg(x) -> arg_ty(m, x, env),
	Expr.Add(l, r) -> arg_ty(m, l, env),
	Expr.Sub(l, r) -> arg_ty(m, l, env),
	Expr.Mul(l, r) -> arg_ty(m, l, env),
	Expr.Div(l, r) -> arg_ty(m, l, env),
	_ -> ""
}

# Infer a generic call's type arguments: for each type variable, a parameter whose declared
# type IS that variable fixes it to the corresponding argument's type. A variable no parameter
# mentions (or whose argument type is unknown) cannot be inferred — an error.
const infer_tyargs = (*MonoCtx m, Func tmpl, [Expr] args, MonoEnv env): [Str] -> {
	let [Str] tvals = []
	let Iarch t = 0
	loop {
		if t >= Iarch(tmpl.typarams.len) then break
		const Str tv = tmpl.typarams[t]
		# a NON-literal argument fixes the variable authoritatively; an integer literal only
		# fixes it if nothing else does (it would otherwise adopt, not pin, the width)
		let Str strong = ""
		let Str weak = ""
		let Iarch p = 0
		loop {
			if p >= Iarch(tmpl.params.len) then break
			if str_eq(tmpl.params[p].type_name, tv) && p < Iarch(args.len) then {
				const Str at = arg_ty(m, args[p], env)
				if !str_eq(at, "") then {
					if is_int_lit(args[p]) then weak = at
					if !is_int_lit(args[p]) then strong = at
				}
			}
			p = p + 1
		}
		let Str bound = strong
		if str_eq(bound, "") then bound = weak
		if str_eq(bound, "") then die("cf0: type: cannot infer a type argument for a generic call\n")
		tvals = [...tvals, bound]
		t = t + 1
	}
	return tvals
}

# --- cloning + rewriting -------------------------------------------------------------------

# Ensure the instance of `gname` with concrete `tyargs` exists (generating it, and transitively
# any instance its body needs), and return its mangled name.
const ensure_instance = (*MonoCtx m, Str gname, [Str] tyargs): Str -> {
	const Str mn = mangle_instance(gname, tyargs)
	if key_seen(m, mn) then return mn
	m.keys = [...m.keys, mn]  # mark before recursing so a recursive generic terminates
	const Iarch ti = find_template(m.templates, gname)
	const Func tmpl = m.templates[ti]
	if Iarch(tmpl.typarams.len) != Iarch(tyargs.len) then die("cf0: type: a generic call has the wrong number of type arguments\n")
	const Func clone = mono_func(m, tmpl, mn, tmpl.typarams, tyargs)
	m.instances = [...m.instances, clone]
	return mn
}

# Clone a function with `tvars` → `tvals` substituted in every type position (parameters,
# return, local annotations, nested generic call arguments) and its generic calls rewritten to
# instances. `newname` is the (concrete) result name.
const mono_func = (*MonoCtx m, Func f, Str newname, [Str] tvars, [Str] tvals): Func -> {
	let [Param] ps = []
	let Iarch i = 0
	loop {
		if i >= Iarch(f.params.len) then break
		const Param p = f.params[i]
		# substitute `'T` in EVERY type position of the parameter: the scalar/record name (or a
		# generic type application, mangled to its instance), a `[T]` array element, and a tuple
		ps = [...ps, Param({ name: p.name, is_ptr: p.is_ptr, type_name: mangle_type(m, p.type_name, tvars, tvals), elem: subst_ty(p.elem, tvars, tvals), telems: subst_telems(p.telems, tvars, tvals) })]
		i = i + 1
	}
	const Str rn = mangle_type(m, f.ret_name, tvars, tvals)
	const Str re = subst_ty(f.ret_elem, tvars, tvals)
	const [TupElem] rtel = subst_telems(f.ret_telems, tvars, tvals)
	# seed the local type env with the (substituted) parameter types, so a generic call in the
	# body can infer from a parameter reference
	let [Str] enames = []
	let [Str] etypes = []
	let Iarch pi = 0
	loop {
		if pi >= Iarch(ps.len) then break
		enames = [...enames, ps[pi].name]
		etypes = [...etypes, ps[pi].type_name]
		pi = pi + 1
	}
	const MonoEnv env = MonoEnv({ tvars: tvars, tvals: tvals, enames: enames, etypes: etypes })
	const [Stmt] body = mono_stmts(m, f.body, env)
	const [Str] no_tp = []
	return Func({ name: newname, is_pub: f.is_pub, ret_name: rn, ret_elem: re, params: ps, body: body, is_asm: f.is_asm, asm_body: f.asm_body, is_value: f.is_value, ret_telems: rtel, typarams: no_tp })
}

# Rewrite a call. A generic callee is instantiated (type args explicit, or inferred from the
# argument types) and renamed to its concrete instance; type args on a non-generic function are
# an error. A non-generic call passes through with its (recursively rewritten) arguments.
const mono_call = (*MonoCtx m, Str n, [Str] ta, [Expr] args, MonoEnv env): Expr -> {
	const [Expr] margs = mono_exprs(m, args, env)
	const [Str] rty = subst_tys(ta, env.tvars, env.tvals)
	const [Str] no_ty = []
	const Iarch ti = find_template(m.templates, n)
	if ti >= 0 then {
		let [Str] fty = rty
		if Iarch(rty.len) == 0 then fty = infer_tyargs(m, m.templates[ti], args, env)
		return Expr.Call(ensure_instance(m, n, fty), no_ty, margs)
	}
	if Iarch(rty.len) > 0 then die("cf0: type: type arguments on a non-generic function\n")
	return Expr.Call(n, no_ty, margs)
}

const mono_expr = (*MonoCtx m, Expr e, MonoEnv env): Expr -> match e {
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	Expr.Var(n) -> Expr.Var(n),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(mangle_type(m, n, env.tvars, env.tvals), mono_fields(m, fs, env)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(mono_expr(m, b, env), f),
	Expr.UnionMk(t, mem, args) -> Expr.UnionMk(mangle_type(m, t, env.tvars, env.tvals), mem, mono_exprs(m, args, env)),
	Expr.Match(scrut, arms) -> mono_match(m, scrut, arms, env),
	Expr.ArrayLit(hs, sn, elems, et) -> Expr.ArrayLit(hs, mono_expr(m, sn, env), mono_exprs(m, elems, env), et),
	Expr.Index(a, i) -> Expr.Index(a, mono_expr(m, i, env)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, mono_expr(m, i, env), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(mono_expr(m, b, env), mono_expr(m, i, env)),
	Expr.Tuple(elems) -> Expr.Tuple(mono_exprs(m, elems, env)),
	Expr.Spread(x) -> Expr.Spread(mono_expr(m, x, env)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(mono_stmts(m, body, env)),
	Expr.Interp(segs) -> Expr.Interp(mono_segs(m, segs, env)),
	Expr.Buffer(n) -> Expr.Buffer(n),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(mono_expr(m, x, env)),
	Expr.Not(x) -> Expr.Not(mono_expr(m, x, env)),
	Expr.BitNot(x) -> Expr.BitNot(mono_expr(m, x, env)),
	Expr.Add(l, r) -> Expr.Add(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.Sub(l, r) -> Expr.Sub(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.Mul(l, r) -> Expr.Mul(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.Div(l, r) -> Expr.Div(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.Mod(l, r) -> Expr.Mod(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.BitOr(l, r) -> Expr.BitOr(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.BitXor(l, r) -> Expr.BitXor(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.Shl(l, r) -> Expr.Shl(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.Shr(l, r) -> Expr.Shr(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.And(l, r) -> Expr.And(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.Or(l, r) -> Expr.Or(mono_expr(m, l, env), mono_expr(m, r, env)),
	Expr.If(c, t, e2) -> Expr.If(mono_expr(m, c, env), mono_expr(m, t, env), mono_expr(m, e2, env)),
	Expr.Call(n, ta, args) -> mono_call(m, n, ta, args, env)
}

const mono_exprs = (*MonoCtx m, [Expr] es, MonoEnv env): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		out = [...out, mono_expr(m, es[i], env)]
		i = i + 1
	}
	return out
}
const mono_fields = (*MonoCtx m, [FieldInit] fs, MonoEnv env): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: mono_expr(m, fs[i].value, env) })]
		i = i + 1
	}
	return out
}
const mono_segs = (*MonoCtx m, [Seg] segs, MonoEnv env): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(segs.len) then break
		const Seg sg = segs[i]
		out = [...out, Seg({ is_hole: sg.is_hole, lit: sg.lit, name: sg.name, expr: mono_expr(m, sg.expr, env) })]
		i = i + 1
	}
	return out
}
# The concrete union a match arm names: an explicitly-qualified `Maybe[Iarch]` is mangled; an
# unqualified `Maybe` on a generic union takes the SCRUTINEE's concrete instance type — itself
# mangled, since the scrutinee type may still be a raw application `Maybe[Iarch]` (a UnionMk or
# unannotated-`let` scrutinee) rather than an already-mangled `Maybe$Iarch` (a parameter); every
# other (a non-generic union, or a `_`) is unchanged.
const arm_type = (*MonoCtx m, Str tn, Str scrut_ty, MonoEnv env): Str -> {
	if str_eq(tn, "") then return tn
	if is_type_app(tn) then return mangle_type(m, tn, env.tvars, env.tvals)
	if find_union_template(m.union_templates, tn) >= 0 then {
		const Str st = mangle_type(m, scrut_ty, env.tvars, env.tvals)
		# the scrutinee's concrete instance is read shallowly (a parameter, or a `let` / literal
		# construction); a scrutinee whose type is not yet inferable — e.g. a direct call result —
		# has no concrete instance to name the arm with, so bind it to an annotated `let` first
		if str_eq(st, "") then die("cf0: type: cannot infer a generic-union match scrutinee's type; bind it to a typed `let` first\n")
		return st
	}
	return tn
}
const mono_arms = (*MonoCtx m, [MatchArm] arms, MonoEnv env, Str scrut_ty): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [...out, MatchArm({ is_wild: a.is_wild, type_name: arm_type(m, a.type_name, scrut_ty, env), members: a.members, binds: a.binds, body: mono_expr(m, a.body, env) })]
		i = i + 1
	}
	return out
}
const mono_match = (*MonoCtx m, Expr scrut, [MatchArm] arms, MonoEnv env): Expr -> {
	const Str st = arg_ty(m, scrut, env)
	return Expr.Match(mono_expr(m, scrut, env), mono_arms(m, arms, env, st))
}

const mono_stmt = (*MonoCtx m, Stmt s, MonoEnv env): Stmt -> match s {
	Stmt.Let(n, mut, ann, e) -> Stmt.Let(n, mut, mangle_type(m, ann, env.tvars, env.tvals), mono_expr(m, e, env)),
	Stmt.Destructure(pat, mut, e) -> Stmt.Destructure(pat, mut, mono_expr(m, e, env)),
	Stmt.Yield(e) -> Stmt.Yield(mono_expr(m, e, env)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, mono_expr(m, e, env)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, mono_expr(m, e, env)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, mono_expr(m, i, env), mono_expr(m, v, env)),
	Stmt.Return(e) -> Stmt.Return(mono_expr(m, e, env)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, mono_stmts(m, body, env)),
	Stmt.Loop(body) -> Stmt.Loop(mono_stmts(m, body, env)),
	Stmt.Break -> Stmt.Break,
	Stmt.Continue -> Stmt.Continue,
	Stmt.IfThen(c, st) -> Stmt.IfThen(mono_expr(m, c, env), mono_stmt(m, st, env)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(mono_expr(m, c, env), mono_stmt(m, t, env), mono_stmt(m, e, env)),
	Stmt.Do(e) -> Stmt.Do(mono_expr(m, e, env)),
	Stmt.Block(stmts) -> Stmt.Block(mono_stmts(m, stmts, env)),
	Stmt.Match(scrut, arms) -> mono_stmt_match(m, scrut, arms, env)
}
const mono_stmt_arms = (*MonoCtx m, [StmtArm] arms, MonoEnv env, Str scrut_ty): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [...out, StmtArm({ is_wild: a.is_wild, type_name: arm_type(m, a.type_name, scrut_ty, env), members: a.members, binds: a.binds, body: mono_stmts(m, a.body, env) })]
		i = i + 1
	}
	return out
}
const mono_stmt_match = (*MonoCtx m, Expr scrut, [StmtArm] arms, MonoEnv env): Stmt -> {
	const Str st = arg_ty(m, scrut, env)
	return Stmt.Match(mono_expr(m, scrut, env), mono_stmt_arms(m, arms, env, st))
}
# The binding type recorded for a `let`: its (substituted) annotation, or — with no annotation
# — the shallow type inferred from the initializer.
const let_binding_ty = (*MonoCtx m, Str ann, Expr e, MonoEnv env): Str -> {
	const Str bt = mangle_type(m, ann, env.tvars, env.tvals)
	if !str_eq(bt, "") then return bt
	return arg_ty(m, e, env)
}
const mono_extend = (*MonoCtx m, Stmt s, MonoEnv env): MonoEnv -> match s {
	Stmt.Let(n, mut, ann, e) -> env_add(env, n, let_binding_ty(m, ann, e, env)),
	_ -> env
}
const mono_stmts = (*MonoCtx m, [Stmt] ss, MonoEnv env0): [Stmt] -> {
	let MonoEnv env = env0
	let [Stmt] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		const Stmt s = ss[i]
		out = [...out, mono_stmt(m, s, env)]
		env = mono_extend(m, s, env)  # a `let` extends the env for the statements after it
		i = i + 1
	}
	return out
}

# Whether every type variable mentioned in a type reference (a bare `'X` or the arguments of a
# generic application) is among `typarams` — used to reject a generic declaration's field/payload
# type that names an undeclared type variable.
const typevar_declared = (Str name, [Str] typarams): Bool -> {
	if is_type_app(name) then {
		const [Str] args = type_args(name)
		let Iarch i = 0
		loop {
			if i >= Iarch(args.len) then break
			if !typevar_declared(args[i], typarams) then return false
			i = i + 1
		}
		return true
	}
	if Iarch(name.len) == 0 then return true
	if Iarch(name[0]) != 39 then return true
	let Iarch j = 0
	loop {
		if j >= Iarch(typarams.len) then break
		if str_eq(typarams[j], name) then return true
		j = j + 1
	}
	return false
}
const check_rec_templates = (*MonoCtx m): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(m.rec_templates.len) then break
		const RecDecl r = m.rec_templates[i]
		let Iarch f = 0
		loop {
			if f >= Iarch(r.ftypes.len) then break
			if !typevar_declared(r.ftypes[f], r.typarams) then die("cf0: type: an undeclared type variable in a generic record field\n")
			f = f + 1
		}
		i = i + 1
	}
	return 0
}
const check_union_templates = (*MonoCtx m): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(m.union_templates.len) then break
		const UnionDecl un = m.union_templates[i]
		let Iarch mi = 0
		loop {
			if mi >= Iarch(un.members.len) then break
			let Iarch pj = 0
			loop {
				if pj >= Iarch(un.members[mi].payloads.len) then break
				if !typevar_declared(un.members[mi].payloads[pj], un.typarams) then die("cf0: type: an undeclared type variable in a generic union payload\n")
				pj = pj + 1
			}
			mi = mi + 1
		}
		i = i + 1
	}
	return 0
}

# Monomorphize the program: drop the generic templates, rewrite every concrete function's body
# (registering the instances its generic calls need, transitively), then append all generated
# concrete instances. The result has no generic functions.
pub const mono_program = (Program prog): Program -> {
	let [Func] templates = []
	let [Func] concrete = []
	let Iarch i = 0
	loop {
		if i >= Iarch(prog.funcs.len) then break
		if Iarch(prog.funcs[i].typarams.len) > 0 then templates = [...templates, prog.funcs[i]]
		else concrete = [...concrete, prog.funcs[i]]
		i = i + 1
	}
	let [Str] unames = []
	let Iarch u = 0
	loop {
		if u >= Iarch(prog.unions.len) then break
		unames = [...unames, prog.unions[u].name]
		u = u + 1
	}
	# split generic RECORD templates from the concrete records the output keeps
	let [RecDecl] rec_templates = []
	let [RecDecl] concrete_recs = []
	let Iarch ri = 0
	loop {
		if ri >= Iarch(prog.recs.len) then break
		if Iarch(prog.recs[ri].typarams.len) > 0 then rec_templates = [...rec_templates, prog.recs[ri]]
		else concrete_recs = [...concrete_recs, prog.recs[ri]]
		ri = ri + 1
	}
	# and generic UNION templates from the concrete unions
	let [UnionDecl] union_templates = []
	let [UnionDecl] concrete_unions = []
	let Iarch vi = 0
	loop {
		if vi >= Iarch(prog.unions.len) then break
		if Iarch(prog.unions[vi].typarams.len) > 0 then union_templates = [...union_templates, prog.unions[vi]]
		else concrete_unions = [...concrete_unions, prog.unions[vi]]
		vi = vi + 1
	}
	let [Func] no_inst = []
	let [Str] no_keys = []
	let [RecDecl] no_recinst = []
	let [Str] no_tk = []
	let [UnionDecl] no_uni = []
	let MonoCtx m = MonoCtx({ templates: templates, keys: no_keys, instances: no_inst, unions: unames, rec_templates: rec_templates, type_keys: no_tk, rec_instances: no_recinst, union_templates: union_templates, union_instances: no_uni })
	# reject a generic record/union template whose field/payload names an undeclared type variable
	check_rec_templates(&m)
	check_union_templates(&m)
	const [Str] no_tv = []
	let [Func] out = []
	let Iarch j = 0
	loop {
		if j >= Iarch(concrete.len) then break
		out = [...out, mono_func(&m, concrete[j], concrete[j].name, no_tv, no_tv)]
		j = j + 1
	}
	let Iarch k = 0
	loop {
		if k >= Iarch(m.instances.len) then break
		out = [...out, m.instances[k]]
		k = k + 1
	}
	# the output records: the concrete ones plus every generated generic-record instance
	let [RecDecl] out_recs = concrete_recs
	let Iarch g = 0
	loop {
		if g >= Iarch(m.rec_instances.len) then break
		out_recs = [...out_recs, m.rec_instances[g]]
		g = g + 1
	}
	# the output unions: the concrete ones plus every generated generic-union instance
	let [UnionDecl] out_unions = concrete_unions
	let Iarch h = 0
	loop {
		if h >= Iarch(m.union_instances.len) then break
		out_unions = [...out_unions, m.union_instances[h]]
		h = h + 1
	}
	return Program({ imports: prog.imports, recs: out_recs, unions: out_unions, funcs: out })
}
