# cf — the self-hosted C! compiler (the KEEPER), entry point.
#
# This is the compiler cf's genesis produces and then reproduces: seed-subset
# C! source, compiled during bootstrap by the throwaway `cfcc` genesis tool, and
# eventually by itself. It runs the same pipeline the ratified specs pin —
# lex, parse, (typecheck, …), emit — degenerately (seed_subset §5).
#
# Tracer-bullet scope: read a `.cf` file, parse `[pub] const main = () -> <int>`,
# and emit QBE IL + an asm floor that an external driver assembles into a running
# darwin/arm64 binary. Everything past `main`'s constant exit code fills in as the
# front end grows. cf cannot yet spawn `qbe`/`cc`, so it stops at emitting text
# to two output paths; the driver runs the `qbe`→`cc` tail.
#
#   cf <input.cf> <out.qbe> <out.s>

import "io" as { open, close, die, o_wronly_creat_trunc, mode_644 }
import "cli" as { Cli, cli_parse, str_eq }
import "ast" as { Program }
import "resolve" as { resolve_program! }
import "monomorph" as { mono_program! }
import "typecheck" as { check_program! }
import "alloc" as { check_alloc_program!, check_root_program! }
import "hoist_defertap" as { hoist_defertaps! }
import "defer" as { lower_defers! }
import "closures" as { lift_program! }
import "routing" as { routing_check!, routing_dump! }
import "emit" as { emit_program! }

pub const main = ([Str] args) -> {
	# cf runs its whole compilation under ONE elastic arena grafted from the root page (memory_model
	# §2, §4): main itself holds no residue on the root, and every allocating pass runs `in a`, so the
	# AST, the instances, and the emitted text all live in `a`. The arena grows from the page as needed
	# (16 MiB initial), and is reclaimed wholesale at process exit — the compiler's own geometry.
	const a = mem.arena.grow(16777216)
	const Cli c = cli_parse(args) in a

	# front end: resolve the entry module and its transitive imports (lexing and parsing
	# each) into one flattened AST — module_system §8
	const Str inp = c.input
	const Program raw = resolve_program!(inp, c.target_os, c.target_arch) in a

	# the `!` allocation algebra, checked both ways (memory_model §5) — UNCONDITIONAL: the whole
	# tree (compiler + lib + corpus) is colored, so there is no flag. Run PRE-mono so the color is
	# per SOURCE function (a generic that may allocate in any instantiation is `!` once).
	check_alloc_program!(raw) in a

	# root-allocation validation (memory_model §2): reject residue placed on the ROOT page —
	# UNCONDITIONAL, no flag. Every program must run its allocating work `in` some arena; only the
	# entry floor (cf_build_args, pre-main) may touch the page. In ZERO-ROOT mode (`--root-size 0` on
	# `Bare`), the rule tightens to reject ANY page use at all — direct residue in `main` and arena
	# grafts alike — so the binary provably never dynamically allocates.
	const Bool zero_root = str_eq(c.target_os, "Bare") && c.root_size == 0
	check_root_program!(raw, zero_root) in a

	# monomorphize generic functions into concrete instances (type_system §8.1) — after this
	# the program has no generic templates, only ordinary functions
	const Program prog = mono_program!(raw) in a

	# middle: typecheck (rejects type errors before any output is produced)
	check_program!(prog) in a

	# lift `defer`-tap VALUES (`defer f(x)` / `|> defer f`) out of expression position into a
	# snapshot binding + a scheduled `defer` statement (memory_model §6) — before lower_defers, so
	# the emitted `Stmt.Defer`s are lowered like any other
	const Program tapped = hoist_defertaps!(prog) in a

	# lower `defer` to explicit scope-exit code (memory_model §6): rewrite each `return e` in a
	# defer-bearing function to snapshot the value, run the pending defers (LIFO), then return —
	# before the closure lift, so a `defer f()` calling a local closure is a plain call site
	const Program deferred = lower_defers!(tapped) in a

	# lower local closures to top-level functions with hidden capture parameters (memory_model
	# §7) — after typecheck (which validated them), before emit
	const Program lowered = lift_program!(deferred) in a

	# the SHADOW routing analysis for the duplex arena (geometry_lowering §2-§3): compute each
	# lowered function's full escape/alias sets and cross-check them against the `!`-oracle —
	# every oracle-escaping name must escape here too. Drives no codegen yet; the divergence
	# check makes every compile of the whole tree exercise the analysis the duplex router will
	# trust. `--dump-routing` prints the sets (temporary inspection hatch).
	routing_check!(lowered) in a
	if c.dump_routing then routing_dump!(lowered) in a

	# back end: emit QBE IL + the asm floor to the two output paths
	const Str oq = c.out_qbe
	const Iarch qf = open(oq.bytes, Uarch(o_wronly_creat_trunc), Uarch(mode_644))
	if qf < 0 then die("cf: cannot create the QBE output\n")
	const Str oa = c.out_asm
	const Iarch af = open(oa.bytes, Uarch(o_wronly_creat_trunc), Uarch(mode_644))
	if af < 0 then die("cf: cannot create the asm output\n")
	emit_program!(lowered, Uarch(qf), Uarch(af), c.target_os, c.root_size) in a
	close(Uarch(qf))
	close(Uarch(af))
	return 0
}
