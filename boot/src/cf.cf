# cf — the self-hosted C! compiler (the KEEPER), entry point.
#
# This is the compiler cf's genesis produces and then reproduces: seed-subset
# C! source, compiled during bootstrap by the throwaway `cfcc` genesis tool, and
# eventually by itself. It runs the same pipeline the ratified specs pin —
# lex, parse, (typecheck, ...), emit — degenerately (seed_subset §5).
#
# Tracer-bullet scope: read a `.cf` file, parse `[pub] const main = () -> <int>`,
# and emit QBE IL + an asm floor that an external driver assembles into a running
# darwin/arm64 binary. Everything past `main`'s constant exit code fills in as the
# front end grows. cf cannot yet spawn `qbe`/`cc`, so it stops at emitting text
# to two output paths; the driver runs the `qbe`→`cc` tail.
#
#   cf <input.cf> <out.qbe> <out.s>

import std::str::{ eq }
import cli::{ Cli, cli_parse, FmtCli, is_fmt_cmd, fmt_cli_parse }
import fmt::{ format_file! }
import docs::{ docs_run! }
import std::compiler::{ compile! }
import std::mem::arena::growing_arena

pub const main = ([Str] args) -> {
	# `cf format`/`cf f` is a separate subcommand — it formats source, not compiles it, so it
	# branches off before the whole compile pipeline. Everything else (a flag or a path as the
	# first argument) stays the legacy positional compile call the bootstrap driver depends on.
	if is_fmt_cmd(args) then {
		const fa = growing_arena::of(16777216)
		const FmtCli fc = fmt_cli_parse(args) in fa

		return format_file!(fc.path, fc.check) in fa
	}

	# `cf docs [<term>]` — browse the standard-library API interactively (docs.cf).
	if Iarch(args.len) >= 2 && eq(args[1], "docs") then {
		const doca = growing_arena::of(16777216)

		return docs_run!(args) in doca
	}

	# cf runs its whole compilation under ONE growing arena grafted from the root page (memory_model
	# §2, §4): main itself holds no residue on the root, and the pipeline runs `in a`, so the AST, the
	# instances, and the emitted text all live in `a`. The arena grows from the page as needed (16 MiB
	# initial), and is reclaimed wholesale at process exit — the compiler's own geometry. The pipeline
	# itself is `std::compiler::compile!`; main only parses the command line and hands it the arena.
	const a = growing_arena::of(16777216)
	const Cli c = cli_parse(args) in a

	return compile!(
		c.input,
		c.out_qbe,
		c.out_asm,
		c.target_os,
		c.target_arch,
		c.root_size,
		c.dump_routing,
	) in a
}
