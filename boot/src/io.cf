# io — the syscall floor for cf0.
#
# cf0 is a freestanding darwin/arm64 binary (its own compiler emits `-nostdlib`
# code), so all I/O bottoms out at raw syscalls through one `asm` trampoline,
# exactly as ebnf § Assembly and seed_subset §3 prescribe. Everything above
# `syscall6` is ordinary C! over that floor.
#
# Value constants are lowercase (an uppercase identifier is a TYPE name in the
# grammar; a `const` value binding is a lowercase name — ebnf § Modules).
#
# ⚠ THROWAWAY vs the real cf std: the ratified std wraps these in typed,
# geometry-aware IO; cf0's genesis floor returns bare Iarch and takes raw
# `Uarch`/byte-pointer operands. Fine for a self-hosting seed.

# The one primitive: BSD syscall number in x16, args in x0..x5, `svc #0x80`.
# darwin returns the result in x0 (negative on error). num FIRST, per
# parameter_order.md / ebnf § Assembly.
pub const syscall6 = (Uarch num, Uarch a0, Uarch a1, Uarch a2, Uarch a3, Uarch a4, Uarch a5): Iarch -> asm "
	mov x16, ${num}
	mov x0, ${a0}
	mov x1, ${a1}
	mov x2, ${a2}
	mov x3, ${a3}
	mov x4, ${a4}
	mov x5, ${a5}
	svc #0x80
	ret
"

# darwin BSD syscall numbers used by cf0's floor.
pub const sys_read = 3
pub const sys_write = 4
pub const sys_open = 5
pub const sys_close = 6

# open() flags/mode. Reading: O_RDONLY = 0. Writing a fresh output file:
# O_WRONLY|O_CREAT|O_TRUNC (darwin 1|0x200|0x400 = 1537), mode 0644 = 420.
pub const o_rdonly = 0
pub const o_wronly_creat_trunc = 1537
pub const mode_644 = 420

# Standard file descriptors.
pub const stdout = 1
pub const stderr = 2

pub const open = (Uarch path, Uarch flags, Uarch mode): Iarch -> syscall6(Uarch(sys_open), path, flags, mode, 0, 0, 0)

pub const read = (Uarch fd, Uarch buf, Uarch n): Iarch -> syscall6(Uarch(sys_read), fd, buf, n, 0, 0, 0)

pub const write = (Uarch fd, Uarch buf, Uarch n): Iarch -> syscall6(Uarch(sys_write), fd, buf, n, 0, 0, 0)

pub const close = (Uarch fd): Iarch -> syscall6(Uarch(sys_close), fd, 0, 0, 0, 0, 0)

# exit() — terminates the process with `code`. Never returns; the `: Iarch` is
# nominal (the svc leaves, so the trailing value is unreachable). cf0's `main`
# return also exits, via `_start`; this is for mid-run aborts (a compile error).
pub const exit = (Iarch code): Iarch -> asm "
	mov x0, ${code}
	mov x16, #1
	svc #0x80
	ret
"

# --- text output over `write` ------------------------------------------------

# Write a whole Str to a file descriptor.
pub const write_str = (Uarch fd, Str s): Iarch -> write(fd, s.bytes, Uarch(s.len))

# Print a Str to stderr (diagnostics).
pub const eprint = (Str s): Iarch -> write_str(Uarch(stderr), s)

# Print a diagnostic and abort with exit code 1 (a cf0 compile error). Never
# returns; the trailing `return exit(1)` satisfies the value-return rule (exit
# leaves the process, so the returned value is never produced).
pub const die = (Str msg): Iarch -> {
	eprint(msg)
	return exit(1)
}
