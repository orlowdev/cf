# docs — the interactive `cf docs` browser.
#
# Three modes over the definitions `docscan` reads live from the standard library. SEARCH: type to
# filter, the matches ranked by a fuzzy score. SELECTION: move the highlight with the arrows or j/k.
# READ: the selected definition's signature and doc comment. Enter/esc/arrows move between modes;
# `i`/`s` jump back to search, `r` resets the query, Ctrl-C exits (restoring the terminal first).
import docscan::{ Def, scan_std!, split_lines }
import std::str::{ fuzzy_score, no_match, eq }
import std::io::term::{
	raw_mode!,
	restore,
	read_key,
	size!,
	clear!,
	hide_cursor!,
	show_cursor!,
	reverse!,
	reset!,
	move_to!,
	TermSize,
	key_up,
	key_down,
	key_enter,
	key_esc,
	key_eof,
}
import std::io::console::{ print, println }

pub const mode_search = 0
pub const mode_select = 1
pub const mode_read = 2

# The keymap legend for each mode, shown at the bottom of the window (the keys really do differ by
# mode — j/k type in search, esc has nothing to go back to there).
const legend_search = "[type] filter   [down/enter] select   [ctrl-c] quit"
const legend_select = "[j/k up/dn] move   [enter] read   [i/esc] search   [r] reset   [ctrl-c] quit"
const legend_read = "[j/k up/dn] scroll   [esc] back   [i] search   [r] reset   [ctrl-c] quit"

const legend_for = (Iarch mode): Str -> {
	if mode == mode_search then return legend_search
	if mode == mode_select then return legend_select

	return legend_read
}

# The browser state: every definition, the current query, the mode, the highlighted row (an index
# into the filtered view), and the read-view scroll offset (top line shown, 0 in the list modes).
data DocState = { [Def] all, Str query, Iarch mode, Iarch sel, Iarch scroll }

# Append the byte `b` to `s` as a character (interpolation would render a byte as a decimal number).
const append_char = (Str s, Iarch b): Str -> {
	let [Uint8] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break

		out = [...out, Uint8(Iarch(s[i]))]
		i = i + 1
	}

	out = [...out, Uint8(b)]

	return Str({ bytes: out, len: Iarch(out.len) })
}

# The signature up to (not including) its body — everything before the last ` ->`. A `data`/`union`
# line has no `->`, so it is returned whole.
const sig_head = (Str sig): Str -> {
	let Iarch cut = 0 - 1
	let Iarch i = 0

	loop {
		if i + 2 >= Iarch(sig.len) then break

		if Iarch(sig[i]) == 32 && Iarch(sig[i + 1]) == 45 && Iarch(sig[i + 2]) == 62 then cut = i

		i = i + 1
	}

	if cut < 0 then return sig

	let [Uint8] out = []
	let Iarch j = 0

	loop {
		if j >= cut then break

		out = [...out, Uint8(Iarch(sig[j]))]
		j = j + 1
	}

	return Str({ bytes: out, len: Iarch(out.len) })
}

# Drop the last character of `s` (backspace).
const drop_last = (Str s): Str -> {
	if Iarch(s.len) == 0 then return s

	let [Uint8] out = []
	let Iarch i = 0
	const Iarch keep = Iarch(s.len) - 1

	loop {
		if i >= keep then break

		out = [...out, Uint8(Iarch(s[i]))]
		i = i + 1
	}

	return Str({ bytes: out, len: Iarch(out.len) })
}

# The filtered, ranked view of `all` for `query`: every definition whose name fuzzy-matches, ordered
# by score descending (a selection sort — the corpus is small). An empty query lists everything.
const ranked! = ([Def] all, Str query): [Def] -> {
	if Iarch(query.len) == 0 then return all

	let [Bool] used = []
	let Iarch z = 0

	loop {
		if z >= Iarch(all.len) then break

		used = [...used, false]
		z = z + 1
	}

	let [Def] out = []

	loop {
		let Iarch best = 0 - 1
		let Iarch best_score = no_match
		let Iarch i = 0

		loop {
			if i >= Iarch(all.len) then break

			if !used[i] then {
				const Iarch sc = fuzzy_score(query, all[i].name)

				if sc > no_match && sc > best_score then {
					best_score = sc
					best = i
				}
			}

			i = i + 1
		}

		if best < 0 then break

		used[best] = true
		out = [...out, all[best]]
	}

	return out
}

# Is `q` the exact name of some definition?
const has_exact = ([Def] all, Str q): Bool -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(all.len) then break
		if eq(all[i].name, q) then return true

		i = i + 1
	}

	return false
}

# --- rendering ---------------------------------------------------------------

# The visible rows for a list, given the terminal height (a sane default off a real terminal).
const visible_rows = (Iarch rows): Iarch -> if rows > 8 then rows - 5 else 20

# The content lines of a definition's read view — the man-style NAME / SYNOPSIS / DESCRIPTION layout,
# the doc split into its own lines. Shared by the renderer and the scroll clamp so both measure the
# same height.
const read_body = (Def d): [Str] -> {
	let [Str] body = []

	body = [...body, "${d.kind} ${d.name}"]
	body = [...body, d.module]
	body = [...body, ""]
	body = [...body, "SYNOPSIS"]
	body = [...body, ""]
	body = [...body, sig_head(d.sig)]
	body = [...body, ""]
	body = [...body, "DESCRIPTION"]
	body = [...body, ""]

	if Iarch(d.doc.len) == 0 then body = [...body, "empty"] else {
		const [Str] dl = split_lines(d.doc)

		for line in dl {
			body = [...body, line]
		}
	}

	return body
}

# The content rows available above the legend (a default off a real terminal).
const read_vis = (Iarch rows): Iarch -> if rows > 2 then rows - 1 else 200

# The furthest the read view can scroll: the body height minus the window (0 when it all fits).
const read_max_scroll = (Def d, Iarch rows): Iarch -> {
	const Iarch h = Iarch(read_body(d).len)
	const Iarch vis = read_vis(rows)

	if h > vis then return h - vis

	return 0
}

const render_read! = (DocState st, [Def] view, Iarch rows): () -> {
	if Iarch(view.len) == 0 then {
		println("(no definition)")

		return ()
	}

	let Iarch idx = st.sel

	if idx >= Iarch(view.len) then idx = Iarch(view.len) - 1
	if idx < 0 then idx = 0

	const Def d = view[idx]
	const [Str] body = read_body(d)
	const Iarch vis = read_vis(rows)

	# clamp the scroll offset to a valid window
	let Iarch top = st.scroll
	const Iarch maxs = read_max_scroll(d, rows)

	if top > maxs then top = maxs
	if top < 0 then top = 0

	# render body[top .. top+vis]; the last visible row flags any lines still below
	let Iarch i = top
	let Iarch shown = 0

	loop {
		if i >= Iarch(body.len) then break
		if shown >= vis then break

		if shown == vis - 1 && i < Iarch(body.len) - 1 then println("  ... (${Iarch(body.len) - i} more — j/k to scroll)")
			else println(body[i])

		i = i + 1
		shown = shown + 1
	}

	return ()
}

const render_list! = (DocState st, [Def] view, Iarch rows): () -> {
	if st.mode == mode_search then println("cf docs  [search]") else println("cf docs  [select]")

	if st.mode == mode_search then print("/ ") else print("  ")

	print(st.query)

	if st.mode == mode_search then print("_")

	println("")
	println("")

	if Iarch(view.len) == 0 then {
		println("  (no matches)")

		return ()
	}

	const Iarch maxvis = visible_rows(rows)
	let Iarch start = 0

	if st.sel >= maxvis then start = st.sel - maxvis + 1

	let Iarch i = start
	let Iarch shown = 0

	loop {
		if i >= Iarch(view.len) then break
		if shown >= maxvis then break

		const Def d = view[i]

		if st.mode == mode_select && i == st.sel then {
			reverse!()
			println("> ${d.kind} ${d.name}   ${d.module}")
			reset!()
		} else {
			println("  ${d.kind} ${d.name}   ${d.module}")
		}

		i = i + 1
		shown = shown + 1
	}

	return ()
}

const render! = (DocState st, [Def] view, Iarch rows): () -> {
	clear!()

	if st.mode == mode_read then render_read!(st, view, rows) else render_list!(st, view, rows)

	# the mode's keymap legend, pinned to the bottom row in reverse video (a status bar) — off a real
	# terminal (rows 0) it just follows the content
	if rows >= 2 then move_to!(rows, 1)

	reverse!()
	print(legend_for(st.mode))
	reset!()

	return ()
}

# --- key dispatch (each returns the next state) ------------------------------

# The Enter key is CR (13) on a raw terminal, but a terminal's ICRNL maps it to LF (10) on input;
# accept either.
const is_enter = (Iarch key): Bool -> key == key_enter || key == 10

const dispatch_search = (DocState st, Iarch key): DocState -> {
	# enter or an arrow moves into the list; esc does nothing here (search is the root)
	if is_enter(key) || key == key_up || key == key_down
		then return DocState({ all: st.all, query: st.query, mode: mode_select, sel: 0, scroll: 0 })

	if key == 127 || key == 8
		then return DocState({ all: st.all, query: drop_last(st.query), mode: mode_search, sel: 0, scroll: 0 })

	if key >= 32 && key <= 126
		then return DocState({ all: st.all, query: append_char(st.query, key), mode: mode_search, sel: 0, scroll: 0 })

	return st
}

const dispatch_select = (DocState st, Iarch key, Iarch viewlen): DocState -> {
	if key == key_up || key == 107 then {
		let Iarch ns = st.sel - 1

		if ns < 0 then ns = 0

		return DocState({ all: st.all, query: st.query, mode: mode_select, sel: ns, scroll: 0 })
	}

	if key == key_down || key == 106 then {
		let Iarch ns = st.sel + 1

		if ns >= viewlen then ns = viewlen - 1
		if ns < 0 then ns = 0

		return DocState({ all: st.all, query: st.query, mode: mode_select, sel: ns, scroll: 0 })
	}

	if is_enter(key) then return DocState({ all: st.all, query: st.query, mode: mode_read, sel: st.sel, scroll: 0 })
	if key == 105 || key == 115 then return DocState({ all: st.all, query: st.query, mode: mode_search, sel: 0, scroll: 0 })
	if key == 114 then return DocState({ all: st.all, query: "", mode: mode_search, sel: 0, scroll: 0 })
	if key == key_esc then return DocState({ all: st.all, query: st.query, mode: mode_search, sel: 0, scroll: 0 })

	return st
}

const dispatch_read = (DocState st, Iarch key, Iarch maxscroll): DocState -> {
	if key == key_esc then return DocState({ all: st.all, query: st.query, mode: mode_select, sel: st.sel, scroll: 0 })
	if key == 105 || key == 115 then return DocState({ all: st.all, query: st.query, mode: mode_search, sel: st.sel, scroll: 0 })
	if key == 114 then return DocState({ all: st.all, query: "", mode: mode_search, sel: 0, scroll: 0 })

	if key == key_down || key == 106 then {
		let Iarch ns = st.scroll + 1

		if ns > maxscroll then ns = maxscroll

		return DocState({ all: st.all, query: st.query, mode: mode_read, sel: st.sel, scroll: ns })
	}

	if key == key_up || key == 107 then {
		let Iarch ns = st.scroll - 1

		if ns < 0 then ns = 0

		return DocState({ all: st.all, query: st.query, mode: mode_read, sel: st.sel, scroll: ns })
	}

	return st
}

const dispatch = (DocState st, Iarch key, Iarch viewlen, Iarch maxscroll): DocState -> {
	if st.mode == mode_search then return dispatch_search(st, key)
	if st.mode == mode_select then return dispatch_select(st, key, viewlen)

	return dispatch_read(st, key, maxscroll)
}

# The browser. `args` is the whole command line — `cf docs [<term>]`; a `<term>` prefills the query,
# and an exact name opens READ mode on it directly. Runs until Ctrl-C (byte 3) or end of input.
pub const docs_run! = ([Str] args): Iarch -> {
	const [Def] all = scan_std!()
	let Str q0 = ""
	let Iarch mode0 = mode_search

	if Iarch(args.len) >= 3 then {
		q0 = args[2]

		if has_exact(all, q0) then mode0 = mode_read
	}

	let DocState st = DocState({ all: all, query: q0, mode: mode0, sel: 0, scroll: 0 })
	let [72 Uint8] tio
	let [64 Uint8] kdata
	let [2 Uint8] kmeta = [0, 0]

	raw_mode!(tio)
	hide_cursor!()

	loop {
		const [Def] view = ranked!(st.all, st.query)
		const TermSize sz = size!()

		render!(st, view, sz.rows)

		const Iarch key = read_key(kdata, kmeta, Uarch(64))

		if key == 3 || key == key_eof then break

		# in read mode, tell the dispatcher how far the current definition can scroll
		let Iarch maxscroll = 0

		if st.mode == mode_read && Iarch(view.len) > 0 then {
			let Iarch ri = st.sel

			if ri >= Iarch(view.len) then ri = Iarch(view.len) - 1
			if ri < 0 then ri = 0

			maxscroll = read_max_scroll(view[ri], sz.rows)
		}

		st = dispatch(st, key, Iarch(view.len), maxscroll)
	}

	show_cursor!()
	clear!()
	restore(tio)

	return 0
}
