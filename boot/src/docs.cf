# docs — the interactive `cf docs` browser: entry point and event loop.
#
# Three modes over the definitions `docscan` reads live from the standard library. SEARCH: type to
# filter, the matches ranked by a fuzzy score. SELECTION: move the highlight with the arrows or j/k.
# READ: the selected definition's man-style page. Enter/esc/arrows move between modes; `i`/`s` jump
# back to search, `r` resets the query, Ctrl-C exits (restoring the terminal first).
#
# The browser is split across `docs/`:
#   state    — the `DocState` model + mode constants
#   synopsis — parse a definition's signature into structured synopsis pieces
#   text     — word-wrap, doc-comment Markdown, padding, query editing
#   search   — fuzzy-filter the corpus (`ranked!`, `has_exact`)
#   page     — build a definition's read-view body + its scroll geometry
#   render   — draw a frame (list / read page / status bar)
#   keys     — turn a keystroke into the next `DocState`
# This file only wires them into the read → key → dispatch loop.
import docscan::{ Def, scan_std! }
import docs::state::{ DocState, mode_search, mode_read }
import docs::search::{ ranked!, has_exact }
import docs::page::{ read_max_scroll! }
import docs::render::{ render! }
import docs::keys::{ dispatch }
import std::io::term::{
	raw_mode!,
	restore,
	read_key,
	size!,
	clear!,
	hide_cursor!,
	show_cursor!,
	TermSize,
	key_eof,
}

# The browser. `args` is the whole command line — `cf docs [<term>]`; a `<term>` prefills the query,
# and an exact name opens READ mode on it directly. Runs until Ctrl-C (byte 3) or end of input.
pub const docs_run! = ([Str] args): Iarch -> {
	const [Def] all = scan_std!()
	let Str q0 = ""
	let Iarch mode0 = mode_search

	if Iarch(args.len) >= 3 then {
		q0 = args[2]

		if has_exact(all, q0) then mode0 = mode_read
	}

	let DocState st = DocState({ all: all, query: q0, mode: mode0, sel: 0, scroll: 0 })
	let [72 Uint8] tio
	let [64 Uint8] kdata
	let [2 Uint8] kmeta = [0, 0]

	raw_mode!(tio)
	hide_cursor!()

	loop {
		const [Def] view = ranked!(st.all, st.query)
		const TermSize sz = size!()
		const Iarch width = if sz.cols > 20 then sz.cols else 80

		render!(st, view, sz.rows, width)

		const Iarch key = read_key(kdata, kmeta, Uarch(64))

		if key == 3 || key == key_eof then break

		# in read mode, tell the dispatcher how far the current definition can scroll
		let Iarch maxscroll = 0

		if st.mode == mode_read && Iarch(view.len) > 0 then {
			let Iarch ri = st.sel

			if ri >= Iarch(view.len) then ri = Iarch(view.len) - 1
			if ri < 0 then ri = 0

			maxscroll = read_max_scroll!(view[ri], sz.rows, width)
		}

		st = dispatch(st, key, Iarch(view.len), maxscroll)
	}

	show_cursor!()
	clear!()
	restore(tio)

	return 0
}
