# emit — the AST to QBE IL + an asm floor.
#
# `emit_expr` walks the expression tree with `match`, writing one QBE
# instruction per interior node and returning the operand (`%tN`, or an inline
# literal) that holds the node's value. A `*Emit` context threads the output fd
# and the temp/label counters; a `[Binding]` environment (a read-only borrow)
# resolves variable references to their stack slots. `emit_program` walks the
# body's statement list and appends the freestanding `_start` floor.
#
# cf0 cannot yet spawn `qbe`/`cc`, so it emits the QBE IL and the arm64 asm floor
# to two file descriptors and the external driver runs the `qbe`→`cc` tail.
#
# ⚠ THROWAWAY codegen — NOT the cf0 `%node`/`%ret` ABI or the real page/arena
# runtime (reintroduced at the M6/M9 representation gate). Integer ops are word
# (`w`) ops; every local is a word stack slot (`alloc4`/`storew`/`loadw`); `/`/`%`
# do not yet apply the §5.6 divide-by-zero guard; `const` vs `let` mutability is
# not yet enforced (that is the typecheck brick).

import "io" as { write_str, die }
import "ast" as { Expr, Stmt, Param, Func, Call, FieldInit, RecLit, RecDecl, UnionMember, UnionDecl, UnionMkE, MatchArm, MatchExpr, Program }

# The emit context: the QBE-IL output fd, the next free temp number, the next free
# basic-block label id, the program's functions (a call resolves its callee — by
# name to a function index — for the `$f<i>` symbol), its record declarations (a
# field read / data literal resolves a field's byte offset), and its union
# declarations (a `Type.member` / `match` resolves a member's tag). `next`/`label`
# reset per function; `funcs`/`recs`/`unions` are constant across the program.
data Emit = { Uarch fd, Iarch next, Iarch label, [Func] funcs, [RecDecl] recs, [UnionDecl] unions }

# A local/parameter in scope: its interned name, the temp holding its stack slot
# pointer, and — for a record local — its record type name (`""` for a word). A word
# slot points to a 4-byte cell (read with `loadw`); a record slot points to the
# record's base (a field is read at base + offset).
data Binding = { Str name, Iarch slot, Str rec_type }

# Byte-wise `Str` equality (variable-name lookup).
const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

# The index of `name`'s binding in `env`, or -1. The typecheck phase has resolved
# every reference, so a hit is guaranteed for well-typed input.
const lookup_index = ([Binding] env, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(env.len) then break
		if str_eq(env[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}

# The index of the record declared as `name`, or -1.
const find_rec = ([RecDecl] recs, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(recs.len) then break
		if str_eq(recs[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}

# The byte offset of field `field` in record type `rt` — its declaration index × 4
# (every field is a 4-byte word). The typecheck phase guarantees both resolve.
const field_offset = ([RecDecl] recs, Str rt, Str field): Iarch -> {
	const Iarch ri = find_rec(recs, rt)
	let Iarch fi = 0
	loop {
		if fi >= Iarch(recs[ri].fields.len) then break
		if str_eq(recs[ri].fields[fi], field) then return fi * 4
		fi = fi + 1
	}
	return 0
}

# The index of the union declared as `name`, or -1; and a member's tag (its index).
const find_union = ([UnionDecl] unions, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(unions.len) then break
		if str_eq(unions[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}
const member_tag = ([UnionDecl] unions, Str type_name, Str member): Iarch -> {
	const Iarch ui = find_union(unions, type_name)
	let Iarch i = 0
	loop {
		if i >= Iarch(unions[ui].members.len) then break
		if str_eq(unions[ui].members[i].name, member) then return i
		i = i + 1
	}
	return 0
}

# Is a union boxed (any member carries a payload)? A boxed union value is a pointer
# to an arena `{tag, payload…}`; a tag-only union value is a bare word tag.
const union_is_boxed = ([UnionDecl] unions, Str name): Bool -> {
	const Iarch ui = find_union(unions, name)
	let Iarch i = 0
	loop {
		if i >= Iarch(unions[ui].members.len) then break
		if Iarch(unions[ui].members[i].payloads.len) > 0 then return true
		i = i + 1
	}
	return false
}

# Is a parameter an aggregate passed by pointer — a record or a BOXED union (a
# tag-only union rides as a word tag, not an aggregate)?
const is_agg_param = (Param p, [RecDecl] recs, [UnionDecl] unions): Bool -> {
	if p.is_ptr then return false
	if find_rec(recs, p.type_name) >= 0 then return true
	if find_union(unions, p.type_name) >= 0 then return union_is_boxed(unions, p.type_name)
	return false
}

# Does a parameter ride in an `l` register — a raw pointer (argv/envp) or an aggregate?
const param_l = (Param p, [RecDecl] recs, [UnionDecl] unions): Bool -> {
	if p.is_ptr then return true
	return is_agg_param(p, recs, unions)
}

# Does a return type ride in an `l` register — a record or a boxed union pointer?
const ret_is_l = (Str ret_name, [RecDecl] recs, [UnionDecl] unions): Bool -> {
	if find_rec(recs, ret_name) >= 0 then return true
	if find_union(unions, ret_name) >= 0 then return union_is_boxed(unions, ret_name)
	return false
}

# A call argument's operand: the temp holding it, and whether it is a record pointer
# (emitted `l`) rather than a word (`w`).
data ArgOp = { Iarch temp, Bool is_rec }

# --- expression emit ------------------------------------------------------------------

# Emit a binary operator node: evaluate both operands, then combine into a fresh
# temp. Operands are bound (not passed as call arguments) so evaluation order —
# left before right — is explicit.
const emit_binop = (*Emit ctx, Str op, Expr l, Expr r, [Binding] env): Str -> {
	const Str a = emit_expr(l, ctx, env)
	const Str b = emit_expr(r, ctx, env)
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w ${op} ${a}, ${b}\n")
	return "%t${t}"
}

# Emit a unary operator whose result is `<op> <operand>` (a two-operand QBE
# instruction with a constant): negation `sub 0, x`, logical not `ceqw x, 0` (a
# Bool 0/1 → its complement), bitwise not `xor x, -1` (all bits flipped).
const emit_unop = (*Emit ctx, Str pre, Expr x, Str post, [Binding] env): Str -> {
	const Str a = emit_expr(x, ctx, env)
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w ${pre}${a}${post}\n")
	return "%t${t}"
}

# Emit a variable reference. A record local's slot IS its base pointer (returned as
# an `l` value — e.g. a record being returned); a word local's slot points to its
# cell, so it is loaded.
const emit_var = (*Emit ctx, [Binding] env, Str name): Str -> {
	const Iarch idx = lookup_index(env, name)
	const Iarch slot = env[idx].slot
	if !str_eq(env[idx].rec_type, "") then return "%t${slot}"
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w loadw %t${slot}\n")
	return "%t${t}"
}

# Emit `base.field`. If `base` is a union type name, this is a tag-only union
# construction — the member's tag, an inline word literal. Otherwise it is a record
# field read: load the word at the record's base + the field's offset (`base` names
# a record local whose slot holds the base pointer).
const emit_field = (*Emit ctx, [Binding] env, Str base, Str field): Str -> {
	if find_union(ctx.unions, base) >= 0 then {
		const Iarch tag = member_tag(ctx.unions, base, field)
		if !union_is_boxed(ctx.unions, base) then return "${tag}"
		# a boxed union's tag-only member is still a one-word arena box holding the tag
		const Iarch b = ctx.next
		ctx.next = ctx.next + 1
		write_str(ctx.fd, "\t%t${b} =l call $cf_alloc(w 4)\n")
		write_str(ctx.fd, "\tstorew ${tag}, %t${b}\n")
		return "%t${b}"
	}
	const Iarch idx = lookup_index(env, base)
	const Iarch slot = env[idx].slot
	const Str rt = env[idx].rec_type
	const Iarch off = field_offset(ctx.recs, rt, field)
	const Iarch addr = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${addr} =l add %t${slot}, ${off}\n")
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w loadw %t${addr}\n")
	return "%t${t}"
}

# Emit a data literal: allocate the record in the ARENA (`cf_alloc`, 4 bytes/field —
# so it outlives the current stack frame and may be returned), store each
# initializer at its field's offset, and return the base-pointer temp. Field
# initializers may be given in any order; each maps to its declared offset.
const emit_record_lit = (*Emit ctx, RecLit rl, [Binding] env): Iarch -> {
	const Iarch ri = find_rec(ctx.recs, rl.type_name)
	const Iarch size = Iarch(ctx.recs[ri].fields.len) * 4
	const Iarch base = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${base} =l call $cf_alloc(w ${size})\n")
	let Iarch a = 0
	loop {
		if a >= Iarch(rl.inits.len) then break
		const Str v = emit_expr(rl.inits[a].value, ctx, env)
		const Iarch off = field_offset(ctx.recs, rl.type_name, rl.inits[a].field)
		const Iarch addr = ctx.next
		ctx.next = ctx.next + 1
		write_str(ctx.fd, "\t%t${addr} =l add %t${base}, ${off}\n")
		write_str(ctx.fd, "\tstorew ${v}, %t${addr}\n")
		a = a + 1
	}
	return base
}

# A record literal only appears as a binding initializer (handled in emit_block), so
# it never flows through emit_expr — this arm is an unreachable internal guard.
const emit_record_val = (*Emit ctx, RecLit rl, [Binding] env): Str -> {
	die("cf0: emit: internal: a record literal is only valid as a binding initializer\n")
	return ""
}

# Emit `Type.member(args)` — a payload-member union construction: an arena box
# `{tag@0, arg0@4, arg1@8, …}`, returned as its base pointer.
const emit_union_mk = (*Emit ctx, UnionMkE mk, [Binding] env): Str -> {
	const Iarch tag = member_tag(ctx.unions, mk.type_name, mk.member)
	const Iarch na = Iarch(mk.args.len)
	const Iarch size = 4 + na * 4
	const Iarch b = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${b} =l call $cf_alloc(w ${size})\n")
	write_str(ctx.fd, "\tstorew ${tag}, %t${b}\n")
	let Iarch i = 0
	loop {
		if i >= na then break
		const Str v = emit_expr(mk.args[i], ctx, env)
		const Iarch off = 4 + i * 4
		const Iarch addr = ctx.next
		ctx.next = ctx.next + 1
		write_str(ctx.fd, "\t%t${addr} =l add %t${b}, ${off}\n")
		write_str(ctx.fd, "\tstorew ${v}, %t${addr}\n")
		i = i + 1
	}
	return "%t${b}"
}

# The aggregate type name a call returns (a record or a BOXED union), or "".
const call_agg_type = (*Emit ctx, Call cl): Str -> {
	const Iarch fidx = find_func(ctx.funcs, cl.callee)
	if fidx < 0 then return ""
	if ret_is_l(ctx.funcs[fidx].ret_name, ctx.recs, ctx.unions) then return ctx.funcs[fidx].ret_name
	return ""
}

# The aggregate type name a `base.field` yields — a boxed union's tag-only member
# (`Node.Nil`) yields the union; a tag-only union member or a record field does not.
const field_agg_type = (*Emit ctx, Str base): Str -> {
	if find_union(ctx.unions, base) < 0 then return ""
	if union_is_boxed(ctx.unions, base) then return base
	return ""
}

# The aggregate type name of a binding initializer that yields an aggregate (a
# record or a boxed union) — so its binding holds a base pointer — else "".
const init_agg_type = (*Emit ctx, Expr e): Str -> match e {
	Expr.Record(rl) -> rl.type_name,
	Expr.UnionMk(mk) -> mk.type_name,
	Expr.Field(base, f) -> field_agg_type(ctx, base),
	Expr.Call(cl) -> call_agg_type(ctx, cl),
	_ -> ""
}

# Copy an aggregate operand (a base pointer) into a fresh temp the binding owns.
const copy_agg = (*Emit ctx, Str v): Iarch -> {
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =l copy ${v}\n")
	return t
}

# Emit an aggregate binding initializer, returning the base-pointer temp. A data
# literal builds directly; anything else (a union construction, a boxed tag-only
# member, an aggregate-returning call) yields a pointer that the binding adopts.
const emit_agg_binding = (*Emit ctx, Expr e, [Binding] env): Iarch -> match e {
	Expr.Record(rl) -> emit_record_lit(ctx, rl, env),
	_ -> copy_agg(ctx, emit_expr(e, ctx, env))
}

# Emit an `if <cond> then <a> else <b>` value. The branches merge through a stack
# slot (not a phi): evaluate the condition, branch, each arm stores its value into
# the slot, and the join block loads it. Robust under nesting; QBE accepts an
# `alloc` in a non-entry block.
const emit_if = (*Emit ctx, Expr cond, Expr thenE, Expr elseE, [Binding] env): Str -> {
	const Str c = emit_expr(cond, ctx, env)
	const Iarch slot = ctx.next
	ctx.next = ctx.next + 1
	const Iarch lid = ctx.label
	ctx.label = ctx.label + 1
	write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
	write_str(ctx.fd, "\tjnz ${c}, @then${lid}, @else${lid}\n")
	write_str(ctx.fd, "@then${lid}\n")
	const Str a = emit_expr(thenE, ctx, env)
	write_str(ctx.fd, "\tstorew ${a}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@else${lid}\n")
	const Str b = emit_expr(elseE, ctx, env)
	write_str(ctx.fd, "\tstorew ${b}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@end${lid}\n")
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${rt} =w loadw %t${slot}\n")
	return "%t${rt}"
}

# Emit a short-circuit `&&`/`||`. The right operand is emitted in its own block,
# reached only when the left operand does not already settle the result — so a
# side-effecting or non-terminating RHS is genuinely skipped. The result (0/1)
# merges through a slot, like `if`. For `&&`: a false lhs short-circuits to 0; for
# `||`: a true lhs short-circuits to 1; otherwise the result is `rhs != 0`.
const emit_logical = (*Emit ctx, Bool is_and, Expr l, Expr r, [Binding] env): Str -> {
	const Str a = emit_expr(l, ctx, env)
	const Iarch slot = ctx.next
	ctx.next = ctx.next + 1
	const Iarch lid = ctx.label
	ctx.label = ctx.label + 1
	write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
	if is_and then write_str(ctx.fd, "\tjnz ${a}, @rhs${lid}, @sc${lid}\n")
	if !is_and then write_str(ctx.fd, "\tjnz ${a}, @sc${lid}, @rhs${lid}\n")
	write_str(ctx.fd, "@sc${lid}\n")
	if is_and then write_str(ctx.fd, "\tstorew 0, %t${slot}\n")
	if !is_and then write_str(ctx.fd, "\tstorew 1, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@rhs${lid}\n")
	const Str b = emit_expr(r, ctx, env)
	const Iarch bb = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${bb} =w cnew ${b}, 0\n")
	write_str(ctx.fd, "\tstorew %t${bb}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@end${lid}\n")
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${rt} =w loadw %t${slot}\n")
	return "%t${rt}"
}

# The index of the function named `name` in `funcs`, or -1 if none.
const find_func = ([Func] funcs, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(funcs.len) then break
		if str_eq(funcs[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}

# Emit a call `callee(args)`. The callee (existence, arity, and argument types
# already checked by the typecheck phase) is mapped by name to its function index
# for the QBE symbol. A word argument is evaluated into a fresh temp (`w`); an
# aggregate argument (a record or boxed union — any expression yielding a base
# pointer) is copied into a temp and passed by pointer (`l`). main's QBE symbol is
# `$main`; every other function is `$f<i>` (positional, so a user name can never
# collide with `_start`).
const emit_call = (*Emit ctx, Call cl, [Binding] env): Str -> {
	const Iarch fidx = find_func(ctx.funcs, cl.callee)
	if fidx < 0 then die("cf0: emit: internal: unresolved call (should be caught by typecheck)\n")
	const Iarch nargs = Iarch(cl.args.len)
	let [ArgOp] aops = []
	let Iarch i = 0
	loop {
		if i >= nargs then break
		if is_agg_param(ctx.funcs[fidx].params[i], ctx.recs, ctx.unions) then {
			const Str av = emit_expr(cl.args[i], ctx, env)
			const Iarch tt = copy_agg(ctx, av)
			aops = [...aops, ArgOp({ temp: tt, is_rec: true })]
		} else {
			const Str op = emit_expr(cl.args[i], ctx, env)
			const Iarch tt = ctx.next
			ctx.next = ctx.next + 1
			write_str(ctx.fd, "\t%t${tt} =w copy ${op}\n")
			aops = [...aops, ArgOp({ temp: tt, is_rec: false })]
		}
		i = i + 1
	}
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	const Bool is_main = str_eq(ctx.funcs[fidx].name, "main")
	# a record-returning callee yields an `l` arena pointer; every other returns a word
	if ret_is_l(ctx.funcs[fidx].ret_name, ctx.recs, ctx.unions) then write_str(ctx.fd, "\t%t${rt} =l call $")
	if !ret_is_l(ctx.funcs[fidx].ret_name, ctx.recs, ctx.unions) then write_str(ctx.fd, "\t%t${rt} =w call $")
	if is_main then write_str(ctx.fd, "main")
	if !is_main then write_str(ctx.fd, "f${fidx}")
	write_str(ctx.fd, "(")
	let Iarch j = 0
	loop {
		if j >= Iarch(aops.len) then break
		if j > 0 then write_str(ctx.fd, ", ")
		const Iarch tj = aops[j].temp
		if aops[j].is_rec then write_str(ctx.fd, "l %t${tj}")
		if !aops[j].is_rec then write_str(ctx.fd, "w %t${tj}")
		j = j + 1
	}
	write_str(ctx.fd, ")\n")
	return "%t${rt}"
}

# The scrutinee's union (the first member arm's type name), or "" if all arms are `_`.
const match_union = (MatchExpr me): Str -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(me.arms.len) then break
		if !me.arms[i].is_wild then return me.arms[i].type_name
		i = i + 1
	}
	return ""
}

# The scrutinee's tag operand: for a boxed union the tag lives at the box's offset 0
# (loaded here); a tag-only union value IS its tag.
const scrut_tag = (*Emit ctx, MatchExpr me, Str s): Str -> {
	const Str un = match_union(me)
	if str_eq(un, "") then return s
	if !union_is_boxed(ctx.unions, un) then return s
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w loadw ${s}\n")
	return "%t${t}"
}

# Emit a `match` on a union. Evaluate the scrutinee to its tag (loading it from the
# box for a boxed union), then a compare-chain: each member arm tests the tag and, on
# a hit, evaluates its body into the result slot and jumps to the end; the LAST arm (a
# `_` wildcard, or — for an exhaustive match — the final member) is the unconditional
# else. The result merges through a stack slot, like `if`.
const emit_match = (*Emit ctx, MatchExpr me, [Binding] env): Str -> {
	const Str s = emit_expr(me.scrut, ctx, env)
	const Str tagop = scrut_tag(ctx, me, s)
	const Iarch slot = ctx.next
	ctx.next = ctx.next + 1
	const Iarch lid = ctx.label
	ctx.label = ctx.label + 1
	write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
	const Iarch na = Iarch(me.arms.len)
	let Iarch i = 0
	loop {
		if i >= na then break
		if i == na - 1 then {
			const Str v = emit_expr(me.arms[i].body, ctx, env)
			write_str(ctx.fd, "\tstorew ${v}, %t${slot}\n")
			write_str(ctx.fd, "\tjmp @mend${lid}\n")
		} else {
			# test each or-pattern alternative: a hit jumps to the arm body, a miss to
			# the next alternative, and after the last to the next arm.
			const Iarch k = Iarch(me.arms[i].members.len)
			let Iarch j = 0
			loop {
				if j >= k then break
				const Iarch tag = member_tag(ctx.unions, me.arms[i].type_name, me.arms[i].members[j])
				const Iarch c = ctx.next
				ctx.next = ctx.next + 1
				write_str(ctx.fd, "\t%t${c} =w ceqw ${tagop}, ${tag}\n")
				if j == k - 1 then write_str(ctx.fd, "\tjnz %t${c}, @marm${lid}_${i}, @mnext${lid}_${i}\n")
				if j != k - 1 then {
					write_str(ctx.fd, "\tjnz %t${c}, @marm${lid}_${i}, @malt${lid}_${i}_${j}\n")
					write_str(ctx.fd, "@malt${lid}_${i}_${j}\n")
				}
				j = j + 1
			}
			write_str(ctx.fd, "@marm${lid}_${i}\n")
			const Str v = emit_expr(me.arms[i].body, ctx, env)
			write_str(ctx.fd, "\tstorew ${v}, %t${slot}\n")
			write_str(ctx.fd, "\tjmp @mend${lid}\n")
			write_str(ctx.fd, "@mnext${lid}_${i}\n")
		}
		i = i + 1
	}
	write_str(ctx.fd, "@mend${lid}\n")
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${rt} =w loadw %t${slot}\n")
	return "%t${rt}"
}

const emit_expr = (Expr e, *Emit ctx, [Binding] env): Str -> match e {
	Expr.Lit(v) -> "${v}",
	Expr.BoolLit(b) -> if b then "1" else "0",
	Expr.Var(name) -> emit_var(ctx, env, name),
	Expr.Record(rl) -> emit_record_val(ctx, rl, env),
	Expr.Field(base, f) -> emit_field(ctx, env, base, f),
	Expr.UnionMk(mk) -> emit_union_mk(ctx, mk, env),
	Expr.Match(me) -> emit_match(ctx, me, env),
	Expr.Neg(x) -> emit_unop(ctx, "sub 0, ", x, "", env),
	Expr.Not(x) -> emit_unop(ctx, "ceqw ", x, ", 0", env),
	Expr.BitNot(x) -> emit_unop(ctx, "xor ", x, ", -1", env),
	Expr.Add(l, r) -> emit_binop(ctx, "add", l, r, env),
	Expr.Sub(l, r) -> emit_binop(ctx, "sub", l, r, env),
	Expr.Mul(l, r) -> emit_binop(ctx, "mul", l, r, env),
	Expr.Div(l, r) -> emit_binop(ctx, "div", l, r, env),
	Expr.Mod(l, r) -> emit_binop(ctx, "rem", l, r, env),
	Expr.BitAnd(l, r) -> emit_binop(ctx, "and", l, r, env),
	Expr.BitOr(l, r) -> emit_binop(ctx, "or", l, r, env),
	Expr.BitXor(l, r) -> emit_binop(ctx, "xor", l, r, env),
	Expr.Shl(l, r) -> emit_binop(ctx, "shl", l, r, env),
	Expr.Shr(l, r) -> emit_binop(ctx, "sar", l, r, env),
	Expr.CmpEq(l, r) -> emit_binop(ctx, "ceqw", l, r, env),
	Expr.CmpNe(l, r) -> emit_binop(ctx, "cnew", l, r, env),
	Expr.CmpLt(l, r) -> emit_binop(ctx, "csltw", l, r, env),
	Expr.CmpGt(l, r) -> emit_binop(ctx, "csgtw", l, r, env),
	Expr.CmpLe(l, r) -> emit_binop(ctx, "cslew", l, r, env),
	Expr.CmpGe(l, r) -> emit_binop(ctx, "csgew", l, r, env),
	Expr.And(l, r) -> emit_logical(ctx, true, l, r, env),
	Expr.Or(l, r) -> emit_logical(ctx, false, l, r, env),
	Expr.If(cond, thenE, elseE) -> emit_if(ctx, cond, thenE, elseE, env),
	Expr.Call(cl) -> emit_call(ctx, cl, env)
}

# --- statement / block emit -----------------------------------------------------------
# A `Stmt` is dispatched by extracting its shape (`match` arms are expressions, so the
# per-kind handling is inlined in `emit_block` after pulling the components out).

const stmt_kind = (Stmt s): Iarch -> match s {
	Stmt.Let(n, m, e) -> 0,
	Stmt.Assign(n, e) -> 1,
	Stmt.FieldAssign(b, f, e) -> 3,
	Stmt.Return(e) -> 2
}
const stmt_name = (Stmt s): Str -> match s {
	Stmt.Let(n, m, e) -> n,
	Stmt.Assign(n, e) -> n,
	Stmt.FieldAssign(b, f, e) -> b,
	Stmt.Return(e) -> ""
}
const stmt_field = (Stmt s): Str -> match s {
	Stmt.Let(n, m, e) -> "",
	Stmt.Assign(n, e) -> "",
	Stmt.FieldAssign(b, f, e) -> f,
	Stmt.Return(e) -> ""
}
# Extract a statement's sub-expression: the initializer of a `Let`, the value of an
# `Assign`, the returned value of a `Return`. Each arm YIELDS the bound payload `e`
# directly — an arena-borrowed alias, sound in cfcc's single never-freed arena — so
# the caller reads it out cleanly rather than the arm having to launder it through
# `emit_expr`.
const stmt_expr = (Stmt s): Expr -> match s {
	Stmt.Let(n, m, e) -> e,
	Stmt.Assign(n, e) -> e,
	Stmt.FieldAssign(b, f, e) -> e,
	Stmt.Return(e) -> e
}

# Emit a block's statements in order, growing the binding environment as `let`/`const`
# locals are declared. The env is seeded with the function's word parameters. Every
# semantic rule (no shadowing, only a mutable name reassigns, a reassignment keeps
# its type, the body returns) was enforced by the typecheck phase, so this walk just
# generates code: a `Let`/`const` allocates a slot and stores; an `Assign` stores
# into the existing slot; a `Return` emits the `ret`.
const emit_block = (*Emit ctx, [Stmt] stmts, [Binding] params): Iarch -> {
	let [Binding] env = []
	let Iarch pi = 0
	loop {
		if pi >= Iarch(params.len) then break
		# rebuild each parameter binding as a fresh record literal — an array element
		# must be fresh, not an alias of the passed-in vector's storage. The field
		# values are read inline (a `Str` cannot be copy-bound to a local).
		env = [...env, Binding({ name: params[pi].name, slot: params[pi].slot, rec_type: params[pi].rec_type })]
		pi = pi + 1
	}
	let Iarch i = 0
	loop {
		if i >= Iarch(stmts.len) then break
		const Stmt s = stmts[i]
		const Iarch k = stmt_kind(s)
		if k == 0 then {
			# `const`/`let name = init`. A record initializer (`{…}`) allocates the record
			# and binds the name to its base pointer; a scalar allocates a word slot,
			# stores the value, and binds the name to that slot.
			const Str rt = init_agg_type(ctx, stmt_expr(s))
			if str_eq(rt, "") then {
				const Str v = emit_expr(stmt_expr(s), ctx, env)
				const Iarch slot = ctx.next
				ctx.next = ctx.next + 1
				write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
				write_str(ctx.fd, "\tstorew ${v}, %t${slot}\n")
				env = [...env, Binding({ name: stmt_name(s), slot: slot, rec_type: "" })]
			} else {
				const Iarch base = emit_agg_binding(ctx, stmt_expr(s), env)
				env = [...env, Binding({ name: stmt_name(s), slot: base, rec_type: rt })]
			}
		}
		if k == 1 then {
			# `name = value` — reassign an existing local's slot.
			const Iarch idx = lookup_index(env, stmt_name(s))
			const Iarch slot = env[idx].slot
			const Str v = emit_expr(stmt_expr(s), ctx, env)
			write_str(ctx.fd, "\tstorew ${v}, %t${slot}\n")
		}
		if k == 3 then {
			# `base.field = value` — store the value into the record's field in place.
			# Evaluate the value first (it may read the record's current fields).
			const Str v = emit_expr(stmt_expr(s), ctx, env)
			const Iarch idx = lookup_index(env, stmt_name(s))
			const Iarch slot = env[idx].slot
			const Str rt = env[idx].rec_type
			const Iarch off = field_offset(ctx.recs, rt, stmt_field(s))
			const Iarch addr = ctx.next
			ctx.next = ctx.next + 1
			write_str(ctx.fd, "\t%t${addr} =l add %t${slot}, ${off}\n")
			write_str(ctx.fd, "\tstorew ${v}, %t${addr}\n")
		}
		if k == 2 then {
			const Str v = emit_expr(stmt_expr(s), ctx, env)
			write_str(ctx.fd, "\tret ${v}\n")
		}
		i = i + 1
	}
	return 0
}

# Emit one function: its signature, parameter spills, and body. main is the exported
# `$main` (the entry the floor calls); every other function `idx` is the internal
# `$f<idx>` (positional, so a user name can never collide with `_start`/`_main`).
#
# Parameters are named POSITIONALLY in QBE (`%p<i>`), not by source name — the temp
# only has to match between the signature and the spill, and a Str name cannot be
# interpolated (cfcc interpolates bare identifiers only). A word parameter (Iarch)
# is `w` and spills to a stack slot so it reads like a local, and is bound in the
# env; a pointer parameter (*[Str]) is `l`, rides the signature unused, and is NOT
# bound (the typecheck phase guarantees it is never referenced). All returns are words.
const emit_func = (*Emit ctx, Func fn, Iarch idx): Iarch -> {
	const Bool is_main = str_eq(fn.name, "main")
	# main always returns a word (its Int exit code); a helper returning a record
	# returns an `l` arena pointer, else a word.
	if is_main then write_str(ctx.fd, "export function w $main(")
	if !is_main then {
		if ret_is_l(fn.ret_name, ctx.recs, ctx.unions) then write_str(ctx.fd, "function l $f${idx}(")
		if !ret_is_l(fn.ret_name, ctx.recs, ctx.unions) then write_str(ctx.fd, "function w $f${idx}(")
	}
	let Iarch si = 0
	loop {
		if si >= Iarch(fn.params.len) then break
		if si > 0 then write_str(ctx.fd, ", ")
		if param_l(fn.params[si], ctx.recs, ctx.unions) then write_str(ctx.fd, "l %p${si}")
		if !param_l(fn.params[si], ctx.recs, ctx.unions) then write_str(ctx.fd, "w %p${si}")
		si = si + 1
	}
	write_str(ctx.fd, ") {\n")
	write_str(ctx.fd, "@start\n")
	let [Binding] params = []
	let Iarch pi = 0
	loop {
		if pi >= Iarch(fn.params.len) then break
		if !fn.params[pi].is_ptr then {
			if is_agg_param(fn.params[pi], ctx.recs, ctx.unions) then {
				# a record parameter arrives as a pointer to the caller's record; copy it
				# into a temp used as the record's base for field reads.
				const Iarch slot = ctx.next
				ctx.next = ctx.next + 1
				write_str(ctx.fd, "\t%t${slot} =l copy %p${pi}\n")
				params = [...params, Binding({ name: fn.params[pi].name, slot: slot, rec_type: fn.params[pi].type_name })]
			} else {
				# a word parameter spills into a stack slot so it reads like a local.
				const Iarch slot = ctx.next
				ctx.next = ctx.next + 1
				write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
				write_str(ctx.fd, "\tstorew %p${pi}, %t${slot}\n")
				params = [...params, Binding({ name: fn.params[pi].name, slot: slot, rec_type: "" })]
			}
		}
		pi = pi + 1
	}
	emit_block(ctx, fn.body, params)
	write_str(ctx.fd, "}\n")
	return 0
}

# The arena's QBE side: a single global bump cursor `{cf_top, cf_limit}` over one OS
# mapping, and `cf_alloc(n)` — lazily mints the page on the first call (if cf_limit
# is 0, call the asm `cf_arena_init`), 8-aligns the request, bumps the cursor, and
# traps via `cf_oom` on overflow. Records (which may escape via a return) live here;
# scalars stay in stack slots. (⚠ THROWAWAY: one bounded 64 MiB mapping, no teardown
# or remap — the M6 std runtime does the real page/arena arc.)
const emit_arena_qbe = (Uarch fd): Iarch -> {
	write_str(fd, "export data $cf_top = { l 0 }\n")
	write_str(fd, "export data $cf_limit = { l 0 }\n")
	write_str(fd, "function l $cf_alloc(w %n) {\n")
	write_str(fd, "@start\n")
	write_str(fd, "\t%lim0 =l loadl $cf_limit\n")
	write_str(fd, "\t%uninit =w ceql %lim0, 0\n")
	write_str(fd, "\tjnz %uninit, @init, @ready\n")
	write_str(fd, "@init\n")
	write_str(fd, "\tcall $cf_arena_init()\n")
	write_str(fd, "\tjmp @ready\n")
	write_str(fd, "@ready\n")
	write_str(fd, "\t%r7 =w add %n, 7\n")
	write_str(fd, "\t%ra =w and %r7, -8\n")
	write_str(fd, "\t%sz =l extuw %ra\n")
	write_str(fd, "\t%p =l loadl $cf_top\n")
	write_str(fd, "\t%nt =l add %p, %sz\n")
	write_str(fd, "\t%lim =l loadl $cf_limit\n")
	write_str(fd, "\t%ok =w culel %nt, %lim\n")
	write_str(fd, "\tjnz %ok, @ok, @oom\n")
	write_str(fd, "@oom\n")
	write_str(fd, "\tcall $cf_oom()\n")
	write_str(fd, "\tret %p\n")
	write_str(fd, "@ok\n")
	write_str(fd, "\tstorel %nt, $cf_top\n")
	write_str(fd, "\tret %p\n")
	write_str(fd, "}\n")
	return 0
}

# The arena's asm side: `cf_arena_init` mmaps 64 MiB (SYS_mmap=197) and seeds the
# cursor; `cf_oom`/`cf_mmap_fail` exit with distinct nonzero codes. Leaf routines
# (no `bl`), so calling `cf_arena_init` lazily from `cf_alloc` needs no arg saving.
const emit_arena_floor = (Uarch fd): Iarch -> {
	write_str(fd, ".globl _cf_arena_init\n")
	write_str(fd, ".globl _cf_oom\n")
	write_str(fd, ".p2align 2\n")
	write_str(fd, "_cf_arena_init:\n")
	write_str(fd, "\tmov x0, #0\n")
	write_str(fd, "\tmov x1, #0x4000000\n")
	write_str(fd, "\tmov x2, #3\n")
	write_str(fd, "\tmov x3, #0x1002\n")
	write_str(fd, "\tmov x4, #-1\n")
	write_str(fd, "\tmov x5, #0\n")
	write_str(fd, "\tmov x16, #197\n")
	write_str(fd, "\tsvc #0x80\n")
	write_str(fd, "\tb.cs _cf_mmap_fail\n")
	write_str(fd, "\tadrp x9, _cf_top@PAGE\n")
	write_str(fd, "\tadd x9, x9, _cf_top@PAGEOFF\n")
	write_str(fd, "\tstr x0, [x9]\n")
	write_str(fd, "\tmov x1, #0x4000000\n")
	write_str(fd, "\tadd x11, x0, x1\n")
	write_str(fd, "\tadrp x10, _cf_limit@PAGE\n")
	write_str(fd, "\tadd x10, x10, _cf_limit@PAGEOFF\n")
	write_str(fd, "\tstr x11, [x10]\n")
	write_str(fd, "\tret\n")
	write_str(fd, "_cf_mmap_fail:\n")
	write_str(fd, "\tmov x0, #71\n")
	write_str(fd, "\tmov x16, #1\n")
	write_str(fd, "\tsvc #0x80\n")
	write_str(fd, "_cf_oom:\n")
	write_str(fd, "\tmov x0, #70\n")
	write_str(fd, "\tmov x16, #1\n")
	write_str(fd, "\tsvc #0x80\n")
	return 0
}

# Emit the whole program: the arena runtime, every function (main exported, the rest
# internal, each with a fresh temp/label counter), then the freestanding entry floor
# plus the arena's asm side. Runs only on programs the typecheck phase has accepted.
#
# darwin hands `main` its (argc, argv, envp) in x0/x1/x2 at the entry point, and the
# `_start` floor does nothing before `bl _main`, so those registers flow straight
# through — QBE reads them as `$main`'s declared arguments.
pub const emit_program = (Program prog, Uarch qbe_fd, Uarch asm_fd): Iarch -> {
	emit_arena_qbe(qbe_fd)
	let Iarch i = 0
	loop {
		if i >= Iarch(prog.funcs.len) then break
		let Emit ctx = Emit({ fd: qbe_fd, next: 0, label: 0, funcs: prog.funcs, recs: prog.recs, unions: prog.unions })
		emit_func(&ctx, prog.funcs[i], i)
		i = i + 1
	}
	# asm floor: the freestanding entry. `_start` calls `_main` (argc/argv/envp still
	# in x0/x1/x2 from the kernel), then exit-syscalls its return (in x0).
	write_str(asm_fd, ".globl _start\n")
	write_str(asm_fd, ".p2align 2\n")
	write_str(asm_fd, "_start:\n")
	write_str(asm_fd, "\tbl _main\n")
	write_str(asm_fd, "\tmov x16, #1\n")
	write_str(asm_fd, "\tsvc #0x80\n")
	emit_arena_floor(asm_fd)
	return 0
}
