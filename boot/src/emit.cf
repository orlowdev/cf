# emit — the AST to QBE IL + an asm floor.
#
# `emit_expr` walks the expression tree with `match`, writing one QBE
# instruction per interior node and returning the operand (`%tN`, or an inline
# literal) that holds the node's value. A `*Emit` context threads the output fd
# and the temp counter through the recursion. `emit_program` wraps the body in
# the exported `main` and appends the freestanding `_start` floor.
#
# cf0 cannot yet spawn `qbe`/`cc`, so it emits the QBE IL and the arm64 asm floor
# to two file descriptors and the external driver runs the `qbe`→`cc` tail.
#
# ⚠ THROWAWAY codegen — NOT the cf0 `%node`/`%ret` ABI or the real page/arena
# runtime (reintroduced at the M6/M9 representation gate). Integer ops are word
# (`w`) ops; `/`/`%` do not yet apply the §5.6 divide-by-zero guard (added when a
# `%0`/`/0` test enters the manifest).

import "io" as { write_str }
import "ast" as { Expr }

# The emit context: the QBE-IL output fd, the next free temp number, and the next
# free basic-block label id.
data Emit = { Uarch fd, Iarch next, Iarch label }

# Emit a binary operator node: evaluate both operands, then combine into a fresh
# temp. Operands are bound (not passed as call arguments) so evaluation order —
# left before right — is explicit.
const emit_binop = (*Emit ctx, Str op, Expr l, Expr r): Str -> {
	const Str a = emit_expr(l, ctx)
	const Str b = emit_expr(r, ctx)
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w ${op} ${a}, ${b}\n")
	return "%t${t}"
}

# Emit unary negation as `0 - x` (no dependence on a QBE `neg`).
const emit_neg = (*Emit ctx, Expr x): Str -> {
	const Str a = emit_expr(x, ctx)
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w sub 0, ${a}\n")
	return "%t${t}"
}

# Emit an `if <cond> then <a> else <b>` value. The branches merge through a stack
# slot (not a phi): evaluate the condition, branch, each arm stores its value into
# the slot, and the join block loads it. Robust under nesting; QBE accepts an
# `alloc` in a non-entry block.
const emit_if = (*Emit ctx, Expr cond, Expr thenE, Expr elseE): Str -> {
	const Str c = emit_expr(cond, ctx)
	const Iarch slot = ctx.next
	ctx.next = ctx.next + 1
	const Iarch lid = ctx.label
	ctx.label = ctx.label + 1
	write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
	write_str(ctx.fd, "\tjnz ${c}, @then${lid}, @else${lid}\n")
	write_str(ctx.fd, "@then${lid}\n")
	const Str a = emit_expr(thenE, ctx)
	write_str(ctx.fd, "\tstorew ${a}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@else${lid}\n")
	const Str b = emit_expr(elseE, ctx)
	write_str(ctx.fd, "\tstorew ${b}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@end${lid}\n")
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${rt} =w loadw %t${slot}\n")
	return "%t${rt}"
}

# Emit a short-circuit `&&`/`||`. The right operand is emitted in its own block,
# reached only when the left operand does not already settle the result — so a
# side-effecting or non-terminating RHS is genuinely skipped. The result (0/1)
# merges through a slot, like `if`. For `&&`: a false lhs short-circuits to 0; for
# `||`: a true lhs short-circuits to 1; otherwise the result is `rhs != 0`.
const emit_logical = (*Emit ctx, Bool is_and, Expr l, Expr r): Str -> {
	const Str a = emit_expr(l, ctx)
	const Iarch slot = ctx.next
	ctx.next = ctx.next + 1
	const Iarch lid = ctx.label
	ctx.label = ctx.label + 1
	write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
	# A true lhs takes @rhs for `&&` (must check rhs) but @sc for `||` (already 1).
	if is_and then write_str(ctx.fd, "\tjnz ${a}, @rhs${lid}, @sc${lid}\n")
	if !is_and then write_str(ctx.fd, "\tjnz ${a}, @sc${lid}, @rhs${lid}\n")
	# short-circuit block: the result is settled by the lhs (0 for `&&`, 1 for `||`).
	write_str(ctx.fd, "@sc${lid}\n")
	if is_and then write_str(ctx.fd, "\tstorew 0, %t${slot}\n")
	if !is_and then write_str(ctx.fd, "\tstorew 1, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	# rhs block: evaluate the right operand and normalise it to 0/1.
	write_str(ctx.fd, "@rhs${lid}\n")
	const Str b = emit_expr(r, ctx)
	const Iarch bb = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${bb} =w cnew ${b}, 0\n")
	write_str(ctx.fd, "\tstorew %t${bb}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@end${lid}\n")
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${rt} =w loadw %t${slot}\n")
	return "%t${rt}"
}

const emit_expr = (Expr e, *Emit ctx): Str -> match e {
	Expr.Lit(v) -> "${v}",
	Expr.Neg(x) -> emit_neg(ctx, x),
	Expr.Add(l, r) -> emit_binop(ctx, "add", l, r),
	Expr.Sub(l, r) -> emit_binop(ctx, "sub", l, r),
	Expr.Mul(l, r) -> emit_binop(ctx, "mul", l, r),
	Expr.Div(l, r) -> emit_binop(ctx, "div", l, r),
	Expr.Mod(l, r) -> emit_binop(ctx, "rem", l, r),
	Expr.BitAnd(l, r) -> emit_binop(ctx, "and", l, r),
	Expr.BitOr(l, r) -> emit_binop(ctx, "or", l, r),
	Expr.BitXor(l, r) -> emit_binop(ctx, "xor", l, r),
	Expr.Shl(l, r) -> emit_binop(ctx, "shl", l, r),
	Expr.Shr(l, r) -> emit_binop(ctx, "sar", l, r),
	Expr.CmpEq(l, r) -> emit_binop(ctx, "ceqw", l, r),
	Expr.CmpNe(l, r) -> emit_binop(ctx, "cnew", l, r),
	Expr.CmpLt(l, r) -> emit_binop(ctx, "csltw", l, r),
	Expr.CmpGt(l, r) -> emit_binop(ctx, "csgtw", l, r),
	Expr.CmpLe(l, r) -> emit_binop(ctx, "cslew", l, r),
	Expr.CmpGe(l, r) -> emit_binop(ctx, "csgew", l, r),
	Expr.And(l, r) -> emit_logical(ctx, true, l, r),
	Expr.Or(l, r) -> emit_logical(ctx, false, l, r),
	Expr.If(cond, thenE, elseE) -> emit_if(ctx, cond, thenE, elseE)
}

# Emit the whole program: the exported `main` (returning the body's word value)
# plus the freestanding entry floor.
pub const emit_program = (Expr body, Uarch qbe_fd, Uarch asm_fd): Iarch -> {
	write_str(qbe_fd, "export function w $main() {\n")
	write_str(qbe_fd, "@start\n")
	let Emit ctx = Emit({ fd: qbe_fd, next: 0, label: 0 })
	const Str result = emit_expr(body, &ctx)
	write_str(qbe_fd, "\tret ${result}\n")
	write_str(qbe_fd, "}\n")
	# asm floor: the freestanding entry. `_start` forwards argc/argv/envp (unused),
	# calls `_main`, then exit-syscalls its return (in x0).
	write_str(asm_fd, ".globl _start\n")
	write_str(asm_fd, ".p2align 2\n")
	write_str(asm_fd, "_start:\n")
	write_str(asm_fd, "\tbl _main\n")
	write_str(asm_fd, "\tmov x16, #1\n")
	write_str(asm_fd, "\tsvc #0x80\n")
	return 0
}
