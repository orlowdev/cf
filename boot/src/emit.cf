# emit — the AST to QBE IL + an asm floor.
#
# `emit_expr` walks the expression tree with `match`, writing one QBE
# instruction per interior node and returning the operand (`%tN`, or an inline
# literal) that holds the node's value. A `*Emit` context threads the output fd
# and the temp/label counters; a `[Binding]` environment (a read-only borrow)
# resolves variable references to their stack slots. `emit_program` walks the
# body's statement list and appends the freestanding `_start` floor.
#
# cf0 cannot yet spawn `qbe`/`cc`, so it emits the QBE IL and the arm64 asm floor
# to two file descriptors and the external driver runs the `qbe`→`cc` tail.
#
# ⚠ THROWAWAY codegen — NOT the cf0 `%node`/`%ret` ABI or the real page/arena
# runtime (reintroduced at the M6/M9 representation gate). Integer ops are word
# (`w`) ops; every local is a word stack slot (`alloc4`/`storew`/`loadw`); `/`/`%`
# do not yet apply the §5.6 divide-by-zero guard; `const` vs `let` mutability is
# not yet enforced (that is the typecheck brick).

import "io" as { write_str, die }
import "ast" as { Expr, Stmt, Param, Func, Call, FieldInit, RecLit, RecDecl, Program }

# The emit context: the QBE-IL output fd, the next free temp number, the next free
# basic-block label id, the program's functions (a call resolves its callee — by
# name to a function index — for the `$f<i>` symbol), and its record declarations (a
# field read / data literal resolves a field's byte offset). `next`/`label` reset
# per function; `funcs`/`recs` are constant across the program.
data Emit = { Uarch fd, Iarch next, Iarch label, [Func] funcs, [RecDecl] recs }

# A local/parameter in scope: its interned name, the temp holding its stack slot
# pointer, and — for a record local — its record type name (`""` for a word). A word
# slot points to a 4-byte cell (read with `loadw`); a record slot points to the
# record's base (a field is read at base + offset).
data Binding = { Str name, Iarch slot, Str rec_type }

# Byte-wise `Str` equality (variable-name lookup).
const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

# The index of `name`'s binding in `env`, or -1. The typecheck phase has resolved
# every reference, so a hit is guaranteed for well-typed input.
const lookup_index = ([Binding] env, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(env.len) then break
		if str_eq(env[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}

# The index of the record declared as `name`, or -1.
const find_rec = ([RecDecl] recs, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(recs.len) then break
		if str_eq(recs[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}

# The byte offset of field `field` in record type `rt` — its declaration index × 4
# (every field is a 4-byte word). The typecheck phase guarantees both resolve.
const field_offset = ([RecDecl] recs, Str rt, Str field): Iarch -> {
	const Iarch ri = find_rec(recs, rt)
	let Iarch fi = 0
	loop {
		if fi >= Iarch(recs[ri].fields.len) then break
		if str_eq(recs[ri].fields[fi], field) then return fi * 4
		fi = fi + 1
	}
	return 0
}

# --- expression emit ------------------------------------------------------------------

# Emit a binary operator node: evaluate both operands, then combine into a fresh
# temp. Operands are bound (not passed as call arguments) so evaluation order —
# left before right — is explicit.
const emit_binop = (*Emit ctx, Str op, Expr l, Expr r, [Binding] env): Str -> {
	const Str a = emit_expr(l, ctx, env)
	const Str b = emit_expr(r, ctx, env)
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w ${op} ${a}, ${b}\n")
	return "%t${t}"
}

# Emit a unary operator whose result is `<op> <operand>` (a two-operand QBE
# instruction with a constant): negation `sub 0, x`, logical not `ceqw x, 0` (a
# Bool 0/1 → its complement), bitwise not `xor x, -1` (all bits flipped).
const emit_unop = (*Emit ctx, Str pre, Expr x, Str post, [Binding] env): Str -> {
	const Str a = emit_expr(x, ctx, env)
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w ${pre}${a}${post}\n")
	return "%t${t}"
}

# Emit a variable reference: load its stack slot.
const emit_var = (*Emit ctx, [Binding] env, Str name): Str -> {
	const Iarch idx = lookup_index(env, name)
	const Iarch slot = env[idx].slot
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w loadw %t${slot}\n")
	return "%t${t}"
}

# Emit a field read `base.field`: load the word at the record's base + the field's
# offset. `base` names a record local whose slot holds the record's base pointer.
const emit_field = (*Emit ctx, [Binding] env, Str base, Str field): Str -> {
	const Iarch idx = lookup_index(env, base)
	const Iarch slot = env[idx].slot
	const Str rt = env[idx].rec_type
	const Iarch off = field_offset(ctx.recs, rt, field)
	const Iarch addr = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${addr} =l add %t${slot}, ${off}\n")
	const Iarch t = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${t} =w loadw %t${addr}\n")
	return "%t${t}"
}

# Emit a data literal: allocate the record on the stack (`alloc4`, 4 bytes/field),
# store each initializer at its field's offset, and return the base-pointer temp.
# Field initializers may be given in any order; each maps to its declared offset.
const emit_record_lit = (*Emit ctx, RecLit rl, [Binding] env): Iarch -> {
	const Iarch ri = find_rec(ctx.recs, rl.type_name)
	const Iarch size = Iarch(ctx.recs[ri].fields.len) * 4
	const Iarch base = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${base} =l alloc4 ${size}\n")
	let Iarch a = 0
	loop {
		if a >= Iarch(rl.inits.len) then break
		const Str v = emit_expr(rl.inits[a].value, ctx, env)
		const Iarch off = field_offset(ctx.recs, rl.type_name, rl.inits[a].field)
		const Iarch addr = ctx.next
		ctx.next = ctx.next + 1
		write_str(ctx.fd, "\t%t${addr} =l add %t${base}, ${off}\n")
		write_str(ctx.fd, "\tstorew ${v}, %t${addr}\n")
		a = a + 1
	}
	return base
}

# A record literal only appears as a binding initializer (handled in emit_block), so
# it never flows through emit_expr — this arm is an unreachable internal guard.
const emit_record_val = (*Emit ctx, RecLit rl, [Binding] env): Str -> {
	die("cf0: emit: internal: a record literal is only valid as a binding initializer\n")
	return ""
}

# The record type name of a binding initializer if it is a data literal, else "".
const init_rec_type = (Expr e): Str -> match e {
	Expr.Record(rl) -> rl.type_name,
	_ -> ""
}

# Emit a data-literal binding initializer, returning the record's base-pointer temp.
const emit_record_init = (*Emit ctx, Expr e, [Binding] env): Iarch -> match e {
	Expr.Record(rl) -> emit_record_lit(ctx, rl, env),
	_ -> 0 - 1
}

# Emit an `if <cond> then <a> else <b>` value. The branches merge through a stack
# slot (not a phi): evaluate the condition, branch, each arm stores its value into
# the slot, and the join block loads it. Robust under nesting; QBE accepts an
# `alloc` in a non-entry block.
const emit_if = (*Emit ctx, Expr cond, Expr thenE, Expr elseE, [Binding] env): Str -> {
	const Str c = emit_expr(cond, ctx, env)
	const Iarch slot = ctx.next
	ctx.next = ctx.next + 1
	const Iarch lid = ctx.label
	ctx.label = ctx.label + 1
	write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
	write_str(ctx.fd, "\tjnz ${c}, @then${lid}, @else${lid}\n")
	write_str(ctx.fd, "@then${lid}\n")
	const Str a = emit_expr(thenE, ctx, env)
	write_str(ctx.fd, "\tstorew ${a}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@else${lid}\n")
	const Str b = emit_expr(elseE, ctx, env)
	write_str(ctx.fd, "\tstorew ${b}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@end${lid}\n")
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${rt} =w loadw %t${slot}\n")
	return "%t${rt}"
}

# Emit a short-circuit `&&`/`||`. The right operand is emitted in its own block,
# reached only when the left operand does not already settle the result — so a
# side-effecting or non-terminating RHS is genuinely skipped. The result (0/1)
# merges through a slot, like `if`. For `&&`: a false lhs short-circuits to 0; for
# `||`: a true lhs short-circuits to 1; otherwise the result is `rhs != 0`.
const emit_logical = (*Emit ctx, Bool is_and, Expr l, Expr r, [Binding] env): Str -> {
	const Str a = emit_expr(l, ctx, env)
	const Iarch slot = ctx.next
	ctx.next = ctx.next + 1
	const Iarch lid = ctx.label
	ctx.label = ctx.label + 1
	write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
	if is_and then write_str(ctx.fd, "\tjnz ${a}, @rhs${lid}, @sc${lid}\n")
	if !is_and then write_str(ctx.fd, "\tjnz ${a}, @sc${lid}, @rhs${lid}\n")
	write_str(ctx.fd, "@sc${lid}\n")
	if is_and then write_str(ctx.fd, "\tstorew 0, %t${slot}\n")
	if !is_and then write_str(ctx.fd, "\tstorew 1, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@rhs${lid}\n")
	const Str b = emit_expr(r, ctx, env)
	const Iarch bb = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${bb} =w cnew ${b}, 0\n")
	write_str(ctx.fd, "\tstorew %t${bb}, %t${slot}\n")
	write_str(ctx.fd, "\tjmp @end${lid}\n")
	write_str(ctx.fd, "@end${lid}\n")
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	write_str(ctx.fd, "\t%t${rt} =w loadw %t${slot}\n")
	return "%t${rt}"
}

# The index of the function named `name` in `funcs`, or -1 if none.
const find_func = ([Func] funcs, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(funcs.len) then break
		if str_eq(funcs[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}

# Emit a call `callee(args)`. The callee (existence and arity already checked by the
# typecheck phase) is mapped by name to its function index for the QBE symbol. Each
# argument is evaluated into a fresh numbered temp first — so the call line
# references temp NUMBERS, not Str operands (which cannot be stored and reread) —
# then the call is emitted. main's QBE symbol is `$main`; every other function is
# `$f<i>` (positional, so a user name can never collide with `_start`).
const emit_call = (*Emit ctx, Call cl, [Binding] env): Str -> {
	const Iarch fidx = find_func(ctx.funcs, cl.callee)
	if fidx < 0 then die("cf0: emit: internal: unresolved call (should be caught by typecheck)\n")
	const Iarch nargs = Iarch(cl.args.len)
	let [Iarch] tnums = []
	let Iarch i = 0
	loop {
		if i >= nargs then break
		const Str op = emit_expr(cl.args[i], ctx, env)
		const Iarch tt = ctx.next
		ctx.next = ctx.next + 1
		write_str(ctx.fd, "\t%t${tt} =w copy ${op}\n")
		tnums = [...tnums, tt]
		i = i + 1
	}
	const Iarch rt = ctx.next
	ctx.next = ctx.next + 1
	const Bool is_main = str_eq(ctx.funcs[fidx].name, "main")
	write_str(ctx.fd, "\t%t${rt} =w call $")
	if is_main then write_str(ctx.fd, "main")
	if !is_main then write_str(ctx.fd, "f${fidx}")
	write_str(ctx.fd, "(")
	let Iarch j = 0
	loop {
		if j >= Iarch(tnums.len) then break
		if j > 0 then write_str(ctx.fd, ", ")
		const Iarch tj = tnums[j]
		write_str(ctx.fd, "w %t${tj}")
		j = j + 1
	}
	write_str(ctx.fd, ")\n")
	return "%t${rt}"
}

const emit_expr = (Expr e, *Emit ctx, [Binding] env): Str -> match e {
	Expr.Lit(v) -> "${v}",
	Expr.BoolLit(b) -> if b then "1" else "0",
	Expr.Var(name) -> emit_var(ctx, env, name),
	Expr.Record(rl) -> emit_record_val(ctx, rl, env),
	Expr.Field(base, f) -> emit_field(ctx, env, base, f),
	Expr.Neg(x) -> emit_unop(ctx, "sub 0, ", x, "", env),
	Expr.Not(x) -> emit_unop(ctx, "ceqw ", x, ", 0", env),
	Expr.BitNot(x) -> emit_unop(ctx, "xor ", x, ", -1", env),
	Expr.Add(l, r) -> emit_binop(ctx, "add", l, r, env),
	Expr.Sub(l, r) -> emit_binop(ctx, "sub", l, r, env),
	Expr.Mul(l, r) -> emit_binop(ctx, "mul", l, r, env),
	Expr.Div(l, r) -> emit_binop(ctx, "div", l, r, env),
	Expr.Mod(l, r) -> emit_binop(ctx, "rem", l, r, env),
	Expr.BitAnd(l, r) -> emit_binop(ctx, "and", l, r, env),
	Expr.BitOr(l, r) -> emit_binop(ctx, "or", l, r, env),
	Expr.BitXor(l, r) -> emit_binop(ctx, "xor", l, r, env),
	Expr.Shl(l, r) -> emit_binop(ctx, "shl", l, r, env),
	Expr.Shr(l, r) -> emit_binop(ctx, "sar", l, r, env),
	Expr.CmpEq(l, r) -> emit_binop(ctx, "ceqw", l, r, env),
	Expr.CmpNe(l, r) -> emit_binop(ctx, "cnew", l, r, env),
	Expr.CmpLt(l, r) -> emit_binop(ctx, "csltw", l, r, env),
	Expr.CmpGt(l, r) -> emit_binop(ctx, "csgtw", l, r, env),
	Expr.CmpLe(l, r) -> emit_binop(ctx, "cslew", l, r, env),
	Expr.CmpGe(l, r) -> emit_binop(ctx, "csgew", l, r, env),
	Expr.And(l, r) -> emit_logical(ctx, true, l, r, env),
	Expr.Or(l, r) -> emit_logical(ctx, false, l, r, env),
	Expr.If(cond, thenE, elseE) -> emit_if(ctx, cond, thenE, elseE, env),
	Expr.Call(cl) -> emit_call(ctx, cl, env)
}

# --- statement / block emit -----------------------------------------------------------
# A `Stmt` is dispatched by extracting its shape (`match` arms are expressions, so the
# per-kind handling is inlined in `emit_block` after pulling the components out).

const stmt_kind = (Stmt s): Iarch -> match s {
	Stmt.Let(n, m, e) -> 0,
	Stmt.Assign(n, e) -> 1,
	Stmt.FieldAssign(b, f, e) -> 3,
	Stmt.Return(e) -> 2
}
const stmt_name = (Stmt s): Str -> match s {
	Stmt.Let(n, m, e) -> n,
	Stmt.Assign(n, e) -> n,
	Stmt.FieldAssign(b, f, e) -> b,
	Stmt.Return(e) -> ""
}
const stmt_field = (Stmt s): Str -> match s {
	Stmt.Let(n, m, e) -> "",
	Stmt.Assign(n, e) -> "",
	Stmt.FieldAssign(b, f, e) -> f,
	Stmt.Return(e) -> ""
}
# Extract a statement's sub-expression: the initializer of a `Let`, the value of an
# `Assign`, the returned value of a `Return`. Each arm YIELDS the bound payload `e`
# directly — an arena-borrowed alias, sound in cfcc's single never-freed arena — so
# the caller reads it out cleanly rather than the arm having to launder it through
# `emit_expr`.
const stmt_expr = (Stmt s): Expr -> match s {
	Stmt.Let(n, m, e) -> e,
	Stmt.Assign(n, e) -> e,
	Stmt.FieldAssign(b, f, e) -> e,
	Stmt.Return(e) -> e
}

# Emit a block's statements in order, growing the binding environment as `let`/`const`
# locals are declared. The env is seeded with the function's word parameters. Every
# semantic rule (no shadowing, only a mutable name reassigns, a reassignment keeps
# its type, the body returns) was enforced by the typecheck phase, so this walk just
# generates code: a `Let`/`const` allocates a slot and stores; an `Assign` stores
# into the existing slot; a `Return` emits the `ret`.
const emit_block = (*Emit ctx, [Stmt] stmts, [Binding] params): Iarch -> {
	let [Binding] env = []
	let Iarch pi = 0
	loop {
		if pi >= Iarch(params.len) then break
		# rebuild each parameter binding as a fresh record literal — an array element
		# must be fresh, not an alias of the passed-in vector's storage. The field
		# values are read inline (a `Str` cannot be copy-bound to a local).
		env = [...env, Binding({ name: params[pi].name, slot: params[pi].slot, rec_type: "" })]
		pi = pi + 1
	}
	let Iarch i = 0
	loop {
		if i >= Iarch(stmts.len) then break
		const Stmt s = stmts[i]
		const Iarch k = stmt_kind(s)
		if k == 0 then {
			# `const`/`let name = init`. A record initializer (`{…}`) allocates the record
			# and binds the name to its base pointer; a scalar allocates a word slot,
			# stores the value, and binds the name to that slot.
			const Str rt = init_rec_type(stmt_expr(s))
			if str_eq(rt, "") then {
				const Str v = emit_expr(stmt_expr(s), ctx, env)
				const Iarch slot = ctx.next
				ctx.next = ctx.next + 1
				write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
				write_str(ctx.fd, "\tstorew ${v}, %t${slot}\n")
				env = [...env, Binding({ name: stmt_name(s), slot: slot, rec_type: "" })]
			} else {
				const Iarch base = emit_record_init(ctx, stmt_expr(s), env)
				env = [...env, Binding({ name: stmt_name(s), slot: base, rec_type: rt })]
			}
		}
		if k == 1 then {
			# `name = value` — reassign an existing local's slot.
			const Iarch idx = lookup_index(env, stmt_name(s))
			const Iarch slot = env[idx].slot
			const Str v = emit_expr(stmt_expr(s), ctx, env)
			write_str(ctx.fd, "\tstorew ${v}, %t${slot}\n")
		}
		if k == 3 then {
			# `base.field = value` — store the value into the record's field in place.
			# Evaluate the value first (it may read the record's current fields).
			const Str v = emit_expr(stmt_expr(s), ctx, env)
			const Iarch idx = lookup_index(env, stmt_name(s))
			const Iarch slot = env[idx].slot
			const Str rt = env[idx].rec_type
			const Iarch off = field_offset(ctx.recs, rt, stmt_field(s))
			const Iarch addr = ctx.next
			ctx.next = ctx.next + 1
			write_str(ctx.fd, "\t%t${addr} =l add %t${slot}, ${off}\n")
			write_str(ctx.fd, "\tstorew ${v}, %t${addr}\n")
		}
		if k == 2 then {
			const Str v = emit_expr(stmt_expr(s), ctx, env)
			write_str(ctx.fd, "\tret ${v}\n")
		}
		i = i + 1
	}
	return 0
}

# Emit one function: its signature, parameter spills, and body. main is the exported
# `$main` (the entry the floor calls); every other function `idx` is the internal
# `$f<idx>` (positional, so a user name can never collide with `_start`/`_main`).
#
# Parameters are named POSITIONALLY in QBE (`%p<i>`), not by source name — the temp
# only has to match between the signature and the spill, and a Str name cannot be
# interpolated (cfcc interpolates bare identifiers only). A word parameter (Iarch)
# is `w` and spills to a stack slot so it reads like a local, and is bound in the
# env; a pointer parameter (*[Str]) is `l`, rides the signature unused, and is NOT
# bound (the typecheck phase guarantees it is never referenced). All returns are words.
const emit_func = (*Emit ctx, Func fn, Iarch idx): Iarch -> {
	const Bool is_main = str_eq(fn.name, "main")
	if is_main then write_str(ctx.fd, "export function w $main(")
	if !is_main then write_str(ctx.fd, "function w $f${idx}(")
	let Iarch si = 0
	loop {
		if si >= Iarch(fn.params.len) then break
		if si > 0 then write_str(ctx.fd, ", ")
		if fn.params[si].is_ptr then write_str(ctx.fd, "l %p${si}")
		if !fn.params[si].is_ptr then write_str(ctx.fd, "w %p${si}")
		si = si + 1
	}
	write_str(ctx.fd, ") {\n")
	write_str(ctx.fd, "@start\n")
	let [Binding] params = []
	let Iarch pi = 0
	loop {
		if pi >= Iarch(fn.params.len) then break
		if !fn.params[pi].is_ptr then {
			const Iarch slot = ctx.next
			ctx.next = ctx.next + 1
			write_str(ctx.fd, "\t%t${slot} =l alloc4 4\n")
			write_str(ctx.fd, "\tstorew %p${pi}, %t${slot}\n")
			params = [...params, Binding({ name: fn.params[pi].name, slot: slot, rec_type: "" })]
		}
		pi = pi + 1
	}
	emit_block(ctx, fn.body, params)
	write_str(ctx.fd, "}\n")
	return 0
}

# Emit the whole program: every function (main exported, the rest internal), each
# with a fresh temp/label counter, then the freestanding entry floor once. Runs only
# on programs the typecheck phase has accepted.
#
# darwin hands `main` its (argc, argv, envp) in x0/x1/x2 at the entry point, and the
# `_start` floor does nothing before `bl _main`, so those registers flow straight
# through — QBE reads them as `$main`'s declared arguments.
pub const emit_program = (Program prog, Uarch qbe_fd, Uarch asm_fd): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(prog.funcs.len) then break
		let Emit ctx = Emit({ fd: qbe_fd, next: 0, label: 0, funcs: prog.funcs, recs: prog.recs })
		emit_func(&ctx, prog.funcs[i], i)
		i = i + 1
	}
	# asm floor: the freestanding entry. `_start` calls `_main` (argc/argv/envp still
	# in x0/x1/x2 from the kernel), then exit-syscalls its return (in x0).
	write_str(asm_fd, ".globl _start\n")
	write_str(asm_fd, ".p2align 2\n")
	write_str(asm_fd, "_start:\n")
	write_str(asm_fd, "\tbl _main\n")
	write_str(asm_fd, "\tmov x16, #1\n")
	write_str(asm_fd, "\tsvc #0x80\n")
	return 0
}
