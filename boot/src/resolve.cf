# resolve — module resolution and flattening (module_system §8), brick 1.
#
# Loads the entry module and, transitively, every module it imports, then flattens all
# their declarations into one Program for the typecheck and emit phases. Each `import
# "m"` resolves to a file `<dir>/m.cf` and its declarations join the program.
#
# Brick-1 scope (narrowings, each a later brick): destructured imports only; paths
# resolve relative to the ENTRY file's directory — correct for a flat layout, where
# every module sits beside the entry, as cf0's own sources do (the spec resolves each
# import relative to its own importer's directory); no name mangling, so imported
# modules must not collide on a private top-level name; no visibility filtering, so every
# merged declaration is visible (the typecheck phase still rejects a reference to a name
# no module declares); no `std/` root, no namespace aliases, no comptime conditional
# imports.

import "io" as { open, read, close, die, o_rdonly }
import "token" as { Token }
import "ast" as { Expr, Stmt, MatchArm, StmtArm, Seg, FieldInit, RecDecl, UnionDecl, Func, Import, Program }
import "lexer" as { lex }
import "parser" as { Parser, parse_program }

# One module's read buffer size — large enough for cf0's own sources (its largest module,
# emit.cf, is ~77 KB and growing; 256 KB leaves comfortable headroom). A single `read`
# fills it (regular files return the whole requested count); a growable read arrives when a
# module outgrows even this.
pub const mod_cap = 262144

# Byte-wise Str equality (used to dedup already-loaded module paths).
const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

# The directory prefix of a path: its bytes up to and INCLUDING the last `/` (empty when
# the path has no `/`). `import "m"` from `dir/entry.cf` resolves against this prefix.
const dir_of = (Str path): Str -> {
	let Iarch last = 0 - 1
	let Iarch i = 0
	loop {
		if i >= Iarch(path.len) then break
		if Iarch(path[i]) == 47 then last = i
		i = i + 1
	}
	let [Uint8] v = []
	let Iarch k = 0
	loop {
		if k > last then break
		v = [...v, path[k]]
		k = k + 1
	}
	return Str(v)
}

# Build a module file path `<dir><name>.cf`, NUL-terminated for `open` (which reads a C
# string). `dir` already ends in `/` (or is empty). The trailing NUL rides in the sealed
# Str's bytes; `open` stops at it, so the one extra length byte is harmless.
const build_path = (Str dir, Str name): Str -> {
	let [Uint8] v = []
	let Iarch i = 0
	loop {
		if i >= Iarch(dir.len) then break
		v = [...v, dir[i]]
		i = i + 1
	}
	let Iarch j = 0
	loop {
		if j >= Iarch(name.len) then break
		v = [...v, name[j]]
		j = j + 1
	}
	v = [...v, 46]  # '.'
	v = [...v, 99]  # 'c'
	v = [...v, 102] # 'f'
	v = [...v, 0]   # NUL terminator for `open`
	return Str(v)
}

# Read, lex, and parse one module file into its Program. Its read buffer is a local, and
# the parser interns every name into the arena, so the returned Program is self-contained
# and the buffer can be discarded.
const load_module = (Str path): Program -> {
	let [262144 Uint8] buf
	const Iarch fd = open(path.bytes, Uarch(o_rdonly), 0)
	if fd < 0 then die("cf0: cannot open an imported module\n")
	const Iarch n = read(Uarch(fd), buf, Uarch(mod_cap))
	close(Uarch(fd))
	if n < 0 then die("cf0: reading an imported module failed\n")
	const [Token] toks = lex(buf, n)
	let Parser p = Parser({ toks: toks, src: buf, pos: 0 })
	return parse_program(&p)
}

# Has this module path already been loaded (dedup + cycle break)?
const seen = ([Str] loaded, Str path): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(loaded.len) then break
		if str_eq(loaded[i], path) then return true
		i = i + 1
	}
	return false
}

# Append every element of `src` onto `dst` (cf0 has no two-spread merge, so grow one at a
# time). One helper per declaration list — the payload types differ.
const cat_recs = ([RecDecl] dst, [RecDecl] src): [RecDecl] -> {
	let [RecDecl] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}
const cat_unions = ([UnionDecl] dst, [UnionDecl] src): [UnionDecl] -> {
	let [UnionDecl] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}
const cat_funcs = ([Func] dst, [Func] src): [Func] -> {
	let [Func] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}
const cat_imports = ([Import] dst, [Import] src): [Import] -> {
	let [Import] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}

# --- name mangling (module_system §8: flatten mangles module-private names apart) -------
#
# When two modules define a top-level name privately (a `const` helper, not `pub`), the
# flatten would double-define it. So each module's PRIVATE names are renamed with a
# per-module tag (`str_eq` → `str_eq__2`) and every reference to one, within that module,
# is rewritten to match. Exported (`pub`) names are left alone — they are unique across
# modules and are how imports resolve — so an import binds the same bare name the flatten
# keeps. Brick scope: private FUNCTIONS only (cf0's collisions are all private helpers;
# records/unions live once and are imported, never redefined). A private function is only
# ever referenced by a `Call` (cf0 has no function values), so the rewrite renames each
# private `Func` definition and every `Call` callee that names one.

# Is `n` one of this module's private names?
const in_priv = ([Str] priv, Str n): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(priv.len) then break
		if str_eq(priv[i], n) then return true
		i = i + 1
	}
	return false
}

# The mangled form of a callee/definition name: private names gain the module tag; every
# other name (a `pub` export, an imported name, a builtin) is unchanged.
const mangle_name = (Str n, [Str] priv, Iarch tag): Str -> {
	if !in_priv(priv, n) then return n
	return "${n}__${tag}"
}

# Rewrite every private-function reference in an expression tree. Only a `Call` callee can
# name a function; every other node is rebuilt unchanged around its recursively rewritten
# children.
const mangle_expr = (Expr e, [Str] priv, Iarch tag): Expr -> match e {
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	Expr.Var(n) -> Expr.Var(n),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(n, mangle_fields(fs, priv, tag)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(mangle_expr(b, priv, tag), f),
	Expr.UnionMk(t, m, args) -> Expr.UnionMk(t, m, mangle_exprs(args, priv, tag)),
	Expr.Match(scrut, arms) -> Expr.Match(mangle_expr(scrut, priv, tag), mangle_arms(arms, priv, tag)),
	Expr.ArrayLit(hs, sn, elems, et) -> Expr.ArrayLit(hs, mangle_expr(sn, priv, tag), mangle_exprs(elems, priv, tag), et),
	Expr.Index(a, i) -> Expr.Index(a, mangle_expr(i, priv, tag)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, mangle_expr(i, priv, tag), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(mangle_expr(b, priv, tag), mangle_expr(i, priv, tag)),
	Expr.Tuple(elems) -> Expr.Tuple(mangle_exprs(elems, priv, tag)),
	Expr.Spread(x) -> Expr.Spread(mangle_expr(x, priv, tag)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(mangle_stmts(body, priv, tag)),
	Expr.Interp(segs) -> Expr.Interp(mangle_segs(segs, priv, tag)),
	Expr.Buffer(n) -> Expr.Buffer(n),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(mangle_expr(x, priv, tag)),
	Expr.Not(x) -> Expr.Not(mangle_expr(x, priv, tag)),
	Expr.BitNot(x) -> Expr.BitNot(mangle_expr(x, priv, tag)),
	Expr.Add(l, r) -> Expr.Add(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Sub(l, r) -> Expr.Sub(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Mul(l, r) -> Expr.Mul(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Div(l, r) -> Expr.Div(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Mod(l, r) -> Expr.Mod(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.BitOr(l, r) -> Expr.BitOr(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.BitXor(l, r) -> Expr.BitXor(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Shl(l, r) -> Expr.Shl(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Shr(l, r) -> Expr.Shr(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.And(l, r) -> Expr.And(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Or(l, r) -> Expr.Or(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.If(c, t, e2) -> Expr.If(mangle_expr(c, priv, tag), mangle_expr(t, priv, tag), mangle_expr(e2, priv, tag)),
	Expr.Call(n, ta, args) -> Expr.Call(mangle_name(n, priv, tag), ta, mangle_exprs(args, priv, tag))
}

# Rewrite a list of expressions / a data literal's field values / a match's arms.
const mangle_exprs = ([Expr] es, [Str] priv, Iarch tag): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		out = [...out, mangle_expr(es[i], priv, tag)]
		i = i + 1
	}
	return out
}
const mangle_fields = ([FieldInit] fs, [Str] priv, Iarch tag): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: mangle_expr(fs[i].value, priv, tag) })]
		i = i + 1
	}
	return out
}
const mangle_segs = ([Seg] segs, [Str] priv, Iarch tag): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(segs.len) then break
		const Seg sg = segs[i]
		out = [...out, Seg({ is_hole: sg.is_hole, lit: sg.lit, name: sg.name, expr: mangle_expr(sg.expr, priv, tag) })]
		i = i + 1
	}
	return out
}
const mangle_arms = ([MatchArm] arms, [Str] priv, Iarch tag): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [...out, MatchArm({ is_wild: a.is_wild, type_name: a.type_name, members: a.members, binds: a.binds, body: mangle_expr(a.body, priv, tag) })]
		i = i + 1
	}
	return out
}

# Rewrite every private-function reference in a statement (recursing into nested blocks).
const mangle_stmt = (Stmt s, [Str] priv, Iarch tag): Stmt -> match s {
	Stmt.Let(n, m, ann, e) -> Stmt.Let(n, m, ann, mangle_expr(e, priv, tag)),
	Stmt.Destructure(pat, m, e) -> Stmt.Destructure(pat, m, mangle_expr(e, priv, tag)),
	Stmt.Yield(e) -> Stmt.Yield(mangle_expr(e, priv, tag)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, mangle_expr(e, priv, tag)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, mangle_expr(e, priv, tag)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, mangle_expr(i, priv, tag), mangle_expr(v, priv, tag)),
	Stmt.Return(e) -> Stmt.Return(mangle_expr(e, priv, tag)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, mangle_stmts(body, priv, tag)),
	Stmt.Loop(body) -> Stmt.Loop(mangle_stmts(body, priv, tag)),
	Stmt.Break -> Stmt.Break,
	Stmt.Continue -> Stmt.Continue,
	Stmt.IfThen(c, st) -> Stmt.IfThen(mangle_expr(c, priv, tag), mangle_stmt(st, priv, tag)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(mangle_expr(c, priv, tag), mangle_stmt(t, priv, tag), mangle_stmt(e, priv, tag)),
	Stmt.Do(e) -> Stmt.Do(mangle_expr(e, priv, tag)),
	Stmt.Block(stmts) -> Stmt.Block(mangle_stmts(stmts, priv, tag)),
	Stmt.Match(scrut, arms) -> Stmt.Match(mangle_expr(scrut, priv, tag), mangle_stmt_arms(arms, priv, tag))
}
const mangle_stmt_arms = ([StmtArm] arms, [Str] priv, Iarch tag): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [...out, StmtArm({ is_wild: a.is_wild, type_name: a.type_name, members: a.members, binds: a.binds, body: mangle_stmts(a.body, priv, tag) })]
		i = i + 1
	}
	return out
}
const mangle_stmts = ([Stmt] ss, [Str] priv, Iarch tag): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		out = [...out, mangle_stmt(ss[i], priv, tag)]
		i = i + 1
	}
	return out
}

# The private (non-`pub`) function names of a module — the set to mangle. A VALUE const
# (`is_value`) is EXCLUDED: it is referenced as a bare `Var` and auto-called, and the
# reference-rewrite only renames `Call` callees, so mangling its definition would orphan the
# reference. A genuine zero-arg FUNCTION is referenced by `Call` and is mangled normally.
# cf0's value consts are all `pub` anyway, so none collide across modules regardless.
const priv_names = ([Func] fs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		if !fs[i].is_pub then {
			if !fs[i].is_value then out = [...out, fs[i].name]
		}
		i = i + 1
	}
	return out
}

# Mangle one module's functions with tag `tag`: rename each private definition and rewrite
# every private-function reference in every body.
const mangle_funcs = ([Func] fs, Iarch tag): [Func] -> {
	const [Str] priv = priv_names(fs)
	let [Func] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		const Func f = fs[i]
		const Str nm = mangle_name(f.name, priv, tag)
		const [Stmt] body = mangle_stmts(f.body, priv, tag)
		# an asm body references only parameters, never functions — passed through unchanged
		out = [...out, Func({ name: nm, is_pub: f.is_pub, ret_name: f.ret_name, ret_elem: f.ret_elem, params: f.params, body: body, is_asm: f.is_asm, asm_body: f.asm_body, is_value: f.is_value, ret_telems: f.ret_telems, typarams: f.typarams })]
		i = i + 1
	}
	return out
}

# Load the entry module and flatten its transitive import graph into one Program. The
# work list grows as newly loaded modules contribute imports; `loaded` dedups by resolved
# path so a diamond or a cycle loads each module once. Each module's private functions are
# mangled with its own tag so they cannot collide after the flatten.
pub const resolve_program = (Str entry): Program -> {
	const Str dir = dir_of(entry)
	const Program root = load_module(entry)
	let [RecDecl] recs = []
	let [UnionDecl] unions = []
	let [Func] funcs = []
	recs = cat_recs(recs, root.recs)
	unions = cat_unions(unions, root.unions)
	funcs = cat_funcs(funcs, mangle_funcs(root.funcs, 0)) # the entry is module tag 0
	let [Str] loaded = []
	let [Import] work = []
	work = cat_imports(work, root.imports)
	let Iarch tag = 0
	let Iarch wi = 0
	loop {
		if wi >= Iarch(work.len) then break
		const Import im = work[wi]
		const Str mpath = build_path(dir, im.path)
		if !seen(loaded, mpath) then {
			loaded = [...loaded, mpath]
			tag = tag + 1 # a distinct tag per loaded module, so private names cannot collide
			const Program m = load_module(mpath)
			recs = cat_recs(recs, m.recs)
			unions = cat_unions(unions, m.unions)
			funcs = cat_funcs(funcs, mangle_funcs(m.funcs, tag))
			work = cat_imports(work, m.imports)
		}
		wi = wi + 1
	}
	let [Import] none = []
	return Program({ imports: none, recs: recs, unions: unions, funcs: funcs })
}
