# resolve — module resolution and flattening (module_system §8), brick 1.
#
# Loads the entry module and, transitively, every module it imports, then flattens all
# their declarations into one Program for the typecheck and emit phases. Each `import
# "m"` resolves to a file `<dir>/m.cf` and its declarations join the program.
#
# Brick-1 scope (narrowings, each a later brick): destructured imports only; paths
# resolve relative to the ENTRY file's directory — correct for a flat layout, where
# every module sits beside the entry, as cf0's own sources do (the spec resolves each
# import relative to its own importer's directory); no name mangling, so imported
# modules must not collide on a private top-level name; no visibility filtering, so every
# merged declaration is visible (the typecheck phase still rejects a reference to a name
# no module declares); no `std/` root, no namespace aliases, no comptime conditional
# imports.

import "io" as { open, read, close, die, o_rdonly }
import "token" as { Token }
import "ast" as { Expr, Stmt, MatchArm, StmtArm, Seg, FieldInit, RecDecl, UnionDecl, UnionMember, TupElem, Param, Func, Import, Program }
import "lexer" as { lex }
import "typealias" as { strip_type_aliases }
import "parser" as { Parser, parse_program }

# One module's read buffer size — large enough for cf0's own sources (its largest module,
# emit.cf, is ~77 KB and growing; 256 KB leaves comfortable headroom). A single `read`
# fills it (regular files return the whole requested count); a growable read arrives when a
# module outgrows even this.
pub const mod_cap = 262144

# Byte-wise Str equality (used to dedup already-loaded module paths).
const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

# The directory prefix of a path: its bytes up to and INCLUDING the last `/` (empty when
# the path has no `/`). `import "m"` from `dir/entry.cf` resolves against this prefix.
const dir_of = (Str path): Str -> {
	let Iarch last = 0 - 1
	let Iarch i = 0
	loop {
		if i >= Iarch(path.len) then break
		if Iarch(path[i]) == 47 then last = i
		i = i + 1
	}
	let [Uint8] v = []
	let Iarch k = 0
	loop {
		if k > last then break
		v = [...v, path[k]]
		k = k + 1
	}
	return Str(v)
}

# Build a module file path `<dir><name>.cf`, NUL-terminated for `open` (which reads a C
# string). `dir` already ends in `/` (or is empty). The trailing NUL rides in the sealed
# Str's bytes; `open` stops at it, so the one extra length byte is harmless.
const build_path = (Str dir, Str name): Str -> {
	let [Uint8] v = []
	let Iarch i = 0
	loop {
		if i >= Iarch(dir.len) then break
		v = [...v, dir[i]]
		i = i + 1
	}
	let Iarch j = 0
	loop {
		if j >= Iarch(name.len) then break
		v = [...v, name[j]]
		j = j + 1
	}
	v = [...v, 46]  # '.'
	v = [...v, 99]  # 'c'
	v = [...v, 102] # 'f'
	v = [...v, 0]   # NUL terminator for `open`
	return Str(v)
}

# Read, lex, and parse one module file into its Program. Its read buffer is a local, and
# the parser interns every name into the arena, so the returned Program is self-contained
# and the buffer can be discarded.
const load_module = (Str path): Program -> {
	let [262144 Uint8] buf
	const Iarch fd = open(path.bytes, Uarch(o_rdonly), 0)
	if fd < 0 then die("cf0: cannot open an imported module\n")
	const Iarch n = read(Uarch(fd), buf, Uarch(mod_cap))
	close(Uarch(fd))
	if n < 0 then die("cf0: reading an imported module failed\n")
	const [Token] toks = strip_type_aliases(buf, lex(buf, n))
	let Parser p = Parser({ toks: toks, src: buf, pos: 0 })
	return parse_program(&p)
}

# Has this module path already been loaded (dedup + cycle break)?
const seen = ([Str] loaded, Str path): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(loaded.len) then break
		if str_eq(loaded[i], path) then return true
		i = i + 1
	}
	return false
}

# Append every element of `src` onto `dst` (cf0 has no two-spread merge, so grow one at a
# time). One helper per declaration list — the payload types differ.
const cat_recs = ([RecDecl] dst, [RecDecl] src): [RecDecl] -> {
	let [RecDecl] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}
const cat_unions = ([UnionDecl] dst, [UnionDecl] src): [UnionDecl] -> {
	let [UnionDecl] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}
const cat_funcs = ([Func] dst, [Func] src): [Func] -> {
	let [Func] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}
const cat_imports = ([Import] dst, [Import] src): [Import] -> {
	let [Import] out = dst
	let Iarch i = 0
	loop {
		if i >= Iarch(src.len) then break
		out = [...out, src[i]]
		i = i + 1
	}
	return out
}

# --- name mangling (module_system §8: flatten mangles module-private names apart) -------
#
# When two modules define a top-level name privately (a `const` helper, not `pub`), the
# flatten would double-define it. So each module's PRIVATE names are renamed with a
# per-module tag (`str_eq` → `str_eq__2`) and every reference to one, within that module,
# is rewritten to match. Exported (`pub`) names are left alone — they are unique across
# modules and are how imports resolve — so an import binds the same bare name the flatten
# keeps. Brick scope: private FUNCTIONS only (cf0's collisions are all private helpers;
# records/unions live once and are imported, never redefined). A private function is only
# ever referenced by a `Call` (cf0 has no function values), so the rewrite renames each
# private `Func` definition and every `Call` callee that names one.

# Is `n` one of this module's private names?
const in_priv = ([Str] priv, Str n): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(priv.len) then break
		if str_eq(priv[i], n) then return true
		i = i + 1
	}
	return false
}

# The mangled form of a callee/definition name: private names gain the module tag; every
# other name (a `pub` export, an imported name, a builtin) is unchanged.
const mangle_name = (Str n, [Str] priv, Iarch tag): Str -> {
	if !in_priv(priv, n) then return n
	return "${n}__${tag}"
}

# Rewrite every private-function reference in an expression tree. Only a `Call` callee can
# name a function; every other node is rebuilt unchanged around its recursively rewritten
# children.
const mangle_expr = (Expr e, [Str] priv, Iarch tag): Expr -> match e {
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	# a bare name may REFERENCE a private function (passed by name to a higher-order function);
	# rewrite it like a `Call` callee so the reference tracks the mangled definition. A local /
	# value-const name is not in `priv`, so it is left unchanged.
	Expr.Var(n) -> Expr.Var(mangle_name(n, priv, tag)),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(n, mangle_fields(fs, priv, tag)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(mangle_expr(b, priv, tag), f),
	Expr.UnionMk(t, m, args) -> Expr.UnionMk(t, m, mangle_exprs(args, priv, tag)),
	Expr.Match(scrut, arms) -> Expr.Match(mangle_expr(scrut, priv, tag), mangle_arms(arms, priv, tag)),
	Expr.ArrayLit(hs, sn, elems, et) -> Expr.ArrayLit(hs, mangle_expr(sn, priv, tag), mangle_exprs(elems, priv, tag), et),
	Expr.Index(a, i) -> Expr.Index(a, mangle_expr(i, priv, tag)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, mangle_expr(i, priv, tag), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(mangle_expr(b, priv, tag), mangle_expr(i, priv, tag)),
	Expr.Tuple(elems) -> Expr.Tuple(mangle_exprs(elems, priv, tag)),
	Expr.Spread(x) -> Expr.Spread(mangle_expr(x, priv, tag)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(mangle_stmts(body, priv, tag)),
	Expr.Interp(segs) -> Expr.Interp(mangle_segs(segs, priv, tag)),
	Expr.Buffer(sz) -> Expr.Buffer(mangle_expr(sz, priv, tag)),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(mangle_expr(x, priv, tag)),
	Expr.Not(x) -> Expr.Not(mangle_expr(x, priv, tag)),
	Expr.BitNot(x) -> Expr.BitNot(mangle_expr(x, priv, tag)),
	Expr.Add(l, r) -> Expr.Add(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Sub(l, r) -> Expr.Sub(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Mul(l, r) -> Expr.Mul(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Div(l, r) -> Expr.Div(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Mod(l, r) -> Expr.Mod(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.BitOr(l, r) -> Expr.BitOr(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.BitXor(l, r) -> Expr.BitXor(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Shl(l, r) -> Expr.Shl(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Shr(l, r) -> Expr.Shr(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.And(l, r) -> Expr.And(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.Or(l, r) -> Expr.Or(mangle_expr(l, priv, tag), mangle_expr(r, priv, tag)),
	Expr.If(c, t, e2) -> Expr.If(mangle_expr(c, priv, tag), mangle_expr(t, priv, tag), mangle_expr(e2, priv, tag)),
	Expr.Call(n, ta, args) -> Expr.Call(mangle_name(n, priv, tag), ta, mangle_exprs(args, priv, tag)),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(mangle_name(fn, priv, tag), mangle_exprs(args, priv, tag))
}

# Rewrite a list of expressions / a data literal's field values / a match's arms.
const mangle_exprs = ([Expr] es, [Str] priv, Iarch tag): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		out = [...out, mangle_expr(es[i], priv, tag)]
		i = i + 1
	}
	return out
}
const mangle_fields = ([FieldInit] fs, [Str] priv, Iarch tag): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: mangle_expr(fs[i].value, priv, tag) })]
		i = i + 1
	}
	return out
}
const mangle_segs = ([Seg] segs, [Str] priv, Iarch tag): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(segs.len) then break
		const Seg sg = segs[i]
		out = [...out, Seg({ is_hole: sg.is_hole, lit: sg.lit, name: sg.name, expr: mangle_expr(sg.expr, priv, tag) })]
		i = i + 1
	}
	return out
}
const mangle_arms = ([MatchArm] arms, [Str] priv, Iarch tag): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [...out, MatchArm({ is_wild: a.is_wild, type_name: a.type_name, members: a.members, binds: a.binds, body: mangle_expr(a.body, priv, tag) })]
		i = i + 1
	}
	return out
}

# Rewrite every private-function reference in a statement (recursing into nested blocks).
const mangle_stmt = (Stmt s, [Str] priv, Iarch tag): Stmt -> match s {
	Stmt.Let(n, m, ann, e) -> Stmt.Let(n, m, ann, mangle_expr(e, priv, tag)),
	Stmt.Destructure(pat, m, e) -> Stmt.Destructure(pat, m, mangle_expr(e, priv, tag)),
	Stmt.Yield(e) -> Stmt.Yield(mangle_expr(e, priv, tag)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, mangle_expr(e, priv, tag)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, mangle_expr(e, priv, tag)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, mangle_expr(i, priv, tag), mangle_expr(v, priv, tag)),
	Stmt.Return(e) -> Stmt.Return(mangle_expr(e, priv, tag)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, mangle_stmts(body, priv, tag)),
	Stmt.Loop(body) -> Stmt.Loop(mangle_stmts(body, priv, tag)),
	Stmt.Break -> Stmt.Break,
	Stmt.Continue -> Stmt.Continue,
	Stmt.IfThen(c, st) -> Stmt.IfThen(mangle_expr(c, priv, tag), mangle_stmt(st, priv, tag)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(mangle_expr(c, priv, tag), mangle_stmt(t, priv, tag), mangle_stmt(e, priv, tag)),
	Stmt.Do(e) -> Stmt.Do(mangle_expr(e, priv, tag)),
	Stmt.Block(stmts) -> Stmt.Block(mangle_stmts(stmts, priv, tag)),
	Stmt.Match(scrut, arms) -> Stmt.Match(mangle_expr(scrut, priv, tag), mangle_stmt_arms(arms, priv, tag)),
	Stmt.Closure(nm, params, ret, body) -> Stmt.Closure(nm, params, ret, mangle_stmts(body, priv, tag)),
	Stmt.Defer(body) -> Stmt.Defer(mangle_stmts(body, priv, tag))
}
const mangle_stmt_arms = ([StmtArm] arms, [Str] priv, Iarch tag): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [...out, StmtArm({ is_wild: a.is_wild, type_name: a.type_name, members: a.members, binds: a.binds, body: mangle_stmts(a.body, priv, tag) })]
		i = i + 1
	}
	return out
}
const mangle_stmts = ([Stmt] ss, [Str] priv, Iarch tag): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		out = [...out, mangle_stmt(ss[i], priv, tag)]
		i = i + 1
	}
	return out
}

# The private (non-`pub`) function names of a module — the set to mangle. A VALUE const
# (`is_value`) is EXCLUDED: it is referenced as a bare `Var` and auto-called, and the
# reference-rewrite only renames `Call` callees, so mangling its definition would orphan the
# reference. A genuine zero-arg FUNCTION is referenced by `Call` and is mangled normally.
# cf0's value consts are all `pub` anyway, so none collide across modules regardless.
const priv_names = ([Func] fs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		if !fs[i].is_pub then {
			if !fs[i].is_value then out = [...out, fs[i].name]
		}
		i = i + 1
	}
	return out
}

# --- local-name collection --------------------------------------------------------------
#
# A bare `Var` reference is mangled (rewritten to a private function's mangled name) ONLY when
# it is NOT shadowed by a local binding of the same name in the enclosing function. So each
# function's LOCAL names — its parameters plus every binder in its body (a `let`/`const`, a
# destructuring pattern, a `for x in`, a match-arm payload binding) — are collected and removed
# from the private set used to rewrite THAT body. A private function reference (not shadowed)
# still tracks its mangled definition; a local that happens to share a name with a private
# function is left alone (module_system §8: a syntactic mangle must not capture a local).
const no_names = (): [Str] -> { let [Str] e = []  return e }
const cat_names = ([Str] a, [Str] b): [Str] -> {
	let [Str] out = a
	let Iarch i = 0
	loop { if i >= Iarch(b.len) then break  out = [...out, b[i]]  i = i + 1 }
	return out
}
const lnames_exprs = ([Expr] es): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop { if i >= Iarch(es.len) then break  out = cat_names(out, lnames_expr(es[i]))  i = i + 1 }
	return out
}
const lnames_fieldinits = ([FieldInit] fs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop { if i >= Iarch(fs.len) then break  out = cat_names(out, lnames_expr(fs[i].value))  i = i + 1 }
	return out
}
const lnames_segs = ([Seg] segs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop { if i >= Iarch(segs.len) then break  out = cat_names(out, lnames_expr(segs[i].expr))  i = i + 1 }
	return out
}
const lnames_match_arms = ([MatchArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop { if i >= Iarch(arms.len) then break  out = cat_names(cat_names(out, arms[i].binds), lnames_expr(arms[i].body))  i = i + 1 }
	return out
}
const lnames_stmt_arms = ([StmtArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop { if i >= Iarch(arms.len) then break  out = cat_names(cat_names(out, arms[i].binds), lnames_stmts(arms[i].body))  i = i + 1 }
	return out
}
const lnames_stmts = ([Stmt] ss): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop { if i >= Iarch(ss.len) then break  out = cat_names(out, lnames_stmt(ss[i]))  i = i + 1 }
	return out
}
const lnames_expr = (Expr e): [Str] -> match e {
	Expr.Lit(v) -> no_names(),
	Expr.BoolLit(b) -> no_names(),
	Expr.Var(n) -> no_names(),
	Expr.StrLit(bs) -> no_names(),
	Expr.FloatLit(t) -> no_names(),
	Expr.Record(n, fs) -> lnames_fieldinits(fs),
	Expr.Field(b, f) -> no_names(),
	Expr.FieldExpr(b, f) -> lnames_expr(b),
	Expr.UnionMk(t, m, args) -> lnames_exprs(args),
	Expr.Match(scrut, arms) -> cat_names(lnames_expr(scrut), lnames_match_arms(arms)),
	Expr.ArrayLit(hs, sn, elems, et) -> cat_names(lnames_expr(sn), lnames_exprs(elems)),
	Expr.Index(a, i) -> lnames_expr(i),
	Expr.IndexField(a, i, f) -> lnames_expr(i),
	Expr.IndexExpr(b, i) -> cat_names(lnames_expr(b), lnames_expr(i)),
	Expr.Interp(segs) -> lnames_segs(segs),
	Expr.Tuple(elems) -> lnames_exprs(elems),
	Expr.Spread(x) -> lnames_expr(x),
	Expr.Unit -> no_names(),
	Expr.Loop(body) -> lnames_stmts(body),
	Expr.Buffer(sz) -> lnames_expr(sz),
	Expr.Addr(name) -> no_names(),
	Expr.Neg(x) -> lnames_expr(x),
	Expr.Not(x) -> lnames_expr(x),
	Expr.BitNot(x) -> lnames_expr(x),
	Expr.Add(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.Sub(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.Mul(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.Div(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.Mod(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.BitAnd(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.BitOr(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.BitXor(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.Shl(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.Shr(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.CmpEq(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.CmpNe(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.CmpLt(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.CmpGt(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.CmpLe(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.CmpGe(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.And(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.Or(l, r) -> cat_names(lnames_expr(l), lnames_expr(r)),
	Expr.If(c, t, e2) -> cat_names(cat_names(lnames_expr(c), lnames_expr(t)), lnames_expr(e2)),
	Expr.Call(n, ta, args) -> lnames_exprs(args),
	Expr.DeferTap(fn, args) -> lnames_exprs(args)
}
const lnames_stmt = (Stmt s): [Str] -> match s {
	Stmt.Let(n, m, ann, e) -> cat_names([n], lnames_expr(e)),
	Stmt.Destructure(pat, m, e) -> cat_names(pat, lnames_expr(e)),
	Stmt.Assign(n, e) -> lnames_expr(e),
	Stmt.FieldAssign(b, f, e) -> lnames_expr(e),
	Stmt.IndexAssign(a, i, v) -> cat_names(lnames_expr(i), lnames_expr(v)),
	Stmt.Return(e) -> lnames_expr(e),
	Stmt.ForIn(v, a, body) -> cat_names([v], lnames_stmts(body)),
	Stmt.Loop(body) -> lnames_stmts(body),
	Stmt.Break -> no_names(),
	Stmt.Continue -> no_names(),
	Stmt.IfThen(c, st) -> cat_names(lnames_expr(c), lnames_stmt(st)),
	Stmt.IfElse(c, t, e) -> cat_names(cat_names(lnames_expr(c), lnames_stmt(t)), lnames_stmt(e)),
	Stmt.Do(e) -> lnames_expr(e),
	Stmt.Block(ss) -> lnames_stmts(ss),
	Stmt.Match(scrut, arms) -> cat_names(lnames_expr(scrut), lnames_stmt_arms(arms)),
	Stmt.Yield(e) -> lnames_expr(e),
	Stmt.Closure(nm, params, ret, body) -> cat_names(cat_names([nm], param_name_list(params)), lnames_stmts(body)),
	Stmt.Defer(body) -> lnames_stmts(body)
}
# A function's parameter names.
const param_name_list = ([Param] ps): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop { if i >= Iarch(ps.len) then break  out = [...out, ps[i].name]  i = i + 1 }
	return out
}
# `priv` minus any name shadowed by a local (`names`) — the set to rewrite in one body.
const priv_minus = ([Str] priv, [Str] names): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(priv.len) then break
		if !in_priv(names, priv[i]) then out = [...out, priv[i]]
		i = i + 1
	}
	return out
}

# Mangle one module's functions with tag `tag`: rename each private definition and rewrite
# every private-function reference in every body — but not a reference shadowed by a local.
const mangle_funcs = ([Func] fs, Iarch tag): [Func] -> {
	const [Str] priv = priv_names(fs)
	let [Func] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		const Func f = fs[i]
		const Str nm = mangle_name(f.name, priv, tag)
		# a name bound locally in THIS function (a parameter or any body binder) shadows a private
		# function of the same name, so it is excluded from the set this body's references rewrite
		const [Str] locals = cat_names(param_name_list(f.params), lnames_stmts(f.body))
		const [Str] bodypriv = priv_minus(priv, locals)
		const [Stmt] body = mangle_stmts(f.body, bodypriv, tag)
		# an asm body references only parameters, never functions — passed through unchanged
		out = [...out, Func({ name: nm, is_pub: f.is_pub, ret_name: f.ret_name, ret_elem: f.ret_elem, params: f.params, body: body, is_asm: f.is_asm, asm_body: f.asm_body, is_value: f.is_value, ret_telems: f.ret_telems, typarams: f.typarams, tbounds: f.tbounds })]
		i = i + 1
	}
	return out
}

# --- declaration spread (data/union), type_system §8 -------------------------------------
#
# A `data Ext = { ...Src, … }` splices record `Src`'s fields in place; a `union Big = {
# ...Src, … }` splices union `Src`'s members. The parser leaves a sentinel — a record field
# with ftype "$spread" (its source name in the field slot), or a union member with payloads
# == ["$spread"] (its source name in the member `name`). This pass, run after the flatten so
# every source declaration is visible, replaces each sentinel with the source's (recursively
# expanded) fields/members. The source must be a CONCRETE record (resp. union): a generic
# template is rejected, as is a cross-kind or duplicate-name splice.

# Index of a record / union by name, or -1 when absent.
const find_rec = ([RecDecl] recs, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(recs.len) then break
		if str_eq(recs[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}
const find_union = ([UnionDecl] unions, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(unions.len) then break
		if str_eq(unions[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}

# Whether a name already appears among the accumulated field / member names (collision).
const has_name = ([Str] names, Str name): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(names.len) then break
		if str_eq(names[i], name) then return true
		i = i + 1
	}
	return false
}

# Whether a union member is a spread sentinel (`payloads` is exactly `["$spread"]`).
const is_spread_member = (UnionMember m): Bool -> {
	if Iarch(m.payloads.len) != 1 then return false
	return str_eq(m.payloads[0], "$spread")
}

# A builtin non-aggregate type name — composing a bare union member over one of these is a
# deferred later brick (a compose-over LEAF like `Int8` needs the member usable as a standalone
# type argument; see the bound machinery). A bare member naming one is rejected (test 209).
const is_builtin_scalar_name = (Str n): Bool -> {
	if str_eq(n, "Iarch") then return true
	if str_eq(n, "Uarch") then return true
	if str_eq(n, "Int") then return true
	if str_eq(n, "Int8") then return true
	if str_eq(n, "Int16") then return true
	if str_eq(n, "Int32") then return true
	if str_eq(n, "Int64") then return true
	if str_eq(n, "Uint8") then return true
	if str_eq(n, "Uint16") then return true
	if str_eq(n, "Uint32") then return true
	if str_eq(n, "Uint64") then return true
	if str_eq(n, "Float32") then return true
	if str_eq(n, "Float64") then return true
	if str_eq(n, "Bool") then return true
	if str_eq(n, "Str") then return true
	return false
}

# §8.1 resolve-or-create: a BARE union member (no explicit payload) whose NAME denotes a declared
# record or union COMPOSES OVER it — the member carries that type as its single payload, so the
# value IS a value of that type (payload-is-the-value, §8.3), reachable as `U.Name(v)` /
# `match … { U.Name(v) -> … }` on the existing payload-member path. A name denoting nothing stays a
# fresh nullary tag (`Nil`, `Nothing`, `Red`). Composing over a builtin scalar is deferred (209).
# This is deliberately SCOPE-SENSITIVE (§8.1): a member whose name matches a type in scope IS that
# type. Runs inside `expand_union`, so both direct and spliced members are resolved.
const compose_member = (UnionMember mem, [RecDecl] recs, [UnionDecl] unions): UnionMember -> {
	if Iarch(mem.payloads.len) > 0 then return mem
	const Str nm = mem.name
	let Bool is_type = false
	if find_rec(recs, nm) >= 0 then is_type = true
	if find_union(unions, nm) >= 0 then is_type = true
	if is_type then {
		const [Str] ps = [nm]
		const [Str] pe = [""]
		const [TupElem] empty_tel = []
		const [[TupElem]] pt = [empty_tel]
		return UnionMember({ name: nm, payloads: ps, pelems: pe, ptelems: pt })
	}
	if is_builtin_scalar_name(nm) then die("cf0: type: a union member composing over a builtin type is not yet supported\n")
	return mem
}

# Expand a record's declaration spreads into a flat field set. Each `$spread` sentinel names
# a source record; the source is looked up (must be a concrete record), recursively expanded,
# and its fields spliced in place — preserving order and rejecting name collisions. The depth
# guard turns an accidental spread cycle into a clean error instead of a hang.
const expand_rec = (RecDecl d, [RecDecl] recs, [UnionDecl] unions, Iarch depth): RecDecl -> {
	if depth > 64 then die("cf0: spread: a record spread cycle\n")
	let [Str] fields = []
	let [Str] ftypes = []
	let [Str] felems = []
	let [[TupElem]] ftelems = []
	let Iarch k = 0
	loop {
		if k >= Iarch(d.fields.len) then break
		if str_eq(d.ftypes[k], "$spread") then {
			const Str src = d.fields[k]
			const Iarch si = find_rec(recs, src)
			if si < 0 then {
				if find_union(unions, src) >= 0 then die("cf0: spread: a record can only spread a record, not a union\n")
				die("cf0: spread: `...` names an undeclared record\n")
			}
			const RecDecl srd = recs[si]
			if Iarch(srd.typarams.len) > 0 then die("cf0: spread: cannot spread a generic record template\n")
			const RecDecl ex = expand_rec(srd, recs, unions, depth + 1)
			let Iarch j = 0
			loop {
				if j >= Iarch(ex.fields.len) then break
				if has_name(fields, ex.fields[j]) then die("cf0: spread: a spliced field collides with an existing field\n")
				fields = [...fields, ex.fields[j]]
				ftypes = [...ftypes, ex.ftypes[j]]
				felems = [...felems, ex.felems[j]]
				ftelems = [...ftelems, ex.ftelems[j]]
				j = j + 1
			}
		} else {
			if has_name(fields, d.fields[k]) then die("cf0: spread: a field collides with a spliced field\n")
			fields = [...fields, d.fields[k]]
			ftypes = [...ftypes, d.ftypes[k]]
			felems = [...felems, d.felems[k]]
			ftelems = [...ftelems, d.ftelems[k]]
		}
		k = k + 1
	}
	return RecDecl({ name: d.name, fields: fields, ftypes: ftypes, felems: felems, ftelems: ftelems, typarams: d.typarams, tbounds: d.tbounds })
}

# Expand a union's member spreads into a flat member set, mirroring `expand_rec`.
const expand_union = (UnionDecl d, [RecDecl] recs, [UnionDecl] unions, Iarch depth): UnionDecl -> {
	if depth > 64 then die("cf0: spread: a union spread cycle\n")
	let [UnionMember] members = []
	let [Str] names = []
	let Iarch k = 0
	loop {
		if k >= Iarch(d.members.len) then break
		const UnionMember mem = d.members[k]
		if is_spread_member(mem) then {
			const Str src = mem.name
			const Iarch si = find_union(unions, src)
			if si < 0 then {
				if find_rec(recs, src) >= 0 then die("cf0: spread: a union can only spread a union, not a record\n")
				die("cf0: spread: `...` names an undeclared union\n")
			}
			const UnionDecl sud = unions[si]
			if Iarch(sud.typarams.len) > 0 then die("cf0: spread: cannot spread a generic union template\n")
			const UnionDecl ex = expand_union(sud, recs, unions, depth + 1)
			let Iarch j = 0
			loop {
				if j >= Iarch(ex.members.len) then break
				if has_name(names, ex.members[j].name) then die("cf0: spread: a spliced member collides with an existing member\n")
				members = [...members, ex.members[j]]
				names = [...names, ex.members[j].name]
				j = j + 1
			}
		} else {
			const UnionMember cm = compose_member(mem, recs, unions)
			if has_name(names, cm.name) then die("cf0: spread: a member collides with a spliced member\n")
			members = [...members, cm]
			names = [...names, cm.name]
		}
		k = k + 1
	}
	return UnionDecl({ name: d.name, members: members, typarams: d.typarams, tbounds: d.tbounds })
}

# Expand every record / union declaration's spreads. Lookups use the raw (pre-expansion)
# lists; `expand_rec`/`expand_union` re-expand a source on demand, so ordering is irrelevant.
const expand_recs = ([RecDecl] recs, [UnionDecl] unions): [RecDecl] -> {
	let [RecDecl] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(recs.len) then break
		out = [...out, expand_rec(recs[i], recs, unions, 0)]
		i = i + 1
	}
	return out
}
const expand_unions = ([UnionDecl] unions, [RecDecl] recs): [UnionDecl] -> {
	let [UnionDecl] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(unions.len) then break
		out = [...out, expand_union(unions[i], recs, unions, 0)]
		i = i + 1
	}
	return out
}

# --- member-type annotations (§8.1): validate + collapse `Union.Member` to `Union` -------------
# A member is a first-class type usable anywhere a type is (`Color.Red`, `Maybe[Iarch].Just`), but
# it DENOTES its union — cf0 collapses it to that union (a member value already widens to its union).
# The parser preserved the `Base.Member` spelling; this pass (run after expand, before monomorph)
# validates the member against the now-visible union tables and rewrites the annotation to `Base`.

# Index of the first byte `b` in `t`, or -1. A type name has no `.` except a member-type's one.
const index_of_byte = (Str t, Iarch b): Iarch -> {
	let Iarch i = 0
	loop { if i >= Iarch(t.len) then break  if Iarch(t[i]) == b then return i  i = i + 1 }
	return 0 - 1
}
const str_prefix = (Str t, Iarch k): Str -> {
	let [Uint8] v = []
	let Iarch i = 0
	loop { if i >= k then break  v = [...v, t[i]]  i = i + 1 }
	return Str(v)
}
const str_suffix = (Str t, Iarch k): Str -> {
	let [Uint8] v = []
	let Iarch i = k
	loop { if i >= Iarch(t.len) then break  v = [...v, t[i]]  i = i + 1 }
	return Str(v)
}
const union_has_mem = (UnionDecl u, Str member): Bool -> {
	let Iarch i = 0
	loop { if i >= Iarch(u.members.len) then break  if str_eq(u.members[i].name, member) then return true  i = i + 1 }
	return false
}
# Collapse a member-type annotation to its union, validating base + member (§8.1). `Color.Red` →
# `Color`; `Maybe[Iarch].Just` → `Maybe[Iarch]`. A plain type (no `.`) is returned unchanged, so
# this is a no-op on every ordinary annotation. Rejects a record base (685) or an unknown member (684).
const collapse_member_type = (Str t, [RecDecl] recs, [UnionDecl] unions): Str -> {
	const Iarch d = index_of_byte(t, 46)
	if d < 0 then return t
	const Str base = str_prefix(t, d)
	const Str member = str_suffix(t, d + 1)
	const Iarch lb = index_of_byte(base, 91)   # `[` — strip a generic application to the union name
	let Str uname = base
	if lb >= 0 then uname = str_prefix(base, lb)
	const Iarch ui = find_union(unions, uname)
	if ui < 0 then {
		if find_rec(recs, uname) >= 0 then die("cf0: type: a member type requires a union base (a record has no members)\n")
		die("cf0: type: a member type names an unknown union\n")
	}
	if !union_has_mem(unions[ui], member) then die("cf0: type: a member type names a non-member of its union\n")
	return base
}
# Rewrite every member-type annotation in a statement (a binding's `ann`), recursing into nested
# statement containers. NOT covered (each a later brick, and each fails LOUD at typecheck/monomorph
# — a dotted type is an unknown type — never a miscompile): an annotation buried in a value-yielding
# EXPRESSION (`loop`/`if`/block that yields), and a CLOSURE parameter/return type (monomorph likewise
# skips those, so a closure already rejects even a plain generic-app annotation there).
const norm_mt_stmt = (Stmt s, [RecDecl] recs, [UnionDecl] unions): Stmt -> match s {
	Stmt.Let(n, m, ann, e) -> Stmt.Let(n, m, collapse_member_type(ann, recs, unions), e),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, norm_mt_stmts(body, recs, unions)),
	Stmt.Loop(body) -> Stmt.Loop(norm_mt_stmts(body, recs, unions)),
	Stmt.IfThen(c, st) -> Stmt.IfThen(c, norm_mt_stmt(st, recs, unions)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(c, norm_mt_stmt(t, recs, unions), norm_mt_stmt(e, recs, unions)),
	Stmt.Block(stmts) -> Stmt.Block(norm_mt_stmts(stmts, recs, unions)),
	Stmt.Match(scrut, arms) -> Stmt.Match(scrut, norm_mt_stmt_arms(arms, recs, unions)),
	Stmt.Closure(nm, params, ret, body) -> Stmt.Closure(nm, params, ret, norm_mt_stmts(body, recs, unions)),
	Stmt.Defer(body) -> Stmt.Defer(norm_mt_stmts(body, recs, unions)),
	_ -> s
}
const norm_mt_stmts = ([Stmt] ss, [RecDecl] recs, [UnionDecl] unions): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = 0
	loop { if i >= Iarch(ss.len) then break  out = [...out, norm_mt_stmt(ss[i], recs, unions)]  i = i + 1 }
	return out
}
const norm_mt_stmt_arms = ([StmtArm] arms, [RecDecl] recs, [UnionDecl] unions): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [...out, StmtArm({ is_wild: a.is_wild, type_name: a.type_name, members: a.members, binds: a.binds, body: norm_mt_stmts(a.body, recs, unions) })]
		i = i + 1
	}
	return out
}
# Collapse the member-type annotations in a function's parameters, return type, and body bindings.
const norm_mt_func = (Func f, [RecDecl] recs, [UnionDecl] unions): Func -> {
	let [Param] ps = []
	let Iarch i = 0
	loop {
		if i >= Iarch(f.params.len) then break
		const Param p = f.params[i]
		ps = [...ps, Param({ name: p.name, is_ptr: p.is_ptr, type_name: collapse_member_type(p.type_name, recs, unions), elem: p.elem, telems: p.telems })]
		i = i + 1
	}
	return Func({ name: f.name, is_pub: f.is_pub, ret_name: collapse_member_type(f.ret_name, recs, unions), ret_elem: f.ret_elem, params: ps, body: norm_mt_stmts(f.body, recs, unions), is_asm: f.is_asm, asm_body: f.asm_body, is_value: f.is_value, ret_telems: f.ret_telems, typarams: f.typarams, tbounds: f.tbounds })
}
const norm_mt_funcs = ([Func] fs, [RecDecl] recs, [UnionDecl] unions): [Func] -> {
	let [Func] out = []
	let Iarch i = 0
	loop { if i >= Iarch(fs.len) then break  out = [...out, norm_mt_func(fs[i], recs, unions)]  i = i + 1 }
	return out
}

# Reject a user record/union that redeclares a builtin type name (`Bool`, `Str`, `Unit`, or a
# numeric width) — those names are reserved (§8.6), and `Bool` in particular is the injected union.
const reject_builtin_type_names = ([RecDecl] recs, [UnionDecl] unions): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(recs.len) then break
		if is_builtin_scalar_name(recs[i].name) then die("cf0: type: a record may not redeclare a builtin type name\n")
		if str_eq(recs[i].name, "Unit") then die("cf0: type: a record may not redeclare a builtin type name\n")
		i = i + 1
	}
	let Iarch j = 0
	loop {
		if j >= Iarch(unions.len) then break
		if is_builtin_scalar_name(unions[j].name) then die("cf0: type: a union may not redeclare a builtin type name\n")
		if str_eq(unions[j].name, "Unit") then die("cf0: type: a union may not redeclare a builtin type name\n")
		j = j + 1
	}
	return 0
}

# Load the entry module and flatten its transitive import graph into one Program. The
# work list grows as newly loaded modules contribute imports; `loaded` dedups by resolved
# path so a diamond or a cycle loads each module once. Each module's private functions are
# mangled with its own tag so they cannot collide after the flatten.
pub const resolve_program = (Str entry): Program -> {
	const Str dir = dir_of(entry)
	const Program root = load_module(entry)
	let [RecDecl] recs = []
	let [UnionDecl] unions = []
	let [Func] funcs = []
	recs = cat_recs(recs, root.recs)
	unions = cat_unions(unions, root.unions)
	funcs = cat_funcs(funcs, mangle_funcs(root.funcs, 0)) # the entry is module tag 0
	let [Str] loaded = []
	let [Import] work = []
	work = cat_imports(work, root.imports)
	let Iarch tag = 0
	let Iarch wi = 0
	loop {
		if wi >= Iarch(work.len) then break
		const Import im = work[wi]
		const Str mpath = build_path(dir, im.path)
		if !seen(loaded, mpath) then {
			loaded = [...loaded, mpath]
			tag = tag + 1 # a distinct tag per loaded module, so private names cannot collide
			const Program m = load_module(mpath)
			recs = cat_recs(recs, m.recs)
			unions = cat_unions(unions, m.unions)
			funcs = cat_funcs(funcs, mangle_funcs(m.funcs, tag))
			work = cat_imports(work, m.imports)
		}
		wi = wi + 1
	}
	let [Import] none = []
	# a user type may not redeclare a builtin (`Bool`/`Str`/`Iarch`/`Int8`/… — the names are
	# reserved, §8.6); checked on the raw decls before expansion/injection
	reject_builtin_type_names(recs, unions)
	# expand declaration spreads now that every source record/union is visible
	const [RecDecl] erecs = expand_recs(recs, unions)
	const [UnionDecl] eunions = expand_unions(unions, recs)
	# collapse member-type annotations (`Color.Red` → `Color`, §8.1) against the expanded tables,
	# before monomorph sees the signatures — validating the base union and member
	const [Func] nfuncs = norm_mt_funcs(funcs, erecs, eunions)
	return Program({ imports: none, recs: erecs, unions: eunions, funcs: nfuncs })
}
