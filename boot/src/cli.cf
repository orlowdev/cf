# cli — the ONE place cf reads its command line.
#
# Per the argv/env discipline: argv is consumed here, next to `main`, into a
# typed record of exactly what cf accepts. Every downstream phase receives
# explicit typed values (a path, an fd) — never `argv`. No other module reaches
# into the command line.
#
# argv arrives as a real cf `[Str]` — `main([Str] args)`. The freestanding floor
# (`_start`) converts the OS's raw `(argc, char** argv)` into this vector, wrapping
# each C-string in a `{bytes, len}` Str header that BORROWS the argv bytes (already
# NUL-terminated). `args[i].bytes` is that NUL-terminated pointer, which feeds `open`
# directly at the syscall boundary. cf keeps ALL argv access here.

import "io" as { exit, eprint }

# cf's parsed command line. THROWAWAY shape for the tracer bullet: cf emits
# QBE IL + an asm floor to two explicit output paths (it cannot yet spawn
# qbe/cc itself — process-spawn is deferred to the external driver). Each path is
# the argv `Str`; the caller passes its `.bytes` to `open`.
#   cf [--target <os>-<arch>] <input.cf> <out.qbe> <out.s>
# `target_os`/`target_arch` are the `Os`/`Arch` variant names the build targets — `comptime.os`/
# `comptime.arch` compare against them to select a platform floor. They come from `--target`,
# defaulting to the host cf was built for (darwin/arm64).
pub data Cli = { Str input, Str out_qbe, Str out_asm, Str target_os, Str target_arch }

const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

# `[--target <os>-<arch>] <input.cf> <out.qbe> <out.s>`. `--target` selects the platform (default:
# the host, `darwin-arm64`); the three positional paths follow. The `!` algebra and root rule are
# validated unconditionally.
pub const cli_parse = ([Str] args): Cli -> {
	let Str tos = "Darwin"
	let Str tarch = "Arm64"
	let Iarch base = 1
	if Iarch(args.len) > 2 && str_eq(args[1], "--target") then {
		const Str t = args[2]
		let Bool known = false
		if str_eq(t, "darwin-arm64") then {
			tos = "Darwin"
			tarch = "Arm64"
			known = true
		}
		if str_eq(t, "linux-arm64") then {
			tos = "Linux"
			tarch = "Arm64"
			known = true
		}
		if str_eq(t, "bare-arm64") then {
			tos = "Bare"
			tarch = "Arm64"
			known = true
		}
		if !known then eprint("cf: unknown --target (expected `darwin-arm64`, `linux-arm64`, or `bare-arm64`)\n")
		if !known then exit(2)
		base = 3
	}
	if Iarch(args.len) < base + 3 then eprint("cf: usage: cf [--target <os>-<arch>] <input.cf> <out.qbe> <out.s>\n")
	if Iarch(args.len) < base + 3 then exit(2)
	return Cli({ input: args[base], out_qbe: args[base + 1], out_asm: args[base + 2], target_os: tos, target_arch: tarch })
}
