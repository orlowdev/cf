# cli — the ONE place cf0 reads its command line.
#
# Per the argv/env discipline: argv is consumed here, next to `main`, into a
# typed record of exactly what cf0 accepts. Every downstream phase receives
# explicit typed values (a path, an fd) — never `argv`. No other module reaches
# into the command line.
#
# argv arrives as `*[Iarch]` — the darwin `char**` viewed as an array of
# pointer-width words (A6 makes `*[Iarch]` indexable). `argv[i]` is the i-th
# C-string pointer as an integer; cast to `Uarch` it feeds `open` directly (a
# path is an opaque NUL-terminated byte pointer — no cf `Str` needed at the
# open boundary). cfcc's `*[Str] argv` is a non-indexable half-promise and,
# worse, semantically wrong (argv is not an array of cf `{buf,len}` headers), so
# cf0 models argv honestly as raw pointer words.

import "io" as { exit, eprint }

# cf0's parsed command line. THROWAWAY shape for the tracer bullet: cf0 emits
# QBE IL + an asm floor to two explicit output paths (it cannot yet spawn
# qbe/cc itself — process-spawn is deferred to the external driver). Paths are
# raw `Uarch` C-string pointers, the only thing `open` needs.
#   cf0 <input.cf> <out.qbe> <out.s>
pub data Cli = { Uarch input, Uarch out_qbe, Uarch out_asm }

pub const cli_parse = (Iarch argc, *[Iarch] argv): Cli -> {
	if argc < 4 then eprint("cf0: usage: cf0 <input.cf> <out.qbe> <out.s>\n")
	if argc < 4 then exit(2)
	return Cli({ input: Uarch(argv[1]), out_qbe: Uarch(argv[2]), out_asm: Uarch(argv[3]) })
}
