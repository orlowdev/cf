# cli — the ONE place cf reads its command line.
#
# Per the argv/env discipline: argv is consumed here, next to `main`, into a
# typed record of exactly what cf accepts. Every downstream phase receives
# explicit typed values (a path, an fd) — never `argv`. No other module reaches
# into the command line.
#
# argv arrives as a real cf `[Str]` — `main([Str] args)`. The freestanding floor
# (`_start`) converts the OS's raw `(argc, char** argv)` into this vector, wrapping
# each C-string in a `{bytes, len}` Str header that BORROWS the argv bytes (already
# NUL-terminated). `args[i].bytes` is that NUL-terminated pointer, which feeds `open`
# directly at the syscall boundary. cf keeps ALL argv access here.

import "io" as { exit, eprint }

# cf's parsed command line. THROWAWAY shape for the tracer bullet: cf emits
# QBE IL + an asm floor to two explicit output paths (it cannot yet spawn
# qbe/cc itself — process-spawn is deferred to the external driver). Each path is
# the argv `Str`; the caller passes its `.bytes` to `open`.
#   cf <input.cf> <out.qbe> <out.s>
pub data Cli = { Str input, Str out_qbe, Str out_asm, Bool check_alloc, Bool suggest_alloc, Bool check_root }

const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}

# `[--check-alloc | --suggest-alloc] <input.cf> <out.qbe> <out.s>`. An optional leading flag drives
# the `!` allocation algebra (alloc.cf): `--check-alloc` validates the marker both ways;
# `--suggest-alloc` prints the functions that need a `!` (Stage C rollout tooling) and emits nothing.
# cf's own build passes neither, so its still-unmarked source compiles unchanged.
pub const cli_parse = ([Str] args): Cli -> {
	let Bool check = false
	let Bool suggest = false
	let Bool root = false
	let Iarch base = 1
	if Iarch(args.len) > 1 && str_eq(args[1], "--check-alloc") then {
		check = true
		base = 2
	}
	if Iarch(args.len) > 1 && str_eq(args[1], "--suggest-alloc") then {
		suggest = true
		base = 2
	}
	# `--check-root` (memory_model §2): reject residue allocated on the ROOT page — a program must
	# graft a geometry (`in`) before any `!` code runs. Opt-in during rollout, like `--check-alloc`.
	if Iarch(args.len) > 1 && str_eq(args[1], "--check-root") then {
		root = true
		base = 2
	}
	if Iarch(args.len) < base + 3 then eprint("cf: usage: cf [--check-alloc | --suggest-alloc | --check-root] <input.cf> <out.qbe> <out.s>\n")
	if Iarch(args.len) < base + 3 then exit(2)
	return Cli({ input: args[base], out_qbe: args[base + 1], out_asm: args[base + 2], check_alloc: check, suggest_alloc: suggest, check_root: root })
}
