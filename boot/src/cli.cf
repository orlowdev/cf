# cli — the ONE place cf reads its command line.
#
# Per the argv/env discipline: argv is consumed here, next to `main`, into a
# typed record of exactly what cf accepts. Every downstream phase receives
# explicit typed values (a path, an fd) — never `argv`. No other module reaches
# into the command line.
#
# argv arrives as a real cf `[Str]` — `main([Str] args)`. The freestanding floor
# (`_start`) converts the OS's raw `(argc, char** argv)` into this vector, wrapping
# each C-string in a `{bytes, len}` Str header that BORROWS the argv bytes (already
# NUL-terminated). `args[i].bytes` is that NUL-terminated pointer, which feeds `open`
# directly at the syscall boundary. cf keeps ALL argv access here.

import std::io::console::{ eprint }
import std::data::str::{ eq }
import std::process::{ exit }
import std::sys::{ Os, Arch, host_arch_tag }
import std::comptime::os

# cf's parsed command line. THROWAWAY shape for the tracer bullet: cf emits
# QBE IL + an asm floor to two explicit output paths (it cannot yet spawn
# qbe/cc itself — process-spawn is deferred to the external driver). Each path is
# the argv `Str`; the caller passes its `.bytes` to `open`.
#   cf [--target <os>-<arch>] [--root-size <bytes>] <input.cf> <out.qbe> <out.s>
# `target_os`/`target_arch` are the `Os`/`Arch` variant names the build targets — `comptime::os`/
# `comptime::arch` compare against them to select a platform floor. They come from `--target`,
# defaulting to the host cf was built for (`os::target`/`arch::target`, folded in at comptime).
# `root_size` is the byte size of the `Bare` target's static root page (BSS), default 1 MiB. `0`
# is a special ZERO-ROOT mode: the binary provably never touches the page (allocation is a compile
# error) — everything must live in `$`-stack, `static` BSS, or a `fixed_buffer`. Ignored off `Bare`.
# `dump_routing` (KEPT — the classification drives codegen now, so the dump is the standing
# inspection hatch): prints each lowered function's shadow escape/alias sets and summary bits.
# `full` selects the self-contained pipeline (`cf <input.cf> -o <output>`): cf compiles, runs the
# EMBEDDED QBE backend, and spawns the system `cc` to produce `output` — no external qbe/driver. In
# that mode `out_qbe`/`out_asm` are unused (cf picks temp paths) and `output` is the final binary;
# `preserve` (`-P`) keeps the intermediates. Without `-o` it stays the legacy 3-path emit-IL form
# the
# bootstrap (build.sh/reseed.sh) depends on: emit QBE IL + the asm floor to `out_qbe`/`out_asm`.
pub data Cli = {
	Str input,
	Str out_qbe,
	Str out_asm,
	Os target_os,
	Arch target_arch,
	Iarch root_size,
	Bool dump_routing,
	Bool no_inline,
	Bool debug,
	Bool instrument,
	Bool full,
	Str output,
	Bool preserve,
	Bool skip_embeds,
	Str build_version,
}

# The parsed `format` subcommand line: the target `path` and the `--check` gate (cf_cli §7).
pub data FmtCli = { Str path, Bool check }

# Is this a `cf format`/`cf f` invocation? (The subcommand name is the FIRST argument after the
# program name.) Every other first argument — a flag or a path — is the legacy positional compile
# call, left exactly as it was so the bootstrap driver and reseed keep working.
pub const is_fmt_cmd = ([Str] args): Bool -> {
	if Iarch(args.len) < 2 then return false
	const Str cmd = args[1]

	return eq(cmd, "format") || eq(cmd, "f")
}

# Is this a bare `cf --version`/`cf -V` query? It prints the compiler's OWN version and exits
# (handled
# in `main`) — distinct from `--set-version <v>`, which stamps the version of the program BEING
# compiled.
# The token short-circuits wherever it appears, matching the usual `--version` convention.
pub const is_version_cmd = ([Str] args): Bool -> {
	let Iarch i = 1

	loop {
		if i >= Iarch(args.len) then break
		const Str a = args[i]
		if eq(a, "--version") || eq(a, "-V") then return true
		i = i + 1
	}

	return false
}

# Is this a help request? Bare `cf` (no command at all), a leading `help` word, or a `--help`/`-h`
# anywhere. `main` prints the full help and exits 0 before any parsing — so `--help` never reaches
# `cli_parse` to be mistaken for a stray positional (the old bug: it fell through to a misleading
# usage line). The bootstrap always passes an input path plus outputs, so it never trips this.
pub const is_help_cmd = ([Str] args): Bool -> {
	if Iarch(args.len) < 2 then return true
	if eq(args[1], "help") then return true

	let Iarch i = 1

	loop {
		if i >= Iarch(args.len) then break
		const Str a = args[i]
		if eq(a, "--help") || eq(a, "-h") then return true
		i = i + 1
	}

	return false
}

# Parse `cf format [--check] <file>` — the arguments after the subcommand name (index 2 on).
# `--check` may appear in any position; the one positional argument is the file path.
pub const fmt_cli_parse = ([Str] args): FmtCli -> {
	let Str path = ""
	let Bool check = false
	let Bool got = false
	let Iarch i = 2

	loop {
		if i >= Iarch(args.len) then break
		const Str a = args[i]
		if eq(a, "--check") then check = true else {
			path = a
			got = true
		}
		i = i + 1
	}

	if !got then eprint("cf: usage: cf format [--check] <file>\n")
	if !got then exit(2)

	return FmtCli({ path: path, check: check })
}

# A non-negative decimal, for `--root-size`. Non-digit bytes are skipped (so `1048576` parses; there
# is no unit suffix — bytes only).
const parse_dec = (Str s): Iarch -> {
	let Iarch v = 0
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break
		const Iarch c = Iarch(s[i])
		if c >= 48 && c <= 57 then v = v * 10 + (c - 48)
		i = i + 1
	}

	return v
}

# The processor this cf RUNS ON — the default `--target` arch. The OS default folds at comptime
# (`os::target`: one seed family is one OS), but the ARCH must not bake into the IL (the darwin
# and linux seed families share one IL across arches), so it reads the per-arch floor's
# `host_arch_tag` at run time and maps the tag to its `Arch` member (the sys.cf decl order).
pub const host_arch = (): Arch -> match host_arch_tag() {
	1 -> Arch.Amd64,
	2 -> Arch.Riscv64,
	_ -> Arch.Arm64,
}

# `[--target <os>-<arch>] [--root-size <bytes>] <input.cf> <out.qbe> <out.s>`. Leading `--flag
# value`
# pairs are consumed in any order; `--target` selects the platform (default: the HOST — the target
# this very compiler was built for, folded in at comptime) and `--root-size` the `Bare` root page
# (default 1 MiB). The three positional paths follow. The `!` algebra and root rule are validated
# unconditionally.
pub const cli_parse! = ([Str] args): Cli -> {
	let Os tos = os::target
	let Arch tarch = host_arch()
	let Iarch rsize = 1048576
	let Bool dumpr = false
	# `--no-inline`: skip the pre-emit inliner — the 1:1 lowering for codegen debugging.
	let Bool noinl = false
	# `--debug`/`-g`: emit debug information — real symbol names + line directives. Passive
	# observability only (profilers, backtraces); it never changes what the program does.
	let Bool dbg = false
	# `--instrument`: swap in the memory geometries' accounting hook variants (build::instrument).
	# Separate from `--debug`: instrumentation perturbs the hot path a time profile measures.
	let Bool instr = false
	let Bool full = false
	let Str output = ""
	let Bool preserve = false
	# `--skip-embeds`: emit no `embed`/`embed_dir` file data — for bootstrap intermediates (the seed),
	# which must stay free of the baked stdlib. The shipped `var/cf` is built WITHOUT it, so it hosts
	# std.
	let Bool skip = false
	# `--set-version <v>` stamps the compiled program's `std::comptime::version::current`. Absent, it
	# stays `0.0.0-dev` — the version of an unreleased local build. (Bare `--version`/`-V` is a
	# separate
	# query for the compiler's OWN version, handled in `main` before parsing — see `is_version_cmd`.)
	let Str bver = "0.0.0-dev"
	# positionals collected wherever they fall — flags may precede or follow the input path (so
	# `cf app.cf -o app` works, not only `cf -o app app.cf`).
	let [Str] pos = []
	let Iarch i = 1

	# `c`/`compile` is the explicit compile verb (cf_cli §1). It is OPTIONAL: the bootstrap
	# (build.sh/reseed.sh) drives cf with the bare positional form (`cf <input.cf> <out.qbe> <out.s>`),
	# so a leading verb is simply skipped when present and its absence changes nothing. An input file
	# is always a `.cf`, never literally `c`/`compile`, so there is no ambiguity with a real path.
	if Iarch(args.len) >= 2 && (eq(args[1], "c") || eq(args[1], "compile")) then i = 2

	loop {
		if i >= Iarch(args.len) then break
		const Str a = args[i]

		if eq(a, "--dump-routing") then {
			dumpr = true
			i = i + 1
			continue
		}
		if eq(a, "--no-inline") then {
			noinl = true
			i = i + 1
			continue
		}
		if eq(a, "--debug") || eq(a, "-g") then {
			dbg = true
			i = i + 1
			continue
		}
		if eq(a, "--instrument") then {
			instr = true
			i = i + 1
			continue
		}
		if eq(a, "-P") || eq(a, "--preserve-intermediates") then {
			preserve = true
			i = i + 1
			continue
		}
		if eq(a, "--skip-embeds") then {
			skip = true
			i = i + 1
			continue
		}
		if eq(a, "--set-version") then {
			if i + 1 >= Iarch(args.len) then eprint("cf: `--set-version` needs a value\n")
			if i + 1 >= Iarch(args.len) then exit(2)
			bver = args[i + 1]
			i = i + 2
			continue
		}
		if eq(a, "-o") then {
			if i + 1 >= Iarch(args.len) then eprint("cf: `-o` needs an output path\n")
			if i + 1 >= Iarch(args.len) then exit(2)
			output = args[i + 1]
			full = true
			i = i + 2
			continue
		}
		if eq(a, "--target") then {
			if i + 1 >= Iarch(args.len) then eprint("cf: `--target` needs a value\n")
			if i + 1 >= Iarch(args.len) then exit(2)
			const Str t = args[i + 1]
			let Bool known = false
			if eq(t, "darwin-arm64") then {
				tos = Os.Darwin
				tarch = Arch.Arm64
				known = true
			}
			if eq(t, "darwin-amd64") then {
				tos = Os.Darwin
				tarch = Arch.Amd64
				known = true
			}
			if eq(t, "linux-arm64") then {
				tos = Os.Linux
				tarch = Arch.Arm64
				known = true
			}
			if eq(t, "linux-amd64") then {
				tos = Os.Linux
				tarch = Arch.Amd64
				known = true
			}
			if eq(t, "linux-riscv64") then {
				tos = Os.Linux
				tarch = Arch.Riscv64
				known = true
			}
			if eq(t, "bare-arm64") then {
				tos = Os.Bare
				tarch = Arch.Arm64
				known = true
			}
			if !known
				then eprint("cf: unknown --target (expected `darwin-arm64`, `darwin-amd64`, `linux-arm64`, `linux-amd64`, `linux-riscv64`, or `bare-arm64`)\n")
			if !known then exit(2)
			i = i + 2
			continue
		}
		if eq(a, "--root-size") then {
			if i + 1 >= Iarch(args.len) then eprint("cf: `--root-size` needs a value\n")
			if i + 1 >= Iarch(args.len) then exit(2)
			rsize = parse_dec(args[i + 1])
			i = i + 2
			continue
		}

		pos = [...pos, a]
		i = i + 1
	}

	# full pipeline (`-o`): one positional, the input; cf produces the final binary itself.
	if full then {
		if Iarch(pos.len) < 1
			then eprint("cf: usage: cf [c|compile] <input.cf> -o <output>   (`cf --help` for all commands)\n")
		if Iarch(pos.len) < 1 then exit(2)

		return Cli({
			input: pos[0],
			out_qbe: "",
			out_asm: "",
			target_os: tos,
			target_arch: tarch,
			root_size: rsize,
			dump_routing: dumpr,
			no_inline: noinl,
			debug: dbg,
			instrument: instr,
			full: true,
			output: output,
			preserve: preserve,
			skip_embeds: skip,
			build_version: bver,
		})
	}

	# No `-o` and fewer than three positionals: the user most likely meant to build a binary and forgot
	# `-o`. Point them at the real form (not the internal 3-path emit shape, which only the bootstrap
	# drives with a full `<input.cf> <out.qbe> <out.s>` triple).
	if Iarch(pos.len) < 3
		then eprint("cf: to build a binary give an output: cf [c|compile] <input.cf> -o <output>   (`cf --help` for all commands)\n")
	if Iarch(pos.len) < 3 then exit(2)

	return Cli({
		input: pos[0],
		out_qbe: pos[1],
		out_asm: pos[2],
		target_os: tos,
		target_arch: tarch,
		root_size: rsize,
		dump_routing: dumpr,
		no_inline: noinl,
		debug: dbg,
		instrument: instr,
		full: false,
		output: "",
		preserve: preserve,
		skip_embeds: skip,
		build_version: bver,
	})
}
