# cf0 — the self-hosted C! compiler (the KEEPER), entry point.
#
# This is the compiler cf0's genesis produces and then reproduces: seed-subset
# C! source, compiled during bootstrap by the throwaway `cfcc` genesis tool, and
# eventually by itself. It runs the same pipeline the ratified specs pin —
# lex, parse, (typecheck, …), emit — degenerately (seed_subset §5).
#
# Tracer-bullet scope: read a `.cf` file, parse `[pub] const main = () -> <int>`,
# and emit QBE IL + an asm floor that an external driver assembles into a running
# darwin/arm64 binary. Everything past `main`'s constant exit code fills in as the
# front end grows. cf0 cannot yet spawn `qbe`/`cc`, so it stops at emitting text
# to two output paths; the driver runs the `qbe`→`cc` tail.
#
#   cf0 <input.cf> <out.qbe> <out.s>

import "io" as { open, read, close, die, o_rdonly, o_wronly_creat_trunc, mode_644 }
import "cli" as { Cli, cli_parse }
import "token" as { Token }
import "ast" as { Program }
import "lexer" as { lex }
import "parser" as { Parser, parse_program }
import "typecheck" as { check_program }
import "emit" as { emit_program }

# The source read buffer. Tracer-bullet scope: one read into a fixed buffer, big
# enough for the corpus test inputs. A growable read loop arrives when cf0 must
# compile large files (its own source).
pub const src_cap = 65536

pub const main = ([Str] args) -> {
	const Cli c = cli_parse(args)

	# read the input source (a path's `.bytes` is the NUL-terminated C-string `open` needs)
	const Str inp = c.input
	const Iarch fd = open(inp.bytes, Uarch(o_rdonly), 0)
	if fd < 0 then die("cf0: cannot open the input file\n")
	let [65536 Uint8] src
	const Iarch n = read(Uarch(fd), src, Uarch(src_cap))
	close(Uarch(fd))
	if n < 0 then die("cf0: read failed\n")

	# front end: lex -> parse -> the program's AST
	const [Token] toks = lex(src, n)
	let Parser parser = Parser({ toks: toks, src: src, pos: 0 })
	const Program prog = parse_program(&parser)

	# middle: typecheck (rejects type errors before any output is produced)
	check_program(prog)

	# back end: emit QBE IL + the asm floor to the two output paths
	const Str oq = c.out_qbe
	const Iarch qf = open(oq.bytes, Uarch(o_wronly_creat_trunc), Uarch(mode_644))
	if qf < 0 then die("cf0: cannot create the QBE output\n")
	const Str oa = c.out_asm
	const Iarch af = open(oa.bytes, Uarch(o_wronly_creat_trunc), Uarch(mode_644))
	if af < 0 then die("cf0: cannot create the asm output\n")
	emit_program(prog, Uarch(qf), Uarch(af))
	close(Uarch(qf))
	close(Uarch(af))
	return 0
}
