# closures — lift local closures to top-level functions (memory_model §7), after typecheck.
#
# A `const f = (params) -> body` captures enclosing locals/parameters. C! closures are FAKE:
# there is no runtime closure object. This pass lowers each closure into an ordinary top-level
# function whose captures become trailing HIDDEN parameters, and rewrites the call sites to pass
# them. Capture is BY REFERENCE:
#   - a captured SCALAR (a word/Bool/fixed/float) is passed by its SLOT ADDRESS (`$capref`) — the
#     lifted body reads/writes THROUGH it, so a mutation is observed by the enclosing scope.
#   - a captured AGGREGATE (a record or `Str`) is passed by its POINTER (`$capagg`) — field writes
#     land in the shared arena record, observed by the enclosing scope.
# At each call site the capture argument is `&x` (`Expr.Addr`) — emit yields the binding's slot
# temp (the address for a scalar cell, the pointer for an aggregate), passed without a copy.
#
# v1 scope (typecheck enforces): a closure is `const`-bound, called directly, not nested in
# another closure, and not a first-class value. A captured local must be annotated (its type is
# read from the annotation / parameter). Runs AFTER typecheck (validated) and BEFORE emit.

import "ast" as { Expr, Stmt, MatchArm, StmtArm, Seg, FieldInit, TupElem, Param, RecDecl, UnionDecl, Func, Import, Program }

const no_names = (): [Str] -> {
	let [Str] e = []
	return e
}
# Byte-wise Str equality.
const str_eq = (Str a, Str b): Bool -> {
	if a.len != b.len then return false
	let Iarch i = 0
	loop {
		if i >= Iarch(a.len) then break
		if Iarch(a[i]) != Iarch(b[i]) then return false
		i = i + 1
	}
	return true
}
const in_list = ([Str] xs, Str n): Bool -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(xs.len) then break
		if str_eq(xs[i], n) then return true
		i = i + 1
	}
	return false
}
const cat = ([Str] a, [Str] b): [Str] -> {
	let [Str] out = a
	let Iarch i = 0
	loop {
		if i >= Iarch(b.len) then break
		out = [...out, b[i]]
		i = i + 1
	}
	return out
}
const find_rec = ([RecDecl] recs, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(recs.len) then break
		if str_eq(recs[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}

# --- referenced-name collection (a closure's free variables) -----------------------------
# Every bare name a body READS or WRITES — Var, a field/index/assign base, an `&` operand, a
# call callee, a `for … in` array. A captured variable is one of these that names an enclosing
# binding (and is not the closure's own parameter/local). Over-collecting a top-level function
# name (a call callee) is harmless: it is not in the enclosing local scope, so it is filtered.
const uses_exprs = ([Expr] es): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		out = cat(out, uses_expr(es[i]))
		i = i + 1
	}
	return out
}
const uses_fieldinits = ([FieldInit] fs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		out = cat(out, uses_expr(fs[i].value))
		i = i + 1
	}
	return out
}
const uses_segs = ([Seg] segs): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(segs.len) then break
		out = cat(out, uses_expr(segs[i].expr))
		i = i + 1
	}
	return out
}
const uses_match_arms = ([MatchArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		out = cat(out, uses_expr(arms[i].body))
		i = i + 1
	}
	return out
}
const uses_stmt_arms = ([StmtArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		out = cat(out, uses_stmts(arms[i].body))
		i = i + 1
	}
	return out
}
const uses_stmts = ([Stmt] ss): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		out = cat(out, uses_stmt(ss[i]))
		i = i + 1
	}
	return out
}
const uses_expr = (Expr e): [Str] -> match e {
	Expr.Lit(v) -> no_names(),
	Expr.BoolLit(b) -> no_names(),
	Expr.Var(n) -> [n],
	Expr.StrLit(bs) -> no_names(),
	Expr.FloatLit(t) -> no_names(),
	Expr.Record(n, fs) -> uses_fieldinits(fs),
	Expr.Field(b, f) -> [b],
	Expr.FieldExpr(b, f) -> uses_expr(b),
	Expr.UnionMk(t, m, args) -> uses_exprs(args),
	Expr.Match(scrut, arms) -> cat(uses_expr(scrut), uses_match_arms(arms)),
	Expr.ArrayLit(hs, sn, elems, et) -> cat(uses_expr(sn), uses_exprs(elems)),
	Expr.Index(a, i) -> cat([a], uses_expr(i)),
	Expr.IndexField(a, i, f) -> cat([a], uses_expr(i)),
	Expr.IndexExpr(b, i) -> cat(uses_expr(b), uses_expr(i)),
	Expr.Interp(segs) -> uses_segs(segs),
	Expr.Tuple(elems) -> uses_exprs(elems),
	Expr.Spread(x) -> uses_expr(x),
	Expr.Unit -> no_names(),
	Expr.Loop(body) -> uses_stmts(body),
	Expr.Buffer(sz) -> uses_expr(sz),
	Expr.Addr(name) -> [name],
	Expr.Neg(x) -> uses_expr(x),
	Expr.Not(x) -> uses_expr(x),
	Expr.BitNot(x) -> uses_expr(x),
	Expr.Add(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.Sub(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.Mul(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.Div(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.Mod(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.BitAnd(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.BitOr(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.BitXor(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.Shl(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.Shr(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.CmpEq(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.CmpNe(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.CmpLt(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.CmpGt(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.CmpLe(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.CmpGe(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.And(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.Or(l, r) -> cat(uses_expr(l), uses_expr(r)),
	Expr.If(c, t, e2) -> cat(cat(uses_expr(c), uses_expr(t)), uses_expr(e2)),
	Expr.Call(n, ta, args) -> cat([n], uses_exprs(args)),
	Expr.DeferTap(fn, args) -> uses_exprs(args)
}
const uses_stmt = (Stmt s): [Str] -> match s {
	Stmt.Let(n, m, ann, e) -> uses_expr(e),
	Stmt.Destructure(pat, m, e) -> uses_expr(e),
	Stmt.Assign(n, e) -> cat([n], uses_expr(e)),
	Stmt.FieldAssign(b, f, e) -> cat([b], uses_expr(e)),
	Stmt.DeepFieldAssign(be, f, e) -> cat(uses_expr(be), uses_expr(e)),
	Stmt.IndexAssign(a, i, v) -> cat([a], cat(uses_expr(i), uses_expr(v))),
	Stmt.Return(e) -> uses_expr(e),
	Stmt.ForIn(v, a, body) -> cat([a], uses_stmts(body)),
	Stmt.Loop(body) -> uses_stmts(body),
	Stmt.Break -> no_names(),
	Stmt.Continue -> no_names(),
	Stmt.IfThen(c, st) -> cat(uses_expr(c), uses_stmt(st)),
	Stmt.IfElse(c, t, e) -> cat(uses_expr(c), cat(uses_stmt(t), uses_stmt(e))),
	Stmt.Do(e) -> uses_expr(e),
	Stmt.Block(ss) -> uses_stmts(ss),
	Stmt.Match(scrut, arms) -> cat(uses_expr(scrut), uses_stmt_arms(arms)),
	Stmt.Yield(e) -> uses_expr(e),
	Stmt.Closure(nm, params, ret, body) -> uses_stmts(body),
	Stmt.Defer(body) -> uses_stmts(body)
}

# --- closure-local binders (names bound INSIDE the closure — not captures) ----------------
const param_names = ([Param] ps): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ps.len) then break
		out = [...out, ps[i].name]
		i = i + 1
	}
	return out
}
const binds_stmts = ([Stmt] ss): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		out = cat(out, binds_stmt(ss[i]))
		i = i + 1
	}
	return out
}
const binds_stmt = (Stmt s): [Str] -> match s {
	Stmt.Let(n, m, ann, e) -> [n],
	Stmt.Destructure(pat, m, e) -> pat,
	Stmt.Assign(n, e) -> no_names(),
	Stmt.FieldAssign(b, f, e) -> no_names(),
	Stmt.DeepFieldAssign(be, f, e) -> no_names(),
	Stmt.IndexAssign(a, i, v) -> no_names(),
	Stmt.Return(e) -> no_names(),
	Stmt.ForIn(v, a, body) -> cat([v], binds_stmts(body)),
	Stmt.Loop(body) -> binds_stmts(body),
	Stmt.Break -> no_names(),
	Stmt.Continue -> no_names(),
	Stmt.IfThen(c, st) -> binds_stmt(st),
	Stmt.IfElse(c, t, e) -> cat(binds_stmt(t), binds_stmt(e)),
	Stmt.Do(e) -> no_names(),
	Stmt.Block(ss) -> binds_stmts(ss),
	Stmt.Match(scrut, arms) -> stmt_arms_binds(arms),
	Stmt.Yield(e) -> no_names(),
	Stmt.Closure(nm, params, ret, body) -> [nm],
	Stmt.Defer(body) -> no_names()
}
const stmt_arms_binds = ([StmtArm] arms): [Str] -> {
	let [Str] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		out = cat(cat(out, arms[i].binds), binds_stmts(arms[i].body))
		i = i + 1
	}
	return out
}

# --- the enclosing scope (name -> declared type name) -------------------------------------
# Tracks each in-scope local/parameter's declared TYPE NAME so a capture's kind (scalar via
# `$capref`, aggregate via `$capagg`) and element type are known when the closure is lifted.
pub data ScopeVar = { Str name, Str tyname, Str elem }
const scope_find = ([ScopeVar] sc, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(sc.len) then break
		if str_eq(sc[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}
# Record a `let`/`const` binding's type for later capture (a bare/array `let`, and a destructured
# binding — which cannot carry a type annotation — are recorded with an empty type that
# `capture_param` rejects cleanly if the closure actually captures them; a v1 limitation).
const add_scope_names = ([ScopeVar] sc, [Str] names): [ScopeVar] -> {
	let [ScopeVar] out = sc
	let Iarch i = 0
	loop {
		if i >= Iarch(names.len) then break
		out = [...out, ScopeVar({ name: names[i], tyname: "", elem: "" })]
		i = i + 1
	}
	return out
}
const extend_scope = ([ScopeVar] sc, Stmt s): [ScopeVar] -> match s {
	Stmt.Let(n, m, ann, e) -> [...sc, ScopeVar({ name: n, tyname: ann, elem: "" })],
	Stmt.ForIn(v, a, body) -> [...sc, ScopeVar({ name: v, tyname: "Iarch", elem: "" })],
	Stmt.Destructure(pat, m, e) -> add_scope_names(sc, pat),
	_ -> sc
}

# --- call-site rewrite (append capture arguments) -----------------------------------------
# A record mapping a closure NAME to its lifted function name and the ordered capture ARGUMENTS
# to append at each call site: a scalar as `&x` (its slot address, `$capref`), an aggregate as
# `x` (its pointer value, `$capagg`) — matching how the lifted parameter is bound.
pub data CloRef = { Str name, Str lifted, [Expr] capargs }
const clo_find = ([CloRef] m, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(m.len) then break
		if str_eq(m[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}
# The rewrite context threaded through the lift: the in-scope closure map, the whole-program
# function table (so a capturing closure passed to a higher-order function can be handled by
# INLINING the HOF at the call site — see `rw_call`), and the current INLINE depth (a recursive HOF
# passed a capturing closure would inline forever — the depth bounds it to a clean diagnostic).
data RwCtx = { [CloRef] clos, [Func] fns, Iarch depth }
const rwctx0 = ([CloRef] clos, [Func] fns): RwCtx -> RwCtx({ clos: clos, fns: fns, depth: 0 })
const find_func = ([Func] fns, Str name): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(fns.len) then break
		if str_eq(fns[i].name, name) then return i
		i = i + 1
	}
	return 0 - 1
}
# The capture argument for a call site: the captured variable by NAME. Emit resolves it to a
# slot address (a scalar `$capref`) or a pointer (an aggregate `$capagg`) by the lifted
# parameter's kind, so the same `Var` serves both.
const cap_arg_expr = (ScopeVar sv): Expr -> Expr.Var(sv.name)
const rw_exprs = ([Expr] es, RwCtx m): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		out = [...out, rw_expr(es[i], m)]
		i = i + 1
	}
	return out
}
const rw_fieldinits = ([FieldInit] fs, RwCtx m): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: rw_expr(fs[i].value, m) })]
		i = i + 1
	}
	return out
}
const rw_segs = ([Seg] segs, RwCtx m): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(segs.len) then break
		const Seg g = segs[i]
		out = [...out, Seg({ is_hole: g.is_hole, lit: g.lit, name: g.name, expr: rw_expr(g.expr, m) })]
		i = i + 1
	}
	return out
}
const rw_match_arms = ([MatchArm] arms, RwCtx m): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [...out, MatchArm({ is_wild: a.is_wild, type_name: a.type_name, members: a.members, binds: a.binds, body: rw_expr(a.body, m) })]
		i = i + 1
	}
	return out
}
const rw_stmt_arms = ([StmtArm] arms, RwCtx m): [StmtArm] -> {
	let [StmtArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const StmtArm a = arms[i]
		out = [...out, StmtArm({ is_wild: a.is_wild, type_name: a.type_name, members: a.members, binds: a.binds, body: rw_stmts(a.body, m) })]
		i = i + 1
	}
	return out
}
const rw_stmts = ([Stmt] ss, RwCtx m): [Stmt] -> {
	let [Stmt] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(ss.len) then break
		out = [...out, rw_stmt(ss[i], m)]
		i = i + 1
	}
	return out
}
const rw_expr = (Expr e, RwCtx m): Expr -> match e {
	Expr.Lit(v) -> Expr.Lit(v),
	Expr.BoolLit(b) -> Expr.BoolLit(b),
	# a bare reference to a CAPTURE-FREE closure (used as a function VALUE, e.g. passed to a HOF) is
	# its lifted top-level function — a plain code pointer, like a top-level function name. A
	# capturing closure has no bare code address (its captures must be threaded); one reaching here
	# as a value is left for the specialization pass / rejected downstream.
	Expr.Var(n) -> rw_var(n, m),
	Expr.StrLit(bs) -> Expr.StrLit(bs),
	Expr.FloatLit(t) -> Expr.FloatLit(t),
	Expr.Record(n, fs) -> Expr.Record(n, rw_fieldinits(fs, m)),
	Expr.Field(b, f) -> Expr.Field(b, f),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(rw_expr(b, m), f),
	Expr.UnionMk(t, mm, args) -> Expr.UnionMk(t, mm, rw_exprs(args, m)),
	Expr.Match(scrut, arms) -> Expr.Match(rw_expr(scrut, m), rw_match_arms(arms, m)),
	Expr.ArrayLit(hs, sn, elems, et) -> Expr.ArrayLit(hs, rw_expr(sn, m), rw_exprs(elems, m), et),
	Expr.Index(a, i) -> Expr.Index(a, rw_expr(i, m)),
	Expr.IndexField(a, i, f) -> Expr.IndexField(a, rw_expr(i, m), f),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(rw_expr(b, m), rw_expr(i, m)),
	Expr.Interp(segs) -> Expr.Interp(rw_segs(segs, m)),
	Expr.Tuple(elems) -> Expr.Tuple(rw_exprs(elems, m)),
	Expr.Spread(x) -> Expr.Spread(rw_expr(x, m)),
	Expr.Unit -> Expr.Unit,
	Expr.Loop(body) -> Expr.Loop(rw_stmts(body, m)),
	Expr.Buffer(sz) -> Expr.Buffer(rw_expr(sz, m)),
	Expr.Addr(name) -> Expr.Addr(name),
	Expr.Neg(x) -> Expr.Neg(rw_expr(x, m)),
	Expr.Not(x) -> Expr.Not(rw_expr(x, m)),
	Expr.BitNot(x) -> Expr.BitNot(rw_expr(x, m)),
	Expr.Add(l, r) -> Expr.Add(rw_expr(l, m), rw_expr(r, m)),
	Expr.Sub(l, r) -> Expr.Sub(rw_expr(l, m), rw_expr(r, m)),
	Expr.Mul(l, r) -> Expr.Mul(rw_expr(l, m), rw_expr(r, m)),
	Expr.Div(l, r) -> Expr.Div(rw_expr(l, m), rw_expr(r, m)),
	Expr.Mod(l, r) -> Expr.Mod(rw_expr(l, m), rw_expr(r, m)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(rw_expr(l, m), rw_expr(r, m)),
	Expr.BitOr(l, r) -> Expr.BitOr(rw_expr(l, m), rw_expr(r, m)),
	Expr.BitXor(l, r) -> Expr.BitXor(rw_expr(l, m), rw_expr(r, m)),
	Expr.Shl(l, r) -> Expr.Shl(rw_expr(l, m), rw_expr(r, m)),
	Expr.Shr(l, r) -> Expr.Shr(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(rw_expr(l, m), rw_expr(r, m)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(rw_expr(l, m), rw_expr(r, m)),
	Expr.And(l, r) -> Expr.And(rw_expr(l, m), rw_expr(r, m)),
	Expr.Or(l, r) -> Expr.Or(rw_expr(l, m), rw_expr(r, m)),
	Expr.If(c, t, e2) -> Expr.If(rw_expr(c, m), rw_expr(t, m), rw_expr(e2, m)),
	Expr.Call(n, ta, args) -> rw_call(n, ta, rw_exprs(args, m), m),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(fn, rw_exprs(args, m))
}
# A bare closure reference used as a value: a capture-free closure becomes its lifted function name
# (a code pointer); any other name is unchanged.
const rw_var = (Str n, RwCtx m): Expr -> {
	const Iarch ci = clo_find(m.clos, n)
	if ci < 0 then return Expr.Var(n)
	if Iarch(m.clos[ci].capargs.len) == 0 then return Expr.Var(m.clos[ci].lifted)
	return Expr.Var(n)
}

# --- inlining a HOF called with a capturing closure (the fake-closure model) ---------------------
# A capturing closure has no bare code address, so it cannot ride an ordinary function-value
# parameter. Instead, at each call `hof(clo, …)` the HOF is INLINED: its single-expression body is
# substituted (the function parameter → the closure, the value parameters → the call arguments) and
# re-rewritten, so `f(x)` becomes a direct call to the closure's lifted body with its captures
# threaded. Inlining recurses, so a closure passed through a chain of HOFs (`relay -> apply`) still
# reduces to a direct call.
pub data Subst = { Str param, Expr repl }
const subst_find = ([Subst] su, Str n): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(su.len) then break
		if str_eq(su[i].param, n) then return i
		i = i + 1
	}
	return 0 - 1
}
const repl_name = (Expr e): Str -> match e { Expr.Var(n) -> n, _ -> "" }
const subst_var = (Str n, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, n)
	if si < 0 then return Expr.Var(n)
	return su[si].repl
}
const arg_var_name = (Expr e): Str -> match e { Expr.Var(n) -> n, _ -> "" }
const subst_exprs = ([Expr] es, [Subst] su): [Expr] -> {
	let [Expr] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(es.len) then break
		out = [...out, subst_expr(es[i], su)]
		i = i + 1
	}
	return out
}
# Replace a call's CALLEE too, when it names a substituted function parameter (`f(x)` with `f` bound
# to a closure → `clo(x)`, later redirected to the lifted body). The arguments are already substituted.
const subst_call = (Str c, [Str] ta, [Expr] sargs, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, c)
	if si < 0 then return Expr.Call(c, ta, sargs)
	const Str rn = repl_name(su[si].repl)
	if str_eq(rn, "") then return Expr.Call(c, ta, sargs)
	return Expr.Call(rn, ta, sargs)
}
# Substitute a bare-name BASE (a `p.f` field, a `p[i]` index, an `&p` address on a parameter name):
# a parameter substituted by a `Var(name)` keeps the name-based form; one substituted by a compound
# expression is rebuilt with the expression-based form (`FieldExpr`/`IndexExpr`).
const subst_field = (Str b, Str f, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, b)
	if si < 0 then return Expr.Field(b, f)
	const Str rn = repl_name(su[si].repl)
	if !str_eq(rn, "") then return Expr.Field(rn, f)
	return Expr.FieldExpr(su[si].repl, f)
}
const subst_index = (Str a, Expr i, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, a)
	if si < 0 then return Expr.Index(a, subst_expr(i, su))
	const Str rn = repl_name(su[si].repl)
	if !str_eq(rn, "") then return Expr.Index(rn, subst_expr(i, su))
	return Expr.IndexExpr(su[si].repl, subst_expr(i, su))
}
const subst_indexfield = (Str a, Expr i, Str f, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, a)
	if si < 0 then return Expr.IndexField(a, subst_expr(i, su), f)
	const Str rn = repl_name(su[si].repl)
	if !str_eq(rn, "") then return Expr.IndexField(rn, subst_expr(i, su), f)
	return Expr.FieldExpr(Expr.IndexExpr(su[si].repl, subst_expr(i, su)), f)
}
const subst_addr = (Str name, [Subst] su): Expr -> {
	const Iarch si = subst_find(su, name)
	if si < 0 then return Expr.Addr(name)
	const Str rn = repl_name(su[si].repl)
	if str_eq(rn, "") then die("cf0: closure: cannot take the address of a non-name argument in an inlined HOF (v1)\n")
	return Expr.Addr(rn)
}
const subst_fieldinits = ([FieldInit] fs, [Subst] su): [FieldInit] -> {
	let [FieldInit] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(fs.len) then break
		out = [...out, FieldInit({ field: fs[i].field, value: subst_expr(fs[i].value, su) })]
		i = i + 1
	}
	return out
}
const subst_match_arms = ([MatchArm] arms, [Subst] su): [MatchArm] -> {
	let [MatchArm] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(arms.len) then break
		const MatchArm a = arms[i]
		out = [...out, MatchArm({ is_wild: a.is_wild, type_name: a.type_name, members: a.members, binds: a.binds, body: subst_expr(a.body, su) })]
		i = i + 1
	}
	return out
}
const subst_segs = ([Seg] segs, [Subst] su): [Seg] -> {
	let [Seg] out = []
	let Iarch i = 0
	loop {
		if i >= Iarch(segs.len) then break
		const Seg g = segs[i]
		out = [...out, Seg({ is_hole: g.is_hole, lit: g.lit, name: g.name, expr: subst_expr(g.expr, su) })]
		i = i + 1
	}
	return out
}
pub const subst_expr = (Expr e, [Subst] su): Expr -> match e {
	Expr.Var(n) -> subst_var(n, su),
	Expr.Call(c, ta, args) -> subst_call(c, ta, subst_exprs(args, su), su),
	Expr.DeferTap(fn, args) -> Expr.DeferTap(fn, subst_exprs(args, su)),
	Expr.Field(b, f) -> subst_field(b, f, su),
	Expr.Index(a, i) -> subst_index(a, i, su),
	Expr.IndexField(a, i, f) -> subst_indexfield(a, i, f, su),
	Expr.Addr(name) -> subst_addr(name, su),
	Expr.Record(n, fs) -> Expr.Record(n, subst_fieldinits(fs, su)),
	Expr.Match(scrut, arms) -> Expr.Match(subst_expr(scrut, su), subst_match_arms(arms, su)),
	Expr.Interp(segs) -> Expr.Interp(subst_segs(segs, su)),
	Expr.FieldExpr(b, f) -> Expr.FieldExpr(subst_expr(b, su), f),
	Expr.UnionMk(t, mm, args) -> Expr.UnionMk(t, mm, subst_exprs(args, su)),
	Expr.ArrayLit(hs, sn, elems, et) -> Expr.ArrayLit(hs, subst_expr(sn, su), subst_exprs(elems, su), et),
	Expr.IndexExpr(b, i) -> Expr.IndexExpr(subst_expr(b, su), subst_expr(i, su)),
	Expr.Tuple(elems) -> Expr.Tuple(subst_exprs(elems, su)),
	Expr.Spread(x) -> Expr.Spread(subst_expr(x, su)),
	Expr.Buffer(sz) -> Expr.Buffer(subst_expr(sz, su)),
	Expr.Neg(x) -> Expr.Neg(subst_expr(x, su)),
	Expr.Not(x) -> Expr.Not(subst_expr(x, su)),
	Expr.BitNot(x) -> Expr.BitNot(subst_expr(x, su)),
	Expr.Add(l, r) -> Expr.Add(subst_expr(l, su), subst_expr(r, su)),
	Expr.Sub(l, r) -> Expr.Sub(subst_expr(l, su), subst_expr(r, su)),
	Expr.Mul(l, r) -> Expr.Mul(subst_expr(l, su), subst_expr(r, su)),
	Expr.Div(l, r) -> Expr.Div(subst_expr(l, su), subst_expr(r, su)),
	Expr.Mod(l, r) -> Expr.Mod(subst_expr(l, su), subst_expr(r, su)),
	Expr.BitAnd(l, r) -> Expr.BitAnd(subst_expr(l, su), subst_expr(r, su)),
	Expr.BitOr(l, r) -> Expr.BitOr(subst_expr(l, su), subst_expr(r, su)),
	Expr.BitXor(l, r) -> Expr.BitXor(subst_expr(l, su), subst_expr(r, su)),
	Expr.Shl(l, r) -> Expr.Shl(subst_expr(l, su), subst_expr(r, su)),
	Expr.Shr(l, r) -> Expr.Shr(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpEq(l, r) -> Expr.CmpEq(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpNe(l, r) -> Expr.CmpNe(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpLt(l, r) -> Expr.CmpLt(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpGt(l, r) -> Expr.CmpGt(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpLe(l, r) -> Expr.CmpLe(subst_expr(l, su), subst_expr(r, su)),
	Expr.CmpGe(l, r) -> Expr.CmpGe(subst_expr(l, su), subst_expr(r, su)),
	Expr.And(l, r) -> Expr.And(subst_expr(l, su), subst_expr(r, su)),
	Expr.Or(l, r) -> Expr.Or(subst_expr(l, su), subst_expr(r, su)),
	Expr.If(c, t, e2) -> Expr.If(subst_expr(c, su), subst_expr(t, su), subst_expr(e2, su)),
	_ -> e
}
# The position of the HOF's function parameter that is receiving a CAPTURING closure at this call
# (or -1). A capture-free closure has been lowered to a code pointer already, so it is not matched.
const capturing_clo_arg = (Func hof, [Expr] args, [CloRef] clos): Iarch -> {
	let Iarch i = 0
	loop {
		if i >= Iarch(hof.params.len) then break
		if i < Iarch(args.len) then {
			if str_eq(hof.params[i].type_name, "$fn") then {
				const Iarch ci = clo_find(clos, arg_var_name(args[i]))
				if ci >= 0 then { if Iarch(clos[ci].capargs.len) > 0 then return i }
			}
		}
		i = i + 1
	}
	return 0 - 1
}
const return_expr = (Stmt s): Expr -> match s { Stmt.Return(e) -> e, _ -> Expr.Unit }
# A substitution-safe argument — one that inlining may duplicate (a repeated parameter) without
# changing meaning: a literal or a bare name (no side effect, same value each read).
const is_simple_arg = (Expr e): Bool -> match e {
	Expr.Lit(v) -> true,
	Expr.BoolLit(b) -> true,
	Expr.FloatLit(t) -> true,
	Expr.StrLit(bs) -> true,
	Expr.Var(n) -> true,
	_ -> false
}
const count_name = ([Str] names, Str n): Iarch -> {
	let Iarch c = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(names.len) then break
		if str_eq(names[i], n) then c = c + 1
		i = i + 1
	}
	return c
}
# Inline `hof(args)` at a call site where `args[cp]` is a capturing closure: substitute the HOF's
# parameters with the arguments in its (single-expression) body, then re-rewrite — so the closure's
# call becomes a direct call to its lifted body, and a further HOF hop inlines in turn (the `depth`
# bounds a recursive HOF, which would inline forever). A value parameter used more than once would
# duplicate its argument, so a repeated parameter admits only a simple (side-effect-free) argument.
const inline_hof = (Func hof, [Expr] args, Iarch cp, RwCtx m): Expr -> {
	if Iarch(hof.body.len) != 1 then die("cf0: closure: a higher-order function taking a capturing closure needs a single-expression body (v1)\n")
	if m.depth > 64 then die("cf0: closure: a recursive higher-order function cannot be passed a capturing closure (v1)\n")
	const Expr bodyexpr = return_expr(hof.body[0])
	const [Str] used = uses_expr(bodyexpr)
	let [Subst] su = []
	let Iarch i = 0
	loop {
		if i >= Iarch(hof.params.len) then break
		if !str_eq(hof.params[i].type_name, "$fn") then {
			if count_name(used, hof.params[i].name) > 1 then {
				if !is_simple_arg(args[i]) then die("cf0: closure: a HOF parameter used more than once needs a simple argument when a capturing closure is passed (v1)\n")
			}
		}
		su = [...su, Subst({ param: hof.params[i].name, repl: args[i] })]
		i = i + 1
	}
	const Expr inlined = subst_expr(bodyexpr, su)
	return rw_expr(inlined, RwCtx({ clos: m.clos, fns: m.fns, depth: m.depth + 1 }))
}
# A call to a closure name is redirected to its lifted function (captures appended); a HOF called
# with a capturing closure is inlined; every other call is unchanged (its arguments already rewritten).
const rw_call = (Str n, [Str] ta, [Expr] args, RwCtx m): Expr -> {
	const Iarch ci = clo_find(m.clos, n)
	if ci >= 0 then {
		let [Expr] all = args
		const [Expr] caps = m.clos[ci].capargs
		let Iarch i = 0
		loop {
			if i >= Iarch(caps.len) then break
			all = [...all, caps[i]]
			i = i + 1
		}
		return Expr.Call(m.clos[ci].lifted, ta, all)
	}
	const Iarch fi = find_func(m.fns, n)
	if fi >= 0 then {
		const Iarch cp = capturing_clo_arg(m.fns[fi], args, m.clos)
		if cp >= 0 then return inline_hof(m.fns[fi], args, cp, m)
	}
	return Expr.Call(n, ta, args)
}
const rw_stmt = (Stmt s, RwCtx m): Stmt -> match s {
	Stmt.Let(n, mut, ann, e) -> Stmt.Let(n, mut, ann, rw_expr(e, m)),
	Stmt.Destructure(pat, mut, e) -> Stmt.Destructure(pat, mut, rw_expr(e, m)),
	Stmt.Assign(n, e) -> Stmt.Assign(n, rw_expr(e, m)),
	Stmt.FieldAssign(b, f, e) -> Stmt.FieldAssign(b, f, rw_expr(e, m)),
	Stmt.DeepFieldAssign(be, f, e) -> Stmt.DeepFieldAssign(rw_expr(be, m), f, rw_expr(e, m)),
	Stmt.IndexAssign(a, i, v) -> Stmt.IndexAssign(a, rw_expr(i, m), rw_expr(v, m)),
	Stmt.Return(e) -> Stmt.Return(rw_expr(e, m)),
	Stmt.ForIn(v, a, body) -> Stmt.ForIn(v, a, rw_stmts(body, m)),
	Stmt.Loop(body) -> Stmt.Loop(rw_stmts(body, m)),
	Stmt.Break -> Stmt.Break,
	Stmt.Continue -> Stmt.Continue,
	Stmt.IfThen(c, st) -> Stmt.IfThen(rw_expr(c, m), rw_stmt(st, m)),
	Stmt.IfElse(c, t, e) -> Stmt.IfElse(rw_expr(c, m), rw_stmt(t, m), rw_stmt(e, m)),
	Stmt.Do(e) -> Stmt.Do(rw_expr(e, m)),
	Stmt.Block(ss) -> Stmt.Block(rw_stmts(ss, m)),
	Stmt.Match(scrut, arms) -> Stmt.Match(rw_expr(scrut, m), rw_stmt_arms(arms, m)),
	Stmt.Yield(e) -> Stmt.Yield(rw_expr(e, m)),
	Stmt.Closure(nm, params, ret, body) -> Stmt.Closure(nm, params, ret, rw_stmts(body, m)),
	Stmt.Defer(body) -> Stmt.Defer(rw_stmts(body, m))
}

# --- capture parameter construction -------------------------------------------------------
# The hidden parameter for a captured variable, by its declared type: a record or `Str` rides
# by pointer (`$capagg`, `elem` = the type name); every other scalar (word/Bool/fixed/float)
# rides by slot address (`$capref`, `elem` = the type name). An unannotated or array/tuple
# capture is unsupported in v1.
const capture_param = ([RecDecl] recs, ScopeVar sv): Param -> {
	if str_eq(sv.tyname, "") then die("cf0: closure: a captured local must be annotated with its type\n")
	if find_rec(recs, sv.tyname) >= 0 then return Param({ name: sv.name, is_ptr: false, type_name: "$capagg", elem: sv.tyname, telems: [], size: 0 })
	if str_eq(sv.tyname, "Str") then return Param({ name: sv.name, is_ptr: false, type_name: "$capagg", elem: sv.tyname, telems: [], size: 0 })
	if str_eq(sv.tyname, "$dyn") then die("cf0: closure: capturing an array is not supported yet\n")
	if str_eq(sv.tyname, "$tuple") then die("cf0: closure: capturing a tuple is not supported yet\n")
	if str_eq(sv.tyname, "$ptr") then die("cf0: closure: capturing a pointer is not supported yet\n")
	return Param({ name: sv.name, is_ptr: false, type_name: "$capref", elem: sv.tyname, telems: [], size: 0 })
}

# --- per-function lifting -----------------------------------------------------------------
# The captured variables of a closure body, in enclosing-scope order: an in-scope local/parameter
# that the body references and the closure does not itself bind.
const compute_captures = ([RecDecl] recs, [Stmt] body, [Param] params, [ScopeVar] scope): [ScopeVar] -> {
	const [Str] used = uses_stmts(body)
	const [Str] local = cat(param_names(params), binds_stmts(body))
	let [ScopeVar] caps = []
	let Iarch i = 0
	loop {
		if i >= Iarch(scope.len) then break
		const ScopeVar sv = scope[i]
		if in_list(used, sv.name) then { if !in_list(local, sv.name) then caps = [...caps, sv] }
		i = i + 1
	}
	return caps
}
# One lifted function name per closure — unique across the program via the enclosing function
# index and the closure's ordinal within it.
const lifted_name = (Iarch fi, Iarch ci): Str -> "__clo_${fi}_${ci}"

# Result of lifting one function's body: the rewritten body (closures removed, calls redirected)
# and the list of lifted top-level functions it produced.
pub data Lifted = { [Stmt] body, [Func] funcs }
const lift_func = (Func fn, Iarch fi, [RecDecl] recs, [Func] fns): Lifted -> {
	let [ScopeVar] scope = []
	let Iarch p = 0
	loop {
		if p >= Iarch(fn.params.len) then break
		scope = [...scope, ScopeVar({ name: fn.params[p].name, tyname: fn.params[p].type_name, elem: fn.params[p].elem })]
		p = p + 1
	}
	let [CloRef] cmap = []
	let [Func] lifted = []
	let [Stmt] out = []
	let Iarch ci = 0
	let Iarch i = 0
	loop {
		if i >= Iarch(fn.body.len) then break
		const Stmt s = fn.body[i]
		match s {
			Stmt.Closure(nm, params, ret, body) -> {
				const [ScopeVar] caps = compute_captures(recs, body, params, scope)
				let [Param] lparams = params
				let [Expr] capargs = []
				let Iarch c = 0
				loop {
					if c >= Iarch(caps.len) then break
					lparams = [...lparams, capture_param(recs, caps[c])]
					capargs = [...capargs, cap_arg_expr(caps[c])]
					c = c + 1
				}
				const Str ln = lifted_name(fi, ci)
				# the closure's calls (later in this body) are redirected before its own body is
				# rewritten, so a captured closure that itself calls another already-lifted closure
				# still resolves
				const [Stmt] lbody = rw_stmts(body, rwctx0(cmap, fns))
				const [Seg] noasm = []
				const [Str] no_tp = []
				const [TupElem] no_tel = []
				lifted = [...lifted, Func({ name: ln, is_pub: false, ret_name: ret, ret_elem: "", params: lparams, body: lbody, is_asm: false, asm_body: noasm, is_value: false, ret_telems: no_tel, typarams: no_tp, tbounds: no_tp, ret_size: 0 })]
				cmap = [...cmap, CloRef({ name: nm, lifted: ln, capargs: capargs })]
				ci = ci + 1
			},
			_ -> {
				out = [...out, rw_stmt(s, rwctx0(cmap, fns))]
				scope = extend_scope(scope, s)
			}
		}
		i = i + 1
	}
	return Lifted({ body: out, funcs: lifted })
}

# Lift every function's closures and append the lifted functions to the program. An asm-bodied
# function has no closures. The lifted functions carry `$capref`/`$capagg` parameters that emit
# lowers (a scalar-address cell / an aggregate pointer); they are already type-validated as the
# original closures, so they are not re-checked.
pub const lift_program = (Program prog): Program -> {
	let [Func] funcs = []
	let [Func] extra = []
	let Iarch i = 0
	loop {
		if i >= Iarch(prog.funcs.len) then break
		const Func fn = prog.funcs[i]
		if fn.is_asm then { funcs = [...funcs, fn] } else {
			const Lifted lf = lift_func(fn, i, prog.recs, prog.funcs)
			funcs = [...funcs, Func({ name: fn.name, is_pub: fn.is_pub, ret_name: fn.ret_name, ret_elem: fn.ret_elem, params: fn.params, body: lf.body, is_asm: false, asm_body: fn.asm_body, is_value: fn.is_value, ret_telems: fn.ret_telems, typarams: fn.typarams, tbounds: fn.tbounds, ret_size: fn.ret_size })]
			let Iarch k = 0
			loop {
				if k >= Iarch(lf.funcs.len) then break
				extra = [...extra, lf.funcs[k]]
				k = k + 1
			}
		}
		i = i + 1
	}
	let Iarch e = 0
	loop {
		if e >= Iarch(extra.len) then break
		funcs = [...funcs, extra[e]]
		e = e + 1
	}
	return Program({ imports: prog.imports, recs: prog.recs, unions: prog.unions, funcs: funcs, groups: prog.groups })
}
