# cf lsp — a Language Server Protocol server over stdio, M1: initialize/shutdown lifecycle,
# diagnostics on open/save AND as-you-type (didChange full sync — the buffer stands in for the
# file via `cf check --src`), and documentSymbol (the outline: top-level declarations scanned
# by line). Each check runs `cf check <file>` in a CHILD process (this
# very binary re-invoked), so a fail-fast front-end die (a parse error mid-edit) never takes
# the server down; the child's located `path:line:col: msg` lines come back on a captured
# stderr and turn into `publishDiagnostics` — each line published to ITS OWN file's uri
# (an error in an imported module squiggles that module, not the saved file; relative std
# paths absolutize against `$PWD`). The uris that carried diagnostics are remembered in a
# tempfile so the next round can clear the ones that went quiet. Uris are percent-decoded
# coming in and percent-encoded going out. Positions are negotiated `positionEncoding:
# "utf-8"` (cf's columns are bytes), lines/columns shift to LSP's 0-base. Each frame is
# handled in its OWN arena, reclaimed wholesale — the server's memory stays flat.

import std::data::str::{ eq, starts_with, ends_with, slice, index_of, split, contains, join, trim }
import std::data::{ Either, Maybe }
import std::data::json::{ Json, JsonEntry, parse!, render!, get }
import std::io::file::{ read, write_str, read_file!, write_file }
import std::io::fd::{ Fd, stdin, stdout, DirEntry, entry_is_dir }
import std::io::fs::{ remove, exists!, read_dir! }
import std::process::{ run!, find_executable!, getenv!, getpid, exit }
import std::io::console::{ eprint }
import std::mem::arena::growing_arena

# --- transport --------------------------------------------------------------------------------

# One byte off stdin, or -1 at EOF.
const read_byte! = (): Iarch -> {
	let [1 Uint8] b

	return match read(stdin(), b, Uarch(1)) {
		Either.Right(n) -> if n == 1 then Iarch(b[0]) else -1,
		Either.Left(e) -> -1,
	}
}

const to_int = (Str s): Iarch -> {
	let Iarch v = 0
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break
		const Iarch c = Iarch(s[i])
		if c < 48 || c > 57 then break
		v = v * 10 + (c - 48)
		i = i + 1
	}

	return v
}

# Read the header block (bytes up to the blank line) and return the Content-Length, or -1 at
# EOF. Headers are ASCII lines `Name: value\r\n`.
const read_content_length! = (): Iarch -> {
	let [Uint8] hdr = []
	let Iarch run = 0

	loop {
		const Iarch c = read_byte!()
		if c < 0 then return -1
		hdr = [...hdr, Uint8(c)]
		if c == 13 || c == 10 then run = run + 1 else run = 0
		if run == 4 then break
	}

	const Str h = Str(hdr)
	const Iarch at = index_of("Content-Length:", h)
	if at < 0 then return -1

	return to_int(slice(at + 15 + 1, Iarch(h.len), h))
}

# Read exactly `n` body bytes (looping over short reads).
const read_body! = (Iarch n): Str -> {
	let [Uint8] out = []
	let [65536 Uint8] buf
	let Iarch got = 0

	loop {
		if got >= n then break
		let Uarch want = Uarch(65536)
		if n - got < 65536 then want = Uarch(n - got)
		const Iarch k = match read(stdin(), buf, want) {
			Either.Right(kk) -> kk,
			Either.Left(e) -> -1,
		}

		if k <= 0 then break
		let Iarch i = 0

		loop {
			if i >= k then break
			out = [...out, buf[i]]
			i = i + 1
		}

		got = got + k
	}

	return Str(out)
}

# Send one message: the compact JSON body behind its Content-Length header.
const send! = (Json msg): () -> {
	const Str body = render!(msg)
	const Iarch n = Iarch(body.len)

	write_str(stdout(), "Content-Length: ${n}\r\n\r\n")
	write_str(stdout(), body)
}

# --- json shorthands --------------------------------------------------------------------------

const jstr = (Str s): Json -> Json.Str(s)

const jnum = (Iarch n): Json -> Json.Num("${n}")

const ent = (Str k, Json v): JsonEntry -> JsonEntry({ key: k, val: v })

const jget = (Str k, Json j): Json -> match get(k, j) {
	Maybe.Just(v) -> v,
	Maybe.Nothing -> Json.Null,
}

const jtext = (Json j): Str -> match j { Json.Str(s) -> s, _ -> "" }

# A response carrying `result` for request `id` (the id is echoed back as parsed).
const respond! = (Json id, Json result): () ->
	send!(Json.Obj([
		ent("jsonrpc", jstr("2.0")),
		ent("id", id),
		ent("result", result),
	]))

const respond_err! = (Json id, Iarch code, Str msg): () ->
	send!(Json.Obj([
		ent("jsonrpc", jstr("2.0")),
		ent("id", id),
		ent("error", Json.Obj([ent("code", jnum(code)), ent("message", jstr(msg))])),
	]))

# --- uris -------------------------------------------------------------------------------------

# The value of one hex digit byte, or -1.
const hex_val = (Iarch c): Iarch -> {
	if c >= 48 && c <= 57 then return c - 48
	if c >= 65 && c <= 70 then return c - 55
	if c >= 97 && c <= 102 then return c - 87

	return -1
}

# The hex digit byte of a value 0..15.
const hex_chr = (Iarch v): Iarch -> if v < 10 then v + 48 else v + 55

# A byte a uri carries verbatim: unreserved (RFC 3986) or the path separator.
const uri_plain = (Iarch c): Bool ->
	(c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) ||
	c == 45 || c == 46 || c == 95 || c == 126 || c == 47

# A `file://` uri to its filesystem path: strip the scheme, percent-decode (`%20` → space).
# A malformed escape passes through verbatim (nothing is lost). The bytes are NUL-terminated
# past `len` (argv-style) so the path feeds `open` at the syscall boundary directly.
const uri_to_path! = (Str uri): Str -> {
	let Str p = uri
	if starts_with("file://", p) then p = slice(7, Iarch(p.len), p)
	let [Uint8] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(p.len) then break
		const Iarch c = Iarch(p[i])

		if c == 37 && i + 2 < Iarch(p.len) then {
			const Iarch hi = hex_val(Iarch(p[i + 1]))
			const Iarch lo = hex_val(Iarch(p[i + 2]))

			if hi >= 0 && lo >= 0 then {
				out = [...out, Uint8(hi * 16 + lo)]
				i = i + 3
			} else {
				out = [...out, Uint8(c)]
				i = i + 1
			}
		} else {
			out = [...out, Uint8(c)]
			i = i + 1
		}
	}

	out = [...out, Uint8(0)]

	return Str(out, Iarch(out.len) - 1)
}

# A filesystem path to its `file://` uri, percent-encoding every reserved byte.
const path_uri! = (Str path): Str -> {
	let [Uint8] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(path.len) then break
		const Iarch c = Iarch(path[i])

		if uri_plain(c) then {
			out = [...out, Uint8(c)]
		} else {
			out = [...out, Uint8(37)]
			out = [...out, Uint8(hex_chr(c / 16))]
			out = [...out, Uint8(hex_chr(c - c / 16 * 16))]
		}

		i = i + 1
	}

	return "file://${Str(out)}"
}

# --- diagnostics ------------------------------------------------------------------------------

# A parsed `path:line:col:` prefix: `plen` the path's byte length (-1 when the line carries no
# location), `ln`/`col` 1-based, `moff` the message's byte offset (past the separating space).
data Loc = { Iarch plen, Iarch ln, Iarch col, Iarch moff }

# Scan a diagnostic line for its leftmost `:<digits>:<digits>:` — the located-line signature
# any file's diagnostic carries, not just the checked file's.
const scan_loc = (Str s): Loc -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break

		if Iarch(s[i]) == 58 then {
			let Iarch j = i + 1

			loop {
				if j >= Iarch(s.len) || Iarch(s[j]) < 48 || Iarch(s[j]) > 57 then break
				j = j + 1
			}

			if j > i + 1 && j < Iarch(s.len) && Iarch(s[j]) == 58 then {
				let Iarch k = j + 1

				loop {
					if k >= Iarch(s.len) || Iarch(s[k]) < 48 || Iarch(s[k]) > 57 then break
					k = k + 1
				}

				if k > j + 1 && k < Iarch(s.len) && Iarch(s[k]) == 58 then {
					let Iarch m = k + 1
					if m < Iarch(s.len) && Iarch(s[m]) == 32 then m = m + 1

					return Loc({
						plen: i,
						ln: to_int(slice(i + 1, j, s)),
						col: to_int(slice(j + 1, k, s)),
						moff: m,
					})
				}
			}
		}

		i = i + 1
	}

	return Loc({ plen: -1, ln: 0, col: 0, moff: 0 })
}

# An LSP range on one 0-based line, `c0` to `c1`.
const jrange! = (Iarch l0, Iarch c0, Iarch c1): Json -> Json.Obj([
	ent("start", Json.Obj([ent("line", jnum(l0)), ent("character", jnum(c0))])),
	ent("end", Json.Obj([ent("line", jnum(l0)), ent("character", jnum(c1))])),
])

# A NUL-terminated copy of `s` (len excludes the NUL, argv-style) — a slice view is not
# terminated, and the raw open syscall wants a C string.
const czstr! = (Str s): Str -> {
	let [Uint8] out = []
	let Iarch i = 0

	loop {
		if i >= Iarch(s.len) then break
		out = [...out, s[i]]
		i = i + 1
	}

	out = [...out, Uint8(0)]

	return Str(out, Iarch(out.len) - 1)
}

# The end byte-col (exclusive) of the token at `c0` in `ln`: identifier bytes and `::`
# separators, so a full path (`std::mem::raw::trap`) squiggles whole. At least one character.
const token_end = (Str ln, Iarch c0): Iarch -> {
	let Iarch i = c0

	loop {
		if i >= Iarch(ln.len) then break

		if name_byte(Iarch(ln[i])) then {
			i = i + 1
			continue
		}
		if Iarch(ln[i]) == 58 && i + 1 < Iarch(ln.len) && Iarch(ln[i + 1]) == 58 then {
			i = i + 2
			continue
		}

		break
	}

	if i <= c0 then return c0 + 1

	return i
}

# One LSP diagnostic at the 0-based position, underlining `c0..c1`.
const build_diag! = (Iarch l0, Iarch c0, Iarch c1, Str msg): Json -> Json.Obj([
	ent("range", jrange!(l0, c0, c1)),
	ent("severity", jnum(1)),
	ent("source", jstr("cf")),
	ent("message", jstr(msg)),
])

# Whether `s` is one of `xs`.
const in_list = (Str s, [Str] xs): Bool -> {
	for x in xs {
		if eq(x, s) then return true
	}

	return false
}

# Publish `diags` to one uri.
const publish! = (Str uri, [Json] diags): () ->
	send!(Json.Obj([
		ent("jsonrpc", jstr("2.0")),
		ent("method", jstr("textDocument/publishDiagnostics")),
		ent("params", Json.Obj([
			ent("uri", jstr(uri)),
			ent("diagnostics", Json.Arr(diags)),
		])),
	]))

# Run `cf check` on the uri's file in a child (stderr captured to a temp file) and publish the
# diagnostics PER FILE: each located line goes to its own file's uri (relative paths absolutize
# against `$PWD` when the file exists there; a line that resolves nowhere lands on the checked
# file at 0:0 with its full text). The checked uri always gets a publish — an empty list clears
# it when clean — and the uris that carried diagnostics last round but are quiet now are cleared
# too (the set persists in `.pub` beside the capture file, so the state survives the per-frame
# arena). A non-empty `src` is the overlay file standing in for the entry's bytes (didChange —
# the unsaved buffer), forwarded as `cf check --src`.
const check_and_publish! = (Str argv0, [Str] env, Str uri, Str src): () -> {
	if !starts_with("file://", uri) then return ()
	const Str path = uri_to_path!(uri)
	const Str tmp = "/tmp/cf-lsp-${getpid()}.diag"
	const Str pubf = "/tmp/cf-lsp-${getpid()}.pub"

	const Str sh = match find_executable!(env, "sh") {
		Either.Right(p) -> p,
		Either.Left(e) -> {
			eprint("cf lsp: no `sh` on PATH\n")

			<- ""
		},
	}

	if eq(sh, "") then return ()
	let Str cmd = "'${argv0}' check '${path}' 2> '${tmp}'"
	if Iarch(src.len) > 0 then cmd = "'${argv0}' check '${path}' --src '${src}' 2> '${tmp}'"
	const Iarch rc = run!(sh, ["sh", "-c", cmd], env)

	# flat (uri, diagnostic) pairs — grouped per uri at publish time
	let [Str] duris = []
	let [Json] djson = []

	if rc != 0 then {
		const Str captured = match read_file!(tmp) {
			Either.Right(s) -> s,
			Either.Left(e) -> "",
		}

		const [Str] lines = split("\n", captured)
		const Str pwd = getenv!(env, "PWD")
		# diagnosed files read ONCE (their line texts widen each squiggle to the whole token)
		let [Str] fpaths = []
		let [Str] ftexts = []

		for ln in lines {
			if Iarch(ln.len) > 0 then {
				const Loc lc = scan_loc(ln)
				let Str target = uri
				let Iarch l0 = 0
				let Iarch c0 = 0
				let Iarch c1 = 1
				let Str msg = ln

				if lc.plen >= 0 then {
					const Str f = slice(0, lc.plen, ln)
					let Str fabs = ""
					if eq(f, path) then fabs = path
					if Iarch(fabs.len) == 0 && starts_with("/", f) then fabs = f

					if Iarch(fabs.len) == 0 && Iarch(pwd.len) > 0 then {
						const Str cand = "${pwd}/${f}"
						if exists!(cand) then fabs = cand
					}

					if Iarch(fabs.len) > 0 then {
						if !eq(fabs, path) then target = path_uri!(fabs)
						l0 = lc.ln - 1
						c0 = lc.col - 1
						if l0 < 0 then l0 = 0
						if c0 < 0 then c0 = 0
						msg = slice(lc.moff, Iarch(ln.len), ln)

						# widen the point stamp to the token under it, reading the diagnosed
						# file (the live `--src` overlay stands in for the checked file)
						let Str ftext = ""
						let Bool seen = false
						let Iarch fi = 0

						loop {
							if fi >= Iarch(fpaths.len) then break

							if eq(fpaths[fi], fabs) then {
								ftext = ftexts[fi]
								seen = true
								break
							}

							fi = fi + 1
						}

						if !seen then {
							let Str rp = fabs
							if eq(fabs, path) && Iarch(src.len) > 0 then rp = src

							ftext = match read_file!(czstr!(rp)) {
								Either.Right(fs) -> fs,
								Either.Left(fe) -> "",
							}

							fpaths = [...fpaths, fabs]
							ftexts = [...ftexts, ftext]
						}

						c1 = c0 + 1
						const [Str] flines = split("\n", ftext)
						if l0 < Iarch(flines.len) then c1 = token_end(flines[l0], c0)
					}
				}

				duris = [...duris, target]
				djson = [...djson, build_diag!(l0, c0, c1, msg)]
			}
		}
	}

	remove(tmp)

	# last round's diag-bearing uris — cleared below when quiet this round
	const Str prev = match read_file!(pubf) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	# this round's target uris, deduped; the checked uri is always among them
	let [Str] cur = []

	for u in duris {
		if !in_list(u, cur) then cur = [...cur, u]
	}

	if !in_list(uri, cur) then cur = [...cur, uri]

	for u in cur {
		let [Json] group = []
		let Iarch k = 0

		loop {
			if k >= Iarch(duris.len) then break
			if eq(duris[k], u) then group = [...group, djson[k]]
			k = k + 1
		}

		publish!(u, group)
	}

	const [Json] none = []

	for p in split("\n", prev) {
		if Iarch(p.len) > 0 && !in_list(p, cur) then publish!(p, none)
	}

	let Str persisted = ""

	for u in cur {
		persisted = "${persisted}${u}\n"
	}

	write_file(pubf, persisted)
}

const init_result! = (): Json -> Json.Obj([
	ent("capabilities", Json.Obj([
		ent("textDocumentSync", Json.Obj([
			ent("openClose", Json.Bool(true)),
			# 1 = FULL sync: every didChange carries the whole buffer, checked live via the
			# `--src` overlay (a full check of the biggest std module is ~100 ms — no debounce)
			ent("change", jnum(1)),
			ent("save", Json.Bool(true)),
		])),
		ent("documentSymbolProvider", Json.Bool(true)),
		ent("definitionProvider", Json.Bool(true)),
		ent("hoverProvider", Json.Bool(true)),
		ent("referencesProvider", Json.Bool(true)),
		# prepareRename lets the editor validate the position (and show the right placeholder)
		# before prompting — the same renameability check rename itself makes
		ent("renameProvider", Json.Obj([ent("prepareProvider", Json.Bool(true))])),
		ent("documentHighlightProvider", Json.Bool(true)),
		ent("completionProvider", Json.Obj([
			ent("triggerCharacters", Json.Arr([jstr(":"), jstr(".")])),
		])),
		ent("positionEncoding", jstr("utf-8")),
	])),
	ent("serverInfo", Json.Obj([ent("name", jstr("cf lsp"))])),
])

# --- symbols ----------------------------------------------------------------------------------

# A name byte: what a top-level declaration's name is made of (stops at ` `, `=`, `:`, `(`, …).
const name_byte = (Iarch c): Bool ->
	(c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) ||
	c == 95 || c == 33 || c == 39

# A scanned top-level declaration line: its LSP SymbolKind (0 when the line opens no
# declaration) and the declared name's byte span `ns..ne`.
data DeclLine = { Iarch kind, Iarch ns, Iarch ne }

# Scan one line for a top-level declaration. cf's formatter pins declarations to column 0, so
# a leading keyword IS top-level; the LSP SymbolKinds: 12 Function, 14 Constant, 23 Struct,
# 10 Enum, 5 Class (a type alias). The shared leaf of documentSymbol and goto-definition.
const scan_decl = (Str ln): DeclLine -> {
	let Iarch koff = 0
	if starts_with("pub ", ln) then koff = 4
	const Str rest = slice(koff, Iarch(ln.len), ln)
	let Iarch klen = -1
	let Iarch kind = 0

	if starts_with("const ", rest) then {
		klen = 6
		kind = 14
	}
	if klen < 0 && starts_with("intrinsic ", rest) then {
		klen = 10
		kind = 14
	}
	if klen < 0 && starts_with("data ", rest) then {
		klen = 5
		kind = 23
	}
	if klen < 0 && starts_with("union ", rest) then {
		klen = 6
		kind = 10
	}
	if klen < 0 && starts_with("type ", rest) then {
		klen = 5
		kind = 5
	}
	if klen < 0 then return DeclLine({ kind: 0, ns: 0, ne: 0 })
	# a value that binds a `(...)` is a function — `const f = (…): T -> …` (intrinsics likewise)
	if kind == 14 && contains("= (", ln) then kind = 12

	const Iarch ns = koff + klen
	let Iarch ne = ns

	loop {
		if ne >= Iarch(ln.len) || !name_byte(Iarch(ln[ne])) then break
		ne = ne + 1
	}

	if ne == ns then return DeclLine({ kind: 0, ns: 0, ne: 0 })

	return DeclLine({ kind: kind, ns: ns, ne: ne })
}

# One line's top-level declaration as a DocumentSymbol, or Null when the line opens none.
const sym_of_line! = (Str ln, Iarch l0): Json -> {
	const DeclLine d = scan_decl(ln)
	if d.kind == 0 then return Json.Null

	return Json.Obj([
		ent("name", jstr(slice(d.ns, d.ne, ln))),
		ent("kind", jnum(d.kind)),
		ent("range", jrange!(l0, 0, Iarch(ln.len))),
		ent("selectionRange", jrange!(l0, d.ns, d.ne)),
	])
}

# Every top-level declaration of `src` as a flat DocumentSymbol list.
const scan_symbols! = (Str src): [Json] -> {
	const [Str] lines = split("\n", src)
	let [Json] out = []
	let Iarch i = 0

	for ln in lines {
		const Json s = sym_of_line!(ln, i)
		const Bool keep = match s { Json.Null -> false, _ -> true }
		if keep then out = [...out, s]
		i = i + 1
	}

	return out
}

# Answer a documentSymbol request: read the uri's file — or the live `--src` overlay when one
# is standing in for exactly this file — and scan its top-level declarations.
const doc_symbols! = (Str uri, Str srcf, Str srcp): Json -> {
	const Str path = uri_to_path!(uri)

	let Str from = path
	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	if eq(owner, path) then from = srcf

	const Str src = match read_file!(from) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	return Json.Arr(scan_symbols!(src))
}

# --- goto definition --------------------------------------------------------------------------

# A number payload as an integer (LSP positions), or -1 when the value is no number.
const jint = (Json j): Iarch -> match j { Json.Num(s) -> to_int(s), _ -> -1 }

# The start byte-col of the token covering `c` in `ln`: identifier bytes and `::` pairs scanned
# backward — the mirror of `token_end`, so the two of them bracket a full qualified path.
const token_start = (Str ln, Iarch c): Iarch -> {
	let Iarch i = c

	loop {
		if i > 0 && name_byte(Iarch(ln[i - 1])) then {
			i = i - 1
			continue
		}
		if i > 1 && Iarch(ln[i - 1]) == 58 && Iarch(ln[i - 2]) == 58 then {
			i = i - 2
			continue
		}

		break
	}

	return i
}

# `f` as an absolute path: itself when already absolute, else resolved against `pwd` when it
# exists there, else "" (not visible from this working directory).
const abs_path! = (Str pwd, Str f): Str -> {
	if starts_with("/", f) then return f

	if Iarch(pwd.len) > 0 then {
		const Str cand = "${pwd}/${f}"
		if exists!(cand) then return cand
	}

	return ""
}

# One indexed name — a top-level declaration, or a union member (kind 22, EnumMember): its
# as-written name, its SymbolKind, its absolute file, 0-based line, and the name's byte span.
# The shared currency of goto-definition, hover, and completion.
data SymRow = { Str sname, Iarch kind, Str file, Iarch line, Iarch ns, Iarch ne }

# The resolved module tree of `path` — each declaration-bearing source file, the entry first —
# via a child `cf modules` run: the same child-process discipline as diagnostics, so a
# parse-broken buffer never takes the server down. A successful list is cached (first line =
# the entry it belongs to); on failure the cache stands in when it is this entry's — goto
# keeps working mid-edit from the last good resolve. A non-empty `src` is the overlay file
# standing in for the entry's bytes.
const modules_of! = (Str argv0, [Str] env, Str path, Str src): [Str] -> {
	const Str tmp = "/tmp/cf-lsp-${getpid()}.mods"
	const Str cache = "/tmp/cf-lsp-${getpid()}.modc"
	const [Str] none = []

	const Str sh = match find_executable!(env, "sh") {
		Either.Right(p) -> p,
		Either.Left(e) -> "",
	}

	if eq(sh, "") then return none
	let Str cmd = "'${argv0}' lsp modules '${path}' > '${tmp}' 2> /dev/null"
	if Iarch(src.len) > 0 then cmd = "'${argv0}' lsp modules '${path}' --src '${src}' > '${tmp}' 2> /dev/null"
	const Iarch rc = run!(sh, ["sh", "-c", cmd], env)

	let Str got = ""

	if rc == 0 then {
		got = match read_file!(tmp) {
			Either.Right(s) -> s,
			Either.Left(e) -> "",
		}

		write_file(cache, "${path}\n${got}")
	} else {
		# a failed resolve (mid-edit): the cached list, if it belongs to this entry
		const Str prev = match read_file!(cache) {
			Either.Right(s) -> s,
			Either.Left(e) -> "",
		}

		const Iarch nl = index_of("\n", prev)

		if nl > 0 && eq(slice(0, nl, prev), path) then
			got = slice(nl + 1, Iarch(prev.len), prev)
	}

	remove(tmp)
	let [Str] mods = []

	for m in split("\n", got) {
		if Iarch(m.len) > 0 then mods = [...mods, m]
	}

	return mods
}

# The absolute files to index: the checked file first (always — even when the module list is
# stale or empty), then each module file that resolves from `pwd`.
const scan_files! = ([Str] mods, Str path, Str pwd): [Str] -> {
	let [Str] scan = [path]

	for m in mods {
		const Str a = abs_path!(pwd, m)
		if Iarch(a.len) > 0 && !in_list(a, scan) then scan = [...scan, a]
	}

	return scan
}

# The bytes of `f` — from the `--src` overlay buffer when `f` is the file the overlay owns.
const src_of! = (Str f, Str owner, Str srcf): Str -> {
	let Str from = f
	if eq(owner, f) then from = srcf

	return match read_file!(czstr!(from)) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}
}

# Every top-level declaration across the scan files, as indexed rows.
const all_decls! = ([Str] scan, Str owner, Str srcf): [SymRow] -> {
	let [SymRow] rows = []

	for f in scan {
		const [Str] lines = split("\n", src_of!(f, owner, srcf))
		let Iarch l = 0

		for ln in lines {
			const DeclLine d = scan_decl(ln)

			if d.kind > 0 then {
				rows = [...rows, SymRow({
					sname: slice(d.ns, d.ne, ln),
					kind: d.kind,
					file: f,
					line: l,
					ns: d.ns,
					ne: d.ne,
				})]
			}

			l = l + 1
		}
	}

	return rows
}

# The first non-whitespace byte's index of `ln`, or -1 for an all-whitespace line.
const first_nonws = (Str ln): Iarch -> {
	let Iarch i = 0

	loop {
		if i >= Iarch(ln.len) then break
		if Iarch(ln[i]) != 9 && Iarch(ln[i]) != 32 then return i
		i = i + 1
	}

	return -1
}

# The end of the name run starting at `i` in `ln`.
const name_end = (Str ln, Iarch i): Iarch -> {
	let Iarch e = i

	loop {
		if e >= Iarch(ln.len) || !name_byte(Iarch(ln[e])) then break
		e = e + 1
	}

	return e
}

# Every member of the union declared `base` across the scan files, as rows (kind 22,
# EnumMember). A member is the LEADING name run of a body line (the formatter's shape — a
# payload type like `Num(Str)`'s `Str` sits behind a paren and never leads), or, for a union
# written on its declaration line, a run after the `{` or a paren-depth-0 `,`. Comment and
# blank lines inside the body are skipped; the closing `}` ends it.
const union_members! = ([Str] scan, Str owner, Str srcf, Str base): [SymRow] -> {
	let [SymRow] rows = []

	for f in scan {
		const [Str] lines = split("\n", src_of!(f, owner, srcf))
		let Bool inun = false
		let Iarch l = 0

		for ln in lines {
			if inun then {
				const Iarch nw = first_nonws(ln)

				if nw >= 0 && Iarch(ln[nw]) == 125 then inun = false

				if inun && nw >= 0 && name_byte(Iarch(ln[nw])) then {
					const Iarch me = name_end(ln, nw)

					rows = [...rows, SymRow({
						sname: slice(nw, me, ln),
						kind: 22,
						file: f,
						line: l,
						ns: nw,
						ne: me,
					})]
				}
			} else {
				const DeclLine d = scan_decl(ln)

				if d.kind == 10 && eq(slice(d.ns, d.ne, ln), base) then {
					const Iarch ob = index_of("{", ln)
					let Bool closed = false

					if ob >= 0 then {
						let Iarch i = ob + 1
						let Iarch depth = 0
						let Bool expect = true

						loop {
							if i >= Iarch(ln.len) then break
							const Iarch ch = Iarch(ln[i])
							if ch == 40 then depth = depth + 1
							if ch == 41 then depth = depth - 1

							if ch == 125 && depth == 0 then {
								closed = true
								break
							}

							if depth == 0 && ch == 44 then expect = true

							if depth == 0 && expect && name_byte(ch) then {
								const Iarch me = name_end(ln, i)

								rows = [...rows, SymRow({
									sname: slice(i, me, ln),
									kind: 22,
									file: f,
									line: l,
									ns: i,
									ne: me,
								})]
								expect = false
								i = me
								continue
							}

							i = i + 1
						}
					}

					if !closed then inun = true
				}
			}

			l = l + 1
		}
	}

	return rows
}

# The (start, end) span of the trailing identifier in ln[lo..hi) — a record field's NAME,
# written after its type. Trailing whitespace and `,` are skipped first; end <= start when
# the tail is no identifier.
const trail_ident = (Str ln, Iarch lo, Iarch hi): (Iarch, Iarch) -> {
	let Iarch e = hi
	if e > Iarch(ln.len) then e = Iarch(ln.len)

	loop {
		if e <= lo then break
		const Iarch b = Iarch(ln[e - 1])
		if b != 32 && b != 9 && b != 44 && b != 13 then break
		e = e - 1
	}

	let Iarch s = e

	loop {
		if s <= lo then break
		if !name_byte(Iarch(ln[s - 1])) then break
		s = s - 1
	}

	return (s, e)
}

# Record FIELDS named `want` across the scan files — the goto/hover fallback for a
# `base.field` read on a lowercase base: with no type information, every `data` record
# declaring the field answers (the editor lists the candidates). A field line's name is its
# LAST identifier (the type precedes it; an inline `#` comment is cut first); a single-line
# body splits on top-level commas, parens tracked so a tuple field's inner commas don't.
const rec_fields! = ([Str] scan, Str owner, Str srcf, Str want): [SymRow] -> {
	let [SymRow] rows = []

	for f in scan {
		const [Str] lines = split("\n", src_of!(f, owner, srcf))
		let Bool inrec = false
		let Iarch l = 0

		for ln in lines {
			if inrec then {
				const Iarch nw = first_nonws(ln)

				if nw >= 0 && Iarch(ln[nw]) == 125 then inrec = false

				if inrec && nw >= 0 && Iarch(ln[nw]) != 35 then {
					let Iarch hi = index_of("#", ln)
					if hi < 0 then hi = Iarch(ln.len)
					const (fs, fe) = trail_ident(ln, nw, hi)

					if fe > fs && eq(slice(fs, fe, ln), want) then {
						rows = [...rows, SymRow({ sname: want, kind: 8, file: f, line: l, ns: fs, ne: fe })]
					}
				}
			} else {
				const DeclLine d = scan_decl(ln)

				if d.kind == 23 then {
					const Iarch ob = index_of("{", ln)
					let Bool closed = false

					if ob >= 0 then {
						let Iarch i = ob + 1
						let Iarch ss = ob + 1
						let Iarch depth = 0

						loop {
							if i >= Iarch(ln.len) then break
							const Iarch ch = Iarch(ln[i])
							if ch == 40 then depth = depth + 1
							if ch == 41 then depth = depth - 1

							if depth == 0 && (ch == 44 || ch == 125) then {
								const (fs, fe) = trail_ident(ln, ss, i)

								if fe > fs && eq(slice(fs, fe, ln), want) then {
									rows = [...rows, SymRow({ sname: want, kind: 8, file: f, line: l, ns: fs, ne: fe })]
								}

								ss = i + 1
							}

							if ch == 125 && depth == 0 then {
								closed = true
								break
							}

							i = i + 1
						}
					}

					if !closed then inrec = true
				}
			}

			l = l + 1
		}
	}

	return rows
}

# Whether every hint segment appears in `file` as a path component (`/seg/`) or as the file
# itself (`/seg.cf`) — how a qualified use (`str::eq`, `std::data::json::parse!`) narrows
# same-named candidates. An alias hint that matches nothing leaves the caller's full set.
const hint_ok! = ([Str] hints, Iarch n, Str file): Bool -> {
	let Iarch i = 0

	loop {
		if i >= n then break
		const Str h = hints[i]
		if !contains("/${h}/", file) && !contains("/${h}.cf", file) then return false
		i = i + 1
	}

	return true
}

# An LSP Location in `file` (the request's own `uri` is echoed for the checked file itself, so
# the client sees exactly the identity it asked about).
const location! = (Str uri, Str path, Str file, Iarch l0, Iarch c0, Iarch c1): Json -> {
	let Str u = ""
	if eq(file, path) then u = uri else u = path_uri!(file)

	return Json.Obj([ent("uri", jstr(u)), ent("range", jrange!(l0, c0, c1))])
}

# The qualified token covering the cursor, decomposed for resolution: `ok` false when no
# token sits there; `name` the segment the cursor is IN (the sought declaration); `hints` the
# segments before it (path narrowing); `lead` the segments through it (a module path); `ts`/
# `te` the whole token's byte span; and `base` — the `Type` of a directly preceding `Type.`
# (uppercase first byte, a union-member use), else "".
data TokCtx = { Bool ok, Str name, [Str] hints, [Str] lead, Iarch ts, Iarch te, Str base }

const no_tok = (): TokCtx -> {
	const [Str] none = []

	return TokCtx({ ok: false, name: "", hints: none, lead: none, ts: 0, te: 0, base: "" })
}

# The `Type` of a `Type.` directly before the token starting at `ts`, else "" (a lowercase
# base is a record variable — its fields are not scanned).
const dot_base = (Str ln, Iarch ts): Str -> {
	if ts <= 0 || Iarch(ln[ts - 1]) != 46 then return ""
	const Iarch bs = token_start(ln, ts - 1)
	if bs >= ts - 1 then return ""
	if Iarch(ln[bs]) < 65 || Iarch(ln[bs]) > 90 then return ""

	return slice(bs, ts - 1, ln)
}

# Decompose the token under (or just left of) the cursor at byte-col `c0` of `ln`.
const token_at = (Str ln, Iarch c0): TokCtx -> {
	let Iarch c = c0
	if c < 0 then c = 0
	if c > Iarch(ln.len) then c = Iarch(ln.len)

	if c >= Iarch(ln.len) || !name_byte(Iarch(ln[c])) then {
		if c > 0 && name_byte(Iarch(ln[c - 1])) then c = c - 1
	}

	if c >= Iarch(ln.len) || !name_byte(Iarch(ln[c])) then return no_tok()
	const Iarch ts = token_start(ln, c)
	const Iarch te = token_end(ln, ts)
	const Str tok = slice(ts, te, ln)
	const [Str] segs = split("::", tok)

	# the segment the cursor sits in: the sought name; the ones before it: path hints
	const Iarch rel = c - ts
	let Iarch csel = Iarch(segs.len) - 1
	let Iarch acc = 0
	let Iarch si = 0
	let Bool found = false

	for s in segs {
		if !found && rel >= acc && rel <= acc + Iarch(s.len) then {
			csel = si
			found = true
		}

		acc = acc + Iarch(s.len) + 2
		si = si + 1
	}

	let [Str] hints = []
	let [Str] lead = []
	let Iarch hi = 0

	for s in segs {
		if hi < csel then hints = [...hints, s]
		if hi <= csel then lead = [...lead, s]
		hi = hi + 1
	}

	const Str name = "${segs[csel]}"
	if Iarch(name.len) == 0 then return no_tok()

	return TokCtx({
		ok: true,
		name: name,
		hints: hints,
		lead: lead,
		ts: ts,
		te: te,
		base: dot_base(ln, ts),
	})
}

# The typed prefix LEFT of the cursor, decomposed like `token_at` but never looking right —
# completion works on what is already typed. `name` is the partial last segment (may be
# empty, right after a `::` or `.`); always `ok`.
const cprefix = (Str ln, Iarch c0): TokCtx -> {
	let Iarch c = c0
	if c < 0 then c = 0
	if c > Iarch(ln.len) then c = Iarch(ln.len)
	const Iarch ts = token_start(ln, c)
	const Str tok = slice(ts, c, ln)
	const [Str] segs = split("::", tok)
	const Iarch last = Iarch(segs.len) - 1

	let [Str] hints = []
	let Iarch hi = 0

	for s in segs {
		if hi < last then hints = [...hints, s]
		hi = hi + 1
	}

	return TokCtx({
		ok: true,
		name: "${segs[last]}",
		hints: hints,
		lead: hints,
		ts: ts,
		te: c,
		base: dot_base(ln, ts),
	})
}

# The resolved hits and the module list behind them (goto's module-path fallback reuses the
# list without a second child run).
data DefOut = { [SymRow] hits, [Str] mods }

# A `cf lsp` child run's outcome: its exit code, the byte offset the query was made at, and
# the raw stdout capture. The capture is read REGARDLESS of the exit code — a tracked parse
# that DIES on a mid-edit buffer salvage-dumps its partial bind-event log to stdout first
# (parser.cf `dump_evs`), and the caller decides what a truncated log may answer: goto and
# completion replay it (they only need events before the cursor), references/rename refuse it.
data ChildOut = { Iarch rc, Iarch off, Str out }

# Only a bare lowercase token can be a LOCAL — a qualified or `Type.`-based one never is.
const local_token = (TokCtx t): Bool -> {
	if Iarch(t.hints.len) > 0 || Iarch(t.base.len) > 0 then return false
	const Iarch b0 = Iarch(t.name[0])

	return !(b0 >= 65 && b0 <= 90)
}

# A bare token (no path qualifier, no `Type.` base) — what the refs child can answer: a
# lowercase one may be a local (or a non-pub function), an UPPERCASE one a type declared
# in this very file. A qualified use names an import — cross-file, refused here.
const bare_token = (TokCtx t): Bool ->
	Iarch(t.hints.len) == 0 && Iarch(t.base.len) == 0

# Run a `cf lsp <verb>` local-binding child at byte position (l0, ts) of the buffer `lines`
# came from. An empty `name` omits the argument (the `scope` verb takes none).
const lsp_child! = (Str argv0, [Str] env, Str path, Str overlay, [Str] lines, Iarch l0, Iarch ts, Str verb, Str name): ChildOut -> {
	const Str sh = match find_executable!(env, "sh") {
		Either.Right(p) -> p,
		Either.Left(e) -> "",
	}

	if eq(sh, "") then return ChildOut({ rc: -1, off: 0, out: "" })
	# the position's byte offset in the (possibly overlaid) buffer
	let Iarch off = ts
	let Iarch li = 0

	for ln in lines {
		if li >= l0 then break
		off = off + Iarch(ln.len) + 1
		li = li + 1
	}

	const Str tmp = "/tmp/cf-lsp-${getpid()}.def"
	let Str narg = ""
	if Iarch(name.len) > 0 then narg = " '${name}'"
	let Str ov = ""
	if Iarch(overlay.len) > 0 then ov = " --src '${overlay}'"
	const Str cmd = "'${argv0}' lsp ${verb} '${path}' ${off}${narg}${ov} > '${tmp}' 2> /dev/null"
	const Iarch rc = run!(sh, ["sh", "-c", cmd], env)
	const Str got = match read_file!(tmp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	remove(tmp)

	return ChildOut({ rc: rc, off: off, out: got })
}

# A child run with DECLARATION-CHUNK isolation applied: the outcome, whether it ran against
# the cursor's chunk instead of the whole buffer, the line delta `dl` chunk answers shift by,
# and the lines the child actually saw (`clines` — salvage offsets convert through them).
data Iso = { ChildOut co, Bool chunked, Iarch dl, [Str] clines }

# Try the FULL buffer first; when its parse dies, isolate the cursor's enclosing top-level
# declaration (col-0 decl anchors — the same line scan everything else trusts) into a
# mini-buffer of just those lines and retry. A break in ANOTHER declaration then cannot
# poison this one's answers — and when the cursor's own declaration is the broken one, the
# chunk's salvage dump still covers it up to the break. A chunk sees ONE declaration:
# complete for LOCALS (a local cannot escape its declaration), but a `top` references
# answer from one must be discarded by the caller (top-level uses span the whole file).
const lsp_child_iso! = (Str argv0, [Str] env, Str path, Str overlay, [Str] lines, Iarch l0, Iarch ts, Str verb, Str name): Iso -> {
	const ChildOut full = lsp_child!(argv0, env, path, overlay, lines, l0, ts, verb, name)
	if full.rc == 0 then return Iso({ co: full, chunked: false, dl: 0, clines: lines })

	# the chunk: from the nearest decl anchor at or above the cursor to the next one below
	let Iarch ds = l0

	loop {
		if ds <= 0 then break
		if scan_decl(lines[ds]).kind != 0 then break
		ds = ds - 1
	}

	let Iarch de = l0 + 1

	loop {
		if de >= Iarch(lines.len) then break
		if scan_decl(lines[de]).kind != 0 then break
		de = de + 1
	}

	# the chunk IS the whole buffer: retrying buys nothing
	if ds == 0 && de >= Iarch(lines.len)
		then return Iso({ co: full, chunked: false, dl: 0, clines: lines })

	let [Str] mlines = []
	let Iarch i = ds

	loop {
		if i >= de then break
		mlines = [...mlines, lines[i]]
		i = i + 1
	}

	let Str mini = ""

	for ml in mlines {
		mini = "${mini}${ml}\n"
	}

	const Str part = "/tmp/cf-lsp-${getpid()}.part"
	write_file(part, mini)
	const ChildOut ch = lsp_child!(argv0, env, path, part, mlines, l0 - ds, ts, verb, name)
	remove(part)

	return Iso({ co: ch, chunked: true, dl: ds, clines: mlines })
}

# A reference row shifted back into whole-buffer line numbers (chunk answers carry `dl`).
const row_shift = (SymRow r, Iarch dl): SymRow -> SymRow({
	sname: r.sname,
	kind: r.kind,
	file: r.file,
	line: r.line + dl,
	ns: r.ns,
	ne: r.ne,
})

# --- the salvage replay: a dying child's partial event log, replayed server-side ---------------

# One salvage-dump line `off:kind:name` (kinds: 0 scope-open, 1 close, 2..5 binds, 6 use,
# 7 the BREAK marker a dying parse ends its dump with; the name is empty on open/close/break).
# `off` -1 on anything else.
data EvRow = { Iarch off, Iarch kind, Str name }

const ev_row = (Str sl): EvRow -> {
	const EvRow bad = EvRow({ off: -1, kind: 0, name: "" })
	const Iarch c1 = index_of(":", sl)
	if c1 <= 0 then return bad
	const Str r1 = slice(c1 + 1, Iarch(sl.len), sl)
	const Iarch c2 = index_of(":", r1)
	if c2 <= 0 then return bad

	return EvRow({
		off: to_int(slice(0, c1, sl)),
		kind: to_int(slice(0, c2, r1)),
		name: slice(c2 + 1, Iarch(r1.len), r1),
	})
}

const parse_evs = (Str out): [EvRow] -> {
	let [EvRow] evs = []

	for sl in split("\n", out) {
		const EvRow r = ev_row(sl)
		if r.off >= 0 then evs = [...evs, r]
	}

	return evs
}

# Byte offset -> (0-based line, byte col) in `lines`; (-1, -1) past the end.
const lc_of = ([Str] lines, Iarch off): (Iarch, Iarch) -> {
	let Iarch rem = off
	let Iarch li = 0

	for ln in lines {
		if rem <= Iarch(ln.len) then return (li, rem)
		rem = rem - Iarch(ln.len) - 1
		li = li + 1
	}

	return (-1, -1)
}

# The byte offset of the innermost binding of `name` still live at `off`, or -1 — the
# server-side port of cf.cf's `binder_at!` for salvaged logs (same replay: binds 2..5 collect
# with their depth, a close drops its scope's binds, the last survivor wins).
const salvage_binder! = ([EvRow] evs, Iarch off, Str name): Iarch -> {
	let Iarch depth = 0
	let [Iarch] boffs = []
	let [Iarch] bdeps = []

	for ev in evs {
		if ev.off > off then break
		# the parse broke BEFORE the cursor: the log does not cover it — a truncated log
		# leaves earlier scopes open, so answering would name a binder the cursor never sees
		if ev.kind == 7 then return -1
		if ev.kind == 0 then depth = depth + 1
		if ev.kind == 1 then {
			let [Iarch] ko = []
			let [Iarch] kd = []

			for (b, i) in boffs {
				if bdeps[i] < depth then {
					ko = [...ko, b]
					kd = [...kd, bdeps[i]]
				}
			}

			boffs = ko
			bdeps = kd
			depth = depth - 1
		}
		if ev.kind >= 2 && ev.kind <= 5 && eq(ev.name, name) then {
			boffs = [...boffs, ev.off]
			bdeps = [...bdeps, depth]
		}
	}

	if Iarch(boffs.len) == 0 then return -1

	return boffs[Iarch(boffs.len) - 1]
}

# Every binding live at `off`, innermost first, deduped by name — the server-side port of
# cf.cf's `run_scope!` core for salvaged logs.
const salvage_scope! = ([EvRow] evs, Iarch off): [EvRow] -> {
	let Iarch depth = 0
	let [EvRow] live = []
	let [Iarch] ldep = []

	for ev in evs {
		if ev.off > off then break
		# the break sits before the cursor: the log does not cover it — offer nothing
		if ev.kind == 7 then {
			const [EvRow] none = []

			return none
		}
		if ev.kind == 0 then depth = depth + 1
		if ev.kind == 1 then {
			let [EvRow] ko = []
			let [Iarch] kd = []

			for (b, i) in live {
				if ldep[i] < depth then {
					ko = [...ko, b]
					kd = [...kd, ldep[i]]
				}
			}

			live = ko
			ldep = kd
			depth = depth - 1
		}
		if ev.kind >= 2 && ev.kind <= 5 then {
			live = [...live, ev]
			ldep = [...ldep, depth]
		}
	}

	let [EvRow] out = []
	let [Str] seen = []
	let Iarch i = Iarch(live.len) - 1

	loop {
		if i < 0 then break

		if !in_list(live[i].name, seen) then {
			seen = [...seen, live[i].name]
			out = [...out, live[i]]
		}

		i = i - 1
	}

	return out
}

# One local visible at the completion cursor: its name and its binder's 0-based line (the
# line's text becomes the completion detail).
data LocalRow = { Str name, Iarch line }

# The locals visible at (l0, ts), innermost first — via the `scope` child on a parsed buffer,
# or the salvage replay of the dying child's partial log on a broken one. No token gate: an
# empty typed prefix still has a scope.
const locals_at! = (Str argv0, [Str] env, Str path, Str overlay, [Str] lines, Iarch l0, Iarch ts): [LocalRow] -> {
	const Iso iso = lsp_child_iso!(argv0, env, path, overlay, lines, l0, ts, "scope", "")
	const ChildOut co = iso.co
	let [LocalRow] rows = []

	if co.rc == 0 then {
		# `line:col:kind:name` per line, innermost first
		for sl in split("\n", co.out) {
			const Iarch c1 = index_of(":", sl)
			if c1 <= 0 then continue
			const Str rest1 = slice(c1 + 1, Iarch(sl.len), sl)
			const Iarch c2 = index_of(":", rest1)
			if c2 <= 0 then continue
			const Str rest2 = slice(c2 + 1, Iarch(rest1.len), rest1)
			const Iarch c3 = index_of(":", rest2)
			if c3 <= 0 then continue
			const Str nm = slice(c3 + 1, Iarch(rest2.len), rest2)
			const Iarch bl = to_int(slice(0, c1, sl))
			if bl <= 0 || Iarch(nm.len) == 0 then continue
			rows = [...rows, LocalRow({ name: nm, line: bl - 1 + iso.dl })]
		}

		return rows
	}

	# broken buffer: replay whatever the parse collected before the break
	const [EvRow] live = salvage_scope!(parse_evs(co.out), co.off)

	for r in live {
		const (bl, bc) = lc_of(iso.clines, r.off)
		if bl >= 0 && Iarch(r.name.len) > 0 then rows = [...rows, LocalRow({ name: r.name, line: bl + iso.dl })]
	}

	return rows
}

# One `line:col` output line as a reference row of the cursor's name in `path` (0-based, the
# name's span), or line -1 on anything else.
const ref_row = (Str lref, Str path, Str name): SymRow -> {
	const SymRow miss = SymRow({ sname: "", kind: 0, file: "", line: -1, ns: 0, ne: 0 })
	const Iarch co = index_of(":", lref)
	if co <= 0 then return miss
	const Iarch bl = to_int(slice(0, co, lref))
	const Iarch bc = to_int(slice(co + 1, Iarch(lref.len), lref))
	if bl <= 0 || bc <= 0 then return miss

	return SymRow({
		sname: name,
		kind: 13,
		file: path,
		line: bl - 1,
		ns: bc - 1,
		ne: bc - 1 + Iarch(name.len),
	})
}

# The LOCAL binding of the token under the cursor, via a `cf lsp def` child run. `line` is -1
# when no local binds the name — the caller falls back to the top-level declaration index. On
# a BROKEN buffer the dying child's salvaged log is replayed here: everything the parse
# collected before the break, which covers any cursor above it.
const local_def! = (Str argv0, [Str] env, Str path, Str overlay, [Str] lines, Iarch l0, TokCtx t): SymRow -> {
	const SymRow miss = SymRow({ sname: "", kind: 0, file: "", line: -1, ns: 0, ne: 0 })
	if !local_token(t) then return miss
	const Iso iso = lsp_child_iso!(argv0, env, path, overlay, lines, l0, t.ts, "def", t.name)
	const ChildOut co = iso.co

	if co.rc == 0 then {
		let Str got = co.out
		const Iarch nl = index_of("\n", got)
		if nl > 0 then got = slice(0, nl, got)
		const SymRow r = ref_row(got, path, t.name)
		if r.line < 0 then return r

		return row_shift(r, iso.dl)
	}

	const Iarch b = salvage_binder!(parse_evs(co.out), co.off, t.name)
	if b < 0 then return miss
	const (bl, bc) = lc_of(iso.clines, b)
	if bl < 0 then return miss

	return SymRow({
		sname: t.name,
		kind: 13,
		file: path,
		line: bl + iso.dl,
		ns: bc,
		ne: bc + Iarch(t.name.len),
	})
}

# Every reference of the binding under the cursor: a LOCAL's binder row FIRST then each use,
# or — when no local binds it — a NON-pub top-level name's decl rows (functions, records,
# unions) then its uses. Empty when the token is qualified (cross-file), pub, an erased
# `type` alias, or undeclared here; and empty ON A BROKEN BUFFER too: references demand the
# COMPLETE use log (a rename built from a truncated one would miss edits past the break and
# corrupt the program), so a nonzero child exit refuses rather than salvages.
const local_refs! = (Str argv0, [Str] env, Str path, Str overlay, [Str] lines, Iarch l0, TokCtx t): [SymRow] -> {
	let [SymRow] rows = []
	# a `Type.` base makes the token a union MEMBER use — the child answers the composite
	const Bool memberq = Iarch(t.base.len) > 0
	if !bare_token(t) && !memberq then return rows
	let Str cname = t.name
	if memberq then cname = "${t.base}.${t.name}"
	const Iso iso = lsp_child_iso!(argv0, env, path, overlay, lines, l0, t.ts, "refs", cname)
	if iso.co.rc != 0 then return rows
	const [Str] outl = split("\n", iso.co.out)
	const Bool is_top = Iarch(outl.len) > 0 && eq(outl[0], "top")

	# a chunk sees one declaration — a top-level name's uses span the whole file, so a `top`
	# answer from a chunk is incomplete: refuse it
	if is_top && iso.chunked then return rows

	# a `top` first line: the child answered for a NON-pub TOP-LEVEL name (its uses cannot
	# leave this file) — the declaration row comes from this file's own decl-line scan. The
	# child cannot see a TYPE declaration's `pub` (the parser discards it), so a `pub` decl
	# line is refused HERE; a `type` ALIAS (kind 5 without a `= {` group body) is refused
	# too — its uses are token-erased before the parse, so the log cannot cover them.
	if is_top && memberq then {
		# a union MEMBER: the owning union's decl line gates pub-ness (like a type), and the
		# member's declaration rows come from the union body scan
		for ln in lines {
			const DeclLine d = scan_decl(ln)

			if d.kind == 10 && eq(slice(d.ns, d.ne, ln), t.base) && starts_with("pub ", ln) then {
				const [SymRow] none = []

				return none
			}
		}

		let Str owner = ""
		if Iarch(overlay.len) > 0 then owner = path
		const [Str] one = [path]

		for m in union_members!(one, owner, overlay, t.base) {
			if eq(m.sname, t.name) then rows = [...rows, m]
		}

		# no such member declared here — nothing to anchor a rename on
		if Iarch(rows.len) == 0 then return rows
	}
	if is_top && !memberq then {
		let Iarch li = 0

		for ln in lines {
			const DeclLine d = scan_decl(ln)

			if d.kind != 0 && eq(slice(d.ns, d.ne, ln), t.name) then {
				if starts_with("pub ", ln) then {
					const [SymRow] none = []

					return none
				}

				if d.kind == 5 && !contains("= {", ln) then {
					const [SymRow] none = []

					return none
				}

				rows = [...rows, SymRow({
					sname: t.name,
					kind: 13,
					file: path,
					line: li,
					ns: d.ns,
					ne: d.ne,
				})]
			}

			li = li + 1
		}

		# a type declared nowhere in this file (a builtin like `Str`, an imported type) has
		# no decl row to anchor — refuse rather than hand back a use list with no owner
		if Iarch(rows.len) == 0 then return rows

		for ar in alias_target_rows(lines, path, t.name) {
			rows = [...rows, ar]
		}
	}

	# uses, deduped by position: a `type P = Point` alias SPLICES its target tokens in for
	# every use of `P`, so several events can land on the one spliced occurrence
	for lref in outl {
		const SymRow r = ref_row(lref, path, t.name)

		if r.line >= 0 then {
			const SymRow s = row_shift(r, iso.dl)
			let Bool dup = false

			for x in rows {
				if x.line == s.line && x.ns == s.ns then dup = true
			}

			if !dup then rows = [...rows, s]
		}
	}

	return rows
}

# The union whose MEMBER declaration sits exactly at (l0, ts) in the checked buffer, or ""
# — a cursor resting on `Line` inside `union Shape = { Dot, Line(Iarch) }` reads as a bare
# token, but it asks about the member: the caller rebases the query onto `Base.member`.
const member_decl_union! = (Str path, Str overlay, [Str] lines, Iarch l0, Iarch ts): Str -> {
	let Str owner = ""
	if Iarch(overlay.len) > 0 then owner = path
	const [Str] one = [path]

	for ln in lines {
		const DeclLine d = scan_decl(ln)

		if d.kind == 10 then {
			const Str ub = slice(d.ns, d.ne, ln)

			for m in union_members!(one, owner, overlay, ub) {
				if m.line == l0 && m.ns == ts then return ub
			}
		}
	}

	return ""
}

# The `type Alias = ...Target...` lines of `lines` that name the UPPERCASE `name` in their
# target (`type Alias = Point`) — those tokens are erased before the parse, so the event log
# cannot cover them: the line scan supplies the rows (the caller's dedup folds the spliced
# duplicates the log DOES carry for a used alias).
const alias_target_rows = ([Str] lines, Str file, Str name): [SymRow] -> {
	let [SymRow] rows = []
	if Iarch(name[0]) < 65 || Iarch(name[0]) > 90 then return rows
	let Iarch al = 0

	for ln in lines {
		const DeclLine d = scan_decl(ln)

		if d.kind == 5 && !contains("= {", ln) then {
			let Iarch i = index_of("=", ln)

			loop {
				if i < 0 || i >= Iarch(ln.len) then break

				if name_byte(Iarch(ln[i])) then {
					const Iarch e = name_end(ln, i)

					if e - i == Iarch(name.len) && eq(slice(i, e, ln), name) then {
						rows = [...rows, SymRow({
							sname: name,
							kind: 13,
							file: file,
							line: al,
							ns: i,
							ne: e,
						})]
					}

					i = e
				} else {
					i = i + 1
				}
			}
		}

		al = al + 1
	}

	return rows
}

# Resolve a decomposed token to its definitions: a `Type.` base tries the union's members
# first; otherwise the top-level declarations of the name, hint-narrowed for a qualified use
# (an alias hint matching nothing keeps the full set) and same-file-preferred for a bare one.
# `dotted` (the token directly follows a `.`) falls back to record FIELDS of the name when no
# declaration matches — a `base.field` read jumps to its field declarations.
const picked_defs! = (Str argv0, [Str] env, Str path, Str srcf, Str srcp, Str overlay, TokCtx t, Bool dotted): DefOut -> {
	const [Str] mods = modules_of!(argv0, env, path, overlay)
	const Str pwd = getenv!(env, "PWD")
	const [Str] scan = scan_files!(mods, path, pwd)

	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	if Iarch(t.base.len) > 0 then {
		const [SymRow] mems = union_members!(scan, owner, srcf, t.base)
		let [SymRow] mhits = []

		for m in mems {
			if eq(m.sname, t.name) then mhits = [...mhits, m]
		}

		if Iarch(mhits.len) > 0 then return DefOut({ hits: mhits, mods: mods })
	}

	const [SymRow] decls = all_decls!(scan, owner, srcf)
	let [SymRow] all = []

	for d in decls {
		if eq(d.sname, t.name) then all = [...all, d]
	}

	let [SymRow] picked = []

	if Iarch(t.hints.len) > 0 then {
		for h in all {
			if hint_ok!(t.hints, Iarch(t.hints.len), h.file) then picked = [...picked, h]
		}
	}

	if Iarch(picked.len) == 0 then picked = all

	# an unqualified name declared in the checked file itself wins (the nearest declaration)
	if Iarch(t.hints.len) == 0 then {
		let [SymRow] local = []

		for h in picked {
			if eq(h.file, path) then local = [...local, h]
		}

		if Iarch(local.len) > 0 then picked = local
	}

	# a field read with no declaration of the name: the record fields answer
	if Iarch(picked.len) == 0 && dotted && eq(t.base, "") then
		picked = rec_fields!(scan, owner, srcf, t.name)

	return DefOut({ hits: picked, mods: mods })
}

# Answer textDocument/definition: the qualified token under the cursor, resolved to the
# top-level declarations (or `Type.` union members) of that name across the checked file's
# module tree. The cursor's own SEGMENT is the sought name and the segments before it narrow
# by module path — so goto works on a bare use (`parse!`), a qualified one (`json::parse!`),
# and an import's member alike. A token that names no declaration but ends a module path
# (`std::data::json` on its import) jumps to the module file. No match is Null, never an error.
const goto_def! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0): Json -> {
	if !starts_with("file://", uri) then return Json.Null
	const Str path = uri_to_path!(uri)

	let Str from = path
	let Str overlay = ""
	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	if eq(owner, path) then {
		from = srcf
		overlay = srcf
	}

	const Str text = match read_file!(from) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	const [Str] lines = split("\n", text)
	if l0 < 0 || l0 >= Iarch(lines.len) then return Json.Null
	const TokCtx t = token_at(lines[l0], c0)
	if !t.ok then return Json.Null

	# a local binding wins over any top-level declaration of the same name (shadowing)
	const SymRow lr = local_def!(argv0, env, path, overlay, lines, l0, t)
	if lr.line >= 0 then return Json.Arr([location!(uri, path, path, lr.line, lr.ns, lr.ne)])

	const Bool dotted = t.ts > 0 && Iarch(lines[l0][t.ts - 1]) == 46
	const DefOut o = picked_defs!(argv0, env, path, srcf, srcp, overlay, t, dotted)

	if Iarch(o.hits.len) == 0 then {
		# no declaration — perhaps the token is a module path (an import): jump to its file
		const Str jp = join("/", t.lead)
		const Str pwd = getenv!(env, "PWD")

		for m in o.mods {
			const Str a = abs_path!(pwd, m)

			if Iarch(a.len) > 0 && contains("${jp}.cf", a) then {
				return Json.Arr([location!(uri, path, a, 0, 0, 1)])
			}
		}

		return Json.Null
	}

	let [Json] locs = []

	for h in o.hits {
		locs = [...locs, location!(uri, path, h.file, h.line, h.ns, h.ne)]
	}

	return Json.Arr(locs)
}

# A plain identifier — what a binding may be renamed to: `[a-zA-Z_]` then `[a-zA-Z0-9_]*`,
# optionally ONE trailing `!` (a function keeps its alloc marker across a rename —
# `bang_matches` enforces that the suffix neither appears nor disappears; `case_matches`
# that a value name stays lowercase and a type name PascalCase).
const ident_ok = (Str s): Bool -> {
	if Iarch(s.len) == 0 then return false
	const Iarch b0 = Iarch(s[0])
	if !((b0 >= 97 && b0 <= 122) || (b0 >= 65 && b0 <= 90) || b0 == 95) then return false
	let Iarch i = 1

	loop {
		if i >= Iarch(s.len) then break
		const Iarch b = Iarch(s[i])
		if b == 33 then return i == Iarch(s.len) - 1
		if !((b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95)
			then return false
		i = i + 1
	}

	return true
}

# The `!` alloc marker is SEMANTIC (the alloc gate checks it) — a rename must carry it over
# exactly: old and new name either both end with `!` or neither does.
const bang_matches = (Str old, Str nn): Bool -> {
	const Bool ob = Iarch(old.len) > 0 && Iarch(old[Iarch(old.len) - 1]) == 33
	const Bool nb = Iarch(nn.len) > 0 && Iarch(nn[Iarch(nn.len) - 1]) == 33

	return (ob && nb) || (!ob && !nb)
}

# The first byte's CASE is the name's grammatical class (a PascalCase type vs a lowercase
# value) — a rename may not cross it: `Point` -> `point` would turn a type reference into a
# value read wherever it appears.
const case_matches = (Str old, Str nn): Bool -> {
	const Bool ou = Iarch(old.len) > 0 && Iarch(old[0]) >= 65 && Iarch(old[0]) <= 90
	const Bool nu = Iarch(nn.len) > 0 && Iarch(nn[0]) >= 65 && Iarch(nn[0]) <= 90

	return (ou && nu) || (!ou && !nu)
}

# The reference rows of the local binding under (uri, l0, c0) — the shared front of
# references and rename. Empty when the position holds no local.
const rows_at! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0): [SymRow] -> {
	const [SymRow] none = []
	if !starts_with("file://", uri) then return none
	const Str path = uri_to_path!(uri)

	let Str from = path
	let Str overlay = ""
	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	if eq(owner, path) then {
		from = srcf
		overlay = srcf
	}

	const Str text = match read_file!(from) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	const [Str] lines = split("\n", text)
	if l0 < 0 || l0 >= Iarch(lines.len) then return none
	const TokCtx t = token_at(lines[l0], c0)
	if !t.ok then return none

	return local_refs!(argv0, env, path, overlay, lines, l0, t)
}

# A per-file `uses` child outcome: `ok` false when the file's parse died (a mid-edit break —
# the whole cross-file answer must refuse; there is no chunk salvage across files).
data UsesOut = { Bool ok, [SymRow] rows }

# Every `.cf` file under `dir`, recursively — dot-entries (`.git`, hidden dirs) skipped, an
# unreadable directory contributes nothing. The workspace candidate set of the rename walk.
const walk_cf! = (Str dir): [Str] -> {
	let [Str] out = []

	match read_dir!(dir) {
		Either.Left(e) -> {},
		Either.Right(entries) -> {
			for e in entries {
				if Iarch(e.name.len) > 0 && Iarch(e.name[0]) != 46 then {
					const Str child = "${dir}/${e.name}"

					if entry_is_dir(e) then {
						for c in walk_cf!(child) {
							out = [...out, c]
						}
					} else if ends_with(".cf", e.name) then {
						out = [...out, child]
					}
				}
			}
		},
	}

	return out
}

# A workspace file's own module list via a `cf lsp modules` child — `ok` false when its
# resolve fails. Uncached: each workspace candidate resolves once per query.
data WsMods = { Bool ok, [Str] mods }

const ws_modules! = (Str argv0, [Str] env, Str w): WsMods -> {
	const [Str] none = []

	const Str sh = match find_executable!(env, "sh") {
		Either.Right(p) -> p,
		Either.Left(e) -> "",
	}

	if eq(sh, "") then return WsMods({ ok: false, mods: none })
	const Str tmp = "/tmp/cf-lsp-${getpid()}.wsm"
	const Str cmd = "'${argv0}' lsp modules '${w}' > '${tmp}' 2> /dev/null"
	const Iarch rc = run!(sh, ["sh", "-c", cmd], env)

	const Str got = match read_file!(tmp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	remove(tmp)
	if rc != 0 then return WsMods({ ok: false, mods: none })
	let [Str] mods = []

	for m in split("\n", got) {
		if Iarch(m.len) > 0 then mods = [...mods, m]
	}

	return WsMods({ ok: true, mods: mods })
}

# One `cf lsp uses` child over a WORKSPACE file `f` — a file outside the checked file's
# module tree, always read from disk (the overlay's owner is a tree file by construction).
# Candidate positions verify against the file's own text, like `uses_all_rows!`.
const uses_file_rows! = (Str argv0, [Str] env, Str f, Str cname, Str vname): UsesOut -> {
	const [SymRow] none = []

	const Str sh = match find_executable!(env, "sh") {
		Either.Right(p) -> p,
		Either.Left(e) -> "",
	}

	if eq(sh, "") then return UsesOut({ ok: false, rows: none })
	const Str tmp = "/tmp/cf-lsp-${getpid()}.uses"
	const Str cmd = "'${argv0}' lsp uses '${f}' '${cname}' > '${tmp}' 2> /dev/null"
	const Iarch rc = run!(sh, ["sh", "-c", cmd], env)

	const Str got = match read_file!(tmp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	remove(tmp)
	if rc != 0 then return UsesOut({ ok: false, rows: none })
	const [Str] flines = split("\n", src_of!(f, "", ""))
	let [SymRow] rows = []

	for lref in split("\n", got) {
		const SymRow r = ref_row(lref, f, vname)

		if r.line >= 0 && r.line < Iarch(flines.len) then {
			const Str ln = flines[r.line]

			if r.ne <= Iarch(ln.len)
			&& eq(slice(r.ns, r.ne, ln), vname)
			&& (r.ns == 0 || !name_byte(Iarch(ln[r.ns - 1])))
			&& (r.ne >= Iarch(ln.len) || !name_byte(Iarch(ln[r.ne]))) then {
				rows = [...rows, r]
			}
		}
	}

	return UsesOut({ ok: true, rows: rows })
}

# The whole tree's uses of `cname` — a plain top-level name or a `Base.member` composite —
# via ONE `cf lsp uses-all` child (it resolves the entry's tree itself and replays every
# file in-process; one spawn instead of one per file). Rows come back `path<TAB>line:col`
# with the resolver's own path stamps, absolutized here like the scan list. Every position
# is VERIFIED: the child's mangled-tail match is loose, so a row only survives when `vname`
# (the token the position points at — the member for a composite) sits at its column as a
# whole token in the file's own text (the overlay stands in for the owner file).
const uses_all_rows! = (Str argv0, [Str] env, Str path, Str overlay, Str owner, Str srcf, Str pwd, Str cname, Str vname): UsesOut -> {
	const [SymRow] none = []

	const Str sh = match find_executable!(env, "sh") {
		Either.Right(p) -> p,
		Either.Left(e) -> "",
	}

	if eq(sh, "") then return UsesOut({ ok: false, rows: none })
	const Str tmp = "/tmp/cf-lsp-${getpid()}.uses"
	let Str ov = ""
	if Iarch(overlay.len) > 0 then ov = " --src '${overlay}'"
	const Str cmd = "'${argv0}' lsp uses-all '${path}' '${cname}'${ov} > '${tmp}' 2> /dev/null"
	const Iarch rc = run!(sh, ["sh", "-c", cmd], env)

	const Str got = match read_file!(tmp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	remove(tmp)
	if rc != 0 then return UsesOut({ ok: false, rows: none })

	# the raw (file, line:col) pairs, then per DISTINCT file: read it once, verify its rows
	let [Str] rfiles = []
	let [Str] rrefs = []

	for row in split("\n", got) {
		const Iarch tb = index_of("\t", row)

		if tb > 0 then {
			rfiles = [...rfiles, slice(0, tb, row)]
			rrefs = [...rrefs, slice(tb + 1, Iarch(row.len), row)]
		}
	}

	let [Str] dfs = []

	for f in rfiles {
		if !in_list(f, dfs) then dfs = [...dfs, f]
	}

	let [SymRow] rows = []

	for f in dfs {
		const Str fabs = abs_path!(pwd, f)

		if Iarch(fabs.len) > 0 then {
			const [Str] flines = split("\n", src_of!(fabs, owner, srcf))
			let Iarch i = 0

			loop {
				if i >= Iarch(rfiles.len) then break

				if eq(rfiles[i], f) then {
					const SymRow r = ref_row(rrefs[i], fabs, vname)

					if r.line >= 0 && r.line < Iarch(flines.len) then {
						const Str ln = flines[r.line]

						if r.ne <= Iarch(ln.len)
						&& eq(slice(r.ns, r.ne, ln), vname)
						&& (r.ns == 0 || !name_byte(Iarch(ln[r.ns - 1])))
						&& (r.ne >= Iarch(ln.len) || !name_byte(Iarch(ln[r.ne]))) then {
							rows = [...rows, r]
						}
					}
				}

				i = i + 1
			}
		}
	}

	return UsesOut({ ok: true, rows: rows })
}

# Cross-file rows for a PUB top-level name: the ONE declaration of the cursor's name across
# the module tree, every tree file's verified uses (import-list members included) and
# alias-target mentions, then the WHOLE WORKSPACE's — every `.cf` under $PWD that mentions
# the name, so a rename made from the declaring module also edits importers the checked
# file's own tree cannot see. Refused (empty) when the name is declared nowhere, more than
# once — in the tree or in a REACHING workspace file (a same-named sibling makes per-file
# binding ambiguous — refuse rather than corrupt) — non-pub, an erased `type` alias, or
# `main` (the entry symbol is not renameable); and when any TREE file's parse dies — an
# edit built from a partial answer would corrupt.
const pub_rows! = (Str argv0, [Str] env, Str path, Str srcf, Str srcp, Str overlay, TokCtx t): [SymRow] -> {
	const [SymRow] none = []
	if eq(t.name, "main") then return none
	# a `Type.` base: the token is a union MEMBER — the UNION's declaration anchors the
	# uniqueness/pub gates, the member's own decl rows come from the union body scan, and
	# the uses children match the `Base.member` composite the parser logs
	const Bool memberq = Iarch(t.base.len) > 0
	let Str dname = t.name
	if memberq then dname = t.base
	let Str cname = t.name
	if memberq then cname = "${t.base}.${t.name}"
	const [Str] mods = modules_of!(argv0, env, path, overlay)
	const Str pwd = getenv!(env, "PWD")
	const [Str] scan = scan_files!(mods, path, pwd)

	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	const [SymRow] decls = all_decls!(scan, owner, srcf)
	let [SymRow] dhits = []

	for d in decls {
		if eq(d.sname, dname) then dhits = [...dhits, d]
	}

	if Iarch(dhits.len) != 1 then return none
	const SymRow dl = dhits[0]
	# a member's base must be a UNION declaration
	if memberq && dl.kind != 10 then return none
	# an erased `type` alias has no events to walk; a group is never pub — kind 5 refuses whole
	if dl.kind == 5 then return none
	const [Str] dlines = split("\n", src_of!(dl.file, owner, srcf))
	if dl.line >= Iarch(dlines.len) then return none
	if !starts_with("pub ", dlines[dl.line]) then return none
	let [SymRow] rows = []

	if memberq then {
		for m in union_members!(scan, owner, srcf, t.base) {
			if eq(m.sname, t.name) then rows = [...rows, m]
		}

		# the union declares no such member — nothing to anchor
		if Iarch(rows.len) == 0 then return none
	} else {
		rows = [...rows, dl]
	}

	const UsesOut u = uses_all_rows!(argv0, env, path, overlay, owner, srcf, pwd, cname, t.name)
	if !u.ok then return none

	for r in u.rows {
		let Bool dup = false

		for x in rows {
			if eq(x.file, r.file) && x.line == r.line && x.ns == r.ns then dup = true
		}

		if !dup then rows = [...rows, r]
	}

	for f in scan {
		for ar in alias_target_rows(split("\n", src_of!(f, owner, srcf)), f, t.name) {
			let Bool dup = false

			for x in rows {
				if eq(x.file, ar.file) && x.line == ar.line && x.ns == ar.ns then dup = true
			}

			if !dup then rows = [...rows, ar]
		}
	}

	# WORKSPACE extension: a file OUTSIDE the checked file's module tree may import the decl
	# file and use the name — walk the workspace root ($PWD, the root the editor opened),
	# cheap-filter to the files that MENTION the sought token at all, and gate MEMBERSHIP by
	# RESOLUTION: a candidate's rows count only when its OWN module tree reaches the decl
	# file (a file can only reference the target through its module). An unrelated project
	# under the same root — a corpus test declaring its own like-named fn — resolves to a
	# tree WITHOUT the decl file and is skipped silently, no refusal, no touch. A mentioning
	# file whose resolve FAILS is skipped too: what cannot resolve cannot compile, so it is
	# no live consumer (deliberately-broken test fixtures must not block every rename; a
	# truly broken importer surfaces the stale name at its own next check). A REACHING file
	# that also DECLARES the anchor name is a per-file shadow the log cannot split — refuse,
	# the tree gate's discipline; a reaching file whose TRACKED parse fails refuses as well.
	if Iarch(pwd.len) > 0 then {
		# `pwd` is an env view — NUL-terminate it before the raw open syscall under read_dir!
		for w in walk_cf!(czstr!(pwd)) {
			if !in_list(w, scan) then {
				const Str wtext = match read_file!(w) {
					Either.Right(s) -> s,
					Either.Left(e) -> "",
				}

				if index_of(t.name, wtext) >= 0 then {
					const WsMods wm = ws_modules!(argv0, env, w)
					let Bool reaches = false

					for m in wm.mods {
						if eq(abs_path!(pwd, m), dl.file) then reaches = true
					}

					if reaches then {
						const [Str] wlines = split("\n", wtext)

						for wl in wlines {
							const DeclLine wd = scan_decl(wl)

							if wd.kind != 0 && eq(slice(wd.ns, wd.ne, wl), dname) then {
								return none
							}
						}

						const UsesOut wu = uses_file_rows!(argv0, env, w, cname, t.name)
						if !wu.ok then return none

						for r in wu.rows {
							let Bool dup = false

							for x in rows {
								if eq(x.file, r.file) && x.line == r.line && x.ns == r.ns then dup = true
							}

							if !dup then rows = [...rows, r]
						}

						for ar in alias_target_rows(wlines, w, t.name) {
							let Bool dup = false

							for x in rows {
								if eq(x.file, ar.file) && x.line == ar.line && x.ns == ar.ns then dup = true
							}

							if !dup then rows = [...rows, ar]
						}
					}
				}
			}
		}
	}

	return rows
}

# The reference rows of the binding under (uri, l0, c0): the same-file rows (a local, or a
# non-pub top-level name) when they answer, else the CROSS-FILE rows of a pub name. The
# shared front of references and rename; empty when neither path answers.
const deep_rows! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0): [SymRow] -> {
	const [SymRow] none = []
	if !starts_with("file://", uri) then return none
	const Str path = uri_to_path!(uri)

	let Str from = path
	let Str overlay = ""
	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	if eq(owner, path) then {
		from = srcf
		overlay = srcf
	}

	const Str text = match read_file!(from) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	const [Str] lines = split("\n", text)
	if l0 < 0 || l0 >= Iarch(lines.len) then return none
	const TokCtx t = token_at(lines[l0], c0)
	if !t.ok then return none
	let TokCtx tq = t

	# a bare PascalCase token may be a union member's own DECLARATION — rebase the query
	# onto `Base.member` so refs/rename answer from the member's identity
	if bare_token(t) && Iarch(t.name[0]) >= 65 && Iarch(t.name[0]) <= 90 then {
		const Str ub = member_decl_union!(path, overlay, lines, l0, t.ts)

		if Iarch(ub.len) > 0 then
			tq = TokCtx({ ok: true, name: t.name, hints: t.hints, lead: t.lead, ts: t.ts, te: t.te, base: ub })
	}

	const [SymRow] lrows = local_refs!(argv0, env, path, overlay, lines, l0, tq)
	if Iarch(lrows.len) > 0 then return lrows

	return pub_rows!(argv0, env, path, srcf, srcp, overlay, tq)
}

# Answer textDocument/references: every reference of the binding under the cursor — a
# local's or a non-pub top-level name's within this file, a PUB name's across the whole
# module tree. The first row is the declaration; it is dropped when the client set
# includeDeclaration off. Null when both paths refuse (no token, ambiguity, a broken file).
const references! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0, Bool incl): Json -> {
	const [SymRow] rows = deep_rows!(argv0, env, uri, srcf, srcp, l0, c0)
	if Iarch(rows.len) == 0 then return Json.Null
	const Str path = uri_to_path!(uri)
	let [Json] locs = []
	let Iarch ri = 0

	for r in rows {
		if incl || ri > 0 then locs = [...locs, location!(uri, path, r.file, r.line, r.ns, r.ne)]
		ri = ri + 1
	}

	return Json.Arr(locs)
}

# Answer textDocument/rename: a WorkspaceEdit renaming every reference of the binding under
# the cursor to `nn` — a local's or a non-pub top-level name's edits land in the one file, a
# PUB name's group per file across the module tree. Null when the position answers nothing
# (see references) or the new name is no plain identifier — better no edit than a corrupting
# one. No conflict check against a like-named binding in an overlapping scope: the resulting
# clash is cf's checker's to report, and the editor previews the edits.
const rename! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0, Str nn): Json -> {
	if !ident_ok(nn) then return Json.Null
	const [SymRow] rows = deep_rows!(argv0, env, uri, srcf, srcp, l0, c0)
	if Iarch(rows.len) == 0 then return Json.Null
	if !bang_matches(rows[0].sname, nn) then return Json.Null
	if !case_matches(rows[0].sname, nn) then return Json.Null
	const Str path = uri_to_path!(uri)

	# the distinct uris carrying edits, in first-seen order — the checked uri keeps its
	# exact requested identity
	let [Str] furis = []

	for r in rows {
		let Str u = ""
		if eq(r.file, path) then u = uri else u = path_uri!(r.file)
		if !in_list(u, furis) then furis = [...furis, u]
	}

	let [JsonEntry] changes = []

	for u in furis {
		let [Json] edits = []

		for r in rows {
			let Str ru = ""
			if eq(r.file, path) then ru = uri else ru = path_uri!(r.file)

			if eq(ru, u) then {
				edits = [...edits, Json.Obj([
					ent("range", jrange!(r.line, r.ns, r.ne)),
					ent("newText", jstr(nn)),
				])]
			}
		}

		changes = [...changes, ent(u, Json.Arr(edits))]
	}

	return Json.Obj([ent("changes", Json.Obj(changes))])
}

# Answer textDocument/prepareRename: the exact span rename would edit and its placeholder
# text, or Null when rename would refuse here (no token, not a local — the editor then never
# opens the prompt). The same renameability check rename makes, made BEFORE the user types.
const prepare_rename! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0): Json -> {
	if !starts_with("file://", uri) then return Json.Null
	const Str path = uri_to_path!(uri)

	let Str from = path
	let Str overlay = ""
	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	if eq(owner, path) then {
		from = srcf
		overlay = srcf
	}

	const Str text = match read_file!(from) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	const [Str] lines = split("\n", text)
	if l0 < 0 || l0 >= Iarch(lines.len) then return Json.Null
	const TokCtx t = token_at(lines[l0], c0)
	if !t.ok then return Json.Null
	let TokCtx tq = t

	# a bare PascalCase token on a union member's own declaration — same rebase as deep_rows!
	if bare_token(t) && Iarch(t.name[0]) >= 65 && Iarch(t.name[0]) <= 90 then {
		const Str ub = member_decl_union!(path, overlay, lines, l0, t.ts)

		if Iarch(ub.len) > 0 then
			tq = TokCtx({ ok: true, name: t.name, hints: t.hints, lead: t.lead, ts: t.ts, te: t.te, base: ub })
	}

	let [SymRow] rows = local_refs!(argv0, env, path, overlay, lines, l0, tq)
	if Iarch(rows.len) == 0 then rows = pub_rows!(argv0, env, path, srcf, srcp, overlay, tq)
	if Iarch(rows.len) == 0 then return Json.Null

	# the SEGMENT under the cursor, not the whole qualified token — rename edits only it
	let Iarch ss = t.ts

	for h in t.hints {
		ss = ss + Iarch(h.len) + 2
	}

	return Json.Obj([
		ent("range", jrange!(l0, ss, ss + Iarch(t.name.len))),
		ent("placeholder", jstr(t.name)),
	])
}

# Answer textDocument/documentHighlight: every reference of the binding under the cursor,
# lit up in this one file — the binder as a Write highlight (kind 3), each use as a Read
# (kind 2). The same rows references answers with; Null when the position holds none.
const highlights! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0): Json -> {
	const [SymRow] rows = rows_at!(argv0, env, uri, srcf, srcp, l0, c0)
	if Iarch(rows.len) == 0 then return Json.Null
	let [Json] hs = []
	let Iarch ri = 0

	for r in rows {
		let Iarch k = 2
		if ri == 0 then k = 3
		hs = [...hs, Json.Obj([ent("range", jrange!(r.line, r.ns, r.ne)), ent("kind", jnum(k))])]
		ri = ri + 1
	}

	return Json.Arr(hs)
}

# The LAST occurrence of `needle` in `s`, or -1.
const last_index_of = (Str needle, Str s): Iarch -> {
	let Iarch at = -1
	let Iarch from = 0

	loop {
		const Iarch i = index_of(needle, slice(from, Iarch(s.len), s))
		if i < 0 then break
		at = from + i
		from = from + i + 1
	}

	return at
}

# A declaration line tidied for hover: surrounding whitespace, a trailing `{`, and a
# member's trailing `,` dropped. A FUNCTION's body is cut at its `->` — the hint is the
# signature, `-> x + x` says nothing. The arrow is found after the last `): ` (the return
# annotation), so an `->` inside a function-TYPE parameter never truncates the signature;
# `main`, the one arrowed decl with no return annotation, falls back to the first `->`.
const tidy_sig = (Str ln): Str -> {
	let Str s = trim(ln)

	if contains("= (", s) then {
		const Iarch anchor = last_index_of("): ", s)
		let Iarch cut = -1

		if anchor >= 0 then {
			const Iarch i = index_of(" ->", slice(anchor, Iarch(s.len), s))
			if i >= 0 then cut = anchor + i
		} else {
			cut = index_of(" ->", s)
		}

		if cut >= 0 then s = trim(slice(0, cut, s))
	}

	if Iarch(s.len) > 0 && Iarch(s[Iarch(s.len) - 1]) == 123 then {
		s = trim(slice(0, Iarch(s.len) - 1, s))
	}

	if Iarch(s.len) > 0 && Iarch(s[Iarch(s.len) - 1]) == 44 then {
		s = slice(0, Iarch(s.len) - 1, s)
	}

	return s
}

# Answer textDocument/hover: the first definition of the token under the cursor, shown as its
# tidied declaration line in a cf code block with the `#` comment block above it as prose. A
# multi-definition name notes how many more there are. Null when nothing resolves.
const hover! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0): Json -> {
	if !starts_with("file://", uri) then return Json.Null
	const Str path = uri_to_path!(uri)

	let Str from = path
	let Str overlay = ""
	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	if eq(owner, path) then {
		from = srcf
		overlay = srcf
	}

	const Str text = match read_file!(from) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	const [Str] lines = split("\n", text)
	if l0 < 0 || l0 >= Iarch(lines.len) then return Json.Null
	const TokCtx t = token_at(lines[l0], c0)
	if !t.ok then return Json.Null

	# a local binding: hover shows its binder line (same buffer — locals live in the one file)
	const SymRow lh = local_def!(argv0, env, path, overlay, lines, l0, t)

	if lh.line >= 0 && lh.line < Iarch(lines.len) then {
		const Str lsig = tidy_sig(lines[lh.line])

		return Json.Obj([
			ent("contents", Json.Obj([ent("kind", jstr("markdown")), ent("value", jstr("```cf\n${lsig}\n```"))])),
			ent("range", jrange!(l0, t.ts, t.te)),
		])
	}

	const Bool dotted = t.ts > 0 && Iarch(lines[l0][t.ts - 1]) == 46
	const DefOut o = picked_defs!(argv0, env, path, srcf, srcp, overlay, t, dotted)
	if Iarch(o.hits.len) == 0 then return Json.Null
	let SymRow h = o.hits[0]

	const [Str] dlines = split("\n", src_of!(h.file, owner, srcf))
	if h.line >= Iarch(dlines.len) then return Json.Null
	const Str sig = tidy_sig(dlines[h.line])

	# the contiguous `#` comment block right above the declaration, as prose (a bare `#`
	# line stays a paragraph break); lines TRIMMED first, so an indented field's doc counts
	let Iarch k0 = h.line

	loop {
		if k0 <= 0 then break
		if !starts_with("#", trim(dlines[k0 - 1])) then break
		k0 = k0 - 1
	}

	let Str doc = ""
	let Iarch k = k0

	loop {
		if k >= h.line then break
		const Str dl = trim(dlines[k])

		if starts_with("# ", dl) then {
			doc = "${doc}${slice(2, Iarch(dl.len), dl)}\n"
		} else {
			doc = "${doc}\n"
		}

		k = k + 1
	}

	let Str md = "```cf\n${sig}\n```"
	if Iarch(doc.len) > 0 then md = "${md}\n\n${doc}"
	if Iarch(o.hits.len) > 1 then md = "${md}\n\n_+${Iarch(o.hits.len) - 1} more definition(s)_"

	return Json.Obj([
		ent("contents", Json.Obj([ent("kind", jstr("markdown")), ent("value", jstr(md))])),
		ent("range", jrange!(l0, t.ts, t.te)),
	])
}

# The CompletionItemKind of an indexed row's SymbolKind: Function, Struct, Enum, Class,
# EnumMember — everything else a Constant.
const citem_kind = (Iarch k): Iarch -> {
	if k == 12 then return 3
	if k == 23 then return 22
	if k == 10 then return 13
	if k == 5 then return 7
	if k == 22 then return 20

	return 21
}

const citem = (Str label, Iarch kind, Str detail): Json -> Json.Obj([
	ent("label", jstr(label)),
	ent("kind", jnum(kind)),
	ent("detail", jstr(detail)),
])

# The path segment of module `m` right after the contiguous `hints` run (`std::data` over
# `lib/std/data/str.cf` -> `str`), or "" when the run does not appear. A `.cf` tail drops.
const next_seg = (Str m, [Str] hints, Iarch n): Str -> {
	const [Str] parts = split("/", m)
	let Iarch i = 0

	loop {
		if i + n >= Iarch(parts.len) then break
		let Bool okrun = true
		let Iarch j = 0

		loop {
			if j >= n then break

			if !eq(parts[i + j], hints[j]) then {
				okrun = false
				break
			}

			j = j + 1
		}

		if okrun then {
			const Str nx = parts[i + n]
			const Iarch pl = Iarch(nx.len)

			if pl > 3 && Iarch(nx[pl - 3]) == 46 && Iarch(nx[pl - 2]) == 99 && Iarch(nx[pl - 1]) == 102 then {
				return slice(0, pl - 3, nx)
			}

			return nx
		}

		i = i + 1
	}

	return ""
}

# Answer textDocument/completion: what the typed prefix could become. A `Type.` base offers
# the union's members; a qualified prefix (`str::`) offers the hint-narrowed declarations
# plus the NEXT path segment of each matching module (so `std::` walks the tree); a bare
# prefix offers every declaration in scope, deduped by name. The client filters by the typed
# word, so no server-side prefix filtering.
const completions! = (Str argv0, [Str] env, Str uri, Str srcf, Str srcp, Iarch l0, Iarch c0): Json -> {
	const [Json] nothing = []
	if !starts_with("file://", uri) then return Json.Arr(nothing)
	const Str path = uri_to_path!(uri)

	let Str from = path
	let Str overlay = ""
	const Str owner = match read_file!(srcp) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	if eq(owner, path) then {
		from = srcf
		overlay = srcf
	}

	const Str text = match read_file!(from) {
		Either.Right(s) -> s,
		Either.Left(e) -> "",
	}

	const [Str] lines = split("\n", text)
	if l0 < 0 || l0 >= Iarch(lines.len) then return Json.Arr(nothing)
	const TokCtx t = cprefix(lines[l0], c0)

	const [Str] mods = modules_of!(argv0, env, path, overlay)
	const Str pwd = getenv!(env, "PWD")
	const [Str] scan = scan_files!(mods, path, pwd)
	let [Json] items = []

	# `Type.` — the union's members, nothing else
	if Iarch(t.base.len) > 0 then {
		const [SymRow] mems = union_members!(scan, owner, srcf, t.base)

		for m in mems {
			items = [...items, citem(m.sname, 20, m.file)]
		}

		return Json.Arr(items)
	}

	let [Str] seen = []

	# a bare prefix: the LOCALS visible at the cursor come first — kind 6 (Variable), the
	# binder's own line as the detail. Seeding `seen` here makes an inner binding shadow a
	# like-named top-level declaration below. `locals_at!` survives a broken buffer (the
	# salvage replay), so mid-edit completion still offers everything bound above the cursor.
	if Iarch(t.hints.len) == 0 then {
		const [LocalRow] locals = locals_at!(argv0, env, path, overlay, lines, l0, t.ts)

		for lr in locals {
			if !in_list(lr.name, seen) then {
				seen = [...seen, lr.name]
				let Str det = ""
				if lr.line < Iarch(lines.len) then det = tidy_sig(lines[lr.line])
				items = [...items, citem(lr.name, 6, det)]
			}
		}
	}

	const [SymRow] decls = all_decls!(scan, owner, srcf)

	for d in decls {
		let Bool keep = true
		if Iarch(t.hints.len) > 0 then keep = hint_ok!(t.hints, Iarch(t.hints.len), d.file)

		if keep && !in_list(d.sname, seen) then {
			seen = [...seen, d.sname]
			items = [...items, citem(d.sname, citem_kind(d.kind), d.file)]
		}
	}

	# the next path segment of each module matching the hint run (`std::` -> `data`, `io`, …)
	if Iarch(t.hints.len) > 0 then {
		for m in mods {
			const Str nx = next_seg(m, t.hints, Iarch(t.hints.len))

			if Iarch(nx.len) > 0 && !in_list(nx, seen) then {
				seen = [...seen, nx]
				items = [...items, citem(nx, 9, m)]
			}
		}
	}

	return Json.Arr(items)
}

# --- the loop ---------------------------------------------------------------------------------

# Handle one frame; returns 1 to keep serving, 0 on EOF/exit.
const serve_one! = (Str argv0, [Str] env): Iarch -> {
	const Iarch n = read_content_length!()
	if n < 0 then return 0
	const Str body = read_body!(n)

	const Json req = match parse!(body) {
		Either.Right(v) -> v,
		Either.Left(e) -> Json.Null,
	}

	const Str method = jtext(jget("method", req))
	const Json id = jget("id", req)
	const Bool is_request = match jget("id", req) { Json.Null -> false, _ -> true }

	if eq(method, "initialize") then {
		respond!(id, init_result!())

		return 1
	}
	if eq(method, "shutdown") then {
		respond!(id, Json.Null)

		return 1
	}
	if eq(method, "exit") then return 0

	const Str srcf = "/tmp/cf-lsp-${getpid()}.src"
	const Str srcp = "/tmp/cf-lsp-${getpid()}.srcp"

	if eq(method, "textDocument/didOpen") || eq(method, "textDocument/didSave") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))

		# the buffer now matches the disk — drop any overlay and check the real file
		remove(srcf)
		remove(srcp)

		if Iarch(uri.len) > 0 then {
			check_and_publish!(argv0, env, uri, "")
			# warm the module-list cache while the buffer parses, so completion/goto still
			# have a tree to scan once the next keystrokes break it
			const [Str] warm = modules_of!(argv0, env, uri_to_path!(uri), "")
		}

		return 1
	}
	if eq(method, "textDocument/didChange") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))

		# FULL sync (capability `change: 1`): the last contentChange carries the whole buffer
		let Json chg = Json.Null

		match jget("contentChanges", jget("params", req)) {
			Json.Arr(xs) -> {
				for x in xs {
					chg = x
				}
			},
			_ -> {},
		}

		const Bool has = match chg { Json.Null -> false, _ -> true }

		if Iarch(uri.len) > 0 && has then {
			write_file(srcf, jtext(jget("text", chg)))
			write_file(srcp, uri_to_path!(uri))
			check_and_publish!(argv0, env, uri, srcf)
		}

		return 1
	}
	if eq(method, "textDocument/documentSymbol") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))

		respond!(id, doc_symbols!(uri, srcf, srcp))

		return 1
	}
	if eq(method, "textDocument/definition") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))
		const Json pos = jget("position", jget("params", req))
		const Iarch pl = jint(jget("line", pos))
		const Iarch pc = jint(jget("character", pos))

		if Iarch(uri.len) > 0 && pl >= 0 && pc >= 0 then {
			respond!(id, goto_def!(argv0, env, uri, srcf, srcp, pl, pc))
		} else {
			respond!(id, Json.Null)
		}

		return 1
	}
	if eq(method, "textDocument/hover") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))
		const Json pos = jget("position", jget("params", req))
		const Iarch pl = jint(jget("line", pos))
		const Iarch pc = jint(jget("character", pos))

		if Iarch(uri.len) > 0 && pl >= 0 && pc >= 0 then {
			respond!(id, hover!(argv0, env, uri, srcf, srcp, pl, pc))
		} else {
			respond!(id, Json.Null)
		}

		return 1
	}
	if eq(method, "textDocument/completion") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))
		const Json pos = jget("position", jget("params", req))
		const Iarch pl = jint(jget("line", pos))
		const Iarch pc = jint(jget("character", pos))

		if Iarch(uri.len) > 0 && pl >= 0 && pc >= 0 then {
			respond!(id, completions!(argv0, env, uri, srcf, srcp, pl, pc))
		} else {
			respond!(id, Json.Null)
		}

		return 1
	}
	if eq(method, "textDocument/references") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))
		const Json pos = jget("position", jget("params", req))
		const Iarch pl = jint(jget("line", pos))
		const Iarch pc = jint(jget("character", pos))
		# absent context.includeDeclaration means include (a reference list without its
		# declaration is the rarer ask)
		const Bool incl = match jget("includeDeclaration", jget("context", jget("params", req))) {
			Json.Bool(b) -> b,
			_ -> true,
		}

		if Iarch(uri.len) > 0 && pl >= 0 && pc >= 0 then {
			respond!(id, references!(argv0, env, uri, srcf, srcp, pl, pc, incl))
		} else {
			respond!(id, Json.Null)
		}

		return 1
	}
	if eq(method, "textDocument/prepareRename") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))
		const Json pos = jget("position", jget("params", req))
		const Iarch pl = jint(jget("line", pos))
		const Iarch pc = jint(jget("character", pos))

		if Iarch(uri.len) > 0 && pl >= 0 && pc >= 0 then {
			respond!(id, prepare_rename!(argv0, env, uri, srcf, srcp, pl, pc))
		} else {
			respond!(id, Json.Null)
		}

		return 1
	}
	if eq(method, "textDocument/documentHighlight") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))
		const Json pos = jget("position", jget("params", req))
		const Iarch pl = jint(jget("line", pos))
		const Iarch pc = jint(jget("character", pos))

		if Iarch(uri.len) > 0 && pl >= 0 && pc >= 0 then {
			respond!(id, highlights!(argv0, env, uri, srcf, srcp, pl, pc))
		} else {
			respond!(id, Json.Null)
		}

		return 1
	}
	if eq(method, "textDocument/rename") then {
		const Str uri = jtext(jget("uri", jget("textDocument", jget("params", req))))
		const Json pos = jget("position", jget("params", req))
		const Iarch pl = jint(jget("line", pos))
		const Iarch pc = jint(jget("character", pos))
		const Str nn = jtext(jget("newName", jget("params", req)))

		if Iarch(uri.len) > 0 && pl >= 0 && pc >= 0 then {
			respond!(id, rename!(argv0, env, uri, srcf, srcp, pl, pc, nn))
		} else {
			respond!(id, Json.Null)
		}

		return 1
	}
	if is_request then respond_err!(id, 0 - 32601, "method not found")

	return 1
}

# The server: one frame per iteration, each in its own arena reclaimed at once. The published-uri
# set outlives the frames on disk; it is removed on exit.
pub const lsp_run! = ([Str] args, [Str] env): Iarch -> {
	let Iarch alive = 1

	loop {
		if alive == 0 then break
		const b = growing_arena::of(4194304)
		defer growing_arena::destroy(b)
		alive = serve_one!(args[0], env) in b
	}

	remove("/tmp/cf-lsp-${getpid()}.pub")
	remove("/tmp/cf-lsp-${getpid()}.src")
	remove("/tmp/cf-lsp-${getpid()}.srcp")
	remove("/tmp/cf-lsp-${getpid()}.modc")

	return 0
}
