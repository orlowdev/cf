// Project tasks for the cf repo. The `cflang-case` tag pairs with the C!
// extension's runnables.scm: every `case!`/`todo!` gets a gutter run button
// that fires this task on the case's file. The repo's own compiler runs the
// tests, so stdlib edits are exercised directly (embedded std overlays aside).
[
	{
		"label": "cf test $ZED_RELATIVE_FILE",
		"command": "./var/cf",
		"args": ["test", "$ZED_RELATIVE_FILE"],
		"tags": ["cflang-case"],
		"reveal": "always"
	}
]
